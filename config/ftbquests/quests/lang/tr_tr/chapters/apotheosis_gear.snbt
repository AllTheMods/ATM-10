{
	chapter.0731FA8830F28280.title: "Apotheosis Ekipmanları"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	image.79376FBD521FA59D.title: "Yücelik Mührü"
	quest.001C1881E9289566.quest_desc: ["&9Nadir&r, nadirlik derecelerinin ortasında yer alır. \n\nTüm &lDünya Seviyeleri&r'nde düşebilir ancak en çok &lDünya Seviyesi: &eYükseliş&r'te yaygındır. \n\n&9Parlak Kristal Parçaları&r, &c&lKurtarma Masasında&r &9Nadir&r &eEşyaları&r sökerek elde edilir."]
	quest.001C1881E9289566.quest_subtitle: "&9Nadir"
	quest.001C1881E9289566.title: "&9Parlak Kristal Parçası"
	quest.0089A394566B0F3B.quest_desc: ["&aSıradan Olmayan&r, ikinci nadirlik derecesidir. \n\n&lDünya Seviyesi: &9Sığınak&r'ta görünmeye başlar, en çok &lDünya Seviyesi: &2Sınır&r'da bulunur ve &lDünya Seviyesi: &4Dorukta&r artık düşmez. \n\n&aEskimiş Kumaş&r, &c&lKurtarma Masasında&r &aSıradan Olmayan&r &eEşyaları&r sökerek elde edilir."]
	quest.0089A394566B0F3B.quest_subtitle: "&aSıradan Olmayan"
	quest.0089A394566B0F3B.title: "&aEskimiş Kumaş"
	quest.097FDC136BC843A7.quest_desc: ["&lDünya Seviyesi: &6Zirve&r kademesine geçmek için &eZırh&r ve &eAlet/Silah&r donanımını &aSıradan Olmayan&r seviyesinden &9Nadir&r (veya daha üstü) seviyesine yükseltmelisin! Ayrıca &0&lWither&r'ı katletmen gerekecek. \n\n&0&lWither&r'ın bir &4İstilacı&r olması şart değil; hatta normal olması işini oldukça kolaylaştırır. \n\n&6&lZirve&r kademesinde &5Destansı&r &eEşyalar&f ve &2Değerli Taşlar&r en yaygın düşenler haline gelir. Ayrıca &eEşyalarda&r &6Efsanevi&r, &aDeğerli Taşlarda&r ise &zMükemmel&r kaliteleri bulmaya başlayabilirsin. Tabii ikisi de hâlâ oldukça nadirdir! \n\nBu kademede %75 Ekstra Tecrübe, %50 Şans bonusu ve &a75 Maks Eterna&r sınırı kazanırsın. \n\nBuna karşılık &4Yaratıklar&r da 12 zırh puanı, 10 zırh sertliği, 15 zırh delme ve 10 koruma delme bonusu kazanarak güçlenir. \n\nBana mı öyle geliyor yoksa onların güçlendirmeleri bizimkilerden daha mı iyi?"]
	quest.097FDC136BC843A7.title: "&lDünya Seviyesi: &6Zirve"
	quest.099C2A9B9CA138F8.quest_desc: ["&6Efsanevi&r dereceli eşyalar elde edebileceğiniz en güçlü eşyalardandır! \n\n&6Efsaneviler&r yalnızca &lDünya Seviyesi: &6Zirve&r'de ve en sık görüldükleri &lDünya Seviyesi: &4Dorukta&r düşer. \n\n&6Tanrı İşlemeli İnciler&r, &c&lKurtarma Masasında&r &6Efsanevi&r &eeşyaları&r sökerek elde edilir."]
	quest.099C2A9B9CA138F8.quest_subtitle: "&6Efsanevi"
	quest.099C2A9B9CA138F8.title: "&6Tanrı İşlemeli İnci"
	quest.1403D677CF2815C3.quest_desc: ["&5&lYeniden Şekillendirme Masası&r, &9&lBasit&r olanın yaptığı her şeyi yapabilir, üstelik çok daha iyi! \n\nÖnceki seçeneklerimizin yanı sıra bize &5Destansı&r ve &6Efsanevi&r &eEkler&r de kazandırabilir!"]
	quest.1403D677CF2815C3.title: "Gelişmiş &5&lYeniden Şekillendirme Masası&r"
	quest.166CE4243896A0CD.quest_desc: ["&aDeğerli Taşlarınızı&r beğenmediniz mi? O zaman değiştirin! \n\n&aDeğerli Taşınızın&r nadirliğini değiştirmek için bu &a&lmasayı&r kullanmanız gerekecek. \n\nAynı &aDeğerli Taştan&r 2 adet ve nadirlik malzemeleri kullanarak &aDeğerli Taşınızın&r nadirliğini artırabilir ve böylece gücünü yükseltebilirsiniz."]
	quest.166CE4243896A0CD.title: "Daha İyi &aDeğerli Taşlar&r Elde Etme"
	quest.16C74B5F99AD6724.quest_desc: ["&8Sıradan&r, en temel nadirlik seviyesidir. Oyunun başında en sık karşılaşacağınız türdür fakat aynı zamanda en zayıf olanıdır. \n\n&8Sıradan&r dereceli eşyalar en çok &lDünya Seviyesi: &9Sığınak&r'ta karşınıza çıkar ve &lDünya Seviyesi: &6Zirve&r'den sonra artık düşmez. \n\n&8Gizemli Hurda Metaller&r, &c&lKurtarma Masasında&r &8Sıradan&r &eEşyaları&r sökerek elde edilir."]
	quest.16C74B5F99AD6724.quest_subtitle: "&8Sıradan"
	quest.16C74B5F99AD6724.title: "&8Gizemli Hurda Metaller"
	quest.196312DF0D2E2CB6.quest_desc: ["&4İstilacılar&r, &6&lApotheosis&r modundaki özel &4Patron&r yaratıklardır. \\n\\nHerhangi bir boyutta kendiliğinden doğabilen, özel efektlerle güçlendirilmiş ve üzerlerinde özel &eEkli Ekipmanlar&r taşıyan yaratıklardır. \\n\\nÇoğu, normal yaratıklara göre daha fazla cana, hasara ve etkiye sahiptir! Katledildiklerinde özel &eEkli Ekipmanlar&f ve &aDeğerli Taşlar&r düşürürler. \\n\\nNadirlikleri &6&lApotheosis&r seviye sistemine dayanır. Yaratığın nadirliği, üzerindeki teçhizatı ve istatistik bonuslarını belirler. \\n\\nBu nadirlik dağılımı ise mevcut &lDünya Seviyene&r bağlıdır! Dünya Seviyeleri bulabileceğin ganimetlerin ve karşına çıkacak patronların kalitesini belirler. \\n\\n&lDünya Seviyesi&r menüsünü açmak için Ctrl + T tuş kombinasyonunu kullanabilirsin."]
	quest.196312DF0D2E2CB6.title: "&4İstilacılar/Patronlar&r ve &lDünya Seviyeleri"
	quest.1CD05CB4A3DB112A.quest_desc: ["&c&lKurtarma Masası&r nihayet &7Örs&r kullanmadan Malzeme ve &9Değerli Değerli Taş Tozu&r elde etmenizi sağlar. \n\n&eEkli&r &eAletleri&f ve &eZırhları&f geri dönüştürerek malzemelerini alabilirsiniz. \n\nElde edeceğiniz malzemeler sökülen eşyanın nadirliğine bağlıdır; &8Sıradan&r eşyalar &8Sıradan&r malzemeler verir. \n\nVe nedense at/köpek zırhlarını da sökebilmektedir."]
	quest.1CD05CB4A3DB112A.title: "&c&lKurtarma Masası"
	quest.1D1FAA2F86695781.quest_desc: ["&l&2Sınır&r kademesinde eşya nadirlikleri çok kritik değildi ancak &l&eYükseliş&r kademesine geçmek için üzerindeki parçaların en az &aSıradan Olmayan&r veya daha yüksek kalitede olması gerekir. \\n\\nAyrıca Dünya Seviyeni yükseltmek için en az 1 &4İstilacı&r (Apothic Patronu) katletmelisin. Patronun nadirliği fark etmez! \\n\\nBu kademede &eEkli Eşyalar&r &5Destansı&r kaliteye kadar çıkabilir ve &9Nadir&r olanlar daha sık düşmeye başlar. Şansın yaver giderse son derece nadir olan &6Efsanevi&r &aDeğerli Taşlar&r bile düşürebilirsin! \\n\\nBonuslara gelince: Şans bonusun %30'a, tecrübe bonusun %55'e ve &aMaks Eterna&r sınırın &a60&r seviyesine yükselir. \\n\\nBuna karşılık &4Yaratıklar&r da fazladan 8 zırh puanı ve 5 zırh delme kazanır."]
	quest.1D1FAA2F86695781.title: "&lDünya Seviyesi: &eYükseliş"
	quest.2002C7EB13626AE7.quest_desc: ["&6&lGeliştirme Masası&r yakıt olarak &6Geliştirme Mühürleri&r kullanır. \n\nHer nitelik yenileme işlemi 1 &6Geliştirme Mührü&r, her yükseltme işlemi ise 2 mühür harcar! \n\n4 adet mühür üretmek için 1 adet &6Tanrı İşlemeli İnci&r gerekir."]
	quest.2002C7EB13626AE7.title: "&6Geliştirme Mührü"
	quest.22E57BF23B9BA2C5.quest_desc: ["&6&lApotheosis&r artık &aGeçitler (Gateways)&r ile entegre çalışır. \n\n&l&9Sığınak&r hariç her Dünya Seviyesine özel &ageçitler&r bulunur ve üzerinize canavar ile &4İstilacı&r dalgaları gönderir. Bu &ageçitler&r yalnızca ilgili &lDünya Seviyesinde&r aktif edilebilir. Son dalgayı temizlediğinizde, o kademedeki gelişiminize katkı sağlayacak zengin ödüller kazanırsınız. \n\nDiğer geçitlerin aksine, bu geçitlerde toplam 3 hakkınız (canınız) bulunur."]
	quest.24D11ED5F4EEDC48.quest_desc: ["&6&lApotheosis&r moduna yeni başlayanlar için &9Yuvalar&r kafa karıştırıcı ve can sıkıcı olabilir. \n\nKısacası, silah ve zırhlarınıza &aDeğerli Taşlar&r takabilmek için &9Yuvalar&r gerekir. \n\nPeki ya &9Yuvası&r yoksa? \n\nO zaman bir &9Yuvalama Mührüne&r ihtiyacınız olacak! \n\nEşyanızı ve mührü bir &8&lDemirci Masası&r'nda birleştirin ve bam, 2 adede kadar &9Yuva&r elde edebilirsiniz."]
	quest.24D11ED5F4EEDC48.title: "&9Yuvalama Mührü"
	quest.29EA8E178F8F8FDB.quest_desc: ["&9&lBasit Yeniden Şekillendirme Masası&r, &5&lBüyü Masası&r ile benzer mantıkta çalışır fakat eşyalara &eekler&r basmanızı sağlar. \n\nBir &eeşyaya&r ek eklemek için eşyayı orta yuvaya, nadirlik malzemesini ise sol yuvaya yerleştirin. \n\nKullandığınız malzeme, eşyaya hangi nadirlikte ek geleceğini belirler. Bu sayede &8Sıradan&r bir eşyayı &aSıradan Olmayan&r seviyeye yükseltebilirsiniz. \n\nTıpkı &5&lBüyü Masası&r'nda olduğu gibi 3 farklı ek seçeneği sunulur; alttaki seçenekler daha yüksek maliyetlidir. \n\n&9&lBasit Yeniden Şekillendirme Masası&r ile en fazla &9Nadir&r seviye ek basılabilir."]
	quest.29EA8E178F8F8FDB.title: "&9&lBasit Yeniden Şekillendirme Masası"
	quest.2A032EC573B5316C.quest_desc: ["&lDünya Seviyesi: &2Sınır&r seviyesine geçmek için öncelikle &9&lSığınak&r görevini tamamlamış olman ve belirli &eEkli Eşyalara&r sahip olman gerekir. \\n\\nNeler gerekli? Tam bir &eEkli Zırh seti&r ile birlikte 1 adet &eEkli Alet&f veya &eSilah&r. \\n\\nBu kademede &aSıradan Olmayan&r nadirlikteki &4İstilacılar&f ve &aDeğerli Taşlar&r ön plana çıkar. Sıralama: &8Sıradan&r, &9Nadir&r ve nadiren &5Destansı&r şeklindedir. \\n\\n&lDünya Seviyesi: &2Sınır&r seviyesindeki oyuncu %35 Tecrübe bonusu, %20 Şans bonusu ve toplam &a45 Maks Eterna&r tavan sınırı kazanır! \\n\\nAncak dikkat: Düşman &4Yaratıklar&r da fazladan 4 zırh puanı kazanarak biraz daha dayanıklı hale gelir."]
	quest.2A032EC573B5316C.title: "&lDünya Seviyesi: &2Sınır"
	quest.2E5E129F25707C5D.quest_desc: ["&6Yücelik Mührü&r! \n\nTıpkı &cKötülük Mührü&r gibi üretilemeyen bir başka mühürdür. &cKötülük Mührü&r gibi ekleri daha güçlü hale getirebilir. &cKötülük Mührü&r'nden farklı olarak, bunu ekipmandaki HER EKE yapar ve süreçte hiçbir eki feda etmez. \n\nBunu, &zApothic İstilacıların Sonsuz Geçidi&r'nin 100 dalgasını yenerek elde edebilirsiniz."]
	quest.377A41499D8218C9.quest_desc: ["İlk kademe olan &lDünya Seviyesi: &9Sığınak&r! Açılması ve ulaşılması en kolay kademedir. \\n\\nEtkinleştirmek için elinde herhangi bir &eEkli Eşya&r tutman yeterlidir! Kilit açıldığında kademen otomatik olarak ayarlanır. \\n\\n&lDünya Seviyesi: &9Sığınak&r kademesinde &8Sıradan&r kalitede &aEkipman&r ve &aDeğerli Taşlar&r ağırlıktadır. Bazen &aSıradan Olmayan&r, çok nadiren de &9Nadir&r ekipmanlar ve değerli taşlar düşebilir. \\n\\nBu kademede &aMaks Eterna&r tavan sınırın &a30&r olarak belirlenir. \\n\\nAyrıca bu kademe, tehlikeli &4İstilacıların&r doğal olarak doğmadığı tek güvenli kademedir."]
	quest.377A41499D8218C9.title: "&lDünya Seviyesi: &9Sığınak"
	quest.38956DC28E317DEF.quest_desc: ["&dYeniden Doğuş Mührü&r, tüm &l&9Yeniden Şekillendirme Masalarında&r kullanılan temel yakıttır. \n\nİşlem yapabilmek için elbette ilgili nadirlik malzemelerine ve dönüştürülecek eşyaya da ihtiyacınız olacak... Ancak neyse ki bu mühürleri üretmek oldukça kolaydır!"]
	quest.38956DC28E317DEF.title: "&dYeniden Doğuş Mührü"
	quest.3BF5B8DE7A1CC4D7.quest_desc: ["İyi bir ekipman istiyorsanız &6&lApotheosis Ekipmanlarına&r ihtiyacınız olacak ve her şey bir &aDeğerli Taş&r ile başlar! \n\n&aDeğerli Taşlar&r herhangi bir yaratıktan nadiren düşer, ayrıca &4İstilacılardan&r kesin olarak düşer. \n\nOnlar hakkında daha fazlasını ileride öğreneceksiniz, şimdilik o yaratıkları avlayın!"]
	quest.3BF5B8DE7A1CC4D7.title: "&6&lApotheosis Macerası"
	quest.45647395169978ED.quest_desc: ["&9Değerli Değerli Taş Tozu&r elde etmek için bir &6&lApotheosis&r &aDeğerli Taşı&r ve bir &7&lÖrs&r gerekir. \n\nHerhangi bir &6&lApotheosis&r &aDeğerli Taşı&r (Sadece &8Sıradan&f ve &aSıradan Olmayan&r olanlar önerilir)! \n\nDeğerli Taşlarınızı aldıktan sonra onları düşen bir &7&lÖrs&r ile ezin! \n\nArdından &9Değerli Değerli Taş Tozunuzu&r bir &c&lKurtarma Masası&r üretmek için kullanabilirsiniz."]
	quest.45647395169978ED.title: "&9Değerli Değerli Taş Tozu"
	quest.4E9DDDBD8263D0E3.quest_desc: ["&7İsim Kaldırma Mührü&r adının da belirttiği şeyi yapar; garip derecede uzun ismi olan bir &eEkli Eşyanız&r olduğunda, ismin çoğundan kurtulmak için bir &8&lDemirci Masası&r'nda mührü eşyayla birleştirebilirsiniz. \n\n(Yalnızca Malzeme, Eşya Türü ve Nadirlik rengi kalacaktır)."]
	quest.4E9DDDBD8263D0E3.title: "&7İsim Kaldırma Mührü"
	quest.552BA5E6FA987256.quest_desc: ["&cKötülük Mührü&r gizemli bir mühürdür. Kimse nasıl üretileceğini bilmez. &4İstilacılardan&r düştüğüne dair söylentiler dolaşır. \n\nNe yaptığı ise başka bir gizemdir; ancak bazı oyuncular kullanıldığında ekipmandan bir eki kaybettiğini ve başka bir eki daha güçlü hale getirdiğini keşfetmiştir. Bunun için seçilen ekler, tıpkı mührün kendisi gibi ayrı bir gizemdir."]
	quest.57BB2CC6D9D2AE87.quest_desc: ["Kusursuz &eEkler&r için gerçekten ihtiyacınız olan şey budur. \n\nÖncelikle &6&lMasa&r, bir Alet ve &6Geliştirme Mühürleri&r gerekir. \n\nTüm bunlara sahip olduğunuzda dünya sizindir! &eEkleri&r yeniden belirleyebilir, belirli bir &eEk&r seçebilir veya mevcut &eEkleri&r yükseltebilirsiniz!"]
	quest.57BB2CC6D9D2AE87.title: "&6&lGeliştirme Masası"
	quest.6667638252DB9C74.quest_desc: ["&8Mühürler&r, &6&lApotheosis&r &eEkli Eşyalarınızı&r değiştirmek için kullanılan eşyalardır; ister &9Yuvaları&r temizlemek, ister daha fazla &9Yuva&r eklemek veya İsmi kaldırmak olsun! \n\nHepsi eşyanızla birlikte bir &8&lDemirci Masası&r, &9&lYeniden Şekillendirme Masası&r veya &6&lGeliştirme Masası&r'nda kullanılır."]
	quest.6667638252DB9C74.quest_subtitle: "Artık sadece Mühürler!"
	quest.6667638252DB9C74.title: "&mŞişeler ve&r &8Mühürler"
	quest.6B5B01C612951BAF.quest_desc: ["Diğer Geçit İncilerinin aksine, bu inci &4&lDoruk&r Geçidini temizleyerek elde edilir. \n\nYine de çok yüksek cana sahip bir yaratık olan &zEbedi Craig&r'in kurban edilmesiyle gelir. \n\nBu geçit, her biri arasında giderek daha az zaman olan ve giderek güçlenen sonsuz bir dalga akını çağırır. Sadece kullandığınız boyuttan değil, HERHANGİ bir boyuttan &4İstilacılar&r doğurabilir. Bu aynı zamanda End dışından da Son Fırtına Değerli Taşları gibi normalde diğer boyutlara özel değerli taşları elde edebileceğiniz anlamına gelir. \n\n100 dalgayı yenmeyi başarabilirseniz elde edebileceğiniz şey..."]
	quest.6B5B01C612951BAF.title: "&zGeçit İncisi - Sonsuz Apothic İstilacı Geçidi"
	quest.6EF206A0BD5BAC0A.quest_desc: ["&5Destansı&r nihayet aşırı güçlü tarafa daha da yaklaşıyor. \n\n&5Destansı&r, &lDünya Seviyesi: &2Sınırdan&r sonra görünmeye başlar ve en çok &lDünya Seviyesi: &4Dorukta&r yaygındır. \n\n&5Arkane Kumlar&r, bir &c&lKurtarma Masasında&r &5Destansı&r &eEşyalar&r kullanılarak yapılır."]
	quest.6EF206A0BD5BAC0A.quest_subtitle: "&5Destansı"
	quest.6EF206A0BD5BAC0A.title: "&5Arkane Kumlar"
	quest.7080F026A37F1832.quest_desc: ["Bu görev, AllTheMods mod paketleri için &6AllTheMods Ekibi&r veya bir &2topluluk üyesi&r tarafından hazırlanmıştır. \n\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı kapsamındadır. Bu görevin &6AllTheMods Ekibi&r'nin izni olmadan başka genel paketlerde kullanılması yasaktır. \n\nBu görev kasıtlı olarak gizlenmiştir; bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.7C90008081DEBECA.quest_desc: ["&eAletleriniz&r ve &aDeğerli Taşlarınız&r var... peki bunları nasıl birleştireceğiz? \n\nÖncelikle &eAletinizde&r açık bir &9Yuva&r olduğundan emin olun. (&9Yuvalar&r hakkında daha fazlası için Mühürler bölümüne bakın). \n\nBiri açıksa, &eAletinizi&r ve &aDeğerli Taşınızı&r bir &8&lDemirci Masası&r'nda birleştirabilirsiniz. \n\nMevcut &aDeğerli Taşlarınızdan&r memnun değilseniz farklı bir Masaya ihtiyacınız olabilir!"]
	quest.7C90008081DEBECA.title: "&aDeğerli Taşları&r (ve Diğerlerini) Takma"
	quest.7CB03F92F9ECEFFB.quest_desc: ["Neyse ki &6&lApotheosis&r, &eAletlerden&r &9Yuvaları&r (değerli taşları) çıkarmayı çok daha kolay hale getirdi! \n\nArtık &eAleti&r mi yoksa &aDeğerli Taşı&r mı kurtaracağınızı seçmek zorunda kalmak yerine ikisini de tutabilirsiniz. \n\nBir &8&lDemirci Masası&r'nda &eEkli Alet&r ile &aÇıkarma Mührünü&r kullanın ve &aDeğerli Taşı&r ondan ayırın."]
	quest.7CB03F92F9ECEFFB.title: "&aÇıkarma Mührü"
	quest.7EF873DCEB3B9D48.quest_desc: ["Nihai kademe olan &lDünya Seviyesi: &4Doruk&r! Bu seviyeye ulaşmak için &d&lEnder Ejderhasını&r katletmiş olmalı ve tamamen &5Destansı&r veya &6Efsanevi&r nadirlikte &eZırh&f ve &eAlet/Silah&r kuşanmalısın. \\n\\nBu kademede &5Destansı&r ve &6Efsanevi&r kalitedeki eşyalar ile &aDeğerli Taşlar&r en yaygın düşenler olur; &zMükemmel&r değerli taş bulma ihtimalin artar. &8Sıradan&r ve &aSıradan Olmayan&r kaliteler artık düşmez (zaten kimse onları özlemez!) \\n\\nBonus olarak %125 Ekstra Tecrübe, %100 Şans bonusu ve &a100 Maks Eterna&r sınırı kazanırsın. \\n\\nDüşman &4Yaratıklar&r da son güçlendirmelerini alır: 16 zırh puanı, 20 zırh sertliği, 25 zırh delme ve 20 koruma delme."]
	quest.7EF873DCEB3B9D48.title: "&lDünya Seviyesi: &4Doruk"
	task.1F073FD0F4A296A3.title: "Apothic Geçitleri"
	task.31C72EBA091270E7.title: "Tüm Hakları Saklıdır"
	task.67D884FA6DD22065.title: "Herhangi Bir Apotheosis Değerli Taşı"
