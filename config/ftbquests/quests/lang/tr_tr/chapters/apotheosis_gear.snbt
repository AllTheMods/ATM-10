{
	chapter.0731FA8830F28280.title: "Apotheosis Ekipmanları"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	image.79376FBD521FA59D.title: "Supremacy Mührü"
	quest.001C1881E9289566.quest_desc: ["&9Rare&r, Nadirliklerin (Rarities) orta noktasıdır. \\n\\nTüm &lWorld Tiers&r'da (Dünya Seviyesi) görünür ancak en çok &lWorld Tier: &eAscent&r'da yaygındır. \\n\\n&9Luminous Crystal Shards&r, &c&lSalvaging Table&r içinde &9Rare&r &eItems&r kullanılarak yapılır."]
	quest.001C1881E9289566.quest_subtitle: "&9Rare"
	quest.001C1881E9289566.title: "&9Luminous Crystal Shard"
	quest.0089A394566B0F3B.quest_desc: ["&aUncommon&r, ikinci Nadirliktir. \\n\\n&lWorld Tier: &9Haven&r'da belirmeye başlar, en çok &lWorld Tier: &2Frontier&r'da bulunur ve &lWorld Tier: &4Pinnacle&r'da durur. \\n\\n&aTimeworn Fabric&r, &c&lSalvaging Table&r içinde &aUncommon&r &eItems&r kullanılarak yapılır."]
	quest.0089A394566B0F3B.quest_subtitle: "&aUncommon"
	quest.0089A394566B0F3B.title: "&aTimeworn Fabric"
	quest.097FDC136BC843A7.quest_desc: ["&lWorld Tier: &6Summit&r, &eArmor&r ve &eTool/Weapon&r'ını &aUncommon&r'dan &9Rare&r'a (veya daha iyisine) yükseltmeni gerektirecek! Ayrıca &0&lThe Wither&r'ı öldürmen gerekecek. \\n\\n&0&lThe Wither&r'ın bir &4Invader&r olması gerekmez ve dürüst olmak gerekirse olmaması daha kolay olacaktır. \\n\\n&6&lSummit&r'de &5Epic&r &eItems &fve &2Gems&r en yaygın olanları olacak ve &eItems&r için artık &6Mythic&r alabilirsin ve &aGems&r ile &zPerfect&r bulabilirsin. Yine ikisi de son derece nadirdir! \\n\\nArtık %75 Kazanılan Deneyim (Experience Gained), %50 Şans (Luck) ve &a75 Max Eterna&r elde edeceksin. \\n\\n&4Monsters&r (Canavarlar) ayrıca 12 Armor Points, 10 Armor Toughness, 15 Armor Pierce ve 10 Protection Pierce alacak şekilde güçlendirilecek. \\n\\nBana mı öyle geliyor yoksa onların yükseltmeleri bizimkilerden daha mı iyi?"]
	quest.097FDC136BC843A7.title: "&lWorld Tier: &6Summit"
	quest.099C2A9B9CA138F8.quest_desc: ["&6Mythic&r'ler elde edebileceğimiz en iyilerinden bazılarıdır! \\n\\n&6Mythic&r'ler yalnızca &lWorld Tier: &6Summit&r'de ve en yaygın oldukları &lWorld Tier: &4Pinnacle&r'da bulunur. \\n\\n&6Godforged Pearls&r, &c&lSalvaging Table&r içinde &6Mythic&r &eItems&r kullanılarak yapılır."]
	quest.099C2A9B9CA138F8.quest_subtitle: "&6Mythic"
	quest.099C2A9B9CA138F8.title: "&6Godforged Pearl"
	quest.1403D677CF2815C3.quest_desc: ["&5&lReforging Table&r, &9&lSimple&r olanın yaptığı her şeyi yapar ama daha iyi! \\n\\nÖncekilerle birlikte bize &5Epic&r ve &6Mythic &eAffixes&r verebilir!"]
	quest.1403D677CF2815C3.title: "(Daha İyi) &5&lReforging Table&r"
	quest.166CE4243896A0CD.quest_desc: ["&aGems&r'lerini sevmiyor musun? O zaman onları değiştir! \\n\\n&aGem&r'inin Nadirliğini (Rarity) değiştirmek için bu &a&lTable&r'ı kullanman gerekecek. \\n\\nAynı &aGem&r'den 2 tane ve Nadirlik Materyalleri kullanarak &aGems&r Nadirliğini artırabilirsin ve bu da onun gücünü artırır."]
	quest.166CE4243896A0CD.title: "Daha iyi &aGems&r Almak"
	quest.16C74B5F99AD6724.quest_desc: ["&8Common&r en temel Nadirliktir. Bu, oyunda erken bulunmasını en yaygın, ancak aynı zamanda en zayıf olanı yapar. \\n\\n&8Common&r en çok &lWorld Tier: &9Haven&r'da ortaya çıkar ve &lWorld Tier: &6Summit&r'den sonra görünmeyi bırakır. \\n\\n&8Mysterious Scrap Metals&r, &c&lSalvaging Table&r içinde &8Common&r &eItems&r kullanılarak yapılır."]
	quest.16C74B5F99AD6724.quest_subtitle: "&8Common"
	quest.16C74B5F99AD6724.title: "&8Mysterious Scrap Metals"
	quest.196312DF0D2E2CB6.quest_desc: ["&4Invaders&r, &6&lApotheosis&r &4Bosses&r olarak bildiğimiz şeylerdir. \\n\\nBunlar herhangi bir Boyutta (Dimension) doğabilen (spawn) yaratıklardır ve her zaman güçlendirilmiş (buffed) olacaklar ve &eAffixed Items&r kuşanmış olacaklardır. \\n\\nÇoğu normal Yaratıklardan (Mobs) daha fazla Kalbe, Hasara ve Etkiye sahip olacak! Öldürüldüklerinde &eAffixed Items&f ve &aGems&r düşürecekler (drop). \\n\\n&6&lApotheosis&r Nadirlikleriyle aynı hizada kendi Nadirlikleri vardır. Nadirlikleri neyle doğacaklarını ve statülerini belirler. \\n\\nNadirlikleri &lWorld Tier&r tarafından belirlenir! &lWorld Tiers&r, &6&lApotheosis&r'e yeni eklemelerdir, Ganimetin (Loot) ve bulabileceğin &4Bosses&r'ların Nadirliğini değiştireceklerdir. \\n\\n&lWorld Tier&r Menüsüne erişmek için CTRL'ye basılı tut ve T'ye bas."]
	quest.196312DF0D2E2CB6.title: "&4Invaders/Bosses&r ve &lWorld Tiers"
	quest.1CD05CB4A3DB112A.quest_desc: ["&c&lSalvaging Table&r, nihayet &7Anvils&r kullanmadan sana Materyaller ve &9Gem Dust&r kazandırabilir. \\n\\nMateryallerini almak için &eAffixes&r'li &eTools &fve &eArmor&r'ı geri dönüştürebilirsin. \\n\\nAldığın Materyaller Eşyanın Nadirliğine bağlıdır, &8Common&r Eşyalar &8Common&r Materyaller verecektir. \\n\\nVe nedense At/Köpek Zırhını (Armor) da parçalayabilirsin."]
	quest.1CD05CB4A3DB112A.title: "&c&lSalvaging Table"
	quest.1D1FAA2F86695781.quest_desc: ["&l&2Frontier&r için &eAffixes&r'in Nadirliği önemli değildi, ama şimdi &l&eAscent&r için her şeyin &aUncommon&r veya daha iyi olması gerekecek. \\n\\nAyrıca &lWorld Tier&r'ını yükseltmek için bir &4Invader&r, yani bir &6&lApothic&r Patronu (Boss) öldürmen gerekecek. &4Boss&r'un Nadirliği önemli değil! \\n\\n&eAffixes&r sadece &5Epic&r'e kadar kalacak ancak artık &9Rare&r diğerlerinden daha yaygın. Ayrıca &6Mythic&r &aGems&r da alabiliriz... ama sadece Lady Luck'ın Lütfu (Lady Luck's Favor) ile! \\n\\nŞanstan bahsetmişken, Şansımız (Luck) %30'a çıkacak, Deneyim (Experience) %55'e fırlayacak ve &aMax Eterna&r &a60&r'a yükselecek. \\n\\nBuna karşılık &4Monsters&r artık 8 Armor Points ve 5 Armor Pierce'a sahip olacak."]
	quest.1D1FAA2F86695781.title: "&lWorld Tier: &eAscent"
	quest.2002C7EB13626AE7.quest_desc: ["&6&lAugmenting Table&r'ın çalışması için farklı bir Yakıta ihtiyacı vardır ve bu Yakıt &6Sigils of Enhancement&r'dır. \\n\\nHer Yeniden Zar Atma (Reroll) 1 &6Sigil of Enhancement&r'a mal olurken, her Yükseltme (Upgrade) 2'ye mal olacak! \\n\\n4 tanesi için bir &6Godforged Pearl&r'e ihtiyacın olacak."]
	quest.2002C7EB13626AE7.title: "&6Sigil of Enhancement"
	quest.22E57BF23B9BA2C5.quest_desc: ["&6&lApotheosis&r artık &aGateways&r ile entegre.\\n\\nHer &lWorld Tier&r'a (&l&9Haven&r hariç) dayalı, canavar ve &4Invaders&r dalgaları sağlayan &aGateways&r vardır. Bu &aGateways&r yalnızca ilgili &lWorld Tier&r'ları içinde kullanılabilir. Son dalgayı yendiğinde, kendi ilgili &lWorld Tier&r'ını tamamlamak için yararlı olan çeşitli ödüller kazanırsın.\\n\\nDiğer &aGateways&r'lerden farklı olarak, çalışabileceğin toplam 3 canın vardır."]
	quest.24D11ED5F4EEDC48.quest_desc: ["&6&lApotheosis&r'e yeni başlayanlar için &9Sockets&r kafa karıştırıcı ve sinir bozucu olabilir. \\n\\nKısacası, Silahlarının ve Zırhının &aGems&r kullanması için &9Sockets&r'a ihtiyacı var. \\n\\nPeki ya &9Socket&r'ı yoksa? \\n\\nO zaman bir &9Sigil of Socketing&r'e ihtiyacın olacak! \\n\\nBir &8&lSmithing Table&r'da eşyanı ve &9Sigil&r'i birleştir ve bum, 2'ye kadar &9Sockets&r elde edebilirsin."]
	quest.24D11ED5F4EEDC48.title: "&9Sigil of Socketing"
	quest.29EA8E178F8F8FDB.quest_desc: ["&9&lSimple Reforging Table&r bir &5&lEnchantment Table&r gibi kullanılır ama &eAffixes&r ile! \\n\\nHerhangi bir &eItem&r'a bir &eAffix&r eklemek için &eItem&r'ı orta Yuvaya (Slot) yerleştir. Ardından Nadirlik Materyalini sol Yuvaya ekle. \\n\\nNadirlik Materyali, &eItem&r'ında hangi Nadirlikte &eAffix&r elde edeceğini belirleyecektir. Bu, &8Common&r'dan &aUncommon&r'a gibi bazı Eşyaları yükseltmek için kullanılabilir. \\n\\nSeçebileceğin 3 &eAffixes&r seçeneği alacaksın, ayrıca bir &5&lEnchantment Table&r'a benzer şekilde ikinci ve üçüncü daha pahalı hale gelir. \\n\\n&9&lSimple Reforging Table&r ile sadece &9Rare&r &eAffixes&r'a kadar alabiliriz."]
	quest.29EA8E178F8F8FDB.title: "&9&lSimple Reforging Table"
	quest.2A032EC573B5316C.quest_desc: ["&lWorld Tier: &2Frontier&r elde etmek için elbette &9&lHaven&r'ın yapılmış olması gerekir, ama aynı zamanda birkaç &eAffixed Items&r'e de ihtiyacın var! \\n\\nKaç tane? Tam bir &eAffixed Armor&r setinin yanı sıra bir &eAffixed Tool &fveya &eWeapon&r'a ihtiyacın var. \\n\\nArtık &aUncommon&r &4Invaders &fve &aGems&r en bol olanları, geri kalanı ise şu sırayla geliyor: &8Common&r, &9Rare&r ve ayrıca &5Epic&r. \\n\\n&lWorld Tier: &2Frontier&r'a sahip Oyuncu toplamda %35 Deneyim (Experience) Artışı, %20 Şans (Luck) ve &a45 Max Eterna&r alacaktır! \\n\\nHey, her şey kolay olmayacak gerçi, artık &4Monsters&r (Canavarlar) fazladan 4 Armor Points kazanacak."]
	quest.2A032EC573B5316C.title: "&lWorld Tier: &2Frontier"
	quest.2E5E129F25707C5D.quest_desc: ["&6Sigil of Supremacy&r!\\n\\nÜretilemeyen başka bir mühür, tıpkı &cMalice&r gibi. &cMalice&r gibi ekleri (affixes) daha güçlü hale getirebilir. &cMalice&r'dan farklı olarak, bunu teçhizattaki HER eke (affix) yapar ve süreçte hiçbirini feda etmez.\\n\\nBunu &zEndless Gateway of Apothic Invaders&r'ın 100 dalgasını geçerek elde edebilirsin. "]
	quest.377A41499D8218C9.quest_desc: ["İlk &lWorld Tier&r &l&9Haven&r! İlk olması, keşfetmesi ve elde etmesi en kolay olanıdır. \\n\\nBunu elde etmek için Elinde bir &eAffixed Item&r tutman yeterli! Kilidi açıldığında otomatik olarak ayarlanacaktır. \\n\\n&lWorld Tier: &9Haven&r, &8Common&r &aGear&r &fve &aGems&r için en yüksek şansa sahiptir. Ayrıca &aUncommon&r ve çok nadiren &9Rare&r olabilir.\\n\\n&aMax Eterna&r'n da bu &lWorld Tier&r'da &a30&r olarak ayarlanmıştır.\\n\\nBu ayrıca &4Invaders&r'ın doğal olarak doğamadığı (spawn) tek &lWorld Tier&r'dır."]
	quest.377A41499D8218C9.title: "&lWorld Tier: &9Haven"
	quest.38956DC28E317DEF.quest_desc: ["&dSigil of Rebirth&r, tüm &l&9Reforging Tables&r için Yakıttır (Fuel). \\n\\nÇalışmaları için hala diğer Materyale ve açıkçası değişeceği Eşyaya ihtiyaçları var gerçi... \\n\\nEn azından Üretilmeleri görece daha kolay!"]
	quest.38956DC28E317DEF.title: "&dSigil of Rebirth"
	quest.3BF5B8DE7A1CC4D7.quest_desc: ["Eğer iyi bir teçhizat istiyorsan &6&lApotheosis Gear&r'a ihtiyacın olacak ve her şey bir &aGem&r ile başlar! \\n\\n&aGems&r, herhangi bir Mob'dan (Yaratık) Nadir Düşen (Rare Drops) ganimetlerdir, aynı zamanda &4Invaders&r'dan da kesin Düşen ganimetlerdir. \\n\\nBunlar hakkında daha sonra daha fazla bilgi edineceksin, şimdilik o Yaratıkları kesmeye devam et (Farm those Mobs)!"]
	quest.3BF5B8DE7A1CC4D7.title: "&6&lApotheosis Macerası"
	quest.45647395169978ED.quest_desc: ["&9Gem Dust&r elde etmek için bir &6&lApotheosis&r &aGem&r ve bir &7&lAnvil&r'a (Örs) ihtiyacın var. \\n\\nHerhangi bir &6&lApotheosis&r &aGem&r (Sadece &8Common &fve &aUncommon&r önerilir)! \\n\\n&aGems&r'lerini aldıktan sonra onları düşen bir &7&lAnvil&r ile parçala! \\n\\nArdından, &c&lSalvaging Table&r Üretmek için &9Gem Dust&r'ını kullanabilirsin."]
	quest.45647395169978ED.title: "&9Gem Dust"
	quest.4E9DDDBD8263D0E3.quest_desc: ["&7Sigil of Unnaming&r adından da anlaşılacağı gibi yapar, garip derecede uzun bir adı olan &eAffixed Item&r'ın olduğunda, ismin çoğundan kurtulmak için onu bir &8&lSmithing Table&r'da &7Sigil&r ile birleştirebilirsin. \\n\\n(Nadirlik rengiyle olduğu gibi sadece Materyal ve Eşya Türü kalacaktır)."]
	quest.4E9DDDBD8263D0E3.title: "&7Sigil of Unnaming"
	quest.552BA5E6FA987256.quest_desc: ["&cSigil of Malice&r gizemli bir mühürdür. Nasıl üretileceğini kimse bilmiyor. &4Invaders&r tarafından düşürüldüğü (dropped) hakkında söylentiler dolaşıyor.\\n\\nNe yaptığı da başka bir gizemdir, ancak bazı oyuncular onu kullandıkları teçhizattan bir ekin (affix) kaybolduğunu ve başka bir ekin daha güçlü hale geldiğini gördüler. Bunun için seçilen ekler, tıpkı mührün kendisi gibi, henüz bir başka gizemdir."]
	quest.57BB2CC6D9D2AE87.quest_desc: ["Mükemmel &eAffixes&r için gerçekten buna ihtiyacın var. \\n\\nÖnce &6&lTable&r, bir Alet (Tool) ve &6Sigils of Enhancement&r'a ihtiyacın var. \\n\\nTüm bunlara sahip olduğunda, dünya senin! &eAffixes&r'leri Yeniden Zar Atabilir (reroll), belirli bir &eAffix&r seçebilir veya ayarlanmış &eAffixes&r'leri yükseltebilirsin!"]
	quest.57BB2CC6D9D2AE87.title: "&6&lAugmenting Table"
	quest.6667638252DB9C74.quest_desc: ["&8Sigils&r, &6&lApotheosis&r &eAffixed Items&r'larını değiştirmek için kullanılan eşyalardır; ister &9Sockets&r temizlemek, ister daha fazla &9Sockets&r eklemek veya İsmi (Name) kaldırmak olsun! \\n\\nHepsi Eşyanla birlikte bir &8&lSmithing Table&r, &9&lReforging Table&r veya &6&lAugmenting Table&r'da kullanılır."]
	quest.6667638252DB9C74.quest_subtitle: "Artık Sadece Sigil'ler!"
	quest.6667638252DB9C74.title: "&mVials and&r &8Sigils"
	quest.6B5B01C612951BAF.quest_desc: ["Diğer Gate Pearls'den farklı olarak, bu &4&lPinnacle&r Gateway temizlenerek (clearing) elde edilir.\\n\\nAncak çok fazla canı olan &zCraig the Eternal&r'ı feda etmen gerekecek.\\n\\nBu geçit (gateway), aralarındaki süre gittikçe azalan, sonsuz bir giderek ölçeklenen dalga akışı çağıracaktır. Sadece onu kullandığın boyuttan değil, HERHANGİ bir boyuttan &4Invaders&r doğurabilir (spawn). Bu aynı zamanda The End dışındaki Endersurge Gems gibi normalde diğer boyutlara özel olan mücevherleri (gems) elde edebileceğin anlamına da gelir.\\n\\nEğer 100 dalgayı yenebilirsen, şunu elde edebilirsin..."]
	quest.6B5B01C612951BAF.title: "&zGate Pearl - Endless Gateway of Apothic Invaders"
	quest.6EF206A0BD5BAC0A.quest_desc: ["&5Epic&r nihayet daha çok aşırı güçlü (overpowered) tarafa tırmanıyor. \\n\\n&5Epic&r, &lWorld Tier: &2Frontier&r'den sonra ortaya çıkar ve en yaygın olarak &lWorld Tier: &4Pinnacle&r'da görülür. \\n\\n&5Arcane Sands&r, &c&lSalvaging Table&r içinde &5Epic&r &eItems&r kullanılarak yapılır."]
	quest.6EF206A0BD5BAC0A.quest_subtitle: "&5Epic"
	quest.6EF206A0BD5BAC0A.title: "&5Arcane Sands"
	quest.7080F026A37F1832.quest_desc: ["This Quest has been authored by &6AllTheMods Staff&r, or a &2Community contributor&r for use in AllTheMods Modpacks. \\n\\nAs all &6AllTheMods&r packs are licensed under &eAll Rights Reserved&r, this Quest is not allowed to be used in any public packs not released by &6AllTheMods Team&r without explicit permission. \\n\\nThis quest is intentionally hidden, if you're seeing this, you're in editing mode."]
	quest.7C90008081DEBECA.quest_desc: ["&eTools&r ve &aGems&r'lerin var... peki bunları nasıl birleştiririz? \\n\\nİlk olarak, &eTool&r'unun açık bir &9Socket&r'ı olduğundan emin ol. (&9Sockets&r hakkında daha fazla bilgi için Sigils bölümüne bak). \\n\\nEğer biri açıksa, &eTool&r'unu ve &aGem&r'ini bir &8&lSmithing Table&r'da birleştirebilirsin. \\n\\nEğer mevcut &aGems&r'lerinden memnun değilsen o zaman farklı bir Table'a ihtiyacın olabilir!"]
	quest.7C90008081DEBECA.title: "&aGems&r (ve diğerlerini) Uygulamak"
	quest.7CB03F92F9ECEFFB.quest_desc: ["Neyse ki &6&lApotheosis&r &9Sockets&r'ları &eTools&r'dan çıkarmayı çok daha kolay hale getirdi! \\n\\nArtık &eTool&r'u mu yoksa &aGem&r'i mi kurtaracağını seçmek zorunda kalmak yerine ikisini de saklayabilirsin. \\n\\nBir &8&lSmithing Table&r'da &eAffixed Tool&r ile &aSigil of Withdrawal&r kullan ve &aGem&r'i ondan ayıracaksın."]
	quest.7CB03F92F9ECEFFB.title: "&aSigil of Withdrawal"
	quest.7EF873DCEB3B9D48.quest_desc: ["Son &lWorld Tier&r, &lWorld Tier: &4Pinnacle&r. Bunu elde etmek için, &d&lEnder Dragon&r'ı en az bir kez Öldürmen ve tümü &5Epic&r veya &6Mythic&r &eArmor &fve &eTool/Weapon&r kuşanman (equip) gerekecek. \\n\\nArtık &5Epic&r ve &6Mythic&r, &aGems &fve &eTools&r için en yaygın olanlarıdır, üstelik &zPerfect&r gems elde etme olasılığımız daha yüksektir! Bu, &8Common&r ve &aUncommon&r'ın kaybıyla gelir, ama hey, kim onları özler ki! \\n\\nAynı yükseltme modelinde %125 Kazanılan Deneyim (Experience Gained) ve %100 Şans (Luck) artışı elde edeceksin ve &aMax Eterna&r en yüksek noktasına, &a100&r'e ulaşacak. \\n\\n&4Monsters&r (Canavarlar) son yükseltmelerini alacaklar ve şunları elde edecekler: 16 Armor Points, 20 Armor Toughness, 25 Armor Pierce ve 20 Protection Pierce."]
	quest.7EF873DCEB3B9D48.title: "&lWorld Tier: &4Pinnacle"
	task.1F073FD0F4A296A3.title: "Apothic Gateways"
	task.31C72EBA091270E7.title: "AllRightsReserved"
	task.67D884FA6DD22065.title: "Any Apotheosis Gem"
}
