	quest.6ED2CDD01659FD10.quest_desc: ["Bu zırh seti Iron ile aynı Zırh Puanına sahiptir ancak hem Sertlik hem de Geri İtme Direnci açısından daha iyidir."]
	quest.6ED2CDD01659FD10.quest_subtitle: "15"
