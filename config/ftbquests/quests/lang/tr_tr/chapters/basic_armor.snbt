{
	chapter.4791C8461B1B4D5F.title: "Temel Zırh"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	quest.004D61425172324F.quest_desc: ["&8Zincir Zırh&r Demirden biraz daha kötüdür. &l&2Minecraft&r'daki asıl kullanım alanı, yalnızca Ticaret ve Yaratık Düşürmeleri yoluyla elde edilebildiği için nadir olmasıydı. \\n\\nElbette bu modlanmış sürüm; artık üretebiliriz! Bu da kullanım amacını ortadan kaldırıyor..."]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8Zincirmail Zırh"
	quest.041ED280691BB05D.quest_desc: ["&9Froststeel&r, &2&lUndergarden&r'ın Soğuk Biyomlarında yaygın bir Cevherdir. "]
	quest.041ED280691BB05D.quest_subtitle: "18"
	quest.041ED280691BB05D.title: "&9Froststeel Zırhı"
	quest.04B31A600004F7CB.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Team&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, bunu görüyorsan düzenleme modundasın."]
	quest.055CCAE237DF3EEF.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ironwood.png width:100 height:150 align:center}"]
	quest.055CCAE237DF3EEF.title: "&8Ironwood"
