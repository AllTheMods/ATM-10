	quest.6F335B4F3FD660E7.quest_desc: ["Bunları elde etmek eğlenceli değildir. \\n\\n&aZırh Shard Kümes&r'ı Eriterek elde edilen &aKnightmetal Külçeler&r'lara ihtiyacın olacak. \\n\\n9 &aZırh Shards&r'ı birleştirerek &aZırh Shard Kümes&r elde edersin. \\n\\n&aZırh Shards&r, &l&9Twilight Forest&r Goblinlerinden ve nadiren Miğfer Yengeçlerinden düşer."]
	quest.6F335B4F3FD660E7.quest_subtitle: "20"
	quest.6F335B4F3FD660E7.title: "&aKnightmetal Zırh"
	quest.6F76DA3BBAE8337B.quest_desc: ["&6&lAllthemodium&r'dan elde edebileceğimiz en harika Zırh, &5Unobtainium&r! \\n\\nŞimdi %100 Geri İtme Direnci ve her yerde daha yüksek istatistiklerle! \\n\\nAyrıca yapmak için &3Vibranium Zırh&r gerekir."]
