	quest.08C870DC50CA49FC.quest_desc: [
		"&#5C5C5CCrude Oil&r kendi başına bizim için pek kullanışlı değildir ancak bir Distillery'den geçirildiğinde, birçok amaç için kullanılabilecek çıktılar elde ederiz."
		""
		"Onunla &#C4C241Sulfuric Heavy Fuel&r, &#CECC5FSulfuric Light Fuel&r ve &#D9D782Sulfuric Naptha&r üretebiliriz."
	]
	quest.08C870DC50CA49FC.title: "&#5C5C5CCrude Oil İşleme"
	quest.0903F0D8642449B7.quest_desc: ["&6Analog circuitry&r'den geçerek, artık 2 bit'ten daha fazla bilgiyi işleyebiliriz. Bu, bazı yeni makineler için ufuklar açar."]
	quest.0A9ADDE68342B987.quest_desc: [
		"&#43DEC2Polyethylene&r yapmak için, bu kimyasal zincirini şu şekilde takip edersiniz:"
		""
		"&8Crude oil&r -> &#D2CD2DSulfuric Light Fuel&r-> &#DBD658Light Fuel&r-> &#E2DF78Steam Cracked Light fuel&r -> &#44D1DBEthylene&r -> &#43DEC2Polyethylene&r."
	]
	quest.0C94D76B87E49FFD.title: "Iron İşleme"
	quest.103728F2BAD5AE84.title: "Gelişmiş Bileşenler"
	quest.1351D0594F1E6551.quest_desc: ["Bu &#55EDA4basic components&r bizi işlemede bir sonraki büyük gelişmeye götürecek."]
	quest.1351D0594F1E6551.title: "Circuit Components"
	quest.162807D14C173CB4.quest_desc: ["&#5599EDCentrifuge&r, bir şeyi yeterince hızlı döndürürsek içinden yeni bir materyalin düşeceği teorimizi doğruladı. Çok fazla kullanımı var ancak buna esas olarak &#F2AAE5Chromium&r ve &#AD3497Monazite&r işleme için ihtiyacınız olacak. "]
	quest.162807D14C173CB4.quest_subtitle: "Başımı döndürüyorsun.."
	quest.1745124F83D033B9.title: "Basic Components"
	quest.18C0EF38430C3E67.quest_subtitle: "Dijital Çağ"
	quest.1A84DF4478D55C41.quest_subtitle: "Buhar olanla aynı"
	quest.1B4CD5AC8F6C3307.quest_desc: ["&#4497DBOverdrive module&r, tarif şu anda çalışmıyor olsa bile makinenin verimliliğini korur. Buna karşılık, makineyi mevcut tarifine kilitler ve her zaman güç kullanmasına neden olur."]
	quest.1E0EF28175A7424F.quest_desc: ["Zaten Steam ürettiğinize göre, neden onu elektrik yapmak için kullanmıyorsunuz. Sadece bir &#6363DBTurbine&r yerleştirin ve içine &7Steam&r koyup &#DBDB63elektrik&r çekin."]
	quest.1E0EF28175A7424F.quest_subtitle: "Steam -> Elektrik"
	quest.1F21B578FAF4CCAC.quest_subtitle: "Buhar olanla aynı"
	quest.1F3E18129B871C49.quest_subtitle: "Buhar olanla aynı"
	quest.22AD9DF2BCC04575.quest_subtitle: "Enerji üretimi"
	quest.22AD9DF2BCC04575.title: "Elektrik Üretimi"
	quest.24285F25F9563B02.quest_desc: ["&#467FDB&nAnalog Circuit&r, ah! sonunda başardın. Genelde diğer insanlar senin harcadığın zamanın yarısını harcardı ama bunu sana karşı kullanmayacağım..."]
	quest.24285F25F9563B02.quest_subtitle: "Elektroniğin Temelleri"
	quest.256C3DBA392B4236.quest_desc: ["Manganese ve Chromium için Asidik Çözeltileri elektroliz etmek, size gelecekteki tarifler için kullanılabilecek Dust formlarını verecektir."]
	quest.256C3DBA392B4236.quest_subtitle: "9 Tiny Dust 1 Dust verir"
	quest.2EF0C033C540A7B1.title: "Ruby İşleme"
	quest.32D585D9F73CD9FD.quest_desc: ["&#EDDF55Electric Blast Furnace&r, birkaç farklı kaynağı pişirmenizi sağlayacak. Tarifler, yapıda kullanılmak üzere &#B8ED55spesifik bir coil&r gerektirir."]
	quest.374C06B3999BB0D3.quest_desc: ["&#C2C78BIron&r, &#EDB2EAChromium&r, &#BEC9A3Nickel&r ve &7Manganese&r'i birlikte karıştırmak size &#ADF0EEStainless Steel Dust&r verecektir."]
	quest.3A03852E282DAA4D.quest_desc: ["&#ED8055Electrolyzer&r, materyale daha temel kaynaklara ayrılmaları için patlamalar halinde yeterli enerjiyi sağlayabilir."]
	quest.3B9D9CB589DB2003.quest_desc: [
		"&#71EBB4&nModern Industrialization&r makineleri diğer modlardan farklı çalışır. Tüm makinelerin bir &#E5EB71verimlilik çarpanı&r vardır, makinede yaptığı bir tarif olduğunda bu artar. &#E5EB71Verimlilik&r, makinenin &#E5EB71hızını&r artırır. Tarif değiştiğinde &#E5EB71verimlilik&r sıfırlanır."
		""
		"Pasif olarak bileşenler üreten 1 tarif için 1 makine kullanmanız tavsiye edilir. Modun bu şekilde oynanması gerekmektedir. Upgrades sistemi daha iyi hale getirecektir. Bu konu gelecekte ele alınacaktır."
		""
		"{image:atm:textures/questpics/modernindustrialization/prod_line.png width:100 height:100 align:center}"
		""
		"{@pagebreak}"
		"Bu moddaki tüm makineler güç olarak FE kabul eder. &c16 FE&r, &#E1EB591 EU&r güce dönüştürülür."
	]
	quest.3B9D9CB589DB2003.quest_subtitle: "Bu yardımcı olacak"
	quest.3CE72DAF431269CD.quest_desc: ["&#D6AC2FPolarizer&r içine konulan materyalleri manyetize edebilir."]
	quest.401A3FD6A3511870.quest_subtitle: "Açıl Susam Açıl"
	quest.401A3FD6A3511870.title: "Gates"
	quest.401B559649C54C5C.quest_desc: ["&#92CCF0Hydrogen&r ve &#519BC9Chlorine&r'i birlikte karıştırmak size &#4FB373Hydrochloric Acid&r verecektir. Bu, &#F2A0E1Chromium Dust&r'ı işlemek için kullanılacaktır."]
	quest.408EBED932656006.quest_desc: ["&7Silicon&r'u katkılamak (doping), temel &7Silicon&r kullanmaktan çok daha iyi bir verim almanızı sağlayacaktır."]
