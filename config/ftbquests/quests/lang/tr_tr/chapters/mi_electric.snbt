	]
	quest.548274CC00E67EC4.quest_desc: ["Elektriği aktarmak basittir, sadece &#F5B027Generators&r ve &#3CC1FAMachines&r arasına bir kablo yerleştirirsiniz. LV kabloları en fazla &#EEFA3C256 EU/t&r aktarabilir."]
	quest.548274CC00E67EC4.quest_subtitle: "Kablo Limitleri"
	quest.548274CC00E67EC4.title: "LV Cables"
	quest.54CE9493B63620C4.quest_desc: ["&#AC59EBDiesel Generator&r, çeşitli sıvı yakıtları elektriğe dönüştürür. Başlangıçta sizin için en erişilebilir olanlar &7Creosote Oil&r ve &8Synthetic Oil&r olacaktır."]
	quest.54CE9493B63620C4.quest_subtitle: "Sıvı Yakıtlar -> Elektrik"
