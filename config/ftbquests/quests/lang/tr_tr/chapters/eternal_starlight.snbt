{
	chapter.6AEC23C6D526F362.title: "Eternal Starlight"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.00453FF528AA0B1C.quest_desc: ["&7Lonestar Skeletons&r, herhangi bir yerde ortaya çıkabilen düşmanca Yaratıklardır. \\n\\n10 &4Hearts&r'a sahiptirler ve size saldırmak için Sword'larını fırlatırlar. \\n\\nÖldüklerinde Bones, &7Deepsilver Nuggets&r ve &7Shattered Swords&r düşürebilirler."]
	quest.00453FF528AA0B1C.title: "&7Lonestar Skeletons"
	quest.00FDBA93722ACECE.title: "&4Amaramber Hoe"
	quest.011FCC180FF3BD83.title: "&9Malarite Sword"
	quest.01F322AEFCC6109E.quest_desc: ["Tangled Skulls, pekala Tangled Skulls'dan düşebilir. \\n\\nBir Wither'dan fırlatılan bir Wither Head gibi mermi olarak kullanılabilirler. \\n\\nAncak bunu yaptığınızda tükenirler."]
	quest.02414CBEF2CD5A9D.title: "&7Deepsilver Sword"
	quest.028472D7F51D439A.title: "&aFlowglaze Scythe"
	quest.02B574B09AB45D09.quest_desc: [
		"&bFreezes&r, &cBlazes&r'a benzer çalışır, havaya uçarlar ve size bir top fırlatırlar. \\n\\nSadece &bFreezes&r tek 1 top fırlatır ve bu sizi ısıtmak yerine üşütür. \\n\\n16 &4Hearts&r'a sahiptirler ve öldüklerinde &bFrozen Tubes&r düşürürler."
		"{image:atm:textures/questpics/eternal/starlight_freeze.png width:150 height:100 align:center}"
	]
	quest.02B574B09AB45D09.title: "&bFreeze"
	quest.0342248394E40B6A.quest_desc: ["Bu Görev, AllTheMods Mod Paketlerinde kullanılmak üzere &6AllTheMods Staff&r veya &2Community contributor&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eAll Rights Reserved&r lisansına sahip olduğundan, bu Görevin açık izin olmadan &6AllTheMods Team&r tarafından yayınlanmayan herhangi bir genel pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.03B40AB768FC0161.quest_desc: [
		"&3Shimmer Rivers&r, dost canlısı nehirlerdir. Bunlar sizi öldürmek için yollarından sapmazlar. \\n\\nBazen &bSeas&r'ı birbirine bağlarlar ve ormanların içinden geçerler. \\n\\nBelli ki &9Water&r'a sahipler ama &9Water&r'ın içinde bol miktarda ganimet var!"
		"{image:atm:textures/questpics/eternal/starlight_river.png width:200 height:100 align:center}"
	]
	quest.03B40AB768FC0161.title: "&3Shimmer River"
	quest.0576C32B0FB360B0.quest_desc: [
		"&l&9Lunar Monstrosity&r 200 &4Hearts&r'a sahiptir ve Fire kullanmadığınız sürece her vuruştan sadece 1 hasar alır. \\n\\nGround Spikes, Projectiles ve Exploding Tangled Heads dahil olmak üzere birkaç saldırısı vardır! \\n\\nOnu öldürdüğünüzde, Arrows, Ingots, Tangled Skulls, &9Tenacious Petals&r, &5Tenacious Vines&r, &9Soul Dew&r ve nadir bir Silah şansı düşürür!"
		"{image:atm:textures/questpics/eternal/starlight_lunar.png width:100 height:125 align:center}"
	]
	quest.0576C32B0FB360B0.title: "&9&lLunar Monstrosity"
	quest.061C4A9E439CE09B.title: "&9Malarite Shovel"
	quest.0688CE330DAF8714.title: "&cStarfire Hoe"
	quest.06D3EC025557855F.title: "&7Deepsilver Axe"
	quest.0720474D384F4774.quest_desc: ["&eMarimold&r, su altında büyüyen mantarlardır. \\n\\nOnların büyük ve küçük versiyonlarını bulabilirsiniz. \\n\\nBloklar &6Honey&r ve &eShroomlights&r karışımı gibi görünür."]
	quest.0720474D384F4774.title: "&eMarimold"
	quest.0854589F28AAA8D0.title: "&dStarlit Diamond Hoe"
	quest.09981C89C585002E.title: "&bGlacite Helmet"
	quest.09C3C0F0278C842F.title: "&4Amaramber Chestplate"
	quest.0BB8D556305EB307.quest_desc: [
		"Ether River gördüğünüzde tanıyacağınız bir şeydir. \\n\\nParlaktır, çok parlaktır ve Map'inizde kırmızı görünebilir, bu bir hata, görmezden gelin."
		"{image:atm:textures/questpics/eternal/starlight_ether.png width:200 height:100 align:center}"
	]
	quest.0BB8D556305EB307.title: "Ether River"
	quest.0C096EE635645E43.quest_desc: ["&dCrystal &bCrossbow&r, sopalar yerine &bCrystals&r kullanılarak &7Mechanical &3Crossbow&r gibi üretilir. \\n\\nArrows atar ve normal bir Crossbow ile aynı hasarı verir ama bu Crystal Infection verir. Crystal Infection, üzerlerinde beliren Crystals ile her saniye 1 hasar verir! Ve evet onları öldürecektir."]
	quest.0C096EE635645E43.title: "&dCrystal &bCrossbow"
	quest.0CFAAF6F13EB6C2C.title: "&cStarfire Hammer"
	quest.0D1C143B2C788204.quest_desc: ["&5Seekers&r, &9&lStarlight&r'da herhangi bir yerde belirebilen Düşmanca Yaratıklardır. \\n\\n12 buçuk &4Hearts&r'a sahiptirler ve etrafta uçarlar. \\n\\nYakınlara uçarak ve size dillerini fırlatarak size saldırırlar. \\n\\n&5Seekers&r, ayrıca &5Seeking Eyes&r toplamak için harika bir yoldur!"]
	quest.0D1C143B2C788204.title: "&5Seekers"
	quest.0D427BD581ADC3A6.title: "&aFlowglaze Pickaxe"
	quest.0E1C2DA415D5742D.title: "&bGlacite Sword"
	quest.0F0D41F29386333A.quest_desc: ["&dScarlet Trees&r'ın boyutu ve şekli değişir ve hatta bazen yıkılmış halde bulunurlar! \\n\\nAncak hepsinin &dpink Leaves&r'ı vardır! Yerdekiler de dahil."]
	quest.0F0D41F29386333A.title: "&dScarlet Trees"
	quest.0F4783FA019C4567.quest_desc: ["&4Amaramber&r, nadiren &cTorreya Logs&r soyularak bulunur. \\n\\nZırh ve Aletler yapmak için Ingots haline getirilebilir veya size yenilenme kazandıracak bir kamp ateşi gibi diğer tariflerde kullanılabilir!"]
	quest.0F4783FA019C4567.title: "&4Amaramber"
	quest.0F812AE4F247FF1C.title: "&bGlacite Chestplate"
	quest.0F8955B74DBDF5F9.title: "&cStarfire Scythe"
	quest.0FE15701F2EDC3E9.quest_desc: ["Bir &5Aethersent Block&r'u bir &5Lunaris Cactus Fruit&r ile üst üste koyarak bir &5Aethersent Golem&r yapabiliriz! \\n\\nBu kötü çocuğun tek bir görevi var, &5Meteor Showers&r'dan &5Creteor&r belirmesini engellemek. \\n\\nEğer bir &5Meteor Shower&r olursa, onlar daha belirmeden önce onları vurarak düşürecektir!"]
	quest.0FE15701F2EDC3E9.title: "&5Aethersent Golem"
	quest.10AB188AC6FB24D3.quest_desc: [
		"&b&lStarlight Golem&r 220 &4Hearts&r'a ve 2 Moda sahiptir. \\n\\n1. mod saldırı modudur, burada hasar alamaz, bunun yerine ona vurmadan önce saldırılarının geçmesini beklemeniz gerekir. Fireballs, Ground Pound veya yıkıcı bir Laser Beam ile saldırır! \\n\\n2. mod şarj olma modudur; bunda ona hasar vermek için kapatılması gerekecek olan Energy Blocks'dan güç almaya başlayacaktır. \\n\\nÖldüğünde bol miktarda Ingots ve Arrows, &bGolem Steel&r, Forge Armor Trim ve hatta belki de Energy Sword düşürecektir!"
		"{image:atm:textures/questpics/eternal/starlight_golem.png width:150 height:100 align:center}"
	]
	quest.10AB188AC6FB24D3.title: "&b&lStarlight Golem"
	quest.10D78DC368E16987.title: "&aFlowglaze Axe"
	quest.11783E5EF07481C3.title: "&aFlowglaze Bow"
	quest.127D085D6C9DB690.quest_desc: ["&eSaltpeter&r yeraltında herhangi bir yerde bulunabilir ancak &dWarm Shore&r Biyomunda çok yaygındır. \\n\\nKazmak için bir Stone Pickaxe gerekir ve kazıldığında birkaç &eSaltpeter Powder&r düşürür. Evet, Fortune bunun üzerinde işe yarar! \\n\\n&ePowder&r diğer Niters'lar için bir yedek olarak kullanılabilir."]
	quest.127D085D6C9DB690.title: "&eSaltpeter Powder"
	quest.144ECED643031A9A.quest_desc: ["Glowing Mushrooms, Scarlet Forests'da bulabileceğiniz devasa Mantar bitkileridir! \\n\\nTipik Brown veya Red Mushrooms gibi işlev görürler ancak bunlar çok daha parlak bir Glow yayarlar! \\n\\n(Bilmiyorsanız Brown ve Red Mushrooms aslında 1 seviyesinde bir Light Source yayar)."]
	quest.15195F456D8AD4C8.quest_desc: ["Ether &9Water&r'a dokunduğunda, &aThioquartz&r oluşur. Bu rastgele üretim ile doğal olarak gerçekleşebilir veya bunu siz gerçekleştirebilirsiniz! \\n\\nAncak Shards'ı bu şekilde elde etmiyoruz, onlar &aBudding Thioquartz&r'dan gelir!"]
	quest.15195F456D8AD4C8.title: "&aThioquartz"
	quest.1533D98B3B2A758E.quest_desc: ["&7Shattered Swords&r ya &7Lonestar Skeletons&r'dan düşürülebilir ya da düşen &7Blades&r kullanılarak üretilebilir. \\n\\n&7Shattered Sword&r, bir Kılıçtan çok bir Trident gibi kullanılır, vurmak yerine onu fırlatırsınız. Ardından, bir Loyalty Trident gibi &7Blade&r'i geri getirmek için Sağ Tıklayabilir ve gerekirse yeniden yüklemek için tekrar Sağ Tıklayabilirsiniz."]
	quest.1533D98B3B2A758E.title: "&7Shattered Sword"
	quest.17A8E4151DE37015.quest_desc: ["&cStarfire&r Tools ve Weapons yapmak için önce yükseltmek üzere &6Thermal Springstone&r Tools'a ihtiyacınız olacak. Ardından, &cUpgrade Template&r. \\n\\n&cStarfire Upgrade Template&r Patron Yapılarında bulunur: &9Cursed Garden&r ve &bGolem Forge&r."]
	quest.17A8E4151DE37015.title: "&cStarfire Template"
	quest.17D82EEA20D02EC8.quest_desc: ["&bSea&r tabanını kaplayan şey &5Dusted Gravel&r'dır. \\n\\nNormal &7Gravel&r yerine kullanılabilir ve nadiren diğer Blocks'ları yapabilen &5Dusted Shards&r düşürebilir!"]
	quest.17D82EEA20D02EC8.title: "&5Dusted Gravel"
	quest.17EC65B33AC5F0B4.quest_desc: [
		"&8Thirst Walkers&r, &5Crystallized Deserts&r yüzeyinde beliren tarafsız Yaratıklardır. \\n\\nKışkırtıldıklarında size vururlar ve Hunger verirler. \\n\\n20 &4Hearts&r'a sahiptirler ve öldüklerinde &8Tooth of Hunger&r düşürebilirler."
		"{image:atm:textures/questpics/eternal/starlight_thirst.png width:100 height:125 align:center}"
	]
	quest.17EC65B33AC5F0B4.title: "&8Thirst Walker"
	quest.1815A439BA9879B7.quest_desc: [
		"&dWarm Shore&r oldukça sıkıcı bir Biyomdur ve çoğunlukla &bStarlit Sea&r ile karayı birbirine bağlamak içindir. \\n\\nAltında Stone olan &dTwilight Sand&r'a sahiptir. Ayrıca burada normalden daha fazla &eSaltpeter&r buldum."
		"{image:atm:textures/questpics/eternal/starlight_shore.png width:200 height:100 align:center}"
	]
	quest.1815A439BA9879B7.title: "&dWarm Shore"
	quest.18AA0B2E9C3B912A.quest_desc: ["O bir &9Snail&r. \\n\\nShell ve Meat düşürecektir."]
	quest.18AA0B2E9C3B912A.title: "&9Shadow Snail"
	quest.19B8871B701F11F4.title: "&dStarlit Diamond Pickaxe"
	quest.19F7BAD1150A2107.quest_desc: ["&cStarfire&r! \\n\\nHayır, Teen Titans veya Teen Titans Go'daki gibi değil. Bu, Tools ve Weapons yapmak için kullanılabilen bir malzemedir veya..."]
	quest.19F7BAD1150A2107.title: "&cStarfire"
	quest.1A95BFE57029F9C4.quest_desc: ["Tuff Golem'i alamadığımız için üzgün müsünüz? Endişelenmeyin, &7Grimstone Golem&r'imiz var! \\n\\nTam olarak aynı şeyi yapıyor, sadece orada duruyor ve bir Block veya Item tutuyor. \\n\\n&7Grimstone Bricks&r üzerine sadece bir &5Lunaris Cactus Fruit&r yerleştirin ve elde edeceksiniz."]
	quest.1A95BFE57029F9C4.title: "&7Grimstone Golem"
	quest.1AAFC306507DFCF8.title: "&bGlacite Scythe"
	quest.1AB17923F87AE264.quest_desc: [
		"Yeti, Soğuğu keşfeden herkesin içine korku salan bir isimdir! En zorlu, en soğuk iklimde yaşayan, oraya gitmeye cesaret eden her şeyi yiyen iğrenç tüylü bir yaratık! \\n\\nEh bu Yeti değil, bunlar sevimli ve arkadaş canlısı! Sizi yemektense etrafta yuvarlanmayı tercih ederler. \\n\\nHatta karşılık bile vermezler ve sadece 10 &4Hearts&r'a sahiptirler. \\n\\nÖldüklerinde Fur'larını ve String'lerini düşürürler, ilki Wool yerine kullanılabilir."
		"{image:atm:textures/questpics/eternal/starlight_yeti.png width:100 height:100 align:center}"
	]
	quest.1AB17923F87AE264.title: "Yetis"
	quest.1AFCA421A6A50DA4.quest_desc: ["&aFlowglaze Upgrade Template&r ayrıca Patron Yapılarında da Belirir: &9Cursed Garden&r ve &bGolem Forge&r. \\n\\n&aFlowglaze Weapons&r yapmak için &bGlacite&f'e &aFlowglaze&f ve &aUpgrade Template&f uygulamanız gerekecek."]
	quest.1AFCA421A6A50DA4.title: "&aFlowglaze Template"
	quest.1C863B4BC6EAD1CD.title: "&9Malarite Sickle"
	quest.1E7B5CDF0D5F833F.title: "&7Deepsilver Pickaxe"
	quest.1EA98CFE85035939.title: "&5Aethersent Bottoms"
	quest.1ECD4331DDFBBB52.quest_desc: ["&cTorreya Trees&r, yaklaşık 40 Blok uzunluğunda olan devasa mor/pembe Ağaçlardır. \\n\\nLeaves her yöne doğru filizlenir ve onlardan &eTorreya Vines&r sarkar."]
	quest.1ECD4331DDFBBB52.title: "&cTorreya Trees"
	quest.20D705C99BD11F18.title: "&cStarfire Axe"
	quest.252AD9C886DE45C8.quest_desc: [
		"&9Twilight Gaze&r, &5The Abyss&r'de bulunan tarafsız bir Fish'tir. \\n\\nBirine vurursanız, Wolves veya Zombified Piglins'e benzer şekilde hepsi size saldırır. Eğer &5The Abyss&r'den çok uzaklaşırsanız sizi takip etmeyi bırakıp derinliklere geri yüzerler. \\n\\nÖldüklerinde hiçbir şey düşürmezler, bu yüzden onlara vurmasanız iyi olur..."
		"{image:atm:textures/questpics/eternal/starlight_gaze.png width:150 height:100 align:center}"
	]
	quest.252AD9C886DE45C8.title: "&9Twilight Gaze"
	quest.2583E4890619044E.title: "&6Thermal Springstone Sword"
	quest.25B45E8FBC9705B3.title: "&dStarlit Diamond Axe"
	quest.25E782DB4309A1B8.quest_desc: ["&3Aurora Deer Antlers&r öldüklerinde &3Aurora Deers&r tarafından düşürülür. \\n\\nBir Sword veya Hoe olarak kullanılabilir."]
	quest.25E782DB4309A1B8.title: "&3Aurora Deer Antlers"
	quest.271A112ABDD923A6.quest_desc: ["Normal Mangrove gibi ama bunlar çirkin değil."]
	quest.271A112ABDD923A6.title: "&9Banyin Trees"
	quest.27D8E62556F7CE8D.title: "&6Thermal Springstone Hoe"
	quest.282AEEC832FFC8D7.title: "&4Amaramber Axe"
	quest.2872C4229702B077.title: "&bGlacite Pickaxe"
	quest.29283BF1B6ED3634.quest_desc: ["&7Mechanical &3Crossbow&r, sadece &bGolem Steel&r kullanılarak normal bir Crossbow gibi yapılır. \\n\\nNormal bir Crossbow gibi çalışır ama çok daha güçlüdür! Ve daha fazlasını yapması için büyülenebilir!"]
	quest.29283BF1B6ED3634.title: "&7Mechanical &3Crossbow"
	quest.298963543B99734E.quest_desc: ["&bStarlit Seas&r kendi Coral versiyonlarını üretir! \\n\\nSadece benim gibi olmayın ve onları almak için Silk Touch'ı unutmayın..."]
	quest.298963543B99734E.title: "Coral Blocks"
	quest.29A1E1FF02BD9219.quest_desc: [
		"Okyanus kadar mavi bir &3Forest&r. \\n\\n&3Starlight Forest&r açık ara &9&lStarlight&r'daki en yaygın biyomdur. \\n\\nTamamını kaplayan düzinelerce &3Lunar Trees&r'a ve altında pasif ve düşmanca bolca Mobs'a sahiptir."
		"{image:atm:textures/questpics/eternal/starlight_forest.png width:200 height:100 align:center}"
	]
	quest.29A1E1FF02BD9219.title: "&3Starlight Forest"
	quest.29EC143D7E0347DE.quest_desc: ["&8Dagger of Hunger&r, &8Teeth of Hunger&r ile yapılır. Hayır, Dişler demiyorum. \\n\\n&8Dagger&r'ın bir Hunger Value'su vardır. Mobs'lara vurduğunuzda bu değer artacak, inaktif olduğunda azalacaktır. %100'e ulaştığında güçlendirmeler alacaksınız. Ve eğer %0'a düşerse sizi öldürmeye başlayacaktır. \\n\\nMobs'lara (veya Players'lara) vurduğunuzda, ayrıca Hunger etkisi de verecektir. \\n\\nOnu suçlamıyorum, ben de acıktığımda sinirlenirim."]
	quest.29EC143D7E0347DE.title: "&8Dagger of Hunger"
	quest.2A14A47E40A97329.title: "&aAlchemist Mask"
	quest.2D457E53BB6D63C7.quest_desc: [
		"&9&lStarlight&r'daki en yüksek noktalar, Mountains üzerinde bulunan Permafrost Forests'dur. \\n\\nBu kadar yüksekte olmak onları çok daha soğuk yapar ve Snow ve Ice ile kaplanmalarına neden olur! \\n\\nEn azından arkadaş canlısı Mobs'lar soğuğun tadını çıkarıyor gibi görünüyor!"
		"{image:atm:textures/questpics/eternal/starlight_permafrost.png width:200 height:100 align:center}"
	]
	quest.2D457E53BB6D63C7.title: "Permafrost Forest"
	quest.2DA8CE213AC3869B.quest_desc: ["&bStarlight &dCrystals&r, &5Crystallized Deserts&r'ın her yerinde ve hatta altında bulunabilir. \\n\\n&5Amethyst&r'e benzer şekilde çalışırlar ve hatta kulağa onun gibi gelirler!"]
	quest.2DA8CE213AC3869B.title: "&bStarlight &dCrystals"
	quest.2E29DC243E8AD61E.quest_desc: [
		"&9Shimmer Lacewings&r hiçbir şey yapmazlar veya düşürmezler, sadece atmosfere katkı sağlarlar. \\n\\nAyrıca tahammül ettiğim tek böceğe benziyorlar!"
		"{image:atm:textures/questpics/eternal/starlight_shimmer.png width:150 height:100 align:center}"
	]
	quest.2E29DC243E8AD61E.title: "&9Shimmer Lacewing"
	quest.2E9D3DA2DF3E3AC9.quest_desc: ["&5Petal &bScythe&r, vurduğu her şeye Poison verir. \\n\\nJEI Farmland yapabildiğini söylüyor ama oyunda yapmıyor... \\n\\n&9Water&r'a Vurulduğunda bir sürü Particles ortaya çıkacaktır. \\n\\nBu Item'ın bittiğini sanmıyorum."]
	quest.2E9D3DA2DF3E3AC9.title: "&5Petal &bScythe"
	quest.2F3E7233129F2B89.quest_desc: [
		"Tam olarak bir Luminofish gibi davranırlar, sadece bunların kafasında bir boynuz vardır!"
		"{image:atm:textures/questpics/eternal/starlight_fish2.png width:100 height:100 align:center}"
	]
	quest.2F3E7233129F2B89.title: "Luminaris"
	quest.306A5B38B52F65F3.title: "&4Amaramber Pickaxe"
	quest.3124D945A54938C2.quest_desc: ["Swamp Silver eskiden &9Swamps&r'da Belirirdi ancak terfi etti (ya da rütbesi düştü bilmiyorum) ve her yerde Belirmeye başladı, şimdi &9Swamps&r'da &9Malarite&r Belirecek. "]
	quest.3124D945A54938C2.title: "&9Malarite"
	quest.315F1CB8158DFB92.title: "&5Aethersent Hood"
	quest.31DDEA54B6E81EEE.title: "&7Deepsilver Helmet"
	quest.337D376BE2653F0F.title: "&bGlacite Boots"
	quest.34119FC1728B75B9.title: "&4Amaramber Helmet"
	quest.342EEB042DEC2B8C.quest_desc: ["Magma ve Geysers ikisi de &5The Abyss&r'in tabanında belirir. \\n\\nMagma aşağı inmenize ve nefesinizi korumanıza yardımcı olacaktır. \\n\\nGeysers sadece havalı görünüyor!"]
	quest.342EEB042DEC2B8C.title: "Magma and Geysers"
	quest.34D7CA6F99B29C87.title: "&2Air Sac Mask"
	quest.362F4CFD1B8B12B1.quest_desc: ["Tüm canlılar Ether içinde Lava'ymış gibi ölecektir. Komik bir şekilde onu bir Bucket'a koyabilirsiniz! \\n\\nOnu elde etmenin tek yolu onu Ether River'da bulmaktır. \\n\\nWater Ether'e dokunduğunda &aThioquartz Blocks&r oluşturacaktır!"]
	quest.36BCCF7395658A5C.quest_desc: ["&9&lStarlight&r'daki Bosses yapıları içinde yaşar. Bunlar yaygın değildir (neyse ki) bu yüzden yardıma, diğer bir deyişle Seeking Eyes'a ihtiyacınız olabilir. \\n\\nSeeking Eyes, &aEnder Eyes&r gibi çalışır, fırlatmak için onlara Sağ Tıklayın ve yapılara gitmek için onları takip edin. \\n\\nYapıyı ayarlamak için Sol Elinizde (Offhand) belirli bir Item'a ihtiyacınız olacak, şunun gibi öğelere..."]
	quest.36BCCF7395658A5C.title: "Finding the Bosses"
	quest.37355F60E45777FE.quest_desc: ["&3Orb of Prophecy&r üretilebilir veya &7&lGatekeeper&r'ı yenerek elde edilebilir! \\n\\nTemel kullanımı Portal'ı etkinleştirmektir, ancak daha fazla kullanımı olacaktır!"]
	quest.37355F60E45777FE.title: "&3Orb of Prophecy"
	quest.373CA701008A9584.quest_desc: ["&4Wilted Crossbow&r için hem &9&lLunar Monstrosity&r hem de &b&lStarlight Golem&r'in öldürülmesi gerekir. \\n\\n&4Wilted Crossbow&r normal bir Crossbow gibidir, sadece her Arrow Wither ve Slowness hasarı verir."]
	quest.373CA701008A9584.title: "&4Wilted Crossbow"
	quest.375F0A098589CF29.quest_desc: [
		"Seeking Eyes'ı kullanırken neden aniden yeraltına indiklerini merak edebilirsiniz. Bunun nedeni muhtemelen &bGolem Forge&r'un yeraltının derinliklerinde, negatif Y seviyelerinde olmasıdır. \\n\\nHer biri Loot, &cLava&f ve &bFreezes&r ile dolu birçok kıvrımlı oda var! Aradığımız oda &b&lStarlight Golem&r'i tutuyor!"
		"{image:atm:textures/questpics/eternal/starlight_golemforge.png width:200 height:100 align:center}"
	]
	quest.375F0A098589CF29.title: "&bGolem Forge"
	quest.378A7484CF999F03.quest_desc: ["Bunlar minik su altı bebek evleri için mükemmel olurdu! \\n\\nTarihte bunu bir fikir olarak düşünen tek bir kişi bile varsa..."]
	quest.378A7484CF999F03.title: "&dSpiral Kelp"
	quest.37E49A1A6BA0E28D.title: "&5Aethersent Cape"
	quest.38CF9E6E7490BD50.title: "&6Thermal Springstone Hammer"
	quest.39796595B42BB41E.quest_desc: ["&7Energy &bBoomerang&r, &8Golem Steel&r'den yapılmış eşsiz bir Weapon'dır. \\n\\nKullanmak için Sağ Tıklamanız yeterlidir. Bu onu Fırlatacaktır. \\n\\nDiğer tüm Boomerang'lar gibi (benim fırlattıklarım hariç), size geri dönecektir. Yaklaşık 10 Blok sonra veya bir Block'a Çarparsa geri gelecektir. \\n\\nEğer bir Mob'a Çarparsa Hasar Verir ve onları Ateşe Verir."]
	quest.39796595B42BB41E.title: "&7Energy &bBoomerang"
	quest.3991EEEFDD263A91.quest_desc: [
		"&9Nightfall Spiders&r, tıpkı &7Lonestar Skeletons&r gibi Düşmancadır ve her yerde belirirler. \\n\\n5 &4Hearts&r'a sahiptirler ve size vurarak saldırırlar. Size vurduktan sonra birkaç saniyeliğine size Glowing etkisi verirler. \\n\\nÖldüklerinde String ve gözlerini düşürürler!"
		"{image:atm:textures/questpics/eternal/starlight_spider.png width:100 height:100 align:center}"
	]
	quest.3991EEEFDD263A91.title: "&9Nightfall Spiders"
	quest.3A33514BD62CD7D9.title: "&bGlacite Axe"
	quest.3A6C912577A615EE.title: "&dStarlit Diamond Sword"
	quest.3AFEE53B4276F8CA.quest_desc: ["Sonunda, bir Tool! \\n\\n&3Underminer&r bir Pickaxe'dir. Hilesi şudur ki, Y Seviyeniz ne kadar düşükse, o kadar hızlı kazar. \\n\\nPeki ne kadar alçakta olduğunu nereden biliyor?"]
	quest.3AFEE53B4276F8CA.title: "&3Underminer"
	quest.3BAF4078F5776809.title: "&6Thermal Springstone Chestplate"
	quest.3C37018123D3653C.title: "&2Air Sac Boots"
	quest.3C74DAE7EC844A98.quest_desc: ["&3Lunar Berries&r mükemmel bir Yemek Kaynağıdır, ayrıca elde etmesi de çok kolaydır! \\n\\n&3Lunar Tree Leaves&r'den aşağı doğru büyürler, &eGlow Berries&r gibi &3Berries&r'leri Sarmaşıklardan (Vines) koparabilirsiniz. \\nSadece bunlar çok daha fazla Yemek Puanı ve Doygunluk sağlar!"]
	quest.3C74DAE7EC844A98.title: "&3Lunar Berries"
	quest.3CAD0701EC16C2D8.quest_desc: [
		"&9Dark Swamps&r, &9&lStarlight&r dünyasını kaplar. \\n\\nBurada bolca bitki, hayvan ve tabii ki Mud bulabilirsiniz."
		"{image:atm:textures/questpics/eternal/starlight_swamp.png width:200 height:100 align:center}"
	]
	quest.3CAD0701EC16C2D8.title: "&9Dark Swamp"
	quest.3D26E7BFE0AA964A.quest_desc: [
		"Luminofish, &5The Abyss&r içinde yaşayan parlayan bir balıktır.\\n\\nTam olarak normal Fish gibi davranırlar. Onlar için balık tutabilir, onları bir Bucket'a koyabilir, hatta pişirebilirsiniz!"
		"{image:atm:textures/questpics/eternal/starlight_fish1.png width:100 height:100 align:center}"
	]
	quest.3D26E7BFE0AA964A.title: "Luminofish"
	quest.3D4032E7119AF8B7.quest_desc: ["&5Sonar Bombs&r, &dCrystallized Moths&r'dan düşen &9Shivering Gel&r ile yapılır. \\n\\nDevasa bir alandaki herhangi bir Mob'a (ve Player'a) zarar vermek için fırlatılabilirler! Ayrıca oyuncuların ekranını sallar ve yüksek bir ses efekti oynatırlar. \\n\\nDikkat dağıtıcıdır, bu yüzden onu yalnızca arkadaşlarınızın üzerinde kullanın!"]
	quest.3D4032E7119AF8B7.title: "&5Sonar Bomb"
	quest.3D7CEED6B974ED8C.title: "&5Aethersent Boots"
	quest.40786B63E2901D11.quest_desc: [
		"&9Cursed Garden&r'ı nasıl tarif ederim bir bakalım... Bu kocaman lanet bir labirent! \\n\\nHer tarafta girişler var ve &9&lLunar Monstrosity&r'nin bulunduğu ortadaki yolu bulmalısınız!\\n\\nLabirentin her yerinde Loot ve &9Tangled&r ile dolu sandıklar bulabilirsiniz!"
		"{image:atm:textures/questpics/eternal/starlight_maze.png width:150 height:150 align:center}"
	]
	quest.40786B63E2901D11.title: "&9Cursed Garden"
	quest.40C776497D68367F.quest_desc: ["Vines, &dRed &fve &bBlue Crystal Moss Carpets&r, &3Lunar Berries&r, Cave Moss ile &dRed &fve &bBlue Crystal Roots&r. \\n\\nBunlar, &9Cursed Garden&r'ı bulmak için Sol Elinizde (Offhand) Seeking Eye ile kullanılabilir."]
	quest.40C776497D68367F.title: "&9&lMonstrosity&r Items"
	quest.41197BEBED4A9B69.title: "&7Deepsilver Hoe"
	quest.4147D247E4D754D0.quest_desc: [
		"&7Gleeches&r, &5Crystallized Desert&r'da beliren küçük yaratıklardır. \\n\\nAcımasızca kanınızı isterler ve bu şiddet içeren yollar anlamına gelse bile. Neyse ki sadece 4 &4Hearts&r'a sahipler! \\n\\nÖldüklerinde, mermi olarak fırlatılabilen &7Eggs&r'lerini düşürebilirler."
		"{image:atm:textures/questpics/eternal/starlight_gleech.png width:100 height:100 align:center}"
	]
	quest.4147D247E4D754D0.title: "&7Gleech"
	quest.41C70F0873E14307.quest_desc: ["Çölde Ağaçlar var! \\n\\nHayır, bekleyin, Ağaçlar vardı..."]
	quest.41C70F0873E14307.title: "&8Dead Lunar Log"
	quest.429785E8F64929CE.quest_desc: ["&9&lStarlight Dimension&r'a gitmek için &2&lOverworld&r'da &7Portal Ruins&r bulmanız gerekecek. \\n\\nOrada bir &7&lGatekeeper&r bulacaksınız, bir sohbet başlatmak ve onları düelloya davet etmek için Sağ Tıklayın! Dikkatli olun, onlar çok zorludurlar. \\n\\nGatekeeper ayrıca Ender Dragon'ı yendiyseniz sizi değerli görecek ve düelloyu atlamanıza izin verecektir.\\n\\nDüelloyu kazandığınızda, &3Orb of Prophecy&r başta olmak üzere birkaç Items hediye edilecektir. &7Portal&r'ı etkinleştirmek için &3Orb&r ile Sağ Tıklayın! Ardından, şuraya gitmek için içeri girin..."]
	quest.429785E8F64929CE.title: "The Gatekeeper and The Gate"
	quest.45AA690C89BF6845.title: "&6Thermal Springstone Leggings"
	quest.45B0442B80A7C7FB.title: "&9Malarite Axe"
	quest.45D73CA0A7BE4666.quest_desc: [
		"&eLush Shallow Sea&r isminin hakkını veriyor, bol miktarda Bitki yaşamı barındırıyor ve o kadar da derin değil! \\n\\nSadece yaklaşık 20 Blok derinliğinde."
		"{image:atm:textures/questpics/eternal/starlight_shallow.png width:200 height:100 align:center}"
	]
	quest.45D73CA0A7BE4666.title: "&eLush Shallow Sea"
	quest.46E32356964E56A0.title: "&7Deepsilver Leggings"
	quest.470EA6870DBBB352.title: "&7Deepsilver Chestplate"
	quest.474C8AF9D536D4E7.title: "&6Thermal Springstone Shovel"
	quest.47CB136D7764B86D.quest_desc: ["&eTorreya Vines&r, &cTorreya Trees&r'den sarkar halde bulunur. \\n\\nSarkıyorlar çünkü başka türlü yerleştirilemiyorlar... \\n\\nAltlarındaki ampul Light yayar!"]
	quest.47CB136D7764B86D.title: "&eTorreya Vines"
	quest.47DF2314B10146E9.title: "&6Thermal Springstone Pickaxe"
	quest.484ABFF266C8791E.quest_desc: ["&eOrbflora&r, &bSea&r tabanından büyüyen bitkilerdir. \\n\\nİstedikleri zaman hasat edilebilirler ancak &eOrbflora Lights&r'ı istiyorsanız beklemeniz gerekecek! \\n\\nSea Level'a kadar büyüdüklerinde çiçek açacaklardır. Çiçek açtıktan sonra &eLight&r yetiştireceklerdir!"]
	quest.484ABFF266C8791E.title: "&eOrbflora"
	quest.49D1EA8E812A12F6.quest_desc: ["Sadece hoş bir bitki. \\n\\nOnu toplamak için bir Sickle'a ihtiyacınız olacak! \\n\\nNedenini bilmiyorum, bitkileri hiç umursamadım ama Reeds bana havalı geliyor. Belki de &9Water&r kenarında olmasındandır veya Cattails'in Corndogs'a benzemesindendir. Bilmiyorum ama onları seviyorum."]
	quest.49DC0BD7DC1B893C.quest_desc: ["&5The Abyss&r, &bStarlit Seas&r içindeki derin çukurlardır. Bunlar -50'ye kadar iniyor! \\n\\nBunları hizalayan çok sayıda renkli Stone katmanına sahipler ve birçok farklı Blocks, Mosses ve Fish barındırıyorlar!"]
	quest.49DC0BD7DC1B893C.title: "&5The Abyss"
	quest.4A54288FD22C903D.quest_desc: ["&2Velvetumoss&r, &5The Abyss&r içinde belirir. \\n\\n&2green&r olanları kazarak yenilebilen veya &aSlimeball&r yapılabilen &2Velvetumoss Balls&r elde edebilirsiniz! \\n\\n&4Red&r olanlar güzel bitkiler ortaya çıkaracaktır!"]
	quest.4A54288FD22C903D.title: "&2Velvetumoss &fand &4Red &fversion"
	quest.4A5EA948F5DCEB73.quest_desc: ["&7Deepsilver&r eskiden Swamp Silver olarak adlandırılırdı ve yalnızca &9Dark Swamps&r'da Belirirdi. \\n\\nArtık yeraltının her yerinde bulunuyor... İsimlerini değiştirmelerinin nedeni muhtemelen budur!"]
	quest.4A5EA948F5DCEB73.title: "&7Deepsilver"
	quest.4B097031A3EE930B.title: "&bGlacite Hoe"
	quest.4B13835110F1FE82.title: "&7Deepsilver Sickle"
	quest.4C23D7E3DC8327C2.quest_desc: ["&9&lLunar Monstrosity&r'yi öldürmek için onu Ateşe vermeniz gerekecek! \\n\\nFlint and Steel veya &eSaltpeter Matchbox&r kullanabilirsiniz. \\n\\nKişisel olarak &eMatchbox&r'ın daha uygun olduğunu düşünüyorum!"]
	quest.4C23D7E3DC8327C2.title: "Burn it!"
	quest.4C72D2BB6785CC78.title: "&cStarfire Shovel"
	quest.4D0B50731FED3CEE.quest_desc: ["Cresant Spear'ı elde etmek için Lunar Monstrosity ve Tangled Hatred'den düşen Items'lardan üretmeniz veya Lunar Monstrosity'den düşmesini beklemeniz gerekecek. (Zaten temel olarak onu öldürmeniz gerekecek). \\n\\nSpear'ı bir Trident gibi kullanıp Mobs'lara vurabilirsiniz veya sizi onunla ileriye doğru uçurması için Sağ Tıklayılı tutabilirsiniz. Eğer ikinci saldırı ile Mobs'lara vurursanız, yakındaki tüm Mobs'lar da hasar alacaktır."]
	quest.4D0B50731FED3CEE.title: "&bCrescent &5Spear"
	quest.4D4DE266A2A325B0.quest_desc: ["&4Redstone&r, &bGolem Steel&r ve &8Oxidized Golem Steel&r, &bGolem Forge&r'u bulmak için kullanılan Items'lardır. \\n\\nBunlardan birini (büyük ihtimalle yeraltında &9&lStarlight&r'da beliren &4Redstone&r'u) Sol Elinizde tutun ve bu arada yeraltında bulunan &bGolem Forge&r'u bulmak için Seeking Eye'ı kullanın!"]
	quest.4D4DE266A2A325B0.title: "&l&bGolem&r Items"
	quest.4D53D9BBD8279282.quest_desc: ["&3Lunar Trees&r, devasa yüksek &3Trees&r'lerden çok küçük olanlara kadar değişebilir. Olabildiğince çok yer kaplamaya adapte olurlar! (Bu, &3Dense Forests&r'ı açıklayabilir). \\n\\nNormal Saplings gibi ekilirler ve yapraklarından &3Lunar Berries&r belirmesini sağlayabilirler!"]
	quest.4D53D9BBD8279282.title: "&3Lunar Trees"
	quest.4D8C9960BB675221.quest_desc: ["Komik bir ismi var!"]
	quest.4DBC3B4D38CC6152.quest_desc: [
		"&dCrystallized Moths&r, &5Crystallized Deserts&r'ın derinliklerinde belirir. \\n\\nTarafsızdırlar ve çok fazla hasar verdikleri için onlara vurmamanızı öneririm! \\n\\nAyrıca 10 &4Hearts&r'a sahiptirler ve öldüklerinde &bStarlight &dCrystals&r veya &9Shivering Gel&r düşürebilirler. \\n\\nBu güzel erkekler ve dişiler Meat ile Beslenerek Evcilleştirilebilirler! O zaman sizin için Savaşacaklardır."
		"{image:atm:textures/questpics/eternal/starlight_moth.png width:125 height:100 align:center}"
	]
	quest.4DBC3B4D38CC6152.title: "&dCrystallized Moth"
	quest.5003365C2A7B4B53.title: "&cStarfire Sword"
	quest.50674FE3C6BE9990.quest_desc: [
		"Tıpkı normal &3Starlight Forest&r gibi ama Ağaçlar arasında çok daha az boşluk var!"
		"{image:atm:textures/questpics/eternal/starlight_dense.png width:200 height:100 align:center}"
	]
	quest.50674FE3C6BE9990.title: "&3Dense Starlight Forest"
	quest.50EC8F8CD04D9598.title: "&5Rage of Stars"
	quest.516AC1F0E0BCAE55.quest_desc: ["&bFrozen Tubes&r, &bGolem Forge&r içindeki &bFreezes&r'dan düşer. \\n\\nKime çarparsa zarar vermesi için Potions gibi fırlatılabilirler."]
	quest.516AC1F0E0BCAE55.title: "&bFrozen Tubes"
	quest.51B1AF28328FFBAD.quest_desc: [
		"&cSpiral Kelp Forest&r, Ahşap meraklıları için oldukça hayal kırıklığı yaratan bir Biyomdur. \\n\\nBu Biyomlar bir Orman değil, bir Okyanus! Ve Ağaçlı olan Okyanus Biyomu bile değil, o &eLush Shallow Sea&r olurdu. \\n\\nÜzgünüm."
		"{image:atm:textures/questpics/eternal/starlight_spiral.png width:200 height:100 align:center}"
	]
	quest.51B1AF28328FFBAD.title: "&cSpiral Kelp Forest"
	quest.51B6D203E28D92BE.quest_desc: ["&5Meteor Showers&r beklemekten nefret mi ediyorsunuz? Neden kendiniz başlatmıyorsunuz! \\n\\n&5Aetherstrike Rocket&r normal bir Firework gibi davranacaktır. Havaya uçar, güzel bir gösteri sunar, sadece bu aynı zamanda bir &5Meteor Shower&r da çağırır. \\n\\nEvet, ateşlendiği yerde bir &5Meteor Shower&r başlatacaktır. \\n\\nAncak bir Bekleme Süresi (Cooldown) vardır."]
	quest.51B6D203E28D92BE.title: "&5Aetherstrike Rocket"
	quest.5244B2D6B5FA0487.quest_desc: [
		"&5Crystallized Desert&r normal bir Çöl gibi görünüyor ancak &5Purple&r (Mor) gölgeli. \\n\\nAyrıca eklenen dev kristallerle, normal Çöllerde buna sahip olduğunu sanmıyorum..."
		"{image:atm:textures/questpics/eternal/starlight_desert.png width:200 height:100 align:center}"
	]
	quest.5244B2D6B5FA0487.title: "&5Crystallized Desert"
	quest.5282190D0C0C2AA9.quest_desc: ["&dStarlit Diamonds&r, &9&lStarlight&r'da her yerde yeraltının derinliklerinde Belirir. \\n\\nVoidstone civarında bulacağınız yer orasıdır. \\nAdındaki Diamond'a bakılırsa, evet Tools ve Weapons için çok iyidir."]
	quest.5282190D0C0C2AA9.title: "&dStarlit Diamond"
	quest.53149C516E544FE9.quest_desc: ["&5Creteors&r ve &5Mini Creteors&r, &5Meteor Showers&r'dan gelebilir. \\n\\n&5Creteors&r Tarafsızdır, önce onlara Vurmanız gerekecek. 8 &4Hearts&r'a sahiptirler. \\n\\nVurulduğunda size doğru yuvarlanacaklar ve yanıp sönmeye başlayacaklar. Size biraz Hasar verecekler ama aynı zamanda patlayacaklar da! Patlamanın gerçekleşmesi biraz zaman alır, bu yüzden koşmak için vaktiniz olur ama patladıklarında Şunları Ortaya Çıkaracaklardır... \\n\\n&5Mini Creteors&r! Bu adamlar büyük meslektaşlarından çok daha az arkadaş canlısıdır. \\n\\n&5Mini Creteors&r size doğru uçacak ve patlayacaktır. Bu adamların sadece 2 buçuk &4Hearts&r'ı var. \\n\\nÖldürüldüklerinde (patlayarak değil) ikisi de &5Aethersent&r ve &5Creteor Hide&r Düşürecektir."]
	quest.53149C516E544FE9.quest_subtitle: "Uzaydan gelen yaratıklar mı? Uzaylılar?"
	quest.53149C516E544FE9.title: "&5Creteors"
	quest.5424A0E1292B13EE.quest_desc: ["&9&lStarlight&r civarında Sıcak Göletler (Hot Ponds) bulabilirsiniz. \\n\\n(Bunlar bir biyom veya yapı değildir, bu yüzden onları bulmak için sadece etrafa bakmanız gerekecek!) \\n\\nİçlerinde &6Thermal Springstone&r bulabilirsiniz."]
	quest.5424A0E1292B13EE.title: "&6Thermal Springstone"
	quest.5466CB622A637DCD.quest_desc: ["Abyssal Fruit teknik olarak herhangi bir &9Water&r kütlesinde belirebilir ancak &3Shimmer Rivers&r içinde yaşayan tek meyvedir. \\n\\nZeminden yukarı doğru &2Kelp&r gibi büyür, ancak aynı zamanda Meyvelerin büyümesi ve ondan toplanabilmesi açısından &eGlowberries&r gibi de çalışır."]
	quest.54DE8AAAE2181F18.quest_desc: ["&dMoonring Greatsword&r artık her iki Bosses'dan Drops'a ihtiyaç duymuyor, artık sadece &9&lLunar Monstrosity&r'yi öldürmenizi gerektiriyor. \\n\\nNormal bir Kılıç (Sword) gibi çalışır, tıpkı 1.9'dan öncesi gibi. Bir kalkan (shield) gibi saldırıları engelleyebilir, ancak tam hasar için ard arda sürekli kullanılamaz (spammed)."]
	quest.54DE8AAAE2181F18.title: "&dMoonring Greatsword"
	quest.562B280928897E0D.title: "&dStarlit Diamond Boots"
	quest.564F0343B1704CE8.title: "&cStarfire Crossbow"
	quest.5671D301C5264C7F.title: "&cStarfire Pickaxe"
	quest.59613CCE59689263.quest_desc: ["&2Rookfish&r, &9&lStarlight&r'da Yüzen şirin Satranç taşı şeklindeki Squids'tir. \\n5 &4Hearts&r'a sahiptirler ve öldüklerinde kendilerini ve Airsacs'lerini Düşürürler."]
	quest.59613CCE59689263.title: "&2Rookfish"
	quest.5B737000D540ED48.title: "&4Amaramber Sickle"
	quest.5C11E99FF201C3F9.quest_desc: ["&8Golem Steel Greatsword&r çok eğlenceli bir Weapon'dır. \\n\\nİlk olarak, Engelleyebilir (Block). Engellemek için sadece Sağ Tıklayın. \\n\\nİkinci olarak, &bLIGHTNING BALLS&r! Sol Tıkladığınızda &8Sword&r'dan 3 &bLightning Balls&r gönderilir. &bLightning&r 3'ü arasında bağlanacak ve dokundukları her şeye Hasar verecektir. Ayrıca Blocks'tan da sekerler. \\n\\nArtı, ne olursa olsun sadece harika bir &8Sword&r!"]
	quest.5C11E99FF201C3F9.title: "&8Golem Steel Greatsword"
	quest.5D8E715CCB7ACCAC.title: "&dStarlit Diamond Leggings"
	quest.5DFE3CB5B0130A7A.quest_desc: ["&3Shimmer River&r'ın üzerinde pek çok bitki yaşamı var, bazılarının üzerinde durabilirsiniz!"]
	quest.5DFE3CB5B0130A7A.title: "River life"
	quest.5E8A1D47CF3C7ACF.title: "&aFlowglaze Shovel"
	quest.60FDCA2FDFE74056.quest_desc: [
		"BU &dPINK&r (PEMBE)! \\n\\nBurada altlarına düşen yaprakların yığıldığı &dScarlet Trees&r'leri bulacaksınız. Ayrıca burada Glowing Mushrooms da bulabilirsiniz!"
		"{image:atm:textures/questpics/eternal/starlight_scarlet.png width:200 height:100 align:center}"
	]
	quest.60FDCA2FDFE74056.title: "&dScarlet Forest"
	quest.61E11E4C358898D6.title: "&dStarlit Diamond Helmet"
	quest.62A11EEC976DA5C5.title: "&aAlchemist Robe"
	quest.62B44B688D09C939.quest_desc: ["&aFlowglaze&r! \\n\\nElinizde &cStarfire&r ile Sağ Tıklayarak onu fırlatır. Bu, Mobs'lara &cStarfire&r ile Etki edebilir veya eğer Sand'e (Kuma) Çarparsa Sand'i &aRaw Flowglaze&r'e dönüştürebilir. \\n\\nSadece &aFlowglaze&r'i eritin ve bunu Weapons ve Tools yapmak için Upgrade Template ile kullanabiliriz."]
	quest.62B44B688D09C939.title: "&aFlowglaze"
	quest.62DA302CF53B7C39.title: "&6Thermal Springstone Boots"
	quest.62F33BBE7BDFE404.quest_desc: ["&5Wand of &bTeleportation&r, &9Lunar Monstrosity&r'den düşen başka bir eşyadır ve yalnızca ondan! \\n\\nBaşlatmak için Wand ile Sağ Tıklamayı basılı tutabilirsiniz, ardından bıraktığınızda sizi en son baktığınız Block'a ışınlayacaktır! \\n\\nBir menzili vardır ancak oldukça uzaktır. Ve kullanımdan sonra bir bekleme süresi (cooldown) vardır!"]
	quest.62F33BBE7BDFE404.title: "&5Wand of &7Teleportation"
	quest.6314B892B569A0A5.quest_desc: ["&9&lStarlight&r! \\n\\nSürekli &9Dusk&r olan bir Boyut ve hayır bunu değiştiremezsiniz. \\n\\nBulunacak düzinelerce Biyomlar (Biomes), Mobs, Bosses ve hatta sadece Blocks var! Hepsini keşfedebilir misin?"]
	quest.6314B892B569A0A5.title: "&9&lEternal Starlight"
	quest.63362CC33B39C627.quest_desc: [
		"Starlit Seas, Warm Shores ile kara arasında düzgünce oturan devasa Su kütleleridir. \\n\\nİçlerinde ve içlerinde büyüyen birçok mucize barındırırlar! \\n\\nUmarım gözlüklerinizi getirmişsinizdir!"
		"{image:atm:textures/questpics/eternal/starlight_starlitsea.png width:200 height:100 align:center}"
	]
	quest.63362CC33B39C627.title: "&bStarlit Sea"
	quest.636848ED1115A0B3.quest_desc: [
		"&8Ratlins&r Yüzeyde belirebilen barışçıl Mobs'lardır. \\n\\nÖldüklerinde Ratlin Meat, Leather ve Cave Moss düşürürler. \\n\\nSonuncusu onları birlikte Çiftleştirmek için kullanılabilir!"
		"{image:atm:textures/questpics/eternal/starlight_rat.png width:100 height:100 align:center}"
	]
	quest.636848ED1115A0B3.title: "&8Ratlins"
	quest.641C74BFA03BC01F.title: "&bGlacite Shield"
	quest.645380EA38544D3B.title: "&bGlacite Shovel"
	quest.64B6E1ABD471CF29.title: "&7Deepsilver Boots"
	quest.66536AAF9E98C3A6.title: "&9Malarite Hoe"
	quest.66DE7EF4AFCE4F7A.title: "&7Deepsilver Shovel"
	quest.687C51D915339086.title: "&aFlowglaze Shield"
	quest.68B2D3B985FC1378.quest_desc: [
		"&cTorreya Trees&r ve &eVines&r ile dolu parlak ve güzel bir Orman (Forest)."
		"{image:atm:textures/questpics/eternal/starlight_torreya.png width:200 height:100 align:center}"
	]
	quest.68B2D3B985FC1378.title: "&cTorreya Forest"
	quest.699C6DDE6B2D51C1.quest_desc: ["&2Jinglestem Trees&r su altında büyür... Acaba gerçek hayatta böyle Ağaçlar var mı? \\n\\nNormal Leaves yerine &2Algaeleaves&r'leri vardır."]
	quest.699C6DDE6B2D51C1.title: "&2Jinglestem Trees&f?"
	quest.6B00D5DBB3552F15.quest_desc: [
		"&9Tangled&r, &9Cursed Garden&r içinde beliren düşmanlardır. \\n\\n10 &4Hearts&r'a sahiptirler ve size tokat atarak saldırırlar. Eğer vurulursanız, az miktarda Poison alırsınız. \\n\\nÖldüklerinde Vines ve Bones düşürecekler ama aynı zamanda bir Tangled Skulls da çıkaracaklar! \\n\\nTangled Skulls, Vexes'e benzer davranır, blokların arasından uçup size vururlar. Sadece 5 &4Hearts&r'ları vardır ve öldüklerinde size onları Item olarak verirler."
		"{image:atm:textures/questpics/eternal/starlight_tangled.png width:150 height:100 align:center}"
	]
	quest.6B00D5DBB3552F15.title: "&9Tangled"
	quest.6DCC11671A2BAA1C.quest_desc: ["Nadir de olsa &9&lStarlight&r Ormanlarında &cBirds&r'lere (Kuşlara) rastlayabilirsiniz. \\nEğer bir Yuva (Nest) yakınında 2 &cBirds&r'e biraz Seeds (Tohum) Beslerseniz, &cBirds&r'den muhabbet kuşlarına dönüşeceklerdir. \\n\\nGerçekten değil, ama ikisi de Yuvalarında (Nest) sarılacaklar. Bundan sonra size bir hediye bırakacaklar. Bazen o hediye..."]
	quest.6DCC11671A2BAA1C.title: "The birds and the... birds?"
	quest.6E970CF05B96EB20.quest_desc: ["&b&lGolem&r'e hasar vermek için onun güç kaynağını kapatmanız gerekecek! \\n\\nBunu yapmak için Energy Blocks maviye döndüklerinde onlara Sağ Tıklamanız (Right Click) gerekecek. \\n\\nGenellikle boss odasının köşelerinde 2 tane ve onun üstünde 2 tane bulabilirsiniz!"]
	quest.6E970CF05B96EB20.title: "Powering down"
	quest.6EC289857CDC4969.quest_desc: [
		"&bEnts&r, &9&lStarlight&r'ın Yüzeyinde beliren başka bir barışçıl Mob'dur. Bunlar ormanlarda belirir! \\n\\nBu küçük ağaçlar öldüklerinde Sticks, &3Lunar Berries&r ve &3Lunar Leaves&r düşürebilirler. \\n\\nOnları Çiftleştirmek (Breed) için &3Lunar Berries&r kullanabilirsiniz!"
		"{image:atm:textures/questpics/eternal/starlight_ent.png width:100 height:100 align:center}"
	]
	quest.6EC289857CDC4969.title: "&bEnts"
	quest.6ECDD55D55D4D44E.title: "&5Starfall Longbow"
	quest.6F5F6BAB09CB4F5E.title: "&9Malarite Spear"
	quest.70A82A5D17D558FB.quest_desc: ["&bEnergy Sword&r yalnızca &b&lStarlight Golem&r'den düşebilir. \\n\\nNormal bir Kılıç (Sword) gibi çalışır ancak Sağ Tıklama (Right Click) ile sallarken Overwatch'taki Genji gibi onlara doğru atılabilirsiniz! "]
	quest.70A82A5D17D558FB.title: "&bEnergy Sword"
	quest.70F8A8D6C442F2B6.title: "&aFlowglaze Hoe"
	quest.713548E540B18E07.quest_desc: ["&9Moonring Bow&r yalnızca &9&lLunar Monstrosity&r'den düşebilir. \\n\\nNormal bir Yay (Bow) gibi Arrows atar ama Ground Spikes Arrow'un gittiği yöne doğru gelecektir!"]
	quest.713548E540B18E07.title: "&9Moonring Bow"
	quest.713EF442D59501BA.quest_desc: ["&5Chain of &9Souls&r, &9&lLunar Monstrosity&r'nin düşürdüklerinden (drops) üretilebilir. \\n\\nO bir kanca (grappling hook)! Onu göndermek için Sağ Tıklamaya dokunun ve bir şeye çarptığında sizi kendine çekmeye başlayacaktır. Sonra, ayırmak için tekrar Sağ Tıklamanız gerekir."]
	quest.713EF442D59501BA.title: "&5Chain of &9Souls"
	quest.71C58666D4BC2508.quest_desc: ["Flint and Steel gibi çalışır!"]
	quest.71C58666D4BC2508.title: "&eSaltpeter Matchbox"
	quest.7322332BB6CF5CF7.title: "&7Deepsilver Brush"
	quest.7618153D6613790E.title: "&6Thermal Springstone Scythe"
	quest.76BFC5815FC6565C.quest_desc: ["&9&lStarlight&r'da nadiren yerin üstünde bir &5Meteor Shower&r meydana gelebilir. \\n\\nGerçek hayatta sizden sadece birkaç metre öteye çarpan Meteors (Göktaşları) parçaları korkutucu olsa da, &2&lMinecraft&r'da faydalıdır! \\n\\nBunlar olduğunda, Meteors'ın çarptığı yerde &5Aethersent&r adı verilen bir Malzeme Belirecektir. Ayrıca aynı Meteors'lardan bazı Mobs'lar da Belirebilir!"]
	quest.76BFC5815FC6565C.title: "&5Meteor Shower"
	quest.770C0975CA61CE46.quest_desc: ["&bGlacite&r, Permafrost Forests'daki yeraltının derinliklerinde bulunabilir. \\n\\nDonma hasarına karşı yardımcı olan Armor ve Tools üretmek için kullanılabilir!"]
	quest.770C0975CA61CE46.title: "&bGlacite"
	quest.7798BC7C5112D6FB.title: "&bGlacite Leggings"
	quest.78D26411B482CD5A.title: "&dStarlit Diamond Shovel"
	quest.79B03F769746784A.title: "&9Malarite Pickaxe"
	quest.79B33E4691E6CB45.title: "&aFlowglaze Sword"
	quest.7A16D2EB63359294.quest_desc: [
		"&3Aurora Deers&r, yine soğukta yaşayan arkadaş canlısı toynaklı hayvanlardır. \\n\\nBu &3Deers&r'ler size zarar vermeye çalışmazlar ancak koştuğunuzda yollarına çıkarsanız bazı &3Antlers&r (Boynuzlar) hissedebilirsiniz. \\n\\n&3Antlers&r ayrıca öldüklerinde onlar tarafından düşürülebilir ve bir silah veya çapa (hoe) olarak kullanılabilir! \\n\\nAyrıca Leather veya Aurora Deer Steak de düşürebilirler."
		"{image:atm:textures/questpics/eternal/starlight_deer.png width:200 height:100 align:center}"
	]
	quest.7A16D2EB63359294.title: "&3Aurora Deer"
	quest.7AF8567CF8C543F7.title: "&6Thermal Springstone Axe"
	quest.7B5D34650BBD97D9.quest_desc: ["&5Aethersent&r, &5Creteors&r'dan ve &5Meteor Showers&r'dan Düşer (Dropped). \\n\\nÇoğu &5Meteor Showers&r onlardan bir ton Düşürür, bu yüzden endişelenmeyin!"]
	quest.7B5D34650BBD97D9.title: "&5Aethersent"
	quest.7B937E68FEFBBA98.title: "&dStarlit Diamond Chestplate"
	quest.7C53F52992EA2064.title: "&4Amaramber Shovel"
	quest.7D68FD0637351E02.title: "&6Thermal Springstone Helmet"
	quest.7D7BD1458CF12021.quest_desc: ["Burası bir Çöl, elbette &5Cacti&r var! \\n\\n&5Cacti&r (Kaktüsler) tamamen büyüdüklerinde üzerlerinde Fruit yetiştirebilir!"]
	quest.7D7BD1458CF12021.title: "&5Lunaris Cactus"
	quest.7E90138B0A2C3210.quest_desc: ["Northland Trees, Permafrost Forests'ın yukarısındaki büyük sağlam Ağaçlardır (Trees). \\n\\nSpruce gibi görünürler ama çok daha hafiftirler! Belki de albino Spruce'durlar. \\n\\nSaplings'leri Grass'a değil, Dirt'e ve 2x2 düzeninde yerleştirilmelidir."]
	quest.7FBB431AC055FE93.quest_desc: ["&7Soulit Spectator&r bir &9Soul Dew&r ve bir &9Nightfal Spider Eye&r ile üretilir. \\n\\nTom Clancy's Splinter Cell'deki Yapışkan Kameraya benzer çalışır. &7Spectator&r'ı göndermek için Sağ Tıklayabilirsiniz ve bir süre sonra onun dışından görebileceksiniz. Hatta onunla kendinizi bile görebilirsiniz! \\n\\nErken sonlandırılamaz, bu yüzden onu kullanırken dikkatli olun. Ayrıca dayanıklılığı (durability) ve bekleme süresi (cooldown) vardır."]
	quest.7FBB431AC055FE93.title: "&7Soulit Spectator"
	quest.7FBD51663C1A711A.title: "&4Amaramber Sword"
	quest.7FF77463F2A0E210.quest_desc: ["Nightfall Mud yalnızca &9Dark Swamps&r içinde bulunabilir. \\n\\nOndan daha fazla Blocks yapabilirsiniz!"]
