{
	chapter.65A95C2312976E49.title: "The Undergarden"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.00CB8D60E7831A57.quest_desc: ["Catacombs, Depthrock Bricks'ten yapılmış devasa yeraltı yapılarıdır. Yüzeyden dışarı taşan ve bulabileceğiniz bir kısmı olabilir. \\n\\nDevasa labirentin içinde &7Forgottens&r, gizli Chest'ler ve patron yatar: &aForgotten Guardian&r. \\n\\nUmarım onun için hazırsınızdır!"]
	quest.00CB8D60E7831A57.title: "Catacombs"
	quest.01B13BBB41BBB460.quest_desc: ["&cUtherium Armor&r, Netherite Armor ile aynı istatistiklere sahiptir! \\n\\nBir Smithing Template'e ihtiyaç duymadan!"]
	quest.01B13BBB41BBB460.title: "&cUtherium&r Armor"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood Forests diğer tüm ormanlar gibidir. \\n\\nSadece bu Tree'ler istedikleri gibi hareket etmeyi severler."
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "Wigglewood Forest"
	quest.06D13E319C26C949.quest_desc: [
		"Blood Mushroom Bog, devasa Blood Mushrooms'a ev sahipliği yapar. \\n\\nBlood beni huzursuz ediyor, bu yüzden sanırım bu açıklamayı kısa tutacağım."
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "Blood Mushroom Bog"
	quest.073BA8470EA37A00.quest_desc: [
		"Başka bir Sea, sadece bu çok daha soğuk."
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "Icy Sea"
	quest.08D9C809CF4062E8.quest_desc: ["Onları çiğ yiyin, kızartın, bir Stick'e geçirin. \\n\\nUnderbeans ile ne yapamazsınız ki!"]
	quest.0A0A991BAC99092C.quest_desc: [
		"Indigo Mushroom Bog, Blood Mushroom Bog'dan çok daha dolgundur. \\n\\nElbette Indigo Mushrooms vardır, ama aynı zamanda Mini Smogstem Trees ve Virulent Mix göletleri de vardır. Acaba ne işe yarıyor..."
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "Indigo Mushroom Bog"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&dNargoyles&r, yeraltında ortaya çıkan iğrenç ve düşman Mobs'tur. \\n\\n7 buçuk Hearts'ları vardır ve acımasızca sizi öldürmeye çalışırlar. \\n\\nHiçbir şey düşürmezler ve sadece barışçıl bir şekilde madencilik yapmaya çalışanlar için bir engel görevi görürler. "
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0C98503A2F20484D.quest_desc: [
		"Frostfields'in yakınında Frosty Smogstem Forests bulabilirsiniz. \\n\\nBunlar tıpkı Frostfields gibidir, sadece Smogstem Trees'i vardır!"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "Frosty Smogstem Forest"
	quest.0D91A6B36BD2F526.quest_desc: ["&2&lUndergarden&r'ın verebileceği en iyi silahı yapmak için &7Cloggrum Battleaxe&r'inizi yükseltin!"]
	quest.0D91A6B36BD2F526.title: "Ultimate Weapon!"
	quest.0FA77C28A57E06F1.quest_desc: ["Veiled Mushrooms yalnızca kendi Bog'larında bulunabilir. \\n\\nAltında Air varsa Mushroom Veils oluşturacak Kahverengi Şapkaları vardır. Adı da buradan geliyor!"]
	quest.1054168AFD8520D4.quest_desc: [
		"&aForgotten Guardian&r, &aForgotten Ingots&r'dan yapılmış devasa bir Golem'dir. \\n\\nOyuncuyu hedef alacak ve onları öldürmek için ne gerekiyorsa yapacaktır. \\n\\n80 Hearts'ları vardır ve onları öldürebilirseniz &aForgotten Nuggets&r düşüreceklerdir."
		"{image:atm:textures/questpics/undergarden/undergarden_guardian.png width:100 height:200 align:center}"
	]
	quest.1054168AFD8520D4.title: "&aForgotten Guardian&r"
	quest.1190BB433EFA3945.quest_desc: ["Slingshot, &2&lUndergarden&r tarafından eklenen çok eğlenceli bir silahtır. Fırlatılabilen 4 Ammo'su (Cephanesi) vardır: \\n\\nScintling Goo fırlatılabilir ve bir Mob'a vurduğunda onlara Gooey Effect verecektir. \\n\\nDepthrocks sadece normal fırlatılabilir nesnelerdir (projectiles). \\n\\nRotten Blisterberries çarpma anında patlayacaktır. \\n\\nVe &eGronglets&r hiçbir hasar vermezler, sadece ses çıkarırlar ve fırlatılırlar!"]
	quest.119242549BD21764.quest_desc: [
		"&eBrutes&r birkaç Biomes'ta ortaya çıkar ve Tarafsızdırlar. \\n\\nVurulursa bölgedeki hepsi size saldıracaktır. Wolves veya Zombified Piglins'e benzer şekilde. \\n\\nÖldüklerinde Tusks'larını düşürebilirler ki bu da Bones'un yerini alabilir!"
		"{image:atm:textures/questpics/undergarden/undergarden_brute.png width:100 height:100 align:center}"
	]
	quest.119242549BD21764.title: "&eBrutes&r"
	quest.130577AD1A1A8222.quest_desc: ["&7Cloggrum&r, Iron Armor'dan biraz daha kötü istatistiklere sahiptir, ancak pratikte Tree'lerde yetiştiği için bence bu adildir. \\n\\nBoots (Botlar) aynı zamanda Scintling Goo'dan geçmeye de yardımcı olur!"]
	quest.130577AD1A1A8222.title: "&7Cloggrum&r Armor"
	quest.141681FE9E524FB0.quest_desc: [
		"&7Forgottens&r, Catacomb Structure içinde ortaya çıkan savaşçılardır. \\n\\nAncient Armor giyerler ve Cloggrum Tools tutarlar, hepsi ölümden sonra düşebilir. \\n\\nAyrıca &cRot Mobs&r'ı hedef alır ve öldürürler."
		"{image:atm:textures/questpics/undergarden/undergarden_forgotten.png width:100 height:200 align:center}"
	]
	quest.141681FE9E524FB0.title: "&7Forgotten&r"
	quest.15A8F04BC10E619E.quest_desc: [
		"Bazı insanlar tüm farklı Tree Saplings'leri elde etmek için birçok farklı Biomes'u keşfetmekten nefret eder. \\n\\nGörünüşe göre &2&lUndergarden&r Geliştiricisi de öyle düşünmüş, bu yüzden çoğunu Dense Forest'a koymuş!"
		"{image:atm:textures/questpics/undergarden/undergarden_dense.png width:200 height:100 align:center}"
	]
	quest.15A8F04BC10E619E.title: "Dense Forest"
	quest.16A04B2FC3F0D902.quest_desc: ["&7Cloggrum&r Tools tıpkı Iron Tools gibi davranır, sadece Iron'dan çok Mud'a (Çamura) benzerler! \\n\\nAncak Sword, Iron Sword'dan daha fazla hasar verir."]
	quest.16A04B2FC3F0D902.title: "&7Cloggrum&r Tools"
	quest.17C2C8F64B4AE6EE.quest_desc: [
		"&2Dwellers&r, &2&lUndergarden&r'ın Cows'udur (İnekleridir). \\n\\nPassive'dirler ve öldüklerinde Leather ve Dweller Meat düşürürler. \\n\\nTanrıya şükür sağılamıyorlar, bu &2Dwellers&r'ın yaptığı sütten istemiyorum."
		"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
	]
	quest.17C2C8F64B4AE6EE.title: "&2Dweller&r"
	quest.19862DBCE9305DE3.quest_desc: ["&3Spear&r, &7Denizen's&r'in Wooden Axe ile birlikte tercih ettiği silahtır... \\n\\nBunu Craftlamak için 2 Sticks ve &3Rogdorium&r'a ihtiyacınız olacak. \\n\\nBir &bDiamond Sword&r ile aynı Hasara sahiptir, ayrıca daha uzun Reach'i (Menzili) vardır! \\n\\nAyrıca bir Trident gibi fırlatılabilir."]
	quest.19862DBCE9305DE3.title: "&3Spear"
	quest.1A23BBF444D17A63.quest_desc: [
		"&2Greater Dwellers&r, Y Seviyesi 0'ın altında ortaya çıkar. Yoldaki Dreadrock'ı kazmak için bir &aForgotten Pickaxe&r veya &6Allthemodium Pickaxe&r'e ihtiyacınız olacak. \\n\\n&2Greater Dwellers&r, daha küçük aile üyelerinden farklı evrimleşmiştir, Derinlikler tehlikelidir, daha büyük ve daha güçlü olmaları gerekmiştir! \\n\\nArtık 100 Hearts'ı olan daha büyük bir boyuta sahipler. Ayrıca Passive yerine Neutral (Tarafsız) olacaklar. Zombified Piglins gibi, eğer birine vurulursa, hepsi Saldıracaktır."
		"{image:atm:textures/questpics/undergarden/undergarden_greater.png width:100 height:100 align:center}"
	]
	quest.1A23BBF444D17A63.title: "&2Greater Dweller"
	quest.1BAE1519E44E40CE.quest_desc: [
		"Ancient Sea'yi hayal edin. Tamam, şimdi içindeki tüm Kelp'leri çıkarın ve tüm &bGwibs&r ve &bGwiblings&r'i çıkarın. \\n\\nİşte bu sizin için Dead Sea!"
		"{image:atm:textures/questpics/undergarden/undergarden_dead.png width:200 height:100 align:center}"
	]
	quest.1BAE1519E44E40CE.title: "Dead Sea"
	quest.1C232674CD04024D.quest_desc: ["&2&lUndergarden&r Boyutu, bolca Bitki Örtüsü, Mobs (dost ve düşman) ve tabii ki Ores ve Items ile dolu çok çeşitli ve iğrenç Biomes'larla doludur. \\n\\nUmarım bir savaşa hazırsınızdır!"]
	quest.1C232674CD04024D.title: "Welcome to the &2&lUndergarden&r!"
	quest.1D2C70F1750E84D0.quest_desc: [
		"Yeni bir &cRot&r Mob mu? \\n\\n&cRotbelcher&r'ın 17 buçuk Hearts'ı ve 4 Armor Points'i vardır. \\n\\nYakınınızdaysalar Kollarını size doğru sallayacaklardır. Biraz daha uzaktaysanız size tüküreceklerdir. \\n\\nTükürükleri o kadar iğrençse biraz gargaraya ihtiyaçları var demektir."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbelcher.png width:100 height:200 align:center}"
	]
	quest.1D2C70F1750E84D0.title: "&cRotbelcher"
	quest.1E13D7CE5A9EFF74.quest_desc: [
		"Frostfields, &2&lUndergarden&r'daki soğuk Biomes'lardan biridir. Devasa buz sarkıtları, Powdered Snow ve Frozen Deepturf sayesinde soğuk olduğunu anlayabilirsiniz! \\n\\nAyrıca burada olağan yeraltı Depthrock yerine Shiverstone bulacaksınız. \\n\\nShiverstone gerçek Stone'dan çok Ice gibi davranır. En azından üzerinde dururken öyle!"
		"{image:atm:textures/questpics/undergarden/undergarden_frosty.png width:200 height:100 align:center}"
	]
	quest.1E13D7CE5A9EFF74.title: "Frostfields"
	quest.1E81B903137BB62A.quest_desc: ["Normal Tools, özellikle &2&lUndergarden&r'daki tehlikeli Mobs ile başa çıkarken yeterli olmayacaktır. \\n\\nNormal bir Shield gibi davranan &7Cloggrum Shield&r'ı yapabiliriz. \\n\\nAncak &7Battleaxe&r'ı &7Forgottens&r'dan nadir bir düşme (drop) olarak almamız gerekecek."]
	quest.1E81B903137BB62A.title: "&7Cloggrum&r Weapons"
	quest.1FCF946B7BE3C0BD.quest_desc: ["&cUtheric&r Tools, Diamond Tools'a benzer ancak weapons &cRot Mobs&r'a karşı daha etkilidir! \\n\\nOnların yaptığı şeyi, onlara daha fazla hasar vermek için kullanıyorsunuz! Muhtemelen bununla yapabileceğim düzinelerce popüler kültür referansı var ama aklıma hiçbiri gelmiyor..."]
	quest.1FCF946B7BE3C0BD.title: "&cUtheric&r Tools"
	quest.22739522F0D33D7B.quest_desc: ["Gloomgourds tıpkı Pumpkins gibi ortaya çıkar ve tarlası yapılır. \\n\\nAyrıca Pumpkins gibi Pie veya hatta Jack-O-Lanterns yapılabilirler! \\n\\nPumpkins'ten farklı olarak patlayıcılara dönüştürülebilirler..."]
	quest.24D38DA8E86DD897.quest_desc: [
		"En küçük ve en zayıf &cRot Mobs&r. \\n\\nBunların 5 Hearts'ı vardır. \\n\\nTüm &cRot Mobs&r gibi onlar da &2Stoneborns&r ve &7Forgottens&r'ı hedef alacaklar ve &cUtheric Shards&r düşüreceklerdir."
		"{image:atm:textures/questpics/undergarden/undergarden_rotling.png width:100 height:100 align:center}"
	]
	quest.24D38DA8E86DD897.title: "&cRotling&r"
	quest.257893DD23BF5017.quest_desc: ["&3Rogdorium&r'u elde etmek için Y Seviyesi 0'ın altındaki Depths'i ziyaret etmemiz gerekecek. Bunun için bir &aForgotten Pickaxe&r veya &6Allthemodium Pickaxe&r'e ihtiyacınız olacak. \\n\\nAyrıca &3Rogdorium Ore&r'u Kazmak için aynı Tier Pickaxe'e ihtiyacınız olacak. Bu, Depths'te herhangi bir yerde Çıkar. \\n\\nAyrıca &3Rogdoric Ancient Root&r'u Kazmak için bir &aForgotten&r veya &6Allthemodium Axe&r kullanabilirsiniz. Bunlar çok daha yaygındır ancak &3Ore&r'un verdiği tam versiyona kıyasla yalnızca bir &3Rogdorium Nugget&r verecektir."]
	quest.257893DD23BF5017.title: "&3Rogdorium"
	quest.278D34BBC13356DF.quest_desc: [
		"Mor bir Bog! \\n\\nBunların her yerinde Ink Mushrooms ve Virulent Mix bulunur!"
		"{image:atm:textures/questpics/undergarden/undergarden_ink.png width:200 height:100 align:center}"
	]
	quest.278D34BBC13356DF.title: "Ink Mushroom Bog"
	quest.2A2041098C069772.quest_desc: [
		"&7Denizens&r, Y Seviyesi 0'ın altında bulunan Depths'te Çıkar. Orada kazmak için bir &aForgotten Pickaxe&r veya benzer bir Tier'e ihtiyacınız olacak. \\n\\n&7Denizens&r garip ve iğrenç bir şekilde insana benzerler, Mysterious Masks takarlar ve ellerinde Spear veya Wooden Axe tutarlar. \\n\\n&7Denizens&r kısa ve yuvarlak boyutta, ayrıca uzun ve sıska boyutta gelirler. Ancak hepsinin 10 Hearts'ı vardır. \\n\\nWeapon'ları haricinde hiçbir Dropları yoktur."
		"{image:atm:textures/questpics/undergarden/undergarden_denizens.png width:100 height:200 align:center}"
	]
	quest.2A2041098C069772.title: "&7Denizen"
	quest.2C5A7E4CD8B57E08.quest_desc: ["Grongle Trees, sadece Gronglegrowth Biomes'ta ortaya çıkan Jungle benzeri uzun Ağaçlardır! \\n\\nBu Ağaçlar aynı zamanda &eGronglets&r'in üzerinde belirdiği yerlerdir."]
	quest.2E596B5A4EA2ABF4.quest_desc: [
		"Şu Smogvent mi hareket ediyor? Hayır bekle bu sadece bir &3S'Mog&r! &2Mog&r'un yakın kuzeni! \\n\\nTam olarak &2Mogs&r gibi davranırlar, sadece bunlar Blue Mogmoss düşürebilir."
		"{image:atm:textures/questpics/undergarden/undergarden_smog.png width:100 height:100 align:center}"
	]
	quest.2E596B5A4EA2ABF4.title: "&3S'Mog&r"
	quest.30582B5FBED35FD1.quest_desc: ["&cUtheric Clusters&r ve &cShards&r, özellikle &cRot&r Monsters olmak üzere birçok farklı Mob tarafından Düşürülebilir. \\n\\n9 &cShards&r 1 &cCluster&r yapar. \\n\\nDaha sonra, &3Rogdorium&r ve bir &cUtheric Cluster&r'ı birleştirip &cUtheric Crystal&r Craftlamak için bir Infuser kullanmamız gerekecek."]
	quest.30582B5FBED35FD1.title: "&cUtheric&r"
	quest.30D6924003C6E273.quest_desc: ["&7Denizen&r Camps (Kampları), Depths içinde bulunabilir. Y Seviyesi 0'ın altında Dreadrock'ı geçmeniz gerekecek. \\n\\nDreadrock'ın Kazılması için bir &aForgotten Pickaxe&r gerekir. Bu &6Allthemodium Pickaxe&r ile aynı Tier'dır. \\n\\nBurada bir sürü &7Denizens&r çıkacak, artı Mysterious Totems ve Chests! Nadiren bir Chest, &7Denizens&r'in taktığının aynısı olan bir Mysterious Mask çıkarabilir. \\n\\n&7Denizens&r yakınında Mysterious Mask takmak, Piglins'in önünde &eGold&r takmak gibidir. Birine vurulmadığı (veya onları kızdıracak bir şey yapılmadığı) sürece Nötr olacaklardır."]
	quest.30ED5FF9DF7B34CF.quest_desc: ["Bir Denizen Camp Lootlayarak veya bunu Craftlayarak Mysterious Totem kullanabiliriz! \\n\\nIıı... bunu nasıl kullanacağız? \\n\\nSadece Yere Yerleştirin ve her birkaç Saniyede bir size 10 Saniyeliğine &bPurity&r verecektir. \\n\\n&bPurity&r sizi &cRot&r hastalığından arındıracaktır."]
	quest.353AEEC116A5DEEF.quest_desc: [
		"Ancient Seas, &2&lUndergarden&r'daki geniş açık Seas'dir (Denizlerdir). \\n\\nKirletici miktarına rağmen bir şekilde Water içmek için güvenlidir. \\n\\nWater ayrıca &bGwibs&r ve &bGwiblings&r de barındırır. Ve Glitterkelp'i de unutamayız!"
		"{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}"
	]
	quest.353AEEC116A5DEEF.title: "Ancient Sea"
	quest.36389696767EFB4E.quest_desc: [
		"Barren Abyss adından da anlaşılacağı gibi, çoraktır... Hostile Mobs ve Pebbles dışında hiçbir şey barındırmaz. \\n\\nŞahsen ben Pebbles'ı başka bir yerde bulmayı tercih ederim..."
		"{image:atm:textures/questpics/undergarden/undergarden_barren.png width:200 height:100 align:center}"
	]
	quest.36389696767EFB4E.title: "Barren Abyss"
	quest.380D3212D1CBA593.quest_desc: [
		"Orta büyüklükteki &cRot Mob&r, &cRotwalker&r. \\n\\n20 Hearts'ları vardır. \\n\\nTüm &cRot Mobs&r gibi onlar da &2Stoneborns&r ve &7Forgottens&r'ı hedef alacaklar ve &cUtheric Shards&r düşüreceklerdir."
		"{image:atm:textures/questpics/undergarden/undergarden_rotwalker.png width:100 height:200 align:center}"
	]
	quest.380D3212D1CBA593.title: "&cRotwalker&r"
	quest.3AF7446592D19FA6.quest_desc: ["&eRegalium&r, &2&lUndergarden&r'daki Emerald eşdeğeridir. \\n\\nArmor veya Tools yapılamaz ancak &2Stoneborns&r ile diğer Item'lar için takas yapmakta kullanılabilir."]
	quest.3AF7446592D19FA6.title: "&eRegalium&r"
	quest.4141EF8B8C316118.quest_desc: ["&7Cloggrum&r, &2&lUndergarden&r'ın Iron'udur. \\n\\nHer yerde bulunur ve düzinelerce farklı tarifte kullanılır. \\n\\nHatta bazı Mob'lar bile onu düşürür!"]
	quest.4141EF8B8C316118.title: "&7Cloggrum&r"
	quest.43A1BC20BB054A14.quest_desc: ["Glitterkelp, Ancient ve Icy Seas'de yetişir. \\n\\nParlamak dışında pek bir şey yapmazlar ve Pie (Turta) yapılabilirler!"]
	quest.43FD4AEBB9548E57.quest_desc: [
		"Smogstem Forest, Indigo Mushroom Bogs'a komşu bir Biome'dur. \\n\\nElbette o da Mavidir ve içinde Indigo Mushrooms bulunur! Sadece daha büyük Smogstem Trees'i vardır!"
		"{image:atm:textures/questpics/undergarden/undergarden_smogstem.png width:200 height:100 align:center}"
	]
	quest.43FD4AEBB9548E57.title: "Smogstem Forest"
	quest.4568C2F465EDB960.quest_desc: ["Droopfruit hemen hemen her Biome'da ortaya çıkabilir, sadece yukarı bakın! \\n\\nÇoğu Biomes'un çatısında çıkarlar ve Glowberries'e benzer şekilde büyürler."]
	quest.46DCB235D3FEDA61.quest_desc: ["Iron Tools'a benzer şekilde bunların hepsi, kendileriyle vurulan herkesi yavaşlatır. \\n\\nHoe hariç, ama basit bir hoe (çapa) kimin umurunda ki?"]
	quest.46DCB235D3FEDA61.title: "&bFroststeel&r Tools"
	quest.4985F82E0D300C6D.quest_desc: ["&2&lOverworld&r'deki evinize dönmek istiyor ama orijinal Portal'ınızı bulamıyorsanız, endişelenmeyin bir yolu var! \\n\\n4 Depthrock, 4 &7Cloggrum Ingots&r ve bir &aForgotten Nugget&r ile Crumbling Catalyst Craftlayabilirsiniz. \\n\\nCrumbling Catalyst, bir Portal'ı aktive etmede normal Catalyst gibi çalışır. "]
	quest.49EB9FB2133E3219.quest_desc: ["Ancient Armor, &7Forgottens&r'ın giydiği şeydir ve onu onlardan elde edebilirsiniz. \\n\\nAncient Boots yoktur gerçi, görünüşe göre &7Forgottens&r'ın ayakları yoktur."]
	quest.49EB9FB2133E3219.title: "Ancient Armor"
	quest.4C5CFA45D9B4F6D3.quest_desc: ["Indigo Mushrooms görünüşe göre Smogstem ile çok yakın arkadaştır ve çoğunlukla onlarla birlikte çıkarlar! "]
	quest.4C7E006502E30C20.quest_desc: ["Bu Görev &6AllTheMods Ekibi&r veya AllTheMods Modpaketlerinde kullanılmak üzere bir &2Topluluk katılımcısı&r tarafından yazılmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r'nin açık izni olmadan tarafından yayınlanmayan hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev bilerek gizlenmiştir, eğer bunu görüyorsan, düzenleme modundasın demektir."]
	quest.4D836B9D9E3B898F.quest_desc: [
		"&aStoneborns&r, Villagers ve Iron Golems'in mükemmel bir karışımıdır. \\n\\nOnlara Sağ Tıklayarak takas yapabilirsiniz. \\n\\nVe onlar Hostile Mobs'u (veya onlara vuran Players'ı) savuşturacaklardır."
		"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
	]
	quest.4D836B9D9E3B898F.title: "&aStoneborn&r"
	quest.4E3D548E5D8D7D26.quest_desc: [
		"Forgotten Fields, &2&lUndergarden&r'ın Plains'idir (Ovalarıdır). \\n\\nAğaçları yoktur ancak bolca Rocks, Flowers ve Mobs'ları vardır! \\n\\nYine de &7Forgottens&r çıkarmazlar, evet heyecanınızı bozduğum için üzgünüm."
		"{image:atm:textures/questpics/undergarden/undergarden_field.png width:200 height:100 align:center}"
	]
	quest.4E3D548E5D8D7D26.title: "Forgotten Fields"
	quest.4F3B4990BE6C2A4A.quest_desc: [
		"&7Scintlings&r, &2&lUndergarden&r'ın her yerinde bulunan küçük masum Sümüklüböceklerdir. \\n\\nSnow Golems gibi hareket ederler, yani yürüdükleri her yerde bir iz bırakırlar. Sadece bu daha Gooey (Yapışkan) bir izdir... \\n\\nÖldüklerinde Scintling Goo düşürürler, ancak bunu sadece izlerinden farmlayabilirsiniz, bu yüzden onları neden öldüresiniz ki!"
		"{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}"
	]
	quest.4F3B4990BE6C2A4A.title: "&7Scintling&r"
	quest.4F5A2E2A5C7F4837.quest_desc: ["&aForgotten Ingots&r Catacombs aracılığıyla elde edilmelidir; ister Chests'i yağmalayarak ister &aForgotten Guardian&r'ı öldürerek. \\n\\nAyrıca Catacomb Chests'te bulunan bir Smithing Template'e de ihtiyacınız olacak."]
	quest.4F5A2E2A5C7F4837.title: "&aForgotten&r"
	quest.511144EF336BFAF5.quest_desc: [
		"Smog Spires... evet doğru tahmin ettin! Tüm Smog'un (Dumanın) geldiği yer! Yani hepsi değil, &2Mogs&r ve &3S'mogs&r'u da göz ardı edemeyiz. \\n\\nBurada Blisterberries, Coarse Deepsoil ve Smog Vents bulacaksın. Yine de onların yakınına gitmeni tavsiye etmem..."
		"{image:atm:textures/questpics/undergarden/undergarden_smogspires.png width:200 height:100 align:center}"
	]
	quest.511144EF336BFAF5.title: "Smog Spires"
	quest.51C59FDF0BD11FDF.quest_desc: ["Bir Wigglewood Tree'nin ne olduğuna dair yapabileceğim tek tanım emin ol Wigglewood Logs ve Leaves'e sahip olmasıdır. Her yöne, boyuta ve şekle doğru büyüyor gibi görünüyorlar. \\n\\nOnları Wigglewood Forests ve Dense Forests içinde bulabilirsin. \\n\\nSpruce'a benzeyen oldukça pembe Leaves (Yaprakları) ve kahverengi Logs (Kütükleri) vardır!"]
	quest.51E2728C5E35A152.quest_desc: ["Froststeel Karlı Biomes'larda çıkar: Frostfields, Frosty Smogstem Forests ve muhtemelen Icy Seas. \\n\\nBu Biomes'larda Depthrock'un yerini alan Shiverstone içinde çıkar. Shiverstone Ice'a (Buza) benzer şekilde davranır, kaygandır ve sizi biraz yavaşlatır. \\n\\nAyrıca Munchers'ın karınlarında bazı Nuggets (Parçacıklar) da bulabilirsiniz!"]
	quest.51E2728C5E35A152.title: "&bFroststeel&r"
	quest.53FDC6C536E50A1A.quest_desc: ["&bGwiblings&r Seas'deki (Denizlerdeki) dost canlısı balıklardır. \\n\\n&bGwibs&r'den daha küçüktürler ve &2&lVanilla&r Fish gibi davranırlar!"]
	quest.53FDC6C536E50A1A.title: "&bGwibling&r"
	quest.57545837046F552B.quest_desc: [
		"Bekle o normal bir Pot (Çömlek) değil! \\n\\n&2Mysterious Pots&r, kendilerini Pots gibi gizleyen canlı yaratıklardır. \\n\\n4 Hearts'ları vardır ve Vurulduğunda sizden kaçarlar. Sizden güvende olduklarını düşünürlerse gizlenmelerine geri dönerler. \\n\\nÖldüklerinde &7Cloggrum&r ve &bFroststeel Nuggets&r ile &cUtheric Shards&r Düşürebilirler. "
		"{image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
	]
	quest.57545837046F552B.title: "&2Mysterious Pots"
	quest.5AF0E903DB670D65.quest_desc: ["Biraz Dreadrock, &3Rogdorium&r ve bir &cUtheric Cluster&r ile Infuser'ı yapabiliriz! \\n\\nBu, belirli Items'ları Craftlamak ve Infuse etmek için kullanabileceğimiz bir Block'tur. Şu an için çok fazla Recipe (Tarif) yok ama eminim daha fazlasını göreceğiz! \\n\\nAna kullanımı &cUtheric Crystals&r Craftlamak ve Armor'ı &3Rogdorium&r ile Infuse etmektir. \\n\\nEğer Armor, &3Rogdorium&r ile Infuse edilirse, sizi &cRot&r hastalığına yakalanmaktan koruyacaktır. "]
	quest.5B4B5C148D63ACA1.quest_desc: [
		"&aForgotten Minions&r normal Mobs gibi spawn olmazlar, yaratılmaları gerekir. Bir &aBlock of Forgotten Ingots&r üzerine Carved Gloomgourd yerleştirilerek yaratılırlar. \\n\\nSnow Golems'a benzer şekilde davranırlar, size asla saldırmazlar ve bunun yerine Hostile Mobs'a ateş ederler. \\n\\n10 Hearts'ları vardır ve öldüklerinde hiçbir şey düşürmezler... ama zaten onları neden öldüresin ki?"
		"{image:atm:textures/questpics/undergarden/undergarden_minion.png width:125 height:100 align:center}"
	]
	quest.5B4B5C148D63ACA1.title: "&aForgotten Minions&r"
	quest.5D229FA3A5F92954.quest_desc: [
		"&4Munchers&r, &2&lUndergarden&r'daki diğer Hostile Mobs'lara benzer, ancak bu, dropları onu çok daha kullanışlı kılar! \\n\\nMuncher öldüğünde &7Cloggrum&r ve &bFroststeel Nuggets&r düşürebilir."
		"{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}"
	]
	quest.5D229FA3A5F92954.title: "&4Muncher&r"
	quest.5E63C78CDC44FF95.quest_desc: ["Rotten Blisterberries fırlatılamaz ama Blisterbombs haline getirildiklerinde fırlatılabilirler! \\n\\nHatta daha da ileri gidip, Blisterberries'i her yere fırlatan bir TNT gibi davranacak Boomgourds bile yapabilirsin."]
	quest.5E63C78CDC44FF95.title: "Explosives!!!"
	quest.5FCA6F5FE97780B7.quest_desc: [
		"&eGronglets&r teknik olarak Mobs değil Blocks'tur. Ama onları dahil etmemek için fazla seviyorum! \\n\\nGrongle Trees üzerinde doğarlar, Ses ve Işık yayarlar! Dekorasyon için kesinlikle mükemmeller."
		"{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}"
	]
	quest.5FCA6F5FE97780B7.title: "&eGronglets&r"
	quest.6124C0E9E419694B.quest_desc: ["&7Cloggrum&r Tools'u &aForgotten Ingots&r ve bir Smithing Template ile yükseltin. \\n\\nBunlar alabileceğiniz en iyi Tools'tur (Aletlerdir), yalnızca &2&lUndergarden&r Block'ları için üzerinde halihazırda Efficiency ile birlikte gelirler. \\n\\nVe Sword ile Axe, &cRot Beast&r ve &aForgotten Guardian&r dışındaki tüm &2&lUndergarden&r Mob'larına daha fazla hasar verecektir!"]
	quest.6124C0E9E419694B.title: "&aForgotten&r Tools"
	quest.647A87E800C703C3.quest_desc: [
		"Açık ara en sevdiğim Biome! \\n\\nDevasa Gronglegrowth Trees içeren büyük bir Green Jungle. \\n\\nO Ağaçlarda &eGronglets&r bulabilirsin!"
		"{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}"
	]
	quest.647A87E800C703C3.title: "Gronglegrowth"
	quest.6751F2651063B3A5.quest_desc: ["Blood Mushrooms kendi Bogs'u içinde bulunabilir. \\n\\nDark Oak Trees şeklinde şekillenmişlerdir ve çoğunlukla Beyazdırlar, yalnızca bazı bloklarda Kan lekeleri vardır!"]
	quest.67A2347534269528.quest_desc: [
		"&9Sploogies&r nadiren çıkabilir ama çıktıklarında seni sinir etmeye mahkumdurlar. \\n\\nSana tükürük atacaklar (ve iğrenç emme sesleri çıkaracaklar) ama onlara vurursan kaçacaklardır; yavru bir Piglin'e benzer şekilde. \\n\\nÖldüklerinde sadece Depthrock Pebbles düşürürler."
		"{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}"
	]
	quest.67A2347534269528.title: "&9Sploogie&r"
	quest.6C4B93FE64BD418D.quest_desc: ["&2&lUndergarden&r'a gitmek &c&lThe Nether&r'a gitmeye benzer. Bir Portal craftlaman gerekecek. \\n\\nNether Portals ile aynı şekil ve boyuttadır ancak Obsidian yerine Stone Bricks'in bir varyantına ihtiyacın olacak. Stone Bricks, Mossy Stone Bricks veya Deepslate Bricks. \\n\\nOluşturulduktan sonra Catalyst'i üzerinde kullanarak aktive edebilirsin. "]
	quest.6C4B93FE64BD418D.quest_subtitle: "Making the Portal"
	quest.6C4B93FE64BD418D.title: "The Undergarden"
	quest.6D4FB6291CA8D1A6.quest_desc: ["Smogstem Trees gerçek hayattaki Baobab Ağaçlarına benzer şekilde alt yarılarında çok daha kalındır! \\n\\nGrey Logs (Gri Kütükleri) olan Blue Leaves (Mavi Yaprakları) vardır. \\nOnları birden fazla Biomes'ta bulabilirsin: Smogstem Forests, Dense Forests ve hatta Indigo Mushroom Bogs içinde bile!"]
	quest.6E7C8537D8A28833.quest_desc: [
		"Y Seviyesi 0'ın altında iki Biomes vardır, Depths onlardan biridir. \\n\\nY Seviyesi 0'ın altına inmek için Dreadrock kazman gerekecek. Dreadrock kazmak için bir Forgotten Pickaxe veya Allthemodium Pickaxe'e ihtiyacın olacak. \\n\\nBurada Greater Dwellers, Denizens ve Rot Monsters Çıkacaktır."
		"{image:atm:textures/questpics/undergarden/undergarden_depths.png width:200 height:100 align:center}"
	]
	quest.6E7C8537D8A28833.title: "Depths"
	quest.6F416275B6F6D8F0.quest_desc: ["Blisterberries Smog Spires'da çıkar. \\n\\nBöylesine iğrenç bir bölgede yetiştikleri için bazıları Rotten (Çürük) olarak gelecektir. \\n\\nOnları yemeni tavsiye etmem, belki başka bir işe yarayabilirler!"]
	quest.6F483B77D64F4EE2.quest_desc: [
		"Y Seviyesi 0'ın altında iki Biomes vardır, Rogdorium Grove onlardan biridir. \\n\\nY Seviyesi 0'ın altına inmek için Dreadrock kazman gerekecek. Dreadrock kazmak için bir Forgotten Pickaxe veya Allthemodium Pickaxe'e ihtiyacın olacak. \\n\\nDepths'e kıyasla çok daha güzel bir Biome. Çok daha az Monsters ve çok daha fazla bitki yaşamı var! Artık Smogstem Trees ve bolca Flowers ile."
		"{image:atm:textures/questpics/undergarden/undergarden_rogdorium.png width:200 height:100 align:center}"
	]
	quest.6F483B77D64F4EE2.title: "Rogdorium Grove"
	quest.70FD8856BFCD9AEE.quest_desc: [
		"En büyük ve en tehlikeli &cRot Mob&r. \\n\\nBence bir Boss sayılacak kadar, 80 Hearts'a sahipler. \\n\\nTüm &cRot Mobs&r gibi onlar da &2Stoneborns&r ve &7Forgottens&r'ı hedef alacaklar ve &cUtheric Shards&r düşüreceklerdir."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
	]
	quest.70FD8856BFCD9AEE.title: "&cRotbeast&r"
	quest.71E1454990DEC451.quest_desc: [
		"&bGwibs&r, &bGwiblings&r'in daha büyük ve daha kızgın versiyonlarıdır. \\n\\nHiçbir Dropları yoktur ve Buckets içine koyulamazlar. Tek sundukları şey acıdır!"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&bGwib&r"
	quest.739601B0C43B239B.quest_desc: ["Evet Black Dye (Siyah Boya) yapabilirler!"]
	quest.744DBE831C120B2F.quest_desc: [
		"Şu kaya mı hareket ediyor? Ah bekle o bir kaya değil, o bir &aMog&r! \\n\\n&aMogs&r, Depthrock Pebbles ile birlikte çiftleştirilebilir ve öldüklerinde daha fazla Pebbles veya Mogmoss düşürebilir! \\n\\nMogmoss birçok farklı tarifte kullanılabilir!"
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&aMog&r"
	quest.75A66B81C1181F59.quest_desc: ["Forgotten Vestiges, &2&lUndergarden&r içinde bulunan minik Depthrock Bricks kalıntılarıdır. \\n\\nBurada Loot ile dolu bolca Pots (Çömlekler) var! \\n\\nSadece onları kır!"]
	quest.75A66B81C1181F59.title: "Forgotten Vestige"
	quest.7617737FC179EA1A.quest_desc: ["&bFroststeel&r Armor Diamond Armor'dan biraz daha kötüdür ancak aynı zamanda büyük bir Knockback Resistance (Geri Savrulma Direnci) verir. \\n\\nAyrıca Speed (Hız) debuff'ı da verir, görünüşe göre pek hareket etmeyeceğiz!"]
	quest.7617737FC179EA1A.title: "&bFroststeel&r Armor"
	quest.76CDC18D7A208512.quest_desc: ["The &2&lUndergarden&r içinde &cRot Mobs&r: &cRotling&f, &cRotwalker&f, &cRotbelcher&f ve &cRotbeast&r size &cUtherium&r bulaştırabilir. \\n\\nYakalanırsanız Hunger Bars (Açlık Barlarınızın) üzerinde Kırmızı Çubuklar olarak görünecektir. 4 tam Bar'dan sonra ekranınızda kırmızı çizgiler belirecektir. 8 Bar'da, Bars'lar sizi daha da kötüleştiği konusunda uyarmak için titremeye başlayacaktır. 10 Bar'da hepsi parlayacaktır ve bu, Hasar almaya başladığınız zamandır. \\n\\n&cRot&r dolmadığı sürece kendi kendine yavaşça geçecektir. Ayrıca onu geçirmek için Mysterious Totems'den Purity alabilir veya &3Rogdorium&r Yiyebilirsiniz. \\n\\nBunların her ikisi de Y Seviyesi 0'ın altında Çıkan Depths'ten gelir. Oraya ulaşmak için bir &aForgotten Pickaxe&r veya &6Allthemodium&r gibi aynı Tier'dan başka bir Pickaxe'e ihtiyacınız olacak. \\n\\n&cRot&r'u önlemenin tek yolu Armor'unuzu Infuser kullanarak &3Rogdorium&r ile Infuse etmektir."]
	quest.76CDC18D7A208512.title: "Warning"
	quest.79C652E3FCB88550.quest_desc: [
		"&5Gloompers&r teknik olarak Passive'dir ancak size karşı bir savunma mekanizmaları vardır, bu yüzden onları Neutral (Tarafsız) olarak kabul ediyorum! \\n\\nVurulduğunda Lingering Potion'a benzer bir Effect bırakacaklardır. \\n\\nÖldüklerinde Legs'lerini (ki bunlar çok lezzetlidir) ve muhtemelen Leather düşürürler. \\n\\nAyrıca Gloomgourds ile çiftleştirilebilirler!"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5Gloomper&r"
	quest.7E3DA4168D352B42.quest_desc: [
		"Söz veriyorum bu son Mushroom Bog! \\nBu Mushrooms oldukça normal görünüyor, asıl numaraları onlardan gelen şey! \\n\\nThe Veils! Kesinlikle kullanışlı bir dekorasyon Block'u."
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "Veil Mushroom Bog"
	task.39194D9CDF673768.title: "AllRightsReserved"
	task.4AA225E5056787B8.title: "AllRightsReserved"
}
