{
	chapter.65A95C2312976E49.title: "The Undergarden"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.00CB8D60E7831A57.quest_desc: ["Catacombs, Depthrock Bricks'ten yapılmış devasa yeraltı yapılarıdır. Yeryüzüne fırlamış parçalarını bulabilirsiniz. \\n\\nDevasa labirentin içinde &7Forgotten'lar&r, gizli sandıklar ve zindan patronu bulunur: &aForgotten Guardian&r. \\n\\nUmarız buna hazırsınızdır!"]
	quest.00CB8D60E7831A57.title: "Catacombs"
	quest.01B13BBB41BBB460.quest_desc: ["&cUtherium Zırhı&r, Netherite zırhı ile aynı değerlere sahiptir! \\n\\nÜstelik bir Demirci Şablonuna ihtiyaç duymadan!"]
	quest.01B13BBB41BBB460.title: "&cUtherium&r Zırhı"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood Forests diğer ormanlar gibidir. \n\nSadece buradaki ağaçlar diledikleri yöne doğru büyümeyi severler."
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "Wigglewood Forest"
	quest.06D13E319C26C949.quest_desc: [
		"Blood Mushroom Bog, devasa kan mantarlarına (Blood Mushrooms) ev sahipliği yapar. \n\nKan görmek içimi bulandırıyor, o yüzden bu açıklamayı kısa tutacağım sanırım."
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "Blood Mushroom Bog"
	quest.073BA8470EA37A00.quest_desc: [
		"Sıradan bir deniz daha, tek farkı çok daha soğuk olması."
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "Icy Sea"
	quest.08D9C809CF4062E8.quest_desc: ["Onları çiğ yiyin, kızartın, şişe geçirin. \\n\\nUnderbean'lerle yapamayacağınız şey yok!"]
	quest.0A0A991BAC99092C.quest_desc: [
		"Indigo Mushroom Bog, Blood Mushroom Bog'a kıyasla çok daha canlı ve dolu bir bataklıktır. \\n\\nElbette Indigo mantarları bulunur ama bununla da kalmaz; mini Smogstem ağaçları ve Virulent Mix havuzları da yer alır. Acaba ne işe yarıyorlar..."
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "Indigo Mushroom Bog"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&dNargoyle'lar&r, yer altında beliren iğrenç ve düşmanca yaratıklardır. \\n\\n15 kalbi (7,5 kalp) bulunur ve acımasızca sizi avlamaya çalışırlar. \\n\\nHiçbir eşya düşürmezler; tek amaçları huzurla maden kazan oyunculara köstek olmaktır."
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0C98503A2F20484D.quest_desc: [
		"Frostfields civarında Frosty Smogstem ormanları ile karşılaşabilirsiniz. \\n\\nTıpkı Frostfields gibidirler, tek farkları Smogstem ağaçlarıyla kaplı olmalarıdır!"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "Frosty Smogstem Forest"
	quest.0D91A6B36BD2F526.quest_desc: ["&7Cloggrum Savaş Baltanızı&r geliştirerek &2&lUndergarden'ın&r sunabileceği en güçlü silaha sahip olun!"]
	quest.0D91A6B36BD2F526.title: "Nihai Silah!"
	quest.0FA77C28A57E06F1.quest_desc: ["Veiled mantarları yalnızca kendilerine ait bataklıklarda yetişir. \\n\\nAltlarında boşluk olduğunda mantar tülleri (Mushroom Veils) sarkan kahverengi şapkalara sahiptirler. Zaten adlarını da buradan alırlar!"]
	quest.1054168AFD8520D4.quest_desc: [
		"&aForgotten Guardian&r, &aForgotten Külçelerinden&r yapılmış devasa bir golemdir. \\n\\nGözüne kestirdiği oyuncunun işini bitirmek için ne gerekiyorsa yapar. \\n\\n160 kalbi (80 kalp) vardır; devirmeyi başarırsanız &aForgotten Nugget&r düşürür."
		"{image:atm:textures/questpics/undergarden/undergarden_guardian.png width:100 height:200 align:center}"
	]
	quest.1054168AFD8520D4.title: "&aForgotten Guardian&r"
	quest.1190BB433EFA3945.quest_desc: ["Sapan, &2&lUndergarden&r tarafından eklenen çok eğlenceli bir silahtır. Kullanabileceği 4 farklı mühimmat çeşidi bulunur: \\n\\nScintling Goo: Fırlatıldığında yaratığa çarparsa ona yapışkan (Gooey) etkisi verir. \\n\\nDepthrock: Standart mermidir. \\n\\nRotten Blisterberry: Çarptığı anda patlar. \\n\\n&eGronglet&r: Hasar vermez; fırlatıldığında komik sesler çıkarır!"]
	quest.119242549BD21764.quest_desc: [
		"&eBrute'lar&r birkaç biyomda beliren tarafsız yaratıklardır. \\n\\nBirine saldırdığınızda çevredeki diğer Brute'lar da sürü halinde üzerinize çullanır. Tıpkı kurtlar veya Zombileşmiş Piglinler gibi. \\n\\nÖldüklerinde kemik yerine kullanılabilen azı dişlerini (Tusk) düşürebilirler!"
		"{image:atm:textures/questpics/undergarden/undergarden_brute.png width:100 height:100 align:center}"
	]
	quest.119242549BD21764.title: "&eBrute'lar&r"
	quest.130577AD1A1A8222.quest_desc: ["&7Cloggrum&r, demir zırhtan bir tık düşük değerlere sahiptir; fakat neredeyse ağaçta yetiştiği düşünülürse gayet makul bir pazarlık! \\n\\nAyrıca çizmeleri, Scintling Goo (sümük) üzerinde yavaşlamadan yürümenizi sağlar!"]
	quest.130577AD1A1A8222.title: "&7Cloggrum&r Zırhı"
	quest.141681FE9E524FB0.quest_desc: [
		"&7Forgotten'lar&r, Catacomb yapılarında beliren kadim savaşçılardır. \\n\\nAncient zırh giyerler ve öldüklerinde düşebilen Cloggrum aletleri kuşanırlar. \\n\\nAyrıca gördükleri yerde &cRot yaratıklarına&r saldırıp onları yok ederler."
		"{image:atm:textures/questpics/undergarden/undergarden_forgotten.png width:100 height:200 align:center}"
	]
	quest.141681FE9E524FB0.title: "&7Forgotten&r"
	quest.15A8F04BC10E619E.quest_desc: [
		"Çoğu oyuncu tüm fidan türlerini toplamak için biyom biyom gezmekten nefret eder. \\n\\nGörünüşe göre &2&lUndergarden&r geliştiricisi de aynı dertten muzdaripmiş ki fidanların çoğunu Dense Forest biyomuna yığmış!"
		"{image:atm:textures/questpics/undergarden/undergarden_dense.png width:200 height:100 align:center}"
	]
	quest.15A8F04BC10E619E.title: "Dense Forest"
	quest.16A04B2FC3F0D902.quest_desc: ["&7Cloggrum&r aletleri tıpkı demir aletler gibidir; tek farkı demirden ziyade çamuru andırmalarıdır! \\n\\nBuna rağmen kılıcı, demir kılıçtan daha yüksek hasar vurur."]
	quest.16A04B2FC3F0D902.title: "&7Cloggrum&r Aletleri"
	quest.17C2C8F64B4AE6EE.quest_desc: [
		"&2Dweller'lar&r, &2&lUndergarden'ın&r inek alternatifidir. \\n\\nUysaldırlar; öldüklerinde deri ve Dweller eti düşürürler. \\n\\nBereket versin ki sağılamıyorlar; bu mahlukların sütünü içmek isteyeceğinizi hiç sanmıyorum!"
		"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
	]
	quest.17C2C8F64B4AE6EE.title: "&2Dweller&r"
	quest.19862DBCE9305DE3.quest_desc: ["&3Mızrak&r, &7Denizen'ların&r ahşap balta ile birlikte en çok tercih ettiği silahtır. \\n\\nÜretmek için 2 çubuk ve &3Rogdorium&r gerekir. \\n\\n&bElmas Kılıç&r ile aynı hasarı verir ve üstüne daha uzun menzile sahiptir! \\n\\nDahası, üçlü mızrak (Trident) gibi fırlatılabilir."]
	quest.19862DBCE9305DE3.title: "&3Mızrak&r"
	quest.1A23BBF444D17A63.quest_desc: [
		"&2Greater Dweller'lar&r, Y=0 seviyesinin altında belirirler. Yolunuzu tıkayan Dreadrock'ları kazmak için &aForgotten Kazma&r veya &6Allthemodium Kazma&r kullanmalısınız. \\n\\n&2Greater Dweller'lar&r, küçük akrabalarına kıyasla farklı bir evrim geçirmiştir; Depths biyomu tehlikelerle dolu olduğu için daha iri ve güçlü olmak zorundaydılar! \\n\\nDevasa cüsseleriyle tam 200 kalbe (100 kalp) sahiptirler. Uysal olmak yerine tarafsızdırlar; tıpkı Zombileşmiş Piglinler gibi birine vurursanız hepsi birden saldırır."
		"{image:atm:textures/questpics/undergarden/undergarden_greater.png width:100 height:100 align:center}"
	]
	quest.1A23BBF444D17A63.title: "&2Greater Dweller&r"
	quest.1BAE1519E44E40CE.quest_desc: [
		"Ancient Sea biyomunu gözünüzün önüne getirin. Şimdi içindeki tüm su yosunlarını, &bGwib'leri&r ve &bGwibling'leri&r çıkarın... İşte karşınızda Dead Sea!"
		"{image:atm:textures/questpics/undergarden/undergarden_dead.png width:200 height:100 align:center}"
	]
	quest.1BAE1519E44E40CE.title: "Dead Sea"
	quest.1C232674CD04024D.quest_desc: ["&2&lUndergarden&r boyutu; zengin bitki örtüsü, dost-düşman envaiçeşit mahlukat ve elbette nadir cevherlerle dolu tekinsiz biyomlara ev sahipliği yapmaktadır. \\n\\nSavaşa hazır olsanız iyi edersiniz!"]
	quest.1C232674CD04024D.title: "&2&lUndergarden'a&r Hoş Geldiniz!"
	quest.1D2C70F1750E84D0.quest_desc: [
		"Yeni bir &cRot&r yaratığı mı? \\n\\n&cRotbelcher'ın&r 35 kalbi (17,5 kalp) ve 4 zırh puanı bulunur. \\n\\nYakındaysanız kollarını savururlar, uzaktaysanız üzerinize tükürürler. \\n\\nTükürükleri bu kadar iğrenç koktuğuna göre acilen bir ağız çalkalama suyuna ihtiyaçları var!"
		"{image:atm:textures/questpics/undergarden/undergarden_rotbelcher.png width:100 height:200 align:center}"
	]
	quest.1D2C70F1750E84D0.title: "&cRotbelcher&r"
	quest.1E13D7CE5A9EFF74.quest_desc: [
		"Frostfields, &2&lUndergarden'ın&r dondurucu biyomlarından biridir. Devasa buz sarkıtları, toz kar ve donmuş çimler soğuğu iliklerinize kadar hissettirir! \\n\\nBurada alışılagelmiş Depthrock yerine Shiverstone ile karşılaşırsınız. \\n\\nShiverstone taş olmaktan ziyade buz gibi davranır; en azından üzerinde yürürken kayışından bunu anlarsınız!"
		"{image:atm:textures/questpics/undergarden/undergarden_frosty.png width:200 height:100 align:center}"
	]
	quest.1E13D7CE5A9EFF74.title: "Frostfields"
	quest.1E81B903137BB62A.quest_desc: ["Standart aletler, özellikle &2&lUndergarden'ın&r tehlikeli yaratıklarına karşı yetersiz kalır. \\n\\nSıradan kalkan işlevi gören &7Cloggrum Kalkanı&r üretebiliriz. \\n\\nAyrıca &7Forgotten'lardan&r nadir bir ganimet olarak &7Savaş Baltası&r düşürmeniz gerekecek."]
	quest.1E81B903137BB62A.title: "&7Cloggrum&r Silahları"
	quest.1FCF946B7BE3C0BD.quest_desc: ["&cUtherium&r aletleri Elmas aletlere benzer ancak silahları &cRot yaratıklarına&r karşı daha etkilidir! \n\nOnlara daha fazla hasar vermek için onların düşürdüğü şeyi kullanırsınız! Bununla ilgili yapılabilecek onlarca popüler kültür göndermesi vardır kesin ama şu an aklıma hiçbiri gelmiyor..."]
	quest.1FCF946B7BE3C0BD.title: "&cUtheric&r Aletleri"
	quest.22739522F0D33D7B.quest_desc: ["Gloomgourd'lar sıradan balkabakları gibi yetişir ve ekilir. \\n\\nTıpkı balkabağı gibi turtası veya balkabağı lambası yapılabilir! \\n\\nAncak normal balkabaklarının aksine patlayıcı yapımında kullanılabilirler..."]
	quest.24D38DA8E86DD897.quest_desc: [
		"En küçük ve en cılız &cRot yaratığı&r. \\n\\nSadece 10 kalbi (5 kalp) bulunur. \\n\\nDiğer tüm &cRot yaratıkları&r gibi onlar da &2Stoneborn'lara&r ve &7Forgotten'lara&r saldırır, öldüklerinde &cUtheric Shards&r düşürürler."
		"{image:atm:textures/questpics/undergarden/undergarden_rotling.png width:100 height:100 align:center}"
	]
	quest.24D38DA8E86DD897.title: "&cRotling&r"
	quest.257893DD23BF5017.quest_desc: ["&3Rogdorium&r elde etmek için Y=0 altındaki Depths biyomuna inmemiz gerekecek. Oraya ulaşmak ve &3Rogdorium Cevheri&r kazmak için &aForgotten Kazma&r ya da &6Allthemodium Kazma&r gerekir. \\n\\nBu cevher Depths biyomunun her yerinde çıkabilir. \\n\\nAyrıca bir &aForgotten Baltası&r veya &6Allthemodium Balta&r ile &3Rogdoric Ancient Root&r da kazabilirsiniz. Bunlar çok daha yaygındır ancak tam cevherin aksine yalnızca tek bir &3Rogdorium Parçası&r verirler."]
	quest.257893DD23BF5017.title: "&3Rogdorium&r"
	quest.278D34BBC13356DF.quest_desc: [
		"Mor renkli bir bataklık! \\n\\nHer köşesinde Ink mantarları ve tehlikeli Virulent Mix sıvıları barındırır!"
		"{image:atm:textures/questpics/undergarden/undergarden_ink.png width:200 height:100 align:center}"
	]
	quest.278D34BBC13356DF.title: "Ink Mushroom Bog"
	quest.2A2041098C069772.quest_desc: [
		"&7Denizen'lar&r, Y=0 seviyesinin altındaki Depths biyomunda yaşar. Oraya ulaşmak için &aForgotten Kazma&r veya dengi bir kazmaya ihtiyacınız var. \\n\\nGarip ve rahatsız edici derecede insansı bir yapıya sahiptirler; gizemli maskeler (Mysterious Mask) takıp mızrak veya ahşap balta kuşanırlar. \\n\\nKimi kısa ve tombul, kimi uzun ve çelimsizdir; fakat hepsinin 20 kalbi (10 kalp) vardır. \\n\\nTaşıdıkları silahlar dışında eşya düşürmezler."
		"{image:atm:textures/questpics/undergarden/undergarden_denizens.png width:100 height:200 align:center}"
	]
	quest.2A2041098C069772.title: "&7Denizen&r"
	quest.2C5A7E4CD8B57E08.quest_desc: ["Grongle ağaçları, sadece Gronglegrowth biyomlarında yetişen uzun, Orman (Jungle) benzeri ağaçlardır! \n\nBu ağaçlar aynı zamanda &eGronglet'lerin&r de yetiştiği yerdir."]
	quest.2E596B5A4EA2ABF4.quest_desc: [
		"Şu kıpırdayan şey bir Smogvent mi? Yok canım, alt tarafı bir &3S'Mog&r! &2Mog'un&r amcaoğlu sayılır. \\n\\nDavranışları &2Mog'larla&r aynıdır, tek farkları Blue Mogmoss düşürebilmeleridir."
		"{image:atm:textures/questpics/undergarden/undergarden_smog.png width:100 height:100 align:center}"
	]
	quest.2E596B5A4EA2ABF4.title: "&3S'Mog&r"
	quest.30582B5FBED35FD1.quest_desc: ["&cUtheric Cluster&r ve &cShard&r parçaları, başta &cRot&r yaratıkları olmak üzere çeşitli mahluklardan düşer. \n\n9 &cShard&r birleşerek 1 &cCluster&r oluşturur. \n\nArdından Infuser bloğunu kullanarak &3Rogdorium&r ile &cUtheric Cluster'ı&r birleştirip &cUtheric Kristali&r elde ederiz."]
	quest.30582B5FBED35FD1.title: "&cUtheric&r"
	quest.30D6924003C6E273.quest_desc: ["&7Denizen&r kamplarına Depths biyomunda rastlayabilirsiniz. Oraya ulaşmak için Y=0 altındaki Dreadrock katmanını kazmanız gerekir. \\n\\nDreadrock ancak &aForgotten Kazma&r veya aynı seviyedeki &6Allthemodium Kazma&r ile kırılabilir. \\n\\nBu kamplarda sürüyle &7Denizen&r, Gizemli Totemler (Mysterious Totem) ve ganimet sandıkları bulunur. Şanslıysanız sandıklardan birinden Denizen'ların taktığı Gizemli Maske (Mysterious Mask) çıkabilir! \\n\\nDenizen'ların yanında bu maskeyi takmak, Piglinlerin karşısına &eAltın&r zırhla çıkmak gibidir. Damarlarına basmadığınız sürece size dokunmazlar."]
	quest.30ED5FF9DF7B34CF.quest_desc: ["Denizen kampını yağmalayarak veya kendimiz üreterek Gizemli Totem (Mysterious Totem) elde edebiliriz! \n\nPeki ne işe yarar? \n\nYere koyduğunuzda birkaç saniyede bir size 10 saniyelik &bPurity (Saflık)&r etkisi verir. \n\n&bPurity&r (Saflık) etkisi sizi &cRot&r (Çürüme) hastalığından arındırır!"]
	quest.353AEEC116A5DEEF.quest_desc: [
		"Ancient Seas, &2&lUndergarden'ın&r ulu denizleridir. \\n\\nBunca kirliliğe rağmen suyu nedense içilebilir durumdadır. \\n\\nBu sularda &bGwib&r ve &bGwibling&r balıkları yüzer; ışıltılı deniz yosunu Glitterkelp'i de unutmayalım!"
		"{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}"
	]
	quest.353AEEC116A5DEEF.title: "Ancient Sea"
	quest.36389696767EFB4E.quest_desc: [
		"Barren Abyss adı üstünde tekinsiz ve çorak bir yerdir... Düşman yaratıklar ve taş parçalarından (Pebbles) başka hiçbir şey barındırmaz. \\n\\nŞahsen çakıl taşlarını başka bir yerden toplamayı yeğlerdim..."
		"{image:atm:textures/questpics/undergarden/undergarden_barren.png width:200 height:100 align:center}"
	]
	quest.36389696767EFB4E.title: "Barren Abyss"
	quest.380D3212D1CBA593.quest_desc: [
		"Orta boy &cRot yaratığı&r, &cRotwalker&r. \\n\\n40 kalbi (20 kalp) bulunur. \\n\\nDiğer tüm &cRot yaratıkları&r gibi &2Stoneborn'lara&r ve &7Forgotten'lara&r saldırır, öldüğünde &cUtheric Shards&r düşürür."
		"{image:atm:textures/questpics/undergarden/undergarden_rotwalker.png width:100 height:200 align:center}"
	]
	quest.380D3212D1CBA593.title: "&cRotwalker&r"
	quest.3AF7446592D19FA6.quest_desc: ["&eRegalium&r, &2&lUndergarden'ın&r zümrütüdür. \\n\\nZırh veya alet yapımında kullanılmaz; fakat &2Stoneborn'larla&r ticaret yaparken para niyetine geçer."]
	quest.3AF7446592D19FA6.title: "&eRegalium&r"
	quest.4141EF8B8C316118.quest_desc: ["&7Cloggrum&r, &2&lUndergarden'ın&r demiridir. \\n\\nAdım başı karşınıza çıkar ve onlarca tarifte kullanılır. \\n\\nHatta bazı yaratıklardan ganimet olarak bile elde edilebilir!"]
	quest.4141EF8B8C316118.title: "&7Cloggrum&r"
	quest.43A1BC20BB054A14.quest_desc: ["Glitterkelp deniz yosunları Ancient ve Icy denizlerinde yetişir. \\n\\nIşıl ışıl parlamak dışında pek marifetleri yoktur, ancak turtası yapılabilir!"]
	quest.43FD4AEBB9548E57.quest_desc: [
		"Smogstem Forest, Indigo Mushroom Bogs biyomuna komşudur. \\n\\nMavinin hakim olduğu bu ormanda Indigo mantarları yetişir, tek farkı buradaki Smogstem ağaçlarının çok daha devasa olmasıdır!"
		"{image:atm:textures/questpics/undergarden/undergarden_smogstem.png width:200 height:100 align:center}"
	]
	quest.43FD4AEBB9548E57.title: "Smogstem Forest"
	quest.4568C2F465EDB960.quest_desc: ["Droopfruit hemen her biyomda yetişebilir, tek yapmanız gereken başınızı yukarı kaldırmak! \\n\\nMağara tavanlarında gelişirler ve Parıldayan Meyvelere (Glow Berries) benzer şekilde sarkarak büyürler."]
	quest.46DCB235D3FEDA61.quest_desc: ["Demir aletlerle benzer niteliktedirler, fakat vurdukları düşmanı yavaşlatma etkisine sahiptirler. \\n\\nTabii çapa hariç... Ama çapanın kimin umurunda olduğu tartışılır!"]
	quest.46DCB235D3FEDA61.title: "&bFroststeel&r Aletleri"
	quest.4985F82E0D300C6D.quest_desc: ["&2&lYeryüzündeki&r sıcacık evinize dönmek istiyor ama açtığınız ilk portalı kaybettiyseniz paniğe gerek yok! \\n\\n4 Depthrock, 4 &7Cloggrum Külçesi&r ve 1 &aForgotten Parçası&r ile Crumbling Catalyst üretebilirsiniz. \\n\\nBu eşya, kapıyı tekrar tutuşturmak için normal Catalyst ile birebir aynı işi görür."]
	quest.49EB9FB2133E3219.quest_desc: ["Kadim Zırh (Ancient Armor), &7Forgotten'ların&r kuşandığı settir ve onları yenerek elde edilebilir. \\n\\nAncak oyunda Ancient Çizme diye bir şey yoktur; anlaşılan &7Forgotten'ların&r pek ayağı yok!"]
	quest.49EB9FB2133E3219.title: "Ancient Armor"
	quest.4C5CFA45D9B4F6D3.quest_desc: ["Indigo mantarları Smogstem ağaçlarıyla canciğer kuzu sarması olmalı ki genelde yan yana yetişiyorlar!"]
	quest.4C7E006502E30C20.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Personeli&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı altında olduğundan, bu Görevin açık izin alınmadan &6AllTheMods Ekibi&r tarafından yayınlanmayan herhangi bir herkese açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.4D836B9D9E3B898F.quest_desc: [
		"&aStoneborn'lar&r, köylüler ile Demir Golemlerin harika bir hibritidir. \\n\\nSağ tıklayarak onlarla ticaret yapabilirsiniz. \\n\\nSaldırgan yaratıklara (ya da kendilerine saldıran oyunculara) hiç acımazlar."
		"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
	]
	quest.4D836B9D9E3B898F.title: "&aStoneborn&r"
	quest.4E3D548E5D8D7D26.quest_desc: [
		"Forgotten Fields, &2&lUndergarden'ın&r düzlükleridir. \\n\\nAğaç barındırmazlar ama bolca kayalık, çiçek ve yaratığa ev sahipliği yaparlar! \\n\\nAncak adlarının aksine &7Forgotten&r doğurmazlar; evet, hayal kırıklığınızı anlıyorum..."
		"{image:atm:textures/questpics/undergarden/undergarden_field.png width:200 height:100 align:center}"
	]
	quest.4E3D548E5D8D7D26.title: "Forgotten Fields"
	quest.4F3B4990BE6C2A4A.quest_desc: [
		"&7Scintling'ler&r, &2&lUndergarden'ın&r dört bir yanında sürünen sevimli sümüklü böceklerdir. \\n\\nGezindikleri her yerde sümüksü bir iz bıraktıkları için Kar Golemlerini andırırlar... sadece biraz daha yapış yapış! \\n\\nÖldüklerinde Scintling Goo düşürürler ama bu yapışkan sıvıyı bıraktıkları izlerden de kolayca toplayabilirsiniz. Yani bu masumları katletmenize hiç gerek yok!"
		"{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}"
	]
	quest.4F3B4990BE6C2A4A.title: "&7Scintling&r"
	quest.4F5A2E2A5C7F4837.quest_desc: ["&aForgotten Külçeleri&r (Forgotten Ingot) Catacombs zindanlarından elde edilir; ister sandıkları yağmalayın ister &aForgotten Guardian'ı&r alt edin. \\n\\nAyrıca zindan sandıklarında gizlenen Demirci Şablonuna da ihtiyacınız var."]
	quest.4F5A2E2A5C7F4837.title: "&aForgotten&r"
	quest.511144EF336BFAF5.quest_desc: [
		"Smog Spires... evet doğru tahmin ettiniz! Tüm dumanın kaynağı burası! Gerçi &2Mog'ların&r ve &3S'mog'ların&r da hakkını yememek lazım. \\n\\nBurada Blisterberry meyveleri, Coarse Deepsoil ve Smog Vents gaz bacaları bulacaksınız. Yine de bacaların dibine kadar sokulmanızı pek önermem..."
		"{image:atm:textures/questpics/undergarden/undergarden_smogspires.png width:200 height:100 align:center}"
	]
	quest.511144EF336BFAF5.title: "Smog Spires"
	quest.51C59FDF0BD11FDF.quest_desc: ["Bir Wigglewood ağacını tanımlayan tek şey Wigglewood odunu ve yapraklarıdır. Her boyutta, şekilde ve yönde rastgele büyürler. \\n\\nOnları Wigglewood ve Dense ormanlarında bulabilirsiniz. \\n\\nLadin ağacını andıran kahverengi gövdeleri ve muazzam pembe yaprakları vardır!"]
	quest.51E2728C5E35A152.quest_desc: ["Froststeel cevheri donmuş biyomlarda çıkar: Frostfields, Frosty Smogstem Forests ve muhtemelen Icy Seas. \\n\\nBu bölgelerde Depthrock yerine geçen Shiverstone kayalarında yataklanır. Shiverstone tıpkı buz gibi kaygandır ve adımlarınızı yavaşlatır. \\n\\nAyrıca Muncher yaratıklarının midesinde de birkaç cevher parçası bulabilirsiniz!"]
	quest.51E2728C5E35A152.title: "&bFroststeel&r"
	quest.53FDC6C536E50A1A.quest_desc: ["&bGwibling'ler&r denizlerin uysal sakinleridir. \n\n&bGwib'lere&r kıyasla çok daha küçüktürler ve sıradan &2&lVanilla&r balıkları gibi yüzerler!"]
	quest.53FDC6C536E50A1A.title: "&bGwibling&r"
	quest.57545837046F552B.quest_desc: [
		"Bir saniye, bu normal bir çömlek değil! \\n\\n&2Mysterious Pots&r kendilerine çömlek süsü vermiş canlı mahluklardır. \\n\\n8 kalbi (4 kalp) vardır; vurursanız panikle kaçışırlar. Tehlikenin geçtiğini sandıklarında tekrar çömlek kılığına bürünürler. \\n\\nÖldüklerinde &7Cloggrum&r, &bFroststeel Parçaları&r ve &cUtheric Shards&r düşürebilirler."
		"{image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
	]
	quest.57545837046F552B.title: "&2Mysterious Pots"
	quest.5AF0E903DB670D65.quest_desc: ["Biraz Dreadrock, &3Rogdorium&r ve bir &cUtheric Cluster&r bir araya getirerek Infuser bloğunu yapabiliriz! \n\nBu blok, özel eşyalar üretmek ve zırhları işlemek için kullanılır. Şu anda çok fazla tarif olmasa da ileride daha fazlasını göreceğimizden eminim! \n\nTemel işlevi &cUtheric Kristali&r üretmek ve zırhları &3Rogdorium&r ile işlemektir. \n\nZırhınız &3Rogdorium&r ile işlendiğinde, sizi amansız &cRot&r (Çürüme) hastalığı kapmaktan korur."]
	quest.5B4B5C148D63ACA1.quest_desc: [
		"&aForgotten Minion'lar&r kendiliğinden belirmez; inşa edilmeleri gerekir. Bir &aForgotten Külçe Bloğu&r üzerine oymalı Gloomgourd (Carved Gloomgourd) yerleştirerek çağırabilirsiniz. \n\nKar Golemlerini andırırlar; size asla saldırmaz, aksine düşman yaratıklara mermi yağdırırlar. \n\n20 kalbi (10 kalp) vardır ve öldüklerinde bir şey düşürmezler... ama zaten bu sevimli yardımcıları niye öldüresiniz ki?"
		"{image:atm:textures/questpics/undergarden/undergarden_minion.png width:125 height:100 align:center}"
	]
	quest.5B4B5C148D63ACA1.title: "&aForgotten Minions&r"
	quest.5D229FA3A5F92954.quest_desc: [
		"&4Muncher'lar&r &2&lUndergarden'daki&r diğer düşman yaratıklara benzer fakat karınlarından çıkanlar onları oldukça kıymetli kılar! \n\nÖldüklerinde &7Cloggrum&r ve &bFroststeel Parçaları&r düşürebilirler."
		"{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}"
	]
	quest.5D229FA3A5F92954.title: "&4Muncher&r"
	quest.5E63C78CDC44FF95.quest_desc: ["Rotten Blisterberry meyveleri doğrudan fırlatılamaz ama Blisterbomb patlayıcılarına dönüştürüldüklerinde fırlatılabilirler! \\n\\nHatta işi bir adım ileri taşıyıp patladığında etrafa Blisterberry saçan Boomgourd bombaları bile yapabilirsiniz."]
	quest.5E63C78CDC44FF95.title: "Patlayıcılar!!!"
	quest.5FCA6F5FE97780B7.quest_desc: [
		"&eGronglet'ler&r teknik olarak mahluk değil, canlı bloklardır. Fakat o kadar tatlılar ki rehbere eklemeden edemedim! \n\nGrongle ağaçlarında yetişir, etrafa ışık ve tatlı sesler yayarlar! Dekorasyon için birebir."
		"{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}"
	]
	quest.5FCA6F5FE97780B7.title: "&eGronglet'ler&r"
	quest.6124C0E9E419694B.quest_desc: ["&7Cloggrum&r aletlerinizi &aForgotten Külçeleri&r ve Demirci Şablonu kullanarak geliştirin. \\n\\nSahip olabileceğiniz en kaliteli aletlerdir; &2&lUndergarden&r bloklarını kazarken doğuştan gelen bir Verimlilik (Efficiency) bonusuna sahiptirler. \\n\\nAyrıca kılıcı ve baltası, &cRot Beast&r ve &aForgotten Guardian&r haricindeki tüm &2&lUndergarden&r mahlukatına ekstra hasar vurur!"]
	quest.6124C0E9E419694B.title: "&aForgotten&r Aletleri"
	quest.647A87E800C703C3.quest_desc: [
		"Açık ara en sevdiğim biyom! \\n\\nDevasa Gronglegrowth ağaçlarıyla kaplı yemyeşil bir orman. \\n\\nBu ağaç dallarında sevimli &eGronglet'leri&r bulabilirsiniz!"
		"{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}"
	]
	quest.647A87E800C703C3.title: "Gronglegrowth"
	quest.6751F2651063B3A5.quest_desc: ["Blood Mantarları sadece kendilerine ait bataklıkta yetişir. \\n\\nKoyu Meşe ağacı formundadırlar; gövdeleri beyaz renktedir ve üzerlerinde kan lekeleri barındırırlar!"]
	quest.67A2347534269528.quest_desc: [
		"&9Sploogie'ler&r nadir belirirler ama çıktıklarında damarınıza basmak için ellerinden geleni yaparlar. \n\nÜzerinize tükürürler (ve iğrenç höpürtü sesleri çıkarırlar) fakat bir darbe vurduğunuzda yavru Piglin gibi kaçışırlar. \n\nÖldüklerinde yalnızca çakıl taşları (Depthrock Pebbles) düşürürler."
		"{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}"
	]
	quest.67A2347534269528.title: "&9Sploogie&r"
	quest.6C4B93FE64BD418D.quest_desc: ["&2&lUndergarden'a&r geçiş yapmak, &c&lNether'a&r gitmeye çok benzer. Özel bir portal inşa etmeniz gerekir. \\n\\nNether portalı ile aynı boyut ve şekilde yapılır; ancak Obsidyen yerine Taş Tuğla varyasyonları (Taş Tuğla, Yosunlu Taş Tuğla veya Derinkayrak Tuğla) kullanmalısınız. \\n\\nÇerçeveyi tamamladıktan sonra Catalyst eşyasını üzerinde kullanarak kapıyı aktifleştirebilirsiniz."]
	quest.6C4B93FE64BD418D.quest_subtitle: "Portalı Yapmak"
	quest.6C4B93FE64BD418D.title: "The Undergarden"
	quest.6D4FB6291CA8D1A6.quest_desc: ["Smogstem ağaçlarının alt gövdesi, tıpkı gerçek hayattaki Baobab ağaçları gibi oldukça kalındır! \\n\\nGri gövdeleri ve masmavi yaprakları vardır. \\nSmogstem Forests, Dense Forests ve Indigo Mushroom Bogs gibi birçok biyomda karşınıza çıkabilirler!"]
	quest.6E7C8537D8A28833.quest_desc: [
		"Y=0 katmanının altında iki özel biyom bulunur; Depths bunlardan biridir. \n\nDerinlere inebilmek için sert Dreadrock kayalarını kazmanız gerekir. Bunun için &aForgotten Kazma&r veya &6Allthemodium Kazma&r şarttır. \n\nBurada Greater Dweller'lar, Denizen'lar ve tehlikeli Rot mahlukları yaşar."
		"{image:atm:textures/questpics/undergarden/undergarden_depths.png width:200 height:100 align:center}"
	]
	quest.6E7C8537D8A28833.title: "Depths"
	quest.6F416275B6F6D8F0.quest_desc: ["Blisterberries meyveleri Smog Spires biyomunda yetişir. \\n\\nÇok pis bir ortamda büyüdüklerinden bazıları çürümüş olarak toplanır. \\n\\nDoğrudan yemenizi hiç tavsiye etmem, ancak farklı tariflerde işinize yarayabilirler!"]
	quest.6F483B77D64F4EE2.quest_desc: [
		"Y=0 katmanının altındaki diğer biyom ise Rogdorium Grove'dur. \\n\\nDerinlere inmek için Dreadrock katmanını &aForgotten Kazma&r veya &6Allthemodium Kazma&r ile geçmelisiniz. \\n\\nDepths biyomuna kıyasla çok daha iç açıcı bir yerdir. Canavar sayısı az, bitki örtüsü zengindir; bolca Smogstem ağacı ve renk renk çiçek barındırır."
		"{image:atm:textures/questpics/undergarden/undergarden_rogdorium.png width:200 height:100 align:center}"
	]
	quest.6F483B77D64F4EE2.title: "Rogdorium Grove"
	quest.70FD8856BFCD9AEE.quest_desc: [
		"En büyük ve en tehlikeli &cRot yaratığı&r. \\n\\nPatron sayılabilecek kadar yüksek, tam 160 kalbi (80 kalp) vardır. \\n\\nDiğer tüm &cRot yaratıkları&r gibi &2Stoneborn'lara&r ve &7Forgotten'lara&r saldırır, öldüğünde &cUtheric Shards&r düşürür."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
	]
	quest.70FD8856BFCD9AEE.title: "&cRotbeast&r"
	quest.71E1454990DEC451.quest_desc: [
		"&bGwib'ler&r, &bGwibling'lerin&r daha iri ve kindar versiyonlarıdır. \\n\\nGanimet düşürmezler ve kovayla yakalanamazlar. Tek sundukları şey acı ve ızdıraptır!"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&bGwib&r"
	quest.739601B0C43B239B.quest_desc: ["Evet, siyah boya yapımında kullanılabilirler!"]
	quest.744DBE831C120B2F.quest_desc: [
		"Şu kaya hareket mi ediyor? Yok yahu, kaya değilmiş, bu bir &aMog&r! \\n\\n&aMog'lar&r Depthrock Pebbles ile beslenip çoğaltılabilir; öldüklerinde ise çakıl taşı veya Mogmoss yosunu düşürürler! \\n\\nMogmoss pek çok farklı tarifte kullanılır."
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&aMog&r"
	quest.75A66B81C1181F59.quest_desc: ["Forgotten Vestiges, &2&lUndergarden'da&r rastlanan Depthrock tuğlalarından örülmüş küçük harabelerdir. \\n\\nİçleri ganimet dolu çömleklerle doludur! \\n\\nTek yapmanız gereken onları kırmak!"]
	quest.75A66B81C1181F59.title: "Forgotten Vestige"
	quest.7617737FC179EA1A.quest_desc: ["&bFroststeel&r zırhı, Elmas zırhtan bir tık düşük olsa da hatırı sayılır bir Geri İtme Direnci (Knockback Resistance) sağlar. \\n\\nFakat kullanıcıyı yavaşlattığı için hareket kabiliyetinizden ödün vermeniz gerekir!"]
	quest.7617737FC179EA1A.title: "&bFroststeel&r Zırhı"
	quest.76CDC18D7A208512.quest_desc: ["&2&lUndergarden'da&r yer alan &cRot yaratıkları&r (&cRotling&f, &cRotwalker&f, &cRotbelcher&f ve &cRotbeast&r) size &cUtherium&r bulaştırabilir. \\n\\nBulaşma gerçekleştiğinde açlık barınızın üstünde kırmızı göstergeler belirir. 4 bar dolduğunda ekranınızda kırmızı damarlar görünür. 8 barda durumun ciddiyetini belirtmek için barlar titremeye başlar. 10 bara ulaştığında hepsi parlar ve canınız yanmaya başlar. \\n\\n&cRot&r (Çürüme), bar tamamen dolmadığı sürece zamanla kendiliğinden geçer. Ayrıca kurtulmak için Mysterious Totem'lerden Saflık (&bPurity&r) etkisi alabilir veya &3Rogdorium&r yiyebilirsiniz. \\n\\nBunların her ikisi de Y=0 altındaki Depths biyomunda bulunur. Oraya ulaşmak için &aForgotten Kazma&r veya &6Allthemodium Kazma&r gibi üst düzey bir kazmaya ihtiyacınız var. \\n\\n&cRot&r etkisinden korunmanın tek yolu zırhınızı Infuser bloğunda &3Rogdorium&r ile işlemektir."]
	quest.76CDC18D7A208512.title: "Uyarı"
	quest.79C652E3FCB88550.quest_desc: [
		"&5Gloomper'lar&r teknik olarak uysaldır fakat kendilerini savunma huyları olduğu için tarafsız sayılırlar! \\n\\nSaldırıya uğradıklarında Kalıcı İksir (Lingering Potion) benzeri bir etki bulutu bırakırlar. \\n\\nÖldüklerinde son derece lezzetli bacaklarını ve bazen de deri düşürürler. \\n\\nAyrıca Gloomgourd ile beslenerek çoğaltılabilirler!"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5Gloomper&r"
	quest.7E3DA4168D352B42.quest_desc: [
		"Söz veriyorum bu son Mantar Bataklığı (Mushroom Bog)! \\n\\nBu mantarlar ilk bakışta sıradan görünse de asıl marifetleri sarkıttıkları parçalarda: \\n\\nVeil'lar (Tüller)! Harika bir dekorasyon bloğu."
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "Veil Mushroom Bog"
	task.39194D9CDF673768.title: "Tüm Hakları Saklıdır"
	task.4AA225E5056787B8.title: "Tüm Hakları Saklıdır"
}