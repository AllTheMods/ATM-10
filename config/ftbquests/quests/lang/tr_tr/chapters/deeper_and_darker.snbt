{
	chapter.13B172FA69904D9F.title: "Deeper and Darker"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.01ECFBB5F0574C24.quest_desc: [
		"Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. "
		""
		"Tüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez. "
		""
		"Bu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."
	]
	quest.0450060852F290CA.quest_desc: [
		"&9Derin Yer Altı Toprakları&r, en çok &3Karanlık Derinlikler&r biyomuna benzer. \n\nBuralar &3Sculk&r'ın yanı sıra &3Çığırtkanlar&r ve &3Sensörler&r ile doludur; evet, bunlar hâlâ &9&lMuhafız&r çağırabilir. \n\nBurada ayrıca daha fazla &3Sculk Yaratığı&r ve Bitki, hatta &3&lOtherside'ın&r sahip olduğu tek Yapıyı bile bulacaksınız!"
		"{image:atm:textures/questpics/deepndark/dnd_land.png width:200 height:100 align:center}"
	]
	quest.0450060852F290CA.title: "&9Derin Yer Altı Toprakları"
	quest.0850F88E2205623F.quest_desc: ["&3Sculk Dalları&r, &bBükük Sarmaşıklar&r gibidir... sadece &3Sculk'ımsı&r. \n\n&9Derin Yer Altı Toprakları&r biyomunda nadiren oluşurlar."]
	quest.0850F88E2205623F.title: "&3Sculk Dalları"
	quest.0B11EAB8D76529E0.quest_desc: [
		"&6Antik Şehir&r, &2&lVanilla Minecraft&r dünyasındaki en tehlikeli Yapıdır. Dolayısıyla bu sadece &3&lDeeper and Darker&r macerasının başlangıcıdır! \n\nBurada bolca &3Sculk&r, değerli Ganimetler ve &9&lMuhafız&r bulabiliriz. Ayrıca &8Güçlendirilmiş Kayrak Taşından&r yapılmış Portal Çerçevesini de bulacağız. \n\nAma o zamana kadar, toplayabildiğiniz kadar Ganimet toplayın! Ve şuna dikkat edin..."
		"{image:atm:textures/questpics/allthemodium/all_city.png width:200 height:100 align:center}"
	]
	quest.0B11EAB8D76529E0.title: "Bir &6Antik Şehir&r Ziyaret Edin"
	quest.0B718FC37699B822.quest_desc: ["&aYankı Odunları&r, &5Yankılanan Orman'da&r yetişen &aYankı Ağaçlarından&r yapılır... burada bir yankı mı var, neden bu kadar çok duyuyorum? \n\n&aYankı Ağaçları&r &5Mor Yapraklara&r ve içlerinde Sculk Işığına sahiptir. Odunları ise &7Açık Gri Kabuğa&r ve çok &aAçık Yeşil Odun Rengine&r sahiptir. \n\nOnlardan yapılan tüm Tahtalar ve Ahşap Eşyalar neredeyse nane benzeri o &aAçık Yeşil Renge&r sahiptir. \n\nTuzak Kapıları ve Kapıları bile harika özgün desenlere sahiptir!"]
	quest.0B718FC37699B822.title: "&aYankı Ağaçları"
	quest.10E025288BB00657.quest_desc: [
		"&bSludges&r, &bBlooming Caverns&r içinde doğar ve Slime'lar gibi davranırlar! \n\nEn büyük formları 8 &4Kalbe&r sahiptir ve tonla Hasar verir. Öldüklerinde 2-4 Orta Boy &bSludge&r oluştururlar. \n\nOrta boy formları 2 &4Kalbe&r sahiptir ve çok daha az Hasar verir. Öldüklerinde 2-4 küçük &bSludge&r oluştururlar. \n\nKüçük form ise sadece yarım &4Kalp Cana&r sahiptir ve hiç Hasar vermez."
		"{image:atm:textures/questpics/deepndark/dnd_sludge.png width:100 height:100 align:center}"
	]
	quest.10E025288BB00657.title: "&bSludge"
	quest.13B338F377951032.quest_desc: ["Hiç kendiniz &9&lMuhafız'ın&r &bSonic Blast&r yeteneğini kullanabilmeyi istediniz mi? \n\n&bSonorous Staff&r ile kullanabilirsiniz! Şarj etmek için Sağ Tıklayıp basılı tutun, ardından &bSonic Blast&r göndermek için bırakın. \nHafif bir bekleme süresi vardır ve Dayanıklılığı bulunur, bu yüzden riski göze alarak kullanın! \n\nBir tane üretmek için &9&lMuhafız'dan&r 1 &9Derinin Kalbi&r, &3&lTakipçi'den&r 2 &3Ruh Kristali&r ve &3Parçalanmışlardan&f 2 &3Sculk Kemiği&r gerekir."]
	quest.13B338F377951032.title: "&bSonorous Staff"
	quest.16A2CC83C99B1F86.quest_desc: [
		"&9Angler Fish&r, &bBlooming Caverns&r içindeki &9Su Göletlerinde&r doğarlar. \n\nNormal balıklar gibi davranırlar, tabii ki nefes almak için &9Suya&r ihtiyaç duyarlar. \n\n3 &4Kalbe&r sahiptirler ve yakında olduğunuzda size saldırırlar. \n\nMaalesef öldüklerinde hiçbir şey düşürmezler... üzgünüz balıkçıklar!"
		"{image:atm:textures/questpics/deepndark/dnd_fish.png width:100 height:120 align:center}"
	]
	quest.16A2CC83C99B1F86.title: "&9Angler Fish"
	quest.183F6A790EC006B8.quest_desc: ["&bBlooming Stem'ler&r Ağaçlar gibi değildir, daha çok Chorus ve Bambu'nun bir bebek yapması gibidir. \n\n&bBlooming Caverns&r içinde yetişirler ve ayakta kalabilmek için diğer &bBlooming Stem'lere&r ihtiyaç duyarlar! Onları bulmanın tek yolu budur. \n\nYine de kabuklarını soyabilir veya onlardan Tahta yapabilirsiniz. Tahtalar &bAçık Mavi renge&r sahiptir ve onlardan yaptığınız her şey de öyle olacaktır!"]
	quest.183F6A790EC006B8.title: "&bBlooming Wood"
	quest.196003E1486ABB31.quest_desc: ["&cNetherit&r zırh ve aletlerinizi &9Muhafız Ekipmanına&r yükseltmek için bir &9Muhafız Yükseltmesi&r kullanmanız gerekir. \\n\\nBu şablonlar &6Antik Şehir&r sandıklarında bulunabilir. \\n\\nElinize bir tane geçtiğinde 7 Elmas ve 1 &3Sculk Bloğu&r kullanarak kopyalayabilirsiniz!"]
	quest.196003E1486ABB31.title: "&9Muhafız Yükseltmesi"
	quest.1A2EA742FDED54FF.quest_desc: ["&5Yankı Toprağı&r, &5Yankılanan Orman&r tabanını kaplar. \n\nÜzerlerinde &5Yankı Fidanlarının&r büyümesine izin vermesi dışında normal &2Çim&r veya Toprak gibi davranmazlar. \n\nNormal fidanlar büyümez."]
	quest.1A2EA742FDED54FF.title: "&5Yankı Toprağı"
	quest.1BFE6745F49B4AB0.quest_desc: ["Sculk Işığı, Mantarışığı ile benzer özellik gösterir. Toplamak için alet gerekmez ancak en hızlı Çapa ile kırılırlar. \\n\\nGenellikle &5Yankı Ağaçlarının&r gövdesinde ve nadiren yer altında bulunurlar."]
	quest.201E3E41018F9521.quest_desc: ["&6Kasvetli Kaktüsler&r tıpkı normal &2Kaktüsler&r gibidir, sadece mevcutturlar ve &cBulutlu Sütunlar&r içinde oluşurlar. \n\nYani Sıcağı severler, büyümek için &9Suya&r ihtiyaç duymazlar, dokununca can yakarlar, aralarında bir fark bile var mı ki? \n\nAh evet, bunlar &2Yeşil&r yerine &6Turuncu Boya&r elde etmek için fırınlanabilir!"]
	quest.201E3E41018F9521.title: "&6Kasvetli Kaktüs"
	quest.21398F45428CD1D1.quest_desc: ["&6Bloom Berries&r, &bBlooming Caverns&r tavanındaki &bGlowing Vines&r üzerinde yetişir. \n\n&bGlowing Vines&r içinde &6Bloom Berries&r oluşabilir ve Sağ Tık ile onları &bSarmaşıktan&r toplamanızı beklerler! \n\nBu, &3&lOtherside&r boyutundaki tek Yiyecek Kaynağıdır."]
	quest.21398F45428CD1D1.title: "&6Bloom Berries"
	quest.35629CB10DBDE340.quest_desc: [
		"&6Antik Tapınak&r, &9Derin Yer Altı Toprakları&r içinde bulunan önemli ve gerekli bir Yapıdır. \n\n&8Kayrak Taşı&r ve &3Sculk&r'tan yapılmış bir Maya Piramidine benzer. Sandıklar ve Antik Vazoların yanı sıra tonlarca &3Sculk Sensörü&r ve &3Sculk Çığırtkanı&r vardır. \n\nÜst katlarda çoğunlukla sadece Sandıklar ve Antik Vazolar bulacaksınız, ancak &6Piramit&r içinde &eAltın Blokları&r ve diğer Malzemeleri bile bulacağız."
		"{image:atm:textures/questpics/deepndark/dnd_temple.png width:200 height:100 align:center}"
	]
	quest.35629CB10DBDE340.quest_subtitle: "Tek yapı"
	quest.35629CB10DBDE340.title: "&6Antik Tapınak"
	quest.36149E69A8C264E4.quest_desc: ["&bIce Lilies&r, &bBlooming Caverns&r içindeki &9Su Göletlerinde&r yetişen Bitkilerdir (size çok fazla Bitkisi olduğunu söylemiştim). \n\nBitkinin 2 parçası vardır: &bLily&r ve &bIce Flower&r. &bLily Pad&r &9Su&r üzerinde yüzen ve üzerinde yürümenizi sağlayan kısımdır. &bIce Flower&r ise &bLily Pad'in&r üzerinde durur ve çok güzel görünür!\n\nOnları yakalamak için Makasa ihtiyacınız olacak."]
	quest.36149E69A8C264E4.title: "&bIce Lilies"
	quest.39100B3867E9C01E.quest_desc: ["&cKasvetli Gayzerler&r, &cBulutlu Sütunlar&r biyomunda bulabileceğiniz özel bloklardır. \\n\\nÜzerlerinden geçtiğinizde sizi havaya fırlatırlar! Düşüş hasarına karşı dikkatli olmalısınız. \\n\\nBu blokları İpeksi Dokunuş ile toplayabilirsiniz."]
	quest.39100B3867E9C01E.title: "&cKasvetli Gayzer"
	quest.39BED5DD9D24F98E.quest_desc: ["&3Sculk Pisliği&r, &3&lDeeper and Darker'ın&r Kil versiyonudur! \n\nBirkaç biyomda bulabilirsiniz ve kazdığınızda &3Kir topları&r elde edersiniz. \n\nBunlar daha sonra tekrar &3Sculk Pisliği&r yapılabilir veya &3Kir Tuğlaları&r haline getirilebilir."]
	quest.39BED5DD9D24F98E.title: "&3Sculk Pisliği"
	quest.3CF2DFB7F0CE065B.quest_desc: [
		"&cBulutlu Sütunlar&r, buradaki diğer biyomlardan çok daha Sıcak ve &6Turuncudur&r. \n\nBurada &3Sculk&r yerini &cKasvvetli Sculk'a&r ve &3Sculk Taşı&r yerini &cKasvetli Levhaya&r bırakır. \n\nAyrıca altlarında &cMagma&f ve &cLava&r ile birlikte Ruh Kumu/Toprağı bulacaksınız. \n\nSıcaklıklar çok yüksek olduğu için Yaratıklar normalde burada doğmaz, ancak birkaç Bitki yaşamı mevcuttur!"
		"{image:atm:textures/questpics/deepndark/dnd_column.png width:200 height:100 align:center}"
	]
	quest.3CF2DFB7F0CE065B.title: "&cBulutlu Sütunlar"
	quest.3D579A1F7EFEDD5C.quest_desc: [
		"&9&lMuhafız&r. &2&lMinecraft'taki&r en zor patron, elbette en zor Yapının içinde yer alıyor. \n\nBir &3Sculk Çığırtkanının&r 3 kez etkinleştirilmesiyle veya ilk &9&lMuhafız'dan&r sonraki herhangi bir sayıda ortaya çıkar. \n\n500 &4Kalbe&r sahiptir ve yumruklarıyla ya da &bSonic Blast&r yeteneğiyle vurarak tonla Hasar verir! \n\nYine de bir zayıflığı vardır, o da Kör olmasıdır. Sizi yalnızca Sesle veya yeterince yakınsanız Kokuyla bulabilir! Mesafenizi koruyun, 23 Blok yukarı çıkmak gibi."
		"{image:atm:textures/questpics/gettingstarted/warden_roar.png width:100 height:100 align:center}"
	]
	quest.3D579A1F7EFEDD5C.title: "&9&lMuhafız&r'ı Öldür"
	quest.44F9B8F285546B2C.quest_desc: ["&bÇiçeklenmiş Yosun Bloğu&r şuradan gelir... bildiniz! &bBlooming Caverns&r! \n\nToplamanız için yerde öylece oluşacaktır. \n\nNormal &2Yosun&r gibi yayılmazlar ve herhangi bir Tarifleri yoktur."]
	quest.44F9B8F285546B2C.title: "&bÇiçeklenmiş Yosun Bloğu"
	quest.45C9D975E3731DFE.quest_desc: ["&9Güçlendirilmiş Yankı Parçası&r, birkaç Eşya gerektiren üretilebilir bir eşyadır. \n\nİlki ve elde etmesi en kolayı &7Kâbus Zarıdır&r! &7Kâbuslar&r Oyuncu birkaç gün uyumadıktan sonra ortaya çıkar. Uykusuz geceler ne kadar çoksa, o kadar çok &7Kâbus&r belirir! \n\nİkincisi &9Yankı Parçacığıdır&r. Bunlar pek çok yolla bulunabilir ama en kolayı &6Antik Şehirleri&r yağmalamaktır. \n\nSonuncusu ise &9Muhafız Karapaksıdır&r. Bunlar &9&lMuhafız&r öldüğünde düşer. Merak etmeyin genelde birden fazla düşürür!"]
	quest.45C9D975E3731DFE.title: "&9Güçlendirilmiş Yankı Parçası"
	quest.4A01C5F5DCF32C19.quest_desc: ["&3Ruh Elitrası&r tıpkı normal bir &8Elitra&r gibi çalışır, sadece daha fazla Dayanıklılık ve Zırh Puanına sahiptir! \n\nNormal &8Elitra'lar&r gibi &7Kâbus Zarı&r ile tamir edilemezler... ama Büyüler yine de onları tamir edebilir! \n\nBir tane üretmek için 1 &8Elitra&r, &3Parçalanmıştan&r düşen 4 &3Sculk Kemiği&r, &3Sculk Isırganı&f veya &3Sculk Sülüğü'nden&r düşen 2 &3Ruh Tozu&r ve &3&lTakipçi'den&r düşen 1 &3Ruh Kristali&r gerekir."]
	quest.4A01C5F5DCF32C19.title: "&3Ruh Elitrası"
	quest.4D57A07592AED307.quest_desc: [
		"&3&lTakipçi&r, Antik Vazolar kırılarak çağrılabilen bir Patrondur. \n\n200 &4Kalbe&r ve takip etmek için bir Patron Barına sahiptir. &3Ruh Kristali&r almak için onu öldürmemiz gerekecek. \n\nÇok hızlıdır ve vurursa tonla Hasar verir. Neyse ki &9&lMuhafız&r gibi Kör'dür. Ancak yakındaki her şeyi duymasını sağlayan harika bir işitme duyusuna sahiptir. \n\nBirkaç saldırısı vardır, normalde sadece Vurur. Bazen bir ALAN (AOE) saldırısına neden olabilir ve size saldırması için &3Sculk Sülükleri&r çağırabilir! \n\nAyrıca &3Sculk&r olmayan her Yaratığa da saldırır."
		"{image:atm:textures/questpics/deepndark/dnd_stalker.png width:100 height:200 align:center}"
	]
	quest.4D57A07592AED307.title: "&3&lTakipçi"
	quest.56D41A4605C42EB5.quest_desc: ["&6Kristalize Kehribar&r blokları &cBulutlu Sütunlar&r biyomunda oluşur. \\n\\nKırmadan toplamak için İpeksi Dokunuş gereklidir. Dekoratif açıdan son derece şık dururlar!"]
	quest.56D41A4605C42EB5.title: "&6Kristalize Kehribar"
	quest.5866438E5D19AB69.quest_desc: [
		"&3Sculk Sülükleri&r bazen kırılan Antik Vazolardan fırlayabilir. \n\n2 tanesi birden çıktığında sizin için küçük bir sürpriz olur! \n\nYalnızca 2 &4Kalbe&r sahiptirler ve buna rağmen size saldırırlar. \n\nÖldüklerinde &3Ruh Tozu&r düşürürler."
		"{image:atm:textures/questpics/deepndark/dnd_leech.png width:100 height:100 align:center}"
	]
	quest.5866438E5D19AB69.title: "&3Sculk Sülüğü"
	quest.59AF80E8EE17C769.quest_desc: [
		"&5Yankılanan Orman&r biraz sade bir yerdir ama aynı zamanda &5Yankı Ağaçlarına&r ev sahipliği yapar! \n\n&5Yankı Ağaçları&r normal Ağaçlar gibi davranır, Üretim için &aOdunlarını&r kazabilirsiniz ve &5Yaprakları&r fidan düşürür. Ayrıca Yaprakların içinde Sculk Işığı da bulabilirsiniz. \n\nÇevresinde, tüm yüzeyi kaplayan &5Yankı Toprağı&r bulacaksınız. Bunlar maalesef Tarım Arazisine veya Toprağa dönüştürülemez, sadece Blokturlar."
		"{image:atm:textures/questpics/deepndark/dnd_forest.png width:200 height:100 align:center}"
	]
	quest.59AF80E8EE17C769.title: "&5Yankılanan Orman"
	quest.5C983A41886A2B75.quest_desc: ["&2&lOverworld'e&r geri dönmek için geldiğimiz yoldan ayrılabiliriz! \n\n&8Güçlendirilmiş Kayrak Taşı&r çerçevesinde &9Derinin Kalbi&r kullanın. \n\nNeyse ki &6Antik Tapınağın&r tabanında bunlardan bir tane bulabiliyoruz."]
	quest.5C983A41886A2B75.title: "Evim, Güzel Evim!"
	quest.5CCF573B67317591.quest_desc: ["&bGlowing Roots&r, &bBlooming Caverns&r içinde oluşur. \n\nTırmanılamazlar ve Yiyecek düşürmezler... Sanırım sadece dekorasyon amaçlılar."]
	quest.5CCF573B67317591.title: "&bGlowing Roots"
	quest.5E287410EE969244.quest_desc: [
		"&9Parçalanmışlar&r, &3&lOtherside&r boyutunda oldukça fazla Biyomda doğarlar. \n\nMinyatür &9&lMuhafızlar&r gibi davranırlar, Kör olup Düşmanları bulmak için &3Sculk'a&r güvenirler. Ayrıca &3Sculk&r olmayan tüm Yaratıklara saldırırlar. \n\n&9Parçalanmışlar&r 50 &4Kalbe&r sahiptir ve bayağı sert vururlar! Bu yüzden çok fazla çekmemeye dikkat edin. \n\nOnları öldürebilirseniz &9Sculk Kemiği&r düşürürler. Bunlar birkaç Tarif için gerekli olacaktır."
		"{image:atm:textures/questpics/deepndark/dnd_shattered.png width:100 height:150 align:center}"
	]
	quest.5E287410EE969244.title: "&9Parçalanmış"
	quest.60721C9B94B36C24.quest_desc: [
		"&3Sculk Çiyanları&r, &3&lOtherside&r boyutunda doğan uzun tarafsız Yaratıklardır. \n\n10 &4Kalbe&r sahiptirler ve vurulurlarsa Kurtlar gibi grup halinde saldırırlar. \n\nSadece &aXP&r ve belki İp düşürürler, bu yüzden kendi hallerine bırakmak en iyisidir!"
		"{image:atm:textures/questpics/deepndark/dnd_centipede.png width:100 height:100 align:center}"
	]
	quest.60721C9B94B36C24.title: "&3Sculk Çiyanı"
	quest.67D38E8A57949B34.quest_desc: ["&3Sculk Ağızları&r, &9Derin Yer Altı Toprakları&r biyomunda yer alan tuzak bloklarıdır. \\n\\nÜzerlerine bastığınızda sizi yakalayıp aşağı çeker ve sürekli hasar verirler. \\n\\nİpeksi Dokunuş kullanarak bu blokları kırıp toplayabilirsiniz."]
	quest.67D38E8A57949B34.title: "&3Sculk Ağzı"
	quest.68446510A1B0D9B8.quest_desc: [
		"&bBlooming Caverns&r, normal Mağaralardan ziyade &bYemyeşil Mağaralara&r benzer. Bunu BİTKİ bolluğu yüzünden söylüyorum! \n\nTavandan tabana büyüyen Bitkiler, tabandan tavana büyüyen Bitkiler, &9Sudan&r büyüyen Bitkiler ve hiç Büyümeyen Bitkiler bulacaksınız! \n\nZemin &bBlooming Sculk Stone&r ve hatta &bÇiçeklenmiş Yosun Bloğu&r ile kaplıdır. \n\nBurada Su Göletleri bile var, bu &3&lBoyutta&r &9Su&r bulabileceğiniz tek yer burasıdır."
		"{image:atm:textures/questpics/deepndark/dnd_cave.png width:200 height:100 align:center}"
	]
	quest.68446510A1B0D9B8.title: "&bBlooming Caverns"
	quest.6BB948F44B0950E8.quest_desc: ["&3Sculk Taşı&r, &cBulutlu Sütunlar&r hariç hemen hemen her yerde oluşur. \n\nNormal &7Taş&r gibi çalışır, her bakımdan. Kırık versiyonlarını pişirerek &3Sculk Taşı&r elde edebilirsiniz ve bu da daha sonra birçok diğer Yapı Bloğuna dönüştürülebilir. \n\nMaalesef Taş Aletler yapmak için kullanılamaz... dur bir dakika ne umursuyorsun ki, &9&lMuhafız'ı&r öldürdün! Neden Taş Aletlere ihtiyacın olsun ki?!?!?!"]
	quest.6BB948F44B0950E8.title: "&3Sculk Taşı"
	quest.6E38CF6E7360E9CA.quest_desc: ["&9&lMuhafız&r oldukça fazla Eşya düşürür ama en önemlisi &9Derinin Kalbidir&r. \n\n&3&lOtherside&r boyutuna Portalımızı açmak için &9Derinin Kalbi'ni&r bir &8Güçlendirilmiş Kayrak Taşı&r çerçevesinde kullanabiliriz. Portal Çerçevesini engelleyen hiçbir Blok olmamalıdır, aksi takdirde çalışmaz. \n\nAyrıca &9Muhafız Karapaksı&r ve &9Yankı Parçacığı&r da düşürür, her ikisi de diğer Eşyaları üretmek için yararlı olacaktır!"]
	quest.6E38CF6E7360E9CA.title: "&9Derinin Kalbi"
	quest.6E901EF1CB411088.quest_desc: ["&9Muhafız Zırhı&r, &cNetherit'in&r doğrudan yükseltmesidir. Yapmak için sadece bir &9Muhafız Yükseltmesi&r, bir &9Güçlendirilmiş Yankı Parçası&r ve bir parça &cNetherit Zırhı&r kullanın. \n\nHer parça, &cNetherit&r muadiline göre 1 Zırh Puanı ve 1 Zırh Koruması daha fazlasına sahiptir. \n\nArtık Geri Tepme Direnci yok ama. \n\nYine de en azından &cNetherit'ten&r çok daha havalı görünüyorlar! &9Kask&r, &9&lMuhafız&r gibi devasa boynuzlara sahiptir ve &9Göğüslük&r bir kalp noktasına sahiptir."]
	quest.6E901EF1CB411088.title: "&9Muhafız Zırhı"
	quest.716FF64ACF896D50.quest_desc: ["&cKasvetli Levha&r, &cBulutlu Sütunlar&r içinde &3Sculk Taşının&r yerini alır. \n\nTıpkı &3Sculk Taşı&r gibi çalışır, sadece daha Kahverengidir."]
	quest.716FF64ACF896D50.title: "&cKasvetli Levha"
	quest.726A627BD7654E0C.quest_desc: ["Bu Aletler için &cNetherit'ten&r &9Muhafız'a&r geçişte pek bir değişiklik yoktur. \n\nKazma aynı Seviyede ve aynı Hızdadır. Kürekler hâlâ Yol yapabilir ve yine aynı Hızdadır. Çapalar hâlâ Tarım Arazisi yapabilir ve ayrıca aynı Hızdadır. \n\nTek gerçek değişiklik hepsi için daha yüksek Saldırı Hasarıdır. \n\nKomik bir şekilde bu, &9Muhafız Çapalarının&r tüm &2&lVanilla&r Çapalardan daha yüksek Hasara sahip olduğu anlamına gelir!"]
	quest.726A627BD7654E0C.title: "&9Muhafız Aletleri"
	quest.72EC845C19645AFC.quest_desc: ["&3Sculk Sarmaşıkları&r, &4Ağlayan Sarmaşığın&r &3Sculk&r versiyonudur. \n\n&bBlooming Caverns&r ve &9Derin Yer Altı Toprakları&r içinde oluşabilirler."]
	quest.72EC845C19645AFC.title: "&3Sculk Sarmaşığı"
	quest.736F4A43EEBDD7B3.quest_desc: [
		"&3Sculk Isırganları&r küçük ama öfkeli Yaratıklardır! \n\nOnların &9Derin Yer Altı Toprakları &fve &cBlooming Caverns&r içinde doğduklarını gördüm. \n\n6 &4Kalbe&r sahiptirler ve Öldüklerinde &3Ruh Tozu&r düşürürler."
		"{image:atm:textures/questpics/deepndark/dnd_snapper.png width:100 height:100 align:center}"
	]
	quest.736F4A43EEBDD7B3.title: "&3Sculk Isırganı"
	quest.76F14C2B866B4EAD.quest_desc: ["&3&lOtherside&r, &9&lMuhafız&r da dahil olmak üzere &3Sculk &fve &3Sculk yaratıklarının&r doğum yeridir. \n\nBurada onun pek çok uzak kuzenini bulacaksınız, ama endişelenmeyin &3&lOtherside'ın&r birkaç artı yönü de var! \n\nBulabileceğimiz pek çok yeni Yapı Bloğu ve Eşya var ve tonlarca &aXP&r için her yerde &3Sculk&r var! \n\nBu yüzden Çapanızı hazırlayın ve &3&lOtherside'a&r doğru maceraya atılın!"]
	quest.76F14C2B866B4EAD.quest_subtitle: "Merhaba..."
	quest.76F14C2B866B4EAD.title: "&3&lOtherside"
	quest.774D61FEFABEFD9A.quest_desc: [
		"Çığlık Solucanları, &9Derin Yer Altı Topraklarında&r &3Enfekte Sculk'a&r basıldığında oluşurlar. \n\n100 &4Kalbe&r sahip Mini patronlardır. \n\nÇok yaklaşırsanız sizi ısırırlar ve tonla Hasara neden olurlar! Ama çok uzağa giderseniz tekrar toprağın altına çekilirler. \n\nBiraz &aXP&r dışında hiçbir şey düşürmezler, bu zahmete değeceğini sanmıyorum."
		"{image:atm:textures/questpics/deepndark/dnd_worm.png width:100 height:200 align:center}"
	]
	quest.774D61FEFABEFD9A.title: "Çığlık Solucanı"
	quest.78BCED8699ADEDF4.quest_desc: ["&3Soundproof Glass&r, &3Ruh Tozu&r ve Cam birleştirilerek yapılır. \n\nBunlar tıpkı Yün gibi Sesi hafifletmeye yarar! Bir &3Sculk Sensörünün &fveya &3Sculk Çığırtkanının&r üzeri bunlardan biriyle kapatılırsa Sesleri duymazlar. \n\nSadece bunların arkasını görebilirsiniz!"]
	quest.78BCED8699ADEDF4.title: "&3Soundproof Glass"
	quest.7CBAA67204CC258C.quest_desc: ["Hayır, &9&lMuhafız&r Kılıç ve Balta kullanmaz. Ama biz kullanabiliriz! \n\nHem &9Muhafız Kılıcı &fhem de &9Muhafız Baltası&r, bir &9Güçlendirilmiş Yankı Parçası &fve &9Muhafız Yükseltmesi&r ile &cNetherit versiyonlarının&r yükseltmeleridir. \n\nHer biri 1 &4Kalp&r daha fazla Hasara ve daha da fazla Dayanıklılığa sahiptir! \n\nEvet, Balta hâlâ Ağaçları verimli bir şekilde kesebilir."]
	quest.7CBAA67204CC258C.title: "&9Muhafız Silahları"
	quest.7FF3EA602FE7A546.quest_desc: ["&3Sculk Vericisi&r, &6Antik Tapınak&r Sandıklarında bulabileceğimiz çok nadir bir Eşyadır. \n\nBir tane bulduğunuzda en iyi arkadaşınız olacak! \n\nKullanmak için arayüzü olan bir Bloğa Shift Sağ Tıklayın; Sandıklar, Çalışma Masaları ve Ocaklar gibi düşünün. Ardından &3Verici&r o Eşyaya bağlanacaktır. \n\nBundan sonra, o Bloğa nereden olursanız olun uzaktan erişmek için &3Vericiyi&r kullanabiliriz! \n\nBloğun bağlantısını kaldırmak için &3Verici&r ile Havaya Shift Sağ Tıklayın."]
	quest.7FF3EA602FE7A546.title: "&3Sculk Vericisi"
	task.5B7FD7C2F05FA64D.title: "Her hakkı saklıdır"
}
