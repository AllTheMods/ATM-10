{
	chapter.13B172FA69904D9F.title: "Deeper and Darker"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.01ECFBB5F0574C24.quest_desc: [
		"Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. "
		""
		"Tüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r'nin açık izni olmadan yayınlanmayan hiçbir halka açık pakette kullanılmasına izin verilmez. "
		""
		"Bu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."
	]
	quest.0450060852F290CA.quest_desc: [
		"&9Deeplands&r en çok &3Deep Dark&r'a benzer. \\n\\nOnlar &3Sculk&r'ın yanı sıra, evet hala &9&lWarden&r'ı çıkarabilen &3Shriekers&r ve &3Sensors&r ile doludurlar. \\n\\nBurada ayrıca daha fazla &3Sculk Creatures&r ve bitkiler ve hatta &3&lOtherside&r'ın sahip olduğu tek Yapıyı da bulacaksınız!"
		"{image:atm:textures/questpics/deepndark/dnd_land.png width:200 height:100 align:center}"
	]
	quest.0450060852F290CA.title: "&9Deeplands"
	quest.0850F88E2205623F.quest_desc: ["&3Sculk Tendrils&r tıpkı &bTwisting Vines&r gibidir... sadece &3Sculky&r versiyonudur. \\n\\n&9Deeplands&r içinde nadiren ortaya çıkarlar."]
	quest.0850F88E2205623F.title: "&3Sculk Tendrils"
	quest.0B11EAB8D76529E0.quest_desc: [
		"&6Ancient City&r, &2&lVanilla Minecraft&r'daki yalnızca en tehlikeli Yapıdır. Tabii ki bu, &3&lDeeper and Darker&r için sadece bir başlangıçtır! \\n\\nBurada Ganimet ve &9&lWarden&r'ın yanı sıra bolca &3Sculk&r bulabiliriz. Ayrıca &8Reinforced Deepslate&r'den yapılmış Portal Çerçevesini de bulacağız. \\n\\nAncak o zamana kadar, toplayabildiğiniz kadar Yağma yapın! Ve şuna dikkat edin..."
		"{image:atm:textures/questpics/allthemodium/all_city.png width:200 height:100 align:center}"
	]
	quest.0B11EAB8D76529E0.title: "Bir &6Ancient City&r'yi Ziyaret Et"
	quest.0B718FC37699B822.quest_desc: ["&aEcho Logs&r, &5Echoing Forest&r'da yetişen &aEcho Trees&r'den elde edilir... burada bir yankı mı var, neden bunu bu kadar çok duyuyorum? \\n\\n&aEcho Trees&r'in &5Purple Leaves&r'i ve içlerinde Sculk Gleam'leri vardır. Kütükleri &7Açık Gri Kabuğa&r ve çok &aAçık Yeşil Kütük rengine&r sahiptir. \\n\\nBundan yapılan tüm Tahtalar ve Ahşap Eşyalar, neredeyse Nane gibi &aAçık Yeşil Renk&r tonundadır. \\n\\nTuzak kapıları ve Kapılar bile harika benzersiz desenlere sahiptir!"]
	quest.0B718FC37699B822.title: "&aEcho Trees"
	quest.10E025288BB00657.quest_desc: [
		"&bSludges&r, &bBlooming Caverns&r'da ortaya çıkar ve tıpkı Slimes gibi davranır! \\n\\nEn büyük formları 8 &4Hearts&r'e sahiptir ve çok fazla Hasar verir. Öldüklerinde 2-4 adet Orta boy &bSludges&r ortaya çıkarırlar. \\n\\nOrta formları 2 &4Hearts&r'e sahiptir ve çok daha az Hasar verir. Öldüklerinde 2-4 adet küçük &bSludges&r ortaya çıkarırlar. \\n\\nKüçük form sadece yarım &4Heart of Health&r'e sahiptir ve hiç Hasar vermez."
		"{image:atm:textures/questpics/deepndark/dnd_sludge.png width:100 height:100 align:center}"
	]
	quest.10E025288BB00657.title: "&bSludge"
	quest.13B338F377951032.quest_desc: ["Hiç kendi başına &9&lWardens&r'ın &bSonic Blast&r yeteneğini kullanabilmeyi diledin mi? \\n\\n&bSonorous Staff&r ile bunu yapabilirsin! Sadece şarj etmek için Sağ Tıkla basılı tut, ardından bir &bSonic Blast&r göndermek için bırak. \\nBunun hafif bir bekleme süresi vardır ve Dayanıklılığa sahiptir, bu yüzden risk alarak kullanın! \\n\\nBir tane Üretmek için &9&lWarden&r'dan bir &9Heart of the Deep&r, &3&lStalker&r'dan 2 adet &3Soul Crystals&r ve &3Shattereds&r'dan 2 adet &3Sculk Bones&r'a ihtiyacınız olacak."]
	quest.13B338F377951032.title: "&bSonorous Staff"
	quest.16A2CC83C99B1F86.quest_desc: [
		"&9Angler Fish&r, &bBlooming Caverns&r içindeki &9Water Ponds&r'larda ortaya çıkar. \\n\\nNormal Balıklar gibi davranırlar, açıkçası nefes almak için &9Water&r'a ihtiyaçları vardır. \\n\\n3 &4Hearts&r canları vardır ve yaklaştığınızda size saldırırlar. \\n\\nNe yazık ki öldüklerinde hiçbir şey düşürmezler... üzgünüm Balıklar!"
		"{image:atm:textures/questpics/deepndark/dnd_fish.png width:100 height:120 align:center}"
	]
	quest.16A2CC83C99B1F86.title: "&9Angler Fish"
	quest.183F6A790EC006B8.quest_desc: ["&bBlooming Stems&r Ağaçlar gibi değildir, daha çok Chorus ve Bamboo'nun bir bebeği olsaydı ona benzerlerdi. \\n\\n&bBlooming Caverns&r içinde ortaya çıkarlar ve ayakta kalabilmek için diğer &bBlooming Stems&r'lere ihtiyaç duyarlar! Onları bulmanın tek yolu budur. \\n\\nOnları hala Soyabilir veya onlardan Tahta yapabilirsiniz. Tahtalar &bAçık Mavi renge&r sahiptir ve onlardan yaptığınız her şey de öyle olacaktır!"]
	quest.183F6A790EC006B8.title: "&bBlooming Wood"
	quest.196003E1486ABB31.quest_desc: ["&cNetherite&r'dan &9Warden Gear&r'a yükseltme yapmak için bir &9Smithing Template&r'e ihtiyacınız olacak! \\n\\nBunlar &6Ancient Cities&r'deki Sandıklarda bulunur. \\n\\nDaha sonra 7 Diamonds ve bir &3Sculk Block&r ile çoğaltılabilirler!"]
	quest.196003E1486ABB31.title: "&9Warden Upgrade Template"
	quest.1A2EA742FDED54FF.quest_desc: ["&5Echo Soil&r, &5Echoing Forests&r'ın zeminini kaplar. \\n\\n&5Echoing Saplings&r'in üzerlerinde büyümesine izin vermeleri dışında normal &2Grass&r veya Dirt gibi davranmazlar. \\n\\nNormal Fidanlar büyümez."]
	quest.1A2EA742FDED54FF.title: "&5Echo Soil"
	quest.1BFE6745F49B4AB0.quest_desc: ["Sculk Gleam, Shroomlight'ların özelliklerine sahiptir. Toplamak için bir Araca ihtiyaçları yoktur, ancak en hızlı bir Hoe ile kırılırlar. \\n\\n&5Echoing Trees&r içinde ve nadiren yeraltında ortaya çıkarlar."]
	quest.201E3E41018F9521.quest_desc: ["&6Gloomy Cacti&r, &cOvercast Columns&r içinde ortaya çıkmaları dışında tıpkı normal &2Cacti&r gibidir. \\n\\nYani sıcağı severler, büyümek için &9Water&r'a ihtiyaç duymazlar, dokunmak acıtır, acaba herhangi bir farklılıkları var mıdır? \\n\\nAh evet, bunlar &2Yeşil&r yerine &6Turuncu Boyaya&r Eritilebilirler!"]
	quest.201E3E41018F9521.title: "&6Gloomy Cacti"
	quest.21398F45428CD1D1.quest_desc: ["&6Bloom Berries&r, &bBlooming Caverns&r'ın çatısındaki &bGlowing Vines&r'den büyür. \\n\\n&bGlowing Vines&r içinde &6Bloom Berries&r ortaya çıkabilir ve Sağ Tık ile &bVine&r'dan onları toplamanızı bekleyecektir! \\n\\nBu, &3&lOtherside&r'daki tek Yiyecek Kaynağıdır."]
	quest.21398F45428CD1D1.title: "&6Bloom Berries"
	quest.35629CB10DBDE340.quest_desc: [
		"&6Ancient Temple&r, &9Deeplands&r içinde bulunan önemli ve gerekli bir Yapıdır. \\n\\n&8Deepslate&r ve &3Sculk&r'dan yapılmış bir Maya Piramidine benzer. Sandıklar ve Antik Vazoların yanı sıra tonlarca &3Sculk Sensors&r ve &3Shriekers&r vardır. \\n\\nDaha yüksek katlarda çoğunlukla sadece Sandıklar ve Antik Vazolar bulacaksınız, ancak &6Pyramid&r içinde &eBlocks of Gold&r ve diğer Malzemeleri bile bulacağız."
		"{image:atm:textures/questpics/deepndark/dnd_temple.png width:200 height:100 align:center}"
	]
	quest.35629CB10DBDE340.quest_subtitle: "Tek yapı"
	quest.35629CB10DBDE340.title: "&6Ancient Temples"
	quest.36149E69A8C264E4.quest_desc: ["&bIce Lilies&r, &bBlooming Caverns&r içindeki &9Water Ponds&r'larda yetişen Bitkilerdir (Size çok sayıda Bitki olduğunu söylemiştim). \\n\\nBitkinin 2 bölümü vardır, &bLily&r ve &bIce Flower&r. &bLily Pad&r, &9Water&r üzerinde yüzen ve üzerinde yürümenizi sağlayan şeydir. &bIce Flower&r, &bLily Pad&r'in üzerinde durur ve çok güzel görünür!\\n\\nOnları yakalamak için Shears'a ihtiyacınız olacak."]
	quest.36149E69A8C264E4.title: "&bIce Lilies"
	quest.39100B3867E9C01E.quest_desc: ["&cGloomy Geysers&r, &cOvercast Columns&r içinde bulabileceğiniz Bloklardır. \\n\\nÜzerlerinden yürüdüğünüzde sizi Havada yükseklere fırlatacaklardır! Ancak dikkatli olun, yine de Düşme Hasarı alacaksınız. \\n\\nBunları Silk Touch kullanarak toplayabilirsiniz."]
	quest.39100B3867E9C01E.title: "&cGloomy Geyser"
	quest.39BED5DD9D24F98E.quest_desc: ["&3Sculk Grime&r, &3&lDeeper and Darker&r'ın Clay versiyonudur! \\n\\nBunu birkaç Biyom içinde bulabilirsiniz ve kazdığınızda &3Grime Balls&r elde edeceksiniz. \\n\\nBunlar daha sonra tekrar &3Sculk Grime&r haline getirilebilir veya &3Grime Bricks&r'e dönüştürülebilir."]
	quest.39BED5DD9D24F98E.title: "&3Sculk Grime"
	quest.3CF2DFB7F0CE065B.quest_desc: [
		"&cOvercast Columns&r, buradaki diğer tüm Biyomlardan çok daha Sıcak ve &6Turuncudur&r. \\n\\nBurada &3Sculk&r yerini &cGloomy Sculk&r'a bırakır ve &3Sculk Stone&r yerini &cGloomslate&r'e bırakır. \\n\\nAyrıca altlarında &cLava&r olan Soul Sand/Soil ve &cMagma&r bulacaksınız. \\n\\nSıcaklıklar çok Yüksek olduğundan, Mob'lar normalde burada ortaya çıkmaz, ancak birkaç Bitki örtüsü vardır!"
		"{image:atm:textures/questpics/deepndark/dnd_column.png width:200 height:100 align:center}"
	]
	quest.3CF2DFB7F0CE065B.title: "&cOvercast Columns"
	quest.3D579A1F7EFEDD5C.quest_desc: [
		"&9&lWarden&r. Tabii ki en zor Yapı içinde olan, &2&lMinecraft&r'daki en zor patron. \\n\\nBir &3Sculk Shrieker&r'ın 3 kez veya ilk &9&lWarden&r'dan sonra herhangi bir miktarda etkinleştirilmesinden ortaya çıkar. \\n\\n500 &4Hearts&r canı vardır ve size yumruklarıyla veya &bSonic Blast&r ile vurarak büyük Hasar verir! \\n\\nAncak onun bir zayıf noktası var, o da Kör olmasıdır. Sizi ancak Sesle veya yeterince yakındaysanız Koku ile bulabilir! Mesafenizi koruyun, mesela 23 Blok yukarıda."
		"{image:atm:textures/questpics/gettingstarted/warden_roar.png width:100 height:100 align:center}"
	]
	quest.3D579A1F7EFEDD5C.title: "&9&lWarden&r'ı Öldür"
	quest.44F9B8F285546B2C.quest_desc: ["&bBlooming Moss&r... tahmin ettiniz! &bBlooming Caverns&r'dan geliyor! \\n\\nOnu toplamanızı bekleyerek yerde ortaya çıkacaktır. \\n\\nNormal &2Moss&r gibi yayılmazlar ve herhangi bir Tarifleri yoktur."]
	quest.44F9B8F285546B2C.title: "&bBlooming Moss"
	quest.45C9D975E3731DFE.quest_desc: ["&9Reinforced Echo Shard&r, birkaç Eşya gerektiren Üretilmiş bir Eşyadır. \\n\\nİlki ve elde etmesi en kolay olanı &7Phantom Membrane&r! Oyuncu birkaç gün uyumadığında &7Phantoms&r ortaya çıkacaktır. Geceler ne kadar uykusuz geçerse, o kadar çok &7Phantoms&r! \\n\\nİkincisi &9Echo Shard&r'dır. Bunlar epeyce şekilde bulunabilir ancak en kolayı &6Ancient Cities&r içindeki Ganimetlerdir. \\n\\nSonuncusu ise &9Warden Carapaces&r'dir. Bunlar öldüğünde &9&lWarden&r'dan Düşer. Merak etmeyin, o genellikle birden fazla düşürür!"]
	quest.45C9D975E3731DFE.title: "&9Reinforced Echo Shard"
	quest.4A01C5F5DCF32C19.quest_desc: ["&3Soul Elytra&r tıpkı normal bir &8Elytra&r gibi çalışır, sadece artık daha fazla Dayanıklılığa ve Zırh Puanına sahiptir! \\n\\nNormal &8Elytras&r gibi &7Phantom Membranes&r ile onarılamazlar... ancak Efsunlar onları hala onarabilir! \\n\\nBir tane Üretmek için bir &8Elytra&r'ya, &3Shattered&r'dan düşen 4 adet &3Sculk Bones&r'a, &3Sculk Snappers&r veya &3Sculk Leeches&r'dan düşen 2 adet &3Soul Dust&r'a ve &3&lStalker&r'dan düşen bir &3Soul Crystal&r'a ihtiyacınız olacak."]
	quest.4A01C5F5DCF32C19.title: "&3Soul Elytra"
	quest.4D57A07592AED307.quest_desc: [
		"&3&lStalker&r, Antik Vazoları kırarak ortaya çıkarılabilen bir Patrondur. \\n\\n200 &4Hearts&r canı vardır ve takip etmek için bir Patron Çubuğu bulunur. &3Soul Crystals&r elde etmek için onu öldürmemiz gerekecek. \\n\\nÇok hızlıdır ve size Vurursa tonlarca Hasar verir. Neyse ki &9&lWarden&r gibi Kör. Ancak aynı zamanda yakındaki her şeyi duymasını sağlayan inanılmaz bir duyma yeteneğine sahiptir. \\n\\nBirkaç saldırısı vardır, normalde size sadece Vuracaktır. Bazen bir AOE saldırısına neden olabilir ve size saldırmaları için &3Sculk Leeches&r çağırabilir! \\n\\nAyrıca &3Sculk&r olmayan her Mob'a saldıracaktır."
		"{image:atm:textures/questpics/deepndark/dnd_stalker.png width:100 height:200 align:center}"
	]
	quest.4D57A07592AED307.title: "&3&lStalker"
	quest.56D41A4605C42EB5.quest_desc: ["&6Crystallized Amber&r, &cOvercast Columns&r içinde ortaya çıkar. \\n\\nOnları yakalamak için Silk Touch'a ihtiyacınız olacak. \\n\\nFazla bir şey yapmazlar, ama güzel görünürler!"]
	quest.56D41A4605C42EB5.title: "&6Crystallized Amber"
	quest.5866438E5D19AB69.quest_desc: [
		"&3Sculk Leeches&r bazen kırık Antik Vazolardan ortaya çıkabilir. \\n\\n2 tane ortaya çıktığında sizin için küçük bir sürpriz gibi olur! \\n\\nSadece 2 &4Hearts&r canları vardır ve buna rağmen size saldırırlar. \\n\\nÖldüklerinde &3Soul Dust&r düşürürler."
		"{image:atm:textures/questpics/deepndark/dnd_leech.png width:100 height:100 align:center}"
	]
	quest.5866438E5D19AB69.title: "&3Sculk Leech"
	quest.59AF80E8EE17C769.quest_desc: [
		"&5Echoing Forest&r biraz sadedir ama aynı zamanda &5Echoing Trees&r'i de barındırır! \\n\\n&5Echoing Trees&r normal Ağaçlar gibi davranır, Üretim için &aLogs&r kısımlarını Kazabilir ve &5Leaves&r kısımları Fidanlar düşürecektir. Leaves içinde ayrıca Sculk Gleam de bulabilirsiniz. \\n\\nEtrafında, yüzeyin her yerinde &5Echoing Soil&r bulacaksınız. Bunlar maalesef Tarla veya Dirt yapılamazlar, onlar sadece Bloklardır."
		"{image:atm:textures/questpics/deepndark/dnd_forest.png width:200 height:100 align:center}"
	]
	quest.59AF80E8EE17C769.title: "&5Echoing Forest"
	quest.5C983A41886A2B75.quest_desc: ["&2&lOverworld&r'e geri dönmek için geldiğimiz yoldan çıkabiliriz! \\n\\n&8Reinforced Deepslate&r Çerçevesi üzerinde &9Heart of the Deep&r'i kullanın. \\n\\nNeyse ki &6Ancient Temple&r'ın dibinde bunlardan bir tane elde edebiliyoruz."]
	quest.5C983A41886A2B75.title: "Evim Güzel Evim!"
	quest.5CCF573B67317591.quest_desc: ["&bGlowing Roots&r, &bBlooming Caverns&r içinde ortaya çıkar. \\n\\nTırmanılamazlar ve Yemek düşürmezler... Sanırım sadece dekorasyon amaçlılar."]
	quest.5CCF573B67317591.title: "&bGlowing Roots"
	quest.5E287410EE969244.quest_desc: [
		"&9Shattered&r, &3&lOtherside&r'da epeyce Biyomda ortaya çıkar. \\n\\nMini &9&lWardens&r gibi davranırlar, kördürler ve Düşmanları bulmak için &3Sculk&r'a güvenirler. Ayrıca &3Sculk&r olmayan tüm Mob'lara saldırırlar. \\n\\n&9Shattereds&r 50 &4Hearts&r cana sahiptir ve oldukça sert vururlar! Bu yüzden çok fazla dikkat çekmemeye özen gösterin. \\n\\nEğer onları öldürebilirseniz, &9Sculk Bones&r düşüreceklerdir. Bunlar birkaç Tarif için gerekli olacaktır."
		"{image:atm:textures/questpics/deepndark/dnd_shattered.png width:100 height:150 align:center}"
	]
	quest.5E287410EE969244.title: "&9Shattered"
	quest.60721C9B94B36C24.quest_desc: [
		"&3Sculk Centipedes&r, &3&lOtherside&r'da ortaya çıkan uzun nötr Mob'lardır. \\n\\n10 &4Hearts&r canları vardır ve Vurulduklarında Wolves gibi grup halinde saldırırlar. \\n\\nSadece &aXP&r ve belki de String düşürürler, bu yüzden onları rahat bırakmak en iyisidir!"
		"{image:atm:textures/questpics/deepndark/dnd_centipede.png width:100 height:100 align:center}"
	]
	quest.60721C9B94B36C24.title: "&3Sculk Centipede"
	quest.67D38E8A57949B34.quest_desc: ["&3Sculk Jaws&r, &9Deeplands&r içinde bulabileceğimiz Bloklardır. \\n\\nYanlışlıkla üzerlerinden geçtiğinizde sizi ısırırlar, bu da sizi aşağı çeker ve onlara sıkıştığınızda Hasar verir. \\n\\nBunları Silk Touch kullanarak alabilirsiniz."]
	quest.67D38E8A57949B34.title: "&3Sculk Jaw"
	quest.68446510A1B0D9B8.quest_desc: [
		"&bBlooming Caverns&r, normal Mağaralardan çok Lush Caves gibidir. Bunu söylüyorum çünkü BİTKİLER bolca var! \\n\\nTavandan yere kadar büyüyen Bitkiler, yerden tavana kadar büyüyen Bitkiler, &9Water&r içinden büyüyen Bitkiler ve hatta hiç Büyümeyen Bitkiler bulacaksınız! \\n\\nZemin &bBlooming Sculk Stone&r ve hatta &bBlooming Moss&r ile kaplıdır. \\n\\nBurada Water Ponds bile var, bu &3&lDimension&r'da &9Water&r bulabileceğiniz tek yer."
		"{image:atm:textures/questpics/deepndark/dnd_cave.png width:200 height:100 align:center}"
	]
	quest.68446510A1B0D9B8.title: "&bBlooming Caverns"
	quest.6BB948F44B0950E8.quest_desc: ["&3Sculk Stone&r, &cOvercast Columns&r hariç hemen hemen her yerde ortaya çıkar. \\n\\nNeredeyse her yönden normal &7Stone&r gibi çalışır. Cobbled versiyonlarını eriterek birçok başka Yapı Taşına dönüştürülebilen &3Sculk Stone&r elde edebilirsiniz. \\n\\nMaalesef Stone Tools yapmak için kullanılamaz... bekle, neden umurunda ki sen &9&lWarden&r'ı öldürdün! Neden Stone Tools'a ihtiyacın var ki?!?!?"]
	quest.6BB948F44B0950E8.title: "&3Sculk Stone"
	quest.6E38CF6E7360E9CA.quest_desc: ["&9&lWarden&r oldukça fazla Eşya düşürecektir ancak &9Heart of the Deep&r en önemlisidir. \\n\\n&3&lOtherside&r'a giden Portalımızı elde etmek için &8Reinforced Deepslate&r çerçevesi üzerinde &9Heart of the Deep&r'i kullanabiliriz. Portal Çerçevesini engelleyen hiçbir Blok olamaz yoksa çalışmaz. \\n\\nAyrıca &9Warden Carapace&r ve &9Echo Shards&r düşürür, her ikisi de diğer Eşyaları Üretmek için faydalı olacaktır!"]
	quest.6E38CF6E7360E9CA.title: "&9Heart of the Deep"
	quest.6E901EF1CB411088.quest_desc: ["&9Warden Armor&r, &cNetherite&r'ın doğrudan bir yükseltmesidir. Yapmak için sadece bir &9Warden Upgrade Template&r, bir &9Reinforced Echo Shard&r ve bir parça &cNetherite Armor&r kullanın. \\n\\nHer parça, &cNetherite&r muadiline kıyasla 1 Zırh Puanı ve 1 Zırh Koruması daha fazladır. \\n\\nAncak artık Geri İtme Direnci yok. \\n\\nEn azından &cNetherite&r'dan çok daha havalı görünüyorlar! &9Helmet&r, &9&lWarden&r gibi dev boynuzlara sahiptir ve &9Chestplate&r üzerinde bir kalp izi vardır."]
	quest.6E901EF1CB411088.title: "&9Warden&r Armor"
	quest.716FF64ACF896D50.quest_desc: ["&cGloomslate&r, &cOvercast Columns&r içindeki &3Sculk Stone&r'un yerini alır. \\n\\nTıpkı &3Sculk Stone&r gibi çalışır, sadece daha Kahverengidir."]
	quest.716FF64ACF896D50.title: "&cGloomslate"
	quest.726A627BD7654E0C.quest_desc: ["Bu Araçlar için &cNetherite&r'dan &9Warden&r'a fazla bir değişiklik yok. \\n\\nKazma aynı Aşama ve aynı Hızdadır. Kürekler hala Yollar yapabilir ve yine aynı Hızdadır. Çapalar hala Tarla yapabilir ve yine aynı Hızdadır. \\n\\nTek gerçek değişiklik, hepsinin Saldırı Hasarının daha yüksek olmasıdır. \\n\\nİlginçtir ki bu, &9Warden Hoes&r'in tüm &2&lVanilla&r Hoes'ten daha yüksek Hasara sahip olduğu anlamına gelir!"]
	quest.726A627BD7654E0C.title: "&9Warden&r Tools"
	quest.72EC845C19645AFC.quest_desc: ["&3Sculk Vines&r, &4Weeping Vines&r'in &3Sculk&r versiyonudur. \\n\\n&bBlooming Caverns&r ve &9Deeplands&r içinde ortaya çıkabilirler."]
	quest.72EC845C19645AFC.title: "&3Sculk Vines"
	quest.736F4A43EEBDD7B3.quest_desc: [
		"&3Sculk Snappers&r küçük ama öfkeli Mob'lardır! \\n\\nOnların &9Deeplands&r ve &cBlooming Caverns&r'da ortaya çıktıklarını gördüm. \\n\\n6 &4Hearts&r canları vardır ve Öldüklerinde &3Soul Dust&r düşürürler."
		"{image:atm:textures/questpics/deepndark/dnd_snapper.png width:100 height:100 align:center}"
	]
	quest.736F4A43EEBDD7B3.title: "&3Sculk Snapper"
	quest.76F14C2B866B4EAD.quest_desc: ["&3&lOtherside&r, &9&lWarden&r dahil olmak üzere &3Sculk&r ve &3Sculk creatures&r'ların doğum yeridir. \\n\\nBurada onun birçok uzak kuzenini bulacaksınız, ancak endişelenmeyin &3&lOtherside&r'ın birkaç artısı da var! \\n\\nBulabileceğimiz pek çok yeni Yapı Taşı ve Eşya var ve tonlarca &aXP&r için her yerde &3Sculk&r var! \\n\\nÖyleyse Çapanızı hazırlayın ve &3&lOtherside&r'a doğru maceraya atılın!"]
	quest.76F14C2B866B4EAD.quest_subtitle: "Merhaba şuradan..."
	quest.76F14C2B866B4EAD.title: "&3&lOtherside"
	quest.774D61FEFABEFD9A.quest_desc: [
		"Shriek Worms, &9Deeplands&r içindeki &3Infested Sculk&r üzerine basılmasıyla ortaya çıkar. \\n\\n100 &4Hearts&r cana sahip Mini patronlardır. \\n\\nÇok yaklaşırsanız sizi ısırırlar ve tonlarca Hasara neden olurlar! Ancak çok uzağa giderseniz tekrar yeraltına geri çekilirler. \\n\\nBiraz &aXP&r dışında hiçbir şey düşürmezler, bence buna uğraşmaya değmez."
		"{image:atm:textures/questpics/deepndark/dnd_worm.png width:100 height:200 align:center}"
	]
	quest.774D61FEFABEFD9A.title: "Shriek Worm"
	quest.78BCED8699ADEDF4.quest_desc: ["&3Soundproof Glass&r, &3Soul Dust&r ve Glass birleştirilerek yapılır. \\n\\nBunlar tıpkı Wool gibi Sesi sönümlemede işe yarar! Eğer bir &3Sculk Sensor&r veya &3Shrieker&r'ın üzerini bunlardan biri kaplarsa, Sesleri duyamazlar. \\n\\nSadece bunların içini görebilirsiniz!"]
	quest.78BCED8699ADEDF4.title: "&3Soundproof Glass"
	quest.7CBAA67204CC258C.quest_desc: ["Hayır, &9&lWarden&r Kılıçlar ve Baltalar kullanmaz. Ancak biz kullanabiliriz! \\n\\nHem &9Warden Sword&r hem de &9Axe&r, &9Reinforced Echo Shard&r ve &9Warden Upgrade Template&r ile &cNetherite versiyonlarının&r yükseltmeleridir. \\n\\nHer biri 1 &4Heart&r daha fazla Hasara ve hatta daha fazla Dayanıklılığa sahiptir! \\n\\nEvet, Axe hala verimli bir şekilde Ağaçları kesebilir."]
	quest.7CBAA67204CC258C.title: "&9Warden&r Weapons"
	quest.7FF3EA602FE7A546.quest_desc: ["&3Sculk Transmitter&r, &6Ancient Temple&r'ın Sandıklarında bulabileceğimiz çok nadir bir Eşyadır. \\n\\nBir kez bulduğunuzda, en iyi arkadaşınız olacak! \\n\\nKullanmak için, bir Arayüzü olan bir Bloğa sadece Shift Sağ Tıklayın, şunları düşünün: Chests, Crafting Tables ve Furnaces. Ardından &3Transmitter&r o Eşyaya bağlanacaktır. \\n\\nOndan sonra, o Bloğa uzaktan erişmek için &3Transmitter&r'ı kullanabiliriz! \\n\\nBloğun bağını koparmak için, &3Transmitter&r ile Havaya Shift Sağ Tıklayın."]
	quest.7FF3EA602FE7A546.title: "&3Sculk Transmitter"
	task.5B7FD7C2F05FA64D.title: "AllRightsReserved"
}
