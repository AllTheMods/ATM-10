	quest.5E71F8A046C60346.quest_desc: ["Size PneumaticCraft'ın güç üretmekle ilgili olmadığını kim söyledi?\n\n&3Pneumatic Dynamo&r, basıncınızı FE'ye dönüştürmenize olanak tanır. Nasıl çalıştığını öğrenmek için araç ipucunu okuyun veya PNC:R rehberinde hakkında bir şeyler okuyun."]
	quest.5E71F8A046C60346.quest_subtitle: "Basınç = Güç"
	quest.5E71F8A046C60346.title: "Güç Üretmek"
	quest.602C3E88D96F8843.quest_desc: ["Şarj Edilmiş bir Boş PCB'yi Etching Tank içine biraz Etching Acid ve biraz ısı ile koyduğunuzda bir &3Unassembled PCB&r elde edersiniz."]
	quest.602C3E88D96F8843.quest_subtitle: "Neredeyse bitti!"
