{
	chapter.5E31DF282998B992.title: "PneumaticCraft"
	chapter_group.2B51AC12041E3F89.title: "Teknoloji"
	quest.00075A5F9AC120ED.quest_desc: ["Bu işlem, eşyaları girdi sandığınızdan alacaktır."]
	quest.00075A5F9AC120ED.quest_subtitle: "Her Zaman Gerekli"
	quest.002163B909070CF8.quest_desc: [
				"Belirli bloklar/sıvılar hakkındaki ayrıntıları duvarların arkasından bile görmenizi sağlar.\\n"
				"{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
			]
	quest.002163B909070CF8.quest_subtitle: "Maks: 1"
	quest.00D7BCC68D971A53.quest_desc: ["Yakındaki canlı yaratıklar, duvarların arkasında olsalar bile otomatik olarak izlenecektir. Eğer saldırgan bir canlıysa, sizi hedef aldığında bir uyarı alırsınız."]
	quest.00D7BCC68D971A53.quest_subtitle: "Maks: 1"
	quest.02643BAD1AE747C6.quest_desc: ["&3Advanced Liquid Kompresör&r, Liquid Kompresör ile aynı şekilde çalışır, ancak çok daha iyidir!"]
	quest.04BE9F63E6003475.quest_desc: ["&3LPG&r, Molten Plastik yapmak için kullanılabilir."]
	quest.04BE9F63E6003475.quest_subtitle: "İhtiyacımız olan şey"
	quest.04BE9F63E6003475.title: "LPG"
	quest.0672462DA3599484.quest_subtitle: "512,000mb"
	quest.09BA45CBBFB4AE26.quest_desc: ["Bu modun bir sonraki aşaması, &3Assembly Line&r (Montaj Hattı) kurmanızı gerektirir. Bir &3Assembly Line&r'ın ana bileşeni &3Assembly Controller&r'dır.\n\nBasınç buraya gidecektir."]
	quest.09BA45CBBFB4AE26.quest_subtitle: "Her Zaman Gerekli"
	quest.0A912B2E2BE34920.quest_desc: [
				"Yüzeyde Ham Petrol bulabilseniz de, sondaj yapmak bir ton petrol elde etmenin harika bir yoludur. Önce altınızda petrol bulana kadar bir &3Seismic Sensor&r kullanın, ardından petrol çıkarmak için sondaj borularıyla dolu &3Gas Lift&r'inizi kullanın. (Bunun çalışması için basınca ihtiyaç vardır).\n"
				"{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
			]
	quest.0A912B2E2BE34920.quest_subtitle: "Petrol Sondajı"
	quest.0AEAEA976ED0C470.quest_desc: ["&3Şarj İstasyonu&r, &aPneumaticCraft&r modundaki çeşitli aletleri ve cihazları basınç kullanarak şarj etmek için kullanılır."]
	quest.0AEAEA976ED0C470.quest_subtitle: "Kablosu nerede?"
	quest.0CC48C2AA553A314.quest_desc: ["&3Matkap Bit&r'ler bir Pneumatic Jackhammer'da kullanılabilir."]
	quest.0D2F5CC96269F9E3.quest_desc: ["PCB yapımının bir sonraki adımı, Etching Acid ile &3Etching Tank&r kullanmayı içerir. Çalışması için ısı gerektirir."]
	quest.0D2F5CC96269F9E3.quest_subtitle: "Aşındırma Zamanı!"
	quest.0D31CD79BE6CC8D2.quest_desc: ["Neden normal Ekmek Maya gerektirmez?"]
	quest.0D31CD79BE6CC8D2.quest_subtitle: "Sorunlarının Mayası"
	quest.0D31CD79BE6CC8D2.title: "Ydoğu"
	quest.0D5015B8FF482D0A.quest_desc: [
				"Gelişime devam edebilmek için &3Amadron Tablet&r'i kullanarak &3Amadron&r'dan bir şeyler sipariş etmemiz gerekecek. Kullanmak için, bir Sandık ve bir Sıvı tankına shift ile sağ tıklayın, para biriminizi (Zümrüt vb.) bağlı bir kaba koyun ve bir şey sipariş edin. Paranızı almak için bir Amadrone'un aşağı indiğini ve sipariş ettiğiniz şeyi bırakmak için başka bir Amadrone'un geldiğini göreceksiniz."
				""
				"{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
			]
	quest.0D5015B8FF482D0A.quest_subtitle: "Acaba 1 günde teslimatları var mı?"
	quest.0D5015B8FF482D0A.title: "Amadron"
	quest.0D50BDEFA0319EA1.quest_desc: ["Bu, bitmiş ürünü çıktı sandığınıza bırakacaktır."]
	quest.0D50BDEFA0319EA1.quest_subtitle: "Her Zaman Gerekli"
	quest.0D9560C8E247F9E7.quest_desc: ["Bir yere sağ tıkladığınızda geri dönüş yolunuzu bulabileceksiniz. Yeterince yakınsanız ve doğrudan bir rotanız varsa, bir yol belirecektir."]
	quest.0D9560C8E247F9E7.quest_subtitle: "Maks: 1"
	quest.0E65BE9460B74000.quest_desc: [
				"Lojistik Çerçevelerin çalışabilmesi için bir &3Logistics Module&r'e bağlanması gerekir."
				""
				"{image:pneumaticcraft:textures/patchouli/logistics_module.png width:100 height:100 align:left fit:true}"
			]
	quest.0F49E9167B5E97C9.quest_desc: ["Düşerken aldığınız her hasar (zırhı görmezden gelerek) yakındaki yaratıklara da verilecektir."]
	quest.0F49E9167B5E97C9.quest_subtitle: "Maks: 1"
	quest.0FF050EC1EA6EAED.quest_desc: ["&3Liquid Hopper&r bir Huni gibidir, ancak sıvılar içindir. Boruların yerini tutmaz."]
	quest.0FF050EC1EA6EAED.quest_subtitle: "Borulara kimin ihtiyacı var ki?"
	quest.122EDEC12C9A05D2.quest_desc: ["Her şeyin patlayabileceğinden bahsetmeyi unuttum mu?...\\n\\nNeyse ki kolay bir çözüm var! &3Security Upgrade&r, bir makineye yerleştirildiğinde patlamamasını sağlar; bunları girebilecekleri tüm makinelere koyun."]
	quest.122EDEC12C9A05D2.quest_subtitle: "Keşke kolay bir Çözüm olsaydı..."
	quest.122EDEC12C9A05D2.title: "Patlamaları Önlemek mi?"
	quest.132DF9ECEFFB3B71.quest_desc: ["&3Module Expansion Card&r, Şarj Ediliyor Module'ü çok daha iyi hale getirir."]
	quest.13F68CA518CD287C.quest_desc: ["&3Dizel&r, daha fazla Kerosene yapmak veya Yağlayıcı yapmak için kullanılabilir."]
	quest.13F68CA518CD287C.quest_subtitle: "Zavallı Sel"
	quest.13F68CA518CD287C.title: "Dizel"
	quest.1427B3AB09510D20.quest_desc: ["Kendinize bir &3Bitti PCB&r elde etmek için Unassembled PCB'nizi 2 Kapasitör ve 2 Transistör ile birlikte üretin."]
	quest.1427B3AB09510D20.quest_subtitle: "Başardınız!"
	quest.142C67218BD16867.quest_desc: ["Minigun'ınızı kullanmak için bu &3Minigun Ammo&r ile doldurun."]
	quest.15007DCAF701B361.quest_desc: ["Envanterinizdeki basınca dayanıklı diğer eşyaları göğüslüğün deposundan şarj eder."]
	quest.15007DCAF701B361.quest_subtitle: "Maks: 6"
	quest.15D355EB164EBE68.quest_subtitle: "Bitti PCB'ler için Gerekli"
	quest.15D355EB164EBE68.title: "Kapasitör'lar"
	quest.187816477B732517.quest_desc: ["&3Transfer Cihazı&r, blokların arasına yerleştirilebilen bir Huni gibi çalışır."]
	quest.187816477B732517.quest_subtitle: "Daha Küçük Huni"
	quest.21624A6500545C42.quest_desc: [
				"Ekinlerinizi daha hızlı büyütmek için üzerlerine &3Crop Support&r'lar yerleştirilebilir."
				""
				"{image:atm:textures/questpics/pneumaticcraft/crop_support.png width:200 height:100 align:center}"
			]
	quest.21624A6500545C42.quest_subtitle: "Daha Hızlı Ekinler"
	quest.22572456571C3F8D.quest_desc: ["&3Şarj Ediliyor Module&r, yönlendirildiği kaplardaki basınca dayanıklı olan her şeyin basıncını boşaltır."]
	quest.230463E830D6FFEB.quest_desc: ["Artık plastiğimiz olduğuna göre bir sonraki adım bazı Bitti PCB'ler elde etmektir, önce Pressure Chamber'da birkaç &3Boş PCB&r yapın."]
	quest.230463E830D6FFEB.quest_subtitle: "PCB'lere giden yol"
	quest.2338E5269CA23C91.quest_desc: ["&3Netherit Matkap Bit&r en iyi matkap ucudur, Elmas Matkap Bit'ten bile daha iyidir."]
	quest.2338E5269CA23C91.quest_subtitle: "En İyi Uç Budur"
	quest.23737103592776C2.quest_desc: ["&3Kerosene Lamp&r, ışık üretmek için yakıt kullanan harika bir ışık kaynağıdır."]
	quest.23737103592776C2.quest_subtitle: "Mega Torch'lar da neymiş!"
	quest.24042326B4632DD4.quest_desc: ["Lojistiğe başlamak için bir &3Logistics Core&r üretin, bu eşyaların nasıl kullanılacağına dair tam bir eğitim için PNC:R Kılavuzunu okumanızı tavsiye ederim."]
	quest.24042326B4632DD4.quest_subtitle: "Eşyaları/Sıvıları Taşımak"
	quest.24042326B4632DD4.title: "Logistics"
	quest.26BEA64C80ECE1A6.quest_desc: ["Her bir &3Logistic Çerçeve&r farklı türde otomasyonlar için kullanılabilir."]
	quest.2745297337E13E9E.quest_desc: ["&3Advanced Air Kompresör&r, Air Kompresör ile aynı şekilde çalışır, ancak çok daha iyidir!"]
	quest.2745297337E13E9E.quest_subtitle: "Artık o sıkıcı eski Air Kompresör'lara gerek yok!"
	quest.2801B7B6BF61E978.quest_desc: ["&3Kerosene&r, Gasoline yapmak için veya Kerosene Lamp'de yakıt olarak kullanılabilir."]
	quest.2801B7B6BF61E978.quest_subtitle: "Bunu Kero-gördün mü?"
	quest.2801B7B6BF61E978.title: "Kerosene"
	quest.2AED15E3AC0346FE.quest_desc: [
				"Aşağıda bu modun başlarında kullanabileceğiniz bazı &3Upgrade&r'ler bulunmaktadır. Bir &3Upgrade&r'in neyde kullanılabileceğini görmek için üzerine gelirken Shift tuşuna basın veya nelerin o yükseltmeyi kullanabileceğini görmek için bir şeyin üzerine gelirken Shift tuşuna basın.\n"
				""
				"Not: Alt yazı size o &3Upgrade&r'in bir şeye konulabilecek maksimum miktarını söyleyecektir."
			]
	quest.2AED15E3AC0346FE.quest_subtitle: "Çok kullanışlı şeyler"
	quest.2AED15E3AC0346FE.title: "Basit Yükseltmeler"
	quest.2C5D78630C7AD57F.quest_desc: ["Menzili artırır, farklı şeylerde kullanıldığında farklı işler yapar."]
	quest.2C5D78630C7AD57F.quest_subtitle: "Yaklaş Bana!"
	quest.2CC56A4F06E53307.quest_desc: [
				"Boş PCB'lerinizi şarj etmek için bir &3UV Light Box&r içine yerleştirin. Basınç ve güneş ışığına erişim gerektirir."
				"{image:atm:textures/questpics/pneumaticcraft/uv_charging.png width:300 height:150 align:center}"
			]
	quest.2CC56A4F06E53307.quest_subtitle: "Umarım biraz Güneş Gözlüğünüz vardır!"
	quest.2CC56A4F06E53307.title: "UV ile Şarj Etmek"
	quest.2DE7CC686B56881F.quest_desc: ["Sizi Mekanism radyasyonundan korur."]
	quest.2DE7CC686B56881F.quest_subtitle: "Maks: 1"
	quest.2E8F851A4E98F741.quest_desc: [
				"&3Pneumatic Zırh&r (Pnömatik Zırh) tek başına oldukça harikadır, ancak bu zırhı mükemmel hale getirmek istiyorsanız yükseltmeler yüklemeniz gerekecektir. Yükseltme Arayüzünü açmak için varsayılan olarak 'U' tuşuna basın, bazı yükseltmeler basınç kullanır, bazıları kullanmaz."
				""
				"PneumaticCraft'taki diğer aletleri yükselttiğiniz gibi, &3Pneumatic Zırh&r'ı yükseltmek için de basınçlı bir Şarj İstasyonu'a ihtiyacınız olacaktır."
				""
				"Not: Alt yazı size o yükseltmenin bir şeye konulabilecek maksimum miktarını söyleyecektir."
			]
	quest.2E8F851A4E98F741.quest_subtitle: "Sıkıştırılmış Iron Man"
	quest.2E8F851A4E98F741.title: "Pneumatic Zırh"
	quest.30AD7B15682E4D0E.quest_desc: ["İçindeki metin her zaman sığacak şekilde ölçeklenen ve dilediğiniz miktarda metni depolayıp görüntüleyebilen akıllı bir Tabela.\n\nTabelayı yeniden renklendirmek için herhangi bir Boya ile sağ tıklayın; kenarlığı ve arka planı bağımsız olarak renklendirebilirsiniz."]
	quest.30AD7B15682E4D0E.quest_subtitle: "Tabelalar? Hiç duymadım!"
	quest.312331F6DB0CE5F4.quest_desc: ["Aşama I'den daha hızlı gider."]
	quest.312331F6DB0CE5F4.quest_subtitle: "Maks: 1"
	quest.31BCE63F5E016323.quest_desc: ["&3Solar Kompresör&r güneş ışığı kullanarak Basınç üretir, ne kadar ısınırsa o kadar fazla Basınç üretecektir.\\n\\nAncak dikkatli olun, çok ısınırsa arızalanır ve onu onarmanız gerekir."]
	quest.31BCE63F5E016323.quest_subtitle: "Avucumun içinde..."
	quest.31BCE63F5E016323.title: "Güneşten Gelen Basınç"
	quest.325483DEB0C602F8.quest_desc: ["Bu Görev, AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r'nin açık izni olmadan yayınlanmayan hiçbir halka açık pakette kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.32C3E14578D48E6C.quest_desc: ["Tıpkı normal &3Pressure Tube&r'ler gibidir, ancak bunlar 10 bar basınç tutabilir."]
	quest.32C3E14578D48E6C.quest_subtitle: "Yükseltilmiş Pressure Tube'lar"
	quest.3334D15766A47A46.quest_desc: ["Bir Laser Assembly Program kullanarak &3Unassembled PCB&r'lerin üretimini hızlandırabilirsiniz. Girdi sandığına sadece bir Boş PCB koyun, biraz basınç pompalayın ve bekleyin."]
	quest.3334D15766A47A46.title: "PCB'leri Otomatikleştirmek"
	quest.36D72D759C4E8823.quest_desc: ["Belki de biraz fazla hızlıdır."]
	quest.36D72D759C4E8823.quest_subtitle: "Maks: 1"
	quest.371A34B297C8A8EF.quest_desc: ["PneumaticCraft tamamen Basınç ile ilgilidir! Bu görevler modun sahip olduğu her şeyin üzerinden geçmeyecektir, ancak yine de birçoğunu ele alacaktır! Lütfen JEI'yi kontrol etmeyi, araç ipuçlarını okumayı ve PCB:R rehberini okumayı unutmayın, hepsi çok kullanışlıdır.\n\nBaşlamak için birkaç &3Compressed Iron Ingot&r üretmeniz gerekecek! Bunu yapmanın en kolay yolu yerde bir çukur açmak, içine birkaç demir külçe (veya blok) atmak ve sonra onu biraz TNT ile havaya uçurmaktır!\n\nBazıları patlamada kaybolabilir, ancak almamız gereken bir risk bu!"]
	quest.371A34B297C8A8EF.quest_subtitle: "Havanın Gücü"
	quest.371A34B297C8A8EF.title: "PneumaticCraft: Repressurized"
	quest.39F142224D5210A9.quest_desc: ["&3Biodeisel&r, &3Yağlayıcı&r ve &3Molten Plastik&r yapmak için kullanılabilir."]
	quest.39F142224D5210A9.quest_subtitle: "Bio/Dizel"
	quest.39F142224D5210A9.title: "Biodeisel"
	quest.3A9AC6AB4407DC32.quest_desc: ["Her tarif aynı bileşenleri gerektirmese de, &3Assembly Line&r'ınızı her şey yüklü olacak şekilde kurabilirsiniz. Her şey için kullanılabilecek basit bir &3Assembly Line&r kurulumu aşağıdaki görselde gösterilmiştir. Her bileşen hakkında bazı önemli bilgiler edinmek için onların görevlerini okuyun.\n\nHız Upgrade'ler bunu çok daha hızlandırır!"]
	quest.3A9AC6AB4407DC32.quest_subtitle: "Biraz Montaj Gerekli"
	quest.3A9AC6AB4407DC32.title: "Assembly Line'ları Kullanmak"
	quest.3CFE522A4B7CC2EC.quest_desc: [
				"&3Reinforced Chest&r, 36 yuvalı patlamaya dayanıklı bir Sandıktır. Çifte Sandık yapılamaz. Ayrıca bir Shulker Kutusu gibi çalışır."
				"{image:atm:textures/questpics/pneumaticcraft/reinforced_chest_ui.png width:200 height:100 align:center}"
			]
	quest.3CFE522A4B7CC2EC.quest_subtitle: "Günlük Sandığınızdan Daha İyi"
	quest.3D819550074CA376.quest_desc: ["Eşyanın tekrar alınmadan önce buraya yerleştirilmesi gerekecektir."]
	quest.3D819550074CA376.quest_subtitle: "Her Zaman Gerekli"
	quest.3E16CF590C911129.quest_desc: ["&3Air Kompresör&r basınç oluşturmanın kolay bir yoludur, içine sadece yanıcı eşyalar koyun ve sihri izleyin! (Başlamak için bunlardan en az 3 tane yapmanızı öneririm)."]
	quest.3E16CF590C911129.quest_subtitle: "Basıncı Hissetmek"
	quest.3E16CF590C911129.title: "Basınç Üretmek"
	quest.3F9CCCFEF4E84166.quest_desc: ["Isı üretiminizi artırmak için Vortex Tube'un soğuk tarafına bir &3Heat Sink&r yerleştirin."]
	quest.3F9CCCFEF4E84166.quest_subtitle: "Daha Fazla Isı"
	quest.3F9CCCFEF4E84166.title: "Daha İyi Isı Üretimi"
	quest.40924F0D64253A38.quest_desc: ["Eşyaların, eşya fırlatabilmesini (dispense) sağlar."]
	quest.40924F0D64253A38.quest_subtitle: "Gitti!"
	quest.40F634AC38F42B88.quest_desc: ["Basıncı taşımak için &3Pressure Tube&r'ler elde etmeniz gerekecektir. Ne basıncı diye soruyor olabilirsiniz? Bunların ne için kullanıldığını görmek için görev serisine devam edin."]
	quest.40F634AC38F42B88.quest_subtitle: "Ne Basıncı?"
	quest.40F634AC38F42B88.title: "Basıncı Taşımak"
	quest.423B8DA485C1308C.quest_desc: ["&3Gasoline&r, LPG yapmak için kullanılabilir."]
	quest.423B8DA485C1308C.quest_subtitle: "Gaz, gaz, gaz"
	quest.423B8DA485C1308C.title: "Gasoline"
	quest.42951D14ADCD9332.quest_desc: ["Bunu biraz Bezelye Ezmesi ve yanında Fasulyeli Tost ile alabilir miyim, Lütfen Vali?"]
	quest.42951D14ADCD9332.quest_subtitle: "Fish \\& Chips ister misin?"
	quest.42951D14ADCD9332.title: "Fish \\& Chips!"
	quest.43CDC28DC56BB3E2.quest_subtitle: "128,000mb"
	quest.43EF5513A1C52A37.quest_desc: ["&3Thermopneumatic İşleme Plant&r, Molten Plastik yapmak için kullanılacaktır, içine sadece biraz LPG, Kömür ve ısı pompalayın."]
	quest.43EF5513A1C52A37.quest_subtitle: "Adı ne kadar uzunsa o kadar iyi"
	quest.43EF5513A1C52A37.title: "Thermopneumatic İşleme"
	quest.440B1E1D4951F808.quest_desc: [
				"&3Smart Chest&r 72 yuvalı, patlamaya dayanıklı bir Sandıktır, yerleşik, tamamen yapılandırılabilir bir Omnidirectional Hopper içerir ve yükseltme yuvalarına sahiptir. Çifte Sandık yapılamaz. Ayrıca bir Shulker Kutusu gibi çalışır."
				"{image:atm:textures/questpics/pneumaticcraft/smart_chest_ui.png width:200 height:100 align:center}"
			]
	quest.440B1E1D4951F808.quest_subtitle: "Sandıkların İneği"
	quest.456B9DD108CF340F.quest_desc: ["İşleri hızlandırır."]
	quest.456B9DD108CF340F.quest_subtitle: "Hızlı!"
	quest.461C8F1E88AA58D9.quest_desc: [
				"Bunlar, PneumaticCraft sıvılarının kovalı sürümünü kullanan tariflerde kullanılabilir.\n\nBir &3Sıvı Tankı&r başka bir &3Sıvı Tankı&r üzerine konulduğunda ve İngiliz anahtarıyla birleştirildiklerinde tek bir büyük tank haline gelirler.\n"
				"{image:pneumaticcraft:textures/patchouli/small_tanks.png width:250 height:250 align:center fit:true}"
			]
	quest.461C8F1E88AA58D9.quest_subtitle: "32,000mb"
	quest.46BE62C20C720D10.quest_desc: ["Oyulmuş Balkabağı gibi Enderman'lerin size sinirlenmesini engeller."]
	quest.46BE62C20C720D10.quest_subtitle: "Maks: 1"
	quest.482E558BCFEE6B7E.quest_desc: ["&3Yapı Brick&r'ler havalı yapı bloklarıdır, dikkatli olun can acıtırlar. Pürüzsüz hale getirmek için onları tekrar üretin."]
	quest.482E558BCFEE6B7E.quest_subtitle: "Bunlara basmaktan daha kötü bir acı yoktur"
	quest.495DCA49B4E80852.quest_desc: ["&3Minigun&r çalışmak için basınç ve cephaneye ihtiyaç duyan bir silahtır. Daha fazla bilgi için araç ipucunu okuyun."]
