	image.6FE86880793C5355.title: "Reinforced Tracks"
	image.706086B28DAAA864.title: "Water Tank"
	image.7BCB60CFEDCEC415.title: "Water Boiler"
	image.7C36A5A3A55CB788.title: "Coke Oven"
	quest.008D186B4E0ED14F.quest_desc: [
		"Steam Oven, buhar gücünden yararlanan özel bir fırın yapısıdır. \\n\\nİçine buhar sağlandığında yerleştirilen tüm eşyaları pişiren bir fırın görevi görür. Cevherleri külçelere dönüştürebilir ve yiyecekleri pişirebilir. \\n\\nSteam Oven bloklarından oluşan 2x2x2 boyutunda bir çoklu yapıdır."
		"{image:atm:textures/questpics/railcraft/rail_oven.png width:100 height:100 align:center}"
	]
	quest.008D186B4E0ED14F.title: "Steam Oven"
	quest.020E6AF37A0421C8.quest_desc: [
		"Water Tank, dışarıda bir varil bulundurmak gibidir. Sadece bu varil çok daha büyüktür. Su toplar ve Steam Locomotive'ler için su depolayabilir. \n\nÜrettiği su miktarı biyoma ve gökyüzünü görüp görmediğine bağlıdır. \n\nOrtası boş olacak şekilde 3x3x3 boyutunda Water Tank bloklarından yapılır."
		"{image:atm:textures/questpics/railcraft/rail_tank.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.title: "Water Tank"
	quest.032B654201E71618.quest_desc: ["Bu &cTrack Kit&r'leri, &7Vagonlarınızda&r varlıkları (yani Mob'ları) kullanmak içindir. \n\n&cEmbarking Kit&r yakındaki Mob'ları toplayıp bir &7Vagona&r bindirir. \n&cDisembarking Kit&r Mob'ları &7Vagonlardan&r indirir. \n&cDumping Kit&r ise &7Vagonlardaki&r mob'ları üzerinde bulunduğu &6rayların&r altına düşürür."]
	quest.032B654201E71618.title: "Varlıkları Taşımak İçin &cTrack Kit&r'ler"
	quest.035C52EF63AD23A7.quest_desc: ["Modun adından (&lRailCraft&r) ve etrafında döndüğü şeyden (&5Trenler&r) anlaşılabileceği gibi, &6Raylar&r oldukça önemlidir. \n\n&2Vanilla&r olanlar bunların çoğu için iş görür ama hadi ama, berbat olduklarını hepimiz biliyoruz. Gelişmiş olanların tarifleri için daha özel eşyalara ihtiyacı olacak! Onları üretin! (Bu eşyaları yapmak makineleri kullanmayı gerektirebilir, bu yüzden görevin o kısmına göz atın!)"]
	quest.035C52EF63AD23A7.title: "&6&lRaylar&r!"
	quest.068294A7C21DE550.quest_desc: ["&cTrack Kit&r'leri, özel &6raylar&r yapmak için &6raylarla&r birlikte tariflerde kullanılır. \n\nBu &6raylar&r, &5Trenleri&r durdurmak, &5Trenleri&r hareket ettirmek ve kızıltaş sinyali yaymak gibi &5Trenlerle&r ilgili her konuda faydalı olacaktır."]
	quest.068294A7C21DE550.title: "&c&lRaylar&r!"
	quest.08457BEED799E600.quest_desc: ["Bu yeni &7Vagonlar&r çoğunlukla &6Ray&r döşemek içindir.\n\n&7Track Layer&r &6Rayları&r yerleştirirken &7Track Remover&r &6Rayları&r söker.\n\n&7Track Relayer&r &6Rayları&r farklı olanlarla değiştirir ve &7Track UnderCutter&r ise &6Rayların&r altındaki blokları değiştirir."]
	quest.08457BEED799E600.title: "&7Vagonlar&r ve &6Raylar&r"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7RailCraft&r, Demiri Çeliğe dönüştürmemiz için çok bloklu bir Blast Furnace ekler! \n\nİnşa etmek için 34 Blast Furnace Brick'e ihtiyacınız olacak. 3 blok genişliğinde, 3 blok uzunluğunda ve 4 blok yüksekliğinde olacaktır. Tam ortadaki iki blok boş olmalıdır. Hepsi birleşip Arayüzüne erişmenize izin verdiğinde tamamlandığını anlayacaksınız. \n\nOraya herhangi bir formda Demir koyarak Çelik ve Granulated Sand elde edebilirsiniz."
		"{image:atm:textures/questpics/railcraft/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.0A43FD0B5C76C1C5.title: "Blast (Steel) Furnace"
	quest.104049993CC62E7F.quest_desc: ["Advanced Item Loader normalinin yaptığı her şeyi yapar ancak &6Rayın&r yakınındaki herhangi bir yerden kullanılabilir. Yanında, üstünde veya diğer tarafındaki yanında. Yönünü değiştirmek için &4Crowbar&r kullanın."]
	quest.104049993CC62E7F.title: "Advanced Item Loader"
	quest.1698565EBB68DC85.quest_desc: [
		"&6Wye Track&r, Spike Maul kullanılarak yapılan ikinci &6raydır&r. İki &6Rayı&r tek bir rayda birleştirir. Bir &6Rayınız&r başka bir rayla kesişiyorsa, &6Wye&r ilk &6Raydaki&r &7Vagonları&r kesişen raya yönlendirir."
		"{image:atm:textures/questpics/railcraft/rail_wye.png width:100 height:100 align:center}"
	]
	quest.1698565EBB68DC85.title: "&6Wye Track&r'ler"
	quest.170118E3C3C072E5.quest_desc: [
		"&6Junction&r, Spike Maul ile yapılan son &6Raydır&r. &6Raylar&r için normal bir kavşak görevi görür. &7Vagonlar&r eskisi gibi aynı yönde gitmeye devam eder ancak artık &6Raylar&r kesişebilir. Üzerinde 2 &7Vagon&r birbirine çarparsa ne mi olur? PATLARLAR!!! Şaka yapıyorum ama &eElectric Locomotive&r'ler patlar."
		"{image:atm:textures/questpics/railcraft/rail_junction.png width:100 height:100 align:center}"
	]
	quest.170118E3C3C072E5.title: "&6Junction Track&r'ler"
	quest.175D943160C10646.quest_desc: [
		"&l&7RailCraft&r çeşitli işlevler için birçok makine sunar; bunların çoğu kaynak üretimiyle ilgilidir."
		""
		"Hepsinin temeli Demir Külçesine dayanır!"
	]
	quest.175D943160C10646.title: "&l&7Makineler"
	quest.17F7964611D893BE.quest_desc: ["Fluid Loader, &3Steam Locomotive&r'lerinizi çalışır durumda tutmaya yardımcı olacaktır. &6Rayların&r birkaç blok üstüne yerleştirilmelidir ve sıvıları hem &5Locomotive&r'e hem de &7Vagonlara&r dolduracaktır."]
	quest.17F7964611D893BE.title: "Fluid Loader"
	quest.184F98BE0F6710E2.quest_desc: ["Bu 2 &cTrack Kit&r'i, &7Vagonlar&r ve Kızıltaş kullanmak içindir.\n\n&cActivator Kit&r üzerinden geçen hangi &7Vagon&r olursa olsun aktif hale getirir. \n&cDetector Kit&r ise üzerinden bir &7Vagon&r her geçtiğinde bir kızıltaş sinyali aktifleştirir. \n\nHer ikisi de normal &6raylar&r için olan &2Vanilla&r muadillerine benzer."]
	quest.184F98BE0F6710E2.title: "Kızıltaş Kullanımı İçin &cTrack Kit&r'ler"
	quest.21693C4DE6531D73.quest_desc: [
		"Crusher tıpkı adının da belirttiği gibidir. Üretim malzemeleri elde etmek için blokları kırabilir; tuğla merdivenden tuğla veya külçelerden toz elde etmek gibi. \n\nÇalışmak için güce ihtiyacı vardır! \n\nBir tane inşa etmek için 3x2x2 boyutunda Crusher bloğu gerekir."
		"{image:atm:textures/questpics/railcraft/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.21693C4DE6531D73.title: "Crusher"
	quest.249E5C6893387E15.quest_desc: ["Bu &cTrack Kit&r'leri &5Locomotive&r'leri ve &7Vagonları&r durdurmak için yapılmıştır. \n\n&cLocking Kit&r &7Vagonları&r durdurur ve yalnızca bir kızıltaş sinyali verildiğinde başlatır. \n&cBuffer Kit&r &6raylarınızın&r sonu içindir, onları durdurur ve başlatmaz. \n&cGated Kit&r ise sadece &6rayla&r bağlantılı bir Çit Kapısı (Fence Gate) yerleştirir."]
	quest.249E5C6893387E15.title: "Vagonları Durdurmak İçin &cTrack Kit&r'ler"
	quest.283AB56F81EF03A5.quest_desc: ["&6Electric Rail&r'lerinize ve &eElectric Locomotive&r'inize güç sağlamak için &eFrame&r'lere ihtiyacınız olacak. &eFrame&r'lerin güçlendirilmesi gerekir ve bağlanan her &eFrame&r'e gücü aktarır."]
	quest.283AB56F81EF03A5.title: "&eFrame'ler"
	quest.2869AB982799CF0C.quest_desc: ["&cOne Way Track Kit&r oldukça basittir. &7Vagonlar&r yalnızca okun baktığı yöne gidebilir."]
	quest.2869AB982799CF0C.title: "Tek Yönlü &cTrack Kit&r"
	quest.2A30595DC6DDBFF7.quest_desc: [
		"&6Electric Track&r'ler &eElectric Locomotive&r'ler için kullanılır. &eFrame&r'ler tarafından güçlendirilmeleri gerekir ve evet, dokunursanız canınızı yakacaktır."
		"{image:atm:textures/questpics/railcraft/rail_electric_rail.png width:150 height:100 align:center}"
	]
	quest.2A30595DC6DDBFF7.title: "&6Electric Track&r'ler"
	quest.2AB0FA084739827A.quest_desc: ["&9Tunnel Bore&r'u gerçekten kullanabilmek için bir &9Tunnel Bore Head&r'e ihtiyacınız olacak. \n\n4 farklı tarzda gelirler ve &9Bore Head&r'e bağlı olarak maden yaparlar. \n\nBüyülenebilir ve dayanıklılığı vardır, bu yüzden onu büyümek isteyeceksiniz!"]
	quest.2AB0FA084739827A.title: "&9Tunnel Bore, Bore Head"
	quest.2D00F85379A4D591.quest_desc: ["Item Loader, RailCraft'taki en temel dağıtıcıdır. &6Rayın&r üzerinde olmalıdır ve aşağıdaki &7Vagonlarınıza&r ne yüklenmesini istediğinize göre yapılandırılabilir."]
	quest.2D00F85379A4D591.title: "Item Loader"
	quest.31094CC16E710040.quest_desc: ["&4Crowbar&r, RailCraft'ın ana aletidir. \n\nBir &5Locomotive&r üzerinde kullanıldığında baktığı yönü değiştirir. \n\nShift tıklaması yapıldığında &5Locomotive&r'leri ve &7Vagonları&r birbirine bağlayabilirsiniz. \n\nSadece &7Vagonlar&r üzerinde kullanıldığında onlara hafif bir itme verir. \n\nVe özel raylarda kullanıldığında modlarını değiştirir. \n\nFarklı &4Crowbar&r'lar sadece farklı görünümler ve hasar verir."]
	quest.31094CC16E710040.quest_subtitle: "\"Ne yani, beni soyacak mısın?\""
	quest.365D4B1DC953D406.quest_desc: ["&7Cart&r Dispenser tıpkı adının belirttiği şeyi yapar. Önündeki &6Raylara&r herhangi bir &7Vagonu&r dağıtabilir. Dağıtmak için bir Kızıltaş sinyaline ihtiyaç duyar."]
	quest.365D4B1DC953D406.title: "&7Cart&r Dispenser"
	quest.38451B61E3FC075B.quest_desc: [
		"Bekleyin, yine Çeliğimiz var, bu aynı zamanda (Kömür) Kokusunu (Coal Coke) da geri aldığımız anlamına mı geliyor? Evet! \n(Kömür) Koku elde etmek için bir Coke Oven'a ihtiyacınız olacak. Bir tane yapmak için 26 Coke Oven Brick'e ihtiyacınız olacak ve ortasında 1 blok boş kalacak şekilde 3x3x3 olarak yerleştireceksiniz. Arayüze erişebildiğinizde ve tek bir doku haline geldiğinde bittiğini anlayacaksınız. \n\n(Kömür) Koku ve Sıvı Kreozot elde etmek için Kömür veya Kömür Blokları yerleştirin! Odun Kömürü (Charcoal) ve Kreozot elde etmek için her zaman herhangi bir kütük de koyabilirsiniz."
		"{image:atm:textures/questpics/railcraft/rail_coke.png width:100 height:100 align:center}"
	]
	quest.38451B61E3FC075B.title: "Coke Oven"
	quest.3E75AFE3482834C5.quest_desc: ["&lRailCraft&r tamamen &5Trenler&r üzerine kurulu bir moddur! \n\n&7Minecart&r'lardan &eElectric Locomotive&r'lere ve &9Tunnel Bore&r'lara kadar! &5Tren&r aksesuarları açısından da her şeye sahiptir! Trafik Işıkları, &5Trenlere&r güç sağlamak için Buhar Kazanları ve tüm meşakkatler için otomasyon. \n\nModel &5Tren&r Severler için örnek bir Mod!"]
	quest.3E75AFE3482834C5.title: "&7&lRailCraft"
	quest.3E8C2E7769DFBF35.quest_desc: [
		"&3Steam Locomotive&r'in aksine, &eElectric Locomotive&r'in içine hiçbir şey koymanıza gerek yoktur. \n\n&6Electric Track&r'lerin altındaki &eFrame&r'lerden gelen güçle çalışır. \n\nEvet, yalnızca &6Electric Track&r'ler üzerinde çalıştırılabilir."
		"{image:atm:textures/questpics/railcraft/rail_electric.png width:100 height:100 align:center}"
	]
	quest.3E8C2E7769DFBF35.title: "&eElectric Locomotive"
	quest.4071BBBE12CACD2D.quest_desc: ["&5Train&r Dispenser, &7Cart&r Dispenser'ın daha iyi bir versiyonudur. Tüm &5Locomotive&r'i ve daha fazlasını dağıtabilir! Dağıtılmasını istediğiniz şey için bir kalıp ayarlayın ve ardından kızıltaş sinyali verin."]
	quest.4071BBBE12CACD2D.title: "Train Dispenser"
	quest.425E375A9EC127EB.quest_desc: [
		"&6Reinforced Track&r'ler normal &6rayların&r yükseltilmiş versiyonudur! Biraz daha hızlıdırlar ve patlamazlar."
		"{@pagebreak}"
		"1"
		"{image:atm:textures/questpics/railcraft/rail_reinforced1.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"2"
		"{image:atm:textures/questpics/railcraft/rail_reinforced2.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"3"
		"{image:atm:textures/questpics/railcraft/rail_reinforced3.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"4"
		"{image:atm:textures/questpics/railcraft/rail_reinforced4.png width:150 height:100 align:center}"
	]
	quest.425E375A9EC127EB.title: "&6Reinforced Track&r'ler"
	quest.475E307844E3AF7F.quest_desc: [
		"Buhar Kazanları (Boiler), &l&7RailCraft&r modunun en temel enerji üreticilerindendir. Yapı; alt kısımda bir Fueled Firebox (Ateş Kutusu) ve üst kısımda kazan bloklarından oluşur. Ateş kutusu 1x1, 2x2 veya 3x3 boyutunda inşa edilebilir. Ateş kutusunun boyutu, üzerine kurulabilecek kazanın maksimum hacmini belirler: 1x1 kutu için 1x1 kazan, 2x2 kutu için 2x2x3 kazan, 3x3 kutu için ise 3x3x4 kazan yapılabilir. Sıvı yakıtlı (Liquid Firebox) modeller kreozot gibi sıvıları kullanırken, katı yakıtlı (Solid Firebox) modeller normal fırın yakıtlarını yakar."
		"{image:atm:textures/questpics/railcraft/rail_big_boiler.png width:100 height:100 align:center}"
	]
	quest.475E307844E3AF7F.title: "Boiler'lar"
	quest.4A44623D8A307473.quest_desc: [
		"&6High Speed Electric Track&r'ler &6Electric Track&r'ler gibidir ama daha hızlıdır! Normal &6High Speed Track&r'lerin gerektirdiği şeyleri ve &6Electric Track&r'lerin gerektirdiği şeyleri gerektirirler: Onlara güç sağlamak için &cSpeed Boost&r'lar ve &eFrame&r'ler. Artık virajlarda ve onlara dokunurken dikkatli olmalısınız!"
		"{image:atm:textures/questpics/railcraft/rail_electric_speed.png width:150 height:100 align:center}"
	]
	quest.4A44623D8A307473.title: "&6High Speed Electric Track&r'ler"
	quest.50A286C268F38E09.quest_desc: ["Bu Görev sayfasında, Oyuncu olarak neye atıfta bulunduğumu anlamanıza yardımcı olmak için metinleri renklendirmeye çok zaman harcadım. Sadece bunun daha da kafa karıştırıcı olabileceğini fark ettim, bu yüzden işte bir Renk Açıklaması! \n\n&5Mor&r: Herhangi bir Tren veya Lokomotif, yani hem Elektrikli hem Buharlı Lokomotifler ve takılı Vagonlar. \n&6Altın&r: Herhangi bir Ray ve Palet, özel Raylar dahildir ancak Track Kit'ler hariçtir. \n&cAçık Kırmızı&r: Herhangi bir Track Kit anlamına gelir. \n&4Koyu Kırmızı&r: Crowbar'lar içindir. \n&3Cam Göbeği&r: Yalnızca Steam Locomotive içindir. \n&eSarı&r: Yalnızca Electric Locomotive içindir. \n&9Mavi&r: Tunnel Bore içindir. \n&7Gri&r: Minecart'lar ve özel Vagonlar içindir."]
	quest.50A286C268F38E09.title: "Renk Açıklaması"
	quest.5128B119DFFF0C4C.quest_desc: [
		"&3Steam Locomotive&r en temel &5Locomotive&r'dir. Su, fırın yakıtı verilerek ve beklenerek çalıştırılabilir. Çalışmaya devam etmek için sürekli suya ihtiyacı olacaktır. \n\nEndişelenmeyin, bu sadece üstünden çıkan dumanın Su Buharı olduğu anlamına gelir ki bu Çevre için güvenlidir. Kömür kısmı Çevre için pek de iyi değil... e burası &2Minecraft&r, ne umurumuzda ki!"
		"{image:atm:textures/questpics/railcraft/rail_steam_locomotive.png width:100 height:100 align:center}"
	]
	quest.5128B119DFFF0C4C.title: "&3Steam Locomotive"
	quest.5180CDD196518F64.quest_desc: [
		"&6Strap Iron Track&r'ler, &6Abandoned Track&r'ler gibi ucuzcular için mükemmeldir. Diğer &6raylardan&r çok daha yavaş giderler ancak raydan çıkma riski yoktur!"
		"{image:atm:textures/questpics/railcraft/rail_strap.png width:150 height:100 align:center}"
	]
	quest.5180CDD196518F64.title: "&6Strap Iron Track&r'ler"
	quest.53594EBA9F7BA840.quest_desc: ["Advanced Item Unloader tıpkı normal parça gibidir ancak her yönden kullanılabilir. Yön dışında farklı bir şey yoktur."]
	quest.53594EBA9F7BA840.title: "Advanced Item Unloader"
	quest.541D270451DA4320.quest_desc: ["Farklı Özel &6Raylar&r arasında şerit değiştirmek için Switch Track gerekecektir. Üzerindeki Oklar hangisinin nereye gittiğini gösterir."]
	quest.54F2CB52D3A7BA87.quest_desc: ["Item Unloader, Item Loader'ın tam tersidir. &7Vagonlardan&r eşyaları alacaktır. Bu da &6Rayın&r üzerinde olmalıdır."]
	quest.54F2CB52D3A7BA87.title: "Item Unloader"
	quest.55D7CD0FA8F1AE48.quest_desc: ["Hepimizin burada olma sebebi, &5Trenler&r. Modun adı &l&7RailCraft&r, şaşırmış gibi yapmayın. \n\n2 farklı ana &5Tren&r ve 1 özel madencilik &5Treni&r vardır. \n\nBu &5Trenler&r tek başlarına biraz sıkıcı olabilir, öyleyse neden arkalarına &7Vagonlar&r bağlamayasınız! &7Vagonları&r &7Vagonlarla&r ve &5Trenlerle&r bağlamaya Kenetleme (Coupling), bağlantılarını kesmeye ise Ayırma (Decouple) denir. &5Trenleri&r ve &7Vagonları&r kenetlemek için bir &4Crowbar&r veya Kenetleme &cTrack Kit&r'ine sahip bir &6Ray&r kullanın."]
	quest.55D7CD0FA8F1AE48.title: "&7&lVagonlar&r ve &5&lTrenler&r!"
	quest.5820EDEF71340A1A.quest_desc: [
		"&6Abandoned Track&r'ler ucuzcular ve estetik için iyidir. Destek olmadan birkaç blok öteye köprü kurmak için kullanılabilirler. Aynı yöne giden bloklardan sadece 2 blok uzaklıkta veya karşı yönden bir blok uzaklıkta olabilirler. Yine de raydan çıkma riskiyle gelirler, temelde &7Vagonunuz&r &6raylardan&r dışarı fırlatılacaktır."
		"{image:atm:textures/questpics/railcraft/rail_abandoned.png width:150 height:100 align:center}"
	]
	quest.5820EDEF71340A1A.title: "&6Abandoned Track&r'ler"
	quest.5E750DB2244A67A1.quest_desc: [
		"&6Turnout Track&r, bir &6raya&r Spike Maul ile vurulduğunda elde edilen ilk raydır. İki yöne, ileriye ve bir yana gitmeye yardımcı olabilir. &6Rayın&r yanındaki bir Switch ile yönü değiştirilebilir."
		"{image:atm:textures/questpics/railcraft/rail_turnout.png width:100 height:100 align:center}"
	]
	quest.5E750DB2244A67A1.title: "&6Turnout Track&r'ler"
	quest.5F458D79D43D8842.quest_desc: ["Bu görev &6AllTheMods Ekibi&r veya AllTheMods mod paketlerinde kullanılmak üzere bir &2topluluk katılımcısı&r tarafından yazılmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir pakette izin alınmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir; eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.609CA1ACFA981BD5.quest_desc: ["&cRouting Kit&r geçiş biletleri (passing tickets) ile kullanılır."]
	quest.609CA1ACFA981BD5.title: "Routing &cTrack Kit&r"
	quest.61C93ABE07742DCD.quest_desc: [
		"Steam Turbine, buhar gücünü kullanarak FE/EU enerjisi üretir. \\n\\nSteam Turbine Housing bloklarından oluşan 3x2x2 boyutunda bir yapıdır. Çalışabilmesi için içine bir Turbine Motor yerleştirilmeli ve borularla buhar aktarılmalıdır."
		"{image:atm:textures/questpics/railcraft/rail_turbine.png width:100 height:100 align:center}"
	]
	quest.61C93ABE07742DCD.title: "Steam Turbine"
	quest.64C105E1E2F97900.quest_desc: ["Spike Maul'lar, modlarını değiştirmek için normal &6Raylar&r üzerinde kullanılır. Kesişimler yapmaya çalışırken çok faydalıdır!"]
	quest.64C105E1E2F97900.title: "Yön Değiştirme"
	quest.677C5D35DADA4A42.quest_desc: ["&cCoupler Kit&r &7Vagonları&r bağlamak veya ayırmak içindir. Kenetleme (Coupling), &7Vagonları&r bağlama ifadesidir. \n\nBir &4Crowbar&r ile kenetleme, ayırma veya otomatik kenetleme moduna yapılandırılabilir. Çalışması için Kızıltaş gerekir."]
	quest.677C5D35DADA4A42.title: "Coupler &cTrack Kit&r"
	quest.6C14D1B60124C2B2.quest_desc: [
		"&9Tunnel Bore&r özellikle dağların veya tepelerin altında otomatik olarak &6Ray&r döşemek için mükemmeldir. \n\nÇalışmaya başlamak için 3 şeye ihtiyacı vardır: &9Bore Head&r, Kömür gibi yakıt ve &6Raylar&r. Üçüne de sahip olduğunda sadece bırakın gitsin! \n\nİçine giren eşyaları takip etmeyi unutmayın!"
		"{image:atm:textures/questpics/railcraft/rail_tunnel.png width:100 height:100 align:center}"
	]
	quest.6C14D1B60124C2B2.title: "&9Tunnel Bore"
	quest.6C163E005351FF6D.quest_desc: ["&cWhistle Kit&r, Kızıltaş ile aktif olduğunda &5Locomotive&r'lerin düdüklerini çalmasına neden olur."]
	quest.6C163E005351FF6D.title: "Whistle &cTrack Kit&r"
	quest.6DB65926EE6D6C2E.quest_desc: ["Bu &cTrack Kit&r'leri, &7Vagonlarınızın&r ivmesini değiştirmek içindir. \n\n&cTransition Kit&r'leri geçen &5Locomotive&r'in hızını değiştirir, kızıltaş gücü gerektirir. \n&cBooster Kit&r'leri güç verildiğinde &7Vagonu&r hızlandırır, güç verilmediğinde &7Vagonu&r yavaşlatır. \n&cControl Kit&r &7Vagonlara&r hafif bir itme verir, güç verildiğinde ittiği yönü değiştirir. \n&cThrottle Kit&r geçen bir &5Locomotive&r'in hızını yapılandırılan hıza değiştirir, kızıltaş ile güçlendirilmesi gerekir. \n&cLauncher Kit&r kelimenin tam anlamıyla &7Vagonunuzu&r fırlatır!"]
	quest.6DB65926EE6D6C2E.title: "&7Vagonları&r Hareket Ettirmek İçin &cTrack Kit&r'leri"
	quest.6E7C4228CD2B6BB9.quest_desc: ["Bu &4Crowbar&r'ın birkaç farklı modu vardır ve her biri bir &5Locomotive&r'in tasarımını değiştirir. Envanterinizdeki eşyanın üzerine gelindiğinde açıklanan varsayılan moddan, &7griye&r dönüştüren \"none\" moduna, ürkütücü kılan &6H&r&5a&r&6l&r&5l&r&6o&r&5w&r&6e&r&5e&r&6n&r ve şenlikli kılan &cC&r&2h&r&cr&r&2i&r&cs&r&2t&r&cm&r&2a&r&cs&r moduna kadar!"]
	quest.75DD345164EE5CD9.quest_desc: [
		"&6High Speed Track&r'ler &6Reinforced Track&r'ler gibidir ama elbette daha hızlıdır. Hız kazanmaya yardımcı olmak için &cTrack Kit&r'lerine ihtiyaç duyarlar! Ve virajlarda dikkatli olun."
		"{image:atm:textures/questpics/railcraft/rail_speed.png width:150 height:100 align:center}"
	]
	quest.75DD345164EE5CD9.title: "&6High Speed Track&r'ler"
	quest.78D8F40AA9568511.quest_desc: ["Powered Rolling Machine, Manual Rolling Machine'in çok daha iyi bir versiyonudur. \n\nBir şeyler üretmek için makinenin içine bakmaya devam etmeniz gerekmez ve hepsini otomatik olarak üretecektir. \n\nTek sorun, güce ihtiyaç duymasıdır!"]
	quest.7D40B80DBBC4E160.quest_desc: ["Manual Rolling Machine, RailCraft için birçok malzemenin üretileceği küçük üretim makineniz olacaktır! \n\nTarifi koyduğunuzda ve 1'den fazla üretebildiğinde, siz hala ona bakarken otomatik üretim yapacaktır. Üretim yaparken Rolling Machine'den ayrıldığınızda üretimi iptal eder ve eşyaları envanterinize koyar. \n\nSon tarifi manuel olarak yapmalısınız!"]
	quest.7F187E291C3D5BA7.quest_desc: ["Fluid Unloader, Fluid Loader'ın tam tersidir. &6Rayın&r üstünde olmak yerine altındadır. &3Steam Locomotive&r'lere su vermek yerine sularını alır. Bunu neden yapmak isteyeceğinizi bilmiyorum ama yapabilirsiniz!"]
	quest.7F187E291C3D5BA7.title: "Fluid Unloader"
	quest.7F4B734CFB0F0306.quest_desc: ["Bu yeni &7Vagonlar&r, özel &2Vanilla&r &7Vagonlara&r benzer. &7Minecart with a Tank&r içindeki tüm Sıvıları tutar ve taşır. &7Minecart with an Energy Cell&r ise bunun yerine Enerji tutar dan taşır!"]
	quest.7F4B734CFB0F0306.title: "Yeni Vagonlar"
