{
	chapter.24151251C8730F2E.title: "Aether"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.04833C4BB0CCCBB7.quest_desc: ["Taş silahlarla aynı özelliklere sahiptir; tek farkı &7Kılıç&r yaratıklara vurduğunda, &7Balta&r ise &2Ağaçları&r kestiğinde &eAmbrosium Parçaları&r düşürür."]
	quest.04833C4BB0CCCBB7.title: "&7Kutsaltaş&r Silahları"
	quest.0483D3B051665F07.quest_desc: ["&5Zanite&r kendinden önceki materyallere göre çok daha fazla kullanım alanına sahiptir. \\n\\nZanite ile aletler ve zırhlar üretebilirsiniz. \\n\\nHatta &5Doğa Asası&r ve &5&lSunak&r gibi özel eşyalar bile yapabilirsiniz."]
	quest.0483D3B051665F07.title: "&5Zanite"
	quest.04B92FAB179A74C9.quest_desc: ["&dGravitit Kılıcı&r vurduğu hedefleri havaya fırlatır. Geri tepme gibi... ama yukarı doğru! \\n\\n&dGravitit Baltası&r ise &eAltın Meşe Ağaçlarını&r kesmenin tek yoludur."]
	quest.04B92FAB179A74C9.title: "&dGravitit&r Silahları"
	quest.08788F976B5C3281.quest_desc: ["&6Kutsal Kılıç&r, üzerinde Darbe büyüsü bulunan bir &bElmas Kılıca&r benzer. \\n\\nDarbe büyüsü ölümsüz yaratıklara ekstra hasar verir; &6Kutsal Kılıç&r da aynı şekilde işler. \\n\\nEn güzel yanı ise hasarını daha da artırmak için üzerine tekrar Darbe büyüsü ekleyebilmenizdir!"]
	quest.08788F976B5C3281.title: "&6Kutsal Kılıç"
	quest.08E4892F96828EC4.quest_desc: [
		"&c&lGüneş Ruhu&r'na doğrudan vuramazsınız. Savaşı başlatmak için önce onunla konuşmak adına sağ tıklamanız gerekir. \\n\\nBunu birkaç kez daha yapın... sonra biraz daha... sonra bir düzine daha yapın; yeterince sinirlendiğinde savaşı başlatacaktır! \\n\\n&c&lGüneş Ruhu&r odanın etrafında dolanarak geçtiği her yere &cAteş&r yayar. \\n\\nAyrıca &cAteş Kristalleri&r ve &bBuz Kristalleri&r fırlatır. Hasar verebilmek için &bBuz Kristallerine&r vurup onu donduracak şekilde üzerine fırlatmalısınız! Donduğunda nihayet ona vurabilirsiniz. \\n\\nDondurulduğunda kendisine yardım etmeleri için &cAteş Minyonlarını&r da çağıracaktır. \\n\\nSöndürüldüğünde düşüreceği şey..."
		"{image:atm:textures/questpics/aether/aether_gold2.png width:200 height:100 align:center}"
	]
	quest.08E4892F96828EC4.title: "&c&lGüneş Ruhu"
	quest.0D2BF2C5D784FCBE.quest_desc: ["&eValkyrie Pelerini&r tıpkı Yavaş Düşüş İksiri gibi etki gösterir. \\n\\n&e&lAether&r ve &d&lEnd&r için oldukça faydalıdır!"]
	quest.0D2BF2C5D784FCBE.title: "&eValkyrie Pelerini"
	quest.0D2F07FC0F804223.quest_desc: [
		"Ona 10 &eZafer Madalyası&r getirdiğinizde onunla savaşabilirsiniz! \\n\\n&e&lKraliçe&r'nin 500 &4Kalbi&r (250 kalp) vardır. Kılıcını savurarak odada hızla hareket eder. \\n\\nBazen üzerinize yıldırım çağıran Yıldırım Kristalleri fırlatır; ki bu 1. çatı altında imkansız olmalı, 2. ise kesinlikle hile sayılır! \\n\\nYenildiğinde size &eAltın Kılıcını&r ve şunları bırakacaktır..."
		"{image:atm:textures/questpics/aether/aether_silver2.png width:200 height:100 align:center}"
	]
	quest.0D2F07FC0F804223.title: "&e&lValkyrie Kraliçesi"
	quest.102DD961706E861A.quest_desc: ["&5Aechor Bitkileri&r saldırgan canlı bitkilerdir. Bir dakika, tüm bitkiler canlıdır... Ama bunların diğer &2&lMinecraft&r bitkilerinde olmayan 15 &4Kalbi&r (7,5 kalp) vardır. \\n\\n&5Aechor Bitkileri&r oklar fırlatır; isabet ederse &5Sarhoşluk Etkisi&r alırsınız. Bu etki, Bulantı ile harmanlanmış Zehir ve tamamen yeni bir etki gibidir. \\n\\nÖldüklerinde &5Taç Yaprakları&r düşürürler."]
	quest.102DD961706E861A.title: "&5Aechor Bitkisi"
	quest.1B7B377CB757867E.quest_desc: ["Tüm &dGravitit Aletleri&r ile kırdığınız belirli bloklara sağ tıklayarak onları gökyüzüne fırlatabilirsiniz! \\n\\nAyrıca bunlar &l&eAether&r'deki en güçlü aletlerdir."]
	quest.1B7B377CB757867E.title: "&dGravitit&r Aletleri"
	quest.1ECAEC7BE573BB9C.quest_desc: ["&5&lSunak&r oldukça kullanışlı bir bloktur. \\n\\nEşyaları &5büyüleyebilir&r ve &e&lAether&r veya &2&lVanilla&r aletlerini onarabilir. \\n\\nBüyülemek derken kitaplarla yapılan normal &2&lVanilla&r büyülerini kastetmiyoruz; sadece belirli &e&lAether&r eşyalarını özel formlarına dönüştürür! \\n\\n&5&lSunak&r yakıt olarak &eAmbrosium&r kullanır."]
	quest.1ECAEC7BE573BB9C.title: "&5&lSunak"
	quest.1F446EF3AD20DC6B.quest_desc: ["Bu &5çekiç&r hem menzilli hem de yakın dövüş silahıdır. \\n\\nYaratıklara normal şekilde vurabilir veya mermi fırlatmak için sağ tıklayabilirsiniz. \\n\\nFırlatılan mermiler yaratıkları rüzgar yükleri gibi geri savurur ve hasar verir."]
	quest.1F446EF3AD20DC6B.title: "&5Kingbdogz'un Çekici"
	quest.20C2A09007E1309A.quest_desc: ["&dGravitit Cevheri&r eritilmez; bunun yerine &5&lSunak&r kullanılarak &5büyülenir&r. \\n\\n&5Büyülendikten&r sonra onunla aletler, zırhlar ve hatta özel bir Müzik Kutusu yapabilirsiniz!"]
	quest.20C2A09007E1309A.title: "&dGravitit"
	quest.20D957B3C350CDE2.quest_desc: ["&dGravitit Zırhı&r 20 zırh puanı ve 8 zırh sertliği sağlar. \\n\\n5 parçanın hepsini giydiğinizde (evet, &dEldivenler&r de dahil) sadece zıplamaz, adeta havaya sıçrarsınız! \\n\\nAyrıca düşme hasarını tamamen engeller!"]
	quest.20D957B3C350CDE2.title: "&dGravitit&r Zırhı"
	quest.242C183437A4CCD4.quest_desc: ["&7Nöbetçi Çizmeleri&r tüm düşme hasarını engeller!"]
	quest.242C183437A4CCD4.title: "&7Nöbetçi Çizmeleri"
	quest.24E124F12CFF2A50.quest_desc: [
		"&7&lKaydırıcı&r, &7Bronz Zindanın&r boss'udur. \\n\\nKendisi dev bir küptür... 400 &4Kalbi&r (200 kalp) vardır ve ona hasar vermek için kazma kullanmanız gerekir. Kazmanız ne kadar kaliteliyse o kadar çok hasar verirsiniz. \\n\\n&l&7Kaydırıcı&r oldukça basit bir mekaniğe sahiptir; tek seferde yalnızca bir yöne doğru birkaç blok hareket eder. Saldırılarından kaçınmak çok kolaydır. \\n\\nCanını 100 &4Kalbin&r altına düşürdüğünüzde gözleri &4kırmızıya&r döner ve çok daha hızlı hareket etmeye başlar. \\n\\nOnu kazmayla \"kazıp\" yendiğinizde kazanacaklarınız..."
		"{image:atm:textures/questpics/aether/aether_bronze2.png width:200 height:100 align:center}"
	]
	quest.24E124F12CFF2A50.title: "&l&7Kaydırıcı"
	quest.26D6FC091B7A8B38.quest_desc: ["&eGümüş Anahtar&r! \\n\\nHazine sandığı &e&lKraliçe'nin&r tahtının altında bulunur."]
	quest.26D6FC091B7A8B38.title: "&eGümüş Anahtar"
	quest.27F62C4B42B16015.quest_desc: ["Tıpkı bir &cNether Portalı&r kurar gibi 4x5 boyutunda &eIşıktaşı Çerçeve&r dizip ortasına &9Su&r dökerek &eAether Portalı&r yapmak mı? \\n\\nHadi oradan, 7 yaşında değilim, buna bir daha kanmam! "]
	quest.27F62C4B42B16015.title: "&eAether Portalı"
	quest.29E6EFC8C19912BD.quest_desc: ["&7Nöbetçiler&r, &aBalçıklar&r ve &aCreeper'ların&r bir melezidir. \\n\\n&aBalçıklar&r gibi zıplar, &aCreeper'lar&r gibi PATLARLAR! \\n\\nPatlamadan önce onları öldürürseniz &7Oyma Taş&r düşürürler."]
	quest.29E6EFC8C19912BD.title: "&7Nöbetçiler"
	quest.2E05F4FB1A1FDE2D.quest_desc: ["&9Mavi Swet'lerin&r 12 &4Kalbi&r (6 kalp) vardır. \\n\\nSize doğrudan hasar vermezler... En azından kendi başlarına. Bunun yerine sizi yakalar ve sizinle birlikte havaya sıçrarlar. \\n\\nYakalandığınızda kurtulmanın tek yolu onlara vurmaktır. \\n\\nÖldüklerinde &9Swet Topları&r ve &bMavi Havabulutları&r düşürürler."]
	quest.2E05F4FB1A1FDE2D.title: "&9Mavi Swet"
	quest.31A2B9C5C0962160.quest_desc: ["Ateş Boyutu büyülü &bElmas Kılıç&r."]
	quest.31A2B9C5C0962160.title: "&cAlevli Kılıç"
	quest.326452FFA7F5C6CA.quest_desc: ["&eAltın Swet'ler&r tıpkı &9Mavi Swet'ler&r gibi davranır; canları ve saldırı şekilleri aynıdır. \\n\\nSadece bu canlılar daha yüksek düşüşlerden hayatta kalabilir, bu da &9Mavi Swet'lerden&r daha çok ve daha yükseğe zıplayacakları anlamına gelir. \\n\\nÖldüklerinde &eIşıktaşı&r düşürürler! Portalı yeniden inşa etmek için oldukça yararlıdır."]
	quest.326452FFA7F5C6CA.title: "&eAltın Swet"
	quest.3417FF406CF0479E.quest_desc: ["&2Gökkökü&r, &eAltın Meşe&r dışında bölgede bulabileceğiniz ana ağaç türüdür. \\n\\nKristal Ağaçlar da vardır ama onlar da &2Gökkökü Kütüğü&r kullanır. \\n\\nDiğer tüm kütükler gibi &2Gökkökü&r de bloklar, aletler vb. yapımında kullanılır."]
	quest.3417FF406CF0479E.title: "&2Gökkökü Ağaçları"
	quest.34FBB18ADA647010.quest_desc: ["Bulut Asası, sağ tıkladığınızda etrafınızda dönen 2 bulut minyonu çağırır. \\n\\nMinyonları çağırdıktan sonra sol tıkladığınızda nişan aldığınız yere buz kristalleri fırlatırlar. \\n\\nİşiniz bittiğinde Shift + sağ tık yaparak minyonları gönderebilirsiniz."]
	quest.362F529D5E7C37A4.quest_desc: ["&6Anka Zırhı&r giyerken &9Suya&r girerseniz zırhınız &5Obsidyen Zırhına&r dönüşür. \\n\\n&5Obsidyen Zırhı&r, ateş korumasını kaybeder ama karşılığında ekstra +4 zırh sertliği kazanır."]
	quest.362F529D5E7C37A4.title: "&5Obsidyen Zırhı"
	quest.3666C6DA23E15F78.quest_desc: ["Fırlattığı tüm okları &cAlevlendiren&r bir yay!"]
	quest.3666C6DA23E15F78.title: "&6Anka Yayı"
	quest.36D9FB96D3557266.quest_desc: ["&9Moa'lar&r büyük ve sevimli kuşlardır. \\n\\n35 &4Kalpleri&r (17,5 kalp) vardır ve tüy düşürürler. \\n\\nRastgele aralıklarla &9Moa Yumurtası&r bırakırlar; bu yumurtaları kullanarak onları evcilleştirebilirsiniz. Detaylar için &c&lKuluçka Makinesi&r görevine göz atın!"]
	quest.36D9FB96D3557266.title: "&9Moa"
	quest.3781DB4807A89375.quest_desc: ["&5Zanite Kılıcı&r başlangıçta Demir Kılıç seviyesinde hasar verir. \\n\\nAncak dayanıklılığı düştükçe verdiği hasar artar! \\n\\nAynı şekilde &5Zanite Balta&r da dayanıklılığı azaldıkça &2Ağaçları&r daha hızlı keser."]
	quest.3781DB4807A89375.title: "&5Zanite&r Silahları"
	quest.3887FD4B14BB993D.quest_desc: ["&cYenilenme Taşları&r takıldığında sizi sürekli olarak iyileştirir. \\n\\nAynı anda iki tane takabilirsiniz; etkileri birleşerek iyileşme hızınızı katlar!"]
	quest.3887FD4B14BB993D.title: "&cYenilenme Taşı"
	quest.38E3ABEEFCE6A0B9.quest_desc: ["&9İtme Kalkanı&r takıldığında gelen mermileri saptırarak saldıran kişiye geri fırlatır. \\n\\nAncak unutmayın, belli bir dayanıklılığı vardır..."]
	quest.38E3ABEEFCE6A0B9.title: "&9İtme Kalkanı"
	quest.39E1211455224291.quest_desc: ["&bZephyr'ler&r sinirli bulut yaratıklarıdır. \\n\\nYalnızca 5 &4Kalpleri&r (2,5 kalp) vardır ancak üzerinize rüzgar topları fırlatırlar. Tıpkı Ghast gibi! \\n\\nÖldüklerinde Soğuk Havabulutu düşürürler."]
	quest.39E1211455224291.title: "&bZephyr"
	quest.3A8AF52A5AE7C6CB.quest_desc: ["Suda nefes almanızı sağlar."]
	quest.3A8AF52A5AE7C6CB.title: "&7Demir Baloncuk"
	quest.3C62EDBB44D83A41.quest_desc: ["&5Doğa Asası&r evcilleştirilmiş &9Moa'lar&r ile çalışır. \\n\\nOturmalarını mı istiyorsunuz? &5Asayı&r kullanın."]
	quest.3C62EDBB44D83A41.title: "&5Doğa Asası"
	quest.3DB036804AD70497.quest_desc: ["&7Bronz Anahtar&r! \\n\\nHazine sandığı, &7&lKaydırıcı&r'nın durduğu yerin altındaki gizli odadadır."]
	quest.3DB036804AD70497.title: "&7Bronz Anahtar"
	quest.3EE51A812E593135.quest_desc: ["&c&lKuluçka Makinesinin&r tek bir görevi vardır: &9Moa Yumurtalarını&r kuluçkaya yatırmak. \\n\\nYakıt olarak &eAmbrosium Meşalesi&r kullanır. Her bir &9yumurta&r için 2 adet meşale gerekir. \\n\\n&9Yumurta&r çatladığında sevimli bir yavru &9Moa&r doğar! \\n\\nBüyümesi 20 dakika sürer. Büyüdüğünde eyer takıp üzerine binebilir ve &5Doğa Asası&r ile ona komut verebilirsiniz."]
	quest.3EE51A812E593135.title: "&c&lKuluçka Makinesi"
	quest.3FE994532AF53ABB.quest_desc: ["Küçük kardeşinin aksine &3Yıldırım Kılıcı&r normal bir kılıç gibi kullanılır. \\n\\nTek farkı, vurduğu her hedefe yıldırım indirmesidir!"]
	quest.3FE994532AF53ABB.title: "&3Yıldırım Kılıcı"
	quest.40AD1851C6851925.quest_desc: ["Haha! Biri aşağı düştü! \\n\\nUmarım düşüşünüzü yumuşatacak bir eşyanız vardır. \\n\\nBir dahaki sefere sadece &ePortalı&r kullanın!"]
	quest.40AD1851C6851925.title: "Eyvah!"
	quest.4394AEF0823FB4D2.quest_desc: ["Ahşap aletlerle aynı seviyededir; bu yüzden Demir veya &5Zanite Cevherini&r kıramaz. \\n\\nAncak her &2Gökkökü&r aleti düşen ganimetleri ikiye katlar. \\n\\n&2Gökkökü Kazması&r cevherleri, &2Kürek&r toprağı, &2Çapa&r ise bitki düşenlerini ikiye katlar."]
	quest.4394AEF0823FB4D2.title: "&2Gökkökü&r Aletleri"
	quest.48530C6C1187F613.quest_desc: ["Aerojel, &l&eAether&r boyutunda yere &cLav&r dökülerek elde edilir. \\n\\nPatlamalara karşı tamamen dayanıklıdır ve çeşitli dekoratif bloklara dönüştürülebilir!"]
	quest.4974F265003DAEC9.quest_desc: ["&eValkyrie Aletleri&r, erişim menzilinin iki kat daha uzun olması dışında normal aletler gibidir!"]
	quest.4974F265003DAEC9.title: "&eValkyrie Aletleri"
	quest.4AED9EF9E0F68483.quest_desc: ["&7Kutsaltaş Kazması&r &5Zanite&r kazabilir ancak &dGravitit&r kazamaz. \\n\\nBu aletler blok kırarken şansa bağlı olarak &eAmbrosium Parçası&r düşürür."]
	quest.4AED9EF9E0F68483.title: "&7Kutsaltaş&r Aletleri"
	quest.4BF7F82F1C8680B9.quest_desc: [
		"&7Bronz Zindan&r en kolay ve en temel zindandır. \\n\\nYer altında oluşur ve &7Oyma Taşlarla&r çevrili kare odalardan meydana gelir. Yüzeyde Yosunlu Kutsaltaş yapılarını arayıp aşağı doğru kazarak bulabilirsiniz. \\n\\nOdalarda &7Nöbetçiler&r doğar; zindanın en altındaki boss odasında ise &7&lKaydırıcı&r beklemektedir."
		"{image:atm:textures/questpics/aether/aether_bronze1.png width:200 height:100 align:center}"
	]
	quest.4BF7F82F1C8680B9.title: "&7Bronz Zindan"
	quest.4E847B0288265DA3.quest_desc: ["&dCockatrice&r, parlayan gözleri ve tüyleriyle &9Moa'lara&r benzer. \\n\\nBu tüylü yaratıklar yalnızca karanlıkta doğar. \\n\\nÜzerinize zehir tükürürler; isabet ederse &5Sarhoşluk Etkisi&r alırsınız (Detaylar için &5Aechor Bitkisi&r görevine bakın). \\n\\n&dCockatrice'in&r 10 &4Kalbi&r (5 kalp) vardır ve öldürüldüğünde tüy düşürür."]
	quest.4E847B0288265DA3.title: "&dCockatrice"
	quest.4F2DB9CDE2BACB69.quest_desc: ["Bu görev, AllTheMods mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk Katkıcısı&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına tabi olduğundan, bu görevin açık izin alınmadanHerkese açık başka paketlerde kullanılması yasaktır. \\n\\nBu görev kasıtlı olarak gizlenmiştir; bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.52007C01B52F7295.quest_desc: ["&eValkyrie'ler&r &eGümüş Zindanda&r doğarlar. \\n\\n&e&lValkyrie Kraliçesi&r ile savaşabilmek için önce 10 tanesini yenmeniz gerekir. \\n\\nHer birinin 50 &4Kalbi&r (25 kalp) vardır ve siz saldırmadıkça tarafsız kalırlar. Şanslısınız ki sizinle teker teker savaşırlar."]
	quest.52007C01B52F7295.title: "10 &eZafer Madalyası"
	quest.57DD886985DBFD97.quest_desc: ["Zindanlardaki sandıkları açarken sinsi bir sahtekarla, yani &4Taklitçiyle (Mimic)&r karşılaşabilirsiniz. \\n\\n&4Taklitçilerin&r 20 &4Kalbi&r (10 kalp) vardır ve oldukça yüksek hasar verirler. \\n\\nSandıktaki ganimetler için endişelenmeyin; &4Taklitçiyi&r öldürdüğünüzde tüm ganimetleri yere saçacaktır!"]
	quest.57DD886985DBFD97.title: "&4Taklitçi"
	quest.58006FC06C34F6CA.quest_desc: ["&5Zanite Zırhı&r toplam 15 zırh puanı sağlar. \\n\\nÖzel bir yeteneği yoktur; standart zırh koruması sunar."]
	quest.58006FC06C34F6CA.title: "&5Zanite&r Zırhı"
	quest.5825892699A8DCB7.quest_desc: ["Vay canına, işe yaradı... \\n\\nHepimizin çocukluğundan kalan modlardan biri olan &e&lThe Aether'e&r hoş geldiniz! Ve evet, tam da hatırladığımız gibi mükemmel! \\n\\n&e&lAether&r, &2&lNormal Dünya'nın&r metrelerce üzerinde süzülen büyüleyici bir gökyüzü boyutudur. Uçan adalar, kadim yapılar ve sonsuz bulutlar sizi bekliyor! \\n\\nBurada keşfedilmeyi bekleyen yepyeni eşyalar, yaratıklar ve zorlu zindanlar bulacaksınız."]
	quest.5825892699A8DCB7.title: "&l&eAether"
	quest.5900ADCC247CD5F9.quest_desc: [
		"&eGümüş Zindan&r yüzeyde yer aldığı için bulunması en kolay zindandır. \\n\\nDevasa bulutların üzerinde yükselir ve &eMelek Taşından&r inşa edilmiştir. \\n\\nYunan mimarisi tarzındadır — ki &eValkyrie'lerin&r İskandinav mitolojisine ait olduğu düşünülürse bu biraz garip bir detay! \\n\\n&e&lValkyrie Kraliçesi'ni&r bulmak için en üst kata çıkmalı, arkadaki merdivenlerden aşağı inmelisiniz. Konuştuğunuzda meydan okumanızı kabul etmek için 10 &eZafer Madalyası&r toplamanızı isteyecektir."
		"{image:atm:textures/questpics/aether/aether_silver1.png width:200 height:100 align:center}"
	]
	quest.5900ADCC247CD5F9.title: "&eGümüş Zindan"
	quest.5A5D4DFE4175FB42.quest_desc: [
		"&cAltın Zindan&r da yer altında bulunur. \\n\\nÜzeri &eAltın Meşe Ağaçlarıyla&r kaplı devasa bir tepenin altında yer aldığı için uzaktan kolayca fark edilir. \\n\\nZindan oldukça sade bir yapıya sahiptir; içinde yalnızca boss'un bulunduğu büyük tek bir oda yer alır."
		"{image:atm:textures/questpics/aether/aether_gold1.png width:200 height:100 align:center}"
	]
	quest.5A5D4DFE4175FB42.title: "&cAltın Zindan"
	quest.5BB5EE00BB4F9691.quest_desc: ["&7Uçan İnekler&r kanatlı ineklerdir! \\n\\nBildiğiniz ineklerden pek bir farkı yok... \\n\\n10 &4Kalpleri&r (5 kalp) vardır, Çiğ Sığır Eti ile Deri düşürürler ve sağılabilirler. \\n\\nTek farkları düşme hasarı almamak için havada süzülmeleridir."]
	quest.5BB5EE00BB4F9691.title: "&7Uçan İnek"
	quest.5C6BA6BBEC75EB71.quest_desc: ["&cAltın Anahtar&r! \\n\\nHazine sandığı, girişin karşısındaki gizli duvarın arkasında yer alır."]
	quest.5C6BA6BBEC75EB71.title: "&cAltın Anahtar"
	quest.5F44BF9A1DAE8B99.quest_desc: ["&9Neptün Zırhı&r 15 zırh puanı ve 4 zırh sertliği kazandırır. \\n\\nTam seti giydiğinizde &9suda&r çok daha hızlı yüzebilirsiniz! Hepsi bu."]
	quest.5F44BF9A1DAE8B99.title: "&9Neptün Zırhı"
	quest.6149E5F1F9CF8DC6.quest_desc: ["Phyg! (Acaba hala domuz diye mi telaffuz ediliyor?). \\n\\nNihayet domuzların uçtuğu günlere geldik! Kanatları sayesinde tavuklar gibi süzülerek düşme hasarından korunurlar. \\n\\n10 &4Kalpleri&r (5 kalp) vardır; öldüklerinde Çiğ Domuz Pirzolası ve Tüy düşürürler."]
	quest.6149E5F1F9CF8DC6.title: "&dPhyg"
	quest.6188A57F52F29D33.quest_desc: ["Hiç Terraria oynadınız mı? Oradaki Yaşam Kristallerini hatırlıyor musunuz? İşte bu eşya da tam olarak öyle çalışır! \\n\\nBir &cYaşam Parçası&r kullandığınızda kalıcı olarak fazladan bir &4kalp&r (2 kalp) kazanırsınız! \\n\\nMaksimum kaç &4kalbe&r ulaşılabildiğini bilmiyorum... Öğrendiğinizde bana da haber verin!"]
	quest.6188A57F52F29D33.title: "&cYaşam Parçası"
	quest.63D4621C06BA747C.quest_desc: ["Ahşap silahlarla aynı hasara sahiptir ancak &2Gökkökü&r silahları çift ganimet verir. \\n\\n&2Gökkökü Kılıcı&r yaratıklardan düşen eşyaları ikiye katlarken, &2Gökkökü Baltası&r ise &2Ağaçlardan&r elde edilen kütük miktarını iki katına çıkarır."]
	quest.63D4621C06BA747C.title: "&2Gökkökü&r Silahları"
	quest.6797E67E0136D96A.quest_desc: ["&7Kutsaltaş&r boyutun her tarafında bulunur; &e&lAether'in&r temel taşıdır. \\n\\nToplamak için kazma kullanmanız gerekir. Onunla çeşitli aletler ve yapı blokları üretebilirsiniz."]
	quest.6797E67E0136D96A.title: "&7Kutsaltaş"
	quest.6B3328B6AE8704D2.quest_desc: ["&bYıldırım Bıçakları&r, çarptıkları noktaya yıldırım indiren fırlatılabilir bıçaklardır! \\n\\nFırlatıldıklarında tüketilirler, bu yüzden dikkatli kullanın."]
	quest.6B3328B6AE8704D2.title: "&bYıldırım Bıçağı"
	quest.6C8766679D0AA8F6.quest_desc: ["Bu silah Domuzlara, Piglinlere ve Zombileşmiş Piglinlere tek atar. \\n\\nHoglin ve Zoglinlere 2, Zalim Piglinlere ise 3 vuruşta son verir."]
	quest.6C8766679D0AA8F6.title: "&dDomuz Katili"
	quest.6D2425DAEA1FC211.quest_desc: ["&cGüneş Sunağı&r &e&lAether'deki&r zamanı değiştirebilir. \\n\\nEvet, normalde &l&eAether'de&r gece-gündüz döngüsü olmasa da bu küçük blok zamanı kontrol etmenizi sağlar. \\n\\nZamanı dilediğiniz gibi ayarlayın! \\n\\nGeceye ayarlarsanız &l&eAether'de&r yatak kullanarak doğma noktası belirleyebilirsiniz."]
	quest.6D2425DAEA1FC211.title: "&cGüneş Sunağı"
	quest.705AEEDA95C52C99.quest_desc: ["&b&lDondurucu&r adından da anlaşılacağı üzere nesneleri &bDondurur&r. \\n\\n&9Suyu&r &bBuza&r, &bBuzu&r &bSıkı Buza&r, &bSıkı Buzu&r &9Mavi Buza&r ve &cLavı&r &5Obsidyene&r dönüştürür. \\n\\nAyrıca buzdan yüzükler ve kolyeler de yapabilir! \\n\\n&b&lDondurucu&r yakıt olarak Buztaşı kullanır."]
	quest.705AEEDA95C52C99.title: "&b&lDondurucu"
	quest.714960DF26EFFA53.quest_desc: ["Tüm &5Zanite aletler&r dayanıklılıkları düştükçe blokları daha hızlı kazar. \\n\\nAyrıca &5Zanite Kazma&r ile &dGravitit&r cevheri kazabilirsiniz."]
	quest.714960DF26EFFA53.title: "&5Zanite&r Aletleri"
	quest.72133DD1B3237493.quest_desc: ["&4Vampir Kılıcı&r can çalma özelliğine sahiptir. \\n\\nDüşmanlara verdiğiniz hasarın bir kısmıyla kendi &4Kalbinizi&r yenilersiniz!"]
	quest.72133DD1B3237493.title: "&4Vampir Kılıcı"
	quest.7597D3D06E761759.quest_desc: ["&eValkyrie Mızrağı&r muazzam bir erişim menziline sahip yakın dövüş silahıdır! \\n\\nTam 10 blok menzil!"]
	quest.7597D3D06E761759.title: "&eValkyrie Mızrağı"
	quest.75C5BFAEADEB486E.quest_desc: ["&eValkyrie Zırhı&r, &cNetherite Zırhı&r ile aynı değerlere sahiptir. \\n\\nAsıl eğlenceli yanı tüm parçaları (Kask, Göğüslük, Pantolon, Çizme ve Eldiven) aynı anda giydiğinizde ortaya çıkar. \\n\\n5 parçayı da taktığınızda Boşluk (Space) tuşuna basılı tutarak uçabilirsiniz! Ancak bu uçuş kısa sürelidir."]
	quest.75C5BFAEADEB486E.title: "&eValkyrie Zırhı"
	quest.765F6A5A9779CF6D.quest_desc: ["Havabulutları &l&eAether'in&r dört bir yanında bulunur. Gökyüzü boyutunda olduğumuz düşünülürse bu gayet doğal! \\n\\nSoğuk Havabulutları ve &eAltın Havabulutları&r benzer şekilde çalışır. İçlerine hafifçe batarsınız; tıpkı &6bal&r gibi ama daha az yapışkandır. Ayrıca düşme hasarını tamamen sönümlerler. \\n\\n&bMavi Havabulutları&r ise farklıdır: Üzerlerinde zıpladığınızda gökyüzüne fırlatılırsınız. Shift tuşuna basarak içlerinden aşağı süzülebilirsiniz. \\n\\nHavabulutlarını her yerde bulup toplayabilirsiniz. Ayrıca Soğuk Havabulutlarını &5büyüleyerek&r &eAltın Havabulutları&r, &bDondurucu kullanarak&r ise &bMavi Havabulutları&r elde edebilirsiniz."]
	quest.765F6A5A9779CF6D.title: "Havabulutları"
	quest.769B23E692CBA16B.quest_desc: ["Bildiğimiz kova ve tekneler gibi çalışırlar; tek farkı &l&eAether&r tahtasından yapılmış olmalarıdır!"]
	quest.769B23E692CBA16B.title: "&2Gökkökü&r Tekne ve Kova"
	quest.78AAFE5AF04A13AC.quest_desc: ["&bAerbunny'ler&r havada zıplarlar. Siz de yapabilseniz siz de yapardınız! \\n\\nYalnızca 6 &4Kalbi&r (3 kalp) olan zararsız yaratıklardır. \\n\\nOnları öldürecek kadar acımasızsanız geriye İp bırakırlar."]
	quest.78AAFE5AF04A13AC.title: "&bAerbunny"
	quest.78BD3D4FBA42D3DC.quest_desc: ["Sheepuff'lar Aether'de yaşayan şapşal küçük canlılardır. \\n\\nNormal koyunlara benzerler ama bazen sebepsizce havaya fırlayıp yavaşça süzülürler. Nedenini bilmiyorum, belki de eğlencelidir! \\n\\nBazen fazla yünden dolayı şişerler; bu durumda arka arkaya iki kez kırkılabilirler! \\n\\n8 &4Kalpleri&r (4 kalp) vardır ve Çiğ Koyun Eti ile Yün düşürürler."]
	quest.78BD3D4FBA42D3DC.title: "Sheepuff"
	quest.79A1A63BCE7A541B.quest_desc: ["&bGörünmezlik Pelerini&r adından ve popüler kültürden de anlaşılacağı üzere sizi görünmez kılar! \\n\\nÇok yaklaşmadığınız veya saldırmadığınız sürece yaratıklar sizi fark etmez."]
	quest.79A1A63BCE7A541B.title: "&bGörünmezlik Pelerini"
	quest.7A4B51313FB134EA.quest_desc: ["&6Anka Zırhı&r &cNetherite&r ile aynı şekilde toplam 20 zırh puanı ve 8 sertlik sağlar. \\n\\nAyrıca doğuştan gelen ateş koruması sayesinde &cateş&r veya &clavdan&r hasar almazsınız! \\n\\nAncak giyerken &9suya&r girmemeye dikkat edin, aksi halde..."]
	quest.7A4B51313FB134EA.title: "&6Anka Zırhı"
	quest.7AD4ED72AC31D912.quest_desc: ["&3Aerwhale'ler&r &l&eAether'de&r süzülen devasa, hızlı, uçan barışçıl yaratıklardır. \\n\\nÖldüklerinde bir şey düşürmezler; sadece manzarayı güzelleştirirler."]
	quest.7AD4ED72AC31D912.title: "&3Aerwhale"
	quest.7BFB4DA68A7912E5.quest_desc: ["Ambrosium, &e&lAether'in&r kömürüdür. \\n\\nMeşale yapımında ve fırınlarda yakıt olarak kullanılır. \\n\\nAyrıca Aether çimleri üzerinde kullanıldığında toprağı kutsar."]
	quest.7BFB4DA68A7912E5.title: "&eAmbrosium"
	quest.7D7BB45D84A4E94A.quest_desc: ["&3Swet Pelerini&r taktığınızda &9Swet'ler&r dost canlısı hale gelir! \\n\\nSizi yakalamak yerine binek gibi güvenle sürmenize izin verirler. \\n\\nSizi öldürmeye çalışmadıklarında çok daha az düşme hasarı alırlar."]
	quest.7D7BB45D84A4E94A.title: "&3Swet Pelerini"
