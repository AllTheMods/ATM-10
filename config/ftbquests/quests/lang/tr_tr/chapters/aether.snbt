{
	chapter.24151251C8730F2E.title: "The Aether"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.04833C4BB0CCCBB7.quest_desc: ["Stone Weapons ile aynıdır, sadece &7Sword &rYaratıklara vurduğunda ve &7Axe&r &2Trees&r kestiğinde &eAmbrosium Shards&r düşürür."]
	quest.04833C4BB0CCCBB7.title: "&7Holystone&r Weapons"
	quest.0483D3B051665F07.quest_desc: ["&5Zanite&r, ondan önceki Eşyalardan çok daha fazla kullanıma sahiptir. \\n\\nOnunla Tools ve Armor yapabiliriz. \\n\\nHatta &5Nature Staff&r ve bir &5&lAltar&r gibi özel Eşyalar (Items) bile yapabiliriz."]
	quest.0483D3B051665F07.title: "&5Zanite"
	quest.04B92FAB179A74C9.quest_desc: ["&dGravitite Sword&r, vurduğu her şeyi Havaya fırlatır. Knockback gibi... sadece yukarı doğru! \\n\\n&dGravitite Axe&r, &eGolden Oak Trees&r kesmenin tek yoludur."]
	quest.04B92FAB179A74C9.title: "&dGravitite&r Weapons"
	quest.08788F976B5C3281.quest_desc: ["&6Holy Sword&r, üzerinde Smite basılı bir &bDiamond Sword&r gibidir. \\n\\nSmite, Undead Yaratıklara fazladan Hasar (Damage) verir. &6Holy Sword&r de öyle. \\n\\nEn iyi yanı ise, daha fazla Hasar eklemek için ona Smite ile Enchant basabilmenizdir!"]
	quest.08788F976B5C3281.title: "&6Holy Sword"
	quest.08E4892F96828EC4.quest_desc: [
		"&c&lSun Spirit&r'e Vuramazsınız (Hit), onunla bir Dövüş (Fight) başlatmak için onunla konuşmak üzere Sağ Tıklamanız (Right Click) gerekecek. \\n\\nBunu birkaç kez daha yapın... sonra birkaç kez daha... ardından fazladan on iki kez civarı yaptıktan sonra, dövüşü başlatacak kadar öfkelenecektir! \\n\\n&c&lSun Spirit&r, gittiği her yere &cFire&r yayarak odanın içinde dolaşmaya başlayacaktır. \\n\\nAyrıca &cFire Crystals&r ve &bIce Crystals&r fırlatacaktır. Ona Hasar (Damage) verebilmek için onu Dondurmak (Freeze) üzere &bIce Crystals&r'ı ona geri Vurmanız (Hit) gerekecek! Donduğunda nihayet ona Vurabilirsiniz (Hit). \\n\\nDondurulduktan sonra ona yardım etmeleri için &cFire Minions&r çağıracaktır. \\n\\nSöndürüldüğünde şunları Düşürecektir (Drop)..."
		"{image:atm:textures/questpics/aether/aether_gold2.png width:200 height:100 align:center}"
	]
	quest.08E4892F96828EC4.title: "&c&lSun Spirit"
	quest.0D2BF2C5D784FCBE.quest_desc: ["&eValkyrie Cape&r bir Slow Falling Potion gibi etki gösterecektir. \\n\\n&e&lThe Aether&r ve &d&lThe End&r için çok yardımcı olur!"]
	quest.0D2BF2C5D784FCBE.title: "&eValkyrie Cape"
	quest.0D2F07FC0F804223.quest_desc: [
		"Ona 10 &eVictory Medals&r getirin ve artık onunla savaşabilirsiniz! \\n\\n&e&lQueen&r'in 500 &4Hearts&r'ı vardır. Kılıcını (Sword) size savurarak odanın içinde oradan oraya atılacaktır. \\n\\nBazen size Lightning çağıracak Thunders Crystals fırlatır, ki bu 1. çatı yüzünden imkansız olmalıdır ve 2. kesinlikle hiledir. \\n\\nSavaşta (Battle) yenildiğinde kendi &eGold Sword&r'unu verecektir ve..."
		"{image:atm:textures/questpics/aether/aether_silver2.png width:200 height:100 align:center}"
	]
	quest.0D2F07FC0F804223.title: "&e&lValkyrie Queen"
	quest.102DD961706E861A.quest_desc: ["&5Aechor Plants&r, Düşmancıl (Hostile) canlı Bitkilerdir. Bir saniye, tüm Bitkiler canlıdır... her neyse, bunların 7,5 &4Hearts&r'ı vardır ve bu diğer &2&lMinecraft&r Bitkilerinde (Plants) yoktur. \\n\\n&5Aechor Plants&r, size isabet ederse &5Inebreviation Effect&r almanıza sebep olacak Oklar (Arrows) fırlatır. Bu etki, Nausea ile karışık bir Poison gibi ve yepyeni bir Etki olarak çalışır. \\n\\nÖldürüldüklerinde kendi &5Petal&r'larını Düşürürler (Drop)."]
	quest.102DD961706E861A.title: "&5Aechor Plant"
	quest.1B7B377CB757867E.quest_desc: ["Tüm &dGravitite Tools&r, kırdıkları belirli Bloklara Sağ Tıklanarak (Right Click) o blokları Gökyüzüne doğru patlatıp uçurmak için kullanılabilir! \\n\\nAyrıca &l&eThe Aether&r'ın sunduğu en iyi Tools'dur."]
	quest.1B7B377CB757867E.title: "&dGravitite&r Tools"
	quest.1ECAEC7BE573BB9C.quest_desc: ["&5&lAltar&r çok kullanışlı bir Bloktur (Block). \\n\\nEşyalara (Items) &5Enchant&r basabilir ve &e&lAether&r veya &2&lVanilla&r Tools'u Onarabilir (Repair). \\n\\nEnchant dendiğinde, Books ile yapılan &2&lVanilla&r Enchantments kastedilmemektedir. Sadece belirli &e&lAether&r Eşyalarını dönüştürür! \\n\\n&5&lAltar&r için yakıt &eAmbrosium&r'dur."]
	quest.1ECAEC7BE573BB9C.title: "&5&lAltar"
	quest.1F446EF3AD20DC6B.quest_desc: ["Bu &5Hammer&r hem menzilli (ranged) hem de Yakın Dövüş (Melee) Silahıdır (Weapon). \\n\\nYaratıklara (Mobs) normal bir şekilde vurabilir veya Mermiler (Projectiles) Ateşlemek (Shoot) için Sağ Tıklayabilirsiniz (Right Click). \\n\\nMermiler Yaratıkları Breezeballs gibi geri savurur ve Hasar (Damage) verir."]
	quest.1F446EF3AD20DC6B.title: "&5Hammer of Kingbdogz"
	quest.20C2A09007E1309A.quest_desc: ["&dGravitite Ore&r Eritilmez (Smelted), bunun yerine &5&lAltar&r ile ona &5Enchant&r basılır. \\n\\n&5Enchanted&r olduğunda ondan Tools ve Armor yapabiliriz. Artı bir Jukebox!"]
	quest.20C2A09007E1309A.title: "&dGravitite"
	quest.20D957B3C350CDE2.quest_desc: ["&dGravitite Armor&r, 20 Armor Points ve 8 Armor Toughness verir. \\n\\n5 Parçanın (evet, &dGloves&r da sayılır) tamamını giydiğinizde havaya zıplamazsınız, sıçrarsınız (leap)! \\n\\nAyrıca Düşme Hasarını (Fall Damage) da önleyecektir!"]
	quest.20D957B3C350CDE2.title: "&dGravitite&r Armor"
	quest.242C183437A4CCD4.quest_desc: ["&7Sentry Boots&r tüm Düşme Hasarını (Fall Damage) sıfırlar!"]
	quest.242C183437A4CCD4.title: "&7Sentry Boots"
	quest.24E124F12CFF2A50.quest_desc: [
		"&7&lSlider&r, &7Bronze Dungeon&r'ın Patronudur (Boss). \\n\\nO bir Küp (Cube)... 400 &4Hearts&r'ı vardır ve Hasar (Damage) vermek için bir Pickaxe'e ihtiyacınız olacak. Pickaxe ne kadar iyiyse Hasar o kadar fazla olur. \\n\\n&l&7Slider&r çok basittir, bir seferde sadece tek yönde ve yalnızca birkaç Blok (Blocks) hareket eder. Kaçınması çok kolaydır. \\n\\nOnu 100 &4Hearts&r'a düşürdüğünüzde Gözleri &4Red&r olacak ve daha hızlı hareket edecektir. \\n\\nEğer onu \"Kazarsanız (Mine)\" şunları elde edersiniz..."
		"{image:atm:textures/questpics/aether/aether_bronze2.png width:200 height:100 align:center}"
	]
	quest.24E124F12CFF2A50.title: "&l&7The Slider"
	quest.26D6FC091B7A8B38.quest_desc: ["&eSilver Key&r! \\n\\nHazine Sandığı (Treasure Chest), &e&lQueen's&r Tahtının altında açılır."]
	quest.26D6FC091B7A8B38.title: "&eSilver Key"
	quest.27F62C4B42B16015.quest_desc: ["Sadece 4x5'lik bir &eGlowstone Rectangle&r yerleştirin, tıpkı bir &cNether Portal&r gibi ve içine &9Water&r dökerek &eAether Portal&r mı yapalım? \\n\\nEvet haklısın, 7 yaşında değilim, buna tekrar kanmayacağım! "]
	quest.27F62C4B42B16015.title: "&eAether Portal"
	quest.29E6EFC8C19912BD.quest_desc: ["&7Sentries&r, &aSlimes &fve &aCreepers&r melezi gibidir. \\n\\n&aSlimes&r gibi zıplarlar ve &aCreepers&r gibi PATLARLAR (EXPLODE)! \\n\\nPatlamadan önce onları Öldürürseniz (Kill), &7Carved Stone&r Düşürürler (Drop)."]
	quest.29E6EFC8C19912BD.title: "&7Sentries"
	quest.2E05F4FB1A1FDE2D.quest_desc: ["&9Blue Swets&r 6 &4Hearts&r'a sahiptir. \\n\\nSize Hasar (Damage) vermezler... en azından tek başlarına. Bunun yerine sizi yakalayıp sizi de beraberinde getirerek havaya yükseklere sıçrarlar. \\n\\nYakalandığınızda kendinizi kurtarmanın tek yolu onlara Vurmaktır (Hit). \\n\\nÖldüklerinde &9Blue Swets&r, &9Swet Balls&r ve &bBlue Aeroclouds&r Düşürür (Drop)."]
	quest.2E05F4FB1A1FDE2D.title: "&9Blue Swet"
	quest.31A2B9C5C0962160.quest_desc: ["Fire Aspect'li &bDiamond Sword&r."]
	quest.31A2B9C5C0962160.title: "&cFlaming Sword"
	quest.326452FFA7F5C6CA.quest_desc: ["&eGolden Swets&r, tıpkı &9Blue Swets&r gibi davranır. Aynı Can (Health), aynı Saldırı (Attack). \\n\\nSadece bu adamlar daha yüksek Sıçramalardan (Jumps) kurtulabilir, bu da &9Blue Swets&r'dan daha fazla ve daha yükseğe Sıçrayacakları (Jump) anlamına gelir. \\n\\n&eGolden Swets&r, &eGlowstone&r Düşürür (Drop)! &ePortal&r'ı yeniden oluşturmak için yardımcı olur."]
	quest.326452FFA7F5C6CA.title: "&eGolden Swet"
	quest.3417FF406CF0479E.quest_desc: ["&2Skyroot&r, &eGolden Oak&r dışında bulduğumuz tek Ağaçtır (Tree). \\n\\nAyrıca Crystal Trees de vardır ancak onlar da &2Skyroot Logs&r kullanır, bu yüzden aynı şeydir! \\n\\n&2Skyroot&r da diğer Logs gibi Bloklar, Tools VS. yapımında kullanılabilir."]
	quest.3417FF406CF0479E.title: "&2Skyroot Trees"
	quest.34FBB18ADA647010.quest_desc: ["Cloud Staff, Sağ Tıkladığınızda (Right Click) etrafınızda dönen 2 Cloud Minions çağırır. \\n\\nOnları Doğurduktan (Spawning) sonra Sol Tıklarsanız (Left Click), ikisi de nişan aldığınız yere Ice Crystals fırlatır. \\n\\nOnlardan sıkıldığınızda, kurtulmak için Shift ile Sağ Tıklamanız (Shift Right Click) yeterlidir."]
	quest.362F529D5E7C37A4.quest_desc: ["&9Water&r içinde &6Phoenix Armor&r ile durursanız &5Obsidian Armor&r elde edersiniz. \\n\\n&5Obsidian Armor&r, ekstra 4 Armor Toughness karşılığında Ateş Korumasından (Fire Protection) vazgeçer."]
	quest.362F529D5E7C37A4.title: "&5Obsidian Armor"
	quest.3666C6DA23E15F78.quest_desc: ["Tüm Okları (Arrows) &cFIRE (ATEŞ)&r ile yakan bir Yay (Bow)!"]
	quest.3666C6DA23E15F78.title: "&6Phoenix Bow"
	quest.36D9FB96D3557266.quest_desc: ["&9Moa's&r, dost canlısı büyük Kuşlardır (Birds). \\n\\n17,5 &4Hearts&r'a sahiptirler ve Feathers Düşürürler (Drop). \\n\\nRastgele olarak &9Moa Eggs&r Düşürürler (Drop), bu onları Evcilleştirebilmenizin (Tame) yoludur. Daha fazlasını öğrenmek için &c&lIncubator&r'a göz atın!"]
	quest.36D9FB96D3557266.title: "&9Moa"
	quest.3781DB4807A89375.quest_desc: ["&5Zanite Sword&r, Iron Sword Hasarı (Damage) civarındadır... ta ki Durability'sini kaybedene kadar. \\n\\nEvet, &5Sword&r daha az Durability'ye sahip oldukça daha fazla Hasar (Damage) verecektir! \\n\\n&5Axe&r, daha az Durability'ye sahip oldukça &2Trees&r'ı daha hızlı kesecektir."]
	quest.3781DB4807A89375.title: "&5Zanite&r Weapons"
	quest.3887FD4B14BB993D.quest_desc: ["&cRegeneration Stones&r giyildiğinde sizi sürekli olarak İyileştirir (Heal). \\n\\nAslında iki tanesini aynı anda tutabilirsiniz ve bunlar İyileştirmeyi (Healing) birleştirecektir (stack)!"]
	quest.3887FD4B14BB993D.title: "&cRegeneration Stone"
	quest.38E3ABEEFCE6A0B9.quest_desc: ["&9Shield of Repulsion&r, giyildiğinde Mermileri (Projectiles) sizden uzağa ve onları atan kişiye geri saptırır. \\n\\nAncak bir Durability'si vardır..."]
	quest.38E3ABEEFCE6A0B9.title: "&9Shield of Repulsion"
	quest.39E1211455224291.quest_desc: ["&bZephyrs&r sinirli Bulutlardır (Clouds). \\n\\nSadece 2,5 &4Hearts&r'ı olan bu yaratıklar size Airballs atar. Breezeballs fırlatan bir Ghast gibi. \\n\\nÖldürüldüklerinde (Killed) Cold Aeroclouds Düşürürler (Drop)."]
	quest.39E1211455224291.title: "&bZephyr"
	quest.3A8AF52A5AE7C6CB.quest_desc: ["Water Breathing (Suda Nefes Alma) verir."]
	quest.3A8AF52A5AE7C6CB.title: "&7Iron Bubble"
	quest.3C62EDBB44D83A41.quest_desc: ["&5Nature Staff&r Evcilleştirilmiş (Tamed) &9Moas&r ile çalışır. \\n\\nOturmalarını (Sit) mı istiyorsunuz? &5Staff&r kullanın."]
	quest.3C62EDBB44D83A41.title: "&5Nature Staff"
	quest.3DB036804AD70497.quest_desc: ["&7Bronze Key&r! \\n\\nHazine Sandığı (Treasure Chest), &7&lSlider&r'ın Uykuda (Dormant) oturduğu yerin altındadır."]
	quest.3DB036804AD70497.title: "&7Bronze Key"
	quest.3EE51A812E593135.quest_desc: ["&c&lIncubator&r'ın tek bir işi vardır: &9Moa Eggs&r'i yumurtadan çıkarmak. \\n\\nYakıt (Fuel) olarak &eAmbriosium Torches&r kullanır. Yumurtadan çıkacak her bir &9Egg&r için 2 taneye ihtiyacınız olacak. \\n\\n&9Egg&r kırıldığında, bir yavru &9Moa&r Doğacaktır (Spawn)! \\n\\nBüyümesi 20 Dakika (Minutes) alacaktır ancak büyüdüğünde ona bir Saddle ile binebilirsiniz. Onlara &5Nature Staff&r ile komut da verebilirsiniz."]
	quest.3EE51A812E593135.title: "&c&lIncubator"
	quest.3FE994532AF53ABB.quest_desc: ["Küçük kardeşinin aksine &3Lightning Sword&r, normal bir Kılıç (Sword) gibi davranır. \\n\\nSadece vurduğu (Hits) her şeye Lightning çarpacaktır!"]
	quest.3FE994532AF53ABB.title: "&3Lightning Sword"
	quest.40AD1851C6851925.quest_desc: ["Haha! Birisi düştü! \\n\\nUmarım düşüşünü yavaşlatacak bir şey getirmişsindir. \\n\\nBir dahaki sefere sadece &ePortal&r'ı kullan!"]
	quest.40AD1851C6851925.title: "Whoops!"
	quest.4394AEF0823FB4D2.quest_desc: ["Wooden Tools ile aynı kademededir (tier), bu yüzden Iron veya &5Zanite Ore&r kıramaz. \\n\\nAncak her &2Skyroot&r Dropları (Düşenleri) ikiye katlar. \\n\\n&2Skyroot Pickaxe&r Ores'i ikiye katlar, &2Shovel&r Dirt'ü ikiye katlar ve &2Hoe&r Plant (Bitki) Droplarını ikiye katlar."]
	quest.4394AEF0823FB4D2.title: "&2Skyroot&r Tools"
	quest.48530C6C1187F613.quest_desc: ["Aerogel, &l&eThe Aether&r'da &cLava&r yerleştirilerek yapılır. \\n\\nPatlamalardan (Explosions) kırılmaz ve başka dekorasyonlar (decoration) yapmak için kullanılabilir!"]
	quest.4974F265003DAEC9.quest_desc: ["&eValkyrie Tools&r, iki kat Uzunluk (Reach) haricinde normal Tools gibidir!"]
	quest.4974F265003DAEC9.title: "&eValkyrie Tools"
	quest.4AED9EF9E0F68483.quest_desc: ["&7Holystone Pickaxe&r, &5Zanite&r kazabilir (Mine) ancak &dGravitite&r kazamaz. \\n\\nTüm bu Tools, Blokları (Blocks) kırarken (Breaking) rastgele olarak &eAmbrosium Shards&r Düşürür (Drop)."]
	quest.4AED9EF9E0F68483.title: "&7Holystone&r Tools"
	quest.4BF7F82F1C8680B9.quest_desc: [
		"&7Bronze Dungeon&r en kolay ve en basit Zindandır (Dungeon). \\n\\nYer altında Doğar (Spawns) ve &7Carved Stone&r ile yapılmış büyük kare odalardan oluşur. Yer üstünde Mossy Holystone arayarak ve onu aşağı doğru takip ederek onu bulabilirsiniz. \\n\\nHer odada &7Sentries&r Doğar (Spawn) ve Patron (Boss) odası &7&lSlider&r'ı tutar."
		"{image:atm:textures/questpics/aether/aether_bronze1.png width:200 height:100 align:center}"
	]
	quest.4BF7F82F1C8680B9.title: "&7Bronze Dungeon"
	quest.4E847B0288265DA3.quest_desc: ["&dCockatrice&r, sadece Parlayan (Glowing) Gözleri ve Tüyleri (Feathers) olan &9Moas&r'a benzer. \\n\\nBu tüylü düşmanlar sadece Karanlıkta (Dark) Doğar (Spawn). \\n\\nSize tükürürler, eğer isabet ederse size &5Inebreviation Effect&r verir. Bu Etkinin (Effect) daha iyi bir açıklaması için &5Aechor Plant&r'e göz atın. \\n\\n&dCockatrice&r 10 &4Health&r'a sahiptir ve öldürüldüğünde Feathers Düşürür (Drop)."]
	quest.4E847B0288265DA3.title: "&dCockatrice"
	quest.4F2DB9CDE2BACB69.quest_desc: ["Bu Görev (Quest), AllTheMods Modpaketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır (All Rights Reserved)&r altında lisanslandığından, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.52007C01B52F7295.quest_desc: ["&eValkyries&r, &eSilver Dungeon&r'da doğar. \\n\\n&e&lValkyrie Queen&r ile savaşmak için onlardan 10 tanesini yenmeniz gerekecek. \\n\\nHer birinin 50 &4Hearts&r'ı vardır ve siz onlara Vurana (Hit) kadar Tarafsızdırlar (Neutral). Çok şükür ki her seferinde teker teker savaşacaklar."]
	quest.52007C01B52F7295.title: "10 &eVictory Medals"
	quest.57DD886985DBFD97.quest_desc: ["Zindanlardaki (Dungeons) Sandıkları (Chests) açarken korkutucu bir sahtekâr olan &4Mimic&r ile karşılaşabilirsiniz. \\n\\n&4Mimics&r, 20 &4Hearts&r'a sahiptir ve çok fazla Hasar (Damage) verir. \\n\\nSandıktan almış olabileceğiniz Ganimet (Loot) için endişelenmeyin, &4Mimic&r Öldürüldüğünde (Killed) benzer Ganimetler Çıkaracaktır (Spawn)!"]
	quest.57DD886985DBFD97.title: "&4Mimic"
	quest.58006FC06C34F6CA.quest_desc: ["&5Zanite Armor&r, toplam 15 Armor Points verir. \\n\\nBunların özel bir yanı yoktur, sadece birer Zırhtırlar (Armor)!"]
	quest.58006FC06C34F6CA.title: "&5Zanite&r Armor"
	quest.5825892699A8DCB7.quest_desc: ["Vay canına, işe yaradı... \\n\\nÇocukluğumuzun Modpaketlerinden (Modpacks) biri olan &e&lThe Aether&r'a hoş geldiniz! Ve evet, tıpkı hatırladığımız gibi! \\n\\n&e&lThe Aether&r, &2&lOverworld&r'ün çok yukarısında uçan bir Gökyüzü Boyutudur (Sky Dimension). Havada süzülen Adalar (Islands) ve yapılar (structures) ve bulutlar (clouds) vardır! Çok ama çok fazla bulut. \\n\\nBurada ayrıca yeni Eşyalar (Items), Yaratıklar (Mobs) ve hatta Zindanlar (Dungeons) bulacaksınız."]
	quest.5825892699A8DCB7.title: "&l&eThe Aether"
	quest.5900ADCC247CD5F9.quest_desc: [
		"&eSilver Dungeon&r, bulunması en kolay Zindandır (Dungeon) çünkü yer üstündedir. \\n\\nVe kocaman Bulutların (Clouds) üzerindedir. \\n\\nVe &eAngelic Stone&r ile yapılmıştır. \\n\\nYunan Mimarisi (Greek Architecture) şeklindedir, bu da gariptir çünkü &eValkyries&r, İskandinav'dır. \\n\\n&e&lValkyrie Queen&r'i bulmak için en üst kata çıkmalı, arkadaki merdiveni bulmalı ve oradan aşağı inmelisiniz. Onunla konuştuktan sonra size, savaşmadan önce 10 &eVictory Medals&r almanızı söyleyecektir."
		"{image:atm:textures/questpics/aether/aether_silver1.png width:200 height:100 align:center}"
	]
	quest.5900ADCC247CD5F9.title: "&eSilver Dungeon"
	quest.5A5D4DFE4175FB42.quest_desc: [
		"&cGold Dungeon&r da yer altında bulunur. \\n\\nBu sefer daha belirgindir çünkü üzeri &eGolden Oak Trees&r ile kaplı devasa bir tümseğin altında doğar (spawns). \\n\\nZindan (Dungeon) oldukça basittir, sadece içinde Patronun (Boss) bulunduğu bir odadan ibarettir."
		"{image:atm:textures/questpics/aether/aether_gold1.png width:200 height:100 align:center}"
	]
	quest.5A5D4DFE4175FB42.title: "&cGold Dungeon"
	quest.5BB5EE00BB4F9691.quest_desc: ["&7Flying Cows&r kanatlı ineklerdir! \\n\\nPek de yeni bir şey değil... \\n\\n5 &4Hearts&r'ı vardır, Raw Beef ve Leather Düşürür (Drop) ve Sağılabilirler (Milked). \\n\\nSadece bunlar, Düşme Hasarı (Fall Damage) almamak için havada süzülürler."]
	quest.5BB5EE00BB4F9691.title: "&7Flying Cow"
	quest.5C6BA6BBEC75EB71.quest_desc: ["&cGold Key&r! \\n\\nHazine Sandığı (Treasure Chest), girişin karşısındaki duvarın arkasında açılır."]
	quest.5C6BA6BBEC75EB71.title: "&cGold Key"
	quest.5F44BF9A1DAE8B99.quest_desc: ["&9Neptune Armor&r 15 Armor Points ve 4 Armor Toughness verir. \\n\\nBu setin tamamı, &9Water&r (Su) içinde daha hızlı yüzmenizi sağlayacaktır! Sadece bu kadar."]
	quest.5F44BF9A1DAE8B99.title: "&9Neptune Armor"
	quest.6149E5F1F9CF8DC6.quest_desc: ["Phyg! (Hâlâ pig -domuz- diye mi okunuyor?). \\n\\nDomuzlar (Pigs) uçtuğunda tam da şimdi! Artık Domuzların Kanatları var. Bu sayede Düşme Hasarından (Fall Damage) kaçınmak için Tavuklar (Chickens) gibi süzülürler. \\n\\n5 Hearts'a sahiptirler ve Ölümde (Death) Raw Porkchops ve Feathers Düşürürler (Drop)."]
	quest.6149E5F1F9CF8DC6.title: "&dPhyg"
	quest.6188A57F52F29D33.quest_desc: ["Hiç Terraria oynadın mı? Life Crystals'i hatırlıyor musun? Bunlar da oldukça benzer çalışır. \\n\\nBir &cLife Shard&r kullandığınızda fazladan bir &4Heart&r (Kalp) kazanırsınız! \\n\\nMaksimum &4Hearts&r miktarının ne kadar olduğunu bilmiyorum... öğrendiğinde bana da haber ver!"]
	quest.6188A57F52F29D33.title: "&cLife Shard"
	quest.63D4621C06BA747C.quest_desc: ["Wood Weapons ile aynı Hasar (Damage) ancak &2Skyroot&r Çifte Droplar (Double Drops) verir. \\n\\n&2Skyroot Sword&r Yaratıklardan (Mobs) iki kat Drop (Ganimet) verecek ve &2Skyroot Axe&r, &2Trees&r'dan (Ağaçlardan) iki kat Logs (Kütük) verecektir."]
	quest.63D4621C06BA747C.title: "&2Skyroot&r Weapons"
	quest.6797E67E0136D96A.quest_desc: ["&7Holystone&r her yerdedir. O, &e&lThe Aether&r'ın Taşıdır (Stone). \\n\\nBunu Kazmak (Mine) için bir Pickaxe'e (Kazma) ihtiyacınız olacak ve ondan Tools veya Bloklar (Blocks) yapabilirsiniz."]
	quest.6797E67E0136D96A.title: "&7Holystone"
	quest.6B3328B6AE8704D2.quest_desc: ["&bLightning Knives&r, vurdukları her yere (Hit) Lightning (Yıldırım) çağıracak olan fırlatılabilir mermilerdir! \\n\\nAncak fırlatıldıklarında tükenirler, bu yüzden onları akıllıca kullanın."]
	quest.6B3328B6AE8704D2.title: "&bLightning Knife"
	quest.6C8766679D0AA8F6.quest_desc: ["Bu Silah (Weapon); Pigs, Piglins, ve Zombified Piglins'e 1 Vuruşta (Hit) öldürür. \\n\\nHoglins ve Zoglins'e 2 Vuruş. \\n\\nPiglin Brutes'a 3 Vuruş."]
	quest.6C8766679D0AA8F6.title: "&dPig Slayer"
	quest.6D2425DAEA1FC211.quest_desc: ["&cSun Altar&r, &e&lThe Aether&r'ın zamanını değiştirebilir. \\n\\nEvet, &l&eThe Aether&r'da Gece/Gündüz Döngüsü (Daylight Cycle) olmamasına rağmen, bu küçük Blok onu değiştirebilir. \\n\\nİstediğiniz zaman dilimine kaydırmanız yeterli! \\n\\nEğer Gece Vakti (Nighttime) yaparsanız, bir Doğma Noktası (Respawn Point) ayarlamak için &l&eThe Aether&r'da bir Bed (Yatak) kullanabilirsiniz."]
	quest.6D2425DAEA1FC211.title: "&cSun Altar"
	quest.705AEEDA95C52C99.quest_desc: ["&b&lFreezer&r tıpkı adından da anlaşılacağı gibi, belirli nesneleri &bDondurur (Freezes)&r. \\n\\n&9Water &fyerine &bIce&f, &bIce &fyerine &bPacked Ice&f, &bPacked Ice &fyerine &9Blue Ice&r ve &cLava &fyerine &5Obsidian&r yapar. \\n\\nAyrıca Ice Rings ve Pendants da var! \\n\\n&b&lFreezer&r Yakıt (Fuel) olarak Icestone kullanır."]
	quest.705AEEDA95C52C99.title: "&b&lFreezer"
	quest.714960DF26EFFA53.quest_desc: ["Tüm &5Tools&r, Durability kaybettiklerinde Blokları (Blocks) daha hızlı Kazar (Mine). \\n\\nAyrıca &5Pickaxe&r ile &dGravitite&r Kazılabilir (Mine)."]
	quest.714960DF26EFFA53.title: "&5Zanite&r Tools"
	quest.72133DD1B3237493.quest_desc: ["&4Vampire Blade&r, Lifesteel (Can Çalma) özelliğine sahiptir. \\n\\nHasar Verdiğinizde (Dealing Damage) karşılığında &4Hearts&r'ınızın (Kalpler) küçük bir miktarını İyileştirirsiniz (Heal)!"]
	quest.72133DD1B3237493.title: "&4Vampire Blade"
	quest.7597D3D06E761759.quest_desc: ["&eValkyrie Lance&r, devasa Uzanma (Reach) mesafesine sahip bir Yakın Dövüş (Melee) Silahıdır! \\n\\nTam 10 Blok (Blocks)!"]
	quest.7597D3D06E761759.title: "&eValkyrie Lance"
	quest.75C5BFAEADEB486E.quest_desc: ["&eValkyrie Armor&r, &cNetherite Armor&r ile aynı İstatistiklere (Stats) sahiptir. \\n\\nAsıl eğlenceli kısım, hepsini aynı anda giydiğinizde başlar: Helmet, Chestplate, Leggings, Boots ve Gloves. \\n\\nBu 5 parçanın hepsini giydiğinizde Uçmak (Fly) için Space'e basılı tutabilirsiniz! Sadece kısa bir süreliğine olsa da."]
	quest.75C5BFAEADEB486E.title: "&eValkyrie Armor"
	quest.765F6A5A9779CF6D.quest_desc: ["Aerclouds, &l&eThe Aether&r'ın her yerinde doğar (spawn). Yani o bir gökyüzü Boyutu (Dimension), bu oldukça beklenen bir şey. \\n\\nCold Aerclouds ve &eGolden Aerclouds&r aynı şekilde çalışır. İçlerine hafifçe batarsınız. &6Honey&r gibi, sadece daha az Yapışkan (Sticky). Ayrıca Düşme Hasarını (Fall Damage) emerler. \\n\\n&bBlue Aerclouds&r ise farklıdır. Eğer ondan zıplarsanız, gökyüzüne yükseklere fırlatılırsınız. Shift'e bastığınızda içlerinden tamamen aşağı doğru batarsınız. \\n\\nAerclouds'u her yerden toplayabilirsiniz. Ayrıca &eGolden Aerclouds&r yapmak için Cold Aerclouds'a &5Enchant&r basabilir veya &bBlue Aerclouds&r yapmak için Cold Aerclouds'u &bDondurabilirsiniz (Freeze)&r."]
	quest.765F6A5A9779CF6D.title: "Aerclouds"
	quest.769B23E692CBA16B.quest_desc: ["Bunlar normal Buckets ve Boats gibi davranır. \\n\\nSadece &l&eThe Aether&r'dan!"]
	quest.769B23E692CBA16B.title: "&2Skyroot&r Boat and Bucket"
	quest.78AAFE5AF04A13AC.quest_desc: ["&bAerbunnys&r havada oradan oraya zıplarlar. Yapabilseydiniz siz de yapardınız! \\n\\nSadece 3 &4Hearts&r ile Pasiftirler. \\n\\nEğer birini Öldürecek (Kill) kadar kötüyseniz, String Düşürürler (Drop)."]
	quest.78AAFE5AF04A13AC.title: "&bAerbunny"
	quest.78BD3D4FBA42D3DC.quest_desc: ["Sheepuffs, Aether'da bulunan aptal küçük hayvanlardır. \\n\\nNormal Sheeps (Koyunlar) gibi görünürler ancak bazen rastgele havaya fırlarlar ve yavaşça aşağı düşerler. Nedenini bilmiyorum, belki de eğlenceli olduğundandır! \\n\\nBazen Sheepuffs fazladan Wool (Yün) ile kabarır, bunlar arka arkaya iki kez Kırkılabilir (Sheared)! \\n\\n4 Hearts'a sahiptirler ve Raw Mutton ile Wool Düşürürler (Drop)."]
	quest.78BD3D4FBA42D3DC.title: "Sheepuff"
	quest.79A1A63BCE7A541B.quest_desc: ["&bInvisibility Cloak&r sizi Görünmez (Invisible) yapacaktır. Adı ve Popüler Kültürün önerdiği gibi! \\n\\nYaratıklar (Mobs), siz onlara çok yaklaşmadığınız veya Vurmadığınız (Hit) sürece, Görünmezken sizi görmeyecektir."]
	quest.79A1A63BCE7A541B.title: "&bInvisibility Cloak"
	quest.7A4B51313FB134EA.quest_desc: ["&6Phoenix Armor&r, toplamda &cNetherite&r ile aynı olan 20 Armor Points ve 8 Toughness verecektir. \\n\\nYalnızca &6Phoenix Armor&r aslında Ateş Koruması (Fire Protection) sağlar, onu giydiğinizde &cFire &fveya &cLava&r'dan Hasar (Damage) almazsınız! \\n\\nOnunla &9Water&r'a (Suya) girerken dikkatli olun yoksa sonunuz şöyle olabilir..."]
	quest.7A4B51313FB134EA.title: "&6Phoenix Armor"
	quest.7AD4ED72AC31D912.quest_desc: ["&3Aerwhales&r; &l&eThe Aether&r'daki devasa, hızlı, uçan, Pasif (Passive) Yaratıklardır (Mobs). \\n\\nÖlümde hiçbir şey Düşürmezler (Drop), sadece güzellerdir."]
	quest.7AD4ED72AC31D912.title: "&3Aerwhale"
	quest.7BFB4DA68A7912E5.quest_desc: ["Ambrosium, &e&lThe Aether&r'ın Kömürüdür (Coal). \\n\\nOndan Torches yapabiliriz veya onu Furnace Yakıtı (Fuel) olarak kullanabiliriz! \\n\\nAyrıca ona Enchant basmak için onu Aether Grass üzerinde de kullanabilirsiniz."]
	quest.7BFB4DA68A7912E5.title: "&eAmbrosium"
	quest.7D7BB45D84A4E94A.quest_desc: ["&3Swet Cape&r giyildiğinde, &9Swets&r Dostane (Friendly) hale gelecektir! \\n\\nArtık yakalanmak yerine onları güvenle sürebilirsiniz. \\n\\nSizi öldürmeye çalışmadıklarında çok daha az Düşme Hasarı (Fall Damage) alırlar."]
	quest.7D7BB45D84A4E94A.title: "&3Swet Cape"
