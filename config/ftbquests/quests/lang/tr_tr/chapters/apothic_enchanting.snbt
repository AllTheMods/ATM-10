{
	chapter.12AD9789D962B179.title: "Apothic Büyüleme"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.001A348054127235.quest_desc: ["&5Tomurcuklanan Ametist&r, üretim tariflerinde ve hatta sadece &5Ametist&r yetiştirmek için oldukça faydalıdır! \\n\\nBir &5Ametist Bloğunu&r &a60 Eterna&r, &c%30-%50 Quanta&r ve &5%50 Arkana&r değerleriyle &d&lİnfüze ederek&r elde edebilirsin. \\n\\nBu değerleri yakalamak için 10 &9Derin Kitaplık&r (&9Uyuyan&r olanlar değil), 2 &2Karpuz Kitaplığı&r ve 7 &7Temel Kitaplık&r kullanabilirsin.\\n\\nEğer &bDeniz Kitaplıkları&r yolunu seçtiysen 11 &bKristal Deniz Kitaplığı&r ve 1 &bAşılama Yapılmış Deniz Kitaplığı&r da işini görecektir."]
	quest.001A348054127235.title: "&5Tomurcuklanan Ametist&r Üretimi"
	quest.0518551637F76C50.quest_desc: ["&9Yankılanan&r geliştirmesi için birkaç farklı eşyaya ihtiyacın olacak. \\n\\nToplaması oldukça kolay olan Mumlar ve elde etmesi kesinlikle kolay olmayan &9Yankı Parçaları&r... \\n\\nParçaları bulmanın en iyi yolu bir &6Antik Şehri&r yağmalamaktır; ancak onları çeşitli ritüellerle de üretebilirsin. \\n\\n(Hatta ileride &5Efsunlama&r ile de!) \\n\\n&9Yankılanan Derin Kitaplıklar&r, &5%15&r ekstra &5Arkana&r sağlamanın yanı sıra maksimum &aEterna&r sınırını da &a75&r'e çıkarır!"]
	quest.0518551637F76C50.title: "&9Yankılanan Derin Kitaplık"
	quest.06F70F6CA37168CC.quest_desc: ["&6&oHouse Fabergé Cevher Kutusu&r, gelişmiş bir &5Cevher Kutusu&r sürümüdür. \\n\\nÇok daha yüksek miktarda &aCevher&r depolayabilir.\\n\\nStandart &5Cevher Kutusu&r toplam 32.768 adet tutabilirken, &6&oHouse Fabergé Cevher Kutusu&r her bir farklı &aCevher&r türünden 2,1 milyara kadar saklayabilir! \\n\\nBunu elde etmek için standart &5Cevher Kutusu&r'nu &d&lİnfüze&r etmen gerekecek. \\n\\nGerekli dizilim: 4 &9Ruh Dokunuşlu Sculk Kitaplığı&f, 4 &9Yankılanan Sculk Kitaplığı&f, 2 &dEjderhamsı End Kitaplığı&f, 7 &7Taş Kitaplığı&r ve 1 &7Temel Kitaplık&r."]
	quest.06F70F6CA37168CC.quest_subtitle: "Gustav Fabergé gurur duyardı"
	quest.06F70F6CA37168CC.title: "&6&oHouse Fabergé Cevher Kutusu"
	quest.091957223C32B094.quest_desc: ["Bu aşamada &aMaks Eterna&r sınırını tekrar artırman gerekecek. &e&lYükseliş&r &lDünya Kademesi&r ile bu sınır &a60&r seviyesine yükselir."]
	quest.091957223C32B094.quest_subtitle: "Maks Eterna: 60"
	quest.091957223C32B094.title: "60'a &e&lYükseliş&r"
	quest.097FDC136BC843A7.quest_desc: ["&lDünya Kademesi: &6Doruk&r kademesine geçmek için &eZırh&r ve &eAlet/Silah&r donanımını &aSıra Dışı&r seviyesinden &9Nadir&r (veya daha üstü) seviyesine yükseltmelisin! Ayrıca &0&lWither&r'ı katletmen gerekecek. \n\n&0&lWither&r'ın bir &4İstilacı&r olması şart değil; hatta normal olması işini oldukça kolaylaştırır. \n\n&6&lDoruk&r kademesinde &5Destansı&r &eEşyalar&f ve &2Cevherler&r en yaygın düşenler haline gelir. Ayrıca &eEşyalarda&r &6Mistik&r, &aCevherlerde&r ise &zKusursuz&r kaliteleri bulmaya başlayabilirsin. Tabii ikisi de hâlâ oldukça nadirdir! \n\nBu kademede %75 Ekstra Tecrübe, %50 Şans bonusu ve &a75 Maks Eterna&r sınırı kazanırsın. \n\nBuna karşılık &4Yaratıklar&r da 12 zırh puanı, 10 zırh sertliği, 15 zırh delme ve 10 koruma delme bonusu kazanarak güçlenir. \n\nBana mı öyle geliyor yoksa onların güçlendirmeleri bizimkilerden daha mı iyi?"]
	quest.097FDC136BC843A7.title: "&lDünya Kademesi: &6Doruk"
	quest.0A3C464EF7CDD5F6.quest_desc: [
		"&4Cehennem Kitaplıkları&r &cQuanta&r değerine ilk adımındır; raf başına &c%3 Quanta&r ve &a3 Eterna&r verirler. \\n\\nNormal kitaplıklardan çok daha iyi, değil mi? \\n\\nBir sonraki adım için toplam 16 adet gerekecek: 15 tanesini &5Büyü Masası&r etrafına dizeceksin, 1 tanesini ise envanterinde tutacaksın. \\n\\nİlk 11 tanesini ürettiğinde son 5 &4Cehennem Kitaplığı&r benden ödül!"
		"{image:atm:textures/questpics/apothic/enchant_hellshelf.png width:100 height:100 align:center}"
	]
	quest.0A3C464EF7CDD5F6.title: "&4Cehennem Kitaplıkları"
	quest.0F3A0A4DC18E5E55.quest_desc: ["&aEterna&r, basabileceğin &5Efsunların&r kalitesini ve seviyesini doğrudan belirleyen &5Efsun Seviyesi&r değerini oluşturur! \\n\\nBaşlangıç değeri &a0&r olup üst sınırı mevcut &lDünya Kademen&r belirler:\\n\\n&9&lSığınak&r kademesinde &a30&r.\\n&2&lSınır&r kademesinde &a45&r.\\n&e&lYükseliş&r kademesinde &a60&r.\\n&6&lDoruk&r kademesinde &a75&r.\\n&4&lZirve&r kademesinde &a100&r.\\n\\n&lDünya Kademeleri&r hakkında ayrıntılı bilgi için Apotheosis Ekipmanları bölümüne veya bu görev zincirindeki bağlantılı görevlere bakabilirsin.\\n\\nNeredeyse tüm &7Kitaplıklar&r &aEterna&r sağlar ancak her raf türünün ulaşabileceği belirli bir tavan sınır vardır."]
	quest.0F3A0A4DC18E5E55.title: "&aEterna"
	quest.105442DA79829777.quest_desc: ["8 &7Kitap&r ve bir örs kullanarak &8Hurda Kitabı&r üretebilirsin. (Daha doğrusu 8 adet çıkar!)\\n\\nBir eşyayı örste bu &8Kitap&r ile birleştirdiğinde eşya üzerindeki &5Efsunların&r yarısını kitaba aktarabilirsin. \\n\\nAncak dikkat: İşlem bittiğinde eşya kırılıp yok olur! Değerli eşyaların için bunu kullanmanı pek önermeyiz; bunun yerine gelişmiş versiyonlarına odaklanmalısın."]
	quest.105442DA79829777.quest_subtitle: "Efsunların Yarısı, Eşyayı Kırar"
	quest.105442DA79829777.title: "&8Hurda Kitabı"
	quest.1113BF457DB7F1DE.quest_desc: ["Bu adım ana raf gelişimi için zorunlu olmasa da belirli &d&lİnfüzyonlar&r için gereklidir.\\n\\nSondan bir önceki &lDünya Kademesi&r olan &6&lDoruk&r, &aMaks Eterna&r sınırını &a75&r'e yükseltir."]
	quest.1113BF457DB7F1DE.quest_subtitle: "Maks Eterna: 75"
	quest.1113BF457DB7F1DE.title: "&6&lDoruk&r Kademesine Ulaşmak"
	quest.148A33CC36B2563A.quest_desc: ["&dEjderhamsı End Kitaplığı&r, kusursuz bir efsunlama düzeni için ihtiyaç duyacağın son raf türüdür. \n\nSadece &aEterna&r veriyor gibi görünse de &a100&r gibi devasa bir &aEterna&r tavan sınırına sahiptir! \n\nBunu üretmek için 5 &3Ender İncisi&r ve 1 &dEjderha Kafası&r gerekecek. Onu &dDraconic&r yapan da tam olarak budur! \n\nBunları &a&lMA&r ile üretebilir veya &d&lEnd&r boyutundaki yapılar olan &dEnd Gemilerinde&r bulabilirsin; &dEjderha Kafası&r geminin ön tarafında (pruvasında) yer alır."]
	quest.148A33CC36B2563A.title: "&dEjderhamsı End Kitaplığı"
	quest.158F872A3A2C3650.quest_desc: ["Maksimum &a80 Eterna&r sınırına ulaştığımıza göre artık &dEjderha Nefesi&r &d&lİnfüze etmeye&r başlayabiliriz! \\n\\n&dEjderha Nefesi&r, &d&lEnder Ejderhası&r ile savaşırken elde edilir. Ejderha yuvasına konduğunda mor/pembe bir sis püskürtür. Sis bulutunun içindeyken boş bir şişeyle sağ tıklayarak nefesi toplayabilirsin! \\n\\nGerekli değerleri yakalamak için en iyi dizilim: 4 &9Yankılanan Sculk Kitaplığı&r, 4 &9Ruh Dokunuşlu Sculk Kitaplığı&r ve 6 &6Denge'nin Jeotla Kaplı Kitaplığı&r. \\n\\nBu dizilim sana &a80 Eterna&r, &c%25 Quanta&r ve &5%100 Arkana&r sağlar. İnfüzyon için tam ideal oranlar!"]
	quest.158F872A3A2C3650.title: "&dAşılama Yapılmış Ejderha Nefesi"
	quest.1617C1935F22FBD1.quest_desc: ["&aEterna&r sınırını &a100&r seviyesine çıkardığına göre artık &6Tanrı Dövmesi İncileri&r &d&lİnfüze etmeye&r geçebilirsin!\\n\\n&6Tanrı Dövmesi İnciler&r, &c&lKurtarma Masasında&r &6Mistik&r nadirlikteki &eEşyaları&r sökerek elde edilir.\\n\\nİnfüzyon için gereken değerler: &a100 Eterna&r, &c%9,65-%11,00 Quanta&r ve &5%58,75-%60,0 Arkana&r.\\n\\nBu değerleri yakalamak için 1 &dEjderhamsı End Kitaplığı&r, 6 &6Denge'nin Jeotla Kaplı Kitaplığı&r, 1 &9Yankılanan Sculk Kitaplığı&r, 5 &9Ruh Dokunuşlu Sculk Kitaplığı&r, 1 &7Taş Kitaplığı&r ve 1 Mum kullanabilirsin."]
	quest.1617C1935F22FBD1.quest_subtitle: "Bu gidişle HER ŞEYİ infüze edeceğiz"
	quest.1617C1935F22FBD1.title: "&6Tanrı Dövmesi İnci"
	quest.1873205CF5247E3E.quest_desc: [
		"Kitaplık serisinin son ve en etkileyici üyelerinden biri: &dEnd Kitaplıkları&r! \n\nBu raflar 6 &eEnd Taşı Tuğlası&r, 1 &3Ender İncisi&r, 1 &7Kitaplık&r ve elbette &dAşılama Yapılmış Ejderha Nefesi&r birleşimiyle üretilir. \n\nVerdikleri taban değerler muazzam görünmeyebilir (her bir istatistik için sadece 5 verirler), ancak sundukları &a90&r &aEterna&r tavan sınırı olağanüstüdür! \n\nAyrıca daha da üst seviye raflara dönüştürülmek üzere tariflerde malzeme olarak kullanılırlar."
		"{image:atm:textures/questpics/apothic/enchant_endshelf.png width:100 height:100 align:center}"
	]
	quest.1873205CF5247E3E.title: "&dEnd Kitaplıkları"
	quest.18AA64DF63F68762.quest_desc: ["Bu, bu bölümdeki son kilit aşamasıdır."]
	quest.18AA64DF63F68762.title: "Bir Kilit Daha"
	quest.191A7F3C9FBA4C13.quest_desc: ["&bAşılama Yapılmış Deniz Kitaplıkları&r ile &bPrizmarin Kristalleri&r birleştirilerek &bKristal Deniz Kitaplıkları&r üretilebilir. \\n\\n&bKristal Deniz Kitaplıkları&r aynı şekilde &a5 Eterna&r ve &5%5 Arkana&r sağlarken bunlara ek olarak &c%3 Quanta&r kazandırır. \\n\\nBu raflardan 12 tane dizdiğinde, &9Uyuyan Derin Kitaplıkları&r işleyip normal &9Derin Kitaplıklara&r &d&lİnfüze etmek&r için gereken değerlere ulaşırsın!"]
	quest.191A7F3C9FBA4C13.title: "&bKristal Deniz Kitaplığı"
	quest.196312DF0D2E2CB6.quest_desc: ["&4İstilacılar&r, &6&lApotheosis&r modundaki özel &4Patron&r yaratıklardır. \\n\\nHerhangi bir boyutta kendiliğinden doğabilen, özel efektlerle güçlendirilmiş ve üzerlerinde özel &eEfsunlu/Ekli Ekipmanlar&r taşıyan yaratıklardır. \\n\\nNormal yaratıklara göre çok daha fazla cana, hasara ve yardımcı etkiye sahiptirler! Katledildiklerinde özel &eEkli Ekipmanlar&f ve &aCevherler&r düşürürler. \\n\\nNadirlikleri &6&lApotheosis&r seviye sistemine dayanır. Yaratığın nadirliği, üzerindeki teçhizatı ve istatistik bonuslarını belirler. \\n\\nBu nadirlik dağılımı ise mevcut &lDünya Kademene&r bağlıdır! Dünya Kademeleri bulabileceğin ganimetlerin ve karşına çıkacak patronların kalitesini belirler. \\n\\n&lDünya Kademesi&r menüsünü açmak için Ctrl + T tuş kombinasyonunu kullanabilirsin."]
	quest.196312DF0D2E2CB6.title: "&4İstilacılar/Patronlar&r ve &lDünya Kademeleri"
	quest.1D1FAA2F86695781.quest_desc: ["&l&2Sınır&r kademesinde eşya nadirlikleri çok kritik değildi ancak &l&eYükseliş&r kademesine geçmek için üzerindeki parçaların en az &aSıra Dışı&r veya daha yüksek kalitede olması gerekir. \\n\\nAyrıca Dünya Kademeni yükseltmek için en az 1 &4İstilacı&r (Apothic Patronu) katletmelisin. Patronun nadirliği fark etmez! \\n\\nBu kademede &eEkli Eşyalar&r &5Destansı&r kaliteye kadar çıkabilir ve &9Nadir&r olanlar daha sık düşmeye başlar. Şansın yaver giderse son derece nadir olan &6Mistik&r &aCevherler&r bile düşürebilirsin! \\n\\nBonuslara gelince: Şans bonusun %30'a, tecrübe bonusun %55'e ve &aMaks Eterna&r sınırın &a60&r seviyesine yükselir. \\n\\nBuna karşılık &4Yaratıklar&r da fazladan 8 zırh puanı ve 5 zırh delme kazanır."]
	quest.1D1FAA2F86695781.title: "&lDünya Kademesi: &eYükseliş"
	quest.1F748ACA3976A92F.quest_desc: ["Bu kilit görevi, hem Deniz Kitaplığı hem de Cehennem Kitaplığı yollarını dengelemenin yanı sıra Apotheosis Ekipmanları bölümündeki Sınır Dünya Kademesi görevini tamamlamanı zorunlu kılar."]
	quest.1F748ACA3976A92F.title: "Gereksinim Geçidi"
	quest.1FAFDB20F504688E.quest_desc: ["&5Efsunlama&r sistemi &5&lApotheosis&r moduyla birlikte köklü bir biçimde değişir. \\n\\nKısacası, sıradan 15 &7Kitaplık&r artık üst düzey efsunlar için kesinlikle yeterli olmayacaktır. \\n\\nYeni raf türleri, özel efsun masaları ve çeşitli infüzyon mekanikleri seni bekliyor. Bu görev dizisi tüm bu sistemleri adım adım kavramana yardımcı olacak!"]
	quest.1FAFDB20F504688E.title: "&5&lApothic Büyüleme"
	quest.224716A537F2FFA0.quest_desc: ["&8Zırh Kitapları&r, doğrudan zırh parçalarına basılabilen &5Efsunları&r hedeflemek için kullanılır. Tüm zırh kitaplarından &5Koruma&f, &5Patlama Koruması&f ve &5Ateş Koruması&r çıkabilir. \\n\\nAyrıca her kitap türü ilgili zırh parçasına özel efsunları verir. Örneğin Çizmeler Kitabı &5Derinlik Yürüyücüsü&r, Miğferler Kitabı ise &5Su Adaptasyonu&r efsunlarını barındırır. \\n\\nDoğrudan &5Koruma&r efsununu hedeflemek istiyorsan en yüksek şansı &8Göğüslükler Kitabı&r sunar!"]
	quest.224716A537F2FFA0.title: "&8Zırh Kitapları"
	quest.235E3C386E8D36A3.quest_desc: [
		"Burası &4Cehennem Kitaplıkları&r ile &bDeniz Kitaplıkları&r yollarının yeniden birleştiği noktadır! \\n\\nİlk olarak bir &9Uyuyan Derin Kitaplık&r üretmelisin. Tarifinde sadece 6 &8Çatlak Derin Kayrak Kiremit&r ve 3 &7Kitap&r kullanılır. \\n\\nArdından masanda &a60 Eterna&r, &c%40 Quanta&r ve &5%40 Arkana&r değerlerini sağlamalısın. Bunu 12 &bKristal Deniz Kitaplığı&r veya 12 &4Parlayan Cehennem Kitaplığı&r ile kolayca yakalayabilirsin. \\n\\nSon olarak &9Uyuyan Derin Kitaplığı&r &d&lİnfüze ederek&r işlevsel bir &9Derin Kitaplık&r elde edebilirsin!"
		"{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"
	]
	quest.235E3C386E8D36A3.title: "&9Derin Kitaplık"
	quest.24391162F4FF0587.quest_desc: ["&5Büyü Masası&r etrafına dizeceğin 15 &bDeniz Kitaplığı&r sayesinde sonuncu &bDeniz Kitaplığını&r &d&lİnfüze edebilirsin&r! \\n\\n&bAşılama Yapılmış Deniz Kitaplıkları&r raf başına 5 &aEterna&r (&a60&r tavan sınırlı) ve &5%5 Arkana&r kazandırır. \\n\\nBu raflar daha gelişmiş raf türlerinin yapımında kullanılır; nihai hedefimiz olan &bKristal Deniz Kitaplığı&r için bunlar gereklidir. \\n\\nİleride 12 adet Kristal Deniz Kitaplığı yapmak için 12 adet &bAşılama Yapılmış Deniz Kitaplığı&r gerekecektir. Sen 8 tane üret, kalan 4 tanesini ödül olarak ben vereceğim!"]
	quest.24391162F4FF0587.title: "&bAşılama Yapılmış Deniz Kitaplığı"
	quest.24C757B8AA6841F6.quest_desc: ["&5&lApotheosis&r geliştiricileri &3Mızrak&r (Trident) bulmanın ne kadar zor olabileceğini bildiklerinden işi kolaylaştırdı! \n\nArtık bir &3Hareketsiz Üçlü Mızrak&r üretip bunu &d&lİnfüze ederek&r gerçek bir &3Mızrak&r elde edebilirsin. \n\nİnfüzyon için gerekenler: &a40 Eterna&r, &c%20-%50 Quanta&r ve en az &5%35 Arkana&r. \n\nBu değerleri 5 &7Temel Kitaplık&r ve 3 &9Yankılanan Sculk Kitaplığı&r ile yakalayabilirsin. \n\nAlternatif olarak &2&lSınır&r kademesinde mızrak yapmak istersen 2 &bKristal Deniz Kitaplığı&r ve 4 &bAşılama Yapılmış Deniz Kitaplığı&r da işini görür."]
	quest.24C757B8AA6841F6.title: "Gerçek Bir &3Mızrak&r Yapımı"
	quest.24FCFF18296ED907.quest_desc: ["&9Derin Kitaplıkları&r üst seviyeye taşımak için infüzyona ihtiyacın yok; doğrudan üretim tariflerini kullanacaksın! \\n\\nGerekli malzemeler: 5 &3Sculk Bloğu&r ve 1 &3Sculk Katalizörü&r. İkisini de &9Karanlık Derinlikler&r biyomunda &5İpeksi Dokunuş&r ile toplayabilirsin. \\n\\nSon malzeme ise &9Muhafız'ın Asma Filizi&r... Bu parça doğrudan &9&lMuhafız&r'dan düşer. Yani evet, Muhafız'ı katletmen gerekecek! \\n\\nTüm malzemeleri topladığında oyundaki en güçlü raflardan birini üretebilirsin: Raf başına &a10 Eterna&r, &c%15 Quanta&r ve &5%10 Arkana&r sağlar. \\n\\nEn harika yanı ise &a80 Eterna&r tavan sınırına sahip olmasıdır!"]
	quest.24FCFF18296ED907.title: "&9Ruh Dokunuşlu Sculk Kitaplığı"
	quest.2A032EC573B5316C.quest_desc: ["&lDünya Kademesi: &2Sınır&r seviyesine geçmek için öncelikle &9&lSığınak&r görevini tamamlamış olman ve belirli &eEkli Eşyalara&r sahip olman gerekir. \\n\\nNeler gerekli? Tam bir &eEkli Zırh seti&r ile birlikte 1 adet &eEkli Alet&f veya &eSilah&r. \\n\\nBu kademede &aSıra Dışı&r nadirlikteki &4İstilacılar&f ve &aCevherler&r ön plana çıkar. Sıralama: &8Yaygın&r, &9Nadir&r ve nadiren &5Destansı&r şeklindedir. \\n\\n&lDünya Kademesi: &2Sınır&r seviyesindeki oyuncu %35 Tecrübe bonusu, %20 Şans bonusu ve toplam &a45 Maks Eterna&r tavan sınırı kazanır! \\n\\nAncak dikkat: Düşman &4Yaratıklar&r da fazladan 4 zırh puanı kazanarak biraz daha dayanıklı hale gelir."]
	quest.2A032EC573B5316C.title: "&lDünya Kademesi: &2Sınır"
	quest.2EC2FA680076C07D.quest_desc: ["&9Derin Kitaplıkları&r &9Yankılanan Sculk Kitaplığına&r dönüştürmek için infüzyon gerekmez; çalışma masasında üretebilirsin! \\n\\nTarif için: 5 &3Sculk Bloğu&r ve 1 &3Sculk Katalizörü&r (Karanlık Derinlikler'de İpeksi Dokunuş ile toplanır) ve 1 &9Muhafız'ın Asma Filizi&r (&9&lMuhafız&r'dan düşer) gerekir. \\n\\nBu raflar sana raf başına &a10 Eterna&r, &c%10 Quanta&r ve &5%15 Arkana&r kazandırır. \\n\\nEn önemlisi de &a80 Eterna&r tavan sınırı sunmasıdır!"]
	quest.2EC2FA680076C07D.title: "&9Yankılanan Sculk Kitaplığı"
	quest.31E7F7464D79F881.quest_desc: ["İnfüzyon işlemi sadece &7Kitaplıklarla&r sınırlı değildir!"]
	quest.31E7F7464D79F881.title: "Diğer &d&lİnfüzyon&r Eşyaları"
	quest.3311B79A8F6C6ADD.quest_desc: ["&6&lKuzgunun Büyü Masası&r, standart &5Büyü Masasının&r son derece güçlü bir üst versiyonudur. Etrafına kitaplık dizmeye gerek kalmadan masanın &aEterna&r, &cQuanta&r ve &5Arkana&r değerlerini doğrudan ayarlamana olanak tanır.\\n\\nBu sayede dilediğin &d&lİnfüzyon&r tarifini zahmetsizce gerçekleştirebilirsin.\\n\\nTarifte kullanılan Kraliyet Cevherleri (Royal Jewels) dünyada keşif yaparken bulunabilir."]
	quest.3311B79A8F6C6ADD.quest_subtitle: "Kuzgun Dedi Ki \"Bir Daha Asla\""
	quest.3311B79A8F6C6ADD.title: "&6&lKuzgunun Büyü Masası"
	quest.377A41499D8218C9.quest_desc: ["İlk kademe olan &lDünya Kademesi: &9Sığınak&r! Açılması ve ulaşılması en kolay kademedir. \\n\\nEtkinleştirmek için elinde herhangi bir &eEkli Eşya&r tutman yeterlidir! Kilit açıldığında kademen otomatik olarak ayarlanır. \\n\\n&lDünya Kademesi: &9Sığınak&r kademesinde &8Yaygın&r kalitede &aEkipman&r ve &aCevherler&r ağırlıktadır. Bazen &aSıra Dışı&r, çok nadiren de &9Nadir&r teçhizatlar düşebilir. \\n\\nBu kademede &aMaks Eterna&r tavan sınırın &a30&r olarak belirlenir. \\n\\nAyrıca bu kademe, tehlikeli &4İstilacıların&r doğal olarak doğmadığı tek güvenli kademedir."]
	quest.377A41499D8218C9.title: "&lDünya Kademesi: &9Sığınak"
	quest.377D6CF86BC1C64F.quest_desc: ["Standart &8Hurda Kitabı&r eşyadaki efsunların yarısını alırken, &8Üstün Hurda Kitabı&r eşyadaki tüm &5Efsunları&r kitaba aktarır! \\n\\nAncak unutma: Her iki kitap da işlem tamamlandığında eşyayı kırarak yok eder. \\n\\nNormal &8Hurda Kitabını&r &8Üstün Hurda Kitabına&r &d&lİnfüze etmek&r için 3 &9Yankılanan Sculk Kitaplığı&r ve 15 &7Temel Kitaplık&r kullanabilirsin.\\n\\nEğer bu kitabı &2&lSınır&r kademesinde infüze etmek istersen 8 &bKristal Deniz Kitaplığı&r da aynı işi görür."]
	quest.377D6CF86BC1C64F.quest_subtitle: "Tüm Efsunlar Alınır, Eşya Kırılır"
	quest.377D6CF86BC1C64F.title: "&8Üstün Hurda Kitabı"
	quest.37E556B4A730E5AA.quest_desc: ["&4Cehennem Kitaplıkları&r veya &bDeniz Kitaplıkları&r koymana rağmen &aEterna&r değerinin &a30&r üzerinde takılı kaldığını fark etmiş olabilirsin. Bunun sebebi &aMaks Eterna&r sınırının &lDünya Kademeleri&r tarafından kısıtlanmasıdır.\\n\\nİlk kademe olan &9&lSığınak&r kademesinde sınır &a30&r, bir sonraki &2&lSınır&r kademesinde ise &a45&r'tir.\\n\\nDetaylı bilgi için Apotheosis Ekipmanları bölümüne veya rehberdeki ilgili görevlere göz atabilirsin."]
	quest.37E556B4A730E5AA.quest_subtitle: "Eterna Neden 30'da Kaldı?"
	quest.37E556B4A730E5AA.title: "&2&lSınır&r Çağırıyor"
	quest.3D31B94CC42BCE43.quest_desc: ["&8Çıkarma Kitabı&r tam aradığımız eşyadır! Eşyaya hiçbir zarar vermeden üzerindeki tüm &5Efsunları&r kitaba aktarır!\\n\\nBunu elde etmek için &8Üstün Hurda Kitabını&r &d&lİnfüze etmen&r gerekir. \\n\\nİnfüzyon için daha önce hazırladığın &9Sculk Kitaplıklarını&r kullanabilirsin."]
	quest.3D31B94CC42BCE43.quest_subtitle: "Tüm Efsunlar Alınır, Eşya Kırılmaz"
	quest.42746659C66CF17F.quest_desc: ["&6&oİskenderiye Kütüphanesi&r, &5Büyü Kütüphanesinin&r en gelişmiş versiyonudur. \\n\\nÇok daha yüksek seviyelerdeki &5Efsunlu Kitapları&r depolayabilir (yine de efsunu o seviyede çıkarabilmek için o seviyede bir kitap eklemiş olman gerekir). \\n\\nAyrıca puan kapasitesi muazzamdır: Normal kütüphane 32.768 puan saklayabilirken &6&oİskenderiye Kütüphanesi&r her efsun türü için 1,1 milyar puan depolayabilir! \\n\\nBunu elde etmek için standart &5Büyü Kütüphanesini&r &d&lİnfüze etmen&r gerekir. \\n\\nGerekli dizilim: 4 &9Ruh Dokunuşlu Sculk Kitaplığı&f, 4 &9Yankılanan Sculk Kitaplığı&f, 1 &dEjderhamsı End Kitaplığı&f, 5 &6Denge'nin Jeotla Kaplı Kitaplığı&r ve 1 İskelet Kafatası."]
	quest.42746659C66CF17F.quest_subtitle: "Roma'nın hiç yanmadığını hayal edin..."
	quest.42746659C66CF17F.title: "&6&oİskenderiye Kütüphanesi"
	quest.43167C59036E79A7.quest_desc: ["&8Madencilerin Kitabı&r madencilik ve kazı işlerinde sana büyük kolaylık sağlar. Basıldığında &5Verimlilik&f, &5Servet&f ve &5İpeksi Dokunuş&r efsunlarını hedefler. \\n\\nBu efsunlar kazma, balta, kürek ve çapa gibi aletlerde geçerlidir. \\n\\n&8Balıkçıların Kitabı&r ise sadece oltaya özel efsunları verir."]
	quest.43167C59036E79A7.title: "&8Alet Kitapları"
	quest.45161821C221EF0B.quest_desc: ["&5Büyü Masası&r etrafına 15 adet &4Cehennem Kitaplığı&r dizdiğinde masan &a45 Eterna&r ve &c%30 Quanta&r değerlerine ulaşır. \\n\\nBu oranlar &4Cehennem Kitaplıklarını&r &d&lİnfüze etmek&r için tam gereken miktardır! \\n\\n&4Aşılama Yapılmış Cehennem Kitaplıkları&r raf başına 5 &aEterna&r (&a60&r tavan sınırlı) ve &c%5 Quanta&r kazandırır. \\n\\nBu rafları diğer malzemelerle birleştirerek gelişmiş raflar üretebilirsin. İleride 12 adet Aşılama Yapılmış Cehennem Kitaplığına ihtiyacımız olacak; ancak benim cömertliğim sayesinde sadece 8 tane üretmen yeterli, gerisini ben vereceğim!"]
	quest.45161821C221EF0B.title: "&4Aşılama Yapılmış Cehennem Kitaplıkları"
	quest.4E895C54651A3CB3.quest_desc: ["Bu özel &8Kitaplar&r, bildiğimiz efsun kitaplarının çok daha işlevsel halleridir! \\n\\nHer biri sıradan kitaplar, çubuklar, &cBlaze Çubukları&f ve &cBlaze Tozu&r birleşimiyle üretilir. \\n\\nBu kitaplar masada efsunlandığında sadece kendi türlerine özel efsun havuzundan efsun çekerler. \\n\\nAyrıca eşyalardaki efsunları sökmek için örste kullanılan &8Hurda Kitapları&r da bu kategoridedir."]
	quest.4E895C54651A3CB3.title: "&8&lEfsun Kitapları"
	quest.4EE6824A970EEB35.quest_desc: ["SpawneRünleri (Spawner Runes), canavar çağırıcılarını özelleştiren eşyaların yapımında kullanılır. Daha güçlü geliştirmeler için İnfüze SpawneRünleri gereklidir.\\n\\nİnfüzyon için en az &a70 Eterna&r, &c%30 Quanta&r ve &5%50 Arkana&r gerekir. \\n\\nBu değerleri elde etmek için şu dizilimlerden birini kullanabilirsin:\\n\\n- 14 &9Derin Kitaplık&r (Uyuyan olmayanlar!)\\n- 12 &4Parlayan Cehennem Kitaplığı&r ve 2 &9Derin Kitaplık&r\\n- 12 &bKristal Deniz Kitaplığı&r ve 2 &9Derin Kitaplık&r"]
	quest.4EE6824A970EEB35.title: "SpawneRünlerini &d&lİnfüze Etmek&r"
	quest.516E66BE01EE5B31.quest_desc: ["&8Silah Kitapları&r kılıç ve baltalara özel &5Efsunları&r sağlar. Kesme ve biçme odaklı &5Keskinlik&f ve &5Ateş Boyutu&r gibi efsunları hedefler. \\n\\n&8Okçuların Kitabı&r ise yay ve arbalet gibi menzilli silahlara özel efsunları sunar: &5Güç&f, &5Delme&f ve &5Vuruk&r gibi!"]
	quest.516E66BE01EE5B31.title: "&8Silah Kitapları"
	quest.51E554305FFEBA1D.quest_desc: ["&4Alevli Cehennem Kitaplıkları&r bir miktar &cQuanta&r ve &aEterna&r sağlasa da infüzyon süreçleri için ekonomik bir tercih sayılmazlar."]
	quest.51E554305FFEBA1D.title: "&4Alevli Cehennem Kitaplığı"
	quest.523DC411241B470A.quest_desc: [
		"&5Büyü Masasındaki&r efsun teklifleri; &aEterna&r, &cQuanta&r ve &5Arkana&r değerlerine göre şekillenir. \\n\\nBir eşyayı masaya koyduğunda arayüzün sağ üst köşesindeki? simgesine tıklayarak olası &5Efsun Havuzunu&r inceleyebilirsin. \\n\\n&cQuanta&r yükseldikçe efsunların rastgelelik aralığı genişler ve zayıf efsun gelme ihtimali artabilir. \\n\\n&6Denge'nin Jeotla Kaplı Kitaplığı&r kullanarak Quanta'nın yarattığı bu olumsuz efsun riskini ortadan kaldırabilirsin."
		"{@pagebreak}"
		"Bunu üretmek için 1 &7Kitaplık&r, 7 Kalsit ve 1 &5Tomurcuklanan Ametist&r gerekir. \\n\\n&5Tomurcuklanan Ametist&r kazmayla (&5İpeksi Dokunuş&r olsa dahi) doğrudan kırılarak toplanamaz. Onu elde etmek için özel bir ritüel veya infüzyon kullanman gerekir!"
	]
	quest.523DC411241B470A.title: "&6Olumsuz Efsunların Kaldırılması"
	quest.586D5DE28EEC8014.quest_desc: ["&cQuanta&r, efsun havuzunun aralığını genişleterek daha çeşitli ve yüksek seviyeli efsunların gelmesini sağlar. \n\nAncak Quanta aleyhine de çalışabilir: Değer yükseldikçe alt seviye veya istenmeyen efsunların çıkma ihtimali de artar. \n\nEskiden &eDüzeltme&r kullanılırdı, ancak artık onun yerine &6Jeot Kaplı Denge Kitaplıklarını&r kullanıyoruz! \n\nVarsayılan &cQuanta&r değeri &c%15&r olup maksimum &c%100&r seviyesine çıkabilir."]
	quest.586D5DE28EEC8014.title: "&cQuanta"
	quest.5C73247A48E72FB3.quest_desc: ["Efsun havuzundan istemediğin belirli bir efsunu tamamen engellemek istiyorsan bu özel &bDeniz Kitaplığını&r düzenine ekleyebilirsin! \\n\\nEngellemek (karaliste) istediğin efsuna sahip &5Efsunlu Kitabı&r bu &bDeniz Kitaplığının&r yuvasına koyman yeterlidir. \\n\\nBöylece masada efsun bastığında o efsun hiçbir eşyada veya kitapta çıkmayacaktır."]
	quest.5C73247A48E72FB3.title: "Havuzdan &5Efsun&r Engelleme"
	quest.5DE45BC0258D1B0B.quest_desc: ["&dİnci Görünümlü End Kitaplığı&r, maliyetine göre oldukça başarılı bir raf seçeneğidir. \\n\\nBir &dEnd Kitaplığının&r 4 &7End Çubuğu&r ve 2 &3Ender İncisi&r ile birleştirilmesiyle üretilir. \\n\\n&a90 Eterna&r tavan sınırı sağlasa da nihai efsunlama düzeni için ilk tercihimiz değildir."]
	quest.5DE45BC0258D1B0B.title: "&dİnci Görünümlü End Kitaplığı"
	quest.60850E717C747A78.quest_desc: ["Hiç Standart Galaktik Alfabeyi öğrenmek için aylarca uğraşıp masadaki sembollerin hiçbir anlam taşımadığını fark ettiğin oldu mu? \\n\\nOlmadı mı? Güzel, çünkü &9Efsun İpuçları&r senin için en iyi tercümandır! \\n\\nHer &9Efsun İpucu&r, efsunu basmadan önce masada hangi efsunların geleceğini bir bir görmeni sağlar."]
	quest.60850E717C747A78.title: "&3Efsun İpuçları"
	quest.61217D80BFF8A858.quest_desc: ["&5Ender Kayışının&r üçüncü ve son aşaması! Kırılmaz dayanıklılığa sahiptir ve yaratıkları doğrudan Spawner'lara (Çağırıcılara) bağlayabilir. \n\nBunun için oldukça zorlu bir &d&lİnfüzyon&r düzeni gerekecektir: En az &a75 Eterna&r, &c%85 Quanta&r ve &5%60-%85 Arkana&r. \n\nBu değerleri 4 &9Ruh Dokunuşlu Sculk Kitaplığı&r, 4 &9Yankılanan Sculk Kitaplığı&r, 3 &7Taş Kitaplığı&r ve 2 &7Temel Kitaplık&r ile yakalayabilirsin. Ha bu arada, infüze edilecek Ender Kayışına bağlanmış bir Cadı getirmeyi unutma!"]
	quest.61217D80BFF8A858.quest_subtitle: "Occultism ile hiçbir ilgisi yok yemin ederim"
	quest.61217D80BFF8A858.title: "&5Occult Ender Kayışı"
	quest.6220EDE42C813C1B.quest_desc: ["&eTılsımlar&r hakkındaki en sinir bozucu şey kırılmalarıdır! Bu kadar güçlü iksir etkilerinin neden dayanıklılık sınırı olmak zorunda ki? \\n\\nNeyse ki &5&lApotheosis&r modunun buna bir çözümü var: &d&lİnfüzyonlar&r! \\n\\nGereksinimler: &a100 Eterna&r, &c%8,5 - %13,5 Quanta&r ve &5%32,5 - %37,5 Arkana&r. \\n\\nBu oranları 10 &4Parlayan Cehennem Kitaplığı&r, 4 &6Denge'nin Jeotla Kaplı Kitaplığı&r, 2 &dEjderhamsı End Kitaplığı&r ve 1 İskelet Kafatası ile yakalayabilirsin! \\n\\nEvet, kafatasları ve özel eşyalar da masaya efsun istatistikleri kazandırabilir!"]
	quest.6220EDE42C813C1B.title: "Kırılmaz &eTılsımlar&r"
	quest.62D39F68DE6E44A4.quest_desc: ["&5Arkana&r son derece kritik bir değerdir; tek seferde basılan &5Efsun&r sayısını artırır ve nadir efsunların çıkma şansını yükseltir. \\n\\nÖrnek vermek gerekirse: Kılıçlarda &5Darbe&r oldukça yaygın bir efsunken &5Ganimet&r çok daha nadirdir. Yüksek Arkana ile Ganimet gibi nadir efsunları yakalamak kolaylaşır. \\n\\n&5Arkana&r taban değeri &5%0&r olup maksimum &5%100&r seviyesine kadar çıkar."]
	quest.62D39F68DE6E44A4.title: "&5Arkana"
	quest.6852BEFDD4DE4E4B.quest_desc: ["&9Ruh Dokunuşlu Derin Kitaplıklar&r, standart Derin Kitaplıkların geliştirilmiş halidir. \\n\\nTarifte 1 &bRuh Feneri&r ve 3 &3Sculk Bloğu&r (&5İpeksi Dokunuş&r ile toplanır) kullanılır. \\n\\nBu raflar raf başına &c%15 Quanta&r kazandırır ve &aEterna&r tavan sınırını &a75&r seviyesine çıkarır!"]
	quest.6852BEFDD4DE4E4B.title: "&9Ruh Dokunuşlu Derin Kitaplık"
	quest.6884E25641A1020C.quest_desc: ["&5Büyü Kütüphanesi&r, efsunlu kitaplarını düzenlemek ve depolamak için mükemmel bir bloktur! \\n\\nÜretimi için 4 &3Ender Sandığı&r, 1 &5Büyü Masası&r ve şu &d&lİnfüze&r raflardan 4 adet gerekir: &4Aşılama Yapılmış Cehennem Kitaplığı&r, &bAşılama Yapılmış Deniz Kitaplığı&r veya &9Derin Kitaplık&r. \\n\\nKullanımı: Envanterindeyken &5Efsunlu Kitaplara&r Shift + sol tıklayarak veya kitapları &9Mavi Yuvaya&r sürükleyerek kütüphaneye aktarabilirsin. \\n\\nEfsunlar alfabetik olarak sıralanır ve puan sistemiyle saklanır. Efsun seviyesi arttıkça gereken puan katlanır: Seviye I = 1 puan, Seviye II = 2 puan, Seviye III = 4 puan, Seviye IV = 8 puan... \\n\\nHer efsun türünden 32.768 puana kadar depolanabilir. İstenen efsuna tıklayarak &6Turuncu Yuvaya&r çıkarabilirsin. Her tıklama kitap seviyesini artırır. \\n\\nFarklı efsun türlerine tıklayarak tek bir kitapta birden fazla efsunu örs mantığıyla birleştirebilirsin. \\n\\nÖnemli kısıtlama: Çıkarabileceğin maksimum efsun seviyesi, kütüphaneye daha önce eklediğin en yüksek seviyeli kitaba bağlıdır. Örneğin kütüphanede 30.000 puanın olsa bile sadece &5Keskinlik III&r eklediysen en fazla Keskinlik III çıkarabilirsin."]
	quest.6884E25641A1020C.title: "&5Büyü Kütüphanesi"
	quest.695889817162EFC7.quest_desc: ["&aTecrübe Puanı (EXP)&r, &5&lApothic Büyüleme&r mekaniklerinin temel yakıtıdır! (Görev ödüllerinde bolca vermemizin sebebi de bu!) \\n\\n&d&lİnfüzyon&r masasını kullanarak &6Bal Şişelerini&r &aEfsun Şişelerine&r dönüştürebilirsin. Bu işlem için 3 farklı infüzyon kademesi bulunur: 1, 8 ve 32 şişelik tarifler! \\n\\n1. Aşama (1 Şişe): Sadece 2 &9Yankılanan Sculk Kitaplığı&r gerektirir. \\n\\n2. Aşama (8 Şişe): 5 &9Yankılanan Sculk Kitaplığı&r ve 1 &9Ruh Dokunuşlu Sculk Kitaplığı&r ister. \\n\\n3. Aşama (32 Şişe): 5 &9Yankılanan Sculk Kitaplığı&f, 3 &9Ruh Dokunuşlu Sculk Kitaplığı&f ve 1 &dEjderhamsı End Kitaplığı&r gerektirir!"]
	quest.695889817162EFC7.title: "&aTecrübe Şişesi&r Üretimi"
	quest.6A07D09831428CB9.quest_desc: [
		"&4&lNether&r tehlikeli geldiyse ve okyanusları keşfetmeyi tercih ediyorsan &bDeniz Kitaplıkları&r tam sana göre! \\n\\n&bDeniz Kitaplıkları&r &5Arkana&r değerine ilk adımdır; raf başına &5%3 Arkana&r ve &a3 Eterna&r sağlarlar. \\n\\nSıradan kitaplıklardan çok daha iyi, değil mi? \\n\\nİnfüzyon adımında toplam 16 taneye ihtiyacın olacak: 15 tanesini masanın etrafına dizeceksin, 1 tanesini infüze edeceksin. \\n\\nCehennem Kitaplıklarında olduğu gibi ekstra raflar benden! Şimdilik sadece 11 tane toplaman yeterli."
		"{image:atm:textures/questpics/apothic/enchant_seashelf.png width:100 height:100 align:center}"
	]
	quest.6A07D09831428CB9.title: "&bDeniz Kitaplıkları"
	quest.6C2C135B9B7B9402.quest_desc: ["&d&lİnfüzyon&r, gelişmiş ve özel eşyalar üretmek için efsun masasının sunduğu özel bir ritüel sistemidir. \\n\\nMasanın &aEterna&r, &cQuanta&r ve &5Arkana&r değerleri belirli bir tarife uyduğunda efsun masasında infüzyon seçeneği belirir. \\n\\n(Gerekli oranları görmek için JEI rehberini inceleyebilir veya bu görevleri takip edebilirsin.)"]
	quest.6C2C135B9B7B9402.title: "&d&lİnfüzyon Mekaniği&r"
	quest.6C57D64518FF22C0.quest_desc: ["Geriye kalan diğer genel &5Efsunlar&r bu &8Diğer Efsun Kitapları&r aracılığıyla hedeflenebilir. \\n\\n&5Kırılmazlık&r gibi genel efsunlar bu gruptadır."]
	quest.6C57D64518FF22C0.title: "&8Diğer Efsun Kitapları"
	quest.70D2C5FAC661E01A.quest_desc: ["&bKalp İşlemeli Deniz Kitaplığı&r, Aşılama Yapılmış Deniz Kitaplığının gelişmiş bir üst versiyonudur. \\n\\nMaliyeti biraz yüksek olsa da bol miktarda &5Arkana&r sağlar! \\n\\nYüksek Arkana gerektiren ileriki infüzyon tariflerinde işini inanılmaz derecede kolaylaştıracaktır."]
	quest.70D2C5FAC661E01A.title: "&bKalp İşlemeli Deniz Kitaplığı"
	quest.73E09ED46A94B812.quest_desc: ["&4&lZirve&r son Dünya Kademesidir. Bu kademeye ulaştığında &aMaks Eterna&r tavan sınırın oyunun en üst noktası olan &a100&r seviyesine çıkar.\\n\\n&8Neyse ki bu sefer kilit/geçit görevi gerekmeyecek.&r"]
	quest.73E09ED46A94B812.quest_subtitle: "Maks Eterna: 100"
	quest.73E09ED46A94B812.title: "Nihayet &4&lZirve&r"
	quest.784466C3813AA506.quest_desc: ["Hiç canlı yaratıkları taşıyıp yakalamak istedin mi? Bunun için Ruh Cevherleri veya Yaratık Yakalayıcılar var tabii...\\n\\nAma şimdilik onları bir kenara bırakıp &5&lApotheosis&r modunun sunduğu seçeneğe odaklanalım: &5Zayıf Ender Kayışı&r, kayış serisinin en ucuz ancak en dayanıksız versiyonudur. Sadece dost pasif hayvanları bağlayabilir ve 8 kullanımdan sonra kırılır."]
	quest.784466C3813AA506.title: "&5Zayıf Ender Kayışı"
	quest.78BFDD3A9B996655.quest_desc: ["&5Zayıf Ender Kayışına&r kıyasla önemli bir geliştirme! Artık düşman yaratıkları da bağlayabilir ve 64 kullanım dayanıklılığa sahiptir. Bunu infüze etmek için en az &a45 Eterna&r, &c%25 Quanta&r ve &5%40 Arkana&r gerekir.\\n\\nBu oranları 9 &bKristal Deniz Kitaplığı&r ile ya da Cehennem yolunu seçtiysen 9 &4Parlayan Cehennem Kitaplığı&r ve 8 Mum (İpucu: Bir bloğa 4 taneye kadar mum yerleştirebilirsin) ile sağlayabilirsin."]
	quest.78BFDD3A9B996655.title: "&5Ender Kayışı"
	quest.78E66F1DE42C747A.quest_desc: ["&9Yankı Parçası&r toplamak oldukça zorlu ve uğraştırıcıdır; üstelik bu raflar için bunlardan bolca gerekecek! Peki daha kolay bir çoğaltma yolu olmasın mı?\\n\\n&d&lİnfüzyon&r ile 1 adet &9Yankı Parçasını&r 4 adede çoğaltabilirsin!\\n\\nGerekli değerler: &a70 Eterna&r, &c%50 Quanta&r ve &5%50 Arkana&r.\\n\\nBu oranlar için şu dizilimlerden birini tercih edebilirsin:\\n\\n- 14 &9Derin Kitaplık&r (Uyuyan olmayanlar!)\\n- 12 &4Parlayan Cehennem Kitaplığı&r ve 2 &9Derin Kitaplık&r\\n- 12 &bKristal Deniz Kitaplığı&r ve 2 &9Derin Kitaplık&r"]
	quest.78E66F1DE42C747A.title: "Sonsuz &9Yankı Parçası&r?"
	quest.78FEDE6FA4845585.quest_desc: ["Bazı özel &d&lİnfüzyonlar&r son derece hassas ve nokta atışı &aEterna&r, &cQuanta&r veya &5Arkana&r oranları gerektirir. \\n\\nİstediğin tam oranı yakalamak için eksiltme yapan özel filtre raflarından faydalanabilirsin. \\n\\nBu rafların her biri ilgili efsun statını belirli bir oranda düşürerek hassas ayar yapmanı sağlar."]
	quest.78FEDE6FA4845585.title: "&4Azaltıcı Raflar&r"
	quest.79AF63E77AD70A93.quest_desc: ["Sıradan &7Kitaplıklar&r bu yolculuğun sonraki adımları için sadece başlangıçtır; kesinlikle son noktası değil! \n\nSadece vanilya &7Kitaplıklar&r kullanarak &aEterna&r değerini en fazla 30 seviyesine çıkarabilirsin. \n\n(Efsun Seviyelerini kısa süre içinde açıklayacağım ama şimdilik sadece bu seviyeleri yükseltmen gerektiğini bil yeter.)\n\n(Temel Kitaplıklar ile vanilya Kitaplıklar tariflerde birbirinin yerine kullanılabilir.)"]
	quest.79AF63E77AD70A93.title: "&2&lVanilya&r Limiti Sadece Başlangıçtır"
	quest.7C758209D06ED0E3.quest_desc: ["&4Aşılama Yapılmış Cehennem Kitaplığını&r &eIşık Taşı&r ile birleştirerek &4Parlayan Cehennem Kitaplığı&r elde edebilirsin. \\n\\nBu raflar aynı &aEterna&r ve &cQuanta&r değerini korurken ek olarak raf başına &5%3 Arkana&r sağlar. \\n\\nBir &9Uyuyan Derin Kitaplığı&f işleyip &9Derin Kitaplığa&r &d&lİnfüze etmek&r için 12 adet raf gerektiğinde bu Arkana bonusu çok işine yarayacaktır!"]
	quest.7C758209D06ED0E3.title: "&4Parlayan Cehennem Kitaplığı"
	quest.7C9D9D1C054874A7.quest_desc: ["Mümkün olan en mükemmel efsun dizilimini mi istiyorsun? Tüm istatistikleri tavan yapmış, en üst seviye ve nadir efsunlarla dolu bir eşya? O halde bu kuruluma ihtiyacın var! \\n\\n1. 5 &9Ruh Dokunuşlu Sculk Kitaplığı&r ve 5 &9Yankılanan Sculk Kitaplığı&r: İhtiyacın olan tüm &cQuanta&r ve &5Arkana&r değerini fazlasıyla karşılar. \\n\\n2. 1 &dEjderhamsı End Kitaplığı&r: &aEterna&r sınırını doğrudan &a100&r tavan noktasına taşır. \\n\\n3. &6Denge'nin Jeotla Kaplı Kitaplığı&r: Yüksek Quanta'nın kötü/zayıf efsun getirme riskini tamamen engeller. \\n\\n4. (İsteğe Bağlı) &6Büyülü Hazine'nin Derin Kitaplığı&r: Normalde masada çıkmayan &5Tamir&r gibi özel hazine efsunlarının da çıkmasını sağlar!"]
	quest.7C9D9D1C054874A7.quest_subtitle: "Kuzgunun Masası Olmadan"
	quest.7C9D9D1C054874A7.title: "&6&lEn İyi Efsunlama Düzeni"
	quest.7EF873DCEB3B9D48.quest_desc: ["Nihai kademe olan &lDünya Kademesi: &4Zirve&r! Bu seviyeye ulaşmak için &d&lEnder Ejderhasını&r katletmiş olmalı ve tamamen &5Destansı&r veya &6Mistik&r nadirlikte &eZırh&f ve &eAlet/Silah&r kuşanmalısın. \\n\\nBu kademede &5Destansı&r ve &6Mistik&r kalitedeki eşyalar ile &aCevherler&r en yaygın düşenler olur; &zKusursuz&r cevher bulma ihtimalin tavan yapar. &8Yaygın&r ve &aSıra Dışı&r kaliteler artık düşmez (zaten kimse onları özlemez!) \\n\\nBonus olarak %125 Ekstra Tecrübe, %100 Şans bonusu ve &a100 Maks Eterna&r sınırı kazanırsın. \\n\\nDüşman &4Yaratıklar&r da son güçlendirmelerini alır: 16 zırh puanı, 20 zırh sertliği, 25 zırh delme ve 20 koruma delme."]
	quest.7EF873DCEB3B9D48.title: "&lDünya Kademesi: &4Zirve"
	quest.7F007C888C23EC42.quest_desc: ["&5Cevher Kutusu&r, topladığın tüm &aApotheosis Cevherlerini&r depolamak için en pratik bloktur! \\n\\nÜretimi için 1 &3Ender Sandığı&r, 1 &5Cevher Kesme Masası&r, 4 Bazalt ve 3 Cam bloğu gerekir. \\n\\nKullanımı: Envanterindeki &aCevherlere&r Shift + sol tıklayarak veya cevherleri &9Mavi Yuvaya&r koyarak kutuya aktarabilirsin. \\n\\nKutu, her bir cevher türü ve saflık derecesi için 32.768 adede kadar depolayabilir (örneğin 32 bin Kusursuz Savaş Lordu Cevheri ve 32 bin Çentikli Savaş Lordu Cevheri aynı anda saklanabilir). İstenen cevhere ve saflığa tıklayarak geri çıkarabilirsin. \\n\\nAyrıca kutu doğrudan bir Cevher Kesme Masası gibi çalışır. Soldaki yuvalara nadirlik malzemeleri ile &9Cevher Tozu&r koyup depolanan cevher türüne tıkladıktan sonra çekiç butonuna tıklayarak 2 alt saflıktaki cevheri bir üst saflığa yükseltebilirsin."]
	quest.7F007C888C23EC42.title: "&5Cevher Kutusu"
	task.3D62C020980A2DEC.title: "Kitaplıklar"
	task.432FCFECDAA542F1.title: "Kitaplıklar"
	task.4644C76CEC129AA4.title: "Kalıcı Tılsımlar"
	task.52C6DC68BF096122.title: "Silah Kitapları"
	task.598F1FCB5B5ED8FC.title: "Alet Kitapları"
	task.5AB4C41B6800D7FA.title: "Zırh Kitapları"
	task.79FB7E7194336B30.title: "Efsun Masaları"
}
