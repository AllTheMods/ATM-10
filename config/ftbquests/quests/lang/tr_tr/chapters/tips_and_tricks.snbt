	task.3DC008A578A93CCF.title: "İpuçları ve Püf Noktaları"
	task.42DA8E971B27ACED.title: "İpuçları Verildi"
	task.4410E4942D7C15E9.title: "Geçitler"
	task.47A1F59A538E3C4B.title: "Building Gadgets"
	task.4AEB792F6A939B3A.title: "TümHaklarıSaklıdır"
	task.58E3131A3EA2661E.title: "Pusulalar"
	task.6038387EA35404CD.title: "Crafting on a Stick"
