{
	chapter.1D42B373285DEF81.chapter_subtitle: ["Ve Productive Metalworks"]
	chapter.1D42B373285DEF81.title: "Silent Gear"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	quest.002D65E4D7E8F62B.title: "Kademe 2 Sınıflandırma Katalizörü"
	quest.036D5767E07005BC.quest_desc: ["&bDökümhane Drenajlarını&r, &7Eriyik Metalleri&r dışarı çıkarmak için kullanacağız. Evet, ne yazık ki ellerimizle veya kovalarla almak için çok sıcak. \\n\\n&c&lDökümhane Musluğunu&r &bDökümhane Drenajına&r bağlayın ve musluğa sağ tıklayarak &7Eriyik Metalleri&r dışarı akıtın. \\n\\nAyrıca, &bDökümhane Drenajına&r bakarak &c&lDökümhane&r içindeki sıvı miktarlarını da görebilirsiniz!"]
	quest.036D5767E07005BC.title: "&c&lDökümhane&r &bDrenajları"
	quest.047F3F99035CE623.quest_subtitle: "Madenleri özlüyorum"
	quest.061A51A0EC13CA0F.quest_desc: ["Artık bir &aDökümhane Kontrolcümüz&r, &bDökümhane Drenajlarımız&r ve &4Dökümhane Tanklarımız&r olduğuna göre birkaç bloğa daha ihtiyacımız var. \\n\\nBirincisi &6Sıvı Isıtma Bobinleri&r. Bunlar &c&lDökümhanenin&r zeminini oluşturacak ve &c&lDökümhaneyi&r ısıtmak için gereklidir. \\n\\nSonuncusu ise &c&lDökümhane Camları&r veya &cAteş Tuğlaları&r. Bunları yapının geri kalanı için kullanacağız! Kelimenin tam anlamıyla yapı taşları. \\n\\n&c&lDökümhanenin&r çerçevesinin inşa edilmesine gerek yoktur, bu nedenle her köşe boş kalabilir; ancak tamamlanması için 4 duvarı ve bir zemini olmalıdır. Eğer eksik bir blok varsa &aDökümhane Kontrolcüsü&r size yerini söyleyecektir. \\n\\n&c&lDökümhane&r; içinde bir &aDökümhane Kontrolcüsü&r ve &6Sıvı Isıtma Bobinleri&r bulunduğu, diğer duvarları da dolu olduğu sürece içten 1x1 kadar küçük olabilir! \\n\\nYine de bu kadar küçük yapmanızı önermem, çünkü &c&lDökümhane&r ne kadar büyük olursa içinde o kadar fazla alan olur! \\n\\n&aDökümhane Kontrolcüsü&r bir ocak gibi aydınlandığında ve &6Sıvı Isıtma Bobinlerinin&r rengi &6turuncuya&r döndüğünde, &c&lDökümhanenin&r inşa edildiğini anlayacaksınız."]
	quest.061A51A0EC13CA0F.title: "&c&lDökümhane&r İnşası"
	quest.083ABBA1C45FF960.quest_subtitle: "Sadece bir Çim Biçme Makinesi"
	quest.0947B4ED95B0267E.quest_desc: ["Eşyaları ve aletleri kaplar.\\n\\nNetherit, harika bir kaplama malzemesidir."]
	quest.0947B4ED95B0267E.quest_subtitle: "Kesinlikle sadece Netherit için değil"
	quest.0D26E5EF6CFCFDBF.quest_desc: ["Hançerden daha yüksek Dayanıklılık, ancak daha düşük hasar ve hız."]
	quest.0D26E5EF6CFCFDBF.quest_subtitle: "Sivri Uçlu"
	quest.0DF4B01CC5B49E4E.quest_desc: ["Bu Döküm Kalıbı ile klasik kılıcı yapabilirsin! Güvenilir hasar ve güvenilir hız."]
	quest.0DF4B01CC5B49E4E.quest_subtitle: "Eski Güvenilir Dost"
	quest.0EF9F10A2178451F.quest_desc: ["&c&lDökümhanenin&r tüm parçaları (Dökümhane Muslukları, Döküm Masaları ve Döküm Kazanları hariç) herhangi bir &zRenge&r boyanabilir. &zRenkler&r bir &c&lDökümhanede&r birbiriyle değiştirilebilir, bu yüzden isterseniz çok renkli &c&lDökümhaneler&r yapabilirsiniz."]
	quest.0EF9F10A2178451F.title: "&zBoyanabilir &c&lDökümhane&r &zParçaları"
	quest.0FEAD3CA2CC4A8B1.title: "Kademe 3 Starlight Şarj Cihazı Katalizör"
	quest.11B0B93D725ABE43.quest_desc: ["Silent Gear ekipmanları, &9Tamir Çantası&r kullanılarak onarılabilir.\\n\\nBir eşyayı onarmak için, Tamir Çantasını bir üretim ızgarasına yerleştir, ardından aleti onarmak için gereken malzemeleri yerleştir. Bu, Tamir Çantasını \"dolduracaktır\".\\n\\nAleti onarmak için, dolu Tamir Çantasını onarmak istediğin aletle bir üretim ızgarasında birleştir."]
	quest.11B0B93D725ABE43.quest_subtitle: "Örs gerekmez"
	quest.158B24939A269D83.quest_desc: ["Tip Upgrade, bir aletin madencilik seviyesini artırmak için kullanılır.\\n\\nÖrneğin: Bir Iron Pickaxe ve 1 Diamond'ın varsa Diamond Tip Upgrade yapıp bunu kazmana takabilirsin. Böylece kazma Obsidian kazabilir ve ayrıca bir istatistik artışı kazanır."]
	quest.158B24939A269D83.quest_subtitle: "3 Elmas bulamadığın zamanlar için"
	quest.2156C00E30424844.quest_desc: ["&4Dökümhane Tankları&r, &c&lDökümhanemize&r sıvı eklemek için yapılmıştır. \\n\\nÇoğunlukla yakıt. \\n\\nÇoğunlukla &cLav&r! \\n\\nGörünüşe göre &c&lDökümhaneye&r gerçek anlamda yakıt sağlamanın tek yollarından biri bu."]
	quest.2156C00E30424844.title: "&l&cDökümhane&r &4Tankları"
	quest.222D08F43B995FED.quest_subtitle: "Dene ve bunu bükmeye çalış"
	quest.22A0A9C81A5C85A1.quest_subtitle: "Her şeyi bir arada tutmak"
	quest.262036FE8E87F50A.quest_subtitle: "3x3 Madencilik"
	quest.26F9DB31A835B69C.quest_desc: ["&nDökümhane&r: &aTamam&r \\n&nDökümhanedeki Eriyik Metal&r: &aTamam&r \\n\\nPeki bunu nasıl çıkaracağız? \\n\\nÖnceki dostumuzu hatırladınız mı? &c&lDökümhane Drenajı&r? Onu yeni dostumuz &c&lDökümhane Musluğu&r ile tanıştırmamız gerekecek. \\n\\n&c&lDökümhane Musluğunu&r &bDökümhane Drenajının&r üzerine yerleştirin, artık &7Eriyik Metali&r içine akıtmak için altına bloklar koyabiliriz... \\n\\nYaklaşık 900 mB &7Eriyik Metali&r tam bir &7Metal Bloğa&r dönüştürecek olan &8Döküm Kazanı&r gibi bloklara. \\n\\nYa da üretmemiz gereken şeyler için kullanacağımız &8Döküm Masasına&r..."]
	quest.26F9DB31A835B69C.title: "Döküm Eşyaları"
	quest.29131C3532610ADF.quest_desc: ["Bu, Starlight Şarj Cihazı için Kademe 2 Sütun Başlığıdır."]
	quest.29131C3532610ADF.title: "Kademe 2 Starlight Şarj Cihazı Sütun Başlığı"
	quest.2BF119DD5D977409.title: "Kademe 2 Starlight Şarj Cihazı Katalizör"
	quest.2EB96FF06627FD9A.quest_desc: ["Salvager, ekipmanları ait oldukları eşyalara dönüştürmene olanak tanır.\\n\\nÖrneğin: Bir adet Diamond Boots koyarsan 4 Diamonds geri alırsın."]
	quest.2EB96FF06627FD9A.quest_subtitle: "(Bazı) Eşyaları parçalara ayırmak!"
	quest.2EB96FF06627FD9A.title: "Salvager"
	quest.3722B43822F80470.quest_desc: ["Kılıçtan daha fazla hasar verir ama daha yavaş."]
	quest.3722B43822F80470.quest_subtitle: "İçindeki Samurayı Serbest Bırak"
	quest.3930404D5C8B44EB.quest_desc: ["Bu, özel alaşımlar oluşturmak için kullanılır.\\n\\nAyrıca Tyrian Çeliği'ni elde etmenin tek yolu da bu!"]
	quest.3930404D5C8B44EB.quest_subtitle: "Malzemeleri Birleştirir"
	quest.39B85DB54B1037FE.quest_desc: ["Kılıçtan biraz daha hızlı, ama daha düşük hasar."]
	quest.39B85DB54B1037FE.quest_subtitle: "Kalın Kılıç"
	quest.3AC03D1FA5C341A7.quest_desc: ["Recrystallizer; silah, alet ve zırh yapımında kullanmak üzere yeni kristaller yapmak için farklı kristalleri bir araya getirmeni sağlar."]
	quest.3B560B2ECE331CAF.quest_desc: ["Bu, Starlight Şarj Cihazı için Kademe 3 Sütun Başlığıdır."]
	quest.3B560B2ECE331CAF.title: "Kademe 3 Starlight Şarj Cihazı Sütun Başlığı"
	quest.3D2C6FF462B17205.quest_desc: ["Düşük hasar, çok yüksek saldırı hızı. Hedefin yenilmezlik süresini azaltır."]
	quest.3D2C6FF462B17205.quest_subtitle: "Daha da Sivri Uçlu Bıçak"
	quest.3F39BEB788175CEF.quest_subtitle: "3x3 Kazma!"
	quest.405DCD3E36232EEA.quest_desc: ["Kılıçtan daha az hasar verir ama daha uzun menzile sahip."]
	quest.405DCD3E36232EEA.quest_subtitle: "İçindeki Spartalıyı Serbest Bırak"
	quest.427516AA3E8C9442.quest_subtitle: "Çok Amaçlı Çapa"
	quest.45899579D9B92D91.quest_desc: ["&aDökümhane Kontrolcüsü&r, &c&lDökümhanenin&r kalbidir. \\n\\nHer &c&lDökümhanede&r en az bir tane bulunmalıdır. \\n\\n&aDökümhane Kontrolcüsünü&r kullanarak &c&lDökümhanenin&r arayüzünü görüntüleyebiliriz. Burada &c&lDökümhanenin&r içindeki sıvı miktarlarını görebiliriz. \\n\\nAyrıca &c&lDökümhaneye&r eşya koyup buradan eşya alabiliriz."]
	quest.45899579D9B92D91.title: "&c&lDökümhane&r &aKontrolcüsü"
	quest.462C1F75A2FB9F02.quest_subtitle: "Willy nerede?"
	quest.48D358470A019E7A.title: "Kademe 1 Starlight Şarj Cihazı Katalizör"
	quest.52CDB46F6CBF007B.quest_subtitle: "Bunu kazıyor musun?"
	quest.63CAD77A4488F2CE.quest_subtitle: "Kazma + Balta + Kürek"
	quest.657B3116A6419420.quest_subtitle: "Kendi Sapın!"
	quest.67216EC5274F08B9.quest_subtitle: "Çobanlar tarafından kullanılır"
	quest.69383DA579901E7E.quest_subtitle: "Sana şunu sormama izin ver"
	quest.6A393C7A24899E3E.quest_desc: ["Bir külçeyi Grader Katalizör ile Grader'a yerleştirmek, malzemeye derece verecektir.\\n\\nDerece ne kadar iyi olursa, malzemeyle ilgili istatistikler de o kadar iyi olur.\\n\\nEn iyi derece \"MAX\"tır."]
	quest.6A393C7A24899E3E.quest_subtitle: "Malzeme Test Cihazı"
	quest.6B78378BC8036227.title: "Kademe 1 Sınıflandırma Katalizörü"
	quest.6BBC440BD0AD0E93.quest_desc: ["Bazıları &9&lSilent Gear&r'ı severken, bazıları da &7&lTinker's Construct&r'ı sever. \\n\\nİkisi arasında seçim yapmak yerine, &9&lSilent Gear&r ve &c&lProductive Metalworks&r'ü kullanarak her ikisinin de en iyi yanlarını birleştirmeye karar verdik! \\n\\n&c&lProductive Metalworks&r, &9&lSilent&r eşyalarımızı elde etme şeklimizi değiştirecek. Artık &9Blueprints&r (Mavi Baskı) kullanmak yerine, &8Casts&r (Kalıplar) ve bir &c&lDökümhane&r'ye ihtiyacımız olacak. \\n\\n&c&lDökümhane&r yapımına başlamak için &cAteş Kili&r ile başlayın."]
	quest.6BBC440BD0AD0E93.title: "&9&lSilent Gear&r ve &c&lProductive Metalworks"
	quest.6BFD7854F078BF16.quest_subtitle: "Şunu Kavra"
	quest.711826BBCA832EE2.quest_desc: ["Tüm &8Kalıplar&r eşit yaratılmıştır. Başka bir deyişle, hepsi aynı şekilde yapılır. \\n\\nBir &8Döküm Masasında&r bir eşyanın üzerine &8Çelik&r dökerek! \\n\\nPeki &8Çeliği&r nasıl yapacağız diye mi soruyorsunuz? Herhangi bir &8Çelik&r eşyayı veya külçeyi eritin. Veya 9 &7Demir&r ile 10 &0Kömürü&r alaşımlayabilirsiniz. \\n\\nAlaşımlama, &c&lDökümhane&r &6ısıtıldığında&r ve içinde doğru miktarlarda farklı &7Eriyik Metaller&r bulunduğunda gerçekleşir. Bu iki &7Eriyik Metal&r birleşerek tek bir &7Eriyik Metale&r dönüşecektir!"]
	quest.711826BBCA832EE2.title: "&8Döküm Kalıpları"
	quest.766C80E5D7B7A916.quest_subtitle: "Birini seç!"
	quest.769D5DE66D13B256.quest_desc: ["Bu görev, AllTheMods Modpack'lerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan veya açık bir izin verilmeyen hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.7C3D763CF22D167A.quest_desc: ["Starlight Şarj Cihazı, \"Star Charged\" büyüsü ile malzemeleri \"büyüleyebilir\".\\n\\nOrtasında Starlight Şarj Cihazı bulunan bir yapı gece gökyüzüne bakacak şekilde inşa edilmelidir. Sadece gece boyunca Starlight Gücü kazanır.\\n\\nŞarj Cihazı, her köşesinde bir Sütun olacak şekilde 7x7'lik bir yapının ortasına yerleştirilmelidir. Her sütunda \"Starlight Şarj Cihazı Başlığı\" bulunmalıdır.\\n\\nAyrıca malzeme başına bir şarj cihazı katalizörü gerektirir."]
	quest.7C3D763CF22D167A.quest_subtitle: "Malzemelerin \"Büyülenmesi\""
