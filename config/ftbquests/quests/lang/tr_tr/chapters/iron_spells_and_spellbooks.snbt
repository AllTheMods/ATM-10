	image.29FABA9C983D1601.title: "Mangrove Hut"
	image.1EE2339CB09FDF9B.title: "Pyromancer Tower"
	quest.3181D07337DEFD14.quest_desc: [
		"Kötü Alamet veya Sınama Alameti etkisine sahipken &4&lThe Dead King&r'i uyandırırsan, &4&lKral&r güçlenir.\\n\\nArtık 1000 &cKalbi&r vardır; daha fazla hasar verir, daha hızlı hareket edip uçar, çağırdığı yaratıklar ek hasar verir ve daha fazla zırha sahip olur. Artık &4Undead Rifts&r açarak onun adına savaşacak &4Undead&r çağırabilir ve ayrıca &aFang Swirl&r büyüsünü kullanabilir.\\n\\nOnu yenince düşen ganimetler de iyileşir. Her zamanki ganimetlerine ek olarak Wicked Bone Ring, bir &aFang Swirl&r parşömeni, Tincture of Forgetfulness, &7Blank Runes&r ve çok daha fazla &bArcane Essence&r düşürebilir."
		"{image:atm:textures/questpics/iron_spells/spells_king_ominous.png width:100 height:200 align:center}"
	]
	quest.3181D07337DEFD14.quest_subtitle: "Yine mi o?"
	quest.3181D07337DEFD14.title: "&lUğursuz Ölü Kral"
	quest.000C1ECD781F3F81.quest_desc: ["&2&lNature&r, düşmanlarımızı &2Zehirleyerek&r ve &2Zayıflatarak&r Dünyayı kendi avantajımıza kullanmak için tasarlanmıştır! Tıpkı Büyük Şirketlerin Dünya'nın kendisine yaptığı gibi! \n&2&lNature's&r Odak Malzemesi &2Poisonous Potato&r'dur. \n\n&2Scrolls&r (Parşömenler), &2Dark Green&r (Koyu Yeşil) metinli &aLight Green&r (Açık Yeşil) renktedir."]
	quest.000C1ECD781F3F81.title: "&2&lNature"
	quest.00D80AA4CDD8335C.quest_desc: ["&6&lPriest&r sizin için yeterince &6Holy&r değil mi? O zaman &6Lightbringer Chestplate&r üretebilirsiniz! \n\nİlk olarak, üretebileceğiniz &6Priest Robes&r'a ihtiyacınız olacak. \n\n&bMithril&r ve Zincirlerden yapılan 3 adet &bMithril Weave&r'e ihtiyacınız olacak. \n\nArdından bir &dDivine Soulshard&r elde etmeniz gerekecek, sonrasında &6Chestplate&r'i üretebilirsiniz. \n\nBu &6Chestplate&r, &6Priest Robes&r ile aynı zırh puanına sahiptir, ancak diğer her şey çok daha iyi hale gelir! \n\nZırh Sertliği, Savurma Direnci ve tabii ki daha fazla &3Spell Power&r (Büyü Gücü) ve Mana kazanırsınız."]
	quest.00D80AA4CDD8335C.title: "&6Lightbringer Chestplate"
	quest.01119871B1D5C576.quest_desc: [
		"Neredeyse her &6Village&r (Köy) içinde &6&lPriest&r (Rahip) barındırabilir. Buna modlu &6Villages&r da dahildir. \n\nGenellikle Pazarların yanında, &6Village&r'ın ortasında takılırlar. Her &6Village&r'da bir tane bulunmaz."
		"{image:atm:textures/questpics/iron_spells/spells_village.png width:200 height:100 align:center}"
	]
	quest.01119871B1D5C576.title: "&6Village"
	quest.0436DF3308681913.quest_desc: [
		"Tahtta geçmiş bir &4&lKing&r\'in kalıntıları yatmaktadır. Ancak yaklaşıp onlara dokunduğunuzda yeniden canlandıklarını göreceksiniz; &4&lKing&r artık ölü değil! Fakat onu sadece cinayet hayatta tutabilir... ve etraftaki en yakın canlı şey sizsiniz. \n\n&4&lThe Dead King&r en zorlu Bosstur, 400 &cHearts&r (&cKalp Sağlığına&r) sahiptir ve gerçek bir Boss Barına (ve müziğe) sahip olan tek bosstur. Herhangi bir sınıftan çeşitli &3Spells&r (Büyüler) kullanabilir, &2Nature&r'dan &2Poison Arrow&r'a, &6Holy&r'den &6Blight&r'a ve hatta &aEvokation&r'dan &aFangs&r'a kadar! Ayrıca ışınlanabilir, ölüleri çağırabilir ve size &4Blood Staff&r ile vurabilir. \n\nEğer onu öldürebilirseniz, her türlü &3Scrolls&r (Parşömen), &7Blank Runes&r düşürür ve muhtemelen &4Blood Staff&r ve Necronomicon da düşürebilir."
		"{image:atm:textures/questpics/iron_spells/spells_king.png width:100 height:200 align:center}"
	]
	quest.0436DF3308681913.title: "&4&lThe Dead King"
	quest.0474C15D3AE3C2C9.quest_desc: ["&cDecrepit Scythe&r, &c&lEcho of Tyros&r'un sizi Öldürmek için kullandığı şeydir. Sadece bizim versiyonumuz çok daha küçüktür. \\n\\n&5Decrepit Flamberge&r'a çok benzer özelliklere sahiptir, sadece biraz, ve birazcık demek istiyorum, daha hızlı Saldırı Hızına sahiptir. \\n\\nAyrıca &6Pyrium&r ile yükseltilebilir, bu ona daha fazla hasar artı bir &3Spell&r (Büyü) verecektir! \\n\\n&cHellrazer&r'ın aldığı &3Spell &cRaise Hell&r'dir. Bu, etrafınızdaki her yöne bir &cFire&r (Ateş) Dalgası gönderecektir. Bu &cFire&r'ı yaymaz ancak yakındaki tüm yaratıklara bir ton hasar verir!"]
	quest.0474C15D3AE3C2C9.title: "&cDecrepit Scythe"
	quest.05DBDD86FCFF3BA8.title: "&5Lightning&r Upgrade Orb"
	quest.06F2C42E6408149E.quest_desc: [
		"Umarım bunu &c&lPyromancer&r'dan çalmamışsındır, o iyi olan!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_pyromancer.png width:50 height:100 align:center}"
	]
	quest.06F2C42E6408149E.title: "&cPyromancer Outfit"
	quest.06F8EDF7513F8611.title: "&dEpic&r Ink"
	quest.08767A1E6D48A5EA.quest_desc: ["&7Graybeard Staff&r çok ucuz bir Asadır. Fiyat ve kalite bakımından ucuzdur. \\n\\nSadece 3 &4Damage&r verir ancak %25 Mana Yenilenmesi ve %10 &3Spell Power&r (Büyü Gücü) verir. \\n\\nÖldürmek için sadece &3Spells&r kullanıyorsanız oldukça yardımcı olur!"]
	quest.08767A1E6D48A5EA.quest_subtitle: "\"Ne zaman Whitebeard (Ak Sakal) olacak?\""
	quest.08767A1E6D48A5EA.title: "&7Graybeard Staff"
	quest.0CE1F6DE5FD6A6D9.title: "&aEvocation&r Upgrade Orb"
	quest.0E594BC58CC7476F.quest_desc: [
		"Kötü olabilir ama yine de modaya uygun giyiniyor. "
		"{image:atm:textures/questpics/iron_spells/spells_outfit_archevoker.png width:60 height:100 align:center}"
	]
	quest.0E594BC58CC7476F.title: "&aArchevoker Outfit"
	quest.0EED5D755D2C866A.quest_desc: ["&d&lEnder&r, &dEnderman&r'lerin ve &dEnder Dragon&r'ın tüm güçlerini alıp tabii ki kendimiz için kullanmak amacıyla kullanılır. &dTeleporting&r (Işınlanma), &dFireballs&r (Ateş Topları) ve &dDragon's Breath&r bunlardan sadece birkaçı! \n\n&d&lEnder's&r Focus Materyali &dEnder Pearls&r (Ender İncileri)'dir. \n\nVe &dScrolls&r (Parşömenleri), &dPink&r metinli &5Purple&r renktedir."]
	quest.0EED5D755D2C866A.title: "&d&lEnder"
	quest.0F8B349EBC9110D6.quest_desc: ["Bunu elde etmek oldukça eğlencelidir! İlk olarak bir &5Lightning Rod&r'un yanı sıra bir &5Energized Core&r'a ihtiyacımız olacak. \n\nSonra, Fırtınalı olduğunda, &5Lightning Rod&r üzerine &5Energized Core&r ile sağ tıklayın. Doğru yapılırsa, &5Lightning&r (Yıldırım) Çarpacaktır. Bu, &5Lightning Rod&r'u &5Rod o' Lightning&r'e dönüştürecektir! \n\nBu Çubuk 5 &4Damage&r verir ve %15 Kullanım Süresi Azaltımını korur. Ancak artık sadece %5 &3Spell Power&r ve &5Lightning Spells&r için %15 &3Spell Power&f verecektir."]
	quest.0F8B349EBC9110D6.title: "&5Rod o' Lightning"
	quest.12498F8B5740F66E.quest_desc: ["&bWizard Gear&r, &lIron's Spells&r için varsayılan Zırhtır! \\n\\nDiğer her Zırh bununla Üretilecek veya ondan Üretilen bir şeyden Üretilecektir! \\n\\nÜretmek için yalnızca &5Arcane Cloths&r gerekecektir. \\n\\nMaksimum Manada büyük bir artış sağlayacak, &bDiamond Armor&r ile aynı zırh puanına sahip olacak ve Büyü Gücü Artışı sağlayacaktır!"]
	quest.12498F8B5740F66E.title: "&bWizard Gear"
	quest.1338EED4F26F3EFF.quest_desc: ["&3Spellbreaker&r, Üretebileceğimiz pahalı ve güçlü bir Silahtır. \\n\\nBunu yapmak için &bWeapon Parts&r, &bDiamonds&f ve 2 &bMithril Ingots&r'a ihtiyacımız olacak. \\n\\n&3Spellbreaker&r 10 &4Hearts of Damage&r (Kalp Hasarı) verir ve bir Kılıçtan biraz daha hızlıdır. \\n\\nAyrıca içinde bir &3Spell&r (Büyü) vardır, &3Counterspell&r. Bir yaratık size karşı bir &3Spell&r kullandığında, onu kullanmalarını engellemek için bunu kullanın!"]
	quest.1338EED4F26F3EFF.title: "&3Spellbreaker"
	quest.13F77C38AC015E9F.quest_desc: [
		"Dağların çok yukarısında, Bulutların çok yukarısında başka bir &bTower&r duruyor. Bu kule insanın tüylerini ürperten cinsten. \n\n&bTower&r Taş, Koyu Meşe ve Derin Kayraktan yapılmıştır. İçinden ayrılan ikinci bir Kulesi vardır. Dışarıda ilk kata çıkan bir merdiven vardır. Oradan yatak odasına veya ikinci kuleye çıkmak için içerideki merdiveni tırmanabilirsiniz. \n\nVeya o merdivenin arkasındaki Merdivenden aşağıya, &b&lCryomancer&r'ın büyük olasılıkla olacağı Bodruma inebilirsiniz. \n\n&bTower&r'da Inscription Tables, Amethyst ve ganimet Sandıkları bulabilirsiniz!"
		"{image:atm:textures/questpics/iron_spells/spells_mountaintower.png width:200 height:100 align:center}"
	]
	quest.13F77C38AC015E9F.title: "&bMountain Tower"
	quest.161477ABCC437BD2.quest_desc: ["&bBoreal Blade&r harika bir Kılıçtır! Hem kişilik hem de sıcaklık açısından. \n\n&bWeapon Parts&r, &bIce&r, &bMithril Ingots&r ve &bIce Venom Vials&r'dan yapılmıştır. \n\n&bIce Venom&r almak için &b&lIce Spider&r Görevine göz atın! \n\nBu Kılıç bir ton hasar verir! Tam 16 &4Kalp Hasarı&r (&4Hearts&r). Ancak sallaması yavaştır, bir Balta ile aynı hızdadır. \n\n&bBoreal Blade&r ile gelen &3Spell&r &bFrostbite&r'dır. Bu başka bir Efekttir... ne işe yaradığından emin değilim."]
	quest.161477ABCC437BD2.title: "&bBoreal Blade"
	quest.19542103E042BDB5.quest_desc: ["{image:atm:textures/questpics/iron_spells/spells_outfit_shadow.png width:60 height:100 align:center}"]
	quest.19542103E042BDB5.title: "&dShadow-Walker Outfit"
	quest.19B057DFF331E41C.quest_desc: ["&4Scarecrow Outfit&r, 3 katı Mana ve daha fazla zırh puanı ile &9Wandering Magician&r'dan biraz daha iyidir. \\n\\nAncak bunu Üretmek için daha fazla Eşyaya ihtiyaç duyulacaktır. \\n\\nArtık &5Essence&r yerine &5Arcane Cloth&r'un yanı sıra &eHay Bales&r ve &6Pumpkins&r'e ihtiyaç duyuyor."]
	quest.19B057DFF331E41C.title: "&4Scarecrow Outfit"
	quest.1A0368CB49B8CBFF.quest_desc: ["Bu &eSpell Book&r, &cBlazes&r'den nadiren düşen bir ganimettir. Bunu hatırlıyorum çünkü &cBlaze&r Farmımdan 1 tane aldığımda kafam karışmıştı. \\n\\n&cFire Spells&r'e Güçlendirme verir ve 10 &3Spell&r Yuvasına sahiptir."]
	quest.1A0368CB49B8CBFF.quest_subtitle: "Sıcak! Sıcak! Sıcak!"
	quest.1A0368CB49B8CBFF.title: "&cBlaze Instruction Manual"
	quest.1BE69992D2C5085B.quest_desc: ["&n&aEvocation:&r\nBir Ruhu veya İlahı çağırmak. \n\n&a&lEvokation&r tamamen &aEvoker&r'ların ne yaptığıyla ilgilidir, esas olarak çağırma. İster &aFangs&r ister &aVexes&r olsun, eğer çağrılırsa büyük olasılıkla bir &aEvokation&r'dır. \n\n&a&lEvokation's&r Focus Materyali &aEmeralds&r (Zümrüt)'dir. Ya Rune'u üretebilir ya da onu &a&lArchevoker&r'dan alabilirsiniz. \n\n&aEvokation Scrolls&r &0Black&r (Siyah) metinli &fWhite&r (Beyaz) renktedir."]
	quest.1BE69992D2C5085B.title: "&a&lEvocation"
	quest.1CAEC4C273EDDB99.quest_desc: ["İşte burada! Şurada! Her yerde ve çürümüş! Bunları çoğu Sandıkta bulabilirsiniz. \\n\\n8 &3Spells&r tutabilirler ancak size daha az Büyü Direnci verirler."]
	quest.1CAEC4C273EDDB99.title: "Rotten Spell Book"
	quest.204B969DA081056A.quest_desc: [
		"Bunlar neredeyse &2Vanilla&r Düşman yaratıkların doğduğu her yerde doğabilir. Boss değiller, sadece daha fazla Düşman! \n\n25 &cKalp&r Puanına sahiptirler ve birden fazla saldırı türleri vardır: &aEvoker&r'ların yaptığı gibi yerden &aFangs&r ve size fırlatabilecekleri bir &bSnowball&r. \n\nAyrıca sizinle savaşmaya yardımcı olmak için Zombiler ve İskeletler de çağırabilirler. Bunlar hiçbir şey düşürmezler ve yerden Zırhla doğarlar. \n\nÖldüklerinde Arcane Essence'in yanı sıra bazen bir &3Scroll&r düşürürler!"
		"{image:atm:textures/questpics/iron_spells/spells_necromancer.png width:100 height:200 align:center}"
	]
	quest.204B969DA081056A.title: "Necromancers"
	quest.24150DE600C2D761.quest_desc: ["Bu tek başına bizi E10'dan Genç derecelendirmesine taşıyor. &4&lBlood&r tamamen kendi &cHealth&r'iniz (Sağlık) için düşmanları öldürmekle ilgilidir! Çoğu saldırı sizi iyileştirecektir. \\n\\n&4&lBlood's&r Focus Materyali, bir Cauldron içinde bir Yaratığı veya oyuncuyu pişirerek elde ettiğiniz &4Blood Vials&r'dır (Kan Şişeleri). \\n\\n&4Scrolls&r (Parşömenleri) &4Dark Red&r (Koyu Kırmızı) metinlerle Kahverengidir (Kahverengi için renk yok)."]
	quest.24150DE600C2D761.title: "&4&lBlood"
	quest.24BAC1C0392E950E.quest_desc: [
		"Duyduğuma göre artık bir tane olmak için çevrimiçi dersler alabiliyormuşsunuz."
		"{image:atm:textures/questpics/iron_spells/spells_outfit_priest.png width:60 height:100 align:center}"
	]
	quest.24BAC1C0392E950E.title: "&6Priest Outfit"
	quest.258B4890CF13D199.quest_desc: ["&aMagehunter&r elde edilmesi çok garip bir Silahtır. Garip derken elde etme yolu çok özeldir. \n\nBunu elde etmek için &aEvoker Fort&r'a gitmeniz gerekecek ve 2. Kattaki &aVindicator&r buna sahip olacak. Elde etmek için onu öldürün. \n\n&aSword&r iyi bir Kılıçtır, normal Kılıç Hızı ile 10 &4Hearts of Damage&r (Kalp Hasarı) verir. \n\nBunu tutarken biraz &3Spell Resistance&r kazanırsınız. Ayrıca bazıları Efsunlarla birlikte gelebilir, benimki öyleydi!"]
	quest.258B4890CF13D199.title: "&aMagehunter"
	quest.25F79B40579B3909.quest_desc: ["&5Decrepit Flamberge&r, &5Ancient Knights&r ve bazı &5Cursed Armor Stands&r için tercih edilen Kılıçtır. \\n\\nBu adamları Öldürerek de onu elde edebiliriz! \\n\\nSanki yapılırken kıpır kıpırmış gibi bir &5Netherite Sword&r'a benziyor. \\n\\n11 &4Hearts of Damage&r (Kalp Hasarı) verir ancak bir Kılıçtan biraz daha yavaştır. \\n\\nSaldırı Hızını artırmak için &6Pyrium&r ile yükseltilebilir."]
	quest.25F79B40579B3909.title: "&5Decrepit Flamberge"
	quest.2664373E8977E7BE.quest_desc: ["Vampirlerden daha iyi &4Blood&r'ı (Kanı) kim bilebilir! Hiç kimse! \\n\\nBu &eSpellbook&r'u yapmak Ruined Book dışında o kadar da zor değil. \\n\\nDiğer Eşyalar sadece &5Arcane Ingots&r ve &4Bloody Vellum&r'dur. &4Bloody Vellum&r, &dHogskin&r'in &4Blood&r ile dolu bir Alchemist Cauldron'a batırılmasıyla yapılır. \\n\\n&eSpellbook&r 10 Büyü Yuvasına sahiptir ve &4Blood Slash&r ile &4Blood Step&r'e fazladan bir Seviye verecektir!"]
	quest.2664373E8977E7BE.title: "&4Vampiric Spellbook"
	quest.27CF1A2587321A2C.quest_desc: ["Hayal edebileceğiniz en iyi &eSpell Book&r! 15 &3Spell&r Yuvası! Gerçekten 15 &3Spells&r var mı?!?! Ah bekle evet var, 15 o kadar da çok değil... \\n\\nÖncekiyle aynı şeyi yapın: önceki Kitap, Ingot (Külçe) ve Şablon."]
	quest.27CF1A2587321A2C.title: "&5Unobtainium&r Spell Book"
	quest.294418130521FDF4.quest_desc: ["&bMithril&r yalnızca &2&lOverworld&r'ün çok aşağılarında oluşan bir Cevherdir. \\n\\nY Seviyeleri -40 ile &8Bedrock&r civarında oluşacaktır. &cLava Pools&r'un (Lav Havuzları) olduğu yerin hemen etrafında! \\n\\nKazmak için bir &5Netherite Pickaxe&r'e ihtiyacınız olacak ve Servet kullanmadığınız sürece yalnızca 1 &bRaw Mithril&r Düşürecektir. \\n\\nBu &bRaw Mithril&r, &bMithril Scraps&r yapmak için Eritilebilir. Bunlar Tariflerde kullanılabilir veya bir &bMithril Ingot&r yapmak için 4 tanesini birleştirebiliriz!"]
	quest.294418130521FDF4.title: "&bMithril Eldesi"
	quest.29605960803BE885.quest_desc: ["&dAmethyst Rapier&r yaptığı işe göre oldukça ucuzdur! \n\nSadece &bWeapon Parts&f, &dAmethyst&r ve Zincirlerden oluşur. \n\n&dAmethyst Rapier&r, &5Netherite Sword&r ile aynı olan 8 &4Hearts of Damage&r (Kalp Hasarı) verir. Sadece bu, 2.3 Saldırı Hızıyla çok daha hızlı savrulur. \n\n&dAmethyst Rapier&r'in özel kısmı, aldığı yerleşik Büyüdür! &dEchoing Strike&r. \n\n&dRapier&r'ı tutarken (V) tuşuna basarak &dEchoing Strike Effect&r elde edersiniz. &dRapier&r ile vurulan herhangi bir yaratıktan bir şok dalgası çıkacaktır. Bu, yakındaki diğer yaratıklara hasar verecektir."]
	quest.29605960803BE885.title: "&dAmethyst Rapier"
	quest.29BDCF3C1B11B4C6.quest_desc: ["&6Pyrium Staff&r en güçlü Asadır... eh, Güç bakımından değil &4Damage&r bakımından. \\n\\n2 &6Pyrium Ingots&r, bir &5Netherite Ingot&r ve &5Arcane Cloth&r gerektirir. \\n\\n&5Netherite Ingots&f ve &5Arcane Cloths&r kolaydır, &6Pyrium&r... pek değil. &cCitadel&r'de 2 Mahzeni Açmanız gerekecek. \\n\\n&6Pyrium Staff&r %5 &3Spell Power&r ve &cFire Spells&r'e %15 verecektir. Ayrıca %10 daha az Kullanım Süresi!"]
	quest.29BDCF3C1B11B4C6.title: "&6Pyrium Staff"
	quest.2A787B99A8B0C767.quest_desc: [
		"Çok önemli bir blok ve çok yaygın bir blok! Üretilebilir veya çoğu &lIron Spells&r Yapısında bulunabilir. \\n\\nBunlar &eSpell Books&r'a &3Scrolls&r (Parşömen) eklemek ve çıkarmak için kullanılır! &eSpell Book&r'u Kitap Yuvasına, ardından &3Scroll&r'u onun altına atın. Bir &3Scroll&r'u çıkarmak isterseniz, ona tıklayın ve sağdan alıp Envanterinize koyun."
		"{image:atm:textures/questpics/iron_spells/spells_table_gui.png width:150 height:100 align:center}"
	]
	quest.2B901ECF97FFA181.quest_desc: ["Ancient Knowledge Parçalarını nihayet birleştirdiğinizde... &9Eldritch Manuscript&r'ı elde edeceksiniz! Son sınıf işte bu! \\n\\n&9Eldritch&r son sınıftır, tüm &3Spells&r'in en güçlüsüdür. &9Echo Shards&r ile üretilirler ve bunları kullanmak için &9Manuscript&r'dan öğrenilmeleri gerekir. Her &9Manuscript&r yalnızca bir kullanımlıktır."]
	quest.2B901ECF97FFA181.quest_subtitle: "9. Sınıf"
	quest.2B901ECF97FFA181.title: "&9&lEldritch"
	quest.2BB910B217DF3A12.quest_subtitle: "Neden ıslak? Bir Gölde miydi?"
	quest.2BB910B217DF3A12.title: "&dEnder&r Upgrade Orb"
	quest.2D84DA544D7A24FA.quest_desc: ["Bu Görev, AllTheMods Mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından yazılmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin, &6AllTheMods Ekibi&r'nin açık izni olmadan &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir genel pakette kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.2E6F1C8718EB8C66.title: "&4Blood&r Upgrade Orb"
	quest.3009018DEC1EC952.quest_desc: ["&2Overworld&r'de bossların doğabileceği 6 yapı var! (7. bir tane var ama içinde boss yok)."]
	quest.3009018DEC1EC952.title: "&lMacera Zamanı!"
	quest.300F2E45D185A9A1.quest_desc: ["&lIron&r bize harika ve çok eğlenceli bir Büyü Modu getirdi! &lIron's Spells 'N Spellbooks!&r \\n\\n&lIron's Spells&r tamamen &3Spells&r yapmak ve kullanmakla ilgilidir! Her &3Spell&r'in bir Nadirliği, Seviyesi ve Sınıfı vardır! Ve her biri bir Spellbook'ta (Büyü Kitabında) kullanılabilir. \\n\\nSadece &7Iron&r ve &cRedstone&r ile ne isterseniz yapamayacaksınız, kıçınızı kaldırıp Maceraya atılmanız ve Savaşmanız gerekecek!"]
	quest.300F2E45D185A9A1.title: "&lIron's Spells 'N Spellbooks"
	quest.30B7AF815D9D7553.quest_desc: [
		"&c&lPyromancer&r'ın &cBurned Tower&r'ı (Yanmış Kulesi). Bazıları &cTower&r'ı görecek kadar yakınsanız, ondan gelen ısıyı hissedecek kadar yakın olduğunuzu söyler. \n\n&cPyromancer Tower&r, içi Ladin ve Meşeden yapılmış, esas olarak Taş türlerinden oluşan yanmış bir kuledir. Ayrıca yapının bir parçası olan &cTower&r'a yakın ikinci bir Bina daha vardır. \n\nEn üstte dumana neyin sebep olduğuyla birlikte bir &5Armor Pile&r (Zırh Yığını) bulacaksınız. \n\n&c&lPyromancer&r'ı bulmak isterseniz Bodruma inmeniz gerekecek!"
		"{image:atm:textures/questpics/iron_spells/spells_pyromancertower.png width:200 height:100 align:center}"
	]
	quest.30B7AF815D9D7553.title: "&cPyromancer Tower"
	quest.32D2CE292E088939.title: "&cFire&r Upgrade Orb"
	quest.34FC02F47F52887F.quest_desc: ["Bu &eSpellbook&r kesinlikle 12 &3Spell Slots&r (Büyü Yuvası) için sizi çalıştırıyor! \\n\\n&bIcy Fangs&r'dan (Buzlu Dişler) yapılan veya &bIce Spider Den&r'den Yağmalanan &bIce Venom Vials&r'a ihtiyacınız olacak. \\n\\nYapımı çok kolay olan &5Arcane Cloths&r. Ayrıca Madencilik yapmanız gerekecek olan &bMithril Scraps&r! \\n\\n&eSpellbook&r'un ne kadar soğuk hissettirdiğine bakılırsa, &bIce Spells&r'e yardımcı olduğunu düşünüyorum."]
	quest.34FC02F47F52887F.title: "&bFrostbanded Spellbook"
	quest.36B283532D70776A.quest_desc: ["&aBoots of Speed&r, buradan alabileceğiniz en iyi Botlardır. \\n\\nİlk olarak &aArchevokers Boots&r'a ihtiyacımız olacak. Kullanılmış eşyaları sevmiyorsanız, kendinizin Üretmesini tavsiye ederim. \\n\\nArdından, bir &bMithril Weave&r'a ihtiyacımız olacak. Bu, &bMithril Ingots&r ve Zincirlerin birleşimidir. Bunlar yalnızca Zırh Üretmek için kullanılır, bu yüzden sadece birkaç tanesine ihtiyacınız olacak. \\n\\nSonuncusu &dDivine Soulshard&r'dır. \\n\\nBu &aBoots&r, diğer tüm Botlardan daha fazla Mana, daha fazla &3Spell Power&r verecek, artı sizi daha mı hızlı yapıyorlar? Sizi nasıl daha hızlı yapıyorlar? Hareketinizi ve &3Spell Casting&r (Büyü Yapma) Hızınızı artırarak!"]
	quest.36B283532D70776A.title: "&aBoots of Speed"
	quest.36F87173D8CD1D68.quest_desc: ["&5Lightning&r'a hükmedin! &5&lLightning&r tamamen düşmanları öldürmek ve kendinizi desteklemek için Elektrik kullanmakla ilgilidir. Hatta bazı saldırılar gerçek &5Lightning&r (Yıldırım) olarak çalışır! \n\n&5&lLightning's&r Focus Materyali, Yüklü bir Creeper'da Boş bir Şişe kullanarak elde ettiğiniz &5Bottle 'O Lightning&r'dir. Daha fazla &5Lightning&r yapmak için &5Lightning&r'e ihtiyacınız var! \n\n&5Scrolls&r (Parşömenleri) &bLight Blue&r (Açık Mavi) metinli &7Grey&r renktedir."]
	quest.36F87173D8CD1D68.title: "&5&lLightning"
	quest.373EBEB2E96D9361.quest_desc: ["Karlı Biyomları keşfederken yıkık dökük bir Kiliseye benzeyen bir şeye rastlayabilirsiniz. \\n\\nAncak içindeki şey &6Holy&r değil! \\n\\nBodrum katından Yeraltı Mezarlarına inin. Burada bol miktarda Stray (Sokak İskeleti) Spawner'ı, Toz Kar tuzakları ve ganimet olacak! \\n\\n&bIce Spider Eggs&r (Buz Örümceği Yumurtaları) da cabası... onları Kırmayı deneyin ve şunu alarma geçireceksiniz..."]
	quest.373EBEB2E96D9361.title: "&bIce Spider Den"
	quest.395A33977B18B9AD.quest_desc: [
		"&5Piles of Armor&r (Zırh Yığınları)'nı toplamaya çalıştıktan sonra sanki onu kullanan bir beden varmış gibi hayata geri dönüyorlar. Ayrıca Spawner'lardan da gelebilirler. \n\n60 &4Kalp Sağlığına&r sahiptirler ve büyü kullanmadıkları için diğer bosslardan farklılar; daha ziyade büyüden yapılmış bir şey olduklarına inanıyorum. Kılıçlarını sallayarak ya da onunla size doğru hücum ederek saldıracaklardır. \n\nGördüğüm kadarıyla diğer &5&lKnight&r'lar (Şövalyeler) hariç gördükleri her şeye saldıracaklar! \n\nÖldürüldüklerinde Netherite Scraps ve &cCinder Essence&r düşürürler. Nadiren &5Weapon&r'larını (Silahlarını) düşürürler ve &cCitadel&r'dakiler Decrepit Keys düşürür."
		"{image:atm:textures/questpics/iron_spells/spells_knight.png width:100 height:150 align:center}"
	]
	quest.395A33977B18B9AD.title: "&5&lAncient Knight"
	quest.3A85110725E81CDF.quest_desc: ["Daha önce &2&lMinecraft&r oynadıysanız Zırhın ne olduğunu ve ne işe yaradığını biliyor olmalısınız! \\n\\n&lIron's Spells&r kendi Zırh türlerini de ekliyor. \\n\\nBunlar normal Zırh gibi çalışır ancak her biri sihirli güçlerinize farklı takviyeler sağlar. Daha yüksek &3Spell Power&r (Büyü Gücü), daha fazla Mana ve hatta Element takviyeleri gibi."]
	quest.3A85110725E81CDF.title: "&lArmor"
	quest.3DCD38634176BD92.quest_desc: ["&6Allthemodium&r &eSpell Book&r'u bir Demirci Masasında bir Vibranium Ingot ve Şablon ile birleştirin.\\n\\nBu şablon bir Bastion'da (Burç) Şüpheli Ruh Kumunu Fırçalayarak elde edilebilir."]
	quest.3DCD38634176BD92.title: "&3Vibranium&r Spell Book"
	quest.3E8077AB45C79E6A.quest_desc: [
		"Kesinlikle Normal bir Minecraft Kazanından daha iyi! \n\nAlchemist Cauldron şunları yapabilir: \n1. Yaratıkları veya oyuncuyu pişirerek &4Blood&r elde etmek için kullanılabilir. \n2. İksirler yapar ve yükseltir. \n3. Bir Parşömenden Mürekkep alma ihtimali yarı yarıyadır. \n4. Bir Nadirliğe ait 4 Mürekkebi daha yüksek bir Nadirliğe birleştirir. "
		"{image:atm:textures/questpics/iron_spells/spells_cauldron.png width:100 height:100 align:center}"
	]
	quest.401BB95B740385B7.title: "&6Holy&r Upgrade Orb"
	quest.4104ABDC0E577350.title: "&2Nature&r Upgrade Orb"
	quest.420CB9502DF8E1BC.quest_desc: ["&b&lIce Spider&r. \n\nBu, 50 &4Kalp Sağlığına&r ve 20 zırh puanına sahip bir Düşmandır. \n\nYaklaşırsanız sizi Isırırlar veya birçok kollarından biriyle size vururlar! \nUzaklaşırsanız ya bir çeşit &bIcy cocoon&r fırlatırlar? Sanırım? Her neyse, size hasar verir ve sizi olduğunuz yerde &bDondurur&r (&bFreezes&r). Veya size hasar vermek için yerden size doğru bir &bIce Rocks&r (Buz Kayaları) çizgisi gönderebilirler. \n\nÖldüklerinde İp, &5Arcane Essence&r ve bazen de &bIcy Fang&r düşürürler."]
	quest.420CB9502DF8E1BC.title: "&b&lIce Spider"
	quest.4407BD7B5F033765.quest_desc: ["Başka bir Üretilebilir &eSpell Book&r ve bu da modeli takip ederek daha da pahalı. Arcane Clothes, Gold (Altın) ve bir Enchanted Book gerektiriyor. Hangi Kitap olduğu konusunda seçici değil sadece Efsunlu olması gerekiyor! \\n\\n10 &3Spell&r Yuvasına sahiptir ve devasa bir Mana Artışı sağlar!"]
	quest.4407BD7B5F033765.title: "Enchanted Spell Book"
	quest.445C21949ADA1FE3.quest_desc: ["Bir Ancient Codex'i bir Demirci Masasında &6Allthemodium Ingot&r ve Şablon ile birleştirin.\\n\\nŞablonu &9Ancient City&r'de Şüpheli Kili Fırçalayarak elde edebilirsiniz."]
	quest.445C21949ADA1FE3.title: "&6Allthemodium&r Spell Book"
	quest.44E8D5DAD7E22724.quest_desc: ["Komik olan şu ki, bu pek bir şey yükseltmiyor. \\n\\n&3Spell Power&r (Büyü Gücü) aynı kalır, Mana aynı kalır, zırh puanı bile aynı kalır. Tek değişiklik Zırh Sertliğinin eklenmesidir. \\n\\nYine de mantıklı, bu sadece &bWizard Gear&r için bir &5Netherite Upgrade&r (Yükseltmesi)!"]
	quest.44E8D5DAD7E22724.title: "&cNetherite Battlemage Armor"
	quest.4567A27C53A01903.quest_desc: [
		"&c&lEcho of Tyros&r, &lIron's&r'dan aldığımız ilk gerçek Boss! \n\n16 zırh puanı ile 1000 &4Kalp Sağlığına&r sahiptir. Ayrıca, kendisiyle savaşmaları için &5Ancient Knight&r'lar çağırma yeteneği de var! \n\n&c&lFirst Flamebearer&r unvanından tahmin edebileceğiniz gibi, saldırmak için &cFire Magic&r (Ateş Büyüsü) kullandığını anlayacaksınız. \n\nSize vurmak için &cScythe&r'ını (Tırpan) sallayabilir veya her yöne bir &cFire&r (Ateş) dalgası salmak için yere vurabilir. \n\nBirkaç saldırı daha &cFirey Swords&r (Ateşli Kılıçlar) içerir, arka arkaya size bir sürü fırlatabilir veya size hasar vermek için yerden yükselmeleri için düzinelercesini çağırabilir. \n\nSahip olduğu son saldırılar &cFireballs&r (Ateş Topları) kullanmaktır, bunları ya hareketsiz durarak ya da havaya sıçrayarak size fırlatacaktır! \n\nOnun &4Health&r'inin (Sağlığının) dörtte birini götürdüğünüzde diz çökecektir. Bu, ona en sert vurabileceğiniz andır! Ancak 300 &4Kalbe&r ulaştığında silahlarını ve zırhını yükseltecektir. Hatta &5Ancient Knight&r'larını bile yükseltecek! \n\nEğer onu bir şekilde öldürebilirseniz, &cScythe&r'ını ve bir &dDivine Soulshard&r düşürecektir. Artı Özler ama kimin umurunda, biz bir &cScythe&r aldık!"
		"{image:atm:textures/questpics/iron_spells/spells_echo.png width:125 height:100 align:center}"
	]
	quest.4567A27C53A01903.title: "&c&lEcho of Tyros, First Flamebearer"
	quest.489833A2A6C39151.quest_desc: [
		"Kötü biriydi çalabilirsin umurumda değil."
		"{image:atm:textures/questpics/iron_spells/spells_outfit_cryomancer.png width:60 height:100 align:center}"
	]
	quest.489833A2A6C39151.title: "\"&bCryomancer Outfit\""
	quest.48C68664319B0294.quest_desc: ["Bu özel Spell Book'u elde etmek için &4&lDead King&r'i öldürmeniz gerekecek! \\n\\n10 &3Spell&r Yuvasına sahiptir ancak 4'ü zaten alınmıştır. &4Blood Slash&r, &4Blood Step&r, &4Ray of Siphoning&r ve &4Blaze Storm&r üzerinde halihazırda gelir ve çıkarılamaz."]
	quest.48C68664319B0294.title: "\"Necronomicon\""
	quest.4CCA1E2AAA9AB9D9.quest_desc: [
		"Bu Moda ne zaman gelecek?"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_electromancer.png width:50 height:100 align:center}"
	]
	quest.4CCA1E2AAA9AB9D9.title: "&5Electromancer Outfit"
	quest.4E3355FDCB65BB63.quest_desc: ["&aEvokers&r, Minecraft'ın güçlü ve ölümcül bir Minibossu olarak bilinir. Yani elbette &lIron&r çok daha güçlü ve ölümcül bir versiyon ekledi! Ve evet, bu &eBook&r her ikisinden de düşen nadir bir ganimettir! \\n\\n10 Büyü Yuvasına sahiptir ancak 3'ü doludur. &aFang Strike&r, &aFang Ward&r ve &aVex Swarm&r hepsi &eBook&r ile birlikte gelir ve taşınamazlar. \\n\\nAyrıca &a&lEvocation&r'a bir güçlendirme sağlar!"]
	quest.4E3355FDCB65BB63.title: "&aGrimore of Evokation"
	quest.541446863A72B96C.title: "&7Common&r Ink"
	quest.548F85EE6B6F1811.quest_desc: [
		"Tıpkı &2&lApotheocarist&r'in benzediği Piglinler gibi, o da Tarafsızdır. Ancak Piglin dostları gibi &eGold&r'u (Altın) umursamaz, sadece ona saldıran insanları umursar. \n\nOnunla ticaret yapabilirsiniz: İksirler, İksir Malzemeleri ve &2Nature Scrolls&r karşılığında ona Zümrüt veya İksir Malzemeleri verebilirsiniz. \n\nOnu öldürmek isterseniz 60 Kalbi vardır. Size İksirler ve &2Nature Spells&r ile saldıracaktır. Canı yandığında İksirlerle iyileşmeye çalışacaktır, (Sanırım İksirleri gerçekten çok seviyor). \n\nÖldürüldüğünde Arcane Essence, Mürekkepler, &2Nature Runes&r ve &2Nature Scrolls&r düşürecektir!"
		"{image:atm:textures/questpics/iron_spells/spells_apotheocarist.png width:100 height:200 align:center}"
	]
	quest.548F85EE6B6F1811.title: "&2&lApothecarist"
	quest.551A4916F032ACCF.quest_desc: [
		"Arcane Anvil, &lIron Spells&r'daki herhangi bir bloktan en çok kullanıma sahip olandır. \\n\\n&3Spells&r'leri aynı Mürekkeple birleştirerek seviyesini yükseltebilirsiniz. \\n&3Scrolls&r'u Kılıç gibi onlarla kullanılmak üzere Silahlarda birleştirebilir. \\nAyrıca Upgrade Orbs kullanarak Yüzüklere bir Eğilim ayarlayabilir veya Silahlara ve Ekipmanlara Upgrade Orbs ekleyebilirsiniz."
		"{image:atm:textures/questpics/iron_spells/spells_anvil_gui.png width:100 height:100 align:center}"
	]
	quest.555ED1E39131D91B.quest_desc: [
		"&bTower&r'a gelmemeliydin, &b&lCryomancer&r oyunculardan hoşlanmaz, size düşmandır. \n\n&b&lCryomancer&r hemen size &bIce Spells&r ile saldırmaya başlayacaktır. Hatta hayvanları size karşı bile kullanabilir! Bir kavgayı kazanmak için hayvanları kurban etmek, gerçekten soğuk kalpli bir hareket! \n\nÖldürüldükten sonra Arcane Essence, Mürekkepler, &bIce Runes&r ve &bIce Scrolls&r düşürecektir!"
		"{image:atm:textures/questpics/iron_spells/spells_cryomancer.png width:100 height:200 align:center}"
	]
	quest.555ED1E39131D91B.title: "&b&lCryomancer"
	quest.59E68086A8B99EA7.quest_desc: [
		"&c&lPyromancer&r (Pie Romancer'dan farklıdır) &lIron's Spells&r tarafından eklenen bir başka Tarafsız yaratıktır. Yine de ona yakın olan yaratıkları &cfire&r'a (ateşe) verebilir... \\n\\nOnunla &cFire&r olan her şeyi, Ink (Mürekkep) ve hatta &cFire Scrolls&r ticaretini yapabilirsiniz. \\n\\nOnunla savaşarak vücudunuzdaki tüm tüyleri riske atmak istiyorsanız hazırlıklı olun, 60 Kalbi vardır. Sizi &cFire Spells&r ile &cFire&r (Ateş) içinde bırakacaktır, tartışmasız. \\n\\nÖlümde Arcane Essence, Mürekkepler, &cFire Runes&r ve &cFire Spells&r düşürecektir!"
		"{image:atm:textures/questpics/iron_spells/spells_pyromancer.png width:100 height:200 align:center}"
	]
	quest.59E68086A8B99EA7.title: "&c&lPyromancer"
	quest.5B013A3A37D6902B.quest_desc: ["Ancient Knowledge Parçalarını &9Ancient City&r Sandıklarına yayılmış olarak bulabilirsiniz. \\n\\nAyrıca 1. &9Spells&r'i öğrenmek için Parçaları Birleştirmek ve 2. Aslında &9Spells&r'i yapmak için &9Echo Shards&r'a ihtiyacınız olacak."]
	quest.5B013A3A37D6902B.title: "Ancient City'ye Doğru"
	quest.5DE863C3FB6492BE.quest_desc: ["{image:atm:textures/questpics/iron_spells/spells_outfit_cultist.png width:60 height:100 align:center}"]
	quest.5DE863C3FB6492BE.title: "&4Cultist Outfit"
	quest.5ED368C926E5F32C.quest_desc: ["Bahsetmeyi unuttuğum son bir &3Spells&r sınıfı var. Şey, bu &9Spells&r ile ilgili tüm bilgiler unutulmuş yani sadece ben değilim. \\n\\nAnıları geri kazanmak için hafıza şeridinde sessizce yürümemiz gerekiyor. Ki bu şans eseri &9Ancient City&r oluyor."]
	quest.5ED368C926E5F32C.title: "Son Sınıf..."
	quest.6046CA1F6AFE2AEA.quest_desc: ["&4The Blood Staff&r, &4&lThe Dead King&r'den Düşen bir ganimettir. Muhtemelen kelimenin tam anlamıyla onun Asası olduğu içindir! \\n\\nBu Asa öncekilerden daha fazla olan 8 &4Damage&r verir. \\n\\nTüm &3Spells&r'e %5 ve sadece &4Blood Spells&r'e %15 &3Spell Power&r (Büyü Gücü) ile %10 Çağrı Gücü verir."]
	quest.6046CA1F6AFE2AEA.title: "&4The Blood Staff"
	quest.60FAD8BF235E381B.title: "&bRare&r Ink"
	quest.615C3E012B2DECD3.quest_desc: ["&eSpellbooks&r! Başka nereye &3Spells&r koyardınız? \\n\\nBir Inscription Table'a ikisini birden koyarak bir &eSpellbook&r'a &3Scrolls&r ekleyebilirsiniz. Tutabilecekleri belirli bir miktar vardır, ancak artık Nadirlik konusunda endişelenmenize gerek yoktur. \\n\\n&3Scrolls&r, &eSpellbook&r'unuza eklendiğinde tüketilmezler, aksine Mana tüketilir."]
	quest.615C3E012B2DECD3.title: "&eSpellBooks&r!"
	quest.6187837A51BA09DC.quest_desc: ["&cCitadel&r, &lIron's Spells&r'ın bize verdiği en büyük Yapıdır. Neredeyse tamamen &0Blackstone&r'dan yapılmıştır. \n\nAna binayı çevreleyen ve ona bağlanan devasa Duvarları ve Kuleleri vardır. Bunların &5Ancient Knight&r Spawner'ları ve ganimet Fıçıları vardır. \n\nAna binanın ilk katında Kütüphane/Araştırma Odası bulunur. Burada milyarlarca Kitabın yanı sıra Sandıklar ve daha fazla &5Ancient Knight&r vardır! \n\nÜst katta Citadel Vaults'un yanı sıra &5Cursed Armor Stands&r (Lanetli Zırh Askıları) da bulunacaktır. Ganimetlerini almaya çalışırken dikkatli olun, mülklerini savunabilirler! \n\nEn üst kat arenadır..."]
	quest.6187837A51BA09DC.title: "&cCitadel"
	quest.637C87D8968CD51A.title: "&aUncommon&r Ink"
	quest.639531AB27DCD267.quest_desc: ["&7Runes&r (Rünler), Sınıflarımızı ve onların parçalarını nasıl yaptığımızdır. Bir &7Blank Rune&r (Boş Rün) elde etmek için &4&lDead King&r'i öldürebilir ya da Yazılı bir Rünü bir Shriving Stone ile silebilirsiniz. \\n\\nHer birinin kendi &3Scrolls&r'u (Parşömenleri), Odak Materyali, Yükseltmeleri ve Kıyafetleri olan 8 farklı sınıf (1 gizli olan) vardır. "]
	quest.639531AB27DCD267.title: "&lSınıflar"
	quest.641888DC7BC40AA9.quest_desc: [
		"Ağır korunan &aFortress&r, &a&lArchevoker&r ve takipçilerine ev sahipliği yapar. \\nBunu devasa Ladin Duvarlarından ve içlerindeki devasa Taş &aFortress&r'dan anlayacaksınız. \\n\\nIllagers, Vindicators, &aEvokers&r ve Ravagers (Yağmacılar) Duvarlar ve &aFortress&r içinde bulunabilir. Onları geçtikten sonra merdivenleri çıkabilir, Çatıya parkur yapabilir ve en tepede &a&lLeader of the Fort&r ile (Hisarın Lideriyle) buluşabilirsiniz. \\n\\nAğır şekilde korunduğu için elbette &aFort&r içinde bir ton ganimet var."
		"{image:atm:textures/questpics/iron_spells/spells_evokerfort.png width:200 height:100 align:center}"
	]
	quest.641888DC7BC40AA9.title: "&aEvoker Fort"
	quest.652A14E17DDE97E6.quest_desc: ["Üretilmesi için Ruined Book gerektiren bir başkası. Ruined Books'u &9Ancient City&r Sandıklarında bulabilirsiniz. \\n\\nAyrıca &dEnder Dragon&r'dan düşen Dragon Skin'e ihtiyacınız olacak! \\n\\n12 &3Spell&r Yuvasına sahip olacak ve &dEnder Spells&r'e destek sağlayacaktır!"]
	quest.652A14E17DDE97E6.title: "&dDragonskin Spell Book"
	quest.660D8AD3EE975340.quest_desc: ["Birkaç Silah Üretmek için &bWeapon Parts&r gerekecektir. \\n\\nVe evet, bunları da Üretmemiz gerekecek. \\n\\nOldukça basitler, sadece 3 &bMithril Ingots&r ve 2 &5Arcane Ingots&r. \\n\\n&5Arcane Ingots&r, 1 &6Copper Ingot&r ve 8 &5Arcane Essence&r'dan yapılır."]
	quest.660D8AD3EE975340.title: "&bWeapon Parts"
	quest.66762A4743104157.quest_desc: ["Üretilebilir bir &eSpellbook&r daha, bu biraz daha pahalı! Hoglinlerden düşen Hogskin'e ihtiyacı olacak. \\n\\nBu 8 &3Spells&r tutabilir ki bu teknik olarak hala alt taraftadır ancak yine de daha iyidir!"]
	quest.66762A4743104157.title: "Apprentice's Spell Book"
	quest.67308C5DDF4A10D2.quest_desc: ["&9Wandering Magician Armor&r, &lIron's Spells&r'in sunabileceği en zayıf olanıdır. \\n\\nKelimenin tam anlamıyla &7Leather Armor&r'a bir yükseltmedir! Kim &7Leather Armor&r Üretir ki?!?!?! \\n\\nÜretmek için &7Leather Armor&r'ınızı &5Arcane Essence&r ile birlikte bir Çalışma Masasına atmanız yeterli. \\n\\nBu, her parçanın daha fazla zırh puanı ve hafif bir Mana Artışı vermesini sağlayacaktır!"]
	quest.67308C5DDF4A10D2.title: "&9Wandering Magician Outfit"
	quest.67439337E29A308B.quest_desc: ["&eArtificer's Cane&r, &7Graybeard Staff&r'tan daha pahalıdır ve bu nedenle daha güçlüdür. \\n\\nArtık 4 &4Damage&r verecek ve %10 &3Spell Power&r'ın (Büyü Gücünün) yanı sıra %15 Bekleme ve Kullanım Süresi Azaltması sağlayacak. \\n\\nSadece daha iyi olduğunu söyledim, çok daha iyi olduğunu söylemedim!"]
	quest.67439337E29A308B.title: "&eArtificer's Cane"
	quest.67A587F4BAD76C70.quest_desc: ["En temel &eSpellbook&r, bu da onu en ucuzu yapar! \\n\\nToplamda yalnızca 5 &3Spells&r tutabilir."]
	quest.67A587F4BAD76C70.title: "Flimsy Journal"
	quest.67D40A1A9332C03D.title: "&6Legendary&r Ink"
	quest.68B44B9E939F4228.quest_desc: [
		"&aFort&r'un tepesinde &a&lArchevoker&r yatıyor. Sadece oyuncuya ve ona saldıran herkese karşı Düşmanca. \\n\\n60 Kalbi var ve normal bir &aEvoker&r gibi saldırıyor, artı daha fazlası! &aFireworks&r, &aShield&r ve &aBlast of Wind&r! \\n\\nÖldürüldükten sonra Arcane Essence, Mürekkepler, &aEvokation Runes&r, &aEvokation Scrolls&r düşürecek ve &aGrimore of Evokation&r'ın nadir düşme ihtimali var!"
		"{image:atm:textures/questpics/iron_spells/spells_evoker.png width:100 height:200 align:center}"
	]
	quest.68B44B9E939F4228.title: "&a&lArchevoker"
	quest.6963EC8A71D66AE3.quest_desc: [
		"Çamurlu Mangrov Bataklıklarının derinliklerinde &2&lApotheocarist&r adı verilen münzevi yaratığın sığınağı yatar. \n\nYakınında kimse yoktur ve sadece iksirleri için neye ihtiyacı varsa etraftadır. \n\n&2&lApotheocarist&r'i kendi &2Hut&r'ında (Kulübesinde) bulabilirsiniz. \n\nOrada İksirlerle dolu Kazanlar ve İksir Stantları da bulabilirsiniz!"
		"{image:atm:textures/questpics/iron_spells/spells_magrovehut.png width:200 height:100 align:center}"
	]
	quest.6963EC8A71D66AE3.title: "&2Mangrove Hut"
	quest.69763C2E2F454A73.quest_desc: ["&c&lFire&r açıkça &cFire&r (Ateş) ile ilgilidir. Parşömenlerin çoğu bir şeyleri yakmak ve incitmek için &cFire&r kullanmakla ilgilidir. \\n\\n&c&lFire's&r Focus Materyali &cBlaze Rods&r'dur (Blaze Çubukları). &cFire Runes&r üretebilir veya &c&lPyromancer&r'ı öldürerek elde edebilirsiniz. \\n\\n&cScrolls&r'u (Parşömenleri) &8Grey&r metinle &cLight Red&r (Açık Kırmızı) renktedir."]
	quest.69763C2E2F454A73.title: "&c&lFire"
	quest.69838E3F12218D68.quest_desc: [
		"Scroll Forge, ne işe yaradığını tahmin edebilirsiniz! \\n\\n&3Scrolls&r (Parşömenler) yapar! \\n\\nNadirliği ayarlamak için bir Mürekkep ekleyin. Gerçek &3Scroll&r için Kağıt. Ardından ne tür bir &3Spell&r (Büyü) istediğinizin Eşyası (&c&lFire&r için &cBlaze Rod&r, &2&lNature&r için &2Poisonous Potato&r vb.). Son olarak istediğiniz &3Spell&r'i seçin ve oluşturulacaktır!"
		"{image:atm:textures/questpics/iron_spells/spells_scroll_gui.png width:150 height:100 align:center}"
	]
	quest.6CE7115DA2B23776.quest_desc: ["Flimsy Journal'dan pek de iyi değil... \\n\\nBu, Flimsy Journal'dan sadece bir &3Spell&r daha tutabilir! Bu, hazırda bekleyen çok güçlü bir &3Spell&r daha demek!"]
	quest.6CE7115DA2B23776.title: "Ironbound Journal"
	quest.6D232F6D8E8DA546.quest_desc: [
		"Cadılar Bayramı civarında çok popüler!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_plagued.png width:60 height:100 align:center}"
	]
	quest.6D232F6D8E8DA546.title: "&2Plagued Outfit"
	quest.6DB5732177AABB87.quest_desc: [
		"&lIron's Spells&r'dan gelen en büyük ve en zor yapı. \\n\\nBunlar Trial Chambers'a benzeyen derin yeraltı yapılarıdır. Onu bulmanıza yardımcı olması için Wayward Compasses'ı da kullanabilirsiniz! \\n\\nİçinde bolca Spawner, Trial Spawner ve tabii ki ganimet vardır. \\n\\nEn önemli oda Taht Odasıdır, oraya vardığınızda, &4&lDead King&r'in İskeleti yeniden canlanacaktır! (Eğer canlanmazsa ona tıklamanız gerekebilir)."
		"{image:atm:textures/questpics/iron_spells/spells_catacombs.png width:200 height:100 align:center}"
	]
	quest.6DB5732177AABB87.title: "&4Catacombs"
	quest.6F5F1C525CF08F96.quest_desc: ["Staffs ve... Asa benzeri Eşyalar, Tutulduklarında Sihir Takviyeleri verecek Silahlardır! \\n\\nArtı çok şıklar!"]
	quest.6F5F1C525CF08F96.title: "Staffs, Rods, and Canes"
	quest.71F0E9C36AA02B46.quest_desc: ["Bu arena oldukça boş görünüyor... ah bekle bu da ne! \\n\\n&cCinderous Soul Rune&r. Neredeyse bir Anahtar Deliğine benziyor, sadece Decrepit Keys üzerlerinde çalışmıyor. \\n\\nBana güven, çalışmıyorlar. \\n\\nBunun yerine &cCinderous Soulcaller&r'a ihtiyacımız olacak! &cCinder Essence&r, &5Netherite Scraps&r ve bir &9Echo Shard&r'dan yapılmıştır. \\n\\n&5Netherite Scraps&r &5Ancient Debris&r'den, &9Echo Shards&r &9Ancient City&r'den gelir ve &cCinder Essence&r &5Ancient Knights&r'dan Düşen ganimetlerdir!"]
	quest.71F0E9C36AA02B46.title: "&cCinderous Soulcaller"
	quest.7270A37E31A70C91.quest_desc: ["&6&lHoly&r tüm Sıhhiyeci/Destek oyuncuları içindir. Çoğunlukla iyileştirme ve yardım etme amaçlıdır. \\n\\n&6&lHoly's&r Focus Materyali üretilen &6Divine Pearls&r'dir. Bunlarla Runes (Rünler) yapabilir veya &6Holy Runes&r almak için &6&lPriest&r'ı öldürebilirsiniz. \\n\\n&6Holy Scrolls&r &6Gold&r (Altın) metinlerle &fWhite&r renktedir."]
	quest.7270A37E31A70C91.title: "&6&lHoly"
	quest.72AB70FD8D8FABBF.quest_subtitle: "&cNether&r!"
	quest.72AB70FD8D8FABBF.title: "Şuraya Giden Otoyolda..."
	quest.73D6B980D35082A0.quest_desc: ["Bunu açıklamak biraz zaman alıyor o yüzden sabırlı olun. \\n\\nİlk olarak, bir &aEvoker Fort&r bulun. \\nSonra, içinde gizlenmiş bir Araştırma Kitabı bulun. Sonra, &aFort&r'da rehin olan bir Tüccara bunu tercüme ettirin. (Rehin Görev Çevirmenlerimiz gibi!) \\nTercüme edildikten sonra, &eSpell Book&r ile takas etmek için onu bir &6Village&r'daki (Köy) bir &6&lPriest&r'a götürün! \\n\\n&6Holy Spells&r'e bir güçlendirme sağlar ve endişelenmeyin rehin Tüccarlar çok ama çok nadirdir, aramaya devam edin!"]
	quest.73D6B980D35082A0.title: "&6Villager Bible"
	quest.7408CCF998D9CD37.quest_desc: ["Üretilebilir bir &eSpell Book&r... evet, üretmesi kolay değil. \\n\\nElde edilmesi en zor olanı, &9Ancient City&r Sandıklarında bulabileceğiniz Ruined Book olacaktır. &4Blood Vials&r, bir Yaratığı bir Kamp Ateşinin üzerindeki bir Kazana veya Alchemical Cauldron'a (Simya Kazanı) koyarak elde edilebilir. &5Bottle O' Lightning&r, Yüklü bir Creeper üzerinde bir Şişe kullanılmasından gelir. \\n\\nTüm bunları yaptıktan sonra Ancient Codex'i üretebilirsiniz. 12 &3Spell&r Yuvası çok faydalıdır!"]
	quest.7408CCF998D9CD37.title: "Ancient Codex"
	quest.76558D23A70AFF78.title: "&bIce&r Upgrade Orb"
	quest.78AA7BFABBFB9973.quest_desc: ["&2&lNature's&r &eSpell Book&r. \\n\\n10 &3Spells&r'e sahiptir ve &2Nature Spells&r'e bir güçlendirme sağlar! \\n\\nBunu üretmek için bir Rotten Spell Book'a ihtiyacınız var gerçi..."]
	quest.78AA7BFABBFB9973.title: "&2Druidic Tome"
	quest.794D6F9B8DB31E7D.quest_desc: ["&bIce Staff&r bir süreliğine kafamı karıştırdı ama çok şükür artık biliyorum! \\n\\nBir &bPermafrost Shard&r ve bir &bFrosted Helve&r'a ihtiyacınız olacak. &bPermafrost Shard&r, Ice Breaker Yapısının içindeki bir ganimettir. Bunlar Buzlu Biyomlardaki Gemi Enkazlarıdır. \\n\\n&bFrosted Helve&r Üretilmiş bir Eşyadır. &5Arcane Ingots &fve &bFrozen Bones&r kullanır. İkincisi &bStrays&r'den (Sokak İskeletlerinden) düşer. \\n\\n&bIce Staff&r 5 &4Damage&r verir ve %25 Mana Yenilenmesi sağlar. Tüm &3Spell&r'e %5, ve sadece &bIce Spells&r'e %15 &3Spell Power&r (Büyü Gücü) verir."]
	quest.794D6F9B8DB31E7D.title: "&bIce Staff"
	quest.79EC8A49368421BF.quest_desc: ["&6Pyrium&r, &cCitadels&r Mahzenlerinden onaylanmış bir ganimettir... \\n\\nAncak bu Mahzenler normal Trials Keys'i kabul etmiyor. Vay canına, sanki bir Anahtar her Kilidi açamıyormuş gibi! \\n\\n&cCitadel&r'daki &5Ancient Knights&r'dan Düşen bir ganimet olan Decrepit Key'e ihtiyacımız olacak. Kulelerde ve Kütüphanenin alt seviyesinde doğarlar."]
	quest.79EC8A49368421BF.title: "&6Pyrium"
	quest.7C79BCE482A06199.quest_desc: ["&b&lIce&r tamamen Kış zamanı Büyüleriyle ilgilidir. Düşmanları üşütmek ve incitmek için &bIce&r ve &bSnow&r kullanmak. \\n\\n&b&lIce's&r Focus Materyali, &bStrays&r'den düşen &bFrozen Bone&r'dur (Donmuş Kemik). Bunları &bIce Rune&r'u üretmek veya onu almak için &b&lCryomancer&r'ı öldürmek için kullanabilirsiniz. \\n\\n&bScrolls&r'u (Parşömenleri) &9Darker Blue&r metinle &bLight Blue&r (Açık Mavi) renktedir."]
	quest.7C79BCE482A06199.title: "&b&lIce"
	quest.7F85669FEA41CD97.quest_desc: [
		"&6Village&r'ın (Köy) Tarafsız koruyucusu. Yakındaki tüm Düşman yaratıklara saldıracaktır. Bir Demir Golem gibi ama nedense tanıdık mı geliyor? Kostümlü tanıdığımız biri olabilir mi? \\n\\nOnunla İyileştirme İksirleri ve yakında &aEvoker Forts&r'a karşı yardım için yapılacak olan Furled Map için Zümrüt takası yapabilirsiniz. \\n\\nOnu öldürmek isterseniz size defalarca &6Holy Spells&r ile saldıracaktır. Ayrıca canı azaldığında kendini İyileştirecektir. \\n\\nÖldürüldükten sonra Arcane Essence, Mürekkepler, &6Holy Runes&r ve &6Holy Scrolls&r düşürecektir."
		"{image:atm:textures/questpics/iron_spells/spells_priest.png width:100 height:200 align:center}"
	]
	quest.7F85669FEA41CD97.title: "&6&lPriest"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&5Ancient Battlegrounds&r sadece geçmişin bir parçasıdır. \\n\\nNe olduğunu kim bilir. \\n\\nKimin kiminle savaştığını kim bilir. Şimdi tek sahip olduğumuz duvarların parçaları ve bu &5Piles of Armor&r (Zırh Yığınları). Kazmanızla onları Kazarak alsanız iyi olur."
		"{image:atm:textures/questpics/iron_spells/spells_battleground.png width:200 height:100 align:center}"
	]
	quest.7FC54AF87CBDD222.title: "&5Ancient Battleground"
	task.00C6A5CB44392D7E.title: "TümHaklarıSaklıdır"
	task.1CC0E97BB8DC4F35.title: "\"5 Necromancer Öldür\""
	task.6D7DD99A02A8F451.title: "The Deep Dark'ı Ziyaret Et"
	task.76B722B1AE7B6CF2.title: "TümHaklarıSaklıdır"
}
