{
	chapter.219B7A003658D24F.title: "XyCraft"
	chapter_group.2B51AC12041E3F89.title: "Teknoloji"
	quest.030AC1AF8F735550.quest_desc: ["Tank içine sıvı almak için bir tür Pipe (Boru) kullanmanız gerekir.\\n\\nHydro Pump yavaş bir oranda, ancak aynı zamanda ücretsiz olarak otomatik olarak Su (Water) koyabilir!"]
	quest.030AC1AF8F735550.title: "Borular"
	quest.06B85804163DD18B.quest_desc: ["Soaryn Box (Soaryn, XyCraft'ın yazarıdır), XyCraft'ın sandığıdır.\\n\\nBlok kırıldığında içindeki eşyaları tutmaz! Acaba üzerindeki o kareler ne işe yarıyor?"]
	quest.08E484DD3E751697.quest_subtitle: "Roy G. Biv'deki B (Mavi)"
	quest.08E484DD3E751697.title: "&bBlue Xychorium Gems"
	quest.0D01524F249E25D7.quest_subtitle: "Işıkları kim kapattı?"
	quest.0D01524F249E25D7.title: "&8Dark Xychorium Gems"
	quest.15540271BF17C2E4.quest_desc: ["&lXyCraft'a Hoş Geldiniz!&r\\n\\nBu mod serisi çoğunlukla XyCraft: World ve Machines üzerine yoğunlaşmıştır!\\nWorld, madencilik yaparken bulunabilen Gems (Mücevherler) verir."]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.16B4A00948D1F60D.quest_desc: ["Bu Görev, &6AllTheMods Ekibi&r veya AllTheMods Modpaketlerinde kullanılmak üzere bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r kapsamında lisanslandığından, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir halka açık pakette açık izin olmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.1A96C595CBA42840.quest_desc: ["Kivi Seeds, Kivi içinde üretilebilen Kivi Essence yetiştirmek için kullanılabilir!"]
	quest.1A96C595CBA42840.title: "Kivi Otomasyonu"
	quest.1E00DBAACDF4404F.quest_desc: ["Collector, çok ucuz bir Absorption Hopper olarak çalışır.\\n\\n3 blokluk bir yarıçap içindeki tüm eşyaları alır ve altındaki envantere veya kendi envanterine koyar. Redstone ile kapatılabilir!"]
	quest.2278A98DCDF713D7.quest_desc: ["Şimdi Tank yapma zamanı! Öncelikle Building Blocks (Yapı Blokları) ve en az 1 Valve'e ihtiyacınız var. Glass ve Item IO'lar isteğe bağlıdır.\\n\\nTank yapı bloklarından oluşan bir çerçeveden yapılmalıdır. Yapı blokları, şeffaf olmayan, yerçekiminden etkilenmeyen veya doğal Dirt ya da Grass olmayan herhangi bir şeydir.\\n\\nTaş, ahşap veya metal gibi eşyalar çerçeveyi ve kenarları oluşturmalıdır. Glass, Valve'ler ve Item IO'lar duvarlara yerleştirilmeli ve içerisi boş olmalıdır.\\n\\nEn fazla 13x13x13 büyüklüğünde olabilir. Tüm bunları yaptıktan sonra, Valve'e sağ tıklayın ve ya 'Oluştu' (Formed) diyecek ya da size sorunu söyleyecektir."]
	quest.2278A98DCDF713D7.title: "&lTank"
	quest.2AC7BC448C007BDB.quest_desc: ["Kivi'yi Aluminum ile güçlendirin, böylece makineleri üretmek için gereken Machine Frames elde edersiniz."]
	quest.2B5E14A47062F83C.quest_subtitle: "Roy G. Biv'deki R (Kırmızı)"
	quest.2B5E14A47062F83C.title: "&cRed Xychorium Gems"
	quest.2C4ECA4F5B1639F4.quest_desc: ["Light Field çok fazla ışık göstermez, ancak bir Mega Torch gibi çalışır.\\n\\nMob'lar etrafındaki belirli bir alanda doğamazlar. Bu alan yaklaşık 32 blokluk bir yarıçaptır."]
	quest.2C4ECA4F5B1639F4.title: "&fLight Field"
	quest.2C7D62231AD6406A.quest_desc: ["XyCraft harika bir Fluid Tank multiblock'una (çoklu blok yapısı) sahip!"]
	quest.2C7D62231AD6406A.title: "&bSıvı Depolama ve Manipülasyon"
	quest.355244420EA47546.quest_desc: ["Fabricator bir Otomatik Üreticidir (Auto-Crafter). Altındaki envanterden öğeleri alır ve ayarlanmış bir tarifi yapar.\\n\\nCTRL Tıklaması ile tarifleri kilitleyebilirsiniz. Ancak oluşturulan eşyaları dışarı pompalaması gerekecektir."]
	quest.355244420EA47546.quest_subtitle: "Otomatik Üretici"
	quest.39E4FC9BA89E44BC.quest_desc: ["Balloon on a Stick erken ve kısıtlayıcı bir Yaratıcı Uçuş (Creative Flight) kaynağıdır.\\n\\nÇubuğu yere yerleştirin, böylece bir balona bağlanacaksınız! Uçmaya başlamak için boşluk tuşuna iki kez dokunun, sadece çok uzağa gitmeyin. Çok uzağa giderseniz kopar ve düşersiniz."]
	quest.39E4FC9BA89E44BC.quest_subtitle: "Yukarı!"
	quest.3E970E76372AB094.quest_desc: ["&2Accelerated Planter&r normal Farmland (Tarım Arazisi) ile benzer çalışır ancak bazı değişiklikler vardır.\\n\\nOtomatik olarak sulanır ve normal Farmland'den daha hızlıdır."]
	quest.3E970E76372AB094.title: "&2Accelerated Planter"
	quest.3F68BA498E877C8C.quest_subtitle: "Roy Biv'in göbek adı (Yeşil)"
	quest.3F68BA498E877C8C.title: "&aGreen Xychorium Gems"
	quest.43F08B510FC1C06F.quest_desc: ["Item IO'lar, eşyaları Tankın içine ve dışına taşıma olanağı verir. Çıktı (Output) ve Girdi (Input) olarak değiştirilebilirler."]
	quest.43F08B510FC1C06F.quest_subtitle: "Eşyaların gelip gittiği yer"
	quest.43F08B510FC1C06F.title: "Item IO'lar"
	quest.4A92237E17ED5F1C.quest_desc: ["Void Container herhangi bir envanteri bir Çöp Kutusuna dönüştürür. Envanterin üzerine koyun ve artık o eşyalar yok!"]
	quest.5E1D4169C083ACEF.quest_desc: ["&cIgnition Plate&r bir Redstone Sinyali verildiğinde önünde ateş oluşturur.\\n\\nSinyal durduğunda ateşi söndürecektir."]
	quest.5E1D4169C083ACEF.title: "&cIgnition Plate"
	quest.623E6A855B363C8D.quest_desc: ["&9Water Block&r, hareket eden kısmı olmadan normal bir Water (Su) gibi davranır.\\n\\nOnunla Cobble Gen'ler (Kırıktaş Üreticileri) yapılabilir, Farmland (Tarım Arazisi) sulanabilir, sadece onunla MLG clutch yapamazsınız. (Balıklar da içine girmeye çalışacak ancak yine de öleceklerdir)."]
	quest.623E6A855B363C8D.quest_subtitle: "Su ama Katı, Buz?"
	quest.623E6A855B363C8D.title: "&9Water Block"
	quest.643FB1A3ED0EA9EC.quest_desc: ["Valve Tankınızın Kalbidir. Burası sıvıları içine pompalayacağınız veya borulayacağınız yerdir."]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Sıvının gelip gittiği yer"
	quest.643FB1A3ED0EA9EC.title: "Valfler (Valves)"
	quest.64D0D69ADB8820DA.quest_desc: ["&8Fluid Void&r, kendisine bağlı tüm suları durduran bir bloktur.\\n\\nKaynak bloklar veya akan su, 1 blokluk bir yarıçap içindeki her şey yok olur."]
	quest.64D0D69ADB8820DA.title: "&8Fluid Void"
	quest.69F11A94D44AB5CF.quest_subtitle: "Çok fazla ışık!"
	quest.69F11A94D44AB5CF.title: "&fLight Xychorium Gems"
	quest.6D0876A402C22067.quest_desc: ["XyCraft bazı eşya depolama ve manipülasyon özelliklerine sahiptir. Yine de sıvı depolama ve manipülasyon kadar değil!"]
	quest.6D0876A402C22067.title: "&6Eşya Depolama ve Manipülasyon"
	quest.71D133BA3EC6F4FD.quest_desc: ["Extractor altındaki bloğu veya öğeyi \"büyütecek\" ve üstündeki bir envantere taşıyacaktır.\\n\\nBu, birçok türdeki taşla çalışan bir Cobblestone üreticisi, bir Amethyst üreticisi veya hatta bir Dragon Egg üreticisi ve diğerleri için kullanılabilir!"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Taşlar için Çiftçilik! (ve Daha Fazlası)"
	quest.7574A782DCFB87CE.quest_desc: ["Kivi birkaç şey için, çoğunlukla dekorasyonlar ve makineler için kullanılabilir.\\n\\nMachine Frames ve XyCraft'taki diğer makineler için Kivi'ye ihtiyacınız olacak. Dekoratif bloklar için bir Stonecutter'da Xychorium Gems ile birlikte kullanılabilir."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	task.4EEF358CAC170CC4.title: "Xychorium Gems"
	task.55DD09212E3DB168.title: "Fluid Pipes"
	task.706FA543A6C675D3.title: "Tüm Hakları Saklıdır"
}
