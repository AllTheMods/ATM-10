{
	chapter.219B7A003658D24F.title: "XyCraft"
	chapter_group.2B51AC12041E3F89.title: "Teknoloji"
	quest.030AC1AF8F735550.quest_desc: ["Tanka sıvı aktarmak için bir boru sistemine ihtiyacınız olacak.\\n\\nHydro Pump, suyu borulara yavaş bir hızda ama tamamen ücretsiz ve otomatik olarak aktarır!"]
	quest.030AC1AF8F735550.title: "Borular"
	quest.06B85804163DD18B.quest_desc: ["Soaryn Box (Soaryn, XyCraft'ın geliştiricisidir), modun özel depolama sandığıdır.\\n\\nBlok kırıldığında içindeki eşyaları muhafaza etmez! Acaba üzerindeki o kareler ne işe yarıyor?"]
	quest.08E484DD3E751697.quest_subtitle: "Gökkuşağının Mavisi"
	quest.08E484DD3E751697.title: "&bMavi Xychorium Taşları"
	quest.0D01524F249E25D7.quest_subtitle: "Kim kapattı ışıkları?"
	quest.0D01524F249E25D7.title: "&8Koyu Xychorium Taşları"
	quest.15540271BF17C2E4.quest_desc: ["&lXyCraft'a Hoş Geldiniz!&r\\n\\nBu mod serisi temel olarak XyCraft: World ve Machines modlarına adanmıştır.\\nWorld modu, maden kazarken bulabileceğiniz Xychorium taşlarını sağlar."]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.16B4A00948D1F60D.quest_desc: ["Bu görev, AllTheMods mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2topluluk üyesi&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı altında olduğundan, bu görevin açık izin olmaksızın &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir herkese açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir; bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.1A96C595CBA42840.quest_desc: ["Kivi Tohumları, Kivi'ye dönüştürülebilen Kivi Özü yetiştirmek için kullanılır!"]
	quest.1A96C595CBA42840.title: "Kivi Otomasyonu"
	quest.1E00DBAACDF4404F.quest_desc: ["Collector, oldukça uygun maliyetli bir Absorption Hopper işlevi görür.\\n\\n3 blokluk yarıçaptaki tüm eşyaları toplayarak altındaki envantere veya kendi hazinesine aktarır. Kızıltaş sinyali ile devre dışı bırakılabilir!"]
	quest.2278A98DCDF713D7.quest_desc: ["Şimdi tank inşa etme zamanı! Öncelikle yapı bloklarına ve en az 1 Vana'ya ihtiyacınız var. Cam ve Item IO blokları isteğe bağlıdır.\\n\\nTankın iskeleti yapı bloklarından oluşmalıdır. Şeffaf olmayan, yerçekiminden etkilenmeyen ve doğal Toprak ya da Çim olmayan herhangi bir blok yapı bloğu olarak kullanılabilir.\\n\\nTaş, odun veya metal gibi bloklar iskeleti ve köşeleri oluşturmalıdır. Cam, Vana ve Item IO'lar duvarlara yerleştirilmeli, yapının içi boş bırakılmalıdır.\\n\\nBoyutları en fazla 13x13x13 olabilir. Tüm şartları sağladıktan sonra Vana'ya sağ tıkladığınızda 'Formed' (Oluşturuldu) yazısını görürsünüz ya da eksik bir şey varsa hatayı bildirir."]
	quest.2278A98DCDF713D7.title: "&lTank"
	quest.2AC7BC448C007BDB.quest_desc: ["Kivi'yi alüminyum ile güçlendirdiğinizde, makine üretimi için gereken Makine Kasalarını (Machine Frame) elde edersiniz."]
	quest.2B5E14A47062F83C.quest_subtitle: "Gökkuşağının Kırmızısı"
	quest.2B5E14A47062F83C.title: "&cKırmızı Xychorium Taşları"
	quest.2C4ECA4F5B1639F4.quest_desc: ["Light Field pek fazla ışık yaymaz ancak tam bir Mega Meşale görevi görür.\\n\\nYaratıklar etrafındaki 32 blokluk yarıçap içinde doğamaz."]
	quest.2C4ECA4F5B1639F4.title: "&fLight Field"
	quest.2C7D62231AD6406A.quest_desc: ["XyCraft, harika bir Sıvı Tankı çoklu bloğuna sahiptir!"]
	quest.2C7D62231AD6406A.title: "&bSıvı Depolama ve Yönetimi"
	quest.355244420EA47546.quest_desc: ["Fabricator, otomatik bir üretim tezgahıdır. Altındaki envanterden eşyaları çekerek belirlenen tarifi üretir.\\n\\nTarifleri kilitlemek için Ctrl ile tıklayabilirsiniz. Üretilen eşyaların dışarı aktarılması gerekir."]
	quest.355244420EA47546.quest_subtitle: "Otomatik Üretici"
	quest.39E4FC9BA89E44BC.quest_desc: ["Balloon on a Stick, oyunun başında kısıtlı bir Yaratıcı Mod uçuşu sağlar.\\n\\nÇubuğu yere yerleştirdiğinizde bir balona bağlanırsınız! Çok uzaklaşmamak kaydıyla uçmaya başlamak için boşluk tuşuna çift dokunmanız yeterlidir. Çok uzağa giderseniz ip kopar ve düşersiniz."]
	quest.39E4FC9BA89E44BC.quest_subtitle: "Yukarı!"
	quest.3E970E76372AB094.quest_desc: ["&2Accelerated Planter&r, normal tarım arazisi gibi işlev görür ancak bazı avantajları vardır.\\n\\nOtomatik olarak sulanır ve ürünleri normal tarım arazisine kıyasla daha hızlı yetiştirir."]
	quest.3E970E76372AB094.title: "&2Accelerated Planter"
	quest.3F68BA498E877C8C.quest_subtitle: "Gökkuşağının Yeşili"
	quest.3F68BA498E877C8C.title: "&aYeşil Xychorium Taşları"
	quest.43F08B510FC1C06F.quest_desc: ["Item IO blokları, eşyaları tankın içine aktarmanızı veya dışarı çekmenizi sağlar. Girdi veya çıktı modları arasında geçiş yapılabilir."]
	quest.43F08B510FC1C06F.quest_subtitle: "Eşya Giriş ve Çıkış Noktası"
	quest.43F08B510FC1C06F.title: "Item IO Blokları"
	quest.4A92237E17ED5F1C.quest_desc: ["Void Container, bağlandığı envanteri bir çöp kutusuna dönüştürür. Envanterin üzerine yerleştirdiğiniz andan itibaren içine giren eşyalara veda edebilirsiniz!"]
	quest.5E1D4169C083ACEF.quest_desc: ["&cIgnition Plate&r, bir kızıltaş sinyali aldığında hemen önünde ateş yakar.\\n\\nSinyal kesildiğinde ise ateşi otomatik olarak söndürür."]
	quest.5E1D4169C083ACEF.title: "&cIgnition Plate"
	quest.623E6A855B363C8D.quest_desc: ["&9Water Block&r, tamamen akışsız sabit bir su kütlesi gibi davranır.\\n\\nBu blokla kırıktaş üreteci yapabilir ve tarım arazilerini sulayabilirsiniz; ancak yüksekten düşerken hayat kurtarma (MLG) amacıyla kullanamazsınız. (Ayrıca balıklar içine girmeye çalışsa da yaşayamazlar)."]
	quest.623E6A855B363C8D.quest_subtitle: "Katı Su, Buz?"
	quest.623E6A855B363C8D.title: "&9Water Block"
	quest.643FB1A3ED0EA9EC.quest_desc: ["Vana, tankınızın kalbidir. Sıvıları tanka pompalamak veya dışarı aktarmak için burayı kullanırsınız."]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Sıvı Giriş ve Çıkış Noktası"
	quest.643FB1A3ED0EA9EC.title: "Vanalar (Valves)"
	quest.64D0D69ADB8820DA.quest_desc: ["&8Fluid Void&r, temas ettiği tüm sıvıları yok eden bir bloktur.\\n\\nKaynak bloğu veya akan su fark etmeksizen, 1 blokluk yarıçapındaki tüm sıvıları ortadan kaldırır."]
	quest.64D0D69ADB8820DA.title: "&8Fluid Void"
	quest.69F11A94D44AB5CF.quest_subtitle: "Çok fazla ışık!"
	quest.69F11A94D44AB5CF.title: "&fAçık Xychorium Taşları"
	quest.6D0876A402C22067.quest_desc: ["XyCraft, eşya depolama ve yönetimi imkanı da sunar. Ancak sıvı depolama çözümleri kadar kapsamlı değildir."]
	quest.6D0876A402C22067.title: "&6Eşya Depolama ve Yönetimi"
	quest.71D133BA3EC6F4FD.quest_desc: ["Extractor, altındaki bloğu veya eşyayı \"çoğaltarak\" üstündeki envantere aktarır.\\n\\nBu mekanizma; çeşitli taş türleri için kırıktaş üreteci, ametist çiftliği ve hatta Ejderha Yumurtası çoğaltıcı gibi birçok otomasyon için kullanılabilir!"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Kaya Toplama Çiftliği! (ve Dahası)"
	quest.7574A782DCFB87CE.quest_desc: ["Kivi, başta dekorasyon ve makine yapımı olmak üzere çeşitli alanlarda kullanılır.\\n\\nXyCraft'taki makine kasaları ve diğer cihazlar için Kivi gereklidir. Ayrıca taş kesicide Xychorium taşlarıyla birleştirilerek dekoratif bloklar üretilebilir."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	task.4EEF358CAC170CC4.title: "Xychorium Taşları"
	task.55DD09212E3DB168.title: "Sıvı Boruları"
	task.706FA543A6C675D3.title: "Tüm Hakları Saklıdır"
}