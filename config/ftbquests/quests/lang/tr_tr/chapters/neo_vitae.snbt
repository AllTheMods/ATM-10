{
	quest.02B5E57E9E803F78.quest_desc: [
		"Sentient zırh vücudunu kaplar ve öğrenir. Aletler gibi seviye atlar."
		""
		"Sentient silah setini tamamlayan isteğe bağlı bir ekipman serisi."
	]
	quest.02B5E57E9E803F78.quest_subtitle: "Kendi fikri olan zırh"
	quest.02B5E57E9E803F78.title: "Duyarlı Kabuk"
	quest.02DF776F9A4C9CB1.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Pestis&r kol geziyor: diyardaki on türden biri olan veba taşıyıcısı."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.02DF776F9A4C9CB1.quest_subtitle: "Diyardaki on türden biri"
	quest.02DF776F9A4C9CB1.title: "Daemonium Pestis"
	quest.07C69759A6163F2D.quest_desc: [
		"Hava, toprak, ateş ve Deus elementlerine ait ritüel taşları bir &6Master Ritual Stone&r çevresine yerleştirilir. Etkiyi taşların dizilimi belirler."
		""
		"Ana taşı ve her elementten bir miktar taş üret."
	]
	quest.07C69759A6163F2D.quest_subtitle: "Ritüeli dizilim belirler"
	quest.07C69759A6163F2D.title: "Taşlar ve Ana Taş"
	quest.09DEA44456CD5010.quest_desc: [
		"Kademe II ritüeli &6Breaching the Edge of Demon Realm&r, perdeyi yarar ve geride bir &lInversion Pillar&r bırakır. Geçmek için ona dokun."
		""
		"Bu, Demon Realm'in sistemi öğrenmene ayrılmış küçük bölgesi &6Antechamber&r'a açılan kapıdır."
	]
	quest.09DEA44456CD5010.quest_subtitle: "Perdeyi Kademe II yarar"
	quest.09DEA44456CD5010.title: "Perdeyi Yarmak"
	quest.0ACA535425EA6A81.quest_desc: [
		"Her ritüel başlatılmak için bir &6Activation Crystal&r ister: düşük kademeli ayinler için Weak, Deus taşlarıyla kurulan güçlü ritüeller için Awakened ve Divinus."
		""
		"Weak kristali erken aşamada elde edilir ve ucuzdur. Daha güçlü olanlar için diyarda ilerlemek gerekir. İsteğe bağlı."
	]
	quest.0ACA535425EA6A81.quest_subtitle: "Bir bakıma ritüel anahtarları"
	quest.0ACA535425EA6A81.title: "Etkinleştirme Kristalleri"
	quest.0BA0AA8A6F07D383.quest_desc: [
		"Tabula Vitae'de veya altarda bir &6Arcane Scribe Tool&r üret. Simya düzeneklerini oluşturan çemberleri bu araç çizer."
		""
		"Onunla yere vur ve çizgilerin parlamasını izle."
	]
	quest.0BA0AA8A6F07D383.quest_subtitle: "Güç tebeşiri"
	quest.0BA0AA8A6F07D383.title: "Yazıcının Aracı"
	quest.0E3971A4FB822ED0.quest_desc: [
		"Altarın halkaları tamam, küreler bağlı, aura canlı, diyar fethedildi: Vitaemancy'nin sunduğu bütün araçlar elinde."
		""
		"Bölüm burada biter. Mod ise devam eder; ağ, ritüeller ve zindan kazandırmayı sürdürür."
	]
	quest.0E3971A4FB822ED0.quest_subtitle: "Zirve bir yaşam biçimidir"
	quest.0E3971A4FB822ED0.title: "Vitaemancy Ustası"
	quest.11721D2D8F03C20F.quest_desc: [
		"Bir &6Petty Spiritus Gem&r, 64 Spiritus depolar ve yakınlara düşen serbest zerreleri toplar."
		""
		"Sonraki kademeler (Lesser 256, Common 1.024, Greater 4.096, Grand 16.384), bir önceki kademedeki mücevher kullanılarak üretilir."
	]
	quest.11721D2D8F03C20F.quest_subtitle: "64 küçük ruh"
	quest.11721D2D8F03C20F.title: "Petty Spiritus Gem"
	quest.11F6669733F1420B.quest_desc: [
		"&6Magus Orb&r: Anima için &l1,000,000 EV&r. Yedi haneli bir rezerv."
		""
		"Ritüellerin bedelleri bu küre esas alınarak belirlenmiştir."
	]
	quest.11F6669733F1420B.quest_subtitle: "Yedi haneli ruh"
	quest.11F6669733F1420B.title: "Ustanın Küresi"
	quest.16F8403D1836717A.quest_desc: [
		"Herhangi bir küreyi &likinci elinde&r tut ve kullanma tuşuna bas: önünde kristal bir kalkan yükselir ve uzaktan gelen saldırıları durdurur: oklar, üçlü mızraklar, ateş topları."
		""
		"Saniyede 50 EV tüketir ve yalnızca uzaktan gelen tehditleri engeller. Yakın dövüş saldırıları doğrudan geçer. İsteğe bağlı."
	]
	quest.16F8403D1836717A.quest_subtitle: "Oklara geçit yok"
	quest.16F8403D1836717A.title: "Sanguine Ward"
	quest.18CD5EBD9682E855.quest_desc: [
		"Kademe IV rünleri değerleri ciddi ölçüde değiştirir: Speed IV, Capacity IV ve kurban çarpanları."
		""
		"Sağladıkları kazanç arttıkça başlangıç maliyeti de yükselir."
	]
	quest.18CD5EBD9682E855.quest_subtitle: "Speed IV, Capacity IV"
	quest.18CD5EBD9682E855.title: "Kademe IV: Dördüncü Halka"
	quest.19891A8F26FBAB0A.quest_desc: [
		"&6Divination Sigil&r, altarının ve Anima'nın durumunu gösterir: doluluk seviyesi, yürütülen işlem ve altarın eksikleri."
		""
		"Sistemi öğrenirken yanında bir tane taşı."
	]
	quest.19891A8F26FBAB0A.quest_subtitle: "Dedikoducu mühür"
	quest.19891A8F26FBAB0A.title: "Düzeneğin Gözleri"
	quest.1B6642BBDAEB2BD5.quest_desc: [
		"&6Veneficus Orb&r, kapasite sınırını &l150,000 EV&r'ye çıkarır. Bu noktadan sonra ritüeller ve Athanor işlemleri hızla pahalılaşır."
		""
		"Toplamaya devam et; eski küreler de sorunsuzca dolmaya devam eder."
	]
	quest.1B6642BBDAEB2BD5.quest_subtitle: "Altı hane"
	quest.1B6642BBDAEB2BD5.title: "Büyücünün Küresi"
	quest.1BBABB2106D321A4.quest_desc: [
		"Küreni altarın yanındaki bir &6Orb Filling Link&r içine yerleştir; ağ, Anima'nı sürekli doldursun."
		""
		"Ritüelleri elini sürmeden beslemenin yolu. İsteğe bağlı."
	]
	quest.1BBABB2106D321A4.quest_subtitle: "Elini sürmeden ruh doldurma"
	quest.1BBABB2106D321A4.title: "Küre Bağlantısı"
	quest.1C43D98AB4E51F15.quest_desc: [
		"&6Incense Altar&r, huzur sağlayan bloklarla düzenlenmiş bir bahçeye yerleştirilir. Kendi sunduğun kana büyük bir bonus sağlayan &6Blessed Sacrifice&r etkisini verir."
		""
		"Çevresine halka biçiminde yollar ve huzur sağlayan bloklar yerleştir; bahçe planlama sitesi hesaplamaları gösterir."
	]
	quest.1C43D98AB4E51F15.quest_subtitle: "Zafer kokusu"
	quest.1C43D98AB4E51F15.title: "Tütsü Altarı"
	quest.1CBBEFE4A84ABA45.quest_desc: [
		"Bir &6Spiritus Conduit&r, her ana yönde 16 blok tarar ve Aura'yı yoğunluğun yüksek olduğu yerden düşük olduğu yere çeker; seviyeleri dengeler, kaynağı hiçbir zaman tamamen tüketmez."
		""
		"Doygun bir chunk'tan çalışma alanına kadar bunları zincir hâlinde bağla. İsteğe bağlı."
	]
	quest.1CBBEFE4A84ABA45.quest_subtitle: "Ürkütücü bir tesisat"
	quest.1CBBEFE4A84ABA45.title: "Aura'yı Taşımak"
	quest.1F7ACF813D8804A6.quest_desc: [
		"Bir &6Alchemy Array&r, çemberin içine atılan iki sunuyu kabul eder. Bazı eşleşmeler eşya üretir, bazıları ise oldukları yerde etkileri tetikler."
		""
		"İlk mührün olan &6Divination Sigil&r, bir düzenek tarifiyle üretilir."
	]
	quest.1F7ACF813D8804A6.quest_subtitle: "İki sunu, bir dilek"
	quest.1F7ACF813D8804A6.title: "Niyet Çemberi"
	quest.22CB17C102BB6773.quest_desc: [
		"Eve dönünce Tau Fruit'i Saturated Tau ve Tau Oil'e dönüştür; tütsü bahçesi bunları tüketir."
		""
		"Yağ, daha iyi şişelerin hazırlanmasında da reaktif olarak kullanılır."
	]
	quest.22CB17C102BB6773.quest_subtitle: "Bahçe yakıtı"
	quest.22CB17C102BB6773.title: "Tau'yu Arıtmak"
	quest.22D7D3FBACEBE7FB.quest_desc: [
		"&6Necromancy&r mühürleri, sen geri gönderene kadar senin için savaşan kalıntı, iskelet ve serseri hizmetkârlar diriltir."
		""
		"Aktif kaldıkları sürece Anima tüketirler. İsteğe bağlı."
	]
	quest.22D7D3FBACEBE7FB.quest_subtitle: "Ayın çalışanı: ölüler"
	quest.22D7D3FBACEBE7FB.title: "Hizmet Eden Ölüler"
	quest.2355A35C8F4C6A30.quest_desc: [
		"Üçüncü halka, daha yüksek rün kademelerini ve bunlara bağlı tarifleri açar."
		""
		"Bu noktadan sonra altar gerçek bir fabrikaya dönüşür."
	]
	quest.2355A35C8F4C6A30.quest_subtitle: "Fabrikanın kapıları açıldı"
	quest.2355A35C8F4C6A30.title: "Kademe III: Daha Derindeki Rünler"
	quest.24C0619EB4A13CA3.quest_desc: [
		"&6Yönlendirme düğümleri&r giriş ve çıkışları belirler; kanallar akışı taşır; bir &6Master Routing Node&r ise akışı yönetir."
		""
		"Küçük başla: bir üretici, bir tüketici. İsteğe bağlı."
	]
	quest.24C0619EB4A13CA3.quest_subtitle: "Ürkütücü bir tesisat"
	quest.24C0619EB4A13CA3.title: "Damarları Döşemek"
	quest.2774F4E92DC99642.quest_desc: [
		"Blessed Sacrifice, sağ tıklayarak sunduğun her kanın değerini büyük ölçüde artırır. Ardından seni &lSoul Fray&r etkisine sokar; bu bekleme süresi, sonraki sunuların verimini düşürür."
		""
		"Döngüyü uygula: kutsan, kan sun, dinlen. İsteğe bağlı."
	]
	quest.2774F4E92DC99642.quest_subtitle: "Zafer kokusu"
	quest.2774F4E92DC99642.title: "Soul Fray"
	quest.298458E916F65407.quest_desc: [
		"Aura &lchunk bazlıdır&r: bir chunk'ta yakılan Spiritus yalnızca o chunk'ı doldurur ve her Aspect için 100 ile sınırlıdır."
		""
		"Oyunun orta aşamasındaki makinelerin neredeyse tamamı, çantandaki kaynağı değil yerel Aura'yı tüketir."
	]
	quest.298458E916F65407.quest_subtitle: "Yerel hava perili"
	quest.298458E916F65407.title: "Dünyalar Arasındaki Aura"
	quest.29953F9E8F0A0D7B.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Cruoris&r kol geziyor: diyardaki on türden biri olan kan avcısı."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.29953F9E8F0A0D7B.quest_subtitle: "Diyardaki on türden biri"
	quest.29953F9E8F0A0D7B.title: "Daemonium Cruoris"
	quest.29B003254299103C.quest_desc: [
		"Greater ve Grand mücevherleri, koca rezervleri envanterde tek bir yuvaya sığdırır."
		""
		"Greater kademesi bir Tabula Spiritus, bir Weak Blood Shard ve bir Spiritus Crystal ister. İsteğe bağlı."
	]
	quest.29B003254299103C.quest_subtitle: "Daha büyük şişeler"
	quest.29B003254299103C.title: "Basamakları Tırmanmak"
	quest.2C0A6D0EC40C766A.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Ignis&r kol geziyor: diyardaki on türden biri olan yanan iblis."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.2C0A6D0EC40C766A.quest_subtitle: "Diyardaki on türden biri"
	quest.2C0A6D0EC40C766A.title: "Daemonium Ignis"
	quest.2C178EF05E31AE9A.quest_desc: [
		"İçerideki her &6Dungeon Seal&r bir &lSimple Dungeon Key&r ister: bu anahtar yalnızca buradaki sandıklarda bulunur, asla üretilmez. Dışarıdan getirdiğin bir anahtar hiçbir şeyi açmaz."
		""
		"Buradaki sandıklardan büyülü ekipman, anointment'lar, Spiritus ve ilk Tau mahsulleri çıkar."
	]
	quest.2C178EF05E31AE9A.quest_subtitle: "Anahtarlar üretilmez, ganimet olarak bulunur"
	quest.2C178EF05E31AE9A.title: "Antechamber"
	quest.2E22A601DC126B7B.quest_desc: [
		"&6Spiritus&r ikinci ekonomidir: kan yerine ruh para birimi kullanılır. Hançerle işaretlenen yaratıkları öldürerek veya Sentient bıçaklarla elde edilir."
		""
		"Serbest Spiritus ortalığı doldurur; onu saklamak için bir mücevher gerekir."
	]
	quest.2E22A601DC126B7B.quest_subtitle: "İkinci cüzdan"
	quest.2E22A601DC126B7B.title: "Yoktan Kristaller"
	quest.332F3C08E4014F63.quest_desc: [
		"&6Spirit Accumulator&r, tek bir Aspect'ten 1,000 Spiritus tutan, havada süzülen bir rezervdir. Yönlendirme ağı bu rezervden yararlanabilir."
		""
		"Athanor bunu bir Animus Mote, bir Common Gem, bir Tabula Spiritus, bir Raw parçası, bir Blood Tank ve 2,000 mB EV kullanarak üretir. İşlemin yapıldığı chunk'ta 45 Raw bulunmalıdır."
	]
	quest.332F3C08E4014F63.quest_subtitle: "Depoda bin"
	quest.332F3C08E4014F63.title: "Spirit Accumulator"
	quest.3617A216FF8BC06C.quest_desc: [
		"Zindan her yolculukta yeni bir yapboz gibi yeniden kurulur: odalar aynı, harita farklıdır."
		""
		"&6Spatial Distortions&r oluşumlarına dikkat et: boşluk dokunaçlarıyla dolu bu odalar, Mines girişini veya Foreman'in kapısını gizler. Ortaya çıktıklarında diyarın kendisi seni uyarır."
	]
	quest.3617A216FF8BC06C.quest_subtitle: "Aynı odalar, yeni dehşet"
	quest.3617A216FF8BC06C.title: "Endless Realm"
	quest.36BA45620B2BED5B.quest_desc: [
		"&6Runes of the Orb&r, Anima kapasiteni Divinus Orb'un bile izin verdiği sınırın ötesine taşır."
		""
		"En üst kademedeki küre bile yetmiyorsa sıradaki seçeneğin budur. İsteğe bağlı."
	]
	quest.36BA45620B2BED5B.quest_subtitle: "Bataryayı genişlet"
	quest.36BA45620B2BED5B.title: "Küre Rünleri"
	quest.383F7F715C60252B.quest_desc: [
		"Kademe II, altarı yeniden genişletir. Daha fazla rün yuvası, ilk gerçek düzenini kurmanı sağlar: Speed ve Capacity rünlerinden işe yarayan bir karışım."
		""
		"Ayrıca modun orta aşamasına geçişi sağlayan altar tariflerini açar."
	]
	quest.383F7F715C60252B.quest_subtitle: "Büyük hedeflere daha çok yer"
	quest.383F7F715C60252B.title: "Kademe II: İkinci Halka"
	quest.3CA324BE8531F253.quest_desc: [
		"&6Weak Blood Shard&r, Athanor'da üretilir; makineyi kurduktan sonra elde edebilirsin."
		""
		"Greater Gem'e ve onun üzerindeki tariflere erişim sağlar."
	]
	quest.3CA324BE8531F253.quest_subtitle: "Küçük parça, büyük kapılar"
	quest.3CA324BE8531F253.title: "Weak Blood Shard (Zayıf Kan Parçası)"
	quest.3E563EED3D77FC35.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Animaris&r kol geziyor: diyardaki on türden biri olan, ruh Aspect'ine sahip avcı."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.3E563EED3D77FC35.quest_subtitle: "Diyardaki on türden biri"
	quest.3E563EED3D77FC35.title: "Daemonium Animaris"
	quest.3EC65211B94462DA.quest_desc: [
		"&6Animus Mote&r yalnızca diyardaki ganimetlerden çıkar. Spirit Accumulator'ın üretilmesi için vazgeçilmez bir parçadır."
		""
		"Bulduğun her birini sakla. İsteğe bağlı bir hatırlatma."
	]
	quest.3EC65211B94462DA.quest_subtitle: "Nadir ganimet, kaybetme"
	quest.3EC65211B94462DA.title: "Animus Mote"
	quest.3ECB062B99C4E4A5.quest_desc: [
		"&6Teleposer&r, işaretlenen iki noktadaki blokların yerini değiştirir veya seni bu noktalar arasında taşır."
		""
		"İlerleyen aşamalarda oluşturucuları, ekinleri ve kendini taşımaya yarar. İsteğe bağlı."
	]
	quest.3ECB062B99C4E4A5.quest_subtitle: "Taşınma günü, büyülü usulle"
	quest.3ECB062B99C4E4A5.title: "Teleposer"
	quest.3F2FE793CE5052F0.quest_desc: [
		"&6Routing Network&r modun lojistik sistemidir: makineler arasında eşya, sıvı ve Spiritus taşıyan düğümler, kanallar ve yönlendiricilerden oluşur."
		""
		"Altarın, potanın ve mücevherlerin sana ihtiyaç duymadan çalışmasını sağlar."
	]
	quest.3F2FE793CE5052F0.quest_subtitle: "Kendi fikri olan borular"
	quest.3F2FE793CE5052F0.title: "Yönlendirme Ağı"
	quest.40C32A4F6DE4B782.quest_desc: [
		"&6Athanor&r üçüncü büyük tezgâhtır: Aura'nın beslediği parçaları, akümülatörleri ve ileri düzey reaktifleri hazırlayan bir pota."
		""
		"Aynı anda EV, Aura ve malzeme ister. Çalıştırmadan önce göstergeyi kontrol et."
	]
	quest.40C32A4F6DE4B782.quest_subtitle: "Üç numaralı tezgâh"
	quest.40C32A4F6DE4B782.title: "Athanor"
	quest.419DB4A2A5A5FC58.quest_desc: [
		"Derinlerdeki işletmeyi &6Foreman&r yönetir. Diyarın patron savaşı onunladır."
		""
		"Değerli ganimetler için onu öldür: Demonite ve Hellforged üretiminde kullanılan parçalar."
	]
	quest.419DB4A2A5A5FC58.quest_subtitle: "Buranın yöneticisi"
	quest.419DB4A2A5A5FC58.title: "Ustabaşı"
	quest.4393ADF3E4C8B0D4.quest_desc: [
		"Spiritus'un beş Aspect'i vardır: &6Raw, Ruina, Invictus, Nihilum, Vindicta&r. Farklı işlemler farklı Aspect'ler gerektirir."
		""
		"Aura bunları ayrı ayrı sayar; belirli bir Aspect ile çalışmanın ilk adımı, bir chunk'ı o Aspect ile doyurmaktır. İsteğe bağlı bir ders."
	]
	quest.4393ADF3E4C8B0D4.quest_subtitle: "Bir çeşit seç"
	quest.4393ADF3E4C8B0D4.title: "Beş Aspect"
	quest.4476319FD2019185.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Voraxis&r kol geziyor: diyardaki on türden biri olan, hiç doymayan iblis."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.4476319FD2019185.quest_subtitle: "Diyardaki on türden biri"
	quest.4476319FD2019185.title: "Daemonium Voraxis"
	quest.44DC32A27B02CDB8.quest_desc: [
		"&6Holding&r ve &6Bound Treasures&r, mührünü ek ceplere dönüştürür."
		""
		"Çantanın hızla dolduğu uzun zindan keşiflerinde kullanışlıdır. İsteğe bağlı."
	]
	quest.44DC32A27B02CDB8.quest_subtitle: "Büyülü cepler"
	quest.44DC32A27B02CDB8.title: "Taşınabilir Depolama"
	quest.459F6257FB16AC47.quest_desc: [
		"Son halka Ara Vitae'yi tamamlar. Artık her rün ailesi en yüksek kademesine yerleştirilebilir."
		""
		"Tek bir blokla başladığın altar artık bir katedraldir."
		""
		"Tek bir blokla başladığın altar artık bir katedraldir."
	]
	quest.459F6257FB16AC47.quest_subtitle: "Rünlerden bir katedral"
	quest.459F6257FB16AC47.title: "Kademe V: Son Halka"
	quest.46122A9389875512.quest_desc: [
		"&6Ritüeller&r, bir Master Ritual Stone çevresine ritüel taşlarıyla çizilen düzenlerdir. Tarım işlerinden diyara geçit açmaya kadar, tek seferde büyük etkiler oluştururlar."
		""
		"Ritual Designer bunları planlar; Diviner ise bir dizilimin neler gerektirdiğini söyler."
	]
	quest.46122A9389875512.quest_subtitle: "Büyük etkiler, daha büyük çizimler"
	quest.46122A9389875512.title: "Ayinler ve Ritüeller"
	quest.4694863405CFB97B.quest_desc: [
		"&6Mines&r, diyarın derinlerdeki kademesidir: maden anahtarı isteyen kapılar, daha zorlu Daemonium'lar ve uğruna gelmeye değen cevherler."
		""
		"Maden anahtarları Endless Realm ganimetlerinden çıkar."
	]
	quest.4694863405CFB97B.quest_subtitle: "Değerli cevherin bulunduğu yer"
	quest.4694863405CFB97B.title: "Madenler"
	quest.4840F41B536529E3.quest_desc: [
		"Bir &6Tipped Throwing Dagger&r, bıçağında anointment taşır: tek atışta, üzerine sürülen etkiyi hedefe uygular."
		""
		"İkinci bir hançer için yerinde durmayan hedefleri zayıflatmaya yarar. İsteğe bağlı."
	]
	quest.4840F41B536529E3.quest_subtitle: "Üzerine sür"
	quest.4840F41B536529E3.title: "Daha Keskin Bir Uç"
	quest.499B8461225D3E74.quest_desc: [
		"Tabula, &6Anointments&r hazırlar: bir süreliğine iş görmek üzere bıçaklara ve aletlere sürülen geçici büyüler."
		""
		"Bir patron savaşı için Keskinlik, bir maden yolculuğu için Servet. İsteğe bağlı."
	]
	quest.499B8461225D3E74.quest_subtitle: "Geçici keskinlik"
	quest.499B8461225D3E74.title: "Anointments"
	quest.4AE0C2D2D8D145F6.quest_desc: [
		"Derine indikçe diyar zenginleşir: daha derindeki mühürler, daha iyi sandıklar, zerre ve patron."
		""
		"Zorlu kısım için isteğe bağlı bir rota. İsteğe bağlı."
	]
	quest.4AE0C2D2D8D145F6.quest_subtitle: "Anahtarlar üretilmez, ganimet olarak bulunur"
	quest.4AE0C2D2D8D145F6.title: "Derinlerde Çalışmak"
	quest.4EBC5B191A7B12D9.quest_desc: [
		"Rünler altarı çevreler ve her rün ailesi onu değiştirir: Speed, Capacity, Sacrifice, Orb ve daha fazlası. Hepsi &6Blank Runes&r olarak başlar."
		""
		"Bir miktar üret; sonraki halkalarda bunlara ihtiyacın olacak."
		""
		"Şimdiden bir miktar üret; sonraki halkalarda bunlara ihtiyacın olacak."
	]
	quest.4EBC5B191A7B12D9.quest_subtitle: "Her katedralin tuğlaya ihtiyacı vardır"
	quest.4EBC5B191A7B12D9.title: "Boş Rünler"
	quest.4EE580588CC10C4E.quest_desc: [
		"&6Demonite&r diyarın derinliklerinden çıkar: diyarın kendi metaline ait çakıl, parçalar ve ham kütleler."
		""
		"Oyunun son aşamasındaki tüm işlemler bu cevher etrafında döner."
	]
	quest.4EE580588CC10C4E.quest_subtitle: "Diyarın kendi metali"
	quest.4EE580588CC10C4E.title: "Demonite"
	quest.4F77EDCEB49EB67F.quest_desc: [
		"Küre rünleri ve altar hızı birbirlerinin etkisini artırır. Tamamen geliştirilmiş bir halka, Divinus seviyesindeki tüketime bile yetişir."
		""
		"Sabırlı oyuncular için isteğe bağlı bir ince ayar. İsteğe bağlı."
	]
	quest.4F77EDCEB49EB67F.quest_subtitle: "Bileşik faiz, kan sürümü"
	quest.4F77EDCEB49EB67F.title: "Rünlerin Etkisini İkiye Katlamak"
	quest.538E28637FF76912.quest_desc: ["Bu Görev, AllTheMods mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2topluluk katılımcısı&r tarafından hazırlanmıştır. \\\\n\\\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin açık izin olmaksızın &6AllTheMods Ekibi&r tarafından yayımlanmayan herhangi bir herkese açık pakette kullanılmasına izin verilmez. \\\\n\\\\nBu görev bilerek gizlenmiştir; bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.538E28637FF76912.title: "Tüm Hakları Saklıdır"
	quest.54AB11938676D4C7.quest_desc: [
		"Tezgâh, reaktiflerle işleyerek yaygın cevherlerin verimini ikiye katlar: demir, altın, bakır ve benzerleri girer, iki kat ürün çıkar."
		""
		"Parça başına yavaştır ama sabırlı bir üste karşılıksız kazanç sağlar. İsteğe bağlı."
	]
	quest.54AB11938676D4C7.quest_subtitle: "Bir alana iki, yavaşça"
	quest.54AB11938676D4C7.title: "Cevher Simyası"
	quest.564AD8763F753C74.quest_desc: [
		"Tabula Vitae ayrıca &6Alchemy Flasks&r doldurur: Anima'ndan hazırlanan, içilebilen, kalıcı alan oluşturan ve fırlatılabilen etkiler."
		""
		"Hem savaş şişeleri hem de yardımcı karışımlar burada hazırlanır."
	]
	quest.564AD8763F753C74.quest_subtitle: "İçebileceğin simya"
	quest.564AD8763F753C74.title: "Şişelenmiş Etkiler"
	quest.56983FF3D82AF789.quest_desc: [
		"&6Imperfect Ritual Stones&r, tek başlarına küçük ve tek seferlik etkiler oluşturur: gündüz/gece kontrolü, yağmur ve diğer hızlı numaralar."
		""
		"Ucuzdur, anında etki eder ve sistemi öğrenmek için uygundur. İsteğe bağlı."
	]
	quest.56983FF3D82AF789.quest_subtitle: "Gerçekten ucuz numaralar"
	quest.56983FF3D82AF789.title: "Kusurlu Ritüeller"
	quest.56DDCB2865CEB9D3.quest_desc: [
		"&6Spiritus Aura Gauge&r envanterinde dururken chunk'ın beş çubuğunu görüş alanına yansıtır."
		""
		"Kesin sayıları görmek için eğil: Raw, Ruina, Invictus, Nihilum ve Vindicta; her biri 0 ile 100 arasında."
	]
	quest.56DDCB2865CEB9D3.quest_subtitle: "Beş çubuk, sinyal yok"
	quest.56DDCB2865CEB9D3.title: "Aura'yı Okumak"
	quest.56F4E4845B8F12BB.quest_desc: [
		"Bağlı bir küreyle altarın yakınında sağ tıklayarak kendi kanını sun: havuz EV ile dolar. Altardan uzaktayken küre, sunuyu daha sonra kullanmak üzere depolar."
		""
		"Havuzdaki EV ile &6Tabula Rasa&r üretilir. Bu, neredeyse her mührün ve daha pek çok şeyin temel malzemesidir."
	]
	quest.56F4E4845B8F12BB.quest_subtitle: "Kandan güce"
	quest.56F4E4845B8F12BB.title: "Boş Levha"
	quest.5785D68A5F1ED2D2.quest_desc: [
		"&6Tau&r yalnızca Demon Realm'de yetişir: Tau Fruit, Saturated Tau ve Tau Oil'in tamamı bu diyardan gelir."
		""
		"Tütsü bahçesini ve orta kademeli simyayı besler. Oradayken hasat et."
	]
	quest.5785D68A5F1ED2D2.quest_subtitle: "İblis meyvesi, en iyi meyve"
	quest.5785D68A5F1ED2D2.title: "Tau Hasadı"
	quest.58248AF507380501.quest_desc: [
		"Artık kullanmadığın ekipmanlardaki büyüleri çıkar ve yeniden kullanmak üzere sakla."
		""
		"Zindandan çıkan ganimetleri geri dönüştürmenin sakin bir yolu. İsteğe bağlı."
	]
	quest.58248AF507380501.quest_subtitle: "Parıltıyı geri dönüştür"
	quest.58248AF507380501.title: "Büyüleri Kurtarmak"
	quest.5A99B71DB0C6A42A.quest_desc: [
		"Mühürlerin kademeleri vardır. Basit anahtarlar Antechamber'ı açar; daha derindeki kapılar &6Mine Keys&r ve daha zorlu anahtarlar ister."
		""
		"Her anahtar diyarın içinde ganimet olarak bulunur. Hiçbirini üretemezsin."
	]
	quest.5A99B71DB0C6A42A.quest_subtitle: "Anahtarlar üretilmez, ganimet olarak bulunur"
	quest.5A99B71DB0C6A42A.title: "Daha Derin Kilitler"
	quest.5AA17C1657E8E5DE.quest_desc: [
		"Sentient ekipman yalnızca kuşanılıp kullanıldığında gelişir. Ona iş ver."
		""
		"Üzerinde ne kadar uzun süre kalırsa o kadar gelişir. İsteğe bağlı."
	]
	quest.5AA17C1657E8E5DE.quest_subtitle: "Botlar gibi kullanarak alıştır"
	quest.5AA17C1657E8E5DE.title: "Kullanarak Geliştir"
	quest.5ACB4565C6B2466C.quest_desc: [
		"Potaya &lRedstone&r gücü verince süreç tersine döner: içindeki boş mücevher boşaltılmak yerine chunk'ın Aura'sından &ldoldurulur&r."
		""
		"Bir Aspect'i doyur, bir mücevheri dolmaya bırak; mücevher o Aspect'i alır."
	]
	quest.5ACB4565C6B2466C.quest_subtitle: "Redstone akışı tersine çevirir"
	quest.5ACB4565C6B2466C.title: "Aspect'li Mücevherler"
	quest.5BDD9D290D63ECE7.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Rancoris&r kol geziyor: diyardaki on türden biri olan kindar iblis."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.5BDD9D290D63ECE7.quest_subtitle: "Diyardaki on türden biri"
	quest.5BDD9D290D63ECE7.title: "Daemonium Rancoris"
	quest.5C3EA8B4F5949406.quest_desc: [
		"&6Hellfire Forge&r ikinci tezgâhtır: Sentient ekipman, daha iyi Spiritus Gems ve oyunun orta aşamasındaki bazı parçalar buradan çıkar."
		""
		"Spiritus ve EV tüketir; bu yüzden ağır işlere girişmeden önce her iki kaynağı da hazırla."
	]
	quest.5C3EA8B4F5949406.quest_subtitle: "Mangaldan daha sıcak"
	quest.5C3EA8B4F5949406.title: "Hellfire Forge"
	quest.5C7581C81669C499.quest_desc: [
		"&6Fast Miner&r kazmanı hızlandırır, &6Green Grove&r ekinleri büyütür, &6Magnetism&r düşen eşyaları sana çeker."
		""
		"Klasik yardımcı mühür seti. İsteğe bağlı."
	]
	quest.5C7581C81669C499.quest_subtitle: "Acele cevher getirir"
	quest.5C7581C81669C499.title: "İşçi Mühürleri"
	quest.602884068EC40EDB.quest_desc: [
		"&6Sentient&r aletler ve kılıç, yaşayan ekipmanlardır. Bir Sentient bıçakla öldürülen yaratıklar doğrudan Spiritus düşürür; hançerle işaretlemeye gerek yoktur."
		""
		"Onlara verdiğin iradeyle seviye atlarlar. İsteğe bağlı ama uğraşmaya değer."
	]
	quest.602884068EC40EDB.quest_subtitle: "Öğreniyor. Onu besle."
	quest.602884068EC40EDB.title: "Sentient Steel"
	quest.6101AB772B0317F1.quest_desc: [
		"&6Anima&r, Vitaemancy ile ilgili her şey için EV depolayan görünmez bir ruh ağıdır: mühürler, ritüeller ve küreler. Tükendiğinde bazı eşyalar bedeli doğrudan bedeninden alır."
		""
		"Depolanan kanı Anima'na normalden on kat hızlı aktarmak için küreyi dolu bir altarın içine yerleştir."
	]
	quest.6101AB772B0317F1.quest_subtitle: "Ruhun bir bataryası var"
	quest.6101AB772B0317F1.title: "Anima'yı Sezmek"
	quest.6171A7D347B9DFF4.quest_desc: [
		"&6Ritual Diviner&r, ritüelin istediği şekli gösterir ve taşları yerleştirmeden önce maliyeti görmeni sağlar."
		""
		"Tahmin etmekten daha ucuza gelir. İsteğe bağlı."
	]
	quest.6171A7D347B9DFF4.quest_subtitle: "Ödemeden önce gör"
	quest.6171A7D347B9DFF4.title: "Kâhinin Gözü"
	quest.62341583003C250F.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Doloris&r kol geziyor: diyardaki on türden biri olan acı getirici."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.62341583003C250F.quest_subtitle: "Diyardaki on türden biri"
	quest.62341583003C250F.title: "Daemonium Doloris"
	quest.62F71D88F1ED68B8.quest_desc: [
		"Diyarda on Daemonium türü kol gezer; her birinin kendine özgü Aspect'i ve mizacı vardır: Animaris, Cruoris, Doloris ve diğerleri. Her biri kendine özgü ganimetler düşürür."
		""
		"Bestiary sayfası, her birinin neyi koruduğunu listeler. İsteğe bağlı bir saha rehberi."
	]
	quest.62F71D88F1ED68B8.quest_subtitle: "Belanın on çeşidi"
	quest.62F71D88F1ED68B8.title: "Daemonium'larını Tanı"
	quest.63BEB615CC08733D.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Fervidis&r kol geziyor: diyardaki on türden biri olan ateşli iblis."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.63BEB615CC08733D.quest_subtitle: "Diyardaki on türden biri"
	quest.63BEB615CC08733D.title: "Daemonium Fervidis"
	quest.65BD73DA55BCC624.quest_desc: [
		"Neo Vitae, Vitaemancy sanatıdır: kendi kanını güce dönüştürmek. Bu bölüm, ilk kesikten Demon Realm'in kendisine kadar tüm yolu anlatır."
		""
		"Ana yolu soldan sağa takip et. Yan dallardaki görevler isteğe bağlı derslerdir; ekipmandan çok iyi hikâyeler kazandırırlar."
	]
	quest.65BD73DA55BCC624.quest_subtitle: "Sadece biraz ister"
	quest.65BD73DA55BCC624.title: "Neo Vitae'ye Hoş Geldin"
	quest.6607F68E3F0B6243.quest_desc: [
		"Derinlerdeki koridorlarda bir &6Daemonium Glaciaris&r kol geziyor: diyardaki on türden biri olan donmuş takipçi."
		"Kayda geçirmek için birini öldür. Daha derindeki odalarda daha nadir türler bulunur."
	]
	quest.6607F68E3F0B6243.quest_subtitle: "Diyardaki on türden biri"
	quest.6607F68E3F0B6243.title: "Daemonium Glaciaris"
	quest.671F7551CBDF462F.quest_desc: [
		"Kademe III ritüeli, giriş bölümünü atlayıp seni doğrudan bu boyutun her seferinde yeni bir düzende oluşan kalbi &lEndless Realm&r'e götürür."
		""
		"Derine indikçe odalar zorlaşır: daha zorlu oluşturucular, daha zengin ganimetler. Ekipmanını getir."
	]
	quest.671F7551CBDF462F.quest_subtitle: "Geçiş ücreti yok, yalnızca iblisler"
	quest.671F7551CBDF462F.title: "Highway to Hell"
	quest.678017C531F68528.quest_desc: [
		"Mühürler çalışma araçlarındır: her biri tek bir iş yapar ve Anima'ndaki EV ile çalışır."
		""
		"Sonraki görevler mühür ailelerini gösterir. Hepsi isteğe bağlı, hepsi yararlı."
	]
	quest.678017C531F68528.quest_subtitle: "Bir mühür, bir iş"
	quest.678017C531F68528.title: "Mühürlerle Dolu Bir Kemer"
	quest.6A866C75EE839078.quest_desc: [
		"Element mühürleri araziye ve havaya hükmeder: uçuşa yardım, lavla çalışma ve don işleri."
		""
		"Her biri bir düzenekte üretilir ve Anima enerjisiyle çalışır."
	]
	quest.6A866C75EE839078.quest_subtitle: "Element araç takımı"
	quest.6A866C75EE839078.title: "Hava, Lav ve Don"
	quest.702FC3E5D0D6C31F.quest_desc: [
		"&6Divinus Orb&r: &l10,000,000 EV&r, Vitaemancy'nin sunduğu en büyük hazne."
		""
		"Bu küre elindeyken haritadaki her ritüelin bedelini karşılayabilirsin."
	]
	quest.702FC3E5D0D6C31F.quest_subtitle: "Zirve bir yaşam biçimidir"
	quest.702FC3E5D0D6C31F.title: "Zirve"
	quest.70D2718D54785867.quest_desc: [
		"&6Spiritus Crucible&r, mücevherleri ve kristalleri yakarak &lAura&r'ya dönüştürür: bulunduğu chunk'ın havasına yayılmış Spiritus."
		""
		"Ona dolu mücevherler veya kristal parçaları ver."
	]
	quest.70D2718D54785867.quest_subtitle: "Havanın da bir rezervi var"
	quest.70D2718D54785867.title: "Spiritus Crucible"
	quest.71E0D06EA65172CF.quest_desc: [
		"Altar ayrıca ilk menzilli silahın ve Spiritus ekonomisinin başlangıcı olan &6Throwing Daggers&r üretir."
		""
		"Düşman bir yaratığı hançerle yaralayarak işaretle, ardından öldür: &6Spiritus&r zerreleri düşer. Bir yığın hazır tut."
	]
	quest.71E0D06EA65172CF.quest_subtitle: "Önce sapla, sonra topla"
	quest.71E0D06EA65172CF.title: "Fırlatma Hançerleri"
	quest.73391A08D7615C77.quest_desc: [
		"Düz bir zemine bir &6Ara Vitae&r yerleştir ve üzerine bir &lelmas&r koy. Kendi gücü olmayan altar, yakınında duranlardan kan çeker ve bunu &6Essentia Vitae (EV)&r'ye dönüştürür."
		""
		"Elmas bir &6Novicius Orb&r'a dönüşür. Onu ruhuna bağlamak için sağ tıkla."
	]
	quest.73391A08D7615C77.quest_subtitle: "Sadece biraz ister"
	quest.73391A08D7615C77.title: "İlk Altar"
	quest.759B0D6F8C0CC1EF.quest_desc: [
		"İlk altar yükseltmesi, Ara Vitae'nin çevresindeki taşa yerleştirilen bir rün halkasıdır. Kademe I'de sekiz rün yuvası açılır."
		""
		"Speed Runes her üretimin süresini kısaltır; Capacity Runes havuzun kapasitesini artırır. Planlama sitesi kesin sayıları gösterir."
	]
	quest.759B0D6F8C0CC1EF.quest_subtitle: "Altar taçlanıyor"
	quest.759B0D6F8C0CC1EF.title: "Kademe I: Rün Halkası"
	quest.770A5CCB2B571FD0.quest_desc: [
		"İkinci eldeki bir küre her öldürmeden beslenir: kurbanın &lazami canının her puanı başına 10 EV&r, kürenin kendi rezervine aktarılır."
		""
		"Savaş alanında doldur, ardından Anima'na 10x hızla aktarmak için küreyi altara bırak."
	]
	quest.770A5CCB2B571FD0.quest_subtitle: "Her öldürme kazandırır"
	quest.770A5CCB2B571FD0.title: "Öldürülenlerin Hasadı"
	quest.7731623EA92027D9.quest_desc: [
		"&6Dominus Orb&r, &l5,000,000 EV&r depolar. Bu noktadan sonra Anima'nın ritüelin ortasında tükenmesi nadirdir."
		""
		"Bundan sonra yalnızca bir kademe kalır."
	]
	quest.7731623EA92027D9.quest_subtitle: "Beş milyon ve devamı"
	quest.7731623EA92027D9.title: "Başbüyücünün Küresi"
	quest.7AFEB7A91DC8F413.quest_desc: [
		"Kademe I bir altarda &6Discipulus Orb&r üret. Anima kapasiten 5,000'den &l25,000 EV&r'ye çıkar."
		""
		"Daha büyük sunular, daha büyük üretimler. Doldurmaya devam et."
	]
	quest.7AFEB7A91DC8F413.quest_subtitle: "Devam etmek için 25,000 neden"
	quest.7AFEB7A91DC8F413.title: "Çırağın Küresi"
	quest.7B293C32824033F9.quest_desc: [
		"&6Crystallarium Maleficum&r, Aura ile beslenen ham parçalardan Spiritus Crystals yetiştirir."
		""
		"Beş Aspect'inin rezervini dolu tutan kristal çiftliği."
	]
	quest.7B293C32824033F9.quest_subtitle: "Kısacası kristal çiftçiliği"
	quest.7B293C32824033F9.title: "Crystallarium Maleficum'u Etkinleştir"
	quest.7C7C061FC04B89FB.quest_desc: [
		"Demonite'ı &6Hellforged&r parçalara ve külçelere dönüştür: en üst düzey aletlerin ve hücrelerin temelindeki metal."
		""
