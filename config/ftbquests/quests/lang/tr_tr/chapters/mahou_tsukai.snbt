{
	chapter.43BB00A7A7E1042C.title: "Mahou Tsukai"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	quest.002B8F2DE2CB4D2C.quest_desc: ["Diğer elinde bir Kalkan, ana elinde &7Güçleniş Parşomeni&r tut ve Sağ Tık'ı basılı tut."]
	quest.002B8F2DE2CB4D2C.title: "Güçlü Kalkan"
	quest.012912FDAFCD1C66.quest_desc: ["&e&lCaliburn&r başlangıçta bir &bElmas Kılıç&r'dan çok daha iyi olmayacak ama bir kez yükseltildiğinde; &bElmas Kılıç&r, &e&lCaliburn&r'ün yanında normal bir Çubuk gibi kalacaktır! \\nHem &4&lMorgan&r hem de &e&lCaliburn&r'ün gerçek Hasarları ve Doğuştan Gelen Sınırları vardır. \\n\\nDoğuştan Gelen Sınır, artırılabileceği maksimum Hasardır. &e&lCaliburn&r'ün Doğuştan Gelen Sınırını artırmak için, onu &5Darbe&r ile büyüle ve ardından Nether Yıldızları ile birlikte &3Göle&r at. \\n\\nMaksimum Sınıra ulaşmak için 6 Nether Yıldızına ihtiyacın var. Bir kez yükseltildiğinde daha fazla yükseltilemez, bu yüzden 6'sını da aynı anda attığından emin ol! \\n\\nNormal Hasarı artırmak için onu &5Darbe&r ile büyülemen gerekecek, sonra tekrar &3Göle&r gidecek! Şunları yapabilmek için daha fazla hasara ihtiyacın olacak..."]
	quest.012912FDAFCD1C66.title: "&l&eCaliburn&r'ü Yükseltme"
	quest.03DCDFB32CD4BD85.quest_desc: ["&e&lCaliburn&r birkaç şey gerektirir; bazıları görevlerde belirtildi, bazıları ise henüz belirtilmedi. \\nÖncelikle &3Mahou Gölü&r'ne ve 5000 &4Mahou&r'ya ihtiyacın var. \\n\\nDaha sonra &5Darbe&r büyüsüne sahip bir &bElmas Kılıç&r'a ihtiyacın olacak (seviye ne kadar yüksekse o kadar iyi). \\n\\nSon olarak, &bKılıç&r'ı &3Göl&r'e at, en dibinde &e&lCaliburn&r'ü bulacaksın!"]
	quest.03DCDFB32CD4BD85.title: "&e&lCaliburn"
	quest.0A1FBDA0C1314DE1.quest_desc: ["Uyumlanmış &bElmas&r/&aZümrütler&r birer &4Mahou&r pilidir ve &4&lMorgan&r'ı elde etmek için bolca &4Mahou&r'ya ihtiyacın olacak. \\n\\nUyumlanmış &bElmaslar&r 2000 &4Mahou&r, Uyumlanmış &aZümrütler&r ise 1000 &4Mahou&r depolar. \\n\\nRitüel için 5000 &4Mahou&r gerekecek, bu yüzden birkaç tane yapman gerekebilir!"]
	quest.0A1FBDA0C1314DE1.title: "Yeterince &4Mahou&r'n var mı? Muhtemelen!"
	quest.0D19FB62C2C1D9F7.quest_desc: ["En az 200 &4Mahou&r elde ettiğinde bir Yaşam Emme Alanı yapmak isteyebilirsin. \\n\\nBu alan içinde ölen her Yaratık için 10 &4Mahou&r geri alırsın, ancak bu YAVAŞ bir süreçtir."]
	quest.0D19FB62C2C1D9F7.title: "Yaşam Emme Alanı"
	quest.146AF0937D9C63DE.quest_desc: ["Diğer elinde bir Yay, ana elinde &7Güçleniş Parşomeni&r tut ve Sağ Tık'ı basılı tut."]
	quest.146AF0937D9C63DE.title: "Güçlü Yay"
	quest.21D323D95F5A7DB3.quest_desc: ["Diğer elinde bir Çubuk, ana elinde &7Güçleniş Parşomeni&r tut ve Sağ Tık'ı basılı tut."]
	quest.21D323D95F5A7DB3.title: "Güçlü Çubuk"
	quest.2D08BCF993B241B8.quest_desc: ["&8&lReplika'yı&r elde etmek için etkinleştirmen gereken ikinci parşömen, &7Bağışıklık Değişimi Parşomenidir&r. \\n\\nBunu elde etmek için 1 &3Tozlaşmış Göz&r ve 2 &aTozlaşmış Zümrüt&r gerektiren Bağışıklık Değişimi Ritüeli'ni yapman gerekecek."]
	quest.2D08BCF993B241B8.title: "&7Bağışıklık Değişimi Parşomeni"
	quest.34DACB973CBDE129.quest_desc: ["Gücü Kullan! \\n\\nBu da başka bir eğlenceli &a&lAsa&r; varlıkları fırlatmak için kullanabilirsin! Kendin de dahil! \\n\\nFırlatmak istediğin şeye Sağ Tık'ı basılı tut, eğer kendin fırlatılmak istiyorsan yere nişan al. Ardından, fareni fırlatılmasını istediğin yöne doğru hareket ettir! \\n\\nNe kadar uzun süre tutarsan fırlatma o kadar güçlü olur! Bir süre sonra maksimum seviyeye ulaşacak ve ne olursa olsun fırlatacaktır."]
	quest.34DACB973CBDE129.title: "&a&lUzaysal Yönelim Bozukluğunun Mistik Asası"
	quest.378105383747DD48.quest_desc: ["İşte bu biraz karmaşık. \\n\\n&8&lReplika'yı&r elde etmek için önce 5 Ruh, Hasar Takası ve Bağışıklık Değişimi'ni hazır bulundur. \\n\\nArdından bir saldırıyı engellemek için Güçlendirilmiş Kalkanı'nı kaldır ve &8&lReplika'yı&r elde et!"]
	quest.378105383747DD48.title: "&8&lReplika"
	quest.3907E68572324333.quest_desc: ["&4&lMorgan'ı&r elde etmek için &e&lCaliburn'e&r ihtiyacın var. \\n\\n&e&lCaliburn'ü&r elde etmek için &3Mahou Gölü'ne&r ihtiyacın var. \\n\\n&3Mahou Gölü'nü&r elde etmek için Güç Konsolidasyonu Ritüeli'ne ihtiyacın olacak. \\n\\nBu ritüel de diğerleri gibi sadece 2 Tozlaşmış Elmas ve 1 Tozlaşmış Zümrüt ile yapılabilir. \\n\\nBilgin olsun, bunu üssünün yakınında yapma; ritüelin gerçekleştiği yer &3Göl'ün&r tam ortası olacaktır!"]
	quest.3907E68572324333.title: "Güç Konsolidasyonu Ritüeli"
	quest.3E89BC6875790952.quest_desc: ["Sadece 2 &bTozlaşmış Elmas&r ve 1 &3Tozlaşmış Ender&r (bana güven, &3Ender İncisi&r bunun için önemli!). \\n\\n&7Parşömenimizi&r elde etmek için bu 3 Tozu bir &7Parşomen&r üzerinde kullan! \\n\\n&7&lAnahtarlarını&r elde etmek için &7Parşömenini&r kullan, artık istediğin kapının kilidini açabilirsin! \\n\\nHayır, bekle, yanlış anahtarlar..."]
	quest.3E89BC6875790952.title: "&7Yakınlık Projeksiyonu Parşomeni"
	quest.3FB0F22BEF7FE622.quest_desc: ["&8&lReplika'yı&r elde etmek için uygulaman gereken bir diğer &7Parşömen&r de &7Hasar takası Parşomenidir&r. \\n\\nBunu elde etmek için 1 Tozlaşmış Demir ve 2 &aTozlaşmış Zümrüt&r ile Hasar Takası Ritüeli'ni yap."]
	quest.3FB0F22BEF7FE622.title: "&7Hasar takası Parşomeni"
	quest.3FF97A4B5029C0E7.quest_desc: ["Bu, 2 &bTozlaşmış Elmas&r ve 1 &eTozlaşmış Altın&r gerektirir; &c&lEfsanevi Patlayıcı Yoğunlaşmış Mana Asasının&r tam tersi! \\n\\n&7Parşömenimizi&r elde etmek için bunları bir &7Parşomen&r üzerinde kullan, ardından bu &7Parşömeni&r kullanarak &b&lYayımızı&r alabiliriz!"]
	quest.3FF97A4B5029C0E7.title: "&7Menzilli Silahlar Parşomeni"
	quest.4A88472F1581EE7E.quest_desc: ["&4&lMahou Tsukai'ye&r hoş geldin. \\n\\nHayır, &4&lMorgan'ı&r anında alamazsın; modda biraz oynaman gerekecek. \\n\\nBaşlamak için biraz hasar al. Üzerinde bir kanama etkisi oluşacak. Bu etki kaybolmadan önce Shift tuşuna basılı tut ve ilk &cMahou Çemberi'ni&r yerleştirmek için sağlam bir bloğa bakarak M tuşuna bas. \\n\\nYani &cMahoujin&r!"]
	quest.4A88472F1581EE7E.title: "&4&lMahou Tsukai"
	quest.4C647369D976E67E.quest_desc: ["Bu &c&lAsa&r'nın 3 modu vardır: Işın, Alan Etkisi (AoE) veya Büyük Patlama. Her biri Shift + Sağ Tık ile değiştirilir! (Merak etme, hepsi patlamaya neden olur!) \\n\\nIşın beklendiği gibi çalışır; nişan aldığın yere dev bir ışın fırlatarak yolundaki her bloğu ve yaratığı yok eder! \\n\\nAlan Etkisi, önünde onlarca çember çağırır ve her biri hedeflenen yere patlayıcı bir atış yapar. \\n\\nBüyük Patlama en eğlenceli moddur; bir hedefe Sağ Tık'ı basılı tut... basılı tutmaya devam et. Tüm çizgilerin büyümesi biraz zaman alacaktır. Ardından bırak! \\n\\nBUUM! Devasa bir nükleer patlama gerçekleşecek! Devasa bir alanı yok eder, bu yüzden üssünün yakınında kullanma. Hatta bu modların hiçbirini üssünün yakınında kullanma..."]
	quest.4C647369D976E67E.title: "&c&lEfsanevi Patlayıcı Yoğunlaşmış Mana Asası"
	quest.5149BDF6BC4B3857.quest_desc: ["Ya da bir Dayanıklılık Takası yap ve içine güçlü (ama çok güçlü olmayan) Eşyalar at. \\n\\n&5Netherit Kürek&r gibi eşyaları tavsiye ederim!"]
	quest.5149BDF6BC4B3857.title: "Dayanıklılık Takası"
	quest.5212A4D67B1851EF.quest_desc: ["Bu eğlenceli küçük &7&lAnahtarlar&r, oldukça benzedikleri Wolverine pençelerine benzer şekilde işlev görür! \\n\\nElindeyken bir hedefin etrafında bir çember belirecektir; hedefe ışınlanmak ve ona vurmak için Sol Tık'ı kullan! \\n\\nBu çok uzak mesafelerden yapılabilir! (Yüz bloktan fazla bir mesafe olduğunu gördüm). \\n\\nDemir Kılıç ile yaklaşık aynı hasarı verir."]
	quest.5212A4D67B1851EF.title: "&7&lKızıl Siyah Yakınlık Projeksiyonu Anahtarları"
	quest.53829B3E51936ACD.quest_desc: ["Diğer elinde bir &bElmas Kılıç&r, ana elinde &7Güçleniş Parşomeni&r tut ve Sağ Tık'ı basılı tut."]
	quest.53829B3E51936ACD.title: "Güçlü Kılıç"
	quest.54E6C0D1BB442184.quest_desc: ["&eBüyüler&r elde etmek için Toz Eşyalara ihtiyacın olacak. \\n\\nToz Eşyalar elde etmek için bir &9Havan tokmağı&r gerekir."]
	quest.54E6C0D1BB442184.title: "&9Havan tokmağı"
	quest.565703CBB06CEABF.quest_desc: ["Hepinizin burada ne için olduğunu biliyorum; &4&lMorgan&r için buradasınız. \\n\\nBu kılıç, tüm &6&lATM Mod Paketlerindeki&r en güçlü kılıçlardan biridir. \\n\\nBu görevleri takip et ve durdurulamaz bir güç haline gel!"]
	quest.565703CBB06CEABF.title: "&4&lMorgan&r'ı Elde Etmek"
	quest.59FD3C4E415EEDDD.quest_desc: ["Ritüel başladıktan sonra &3Göl&r'ün oluştuğunu fark edeceksin. \\n\\nYaklaşık 20x20 blokluk bir alanda &3Bulanık Su&r ile dolu olacak şekilde büyüyecektir. \\n\\n&3Bulanık Su&r seni öldürmeyecektir; tabii hava almayı unutmadığın sürece."]
	quest.59FD3C4E415EEDDD.title: "&3Mahou Gölü"
	quest.5EF54E0EB14024D1.quest_desc: ["2 &eTozlaşmış Altın&r ve 1 &3Tozlaşmış Ender&r (bunları karıştırma yoksa Yükseliş Parşomeni elde edersin!). \\n\\n&7Parşömenimizi&r elde etmek için bunları bir &7Parşomen&r üzerinde kullan! \\n\\nSonra bu &7Parşömeni&r kullanarak daha az patlayıcı ama yine de eğlenceli &a&lAsamızı&r alacağız!"]
	quest.5EF54E0EB14024D1.title: "&7Uzaysal Oryantasyon Bozukluğu Parşomeni"
	quest.5F9B8ACCE0C8389E.quest_desc: ["Daha eğlenceli, küçük &4&lMahou Tsukai&r silahları elde etmek için bir &7Güçleniş Parşomenine&r ihtiyacın olacak. \\n\\nBir tane elde etmek için yere bir &7Parşomen&r yerleştir, ardından üzerinde Güçlendirme Ritüeli'ni gerçekleştir ve &7Parşomeni&r yerden al."]
	quest.5F9B8ACCE0C8389E.title: "&7Güçleniş Parşomeni"
	quest.5FD4FB9D24586B9B.quest_desc: ["Bir &9Yıldırım Asası&r elde etmek için ne yapman gerektiğini merak mı ediyorsun? \\n\\nGüçlendirilmiş Çubuğu tutarken sana &9Yıldırım&r çarpması olabilir mi?\\n\\nBence tam olarak öyle! \\n\\n&9&lEmrys&r'i elde ettiğinde diğer elinde tut ve Sağ Tık'ı basılı tut, sonuçlar ŞOK EDİCİ olacak!"]
	quest.5FD4FB9D24586B9B.title: "&9&lEmrys"
	quest.63768C7B988ED22B.quest_desc: ["&bGüçlendirilmiş Elmas Kılıcı'nı&r bir &dEjderha Nefesi&r havuzuna at, &d&lklarent&r elde edeceksin! \\n\\n&d&lklarent&r hem Kalkan hem de Kılıç görevi görür. \\n\\n&d&lklarent&r ile engelleme yapmak için Sağ Tık'ı basılı tut; engellediği tüm saldırılar, engellediği miktarda hasarı geri yansıtacaktır."]
	quest.63768C7B988ED22B.title: "&d&lklarent"
	quest.667B95A687703D6D.quest_desc: ["Hiçbir Yay'dan Elmas Kılıç atmak istedin mi? Ya da Netherit Çapa? Ya da temelde herhangi bir \"Silah\"? \\n\\nO zaman &b&lMenzilli Silahlar Yayı&r tam sana göre! \\n\\nShift + Sağ Tık ile değiştirilebilen iki modu vardır: Normal ve Projeksiyon. Değişen tek şey, envanterindeki herhangi bir silahı mı (Normal) yoksa sadece yan elindeki silahı mı (Projeksiyon) fırlattığıdır. \\n\\n&b&lYaydan&r fırlatılan silahlar fırlatılmış bir Üçlü Mızrak gibi davranır ve aynı şekilde geri toplanabilir. \\n\\nSilahlar normal bir savurma vuruşuyla aynı hasarı verir!"]
	quest.667B95A687703D6D.title: "&b&lMenzilli Silahlar Yayı"
	quest.6AD061C4331BE1F8.quest_desc: ["&4Mahou&r, &4&lMahou Tsukai&r'deki her şeyin yaşam kaynağıdır. &eBüyüleri&r kullanmak ve silahlar yapmak için onu artırman ve bolca &4Mahou&r'ya sahip olman gerekir. \\n\\n&4Mahou&r kullandıkça üst limitin artar. \\nDaha fazla &4Mahou&r depolamak için Uyumlanmış &aZümrüt&r veya &bElmas&r kullanmak, &4Mahou&r harcamanın kolay bir yoludur. \\n\\nYeterince yüksek &4Mahou&r seviyesine ulaştığında bu &eBüyüleri&r deneyebilirsin..."]
	quest.6AD061C4331BE1F8.title: "&4Mahou&r'nu Nasıl Artırırsın?"
	quest.6E04A314CD796254.quest_desc: ["Her Büyü Modu neye ihtiyaç duyar? Silah mı dedin! Umarım silah demişsindir! \\n\\nNobu, elbette 3 farklı ateşleme Moduna sahip bir silahtır."]
	quest.6E04A314CD796254.title: "&5&lNobu"
	quest.731A4846BC556AE1.quest_desc: ["&8&lReplika&r için ihtiyacın olan son şey, tabii ki başka bir &7Parşömen&r. \\n\\n&7Ölüm Toplayıcı Mistik Gözler Parşomeni&r. \\n\\nYaratıkların ölümünü izleyerek Ruh toplamanı sağlar. \\n\\nHer ölüm yalnızca çok az miktarda Ruh verir, bu yüzden bolca ölüm görmen gerekecek. \\n\\n5 tam Ruh elde ettiğinde &8&lReplika'yı&r almaya hazır olacaksın."]
	quest.731A4846BC556AE1.title: "Ruhlar"
	quest.73325912C84F64A5.quest_desc: ["Başka bir seçenek de Zaman Değişimi kullanmaktır; 12 saat boyunca &4Mahou&r kazanırsın, ardından 12 saat boyunca harcarsın. \\n\\nİkinci bir Zaman Değişimi çemberi yaparsan, ilki harcamaya başladığında bu sonsuz bir döngüye dönüşür."]
	quest.73325912C84F64A5.title: "Zaman Değişimi"
	quest.777BB82B56038ED3.quest_desc: ["&4&lMorgan&r'ın Hasarını artırmanın tek yolu Köylüleri öldürmektir. Bebek Köylüler, &4&lMorgan&r'ın Hasarını daha da fazla artırır! \\n\\nUmarım bir çiftlik kurmuşsundur. Çok, çok, çok sayıda Köylü ölümünün ardından fullemiş bir &4&lMorgan&r'a sahip olacaksın. \\n\\nAyrıca &4&lMorgan&r ile Sağ Tık'ı basılı tutarak özel bir saldırı yapabilirsin."]
	quest.777BB82B56038ED3.title: "&4&lMorgan&r'ı En Yüksek Seviyeye Çıkar"
	quest.795FA102F6577368.quest_desc: ["&4&lMorgan&r'ı elde etmek için &e&lCaliburn&r ile evcilleştirilmiş bir Köpek öldürmen gerekir. \\n\\nAyrıca &e&lCaliburn&r'ün Doğuştan Gelen Sınırı, &4&lMorgan&r'ın da Doğuştan Gelen Sınırı olacaktır. \\n\\nİyi şanslar!"]
	quest.795FA102F6577368.title: "&4&lMorgan&r'ı Elde Et"
	quest.7992C63F063BE908.quest_desc: ["Bu kadar güçlü bir şey için oldukça basit bir &7Parşömen&r tarifi! Sadece 2 &eTozlaşmış Altın&r ve 1 &bTozlaşmış Elmas&r. \\n\\nBunu, üzerinde &cMahoujin&r bulunan bir &7Parşomen&r üzerinde kullan; kurulduktan sonra &7Parşömeni&r elde etmek için üzerine Sağ Tıkla! \\n\\nArdından &c&lEfsanevi Patlayıcı Yoğunlaşmış Mana Asasını&r almak için &7Parşömeni&r kullan!"]
	quest.7992C63F063BE908.title: "&7Patalyıcı Yoğunlaşmış Mana Parşomeni"
	quest.7F7ED94590B5B857.quest_desc: ["Bazı &eBüyüler&r ihtiyaç duyulan her yerde kullanılmak üzere &7Parşömenlere&r aktarılabilir. \\n\\nİlk olarak bir &7Parşomene&r ihtiyacın olacak, onu yere yerleştir. Sonra aynı ritüeli &7Parşomen&r üzerinde gerçekleştir. \\n\\nTüm &4Kan&r ve &bToz&r işlemleri bittiğinde &7Parşomene&r Sağ Tıkla ve BUUM, işte &7Parşömen&r! \\n\\nBazı &eBüyüler&r &7Parşömene&r dönüştürülemez, bu yüzden ziyan olan malzemelerden sorumlu değilim."]
	quest.7F7ED94590B5B857.title: "Taşınabilir &eBüyüler&r!"
}
