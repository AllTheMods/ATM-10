{
	chapter.7AF827D2D101D343.title: "Artifacts"
	chapter_group.15E5B587D291A4AA.title: "Araçlar ve Ekipman"
	quest.010607466D565B53.quest_desc: ["Doğa Ana ile temasa geçmek dostum. \\n\\n&aKöklenmiş Çizmeler&r ile doğa senin en iyi dostun! Çimenlerin üzerinde durduğunda Kalplerin Yenilenir. Ayrıca Çimen üzerinde dururken Yemek yediğinde sanki Kemik Tozuyla sağ tıklanmış gibi davranacaktır."]
	quest.010607466D565B53.quest_subtitle: "Ayaklar"
	quest.010607466D565B53.title: "&aKöklenmiş Çizmeler"
	quest.0A1D4228271DECA3.quest_desc: ["Nereye gittin?\\n\\nÖnceki boyutunun sadece yarısı kadar olmuşsun. 1 blok boşluğa sığacak kadar küçük."]
	quest.0A1D4228271DECA3.quest_subtitle: "Kolye"
	quest.0A1D4228271DECA3.title: "&5Küçülme Nazarlığı&r"
	quest.0E716B90E60C486B.quest_desc: ["Bazı zamanlar savaşmanın en iyi yolu savaşmamaktır... kaçınmaktır! \\n\\n&4Panik Kolyesi&r ile, vurulduğunda kısa bir süreliğine Hız Etkisi elde edersin. Kaçınmak için yeterli bir zaman!"]
	quest.0E716B90E60C486B.quest_subtitle: "Kolye"
	quest.0E716B90E60C486B.title: "&4Panik Kolyesi&r"
	quest.11C5F17C6BB1237B.quest_desc: ["&5Solmuş Bileklik&r takılıyken Yakın Dövüş Saldırılarına Wither Etkisi verme ihtimali vardır.\\n\\nÜzgünüm Yay kullanıcıları!"]
	quest.11C5F17C6BB1237B.quest_subtitle: "Bilekler"
	quest.11C5F17C6BB1237B.title: "&5Solmuş Bileklik&r"
	quest.122E6E7CABCB17E7.quest_desc: ["Bazı nedenlerden dolayı Creeper'lar Kedilerden korkarlar. Creeper'lar son derece gerzektir ve &7Kedi Terlikleri&r'indeki Kedilerin gerçek olduğuna inanır. \\n\\nBu &7Kedi Terlikleri&r giyildiğinde tüm Creeper'lar senden kaçacak ve düşmanca davranmayacak. \\n\\nAyrıca hasar aldığında Kedi sesleri çıkarır! (Yine de her zaman Ayaklarının üzerine düşeceğini garanti edemem)."]
	quest.122E6E7CABCB17E7.quest_subtitle: "Ayaklar"
	quest.122E6E7CABCB17E7.title: "&7Kedi Terlikleri&r"
	quest.145E7D1A88B83DDD.quest_desc: ["Nereye kayboldun?"]
	quest.145E7D1A88B83DDD.quest_subtitle: "Atkı"
	quest.145E7D1A88B83DDD.title: "&9Görünmezlik Atkısı&r"
	quest.161A90E134592D0E.quest_desc: ["Normal Çiğ İnek Eti gibi, &cSonsuz Biftek&r'i de pişirerek &4Ebedi Biftek&r elde edebilirsin!\\n\\nTıpkı &cSonsuz Biftek&r gibi çalışır. Ancak daha fazla Açlık Puanı ve Doygunluk verir."]
	quest.161A90E134592D0E.quest_subtitle: "Benzersiz"
	quest.161A90E134592D0E.title: "&4Ebedi Biftek"
	quest.16255FB20F35A9D9.quest_desc: ["&3Şnorkel&r, &9Suya&r girdiğinde sana az miktarda Su Altında Nefes Alma etkisi verir. Kaplumbağa Kabuğuna benzer! Ama dikkatli ol, tükeniyor."]
	quest.16255FB20F35A9D9.quest_subtitle: "Kafa"
	quest.16255FB20F35A9D9.title: "&3Şnorkel"
	quest.19B393433FB0C62F.quest_desc: ["Lavgezer'in &cLav&r üzerinde yürümesinin sırrı Bacaklarında. Bu yüzden Bacaklarını onlardan aldık ve onun yerine senin kullanmanı sağladık! \\n\\nEğilirken &cLav&r'ın üzerinde güvenle yürüyebilirsin! Eğilmeyi bıraktığında &cLav&r'ın içine düşeceksin. Bunlar, ayrıca Magma bloklarının ve diğer sıcak blokların üzerinde güvenle yürümene de izin verir!"]
	quest.19B393433FB0C62F.quest_subtitle: "Ayaklar"
	quest.19B393433FB0C62F.title: "&4Lavgezer Çizmeleri&r"
	quest.1E40ACF3E69A4100.quest_desc: ["İçmek zorunda mısın? Bilemiyorum, sadece orada kalır ve işe yarar...  \\n\\n&6Panzehir Kabı&r ile negatif Etkilerin süreleri kısalır! Cadılar veya Wither İskeletleriyle karşılaştığında çok yardımcı olur."]
	quest.1E40ACF3E69A4100.quest_subtitle: "Kemer"
	quest.1E40ACF3E69A4100.title: "&6Panzehir Kabı&r"
	quest.2215FB0777D7029D.quest_desc: ["Çiviler, Kramponlar, Kramponlar her neyse! \\n\\n&7Sarsılmaz Çizmeler&r, seni ayaklarının üzerinde sabit tutar. Saldırılardan etkilenmezsin ve artık buzda kaymazsın."]
	quest.2215FB0777D7029D.quest_subtitle: "Ayaklar"
	quest.2215FB0777D7029D.title: "&7Sarsılmaz Çizmeler&r"
	quest.221C9EDA651144BA.quest_desc: ["Ne &9Suyu&r? \\n\\n&3Batma Nazarlığı&r ile &9Su&r içinde, sanki Havaymış gibi hareket edersin! Yine de suyun altında nefes alamazsın..."]
	quest.221C9EDA651144BA.quest_subtitle: "Kolye"
	quest.221C9EDA651144BA.title: "&3Batma Nazarlığı&r"
	quest.2607F3DC07049785.quest_desc: ["Hızlıca Yemek ve İçmek varken neden oturup güzel bir Ev Yemeği yemek için zaman harcayasın ki! \\n\\nBu çok şık &6Şapka&r ile, Yemek ve İçmek çok daha hızlı."]
	quest.2607F3DC07049785.quest_subtitle: "Kafa"
	quest.2607F3DC07049785.title: "&6Plastik İçme Şapkası"
	quest.27E951F4F4F6F847.quest_desc: ["&aDiken Kolye&r'a benzer, sadece biraz daha sıcak. Hayır, daha sıcak! \\n\\n&cAlev Kolye&r sana saldıranları ateşe verme ihtimaline sahiptir! Onlar tutuştuğunda, &cKolye&r da sana Ateş Direnci kazandıracaktır."]
	quest.27E951F4F4F6F847.quest_subtitle: "Kolye"
	quest.27E951F4F4F6F847.title: "&cAlev Kolye&r"
	quest.29448D08C8777425.quest_desc: ["Bu gece Balıklara birlikte uyuyor olacak. \\n\\n&cBalıkçı Şapkası&r, Balıkları Yemlemene yardımcı olur ve Nadir eşya elde etme şansını artırır!"]
	quest.29448D08C8777425.quest_subtitle: "Kafa"
	quest.29448D08C8777425.title: "&cBalıkçı Şapkası"
	quest.2AD78E22988A92D3.quest_desc: ["Seni görüyorum! \\n\\n&2Gece Görüş Gözlüğü&r taktığında, karanlıkta görme yeteneğine sahip olursun! Başka bir şeye değil..."]
	quest.2AD78E22988A92D3.quest_subtitle: "Kafa"
	quest.2AD78E22988A92D3.title: "&2Gece Görüş Gözlüğü"
	quest.321F16645640C462.quest_desc: ["Ender İnciler seyahat etmenin eğlenceli bir yolu! (Bumblezone için faydalı, acaba bu Mod için bir Görev bölümü elde edecek miyiz?) Ama Ender İncisini kullandıktan sonra tükenmesinden ve her kullanımda 2 Kalp hasar vermesinden sende rahatsız olmuyor musun? \\n\\n&9Warp Sürücüsü&r ile tüm bunlar ortadan kalkıyor ve Ender İncileri açıkça en iyi ulaşım aracı haline geliyor! Açlık, Ender İncileri yerine tüketilir ve artık Ender İncisi kullanıldığında hasar alınmaz. Tüm Açlık Çubukları tükendiğinde, Ender İncisi tüketmeye devam edecek."]
	quest.321F16645640C462.quest_subtitle: "Kemer"
	quest.321F16645640C462.title: "&9Warp Sürücüsü&r"
	quest.3446803FB59D8875.quest_desc: ["Sana Dikenli özelliği verir. Zırhına değil, sana! Kirpi balığı gibi!"]
	quest.3446803FB59D8875.quest_subtitle: "Kolye"
	quest.3446803FB59D8875.title: "&aDiken Kolye&r"
	quest.3525D5DCC3A534D9.quest_desc: [
		"Bunlar favorilerimden biri! \\n\\n&9Kazma Pençeleri&r;"
		"1. Madencilik hızını artırır. Yani temelde tüm Kazmalardaki Verimlilik seviyesi"
		"ve "
		"2. Yumruklarının Taş Kazma gibi davranmasını sağlar! \\n\\nGenel olarak inşa etmek ve oynamak için süper yararlı!"
	]
	quest.3525D5DCC3A534D9.quest_subtitle: "Eller"
	quest.3525D5DCC3A534D9.title: "&9Kazma Pençeleri&r"
	quest.3705D303CF423804.quest_desc: ["&aVahşi Pençeler&r'ın diğer parçası. Bunları takmak, verdiğin Hasarı artırır."]
	quest.3705D303CF423804.quest_subtitle: "Eller"
	quest.3705D303CF423804.title: "&eGüç Eldiveni&r"
	quest.3B3BD39BA02DCA13.quest_desc: ["&6Cep Pistonu&r ile Saldırıların, Düşmanlarını çok daha uzağa fırlatacak! \\n\\nAcaba hangisi kazanır merak ediyorum. &6Cep Pistonu&r mı yoksa &7Sarsılmaz Çizmeler&r mu?"]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Eller"
	quest.3B3BD39BA02DCA13.title: "&6Cep Pistonu&r"
	quest.3E0643EA9183CDAE.quest_desc: ["'O onun Şapkasıydı ama Bay Yengeç! O 1 Numaraydı!' \\n\\nNormal &6İçme Şapkası&r ile aynı şeyi yapar. Sadece daha havalı görünüyor!"]
	quest.3E0643EA9183CDAE.quest_subtitle: "Kafa"
	quest.3E0643EA9183CDAE.title: "&9İlginç İçme Şapkası"
	quest.3E1A3BC8642390B3.quest_desc: ["'Hey, ben Marry Poppins'im!' \\n\\n&4Şemsiye&r, &l&3Artifacts&r tarafından eklenen çok kullanışlı bir alettir! Sağ tıklayarak kalkan olarak kullanmak için önünde tutulabilir. Ya da sadece elinde tutarak düşüşünü yavaşlatmak için kullanılabilir! "]
	quest.3E1A3BC8642390B3.quest_subtitle: "Benzersiz"
	quest.3E1A3BC8642390B3.title: "&4Şemsiye&r"
	quest.3EC8A0B89788D079.quest_desc: ["Ellerim yok, &9Paletler&r'ım var. \\n\\n&9Paletler&r çok daha iyi bir Derin Koşucu gibi davranacaktır. &9Su&r içinde çok daha hızlı yüzebilir ve yürüyebilirsin!"]
	quest.3EC8A0B89788D079.quest_subtitle: "Ayaklar"
	quest.3EC8A0B89788D079.title: "&9Paletler&r"
	quest.427014BDE06DE631.quest_desc: ["Vurduğum her şey, alev alev yanıyor!!!!!"]
	quest.427014BDE06DE631.quest_subtitle: "Eller"
	quest.427014BDE06DE631.title: "&cAteş Eldiveni&r"
	quest.436E4E3515BCCDE9.quest_desc: ["&bŞişedeki Bulut&r takılıyken çift zıplamak için Boşluk Tuşuna iki kez basabilirsin! Parkur için çok faydalıdır! \\n\\nAyrıca &dTavşan Zıplayıcıları&r gibi düşebileceğin yüksekliği de artırır!"]
	quest.436E4E3515BCCDE9.quest_subtitle: "Kemer"
	quest.436E4E3515BCCDE9.title: "&bŞişedeki Bulut&r"
	quest.4564B577CB4EC046.quest_desc: ["Yüzlerce İneği keserken Nadir bir İnek Etine rastlayabilirsin. Deli Dana Hastalığı olanlardan değil, &cSonsuz Biftek&r'den bahsediyorum!\\n\\n&cSonsuz Biftek&r, normal Çiğ İnek Eti gibi yenebilir ama tüketildiğinde kaybolmaz! Bunun yerine, tekrar yiyebilmen için bekleme süresi olur.\\n\\n(Otomatik beslemesi olan sırt çantaları ile de çalışır!)"]
	quest.4564B577CB4EC046.quest_subtitle: "Benzersiz"
	quest.4564B577CB4EC046.title: "&cSonsuz Biftek&r"
	quest.4933CF4675E77D50.quest_desc: ["Alev Hasarından darbe aldıktan sonra, &5Obsidiyen Kafatası&r etkinleştirilerek sana bir süreliğine Ateş Direnci verir. Umarım alevlerden kaçmaya yetecek kadar uzun bir süredir!"]
	quest.4933CF4675E77D50.quest_subtitle: "Kemer"
	quest.4933CF4675E77D50.title: "&5Obsidiyen Kafatası&r"
	quest.4A7AEBEB87CEC274.quest_desc: ["Belirli bir &cKoşu Ayakkabısı&r markası kullanma iznim olduğunu sanmıyorum. Bu yüzden bunların hangisi olduğu konusunda hayal gücünü kullan.  \\n\\n&cKoşu Ayakkabıları&r, Koşarken sana Hız Artışı sağlar. Böylece Koşarken daha da hızlı olursun! Ayrıca Koşarken otomatik zıplama sağlar..."]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Ayaklar"
	quest.4A7AEBEB87CEC274.title: "&cKoşu Ayakkabıları&r"
	quest.4D3379D38237F830.quest_desc: ["&bBunları&r Ayağına takarak bir mucize gerçekleştirebilirsin! &9Su&r üzerinde yürümek! \\n\\nAslında &9Su&r üzerinde koşmak. &9Su&r üzerinde koşabilmek için Koşuyor olman gerekir. Koşmayı bıraktığında Batmaya başlarsın."]
	quest.4D3379D38237F830.quest_subtitle: "Ayaklar"
	quest.4D3379D38237F830.title: "&bSu Hızlandırıcıları&r"
	quest.5040B3D29F238BC0.quest_desc: ["Zıpla, Tavşancık. Zıpla, Tavşancık. Zıpla, Tavşancık.\\n\\n&dTavşan Zıplayıcıları&r takılıyken iki kat daha yükseğe zıplayabilir ve normalde aldığın düşme hasarının yarısını alabilirsin! Bu seni Düşme Hasarına karşı yenilmez yapmaz, hâlâ ölebilirsin. Sadece daha zordur."]
	quest.5040B3D29F238BC0.quest_subtitle: "Ayaklar"
	quest.5040B3D29F238BC0.title: "&dTavşan Zıplayıcıları&r"
	quest.50A32AC6EDBC5854.quest_desc: ["Yemek tek başına oldukça sıkıcı olabilir. Ancak yemeğinin yanında bir garnitürün olduğunda çok daha iyi olur! Daha spesifik olarak biraz (bir) &6Soğan Halkası&r!\\n\\n&6Soğan Halkası&r'i taktığında, yediğin her şey sana biraz Acele verecek."]
	quest.50A32AC6EDBC5854.quest_subtitle: "Eller"
	quest.50A32AC6EDBC5854.title: "&6Soğan Halkası&r"
	quest.589F1D502F680075.quest_desc: ["Havuz Partileri için mükemmel! \\n\\nSevimli ve komik görünmesinin yanı sıra &dHelyum Flamingosu&r, Havada yüzmeni sağlar. Evet beni duydun!  Havada... Yüz... \\n\\nHavadayken, zıplamak gibi. Havada Yüzmeye başlamak için tekrar CTRL'e basabilirsin. Tıpkı Suda olduğu gibi hareket edebilirsin: yukarı Yüz, aşağı Yüz, her tarafa Yüz!"]
	quest.589F1D502F680075.quest_subtitle: "Kemer"
	quest.589F1D502F680075.title: "&dHelyum Flamingosu&r"
	quest.5CE44C58A470E48E.quest_desc: ["&l&3Artifacts&r, Minecraft deneyimini çok daha kolay ve çok daha eğlenceli hale getirecek &l&3Eserler&r ekleyen harika bir Mod!\\n\\nTüm &l&3Eserler&r ya keşif yaparak, ya arkeolojiyle ya da Taklitçi'leri öldürerek bulunabilir!\\n\\nTaklitçi'ler yer altındaki Kamp Alanlarında bulunur ve normal Sandıklar gibi görünürler! Ancak çok yaklaştığında saldırırlar!"]
	quest.5CE44C58A470E48E.title: "&l&3Artifacts"
	quest.5DE7C4FD5FA29236.quest_desc: ["Tam bir Enderman'i öldürmek üzereyken ışınlanıp gitmesinden sen de rahatsız olmuyor musun? Rahatsız olmuyorsun, seviyorsun! Sadece kızgınsın çünkü kıskanıyorsun! Onu istiyorsun! \\n\\nVe &5Koro Kemeri&r ile bunu elde edebilirsin! Seni öldürecek bir saldırıdan ışınlanarak uzaklaşacaksın."]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Kemer"
	quest.5DE7C4FD5FA29236.title: "&5Koro Kemeri&r"
	quest.5EB7CE3A1DCD3E9B.quest_desc: ["Bu bir &cMıknatıs&r."]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Kemer"
	quest.5EB7CE3A1DCD3E9B.title: "&cEvrensel Çekici&r"
	quest.5F5E43B3F51CAE9E.quest_desc: ["'Sihirli bir şekilde lezzetliler!' \\n\\n&aHurafe Şapka&r öldürdüğün Yaratıklar için sana fazladan Yağma seviyesi verir. \\n\\nBüyülerle birlikte istiflenir!"]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Kafa"
	quest.5F5E43B3F51CAE9E.title: "&aHurafe Şapka"
	quest.5FD6A738754F6013.quest_desc: ["Bu görev, AllTheMods Modpack'lerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan veya açık bir izin verilmeyen hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.623796B1D7981E59.quest_desc: ["'Ayrıca Terraria'yı da dene!'\\n\\nTakıldığında fazladan 5 Kalp kazanacaksın! Ya da 10 tam Sağlık puanı! Varsayılan olarak 30 kalp'a kadar eklenir."]
	quest.623796B1D7981E59.quest_subtitle: "Kemer"
	quest.623796B1D7981E59.title: "&4Kristal Kalp&r"
	quest.62622137648A4F56.quest_desc: ["Cevherlerini bir eşya ile kazıp diğer eşya ile eritmek zorunda kalmaktan hoşlanmıyor musun? Artık &7Kazma Isıtıcısı&r ile her zamankinden daha tembel olabilirsin!\\n\\n&7Kazma Isıtıcısı&r takılıyken, Kazdığın Cevherler otomatik olarak Eritilecektir!\\n\\nCevher İşleme kurulumu istiyorsan dikkatli olmak isteyebilirsin."]
	quest.62622137648A4F56.quest_subtitle: "Eller"
	quest.62622137648A4F56.title: "&7Kazma Isıtıcısı&r"
	quest.6A452BFC8A967C39.quest_desc: ["Bu &aPençeler&r'i takınca kendini farklı hissediyorsun. Adrenalin pompalanıyor, düşünceler azalıyor, gücün başka hiçbir şeye benzemeyecek şekilde artıyor! \\n\\n&aVahşi Pençeler&r ile Silahların ya da Yumruklarınla çok daha hızlı Saldıracaksın."]
	quest.6A452BFC8A967C39.quest_subtitle: "Eller"
	quest.6A452BFC8A967C39.title: "&aVahşi Pençeler&r"
	quest.6FBE5B5D5027B32C.quest_desc: ["Bu &7Şapka&r'yı takınca yaratıklar rüzgar gibi kaçışıyor! \\n\\nÇok da güzel görünüyor."]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Kafa"
	quest.6FBE5B5D5027B32C.title: "&7Kovboy Şapkası"
	quest.70C7D92844089DEB.quest_desc: ["Diğer Kolyeler gibi bunun da saldırganına zarar verme şansı var. Sadece Yıldırım ile! \\n\\nAyrıca, Yıldırım tarafından vurulacak kadar şanslıysan/şanslı değilsen. Sana zarar vermez."]
	quest.70C7D92844089DEB.quest_subtitle: "Kolye"
	quest.70C7D92844089DEB.title: "&bŞok Kolye&r"
	quest.7188DC06A28AE30E.quest_desc: ["&eAltın Kanca&r takmak, düşmanlardan elde edeceğin deneyimi artırır!"]
	quest.7188DC06A28AE30E.quest_subtitle: "Eller"
	quest.7188DC06A28AE30E.title: "&eAltın Kanca&r"
	quest.72D6265E35814927.quest_desc: [
		"Sağlık ve hasar sistemi olan çoğu oyunda Yenilmezlik Çerçeveleri vardır. Hasar aldıktan sonra birkaç Yenilmezlik Çerçeven olur. Böylece;"
		"1. Basit bir saldırı ile anında ölmezsin ve"
		"2. Karşılık vermek için zamanın olur. Sana en iyi şekilde savaşmak için zaman verir. \\n\\n&eHaç Kolye&r ile birkaç Yenilmezlik Çerçevesi daha elde edersin. Bu da karşılık vermek için fazladan zaman demektir!"
	]
	quest.72D6265E35814927.quest_subtitle: "Kolye"
	quest.72D6265E35814927.title: "&eHaç Kolye&r"
	quest.73B73870B29DFAD9.quest_desc: ["Bizden biri! Bizden biri! \\n\\n&eKöylü Şapkası&r, Köylüleri aynı Kasabadan olduğuna inandırır. Böylece Kasaba Dışı Vergisinden muaf olursun. Köylü Ticaretleri daha ucuzdur."]
	quest.73B73870B29DFAD9.quest_subtitle: "Kafa"
	quest.73B73870B29DFAD9.title: "&eKöylü Şapkası"
	quest.73FC51144FC2DA52.quest_desc: ["Bu &7Eldiven&r ile vurduğun tüm düşmanların canını alacaksın!\\n\\nOh evet üzgünüm unutmuşum... bleh bleh blehhh!"]
	quest.73FC51144FC2DA52.quest_subtitle: "Eller"
	quest.73FC51144FC2DA52.title: "&7Vampir Eldiveni&r"
	quest.74B352457BF1541B.quest_desc: ["Eğer sende benim gibiysen ya da aklı başında biriysen Tozlaşmış Kar hoşuna gitmez. Neyse ki &l&3Artifacts&r bize bununla başa çıkmamız için bir alet veriyor! Kar Ayakkabıları! \\n\\nKar Ayakkabıları, Deri Çizmelerin yaptığı gibi Tozlaşmış Kar üzerinde güvenle yürümeni sağlayacaktır. Ayrıca herhangi bir Kar üzerinde yürürken Hız artışı elde edeceksin!"]
	quest.74B352457BF1541B.quest_subtitle: "Ayaklar"
	quest.7503823ACDDB0491.quest_desc: ["Bu ve &aHurafe Şapka&r sana ihtiyacın olabilecek tüm şans tılsımlarını verir!\\n&2Şanslı Atkı&r, Kazmaların için ekstra bir Servet seviyesi sağlar."]
	quest.7503823ACDDB0491.quest_subtitle: "Atkı"
	quest.7503823ACDDB0491.title: "&2Şanslı Atkı&r"
	quest.789AF6D0A6321945.quest_desc: [
		"&l&3Eser&r'lerden tek ve en önemlisi! En güçlüsü! En tehlikeli olanı!"
		"{@pagebreak}"
		"Ne işe yaradığını açıklamam gerektiğinden bile emin değilim, çok tehlikeli!"
		"{@pagebreak}"
		"Gücüyle başa çıkabileceğinden eminsen, belki de okumaya devam etmelisin..."
		"{@pagebreak}"
		"Geri dönmek için geç değil!"
		"{@pagebreak}"
		"Tamam, seni uyarmıştım..."
		"{@pagebreak}"
		"Osurma ihtimali için &dWhoopee Minderi&r takılıyken Shift tuşuna bas."
	]
