{
	chapter.7A5C327771634A7D.title: "İnşa İpuçları"
	quest.0052E5592A6BBEC1.quest_desc: [
		"Bu &2&lMinecraft&r, sana nasıl yapı yapacağını söyleyemem..."
		"{@pagebreak}"
		"Ama sana bunun için ipuçları verebilirim!"
	]
	quest.0052E5592A6BBEC1.title: "&lYapı İpuçları!&r"
	quest.005CC8A3325FE2BD.quest_desc: ["&bFroststeel&r, &7Cloggrum&r ve &eRegalium&r bunun için Kazılabilir. \\n&cUtheric&r ve &aForgotten&r'ı öldürmen gerekir. \\n\\nBaşka soru var mı?"]
	quest.005CC8A3325FE2BD.title: "&2&lUndergarden&r Metalleri"
	quest.01516BC726013B7C.quest_desc: ["Bu görev, AllTheMods Modpack'lerinde kullanılmak üzere &6AllTheMods Ekibi&r veya bir &2Topluluk katılımcısı&r tarafından oluşturulmuştur.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan veya açık bir izin verilmeyen hiçbir halka açık pakette kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.027E6E294D9E1375.quest_desc: ["Not al &lCorail&r! Holiday'leri işte böyle yapmalısın! (Bunu %100 sevgiyle söylüyorum, seni seviyoruz &lCorail&r!) \\n\\nBu eklenti Noel ve Cadılar Bayramı için bol miktarda süsleme ekliyor. \\n\\nNoel için Noel Ağaçları, Hediyeler ve Işıklardan Cadılar Bayramı için Kabaklar, Örümcekler ve Cadı Şapkalarına kadar."]
	quest.027E6E294D9E1375.title: "&b&lMacaw's Holidays&r"
	quest.034DB3C64F24C7B7.quest_desc: ["&6&lAllTheOres&r cevherleri birleştirmeye yardımcı olmak için tarafımızca yapılmış bir moddur.\\n\\nBununla birlikte tonlarca çok kullanışlı dekoratif blok geliyor!\\n\\n&dFlorit&r ve &9Safir&r'in her ikisi de çok havalı görünüyor!"]
	quest.034DB3C64F24C7B7.title: "&l&6AllTheOres&r Blokları"
	quest.04F5846E2468E807.quest_desc: ["&b&lMacaw's Doors&r her türlü farklı Kapı ve Kapı çeşidini ekler. \\nHuş ağacı tasarımını Ladin ağacıyla mı istiyorsun? Buna sahip olabilirsin! \\n\\nHatta Hastane Kapıları bile var!"]
	quest.04F5846E2468E807.title: "&b&lMacaw's Doors"
	quest.0539AF15A10B2859.quest_desc: ["&lCompact Makineler&r, sıkıştırılmış bir boyuta girmene olanak tanır. Bir &lCompact Machine&r yerleştirdikten sonra, Personal Shrinking Device kullanarak içine girebilirsin.\\n\\n&lCompact Machine&r boyutu tarife bağlı olarak 5x5x5'ten 45x45x45'e kadar değişir!\\n\\n&lCompact Machine&r duvarlarını kıramazsın ve Personal Shrinking Device ile Sağ Tık yaparak çıkabilirsin."]
	quest.0539AF15A10B2859.title: "&lCompact Makineler"
	quest.0589911EB4D30FAD.quest_desc: ["&l&cRegions Unexplored&r ayrıca Tahtaları, Yün veya Cam gibi boyayabilmeni sağlıyor!"]
	quest.0589911EB4D30FAD.title: "Boyalı Tahtalar"
	quest.0596F6C70758EEC0.quest_desc: ["En pahalısı olmalarının yanı sıra en güzelleri de onlar! \\n\\nVe Yapılar için önemli olan da budur!"]
	quest.06FFBB12CFA87815.quest_desc: ["Farklı &2Vanilla&r Biyomlarında bulunan &2Vanilla &lMinecraft&r Kütükleri! \\n\\nBundan daha fazlasını açıklamama gerek yok!"]
	quest.06FFBB12CFA87815.title: "&2Vanilla&r Kütükleri"
	quest.08C66BCA3AAE765B.quest_desc: ["Bu &2&lMinecraft&r'ta Olmayan Bloklar ekler, bu yüzden tartışmamayı tercih ederim."]
	quest.08C66BCA3AAE765B.title: "&b&lMacaw's Roofs"
	quest.09955CF85F579E0F.quest_desc: ["Bunu eninde sonunda elde edeceksin, kelimenin tam anlamıyla &2&lMinecraft&r'daki en bol blok."]
	quest.09955CF85F579E0F.title: "Taş Bloklar"
	quest.09F49ED309152E24.quest_desc: ["&l&cChisel Reborn&r, &lChiseled&r'ı esas alan bir başka moddur. \\n\\nModun temelinde bazı Blokların tasarımlarını değiştirmek için Chisel Aletini kullanmak vardır. \\n\\nGUI'sini açmak için Chisel ile Sağ Tıklayabilirsin, orada içine bir istif blok koyabilir, sonra istediğin bir tasarımı seçebilir ve çıkarabilirsin. Ya da Chisel'da tutabilirsin, ama bunu neden istediğini anlamıyorum.  \\n\\nAyrıca Chisel GUI'sini açmadan tasarımını değiştirmek için Chisel ile bir Bloğa Sol Tıklayabilirsin! \\n\\nEndişelenme, bunun Dayanıklılığı yok."]
	quest.09F49ED309152E24.title: "&l&cChisel Reborn"
	quest.0A21773B773F34F8.quest_desc: ["Renk, bir Yapıyı daha canlı hale getirmenin en önemli parçalarından biridir! \\n\\nOna hayat, kişilik ve renk verir!  \\n\\nBoyalarla başla!"]
	quest.0A21773B773F34F8.title: "Renkli Bloklar"
	quest.0BC106B34AD386E5.quest_desc: ["&l&cRegions Unexplored&r başka bir Biyom Modudur, bu &l&6AllTheMods!&r için yeni bir mod! \\n\\nTabii ki Biyomlarla birlikte daha fazla Ağaç geliyor!"]
	quest.0BC106B34AD386E5.title: "&l&cRegions Unexplored&r Kütükleri"
	quest.0C82CE3AFBD48C1E.quest_desc: ["&l&aSushi Go Üretim&r çok fazla blok eklemiyor ama eklediklerini Mutfağında kullanmanı kesinlikle tavsiye ederim! \\n\\nÖzellikle Rice Cooker; artık Pilav için Mikrodalga kullanmaya gerek yok."]
	quest.0C82CE3AFBD48C1E.title: "&l&aSushi Go Üretim&r"
	quest.0EB6ED88895366D0.quest_desc: ["Sadece Taş ve Kırık Taş olduğu zamanları hatırlıyor musun?"]
	quest.0EB6ED88895366D0.title: "&2Vanilla&r Taşları"
	quest.0FE30548F25FEDB1.quest_desc: ["Eğer sen de benim gibiysen ve bir kutunun içinde yaşamaktan hoşlanmıyorsan (bana çok fazla okulu hatırlatıyor), o zaman Yapılarında dışarıyı görebilmen için Cam olmasını isteyeceksin. \\n\\nNormal Vanilla olanlar güzel olsa da elbette çok daha iyisini yapabiliriz! \\n\\nHatta bunu biraz değerlendirebiliriz bile!"]
	quest.106884349C9FF3BA.quest_desc: ["Dostum bazı Işık Kaynakları çok çirkin! \\n\\nBunu değiştirelim!"]
	quest.106884349C9FF3BA.title: "&l&bChipped&r Işıklar"
	quest.10A2E758D7743DD0.quest_desc: ["&5&lEternal Starlight&r çok sayıda benzersiz eşya, Yaratık ve Bloğa ev sahipliği yapıyor. \\n\\nAğaçlar da! \\n\\nBu Ağaçları, Boyutun her yerinde, neredeyse her Biyomda bulabilirsin."]
	quest.10A2E758D7743DD0.title: "&5&lEternal Starlight&r Ağaçları"
	quest.11C43962B06D5092.quest_desc: ["Bu gerekli miydi?"]
	quest.11C43962B06D5092.title: "İşte şimdi gösteriş yapıyorsun"
	quest.156605859D553276.quest_desc: ["Pencereler, Pencere Camları, Panjurlar, Perdeler, Storlar, hatta Denizlikler! \\n\\nBunun ne olduğunu bile bilmiyorum!"]
	quest.156605859D553276.title: "&l&bMacaw's Pencereleri&r"
	quest.1591013DDD4766E1.quest_desc: ["&l&cCooking for Blockheads&r tamamen Mutfağı evin haline getirmekle ilgilidir. \\n\\nVerdiği her şeyi kullanmanı tavsiye ederim çünkü her Eşyanın bir kullanımı var ve harika görünüyor!"]
	quest.1591013DDD4766E1.title: "&l&cCooking for Blockheads&r"
	quest.1625C3A30E69D634.quest_desc: ["Bu yeni Taşları &l&cRegions Unexplored&r Biyomlarında bulabilirsin! \\n\\nHayır, Yosunlu Taş &l&aOh The Biyomlar We've Gone&r'daki ile aynı değil. \\n\\nHayır, Yosunlu Taş Tuğlası ile aynı değil."]
	quest.1625C3A30E69D634.title: "&l&cRegions Unexplored&r Taşları"
	quest.1972B36F72808D55.quest_desc: ["Bu taşların sadece bazıları yontulmuştur."]
	quest.1972B36F72808D55.title: "&l&bChipped&r Taşları"
	quest.1FD60B7448CED1EB.quest_desc: ["Bu &b&lMacaw&r Modu yeni Çit, Çit Kapısı ve Duvar çeşitleri ekler. \\n\\nEvet, dikenli teller canını yakacak. \\n\\nHayır, hiçbirinin üzerinden normal olarak atlayamazsın."]
	quest.1FD60B7448CED1EB.title: "&b&lMacaw's Fences and Walls"
	quest.1FDC8725105D822A.quest_desc: ["Mutfakta Yiyecekleri tutabilen, koruyabilen ve Pişirebilen birçok blok bulunur! \\n\\nYiyecek pişiren veya hazırlayan Blokların çoğu Enerjiye ihtiyaç duyar, bu nedenle daha fazla bilgi edinmek için Elektrik Takımına göz at!"]
	quest.1FDC8725105D822A.title: "Mutfak Takımı"
	quest.2094D1CE4BA66091.quest_desc: ["Işık her Üssün çok önemli bir parçasıdır. \\n\\nCanavarların ortaya çıkmasını engeller, görmene yardımcı olur ve hatta Yapılarına daha fazla Renk ve canlılık katar! \\n\\nYa da sadece Gece Görüşü kullanabilirsin ama bunun eğlencesi nerede!"]
	quest.22D2CFDDB06C720C.quest_desc: ["Aletler &2&lMinecraft&r'da çok önemlidir, ancak envanter alanı da öyle. Öyleyse neden bir Kaltek yaparak biraz yer açmıyorsun! \\nKaltek, Kazma, Balta ve Kürek kelimelerinin birleşimidir. \\n\\nOdun soyabilir, yol yapabilir ve aynı kazma/balta/kürek kademesinin yapabildiği her türlü bloğu kazabilirler!"]
	quest.22D2CFDDB06C720C.title: "Kaltek"
	quest.22E007025C19EC0A.quest_desc: ["&l&7Railcraft&r, Trenlerin yanı sıra Dekorasyon için bazı Taşlar da ekliyor! \\n\\nCilalı, Yontulmuş veya Tuğla versiyonlarını yapmak için Quarried ve Uçurum Taşı birlikte üretilebilir! \\n\\nAyrıca Merdivenleri ve Basamakları da unutma! "]
	quest.22E007025C19EC0A.title: "&l&7Railcraft&r Taşları"
	quest.23631A4A743D4F0C.quest_desc: ["Bu konuda şikayet etmeyin bile. \\n\\nDemir elde etmenin onlarca yolu vardır ve sadece normal ilerleme için bile gereklidir. \\n\\nDemir elde edeceksin, onu bir blok haline getireceksin ve güzelleştireceksin!"]
	quest.23631A4A743D4F0C.title: "&l&bChipped&r Metalleri"
	quest.266127E7947CB3D4.quest_desc: ["Bu Görev Sayfasında gördüğün tüm güzel Yapılar ATM Discord'daki insanlardan geliyor! \\n\\nMerak etme, hepsi Yapılarının paylaşılmasına izin verdi ve hepsine atıfta bulunuldu! \\n\\nYapılarını paylaşmak istersen, Discord'daki artwork-builds-showoff Kanalına göz at! \\n\\n(Tüm Yapıların ATM10'da yapıldığını garanti edemem, sadece diğer Minecraft Oyuncuları tarafından yapıldığını garanti edebilirim. Aynı şekilde bazıları Gölgelendiriciler kullanabilir, bu nedenle Yapılarınız tam olarak aynı değilse nedeni bu olabilir!)"]
	quest.26FADB78B04F592B.quest_desc: ["&l&aBuilding Gadgets 2&r, birkaç çok yararlı eşya ekleyen bir moddur. \\n\\nElbette hepsi inşa etmek için! \\n\\nHer biri çalışmak için &cEnerji&r gerektirir ve varsayılan olarak &lG&r ile açılan bir menüye sahiptir.\\n\\nBunları bir Wireless Access Point'e yerleştirerek bir AE2 ağına bile bağlayabilirsin!"]
	quest.26FADB78B04F592B.title: "&l&aYapı Aletleri&r"
	quest.28FDB2D13D0DDE8E.quest_desc: ["&b&lChipped&r Blokların tasarımlarını değiştirdiği için Chisel Modlarına benzer, ancak &b&lChipped&r'ın bunu yapmak için kendi yolu vardır! \\n\\n&b&lChipped&r bunun yerine Blokları değiştirmek için gitmen gereken İstasyonları kullanır. \\n\\nHer biri farklı Blokları değiştiren 7 farklı İstasyon vardır: Carpenters Table Ahşap'ları değiştirir, Glassblower Cam'ları değiştirir.  \\n\\nVe bu İstasyonlardan 6 tanesi daha kolay erişim için elde taşınabilen bir Eşyaya dönüştürülebilir. \\n\\nHatta onlar için Sırt Çantası Yükseltmeleri bile var!"]
	quest.28FDB2D13D0DDE8E.title: "&l&bChipped&r"
	quest.2B4801CD3E90BD40.quest_desc: ["&l&3Handcrafted&r dekorasyon anlamında her şey demek. \\n\\nYatak Odaları için Yataklar (içinde uyuyabilecek kadar iyi görünen ve ben seçici bir uykucuyum!) ve Komodinleri var. \\n\\nOturma Odası için Sandalye ve Masalar var. \\n\\nMutfak için Fırın, Tabaklar ve Kâseler var. \\n\\nHatta gösteriş için heykeller bile var!"]
	quest.2B4801CD3E90BD40.title: "&l&3Handcrafted&r"
	quest.2B864D741F7C7549.quest_desc: ["&lProductive Trees&r tamamen Ağaçlar ve daha fazla Ağaç yapmak için Ağaçları Yetiştirmekle ilgilidir. \\n\\nBu yüzden &2&lMinecraft&r'a daha fazla Ağaç türü getirdiğini tahmin edebilirsin! \\n\\nHatta bazı özel Ahşaplar bile!"]
	quest.2B864D741F7C7549.title: "&lProductive Trees"
	quest.2BA0E5D48E234FE9.quest_desc: ["&d&lArs Nouveau&r'nun büyülü dünyası bize Magelight'ı getiriyor! Saf büyünün Işık Kaynakları! \\n\\nBüyüler kullanılarak normal bir şekilde yerleştirilebilirler ya da onun yerine Büyülü Fener üretip yerleştirebilirsin."]
	quest.2BA0E5D48E234FE9.title: "&d&lArs Nouveau&r Işıkları"
	quest.30B3BC91460C9B19.quest_desc: ["&bMacaw Sketch&r çok popüler bir Mod Geliştiricisidir. Dekor Modları ile tanınır. \\nPencerelerden, Yollara ve Çekmecelere kadar Hemen hemen her şeyi yapıyor. \\n\\nHepsini üretebilir misin?"]
	quest.30B3BC91460C9B19.title: "&bMacaw's Modları"
	quest.313F5AFF459201EB.quest_desc: ["&l&5Eternal Starlight&r keşfedilecek yepyeni bir boyut! \\n\\nVe &2&lMinecraft&r'da sürekli yapı arayanlar için, içinde bir sürü yeni Taş bulabilirsiniz! \\n\\nBoyuta ulaşmak için Portalını bulman gerekecek!"]
	quest.313F5AFF459201EB.title: "&l&5Eternal Starlight&r Taşları"
	quest.318A2CC03D1D0B04.quest_desc: ["Hiç &lYapı Wands&r'ı özlediniz mi? \\n\\nBen özledim, ve görünüşe göre &9Mrbysco&r da özlemiş! Bu yüzden &l&6Yapı Sticks&r'i yaptı! \\n\\n&6Yapı Stick&r'in birkaç farklı seviyesi vardır. Ne kadar pahalı olurlarsa, dayanıklılıkları o kadar artar ve o kadar fazla blok yerleştirebilirler. \\n\\nBaşlangıçta sadece bir alanı doldurmak için blok yerleştirirler, ancak GUI'lerini açarak ayarları değiştirilebilir. Bunun için kendi kısayol tuşunuzu ayarlamanız gerekir. \\n\\nMenüyü açtığınızda her şeyi değiştirebilirsiniz. Blokları nereye yerleştireceklerini, hangi düzende yerleştireceklerini ve hatta hangi blokları kullanacaklarını! \\n\\nAyrıca kendinize ait yükseltmeler üretebilirsiniz. Bunları kullanmak için yükseltmeyi bir demirci masasında &6Yapı Stick&r'inizle birleştirin. "]
	quest.318A2CC03D1D0B04.title: "&l&6Yapı Sticks"
	quest.3497C2E05DF5A87C.quest_desc: ["&cKızıltaş&r, &9Lapis&r, Kuvars, &5Ametist&r, &aZümrüt&r ve &bElmaslar&r hepsi Değerli Taşlardır. \\n\\nBu yüzden elbette onları Bloklara dönüştürüyoruz, tam olarak belirtmek gerekirse çok güzel değerli Bloklara!"]
	quest.3497C2E05DF5A87C.title: "&l&bChipped&r Değerli Taş Blokları"
	quest.35C46E6E27C9CB1A.quest_desc: ["10 &2Vanilla&r Kütüğü harikadır, ama sadece birkaç tasarımları var! \\n\\nTabii ki &l&bChipped&r, bu Kütükler için onlarca yeni tasarım ekleyerek katkıda bulundu!"]
	quest.35C46E6E27C9CB1A.title: "&l&bChipped&r Kütükleri"
	quest.3889D0255074CE85.quest_desc: ["&bMacaw&r mobilyaların yeterli olmadığına, Macaw evinin &b&lMacaw Pencerelerinden&r gelen doğal ışıktan daha fazlasına sahip olması gerektiğine karar verdi. \\n\\nBöylece artık her türlü Işık Kaynağını ekleyen &b&lMacaw's Lights and Lamps&r'e sahibiz. \\n\\nLambalardan Fenerlere ve Avizelere!"]
	quest.3889D0255074CE85.title: "&l&bMacaw's Lights and Lamps&r"
	quest.392F34FD4FCC794A.quest_desc: ["Pahalı olsalar da oldukça şıktırlar!"]
	quest.392F34FD4FCC794A.title: "&2&lMystical Tarım&r Blokları"
	quest.3BA4504DEFB87264.quest_desc: ["&lSimply Lights&r'a benzer şekilde çalışır, Inverted, üzerine Kızıltaş uygulanmadığında yanar, normal ise sadece Kızıltaş ile çalışır. \\n\\nBunların yerleştirilebilmesi için bir Duvara bağlı olması gerekir."]
	quest.3BA4504DEFB87264.title: "Duvar Lambaları"
	quest.3D1D5CB45D81A6E4.quest_desc: ["&b&lMacaw's Doors&r 'a benzer şekilde bu da farklı tip ve versiyonlarda Tuzak Kapıları ekliyor. \\n\\nLadin Desenli Orman Ağacı Tuzak Kapısı mı istiyorsun? Artık yapabilirsin! "]
	quest.3D1D5CB45D81A6E4.title: "&b&lMacaw's Trapdoors"
	quest.3E4B27759C973006.quest_desc: ["&l&6Framed Bloklar&r en önemli yapı Modudur. Aslında bana bir Mod paketi verirseniz ve içinde &l&6Framed Bloklar&r yoksa, oynamam. O kadar önemli! \\n\\n&l&6Framed Bloklar&r bize blok Varlığı olmayan herhangi bir Blokla doldurulabilen sahte Bloklar verir (Blok Varlıkları; Çalışma Masası, Ocak veya Zenginleştirici gibi Bloklardır). \\n\\nBu Frame'ler hemen hemen her şekilde veya herhangi bir şey olabilir! Vertical Slab'lerden, slope'lara, hatta çeyrek bloklara kadar! \\n\\n&5Netherit&r Merdiven mi istiyorsun? Öyleyse Framed Bloklar kullan! Saman Balyası Çalışma Masası mı istiyorsun? Onu elde edebilirsin! Yapında mükemmel açılar mı istiyorsun? Öyleyse &l&6Framed Bloklar&r yapmaya başla!"]
	quest.3E4B27759C973006.title: "&l&6Framed Bloklar&r"
	quest.3E76BC1D0FC3E9A8.quest_desc: ["&cMr Crayfish's&r Modundaki Tonlarca eşya Enerji Kullanır! \\n\\nOnları çalıştırmak için bir Elektrik Jeneratör'e ihtiyacın olacak. Bunları çalıştırmak için Kömür veya diğer Ocak Yakıtları gerekir! \\n\\nArdından, Jeneratör'ü Enerjiye ihtiyaç duyan Bloklarına bağlamak için Anahtar'e ihtiyacın olacak. \\n\\nJeneratör üstteki Switch ile açıldığında ve Yakıtı olduğunda, bağlı olan her şeye güç verecektir."]
	quest.3E76BC1D0FC3E9A8.title: "Elektrik Takımı"
	quest.3ED8365BAD406CC5.quest_desc: ["Bunlar evini veya üssünü dekore etmek için mükemmel bulduğum Modlar! \\n\\nBurada gösterilenlerden daha fazlasını kontrol etmekten çekinme!"]
	quest.3ED8365BAD406CC5.title: "Dekor Modları!"
	quest.3EEF17C57375CC39.quest_desc: ["&lSimply Lights&r yapımı çok basit ve kullanımı kolay ışıklar ekler.\\n\\nTers çevrildiklerinde Kızıltaş olmadan çalışacaklar ve Kızıltaş sinyali etkinleştirdiğinde kapanacaklar.\\n\\nÇok sayıda farklı renk ve şekli var!"]
	quest.3EEF17C57375CC39.title: "&lSimply Light&r"
	quest.3F185554793CCE54.quest_desc: ["Yapı için aletlere ihtiyacın olacak. Ve sen de Alet isteyeceksin. \\n\\nBlokları elde etmene yardımcı olacak Aletler, bu Blokların farklı versiyonlarını elde etmene yardımcı olacak Aletler ve Blokları yerleştirmene yardımcı olacak Aletler! \\n\\nBir çubukla başlaman gerekecek!"]
	quest.3F185554793CCE54.title: "Aletler!"
	quest.3FD9DC6B7844A79C.quest_desc: ["Betonun sıkıcı olmasından hep nefret etmişimdir, özellikle de gerçek hayatta. \\n\\nEn azından &2&lMinecraft&r'da &l&bChipped&r Modu ile farklı tasarımlar elde edebiliriz!"]
	quest.3FD9DC6B7844A79C.title: "&l&bChipped&r Betonu"
	quest.408F48C4442CE180.quest_desc: ["Dinlenme yeriniz için bol miktarda Işık ve Depolama."]
	quest.408F48C4442CE180.title: "Yatak Odası Takımı"
	quest.40C068B2B8AC0F33.quest_desc: ["Yeryüzü Şekillendirme, en basit Yapılar için bile önemli bir parçadır. Ancak biz &2&lMinecraft&r Oyuncularının bunu yapmak için ne zamanı ne de çabası var. \\n\\nÖyleyse neden bunu bizim için Makinelerin yapmasına izin vermiyoruz? \\n\\nMaden ocakları bunu yapmanın çok kolay yollarıdır ancak hepsi Blok Kırıcı'lar ile başlar. Simple Blok Kırıcı sadece önündekini kırar, bu en yararlı olanı değil... \\n\\nAncak Advanced Blok Kırıcı belirli bir alanı kazacaktır! Yeryüzü Şekillendirmesi için çok daha iyi!"]
	quest.40C068B2B8AC0F33.title: "Maden Ocakları ve Madenler"
	quest.44688FC2E34FF09F.quest_desc: ["Minecraft zaten yüzlerce blok ekliyor ve Modlar yüzlerce daha ekliyor! Ancak bazen yine de yeterli olmuyor. \\n\\nBazı Modlar ile halihazırda sahip olduğumuz Blokları farklı şekillere, tasarımlara ve hatta tamamen yeni Bloklara dönüştürebiliriz!"]
	quest.44688FC2E34FF09F.title: "Blokların Değiştirilmesi"
	quest.44BD0B40EB5451AF.quest_desc: ["Tedarik Kampları/Gemileri, &lMinecolonies&r tarafından eklenen Eşyalardır. Sana anında içinde yaşamak için Üs kurmak ve böylelikle Koloni oluşturmak için üretildiler! \\n\\nMenüyü açmak için Sağ Tıklayabilirsin, orada istediğin Kamp/Gemi türünü seçmen gerekecek! \\n\\nArdından, yerleştirmek için bir yer bulman gerekecek. Arazi düz olmalı, Kırmızı çizgili Bloklar sana neyin kırılması gerektiğini söylüyor! \\n\\nBir kez ayarlandığında, yeni Kampın/Gemin tamamen ücretsiz olarak inşa edilecektir! \\n\\nBelediye Binalarına, Yataklara, Malzemelere ve çok daha fazlasına sahip olacak!"]
	quest.44BD0B40EB5451AF.title: "Hile Yapmak"
	quest.48971CE964CF037F.quest_desc: ["Nükleer Reaktörlerimizi korumak önemli olmakla birlikte, içeriklerini görmek güvenlikle ilgilidir. \\n\\nCam, üslerimizin daha iyi görünmesini sağlamak için de kullanılabilir! \\n\\nVe gerçekten hangisi daha önemli: nükleer reaktörlerimizin güvenliği ve korunması mı? Ya da üslerimizin daha iyi görünmesini sağlamak mı?!"]
	quest.4AE8D8826F894EC7.quest_desc: ["&l&5Domun Ornamentum&r, &l&6Framed Bloklar&r ve &l&bChipped&r'ın bir araya getirilmesi gibi bir şey! \\n\\nArchitects Cutter'ı kullanarak tonlarca farklı Şekil ve Çeşitte blok yapabiliriz. \\n\\nBlok oluştururken önce hangi Grup olduğunu seç: Kapılar, Işıklar, VB. \\nArdından, bir Varyant seç. \\nBundan sonra, yapılmasını istediğimiz Bloklarımızı eklememiz gerekiyor! Bazı Bloklar iki farklı blok seçimine ihtiyaç duyarken, diğerleri sadece bir tanesine ihtiyaç duyar."]
	quest.4AE8D8826F894EC7.title: "&l&5Domun Ornamentum&r"
	quest.4B552E9D05FF5415.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r tamamen 5 farklı renkle ilgili, bu renkleri Bloklar için kullanmayı da içeriyor! \\n\\n&aYeşil&r, &cKırmızı&r, &9Mavi&r, &8Karanlık&r ve her türden Aydınlık Bloklar!"]
	quest.4B552E9D05FF5415.title: "&l&9X&cy&aC&8r&aa&cf&9t&r &lDünya"
	quest.4BC27F16229BBF46.quest_desc: ["&l&6Depolama Delight&r tamamen eşya Depolama ile ilgili ama güzel görünmesini sağlıyor. \\n\\nFarklı tasarım ve renklere sahip onlarca Çekmecesi var. \\n\\nBir Fıçı ile aynı kullanım ve alana sahiptir."]
	quest.4BC27F16229BBF46.title: "&l&6Depolama Delight&r"
	quest.4EA2DB12E8F0068F.quest_desc: ["&l&aOh The Biyomlar We've Gone&r, Dr Seuss'un \"Oh the Yerleştirs You'll Go\" kitabından esinlenerek yazılan &l&aOh The Biyomlar You'll Go&r'nun devamı niteliğindedir.\\n\\nTonlarca muhteşem yeni biyom ekliyor! Yeni bitkiler, kayalar ve tabii ki ağaçlar!"]
	quest.4EA2DB12E8F0068F.title: "&l&aOh The Biyomlar We've Gone&r Odunu"
	quest.51E77B9CD3FB6DEA.quest_desc: ["Bu gerekli değil ama ben çok faydalı buluyorum. \\n\\nKazma Pençeleri, Ellerin için Kazma Kademeni yükseltir. Böylece sadece Yumruklarınla Demir Cevherine kadar Madencilik yapabilirsin! \\n\\nBuna Taş, Terakota ve Beton gibi kazılabilir şeylerde dahildir. Ve hatta bunları Ellerinde blok varken bile kazabilirsin. \\n\\nDürüst olmak gerekirse, aslında buna ihtiyaç var."]
	quest.537B39B42C7D21ED.quest_desc: ["&l&aOh The Biyomlar We've Gone&r tarafından eklenen yeni Biyomlarda 4 yeni Taş türü bulabilirsin: Dacite, Kırmızı Taş, Yosunlu Taş ve Kayalık Taşı. \\n\\nŞimdi Kayalık Taşı'nı diğer taşlardan ayıran ve ona Kayalık ünvanını kazandıran şeyin ne olduğunu bilmek istiyorum."]
	quest.537B39B42C7D21ED.title: "&l&aOh The Biyomlar We've Gone&r Taşları"
	quest.53CE66D760CEFD7E.quest_desc: ["Lavabolar, Klozetler ve Banyolar! \\n\\nFerah ve hijyenik kalman için gereken her şey! \\n\\nHepsi Su tutar ve evet Tuvaletlerin üzerine oturabilirsin."]
	quest.53CE66D760CEFD7E.title: "Banyo Takımı"
	quest.55160BAFFD9E2988.quest_desc: ["Tam anlamıyla mükemmel &9Macaw&r Modu, &9&lMacaw's Furniture&r! \\n\\nİhtiyacın olan her şeyi ekler! Sandalyeler, Sehpalar, Kitaplıklar ve hatta Çekmeceler!"]
	quest.55160BAFFD9E2988.title: "&l&9Macaw's Furniture&r"
	quest.5716E84828EC0C23.quest_desc: ["Plastik Yapı Bricks, &l&7PneumaticCraft: Repressurized&r aracılığıyla yapılan bloklardır. \\n\\nTıpkı gerçek hayattaki benzerleri gibi üzerine basmak can yakıyor! \\n\\nBu yüzden ya Ayakkabı giy ya da Tuğlaları düzleştir."]
	quest.5716E84828EC0C23.title: "Plastik yapı Tuğlaları"
	quest.59B6C6BF0550D13D.quest_desc: ["Trenlerinizle birlikte kullanabileceğiniz yeni Cam türleri! Ya da üsleriniz için \\n\\nBelirli bir şey için kullanmana seni zorlayamam."]
	quest.59B6C6BF0550D13D.title: "&7&lRailcraft&r Camı"
	quest.5AD09CCEEDC0B50F.quest_desc: ["İşte bunlar çok faydalı, kesinlikle göz atmalısın! \\n\\nAsıl Işık Kaynağı Feral İşaret Fişeği Fener'dir. Etrafına 20 blok veya daha fazla görünmez Işık Kaynağı yerleştirir. \\n\\nMega Torch farklıdır: Işık yaymaz, ancak 64 blok içerisinde tüm Düşman Yaratıklarının ortaya çıkışlarını Engeller! Gece Görüşü kullananlar için faydalıdır. \\n\\nDread Lamp tam tersini yapar, aynı alandaki Pasif Mob'ların ortaya çıkmasını engeller."]
	quest.5AD09CCEEDC0B50F.title: "&l&eTorchmaster&r"
	quest.5C2B30655A44227F.quest_desc: ["Oo, &5&lEternal Starlight&r'ın tüm bu Metalleri kolay yoldan elde etmeni sağlayacağını mı düşündün? \\n\\nHA! Saçmalama. Patronlarla savaşman, Çamuru kazman ve Meteor Yağmuru araman gerekecek!"]
	quest.5C2B30655A44227F.title: "&5&lEternal Starlight&r Metalleri"
	quest.5D5563142917495A.quest_desc: ["&l&eFarmer's Delight&r tamamen Çiftçilik ve Gıda Eşyalarını Pişirmekle ilgili! Aynı eşyaları dekorasyon ve kullanım amaçlı de kullanabiliriz! \\n\\nOcak, Tencere ve Tavalar bir Mutfak için mükemmeldir. \\n\\nYiyecek Kasaları bir Kiler için harikadır. \\n\\nÇiftlik eşyaları dış mekan dekorasyonu için ve Kilerler her yer için mükemmeldir!"]
	quest.5D5563142917495A.title: "&l&eFarmer's Delight&r"
	quest.5E5D5D28D82F6891.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r, &lWorld Core&r'u ile çok sayıda Cam ekliyor! \\n\\nİçinden yürüyebildiklerinden, parlayanlara ve daha güçlü olanlara kadar!"]
	quest.5E5D5D28D82F6891.title: "&l&9X&cy&aC&8r&aa&cf&9t&r Camı"
	quest.5EB488C393B084C4.quest_desc: ["&lChiseled&r, &4&lRechiseled&r'ın devamı! \\n\\nBu Modun tamamı Chisel Aleti içinde çalışır, GUI'sini açmak için onunla Sağ Tıkla. \\nSolda tasarımı seçtiğin yer ve Sağ Altta Blokları yerleştirdiğin yer var.  \\n\\nBunun üzerinde tasarımı ayarlanmış desenlerde görüntüleyebilirsin: sadece 1 blok, 3x1 blok veya o Bloğun 3x3 Duvarı. Ayrıca düğmeye tıklayarak görüntüyü dönecek ya da dönmeyecek şekilde ayarlayabilirsin! \\n\\nBlokların gittiği yerin yanındaki Chisel'e tıklayabilirsin, bunu yapmak seçilen tasarımı Envanterindeki değiştirilebilecek her Bloğa ayarlayacaktır.  \\n\\nAyrıca Dayanıklılığı yoktur!"]
	quest.5EB488C393B084C4.title: "&4&lRechiseled&r"
	quest.5F7F753FD72BFBBF.quest_desc: ["&l&7Railcraft&r tarafından eklenen Daha Fazla Bloklar? Bunun trenlerle ilgili olduğundan bile şüphe etmeye başladım!"]
	quest.5F7F753FD72BFBBF.title: "&l&7Railcraft&r Renkli Bloklar"
	quest.6012D6C3253895F0.quest_desc: ["&cMr Crayfish&r, Modlanmış &2&lMinecraft&r ismiyle eş anlamlı bir addır. \\n\\nEn çok indirilen Modu elbette Mobilya Modu! \\n\\nÇalışmaya başlamak için Enerji gerektiren bir Workbench'e ihtiyacın olacak."]
	quest.6012D6C3253895F0.title: "&cMr Crayfish's Mod'ları&c"
	quest.616ED6C49C37EB91.quest_desc: ["&b&lPaths and Pathways&r, tonlarca farklı Halı benzeri Bloklar ekler (ve tam Bloklar ve Basamak türleri). \\n\\nBunlar açıkça Yol olarak kullanılıyor, sadece &2&lMinecraft&r Yol Bloğundan çok daha güzel görünüyorlar. "]
	quest.616ED6C49C37EB91.title: "&b&lMacaw's Paths and Pavings"
	quest.61BE7882EE0E6FAF.quest_desc: ["Merdivenlerden ne yuvarlanır \\nTek başına ya da çift olarak... \\nKomşunuzun köpeğinin üzerinden yuvarlanır \\nAtıştırmak için ne harikadır \\nVe sırtınıza sığar? \\n İşte bu Kütük! Kütük! Kütük!"]
	quest.6258F26293B9C1C1.quest_desc: ["Bize &9&lCrystalix&r ne veriyor diye mi soruyorsunuz? \\nCam veriyor! Hem de her çeşit cam! Normal, Şeffaf ve Çerçeveli olmak üzere. \\n\\nÇerçeveli olan, normal &2&lMinecraft&r cam desenidir. Cam olduğunu belirtmek için çerçeveleri ve köşelerde pikselleri vardır. Şeffaf olanın çerçeveleri vardır ancak köşelerde pikselleri yoktur, bu nedenle içi tamamen şeffaftır. Normal olanın ise ne çerçevesi ne de pikselleri vardır; %100 şeffaf ve tek renktir. \\n\\nHer bir &9&lCrystalix&r camının kendi özellikleri de vardır: Gölgesiz, Güçlendirilmiş, Işıklı ve Hayalet. \\n\\nGölgesiz olan, shader'lara ve hatta &2&lMinecraft&r aydınlatmasına nasıl tepki vereceğini etkiler. Güçlendirilmiş olan, patlama direncini etkiler. Işıklı olan, ışık verip vermeyeceğini, ışığı yok sayıp saymayacağını veya ışığı içeri alarak normal cam gibi davranıp davranmayacağını belirler. Hayalet olan ise, camın içinden kimlerin geçebileceğini değiştirebilir; bu en çok ayara sahip olandır."]
	quest.6258F26293B9C1C1.title: "&9&lCrystalix"
	quest.655BD0A54AF1E1CA.quest_desc: ["İçerisi için yeterince mobilya gördük, peki ya dışarısı? İçeride 4 Temmuz Barbeküsü yapamazsın! \\n\\nDış mekan takımı bize Grill'ler, Cooler'lar ve Misafirlerin vatansever kalplerle geldiklerini bildirmek için çalacakları Doorbell'ler sunuyor!"]
	quest.655BD0A54AF1E1CA.title: "Dış Mekan Takımı"
	quest.6607E5CDB3D17D67.quest_desc: ["Merak etme, bunlar yanmaz!"]
	quest.6607E5CDB3D17D67.title: "&l&bChipped&r Yünü"
	quest.667CD7C6E87A05F4.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r tabii ki Renklere ilgili olmakla birlikte, Işıklar da Renklere dayanmaktadır. \\n\\nRGB Işıklar hangi Boya ile yapılmışsa o olacaktır. \\n\\nBoya özellikle Değerli Taş değildir."]
	quest.667CD7C6E87A05F4.title: "&l&9X&cy&aC&8r&aa&cf&9t&r Işıkları"
	quest.69B5D716568AA9EB.quest_desc: [
		"&d&lCamol&r, &lHER ŞEYİ&r kamufle etmenin cevabıdır. Pipez borularından Mekanism kablolarına, ATM Star'lara ve aklınıza gelebilecek her şeye kadar (Mutfak lavabosu hariç, bekle, o da dahil).\\n\\n&d&lCamo Block&r'u, kamuflaj için kullanmak istediğiniz blokla birlikte üretin, ardından kamufle etmek istediğiniz kablo gibi bir bloğa sağ tıklayın.\\n\\nVarsayılan olarak &d&lCamo Block&r, kamufle edilen bloğun çarpışma şeklini (collision shape) alır. Bunu, tek başına bir üretim ızgarasına koyarak Şekil Koruyan versiyonuyla değiştirebilirsiniz. Bu, onun kamufle eden bloğun şeklini almasını sağlar.\\n\\nBir &d&lCamo Block&r'u kaldırmak isterseniz, kamufle edilmiş bloğa başka bir Camo Block ile sağ tıklayın."
		"{@pagebreak}"
		"{image:atm:textures/questpics/building_tips/camol_example.png width:200 height:100 align:center}"
	]
	quest.69B5D716568AA9EB.title: "&d&lCamol"
	quest.6AC85C203E7C3482.quest_desc: ["&b&lMacaw's Modları&r'ndaki her şeyden bir tane elde ettin. Bence bunu hak ettin. \\n\\nVe bununla kendi &bMacaw&r'ını elde ettiğini kastediyorum!"]
	quest.6AC85C203E7C3482.title: "&bMacaw&r Tamamlandı"
	quest.6B0D84B730C6C76C.quest_desc: ["&2&lMinecraft&r'ın size verdiği 16 renk yeterli değil mi? \\n\\nSanırım 18 tane daha alabilirsin! \\n\\n&l&cDy&6en&ea&ami&bcs&r bize &2&lMinecraft&r'ın Boyaları ile aynı Eşyalar ve Bloklar için kullanılabilecek 18 Boya daha sunuyor!  \\n\\n&6Peach&r renginde Mum mu istiyorsun? Bir tane alabilirsin! &dBumblegum&r renginde Shulker mi istiyorsun? Neden olmasın! &eFluorscent&r renginde Yatak mı istiyorsun? Tabii ki!"]
	quest.6B0D84B730C6C76C.title: "&l&cDy&6en&ea&ami&bcs&r"
	quest.6BC78AF7C9D93F11.quest_desc: ["Sırlanmış çeşitleri bile var!"]
	quest.6BC78AF7C9D93F11.title: "&l&bChipped&r Terakota"
	quest.6F65216B13E9FFA9.quest_desc: ["Bir blok elde et. Kelimenin tam anlamıyla herhangi bir blok. \\n\\nHer Oyuncu Blokların yapı yapmanın yapı taşları olduğunu bilmelidir. Gerçekten bir şey inşa etmek için Bloklara ihtiyacın olacak."]
	quest.6F65216B13E9FFA9.title: "Bloklar!"
	quest.72DB967E59EEA729.quest_desc: ["&3&lGlassential&r inşa için çok önemli bir moddur, hatta amacı olan yapılar için bile! \\nBu sadece normal Cam değil, bunların eşya üzerinde gezinirken okunabilen özellikleri var! \\n\\nİçinden geçebildiğin ancak Yaratıkların geçemediği Etereal Glass gibi. (Bunu 9sky'daki Arı Kubbem için kullandım!)"]
	quest.72DB967E59EEA729.title: "&3&lGlassential&r"
	quest.7C2ED69E07988DF4.quest_desc: ["Orijinal &2&lMinecraft&r Sandalyesi, merdivenler. \\n\\nModlu &2&lMinecraft&r'a hoş geldin, dekorasyon için merdivenlerden çok daha fazlasına sahibiz. \\n\\nDekorasyon ekleyen onlarca mod var ve dekorasyon için kullanılabilecek eşyalar ekleyen daha da fazlası var!"]
	quest.7C2ED69E07988DF4.title: "Dekorasyon!"
	quest.7CF13A4941F608E5.quest_desc: ["Normal Camdan, İnce Camlara ve hatta Mozaiklere kadar!"]
	quest.7CF13A4941F608E5.title: "&l&bChipped&r Camı"
	quest.7DA8ACE06DE8097F.quest_desc: ["&6Bakır&r, &2&lMinecraft&r'da en bol bulunan cevherdir ve ana kullanımı dekorasyondur. \\n\\nZaten &2&lMinecraft&r tarafından eklenen birçok farklı varyant var ama &l&bChipped&r bunun yeterince iyi olmadığını düşündü! Bu yüzden daha fazlasını aldık! \\n\\nHatta oksitlenmiş versiyonlar için bile varyantlar var. \\n\\nSahte &aZümrüt Bloklar&r yapabilirsin."]
	quest.7DA8ACE06DE8097F.title: "&l&bChipped &6Bakır"
	quest.7DABD82393713B5A.quest_desc: ["&c&lLuminax&r çok basit bir moddur. Renkli ışıkları seviyor musun? Renkli ışıkların olabilir. \\n\\nHepsi dokusuz, tek renklidir ve Merdivenler, Basamaklar hatta Basınç Plakaları gibi farklı şekillerde bulunabilir! \\n\\nÜstelik &l&cDy&6en&ea&ami&bcs&r ile de çalışırlar!"]
	quest.7DABD82393713B5A.title: "&l&cLuminax"
	quest.7E49C985A0433B20.quest_desc: ["&d&lArs Nouveau&r çok eğlenceli bir büyü Modu ve beraberinde kendi Ahşap grubunu getiriyor! \\n\\nArchwood, çoğu Biyomda var ama çoğunlukla Archwood Biyomunda ortaya çıkan 5 farklı renkte ağaçla gelir!"]
	quest.7E49C985A0433B20.title: "&d&lArs Nouveau&r Kütükleri"
	task.00A904FBEDE80712.title: "Macaw's Roofs"
