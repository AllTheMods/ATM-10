{
	chapter.792AD692F1468B1F.chapter_subtitle: ["Ayrıca Star Otomasyonu!"]
	chapter.792AD692F1468B1F.title: "&aBölüm 4&r: &dYaratıcı"
	chapter_group.2084F3F6FB861C5B.title: "Ana Görev Hattı"
	quest.00F00B0B66059996.quest_desc: [
				"Tamam, bir &lMultiblock&r daha! Bu, herhangi bir Deniz Üssünde görülenden daha fazla port gerektiriyor!\\n\\n&3Fluid Giriş &fve &3Çıkış&r kapaklarına, ayrıca &6Eşya Giriş &fve &6Çıkış&r kapaklarına ihtiyacımız olacak.\\n\\nBu işlem biraz uzun sürecek; bu yüzden dikkatlice takip et!\\n\\nÖncelikle, bir Ruh Tree üzerinde &lIF&r'ye ait Sıvı Çıkarıcı kullanılarak elde edilen &7Unrefined Liquid Ruhlar&r gerekiyor.\\n\\nArdından, yakındaki Source Jar'lardan Source çekip onu &dLiquefied Source&r'a dönüştüren bir &9Source Condenser&r kullanarak &dLiquefied Source&r elde etmeliyiz!\\n\\nSonra, Ruhlar, &7Unrefined Liquid Ruhlar&r ve &dLiquefied Source&r'u birleştirerek Liquid Ruhlar elde etmek için &b&lRunic Crucible&r'ı kullanabiliriz!\\n\\nSon olarak Liquid Ruhlar, &dLiquefied Source&r ve &l&5Mekanism&r'den bazı eşyaları kullanarak &5Obsidiyensteel&r üreteceğiz."
				"{@pagebreak}"
				"{image:atm:textures/questpics/chap3/creative_crucible1.png width:125 height:100 align:center}"
				"&l&bRunic Crucible&r'ın ilk katmanında ortada bir &6Gilded Chiseled Polished Darktaş&r bulunur; çevresi &9Polished Darktaş&r ile çevrilidir. Yanlarda ters çevrilmiş &9Polished Darktaş Stairs&r, köşelerde ise &7Rune Bloklar&r bulunur."
				"{image:atm:textures/questpics/chap3/creative_crucible2.png width:125 height:100 align:center}"
				"Tam ortaya bir &bArcane Crystal&r, çevresine de &9Polished Darktaş Stairs&r yerleştireceğiz. Yanlarda &6Arcane Polished Darktaş Pillars&r, kapaklarla değiştirilecek &9Polished Darktaş&r ve &6Arcane Polished Darktaş&r bulunacak."
				"{image:atm:textures/questpics/chap3/creative_crucible3.png width:125 height:100 align:center}"
				"Her köşeye &bArcane Crystal Bloklar&r yerleştirip işi bitirin!"
				"{image:atm:textures/questpics/chap3/creative_crucible4.png width:125 height:100 align:center}"
				"Son olarak, bir blok boşluk bırakarak orta &bArcane Crystal Block&r'ın üstüne &7Quantum Injector&r yerleştirin."
				"{image:atm:textures/questpics/chap3/creative_crucible5.png width:150 height:100 align:center}"
				"{image:atm:textures/questpics/chap3/creative_crucible6.png width:150 height:100 align:center}"
				"Orta katmandaki &9Polished Darktaş blokları&r, kapaklarımızı yerleştireceğimiz yerdir!"
			]
	quest.00F00B0B66059996.title: "&b&lRunic Crucible"
	quest.050CCE5D1DD6B21E.quest_desc: [
				"En önemli Çoklu Bloklardan biri. Çünkü çoğunlukla diğer Çoklu Bloklar için ona ihtiyacımız var. \\n\\nBurada Sıvı Girdisine (her Girdi sadece 1 tür Sıvı tutabilir. Bu nedenle birden fazla girdiye ihtiyacın olacak), Enerji Girdisine ve eşya Girdi ve Çıktı Kapaklarına ihtiyacın olacak. \\n\\nBu Kapakları kullanarak tüm Eşyaları, Sıvıları ve Enerjiyi içine aktarabiliriz ve diğer Çoklu blok Kontrolcüleri gibi Eşyalarımızı üretecektir! \\n\\nYa da &6Yıldız Parçaları&r için gereken Eşyalarımızı üretir! Bunlar için çok fazla Blood, Aureal, Ruh'lar ve Enerjiye ihtiyacın olacak!"
				"{@pagebreak}"
				"{image:atm:textures/questpics/chap3/creative_forge1.png width:150 height:100 align:center}"
				"İlk katman en karmaşık olanı. Ortası bir daire içinde çeşitli &cMachine Casing&r'ler ve &cPart&r'lardan oluşur. Köşelere Rune Block'ları ve &bArcane Crystal&r'ler koyacaksın. Sonrasında, geri kalanlar ise &9Polished Darktaş&r, &9Stair&r'lar ve &6Arcane Polished&r olacak."
				"{image:atm:textures/questpics/chap3/creative_forge2.png width:150 height:100 align:center}"
				"Yine de ilk katmanda, bazı &cMachine Casing&r'leri Kapaklar ile değiştirmemiz gerekecek!"
				"{image:atm:textures/questpics/chap3/creative_forge3.png width:150 height:100 align:center}"
				"Bir önceki &cMachine Part&r'ları çemberin üzerine &6Gilded Chiseled Polished Darktaş&r ve &6Chiseled Arcane Polished Darktaş&r ekleyeceğiz. Ardından, geri kalanı &9Polished Darktaş&r, &9Stair&r'lar ve &9Slab&r'ler ile doldur. Ve &bArcane Crystal Block&r'ların üzerindeki 4 &bArcane Crystal Obelisk&r'i de unutma!"
				"{image:atm:textures/questpics/chap3/creative_forge4.png width:150 height:100 align:center}"
				"Şimdi &6Gilded Chiseled Polished Darktaş&r'umuzun üzerine &6Pedestal&r'ler ve Forge'umuzu yerleştirebiliriz. Ayrıca son 4 &bArcane Crystal Obelisk&r'i de."
				"{image:atm:textures/questpics/chap3/creative_forge5.png width:200 height:100 align:center}"
				"Son olarak da birkaç Kapak daha yerleştirmek! Onlara ihtiyacımız olacak!"
				"{image:atm:textures/questpics/chap3/creative_forge6.png width:200 height:100 align:center}"
			]
	quest.050CCE5D1DD6B21E.title: "&c&lOtomatik Hepheastus Forge"
	quest.070CAEAD49B8DBA3.quest_desc: ["8 İstif &7Compressed Iron Block&r ve bir &6&lATM Yıldızı&r karşılığında &5Yaratıcı &7Compressed Iron Block&r elde edebilirsin! \\n\\nBu, ayarlanmasını istediğin herhangi bir sıcaklığa ayarlanabilir ve Makinelerinde kullanılabilir. \\n\\n8 İstif &7Compressed Iron Block&r, 4,608 &7Compressed Iron Ingot&r'a eşittir... iyi şanslar!"]
	quest.070CAEAD49B8DBA3.title: "&5&lYaratıcı &7Compressed Iron Bloklar"
	quest.0EF9C391EE42824A.quest_desc: ["Bu biraz daha pahalı ama aynı zamanda biraz daha eğlenceli! \\n\\n&bElmaslar&r hemen hemen her Mod aracılığıyla elde edilir. \\n\\n&7Çakmak Taşı&r Çakılın işlenmesinin birçok farklı yolu ile elde edilebilir: Sıkıştırarak, Ezerek, Zenginleştirerek...? \\n\\nSivri Damla Taş ve Damla Taş Blokları (sadece 4 Sivri Damla Taş olan) Extractor'ler ya da Karıştırıcı'lardan oluşturulabilir. Ancak her ikisi de daha fazlasını yapmak için orijinal Sivri Damla Taşlara ihtiyaç duyar."]
	quest.0EF9C391EE42824A.title: "&7Terrastomp Prism"
	quest.149C260C10B34BB0.quest_subtitle: "5/5"
	quest.149C260C10B34BB0.title: "&6&lATM Yıldızı&r'nın Sol parçası"
	quest.14C27D44D3C8EDF5.quest_desc: ["1. Muhtemelen bunları sadece &dEnd Şehirlerindeki&r sandıklardan vb.'den elde edeceksin. \\n\\n2. Otomatikleştirmek için tüm eşyaları elde etmen gerekecek. \\n\\nKemik Tozu, &7Barut&r, &4Kızıltaş&r, &cBlaze Tozu&r ve Kâbus Zarı. Tüm bunlar &b&lHNN&r ya da &2&lMA&r ile otomatikleştirilebilir. \\n\\n&bArcane Crystal&r'ler için ya &6&lArılar&r ya da &2&lMA&r gerekir. Ardından bunlar eritilerek &bDust&r haline getirilir."]
	quest.14C27D44D3C8EDF5.title: "&cMundabitur Dust"
	quest.173541B0765DA13E.quest_desc: ["Bunun otomatikleştirilmesi en kolay olanı olduğunu düşünüyorum. \\n\\nKâbus Zar'ları, Tüy'ler ve Yün, &b&lHNN&r aracılığıyla otomatikleştirilebilir. \\n\\nSadece &7Bat Wing&r diğerlerine göre daha zordur ve canavar çağırıcılardan elde edilmesi gerekir!"]
	quest.173541B0765DA13E.title: "&fWhirlwind Prism"
	quest.1C566975C4EC5D93.quest_desc: ["Dürüst olmak gerekirse, bunun için sadece &2&lMA&r kullan. Hepsini elde etmenin en kolay yolu bu. \\n\\nLütfen toplu &2Kaplumbağa&r üreticiler ve toplu &bGardiyan&r kıyım çiftlikleri yapma. TPS önemlidir!"]
	quest.1C566975C4EC5D93.title: "&9Sea Prism"
	quest.1D87415343E65AA7.quest_desc: ["&5Yaratıcı &8Kompresör&r istediğin Bar Pressure'ı seçmene olanak sağlar! Pozitif, Negatif, hatta 0! Makinelerin içinde kullanılabilir. \\n\\n4 istif Advanced Pressure Tube, Advanced Liquid Kompresör, Advanced Air Kompresör, Electrostatic Kompresör ve bir Flux Kompresör'e ihtiyacın olacak. \\n\\nHangisi daha zor bilmiyorum &6&lYıldızı&r elde etmek mi yoksa bunu yapmak için ihtiyacın olan tüm Malzemeleri hatırlamak mı!"]
	quest.1D87415343E65AA7.title: "&5&lYaratıcı &8Kompresör"
	quest.1FC1588A131B6A4A.quest_desc: ["Tıpkı normalde &6&lATM Yıldızı&r yapmak gibi. Bunu otomatikleştirmek de &6&lRunic Star Altar&r'ın içinde olmalı! \\n\\nNasıl inşa edileceğini ve kullanılacağını öğrenmek için Bölüm 3'teki Görev'e göz at."]
	quest.1FC1588A131B6A4A.title: "&6&lRunic Star Altar"
	quest.1FFF00B5D90C3905.quest_desc: ["&cMundabitur Dust&r'ı birçok farklı şekilde elde edebilirsin. Bu yüzden sana sadece &bArcane Crystal&r'lerini nasıl alacağını kısaca anlatacağım! \\n\\nEvet bu bir üretim malzemesidir, eğer üretmek istiyorsan.  \\n\\nÖnce &bArcane Crystal&r'ler için madencilik yapman gerekecek; daha sonra daha fazlasını yapmak için &2&lMA&r ya da &6&lArıları&r kullanabilirsin!"]
	quest.1FFF00B5D90C3905.title: "&bArcane Crystal'ler"
	quest.203C91B992BA8CF9.quest_desc: ["&6&lATM Yıldızı&r'nı yeniden yapmak için Infused &dPatrick &aStar&r'a ihtiyacımız var. Bu da &dPatrick &aYıldızı&r'na ihtiyaç duyar. Her ikisi de &6&lRunic Star Altar&r aracılığıyla yapılır. \\n\\nInfused &dPatrick &aStar&r yapmak için gereken diğer eşyalar &5&lRunic Enchanting&r ile elde edilen 4 &5Onarım Kitabı&r ve &dAşılama Yapılmış Ejderha Nefesi&r'dir. \\n\\nArılarımızdan elde edeceğimiz &6Yıldız Parçaları&r! \\n\\nVe Alaşım Külçeleri: &3Vibranium&f-&6Allthemodium&r, &5Unobtainium&f-&6Allthemodium&r ve &5Unobtainium&f-&3Vibranium&r Külçeleri. \\n\\nHer 3'ü de &6&lAllthemodium&r bölümünde açıklanan kendine has yöntemlerle üretilmiştir! \\n\\nTüm bunları &6&lRunic Star Altar&r'a fırlatıp 85MFE ekle. Sonrasında Infused &dPatrick &aStar&r'larımızı elde edeceğiz!"]
	quest.203C91B992BA8CF9.title: "Infused &dPatrick &aStar"
	quest.228CB313BAB6406E.quest_desc: ["Görünüşe göre bunun varsayılan olarak bir tarifi yokmuş! Sanki Mod Geliştiricisi, &5Yaratıcı&r Lokomotif'leri Hayatta Kalma'da kullanmanı istememiş gibi. \\n\\nÇok OP olduklarını düşünmedim. Bu yüzden &5Trainler&rinin tadını çıkar! \\n\\nNormal &3Locomotive&r'ler gibi çalışır, sadece Yakıt ve Enerji'ye ihtiyaç duymadan. Sadece &6Ray&r'lara ihtiyaç duyar."]
	quest.228CB313BAB6406E.title: "&5&lYaratıcı &8Locomotive"
	quest.235273F7C9A9B0D0.quest_subtitle: "3/5"
	quest.235273F7C9A9B0D0.title: "&6&lATM Yıldızı&r'nın Sağ Alt parçası"
	quest.23DE60E57136C207.quest_desc: ["En kolay sınırsız Enerji deposu. Sadece 4 &3Energy Battery&r (&3&lID&r'den) ve bir &6&lYıldız&r'a ihtiyaç duyar! \\n\\nHepsini &2&lMinecraft&r'ın kaldırabileceği kadar Enerji ile enerjilendirmen gerekecek... Tam anlamıyla tam sayı (integer) sınırı!"]
	quest.23DE60E57136C207.title: "&5&lYaratıcı &3Energy Battery"
	quest.360B150190A5C894.quest_desc: [
				"Birçok Modlu oynayan Oyuncunun canını sıkan bir şey de &5Büyüleme&r'nin tamamen otomatikleştirilememesi! Ve hangi &5Büyü&r'yü istediğini seçemezsin. İstediğini elde edebilmek için şanslı olman gerekir! \\n\\nMerak etme, bu iki dileğin de &5&lRunic Büyülendirici&r ile gerçekleşti! \\n\\nBunu kullanmak için &5Büyü Masası&r'na dokunmamız gerekmeyecek. Sadece doğru Eşyaları, &dKaynak&r'ı ve &aXP Fluid&r'i içine aktar. \\n\\n&aXP Fluid&r, &8&lImmersive Engineering&r'deki Şişeleme Makinesi ile herhangi bir çeşit &aSıvı TP&r'yi şişeleyerek ve ardından &7&lExtended Industrialization&r'ın Canning Machine'i ile işleyerek elde edilir. \\n\\n&6&lATM Yıldızı&r'nı yeniden yapmak için &dİnfüze Ejderha Nefesi&r ve &5Onarım Kitapları&r yapman gerekecek!"
				"{@pagebreak}"
				"(&bAçık Mavi Halı&r, &bRuh Dokunuşlu Derin Kitaplık&r"
				"&5Mor Halı&r, &5Yankılanan Sculk Kitaplığı&r"
				"&9Mavi Halı&r, &9Ruh Dokunuşlu Sculk Kitaplığı&r)"
				"{image:atm:textures/questpics/chap3/creative_enchanter1.png width:125 height:100 align:center}"
				"&5&lRunic Büyülendirici&r'ın tabanı &cMachine Casing&r'ler ve &cPart&r'lar ile dolu! Bunların etrafında &9Polished Darktaş&r'dan kare var. Ve onların etrafında da &9Polished Darktaş Stair&r'lar var!"
				"{image:atm:textures/questpics/chap3/creative_enchanter2.png width:125 height:100 align:center}"
				"Şimdi &cMachine Casing&r'lerin üzerine daha fazla &9Polished Darktaş&r, &9Stair&r'lar ve &9Slab&r'ler ekleyeceğiz. Merkezin içine biraz daha &9Stair&r'lar ve Rune Block'ları ekleyeceğiz."
				"{image:atm:textures/questpics/chap3/creative_enchanter3.png width:125 height:100 align:center}"
				"Tamam, işte zor kısım geliyor... resimdeki &aController&r'ın sol tarafta olduğunu unutma! Şimdi &5Büyü Masası&r'nı tam ortaya yerleştir. Etrafına da, orada gösterilen Halıların altına Kitaplıklarımızı yerleştir. Renk Kodunu görmek için bu sayfanın üst kısmına bak!"
				"{image:atm:textures/questpics/chap3/creative_enchanter4.png width:125 height:100 align:center}"
				"Daha fazla Kitaplık! Tekrardan &bRuh Dokunuşlu Derin Kitaplık&r, &5Yankılanan Sculk Kitaplığı&r, &9Ruh Dokunuşlu Sculk Kitaplığı&r."
				"{image:atm:textures/questpics/chap3/creative_enchanter5.png width:125 height:100 align:center}"
				"&5Büyü Masası&r'nın üzerindeki üçüncü blok, tatlı mı tatlı &7Quantum Injector&r'ımız olacak!"
				"{image:atm:textures/questpics/chap3/creative_enchanter6.png width:150 height:150 align:center}"
				"Şimdi &5&lRunic Büyülendirici&r'ımızın üzerinde küçük yapılar yapmamız gerekecek. Bu sefer sadece 4 tane! Bir &6Büyülü Hazine'nin Derin Kitaplığı&r, üstüne ve altına &9Polished Darktaş Wall&r yerleştir. Bu Wall'ların üstüne ve altına Abanoz Çitler (&l&aBWG&r'den) yerleştir. Sonra en alttaki çitin altına bir Ruh Feneri yerleştir. Bunlar &6Gilded Darktaş&r köşesinin üzerindeki 3 blok (&aController&r'ın sağındaki hariç) ve &7Quantum Injector&r'ın üzerinde 2 Bloktur.  "
				"{image:atm:textures/questpics/chap3/creative_enchanter7.png width:150 height:150 align:center}"
				"Şimdi çok benzer yapılar yapacağız. Sadece Abanoz Çitleri, Lunar Fence'ler (&5&lEternal Starlight&r'dan) ile değiştiriyoruz. Bunlar &aController&r'ın sağındaki &6Gilded Darktaş&r'un 3 blok yukarısına ve ikinci katmandaki &6Gilded Darktaş&r'un 3 blok yukarısına yerleştirilir! İkinci katmanın üzerindekiler; Kitaplıklar yerine, Kapaklarımızın yerleştirileceği yer olacak!"
			]
	quest.360B150190A5C894.title: "&5&lRunic Büyülendirici"
	quest.36ABE142039E712B.quest_desc: ["Bu normal sonsuz enerji deposu gibi çalışır. Sadece bu, sistemine bağlanabilir! Sisteminin yeterli güce sahip olup olmadığı konusunda asla endişelenmene gerek yok! Ve buna &5Kuantum Zırhı&r da dahildir.  \\n\\n4 &dSuperdense Cell&r'e ve bir &6&lATM Yıldızı&r'na ihtiyacın olacak. Her &dSuperdense Cell&r, 8 &dYoğun Enerji Hücre&r'sine ihtiyaç duyar. Her &dYoğun Enerji Hücresi&r'de, 8 &dEnerji Hücresi&r'ne ihtiyaç duyar. \\n\\n256 &dEnerji Hücresi&r... artı çok fazla enerji!"]
	quest.36ABE142039E712B.title: "&5&lYaratıcı &dEnerji Hücresi"
	quest.38BFF6F845EA479E.quest_subtitle: "4/5"
	quest.38BFF6F845EA479E.title: "&6&lATM Yıldızı&r'nın Sol Alt parçası"
	quest.3BB0926C4C00BE1D.quest_desc: ["Jetpack'indeki Enerjinin bitmesi seninde hoşuna gitmiyor mu? Artık bu konuda endişelenmene gerek yok! \\n\\nİlk başta bundan önceki her Jetpack'i, bir &6&lATM Yıldızı&r'nı, artı daha pahalı Eşyalar yapman gerekebilir ama hey buna değer! \\n\\nSadece tak ve normal şekilde kullan. Sadece daha az şarjla."]
	quest.3BB0926C4C00BE1D.title: "&5&lYaratıcı Jetpack"
	quest.3D755073C56274BE.quest_desc: ["Atomic Reconstructor'ın önüne bir Lens Eşyası bırak. Etkinleştirildiğinde Lens of &cC&eo&al&bo&3r&r'a dönüşecektir. \\n\\nÖnüne bir Lens of &cC&eo&al&bo&3r&r bırak ve patladığında Lens of &cDetonation&r yapacak. \\n\\nBunu Lens of &3Certain Death&r elde edene kadar yapmaya devam et."]
	quest.3D755073C56274BE.title: "Lens of &3Certain Death"
	quest.3D78D9F4E8A60EDB.quest_desc: ["Şu anda oldukça basit bir tarif. 4 &dKaynak Kavanozu&r, 4 &dKaynak Cevher Bloğu&r ve bir &6&lYıldız&r gerekiyor. Merak etme, bu daha zor olacak şekilde değiştirilecek! \\n\\nBu kavanoz her zaman &dKaynak&r ile doludur ve &dKaynak&r'a ihtiyaç duyan her şeye bağlanabilir. Buna &6&lATM Yıldızı&r çoklu blokları da dahil."]
	quest.3D78D9F4E8A60EDB.quest_subtitle: "Önce bunu elde et!"
	quest.3D78D9F4E8A60EDB.title: "&5&lYaratıcı &dKaynak &fKavanozu"
	quest.3FF61A4D7A250AE1.quest_desc: ["Bu &5Yaratıcı Mod &cEnerji Hücresi&r için (diğer &5Yaratıcı Mod &dEnerji Hücresi&r ile karıştırılmamalı) 4 &cNitro Hücre&r'ye ihtiyacın olacak. \\n\\nHer &cNitro Hücre&r, 2 &aSpirited Hücre&r'ye ve her &aSpirited Hücre&r, 2 &bNiotic Hücre&r'ye ihtiyaç duyar. Bu, bir süre böyle devam eder... \\n\\nBu matematiği yapmayacağım. Tarif Ağacını kontrol et. Yapacak daha önemli işlerim var!"]
	quest.3FF61A4D7A250AE1.quest_subtitle: "Sınırsız Güç!"
	quest.3FF61A4D7A250AE1.title: "&l&cEnerji Hücresi &5(Yaratıcı Mod)"
	quest.405D2571E61694FD.quest_desc: ["&6&lATM Yıldızı Bloğu&r ile &dPatrick &aArı&r'ya Sağ Tıkladığında, bir &6Yıldızlı Arı&r elde edeceksin! \\n\\nTozlaşmaları için bir &6&lATM Yıldız Bloğuna&r daha ihtiyacın olacak... Muhtemelen bunu sana daha önce söylemeliydim... \\n\\n&6Yıldızlı Arı&r'lar &6Yıldızlı Arı Petek&r'leri yapacak ve bunları daha sonra Santrifüjde kullanarak nadiren &6Yıldız Parçaları&r elde edeceksin!"]
	quest.405D2571E61694FD.title: "&6Yıldızlı Arı&r!"
	quest.427BBEB1F24E9DEE.quest_desc: ["&5Corrupti Dust&r'ın çoğu kolayca otomatikleştirilebilir. \\n\\n&4Nether Yumrusu&r herhangi bir otomatik toplama yeriyle elde edilebilir. &cBlaze Tozu&r ve &3Enderpearl Fragment&r'lar &b&lHNN&r'den elde edilebilir. Ve &bArcane Crystal&r'leri nasıl elde edeceğin başka bir Görevde gösterilmiştir. \\n\\nSadece &5Obsidiyensteel&r'in &b&lRunic Crucible&r ile otomatikleştirilmesi gerekecek."]
	quest.427BBEB1F24E9DEE.title: "&5Corrupti Dust"
	quest.4A6B585C2394A89A.quest_desc: ["&5&lRunic Büyülendirici&r'dan ihtiyacımız olan 2 eşya, &dAşılama Yapılmış Ejderha Nefesi&r ve &5Onarım Kitap&r'ları. \\n\\n&dAşılama Yapılmış Ejderha Nefesi&r oldukça basit. Sadece &aFluid XP&r, &dSource&r, ve &dEjderha Nefesi&r'ne ihtiyacın var! \\n\\n&dEjderha Nefesi&r; &b&lHNN&r ya da daha da iyisi &l&9X&cy&aC&8r&aa&cf&9t&r'den Extractor ile oldukça kolay bir şekilde toplanabilir. \\n\\n&5Onarım Kitap&r'ları; &aFluid XP&r, &dSource&r, &9Lapis Lazuli&r, &4Supremium Enchanting Base&r ve en zor kısmı olan &aTecrübe Çubuğu&r ile otomatikleştirilebilir. \\n\\n&9Lapis&r; &2&lMA&r, &6&lArılar&r ya da sadece Maden Ocaklarından elde edilebilir. \\n\\n&aTecrübe Çubuğu&r, &a&lEnderIO&r'dan iki alaşıma ihtiyaç duyacaktır: Ruharyum ve Enerjik Alaşım. Her ikisi de Alaşım Eritici'den yapılabilir. Ayrıca Şüpheli Tohumlara (Suspicious Seeds) da ihtiyacın var. Bunlar Katman Kayasını (Bedrock) ateşe vererek elde edilir. Bunu, &3&lJDT&r'den Item Clicker'lar ile Çakmaktaşı ve Çelik (Flint and Steel) kullanarak ve onları toplayacak bir şey ile otomatikleştirilebilirsin. \\n\\n&4Supremium Enchanting Base&r, &5&lRunic Büyülendirici&r için yapılmış yeni bir Eşyadır. Kitap ve Kalem'den (&b&lHNN&r ile otomatikleştirilebilir) &4Supremium Enchanting Base&r'e ulaşmak için tonlarca &aTecrübe Özü&r ve Kademe Öz'leri (Prudentium, Tertium vs.) kullanman gerekecek! \\n\\n&5&lRunic Büyülendirici&r kullanmak yerine &5Onarım Kitap&r'larını farmlamanın başka yolları da vardır. Daha fazla yazdırmak (Print) için &aTecrübe&r'yi ve bir Kitabı başka bir &5Onarım Kitap&r'ıyla birleştirmek üzere &6&lCreate&r'in &6Yazıcı&r'sını (&6Printer&r) kullanabilirsin. Ayrıca 3 &0Wither İskeleti Kafatası&r'nı ve 256 &aTecrübe Özü&r'nü bir &5Onarım Kitap&r'ına dönüştürebilen &a&lMystical Agriculture&r Enchanter'ı da mevcuttur."]
	quest.4F7F0A5162D70082.quest_desc: ["Kafan karışmasın. Dolu ve boş olmak üzere 2 tane &5Yaratıcı &aEnerji Kübü&r var. \\n\\n&aBoş Küpler&r bir Energy Trash Can olarak çalışır ve içine aktarılan tüm Enerjiyi geçersiz kılar. \\n\\n&aDolu Küpler&r sonsuz bir enerji deposu olarak çalışır. Ancak bunu yapmak için &aboş Enerji Küplerine&r ihtiyacın olacak... ve bunlar pahalı! \\n\\n&6&lATM Yıldızı&r ile 4 &aboş Enerji Küpünü&r enerjilendirerek bir tane dolu olanı elde edebilirsin."]
	quest.4F7F0A5162D70082.title: "&5&lYaratıcı &aEnerji Kübü"
	quest.5436157FDFC9633E.quest_desc: ["Infused &dPatrick &aStar&r, 5 &6Star Fragment&r, &5Corrupti Dust&r, &cMundabitur Dust&r ve Lens of the &4Killer&r ile &6&lATM Yıldız&r'larını 100% otomatik olarak yeniden yapabiliriz! \\n\\nArtık &5Yaratıcı Mod&r Eşyaları üretmek çok kolay olacak!"]
	quest.5436157FDFC9633E.title: "Tamamen Otomatikleştirilmiş &6&lATM Yıldızı"
	quest.5660E81BBEED6DC3.quest_desc: ["&dRuh Binding Crystal&r üretilmesi en zor olandır. \\n&3Ender Pearl Fragment&r'lar, &5Enderman&r'lerden toplanabilen &3Ender İnci&r'lerinden üretilebilir. Sonsuz &5Ametist&r elde etmek için Extractor kullanabilirsin. Kuvars, &2&lMA&r'dan elde edilebilir. \\n\\nŞimdi Ruh'lara odaklanmamız gerekiyor. Başlamak için normal Ruh'lara ihtiyacımız var! Ruhu çıkarmak için genellikle Ruh Kumu üzerinde bir Ruh Çıkarıcı kullanırız. \\n\\nAma bu bir eşya kullanmaktan geçiyor ve Ruh Kumunu değiştiriyor... İlk olarak, &3&lJust Dire Things&r'den bir Clicker kullanarak, onu kendi yerimize koyabiliriz! \\n\\nŞimdi Ruhsuz Kum'i, yine &3&lJust Dire Things&r'den Blok Kırıcı'lar ve Yerleştiriciler kullanarak Ruh Kumu ile değiştirmemiz gerekiyor. \\n\\nArtık Ruh'ları &5Corrupti Dust&r ve Trapped Ruh'lar (&5Lunar Guardian&r'dan toplanan Eşyalar) ile birleştirerek Corrupt Ruh'lar elde edebiliriz. \\n\\nSon olarak, Enchanted Ruh'lar yapmak için Ruh'ları, Liquid Aureal ve Holy Hand Grenade ile birleştir. Holy Hand Grenade, &c&lReliquary&r'deki bir dizi tariften geliyor."]
	quest.5660E81BBEED6DC3.title: "&dRuh Binding Crystal"
	quest.6076D1DB438EB997.quest_desc: ["Çok basit bir tarif, &7Kömür&r, &cBlaze Tozu&r ve &bArcane Crystal Block&r gerekiyor. \\n\\n&7Kömür&r ve &bArcane Crystal&r Maden Ocakları, &6&lArılar&r ya da &2&lMA&r aracılığıyla elde edilebilir. \\n\\n&cBlaze Tozu&r, bahsedilen son iki Moddan ya da Blaze çiftliğinden ve &b&lHNN&r'den elde edilebilir. &cBlaze Tozu&r elde etmenin çok fazla yolu var."]
	quest.6076D1DB438EB997.title: "&cSmelter Prism"
	quest.635BA2C17458E9E6.quest_desc: ["Bu kadar basit bir tarif için aslında oldukça kullanışlı bir Makine elde edersin!  \\n\\nBasitçe yere yerleştir, (nasıl yerleştirdiğin, bir fırlatıcı gibi hedeflediği yeri değiştirir!) biraz Güç ver ve &4Kızıltaş Meşalesi&r ile nasıl çalıştığını ayarla. \\n\\nDevre dışı bırak'a ayarlanmışsa, kendisine bir &4Kızıltaş Sinyali&r gönderildiğinde devre dışı kalacağı anlamına gelir. Pulse (Darbe) modunda ise, kendisine bir &4Kızıltaş Sinyali&r verildiğinde etkinleşeceği anlamına gelir. \\n\\nBiz sadece &6&lYıldızı&r otomatikleştirmek istiyoruz. Bu yüzden derinlemesine anlatmayacağım. Bir Lens ile başlayacağız!"]
	quest.66BAC2B478F9B119.quest_subtitle: "1/5"
	quest.66BAC2B478F9B119.title: "&6&lATM Yıldızı&r'nın Üst parçası"
	quest.66E88F916B638B3B.quest_desc: ["Bu biraz kafa karıştırıcı olabilir. Oldukça fazla &5Yaratıcı &eBüyü Kitabı&r var! Ama bizim istediğimiz &d&lAllTheArcanist Gear&r'daki büyü kitabı. \\n\\nBunu yapmak için &l&dArs Nouveau&r'dan bir tane üretmemiz gerekiyor. Bu &eBüyü Kitabı&r; &eArchmage Büyü Kitabı&r, &6&lATM Yıldızı&r ve birkaç ekstra Eşyaya ihtiyaç duyar. \\n\\n&eUnobtainium Spell Book&r ile aynı konfigürasyonlara sahip ancak sonsuz Mana'sı var ve tüm Gliflerin kilidi açık! \\n\\nAll the Spell Power BWAHAHAHAHA!"]
	quest.66E88F916B638B3B.title: "&5&lYaratıcı &eSpellbook"
	quest.6C16670D16113DE9.quest_desc: ["&6&lATM Yıldızı&r üretimini otomatikleştirmek için &6Yıldız Parçalarına&r ihtiyacımız olacak. &6Yıldız Parçaları&r elde etmek için &6Yıldızlı Arılara&r ihtiyacımız olacak. \\n\\nVe tabii ki &6Yıldızlı Arıları&r elde etmek için &dPatrick &aArılarına&r ihtiyacımız olacak! Sıcak Okyanuslarda balık tutarak nadiren &dPatrick &aArıları&r elde edebilirsin! \\nEğer onları dönüştürmek istemiyorsan, onlarla &dPatrick &aYıldız&r'ı çiftliği kurabilirsin."]
	quest.6C16670D16113DE9.title: "&dPatrick &aYıldızı&r... Arı?"
	quest.71B72958B9F80355.quest_desc: ["Endişelenme, bu aşamada daha fazla eşya düşüşü yok! \\n\\nŞimdi tek yapmamız gereken üretmek! &bElmas Kılıç&r ve &5Keskinlik V Büyüsü olan Kitap&r ile Lens of &3Certain Death&r'i, Lens of the &4Killer&r üretmek için birleştir. \\n\\n&5Büyülü Kitapları&r &5&lRunic Büyülendirici&r'dan elde edebilirsin! Başka bir Görevde daha fazlasını öğrenebilirsin!"]
	quest.71B72958B9F80355.title: "Lens of the &4Killer"
	quest.73201E591C2A40CC.quest_desc: ["Artık &6Yıldız Parçaları&rnı elde ettiğine göre, &6&lYıldızlarımız&rı yeniden yapmak için farklı parçaları yapmaya başlayabilirsin! \\n\\n1 &6&lYıldızı&r yeniden yapmak için toplam 262 &6Yıldız Parçasına&r ihtiyacın olacak... umarım iyi bir Arı kurulumu yapmışsındır!"]
	quest.73201E591C2A40CC.title: "&6Yıldız Parçaları&r"
	quest.745E616E97838D2E.quest_desc: ["&lDur!&r Hayvanların kitlesel soykırımını durdur. PETA bir uzlaşmaya varmış gibi görünüyor. Hey, sen masum hayvanları öldürmeyi bırak. Onlar da sana &5Yaratıcı &4Blood Drop&r versin! \\n\\nBununla &4Blood&r'a ihtiyaç duyan herhangi bir kabı sonsuza kadar doldurabilirsin! \\n\\nBunu üretmek için 4 &bPromise of Tenacity&r, bir &6&lATM Yıldızı&r ve &4Blood&r ile dolu olması gereken 4 farklı Eşyaya ihtiyacın olacak."]
	quest.745E616E97838D2E.title: "&5&lYaratıcı &4Blood Drop"
	quest.7A066DD274F970C2.quest_subtitle: "2/5"
	quest.7A066DD274F970C2.title: "&6&lATM Yıldızı&r'nın Sağ parçası"
	quest.7C9154EF6068BE27.quest_desc: ["Teknik olarak Ezici'yi &6&lATM Yıldızı&r'nı 5 &6Yıldız Parçası&r'na dönüştürmek içinde kullanabilirsin... \\n\\nAma yeni &6&lYıldız&r yapmak için 262 tanesine ihtiyacın olacak... \\n\\nÖyleyse neden yapasın ki?"]
	quest.7C9154EF6068BE27.title: "Ama neden?"
}
