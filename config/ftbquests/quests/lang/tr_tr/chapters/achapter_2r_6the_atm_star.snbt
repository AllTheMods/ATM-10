{
	chapter.792AD692F1468B1F.chapter_subtitle: ["Ayrıca Yıldız Otomasyonu!"]
	chapter.792AD692F1468B1F.title: "&aBölüm 4&r: &dYaratıcı"
	chapter_group.2084F3F6FB861C5B.title: "Ana Görev Hattı"
	quest.00F00B0B66059996.quest_desc: [
				"Tamam, bir &lMultiblock&r daha! Bu, herhangi bir Deniz Üssünde görülenden daha fazla port gerektiriyor!\\n\\n&3Fluid Input &fve &3Output&r Hatch'lerine, ayrıca &6Item Input &fve &6Output&r Hatch'lerine ihtiyacımız olacak.\\n\\nBu işlem biraz uzun sürecek; bu yüzden dikkatlice takip et!\\n\\nÖncelikle, bir Soul Tree üzerinde &lIF&r'ye ait Sıvı Çıkarıcı kullanılarak elde edilen &7Unrefined Liquid Souls&r gerekiyor.\\n\\nArdından, yakındaki Source Jar'lardan Source çekip onu &dLiquefied Source&r'a dönüştüren bir &9Source Condenser&r kullanarak &dLiquefied Source&r elde etmeliyiz!\\n\\nSonra, Souls, &7Unrefined Liquid Souls&r ve &dLiquefied Source&r'u birleştirerek Liquid Souls elde etmek için &b&lRunic Crucible&r'ı kullanabiliriz!\\n\\nSon olarak Liquid Souls, &dLiquefied Source&r ve &l&5Mekanism&r'den bazı eşyaları kullanarak &5Obsidiansteel&r üreteceğiz."
				"{@pagebreak}"
				"{image:atm:textures/questpics/chap3/creative_crucible1.png width:125 height:100 align:center}"
				"&l&bRunic Crucible&r'ın ilk katmanında ortada bir &6Gilded Chiseled Polished Darkstone&r bulunur; çevresi &9Polished Darkstone&r ile çevrilidir. Yanlarda ters çevrilmiş &9Polished Darkstone Stairs&r, köşelerde ise &7Rune Blocks&r bulunur."
				"{image:atm:textures/questpics/chap3/creative_crucible2.png width:125 height:100 align:center}"
				"Tam ortaya bir &bArcane Crystal&r, çevresine de &9Polished Darkstone Stairs&r yerleştireceğiz. Yanlarda &6Arcane Polished Darkstone Pillars&r, Hatch'lerle değiştirilecek &9Polished Darkstone&r ve &6Arcane Polished Darkstone&r bulunacak."
				"{image:atm:textures/questpics/chap3/creative_crucible3.png width:125 height:100 align:center}"
				"Her köşeye &bArcane Crystal Blocks&r yerleştirip işi bitirin!"
				"{image:atm:textures/questpics/chap3/creative_crucible4.png width:125 height:100 align:center}"
				"Son olarak, bir blok boşluk bırakarak orta &bArcane Crystal Block&r'ın üstüne &7Quantum Injector&r yerleştirin."
				"{image:atm:textures/questpics/chap3/creative_crucible5.png width:150 height:100 align:center}"
				"{image:atm:textures/questpics/chap3/creative_crucible6.png width:150 height:100 align:center}"
				"Orta katmandaki &9Polished Darkstone blocks&r, Hatch'lerimizi yerleştireceğimiz yerdir!"
			]
	quest.00F00B0B66059996.title: "&b&lRunic Crucible"
	quest.050CCE5D1DD6B21E.quest_desc: [
				"En önemli Multiblock'lardan biri; çünkü diğer Multiblock'lar için çoğunlukla buna ihtiyacımız var. \\n\\nBurada &bFluid Input&r (her Input yalnızca bir Fluid türü tutabildiği için birden fazlası gerekir), &cEnergy Input&r ve &eItem Input&r ile Output Hatch'lerine ihtiyacın olacak. \\n\\nBu Hatch'lerle tüm &eItems&r, &bFluids&r ve &cEnergy&r girdilerini sağlayabilir; diğer &5Multiblock Controllers&r gibi eşyalarımızı üretebiliriz. \\n\\nBöylece &6Star Parts&r için gereken eşyaları da üretebiliriz! Bunlar için çok miktarda &4Blood&f, &bAureal&f, Souls ve &cEnergy&r gerekecek!"
				"{@pagebreak}"
				"{image:atm:textures/questpics/chap3/creative_forge1.png width:150 height:100 align:center}"
				"İlk katman oldukça basit: birkaç &9Polished Darkstone Blocks &fve &9Stairs&r; ayrıca &7Rune Blocks&r ve &6Arcane Polished Darkstone&r. Ah, neredeyse en önemli bloğu unutuyordum: &5Forge Block&r."
				"{image:atm:textures/questpics/chap3/creative_forge2.png width:150 height:100 align:center}"
				"Sonraki katmanda &9Blocks&f, &9Stairs&f ve &9Slabs&r biçiminde daha fazla &9Darkstone&r; ayrıca &6Gilded Arcane Polished Darkstone&r ve &6Chiseled Polished Arcane Darkstone&r olacak. Dört &bArcane Crystal Obelisks&r'i de unutma!"
				"{image:atm:textures/questpics/chap3/creative_forge3.png width:150 height:100 align:center}"
				"Bu katman çok kolay! Ortada kare biçiminde bir &9&lTier 5 &6Forge&r ve ondan iki blok uzakta sekiz &6Darkstone Pedestals&r bulunacak."
				"{image:atm:textures/questpics/chap3/creative_forge4.png width:150 height:100 align:center}"
				"Bu katmanda hiçbir şey eklenmediği için bir katmanı atlıyoruz. Aralarında bir blok boşluk bırakarak &7Quantum Injector&r'ı &9&lTier 5 &6Forge&r'un üstüne yerleştir."
				"{image:atm:textures/questpics/chap3/creative_forge5.png width:200 height:100 align:center}"
				"{image:atm:textures/questpics/chap3/creative_forge6.png width:200 height:100 align:center}"
				"Son olarak birkaç Hatch daha yerleştir! Onlara ihtiyacımız olacak!"
			]
	quest.050CCE5D1DD6B21E.title: "&c&lAutomatic Hepheastus Forge"
	quest.070CAEAD49B8DBA3.quest_desc: ["8 İstif &7Compressed Iron Block&r ve bir &6&lATM Yıldızı&r karşılığında &5Yaratıcı &7Compressed Iron Block&r elde edebilirsin! \\n\\nBu, ayarlanmasını istediğin herhangi bir sıcaklığa ayarlanabilir ve Makinelerinde kullanılabilir. \\n\\n8 İstif &7Compressed Iron Block&r, 4,608 &7Compressed Iron Ingot&r'a eşittir... iyi şanslar!"]
	quest.070CAEAD49B8DBA3.title: "&5&lYaratıcı &7Compressed Iron Bloklar"
	quest.0EF9C391EE42824A.quest_desc: ["Bu biraz daha pahalı ama aynı zamanda biraz daha eğlenceli! \\n\\n&bElmaslar&r hemen hemen her Mod aracılığıyla elde edilir. \\n\\n&7Çakmak Taşı&r Çakılın işlenmesinin birçok farklı yolu ile elde edilebilir: Sıkıştırarak, Ezerek, Zenginleştirerek...? \\n\\nSivri Damla Taş ve Damla Taş Blokları (sadece 4 Sivri Damla Taş olan) Extractor'ler ya da Karıştırıcı'lardan oluşturulabilir. Ancak her ikisi de daha fazlasını yapmak için orijinal Sivri Damla Taşlara ihtiyaç duyar."]
	quest.0EF9C391EE42824A.title: "&7Terrastomp Prism"
	quest.149C260C10B34BB0.quest_subtitle: "5/5"
	quest.149C260C10B34BB0.title: "&6&lATM Yıldızı&r'nın Sol parçası"
	quest.14C27D44D3C8EDF5.quest_desc: ["1. Muhtemelen bunları sadece &dEnd Şehirlerindeki&r sandıklardan vb.'den elde edeceksin. \\n\\n2. Otomatikleştirmek için tüm eşyaları elde etmen gerekecek. \\n\\nKemik Tozu, &7Barut&r, &4Redstone&r, &cBlaze Tozu&r ve Kâbus Zarı. Tüm bunlar &b&lHNN&r ya da &2&lMA&r ile otomatikleştirilebilir. \\n\\n&bArcane Crystal&r'ler için ya &6&lArılar&r ya da &2&lMA&r gerekir. Ardından bunlar eritilerek &bDust&r haline getirilir."]
	quest.14C27D44D3C8EDF5.title: "&cMundabitur Dust"
	quest.173541B0765DA13E.quest_desc: ["Bunun otomatikleştirilmesi en kolay olanı olduğunu düşünüyorum. \\n\\nKâbus Zar'ları, Tüy'ler ve Yün, &b&lHNN&r aracılığıyla otomatikleştirilebilir. \\n\\nSadece &7Bat Wing&r diğerlerine göre daha zordur ve canavar çağırıcılardan elde edilmesi gerekir!"]
	quest.173541B0765DA13E.title: "&fWhirlwind Prism"
	quest.1C566975C4EC5D93.quest_desc: ["Dürüst olmak gerekirse, bunun için sadece &2&lMA&r kullan. Hepsini elde etmenin en kolay yolu bu. \\n\\nLütfen toplu &2Kaplumbağa&r üreticiler ve toplu &bGardiyan&r kıyım çiftlikleri yapma. TPS önemlidir!"]
	quest.1C566975C4EC5D93.title: "&9Sea Prism"
	quest.1D87415343E65AA7.quest_desc: ["&5Creative &8Compressor&r istediğin Bar Pressure'ı seçmene olanak sağlar! Pozitif, negatif, hatta 0! Makinelerin içinde kullanılabilir. \\n\\n4 istif Advanced Pressure Tubes, bir Advanced Liquid Compressor, Advanced Air Compressor, Electrostatic Compressor ve Flux Compressor'a ihtiyacın olacak. \\n\\nHangisi daha zor bilmiyorum: &6&lStar&r'ı elde etmek mi, yoksa bunu yapmak için gereken tüm malzemeleri hatırlamak mı!"]
	quest.1D87415343E65AA7.title: "&5&lCreative &8Compressor"
	quest.1FC1588A131B6A4A.quest_desc: ["Tıpkı normalde &6&lATM Yıldızı&r yapmak gibi. Bunu otomatikleştirmek de &6&lRunic Star Altar&r'ın içinde olmalı! \\n\\nNasıl inşa edileceğini ve kullanılacağını öğrenmek için Bölüm 3'teki Görev'e göz at."]
	quest.1FC1588A131B6A4A.title: "&6&lRunic Star Altar"
	quest.1FFF00B5D90C3905.quest_desc: ["&cMundabitur Dust&r'ı birçok farklı şekilde elde edebilirsin. Bu yüzden sana sadece &bArcane Crystal&r'lerini nasıl alacağını kısaca anlatacağım! \\n\\nEvet bu bir üretim malzemesidir, eğer üretmek istiyorsan.  \\n\\nÖnce &bArcane Crystal&r'ler için madencilik yapman gerekecek; daha sonra daha fazlasını yapmak için &2&lMA&r ya da &6&lArıları&r kullanabilirsin!"]
	quest.1FFF00B5D90C3905.title: "&bArcane Crystal'ler"
	quest.203C91B992BA8CF9.quest_desc: ["&6&lATM Yıldızı&r'nı yeniden yapmak için Infused &dPatrick &aStar&r'a ihtiyacımız var. Bu da &dPatrick &aYıldızı&r'na ihtiyaç duyar. Her ikisi de &6&lRunic Star Altar&r aracılığıyla yapılır. \\n\\nInfused &dPatrick &aStar&r yapmak için gereken diğer eşyalar &5&lRunic Enchanting&r ile elde edilen 4 &5Onarım Kitabı&r ve &dAşılama Yapılmış Ejderha Nefesi&r'dir. \\n\\nArılarımızdan elde edeceğimiz &6Yıldız Parçaları&r! \\n\\nVe Alaşım Külçeleri: &3Vibranium&f-&6Allthemodium&r, &5Unobtainium&f-&6Allthemodium&r ve &5Unobtainium&f-&3Vibranium&r Külçeleri. \\n\\nHer 3'ü de &6&lAllthemodium&r bölümünde açıklanan kendine has yöntemlerle üretilmiştir! \\n\\nTüm bunları &6&lRunic Star Altar&r'a fırlatıp 85MFE ekle. Sonrasında Infused &dPatrick &aStar&r'larımızı elde edeceğiz!"]
	quest.203C91B992BA8CF9.title: "Infused &dPatrick &aStar"
	quest.228CB313BAB6406E.quest_desc: ["Görünüşe göre bunun varsayılan olarak bir tarifi yokmuş! Sanki mod geliştiricisi, &5Creative&r Locomotive'leri Survival'da kullanmanı istememiş gibi. \\n\\nÇok güçlü olduklarını düşünmedim; bu yüzden &5Train&r'lerinin tadını çıkar! \\n\\nNormal &3Locomotive&r'ler gibi çalışırlar; yalnızca Fuel veya Energy gerektirmezler. Sadece &6Rails&r gerekir."]
	quest.228CB313BAB6406E.title: "&5&lYaratıcı &8Locomotive"
	quest.235273F7C9A9B0D0.quest_subtitle: "3/5"
	quest.235273F7C9A9B0D0.title: "&6&lATM Yıldızı&r'nın Sağ Alt parçası"
	quest.23DE60E57136C207.quest_desc: ["En kolay sınırsız Enerji deposu. Sadece 4 &3Energy Battery&r (&3&lID&r'den) ve bir &6&lYıldız&r'a ihtiyaç duyar! \\n\\nHepsini &2&lMinecraft&r'ın kaldırabileceği kadar Enerji ile enerjilendirmen gerekecek... Tam anlamıyla tam sayı (integer) sınırı!"]
	quest.23DE60E57136C207.title: "&5&lYaratıcı &3Energy Battery"
	quest.360B150190A5C894.quest_desc: [
				"Birçok modlu Minecraft oyuncusunun canını sıkan şeylerden biri, &5Enchanting&r'in tamamen otomatikleştirilememesidir! Ayrıca hangi &5Enchants&r'ı istediğini seçemezsin; istediğini elde etmek için şanslı olman gerekir! \\n\\nEndişelenme, &5&lRunic Enchanter&r bu iki isteği de karşılıyor! \\n\\nBunu kullanmak için &5Büyü Masası&r'na dokunmana gerek yok; doğru eşyaları, &dSource&r'u ve &aXP Fluid&r'i borularla içine aktarman yeterli. \\n\\n&aXP Fluid&r elde etmek için herhangi bir &aLiquid XP&r türünü &8&lImmersive Engineering&r modundaki Şişeleme Makinesi ile şişele, ardından &7&lExtended Industrialization&r modundaki Canning Machine'de işle. \\n\\n&6&lATM Star&r'ı yeniden yapmak için &dAşılama Yapılmış Ejderha Nefesi&r ve &5Mending Books&r üretmen gerekecek!"
				"{@pagebreak}"
				"(&bLight Blue Carpet&r = &bRuh Dokunuşlu Derin Kitaplık&r"
				"&5Purple Carpet&r = &5Yankılanan Sculk Kitaplığı&r"
				"&9Blue Carpet&r = &9Ruh Dokunuşlu Sculk Kitaplığı&r)"
				"{image:atm:textures/questpics/chap3/creative_enchanter1.png width:125 height:100 align:center}"
				"&5&lRunic Enchanter&r'ın tabanında neredeyse her şey var: bolca &9Darkstone&r, Bookshelves, &7Rune Blocks&r ve &bArcane Crystal Blocks&r!"
				"{image:atm:textures/questpics/chap3/creative_enchanter2.png width:125 height:100 align:center}"
				"Benzer biçimde devam edeceğiz; yalnızca &7Rune Blocks&r ve &bArcane Crystal Blocks&r yerine &6Gilded Chiseled Polished Darkstone&r ve &6Darkstone Pillars&r yerleştir. Evet, yeni görünen komik kareler &6Darkstone Pillars&r'ın üstleridir!"
				"{image:atm:textures/questpics/chap3/creative_enchanter3.png width:125 height:100 align:center}"
				"Merak etme, yapı kolaylaşıyor! Birkaç Bookshelf'i koruyup &6Darkstone Pedestals&r ve bir &5Büyü Masası&r ekle."
				"{image:atm:textures/questpics/chap3/creative_enchanter4.png width:125 height:100 align:center}"
				"Bu katman daha da kolay: son Bookshelf'lerin üzerine yalnızca dört &bSoul Lanterns&r yerleştir."
				"{image:atm:textures/questpics/chap3/creative_enchanter5.png width:125 height:100 align:center}"
				"Bir &7Quantum Injector&r'ı &5Büyü Masası&r'nın bir blok üstüne yerleştir."
				"{image:atm:textures/questpics/chap3/creative_enchanter6.png width:150 height:150 align:center}"
				"{image:atm:textures/questpics/chap3/creative_enchanter7.png width:150 height:150 align:center}"
				"Muhtemelen daha önce söylemeliydim ama Hatch'ler &5&lRunic Enchanter&r'ın altına yerleştiriliyor... üzgünüm!"
			]
	quest.360B150190A5C894.title: "&5&lRunic Enchanter"
	quest.36ABE142039E712B.quest_desc: ["Bu normal sonsuz enerji deposu gibi çalışır. Sadece bu, sistemine bağlanabilir! Sisteminin yeterli güce sahip olup olmadığı konusunda asla endişelenmene gerek yok! Ve buna &5Kuantum Zırhı&r da dahildir.  \\n\\n4 &dSuperdense Cell&r'e ve bir &6&lATM Yıldızı&r'na ihtiyacın olacak. Her &dSuperdense Cell&r, 8 &dYoğun Enerji Hücre&r'sine ihtiyaç duyar. Her &dYoğun Enerji Hücresi&r'de, 8 &dEnerji Hücresi&r'ne ihtiyaç duyar. \\n\\n256 &dEnerji Hücresi&r... artı çok fazla enerji!"]
	quest.36ABE142039E712B.title: "&5&lYaratıcı Mod &dEnerji Hücresi"
	quest.38BFF6F845EA479E.quest_subtitle: "4/5"
	quest.38BFF6F845EA479E.title: "&6&lATM Yıldızı&r'nın Sol Alt parçası"
	quest.3BB0926C4C00BE1D.quest_desc: ["Jetpack'indeki Enerjinin bitmesi seninde hoşuna gitmiyor mu? Artık bu konuda endişelenmene gerek yok! \\n\\nİlk başta bundan önceki her Jetpack'i, bir &6&lATM Yıldızı&r'nı, artı daha pahalı Eşyalar yapman gerekebilir ama hey buna değer! \\n\\nSadece tak ve normal şekilde kullan. Sadece daha az şarjla."]
	quest.3BB0926C4C00BE1D.title: "&5&lYaratıcı Jetpack"
	quest.3D755073C56274BE.quest_desc: ["Atomic Reconstructor'ın önüne bir Lens Eşyası bırak. Etkinleştirildiğinde Lens of &cC&eo&al&bo&3r&r'a dönüşecektir. \\n\\nÖnüne bir Lens of &cC&eo&al&bo&3r&r bırak; makine etkinleştiğinde Lens of &cDetonation&r elde edeceksin. \\n\\nBunu Lens of &3Certain Death&r elde edene kadar yapmaya devam et."]
	quest.3D755073C56274BE.title: "Lens of &3Certain Death"
	quest.3D78D9F4E8A60EDB.quest_desc: ["Şu anda oldukça basit bir tarif. 4 &dKaynak Kavanozu&r, 4 &dKaynak Cevher Bloğu&r ve bir &6&lYıldız&r gerekiyor. Merak etme, bu daha zor olacak şekilde değiştirilecek! \\n\\nBu kavanoz her zaman &dKaynak&r ile doludur ve &dKaynak&r'a ihtiyaç duyan her şeye bağlanabilir. Buna &6&lATM Yıldızı&r çoklu blokları da dahil."]
	quest.3D78D9F4E8A60EDB.quest_subtitle: "Önce bunu elde et!"
	quest.3D78D9F4E8A60EDB.title: "&5&lYaratıcı &dKaynak &fKavanozu"
	quest.3FF61A4D7A250AE1.quest_desc: ["Bu &5Yaratıcı Mod &cEnerji Hücresi&r için (diğer &5Yaratıcı Mod &dEnerji Hücresi&r ile karıştırılmamalı) 4 &cNitro Hücre&r'ye ihtiyacın olacak. \\n\\nHer &cNitro Hücre&r, 2 &aSpirited Hücre&r'ye ve her &aSpirited Hücre&r, 2 &bNiotic Hücre&r'ye ihtiyaç duyar. Bu, bir süre böyle devam eder... \\n\\nBu matematiği yapmayacağım. Tarif Ağacını kontrol et. Yapacak daha önemli işlerim var!"]
	quest.3FF61A4D7A250AE1.quest_subtitle: "Sınırsız Güç!"
	quest.3FF61A4D7A250AE1.title: "&l&cEnerji Hücresi &5(Yaratıcı Mod)"
	quest.405D2571E61694FD.quest_desc: ["&6&lATM Yıldızı Bloğu&r ile &dPatrick &aArı&r'ya Sağ Tıkladığında, bir &6Yıldızlı Arı&r elde edeceksin! \\n\\nTozlaşmaları için bir &6&lATM Yıldız Bloğuna&r daha ihtiyacın olacak... Muhtemelen bunu sana daha önce söylemeliydim... \\n\\n&6Yıldızlı Arı&r'lar &6Yıldızlı Arı Petek&r'leri yapacak ve bunları daha sonra Santrifüjde kullanarak nadiren &6Yıldız Parçaları&r elde edeceksin!"]
	quest.405D2571E61694FD.title: "&6Yıldızlı Arı&r!"
	quest.427BBEB1F24E9DEE.quest_desc: ["&5Corrupti Dust&r'ın çoğu kolayca otomatikleştirilebilir. \\n\\n&4Nether Yumrusu&r herhangi bir otomatik çiftlikle elde edilebilir. &cBlaze Powder&r ve &3Enderpearl Fragments&r, &b&lHNN&r ile elde edilebilir. &bArcane Crystals&r'ın nasıl elde edileceği ise başka bir görevde gösterilmiştir. \\n\\nYalnızca &5Obsidiansteel&r'in &b&lRunic Crucible&r ile otomatikleştirilmesi gerekecek."]
	quest.427BBEB1F24E9DEE.title: "&5Corrupti Dust"
	quest.4A6B585C2394A89A.quest_desc: ["&5&lRunic Enchanter&r'dan ihtiyacımız olan iki eşya, &dAşılama Yapılmış Ejderha Nefesi&r ve &5Mending Books&r. \\n\\n&dAşılama Yapılmış Ejderha Nefesi&r oldukça basit: yalnızca &aFluid XP&r, &dSource&r ve &dEjderha Nefesi&r gerekir. \\n\\n&dEjderha Nefesi&r, &b&lHNN&r ile veya daha da iyisi &l&9X&cy&aC&8r&aa&cf&9t&r'den bir Extractor ile kolayca toplanabilir. \\n\\n&5Mending Books&r; &aFluid XP&r, &dSource&r, &9Lapis Lazuli&r, &4Supremium Enchanting Base&r ve en zor parça olan &aExperience Rod&r ile otomatikleştirilebilir. \\n\\n&9Lapis&r; &2&lMA&r, &6&lBees&r veya Quarries ile elde edilebilir. \\n\\n&aExperience Rod&r için &a&lEnderIO&r'dan iki alaşım gerekir: Soularium ve Energetic Alloy. İkisi de Alloy Smelter'da yapılabilir. Ayrıca Suspicious Seeds gerekir. Bunlar Bedrock ateşe verilerek elde edilir. Bu işlemi &3&lJDT&r Item Clickers, Flint and Steel ve düşenleri toplayacak bir araçla otomatikleştirebilirsin. \\n\\n&4Supremium Enchanting Base&r, &5&lRunic Enchanter&r için eklenmiş yeni bir eşyadır. Book and Quill'den (&b&lHNN&r ile otomatikleştirilebilir) &4Supremium Enchanting Base&r'e ulaşmak için çok miktarda &aEXP Essence&r ve kademeli Essence (Prudentium, Tertium vb.) kullanman gerekecek. \\n\\n&5&lRunic Enchanter&r yerine &5Mending Books&r toplamanın başka yolları da vardır. &6&lCreate&r'in &6Printer&r'ıyla &aExperience&r ve bir Book'u başka bir &5Mending Book&r ile birleştirip daha fazlasını yazdırabilirsin. Ayrıca &a&lMystical Agriculture&r Enchanter, üç &0Wither İskeleti Kafatası&r ve 256 &aExperience Essence&r'ı bir &5Mending Book&r'a dönüştürebilir."]
	quest.4F7F0A5162D70082.quest_desc: ["Kafan karışmasın. Dolu ve boş olmak üzere 2 tane &5Yaratıcı Mod &aEnerji Küpü&r var. \\n\\n&aBoş Küpler&r bir Energy Trash Can olarak çalışır ve içine aktarılan tüm Enerjiyi geçersiz kılar. \\n\\n&aDolu Küpler&r sonsuz bir enerji deposu olarak çalışır. Ancak bunu yapmak için &aboş Enerji Küplerine&r ihtiyacın olacak... ve bunlar pahalı! \\n\\n&6&lATM Yıldızı&r ile 4 &aboş Enerji Küpünü&r enerjilendirerek bir tane dolu olanı elde edebilirsin."]
	quest.4F7F0A5162D70082.title: "&5&lYaratıcı Mod &aEnerji Küpü"
	quest.5436157FDFC9633E.quest_desc: ["Infused &dPatrick &aStar&r, 5 &6Star Fragment&r, &5Corrupti Dust&r, &cMundabitur Dust&r ve Lens of the &4Killer&r ile &6&lATM Yıldız&r'larını 100% otomatik olarak yeniden yapabiliriz! \\n\\nArtık &5Yaratıcı Mod&r Eşyaları üretmek çok kolay olacak!"]
	quest.5436157FDFC9633E.title: "Tamamen Otomatikleştirilmiş &6&lATM Yıldızı"
	quest.5660E81BBEED6DC3.quest_desc: ["&dSoul Binding Crystal&r üretilmesi en zor olanıdır. \\n&3Ender Pearl Fragments&r, &5Endermen&r'den toplanabilen &3Ender İncileri&r'nden üretilebilir. Sonsuz &5Amethyst&r elde etmek için Extractor kullanabilirsin. Quartz, &2&lMA&r ile üretilebilir. \\n\\nŞimdi Souls'a odaklanmamız gerekiyor. Başlangıç için normal Souls gerekir; bunları genellikle Soul Sand üzerinde Soul Extractor kullanarak çıkarırız. \\n\\nBu işlem bir eşya kullanır ve Soul Sand'i değiştirir. Önce &3&lJust Dire Things&r'den bir Clicker kullanarak oyuncunun yaptığı tıklamayı otomatikleştirebiliriz. \\n\\nArdından Souless Sand'i, yine &3&lJust Dire Things&r'den Block Breakers ve Placers kullanarak Soul Sand ile değiştirmeliyiz. \\n\\nSouls'u &5Corrupti Dust&r ve Trapped Souls (&5Lunar Guardian&r'dan toplanan eşyalar) ile birleştirerek Corrupt Souls elde edebiliriz. \\n\\nSon olarak Souls'u Liquid Aureal ve Holy Hand Grenade ile birleştirerek Enchanted Souls yap. Holy Hand Grenade, &c&lReliquary&r'deki bir tarif zincirinden gelir."]
	quest.5660E81BBEED6DC3.title: "&dSoul Binding Crystal"
	quest.6076D1DB438EB997.quest_desc: ["Çok basit bir tarif, &7Kömür&r, &cBlaze Tozu&r ve &bArcane Crystal Block&r gerekiyor. \\n\\n&7Kömür&r ve &bArcane Crystal&r; Quarries, &6&lArılar&r ya da &2&lMA&r aracılığıyla elde edilebilir. \\n\\n&cBlaze Tozu&r, bahsedilen son iki Moddan ya da Blaze çiftliğinden ve &b&lHNN&r'den elde edilebilir. &cBlaze Tozu&r elde etmenin çok fazla yolu var."]
	quest.6076D1DB438EB997.title: "&cSmelter Prism"
	quest.635BA2C17458E9E6.quest_desc: ["Bu kadar basit bir tarif için oldukça kullanışlı bir Machine elde edersin! \\n\\nOnu yere yerleştir (yerleştirme yönün, bir dispenser gibi nereye nişan aldığını belirler), biraz Power ver ve çalışma biçimini bir &4Redstone Torch&r ile ayarla. \\n\\nDeactivate moduna ayarlanmışsa bir &4Redstone Signal&r aldığında devre dışı kalır. Pulse modunda ise her &4Redstone Signal&r verildiğinde etkinleşir. \\n\\nAmacımız yalnızca &6&lStar&r'ı otomatikleştirmek; bu yüzden ayrıntıya girmeyeceğim. Bir Lens ile başlayacağız!"]
	quest.66BAC2B478F9B119.quest_subtitle: "1/5"
	quest.66BAC2B478F9B119.title: "&6&lATM Yıldızı&r'nın Üst parçası"
	quest.66E88F916B638B3B.quest_desc: ["Bu biraz kafa karıştırıcı olabilir. Oldukça fazla &5Yaratıcı &eBüyü Kitabı&r var! Ama bizim istediğimiz &d&lAllTheArcanist Gear&r'daki büyü kitabı. \\n\\nBunu yapmak için &l&dArs Nouveau&r'dan bir tane üretmemiz gerekiyor. Bu &eBüyü Kitabı&r; &eArchmage Büyü Kitabı&r, &6&lATM Yıldızı&r ve birkaç ekstra Eşyaya ihtiyaç duyar. \\n\\n&eUnobtainium Spell Book&r ile aynı konfigürasyonlara sahip ancak sonsuz Mana'sı var ve tüm Gliflerin kilidi açık! \\n\\nAll the Spell Power BWAHAHAHAHA!"]
	quest.66E88F916B638B3B.title: "&5&lYaratıcı &eSpellbook"
	quest.6C16670D16113DE9.quest_desc: ["&6&lATM Yıldızı&r üretimini otomatikleştirmek için &6Yıldız Parçalarına&r ihtiyacımız olacak. &6Yıldız Parçaları&r elde etmek için &6Yıldızlı Arılara&r ihtiyacımız olacak. \\n\\nVe tabii ki &6Yıldızlı Arıları&r elde etmek için &dPatrick &aArılarına&r ihtiyacımız olacak! Sıcak Okyanuslarda balık tutarak nadiren &dPatrick &aArıları&r elde edebilirsin! \\nEğer onları dönüştürmek istemiyorsan, onlarla &dPatrick &aYıldız&r'ı çiftliği kurabilirsin."]
	quest.6C16670D16113DE9.title: "&dPatrick &aYıldızı&r... Arı?"
	quest.71B72958B9F80355.quest_desc: ["Endişelenme, bu aşamada artık yere eşya bırakmak yok! \\n\\nŞimdi yalnızca üretim yapmamız gerekiyor: Lens of &3Certain Death&r'i bir &bDiamond Sword&r ve &5Enchanted Book of Sharpness V&r ile birleştirerek Lens of the &4Killer&r üret. \\n\\n&5Enchanted Books&r'u &5&lRunic Enchanter&r'dan elde edebilirsin; ayrıntılarını başka bir görevde öğrenebilirsin!"]
	quest.71B72958B9F80355.title: "Lens of the &4Killer"
	quest.73201E591C2A40CC.quest_desc: ["Artık &6Yıldız Parçalarını&r elde ettiğine göre, &6&lYıldızlarımızı&r yeniden yapmak için farklı parçaları yapmaya başlayabilirsin! \\n\\n1 &6&lYıldızı&r yeniden yapmak için toplam 262 &6Yıldız Parçasına&r ihtiyacın olacak... umarım iyi bir Arı kurulumu yapmışsındır!"]
	quest.73201E591C2A40CC.title: "&6Yıldız Parçaları&r"
	quest.745E616E97838D2E.quest_desc: ["&lDur!&r Hayvanların kitlesel soykırımını durdur. PETA bir uzlaşmaya varmış gibi görünüyor. Hey, sen masum hayvanları öldürmeyi bırak. Onlar da sana &5Yaratıcı &4Blood Drop&r versin! \\n\\nBununla &4Blood&r'a ihtiyaç duyan herhangi bir kabı sonsuza kadar doldurabilirsin! \\n\\nBunu üretmek için 4 &bPromise of Tenacity&r, bir &6&lATM Yıldızı&r ve &4Blood&r ile dolu olması gereken 4 farklı Eşyaya ihtiyacın olacak."]
	quest.745E616E97838D2E.title: "&5&lYaratıcı &4Blood Drop"
	quest.7A066DD274F970C2.quest_subtitle: "2/5"
	quest.7A066DD274F970C2.title: "&6&lATM Yıldızı&r'nın Sağ parçası"
	quest.7C9154EF6068BE27.quest_desc: ["Teknik olarak Ezici'yi &6&lATM Yıldızı&r'nı 5 &6Yıldız Parçası&r'na dönüştürmek içinde kullanabilirsin... \\n\\nAma yeni &6&lYıldız&r yapmak için 262 tanesine ihtiyacın olacak... \\n\\nÖyleyse neden yapasın ki?"]
	quest.7C9154EF6068BE27.title: "Ama neden?"
}
