{
	chapter.7A72E12C3839D165.title: "Nature's Aura"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.05E668CE6687AC64.quest_desc: ["&bToken of Joy&r, üretmeniz gereken ilk Token'dır. Token'lar, &aNature's Aura&r'daki pek çok eşya için temel üretim malzemesidir."]
	quest.05E668CE6687AC64.title: "&bToken of Joy"
	quest.0B6D35F5B3A11FD2.quest_desc: ["&9Aura Cache&r, bünyesinde &aAura&r depolamanızı sağlar!"]
	quest.0B6D35F5B3A11FD2.quest_subtitle: "Aura Depolama!"
	quest.0B6D35F5B3A11FD2.title: "&9Aura Cache"
	quest.0EFD0A4AE82153E8.quest_desc: ["Diğer eşyalar için bu Token'ları da üretmeniz gerekecektir."]
	quest.0EFD0A4AE82153E8.title: "Diğer Token'lar"
	quest.0FD26FD88E801C0E.quest_desc: ["&2Altar of Birthing&r ile pek çok vanilla yaratığını oluşturabilirsiniz. &dSpirits of Birthing&r, yüksek miktarda aura bulunan alanlarda hayvanları çiftleştirerek elde edilir."]
	quest.0FD26FD88E801C0E.quest_subtitle: "Büyülü Çoğaltma"
	quest.0FD26FD88E801C0E.title: "&2Altar of Birthing"
	quest.12D3C7FC4B3DAB23.quest_desc: ["&bEnvironmental Eye&r, &aRitual of the Forest&r ritüeliyle üretilir. Ekranın sol üst köşesinden ortamdaki aura seviyesini takip edebilmek için Tılsım yuvanıza kuşanabilirsiniz."]
	quest.12D3C7FC4B3DAB23.quest_subtitle: "Gözünüz Çevrede Olsun"
	quest.1ABEC7DE47BD6286.quest_desc: ["&5Ender Crates&r, tıpkı Ender Sandıkları gibi eşya taşımada kullanılır.\\n\\n&5Ender Oculars&r ise &5Ender Crates&r sandıklarına uzaktan erişmenizi sağlayan el versiyonlarıdır."]
	quest.1ABEC7DE47BD6286.quest_subtitle: "Hem Burada Hem Orada!"
	quest.1ABEC7DE47BD6286.title: "&5Ender Crates ve Oculars"
	quest.1D39634260A47C9A.quest_desc: ["&2Offering Table&r üzerinde &2Infused Iron Ingot&r veya &6Tainted Gold Ingot&r sunduğunuzda &bIngots of the Skies&r elde edersiniz."]
	quest.1D39634260A47C9A.title: "&bIngots of the Skies"
	quest.20F9EF925DB1CE05.quest_desc: ["&2Natural Altar&r; 1 adet &2Natural Altar&r, 20 Ahşap Kalas, 16 Taş Tuğla, 8 &eGolden Stone Bricks&r ve 4 Yontulmuş Taş Tuğla içeren çoklu bloklu bir yapıdır.\\n\\nNatural Altar gerçekleşen her tarif için aura tüketir ve modda ilerlemek için şarttır.\\n\\nGörevin sağındaki görsel, yapının nasıl kurulacağını göstermektedir."]
	quest.20F9EF925DB1CE05.title: "&2Natural Altar"
	quest.22ADCF96AE3E609B.quest_desc: ["&dAncient Sapling&r fidanları, &aRitual of the Forest&r ritüeli ile oluşturulur. Ağaçlar büyüdüğünde ortamdaki aura seviyesini dengede tutmaya çalışır.\\n\\nAura seviyesi düşerse yapraklar çürüyerek aurayı tekrar yükseltmeye başlar."]
	quest.22ADCF96AE3E609B.quest_subtitle: "Bildiğiniz Kadim Fidanlardan Değil"
	quest.22ADCF96AE3E609B.title: "Ancient Trees"
	quest.24599D45F5D1606E.quest_desc: ["&bAura Trove&r, &9Aura Cache&r deposunun gelişmiş versiyonudur ve çok daha fazla aura tutabilir."]
	quest.24599D45F5D1606E.quest_subtitle: "Aura Hazinesi!"
	quest.24599D45F5D1606E.title: "&bAura Trove"
	quest.2B4D4E741D855B5A.quest_desc: ["Üretim masasında 2 adet &bIngots of the Skies&r, 2 adet &6Tainted Gold Ingot&r ve 1 adet &5Netherite Scrap&r birleştirerek &dIngots of the Depths&r elde edebilirsiniz."]
	quest.2B4D4E741D855B5A.title: "&dIngots of the Depths"
	quest.34ABEF75AE1E5A0F.quest_desc: ["&bStaff of Ancient Knowledge&r, etraftaki &5Ancient Debris&r cevherlerinin yerini belirlemek için aura tüketir."]
	quest.34ABEF75AE1E5A0F.quest_subtitle: "Netherit Avcısı"
	quest.3C2F5AB815A6C949.quest_desc: ["&2Infused Iron Ingot&r üretmek için &2Natural Altar&r üzerine bir Demir Külçe koyun.\\n\\nBu işlem &6Tainted Gold&r üretimine kıyasla çok daha hızlı gerçekleşir."]
	quest.3EC90ADA4E322B14.quest_desc: ["&6Tainted Gold Ingot&r üretmek için &2Natural Altar&r üzerine bir Altın Külçe koyun.\\n\\nBu işlem &2Infused Iron&r üretimine kıyasla biraz daha uzun sürer."]
	quest.3EC90ADA4E322B14.quest_subtitle: "Altını Dönüştür!"
	quest.3EC90ADA4E322B14.title: "&6Tainted Gold"
	quest.3F8A5CBEAE024748.quest_desc: ["&bEye of the Pillager&r, &bEye of the Blaze&r ve &bEye of the Shulker&r gibi gözler, haritadaki belirli yapıların yerini tespit etmeye yarar."]
	quest.3F8A5CBEAE024748.quest_subtitle: "Gözüm Üzerinizde"
	quest.3F8A5CBEAE024748.title: "Yapı Bulucu Gözler"
	quest.497AE687B7E95DE8.quest_desc: [
		"&aRitual of the Forest&r; ritüele bağlı olarak 8 adet &eWooden Stand&r, 16 adet &eGold Powder&r ve bir Meşe ya da Orman Ağacı fidanından oluşan çoklu bloklu bir yapıyla gerçekleştirilir.\\n\\nRitüeli başlatmak için gerekli eşyaları &eWooden Stand&r'lara yerleştirin ve merkezdeki fidanı büyütün. &eGold Powder&r ritüel sırasında tüketildiği için bol miktarda stoklamanız gerekecek."
		"{image:atm:textures/questpics/natures_aura/forest_ritual.png width:295 height:150 align:center}"
	]
	quest.497AE687B7E95DE8.title: "&aRitual of the Forest"
	quest.4AD4FDF70B9BFCC9.quest_desc: ["&2Offering Table&r üzerinde Token'larınızı işleyerek onları yükseltebilirsiniz. Gelişmiş Token'lar daha ileri seviye tariflerde gereklidir."]
	quest.4AD4FDF70B9BFCC9.title: "Gelişmiş Token'lar"
	quest.4F03B152479C4AC0.quest_desc: ["&bStaff of Riches&r, 64 blok yarıçaptaki tüm depolama kutularını yaklaşık 1 dakika boyunca görünür kılmak için aura tüketir.\\n\\nGanimet sandıkları ararken veya madende unuttuğunuz sandıkları bulurken son derece kullanışlıdır."]
	quest.4F03B152479C4AC0.title: "&bStaff of Riches"
	quest.4F9D6109EEA5D26A.quest_desc: ["&eGolden Leaves&r bloklarını kırdığınızda, &eGold Powder&r yapımında kullanılan &eGold Leaf&r elde etme şansınız yüksektir."]
	quest.4F9D6109EEA5D26A.quest_subtitle: "Ateş Böcekleriyle Aura"
	quest.4F9D6109EEA5D26A.title: "&eGold Leaves"
	quest.54F7AD64A403C9BF.quest_desc: ["Bu katalizörler, &2Natural Altar&r yapınıza sütun başlığı olarak eklenebilir. Farklı dönüştürme ve ayrıştırma tariflerinin kilidini açarlar.\\n\\nÖrneğin &bCrumbling Catalyst&r, her bir &eGold Leaf&r'i 2 yerine 4 adet &eGold Powder&r'a dönüştürmenizi sağlar!"]
	quest.54F7AD64A403C9BF.title: "Katalizörler"
	quest.5A011CE8EEA3F9D8.quest_desc: ["Aura, elinizdeki &eBottle and Cork&r ile havaya sağ tıklanarak depolanabilir. Aura, toplandığı boyuta göre farklı türlere dönüşür:\\n\\nOverworld'de &aSunlight&r, Nether'da &4Ghosts&r, End'de ise &0Darkness&r şeklinde şişelenir.\\n\\nEğer aura seviyesi aşırı düşük bir alanda şişeleme yaparsanız &0Bottled Vacuum&r elde edersiniz."]
	quest.5A011CE8EEA3F9D8.quest_subtitle: "Aura Şişeleme"
	quest.5A011CE8EEA3F9D8.title: "Aura Şişeleri"
	quest.5A0EB2ADEBC7EE2B.quest_desc: ["Bu görev AllTheMods mod paketleri için &6AllTheMods Ekibi&r veya bir &2topluluk üyesi&r tarafından hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına tabi olduğundan, bu görevin &6AllTheMods Ekibi&r'nin yazılı izni olmaksızın resmi olmayan herhangi bir pakette kullanılması yasaktır.\\n\\nBu görev normal oyunda gizlidir; yalnızca düzenleme modunda görünür."]
	quest.5C990F7E5D345A6F.quest_desc: [
		"&2Offering to the Gods&r; 1 adet &2Offering Table&r ve 36 adet çiçekten oluşan çoklu bloklu bir yapıdır. Tanrılara adakta bulunabilmek için &dSpirits of Calling&r ruhlarına ihtiyacınız olacak.\\n"
		"{image:atm:textures/questpics/natures_aura/offering.png width:295 height:150 align:center}"
	]
	quest.5C990F7E5D345A6F.quest_subtitle: "Çiçek Ormanında Tanrılara Bir Kuş Banyosu Sunmak"
	quest.71B6F013C8A60EB6.quest_desc: ["&2Canopy Diminisher&r ve &2Herbivorous Absorber&r, aura üretmeye başlamak için pratik ve etkili yöntemlerdir."]
	quest.71B6F013C8A60EB6.quest_subtitle: "Daha Fazla Aura!"
	quest.71B6F013C8A60EB6.title: "Aura Üretimi"
	quest.7DAED14CEC4CDA51.quest_desc: ["&aNature's Aura&r, &aAura&r enerjisini kullanma ve yenileme üzerine kurulu bir büyü modudur. Bu görevler temel mekanikleri anlatmaktadır.\n\nBaşlamak için &eGold Nuggets&r, &aLeaves&r ve &aGrass&r ile &eBrilliant Fiber&r üretin. Elinizdeki &eBrilliant Fiber&r ile herhangi bir yaprağa sağ tıkladığınızda onları &eGolden Leaves&r'e dönüştürür.\n\n&aBook of Natural Aura&r rehber kitabını okuduğunuzdan emin olun; bu kitabı &aNature's Aura&r modundaki çoklu blokların nasıl yapılacağını görmek için de kullanabilirsiniz."]
	quest.7DAED14CEC4CDA51.title: "&aNature's Aura&r'ya &eHoş Geldiniz"
	task.0CA0B32D52395A39.title: "Ahşap Kalaslar"
	task.15698B55CCAD2433.title: "TümHaklarıSaklıdır"
	task.2E97226C40818239.title: "Çiçekler"
	task.4C6370D2B7EF8685.title: "TümHaklarıSaklıdır"
	task.52874F5B79ECAE65.title: "Taş Tuğlalar"
	task.55628B1EECBB5E94.title: "Ritüel Fidanları"
