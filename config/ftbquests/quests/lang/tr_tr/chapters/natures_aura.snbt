{
	chapter.7A72E12C3839D165.title: "Nature's Aura"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.05E668CE6687AC64.quest_desc: ["&bToken of Joy&r, üretmeniz gereken ilk Token'dır, token'lar &aNature's Aura&r'daki eşyalar için önemli üretim malzemeleridir."]
	quest.05E668CE6687AC64.title: "&bToken of Joy"
	quest.0B6D35F5B3A11FD2.quest_desc: ["&9Aura Cache&r, &aAura&r depolamak için kullanılabilir!"]
	quest.0B6D35F5B3A11FD2.quest_subtitle: "Depolanıyor!"
	quest.0B6D35F5B3A11FD2.title: "&9Aura Cache"
	quest.0EFD0A4AE82153E8.quest_desc: ["Diğer eşyalar için de bu Token'ları üretmeniz gerekecek."]
	quest.0EFD0A4AE82153E8.title: "Diğer Token'lar"
	quest.0FD26FD88E801C0E.quest_desc: ["&2Altar of Birthing&r ile çok sayıda vanilla yaratığı (mob) oluşturabilirsiniz. &dSpirits of Birthing&r, büyük miktarda aura bulunan alanlarda hayvanları çiftleştirerek yapılır. "]
	quest.0FD26FD88E801C0E.quest_subtitle: "Büyüyle Bebek Yapmak"
	quest.0FD26FD88E801C0E.title: "&2Altar of Birthing"
	quest.12D3C7FC4B3DAB23.quest_desc: ["&bEnvironmental Eye&r, &aRitual of the Forest&r kullanılarak yapılabilir ve ekranın sol üst köşesindeki aura seviyelerini izlemek için Charm yuvanıza takılabilir."]
	quest.12D3C7FC4B3DAB23.quest_subtitle: "Çevrede Gözün Olsun"
	quest.1ABEC7DE47BD6286.quest_desc: ["&5Ender Crates&r, eşyaları taşımak için kullanılabilen &5Ender Chests&r'dir.\\n\\n&5Ender Oculars&r, &5Ender Crates&r'in elde tutulan versiyonlarıdır."]
	quest.1ABEC7DE47BD6286.quest_subtitle: "Burada ve Orada!"
	quest.1ABEC7DE47BD6286.title: "&5Ender Crates and Oculars"
	quest.1D39634260A47C9A.quest_desc: ["Eğer Offering Table üzerinde &2Infused Iron Ingots&r veya &6Tainted Gold Ingots&r kullanırsanız, &bIngots of the Skies&r elde edersiniz."]
	quest.1D39634260A47C9A.title: "&bIngots of the Skies"
	quest.20F9EF925DB1CE05.quest_desc: ["&2Natural Altar&r; 1 &2Natural Altar&r, 20 Planks, 16 Stone Bricks, 8 &eGolden Stone Bricks&r ve 4 Chiseled Stone Bricks'ten yapılan çok bloklu bir yapıdır.\\n\\nNatural Altar, her tarif için aura tüketir ve modda ilerlemeye devam etmek için gereklidir.\\n\\nBu görevin sağındaki görsel, çok bloklu kurulumu göstermektedir."]
	quest.20F9EF925DB1CE05.title: "&2Natural Alter"
	quest.22ADCF96AE3E609B.quest_desc: ["&dAncient Saplings&r, &aRitual of the Forest&r kullanılarak oluşturulur. Büyüdüklerinde, ağaçlar normal aura seviyelerini (ne çok yüksek ne de çok düşük) korumaya çalışırlar.\\n\\nAura düşerse, yapraklar çürümeye başlar ve süreci tersine çevirir."]
	quest.22ADCF96AE3E609B.quest_subtitle: "O Ancient Sapling'ler Değil"
	quest.22ADCF96AE3E609B.title: "Kadim Ağaçlar"
	quest.24599D45F5D1606E.quest_desc: ["&bAura Trove&r, &9Aura Cache&r'in yükseltilmiş bir versiyonudur."]
	quest.24599D45F5D1606E.quest_subtitle: "Bir Hazine Zulası!"
	quest.24599D45F5D1606E.title: "&bAura Trove"
	quest.2B4D4E741D855B5A.quest_desc: ["Bir üretim masasında 2 &bIngots of the Skies&r, 2 &6Tainted Gold Ingots&r ve 1 &5Netherite Scrap&r birleştirmek &dIngots of the Depths&r yapacaktır."]
	quest.2B4D4E741D855B5A.title: "&dIngots of the Depths"
	quest.34ABEF75AE1E5A0F.quest_desc: ["Staff of Ancient Knowledge, yakındaki &5Ancient Debris&r'i vurgulamak için Aura kullanır."]
	quest.34ABEF75AE1E5A0F.quest_subtitle: "Netherite Bulucu"
	quest.3C2F5AB815A6C949.quest_desc: ["Bir &2Infused Iron Ingot&r yapmak için &2Natural Altar&r üzerine bir Iron Ingot yerleştirin.\\n\\nBu işlem &6Tainted Gold&r ile olduğundan daha hızlı olacaktır."]
	quest.3EC90ADA4E322B14.quest_desc: ["Bir &6Tainted Gold Ingot&r yapmak için &2Natural Altar&r üzerine bir &eGold Ingot&r yerleştirin.\\n\\nBu işlem &2Infused Iron&r ile olduğundan daha uzun sürecektir."]
	quest.3EC90ADA4E322B14.quest_subtitle: "Şu Altını Kirlet!"
	quest.3EC90ADA4E322B14.title: "&6Tainted Gold"
	quest.3F8A5CBEAE024748.quest_desc: ["Eye of the Pillager, Eye of the Blaze ve Eye of the Shulker'ın her biri belirli yapıları bulmak için kullanılır."]
	quest.3F8A5CBEAE024748.quest_subtitle: "Gözüm Üzerinde"
	quest.3F8A5CBEAE024748.title: "Yapı Bulucular"
	quest.497AE687B7E95DE8.quest_desc: [
		"&aRitual of the Forest&r, tarife bağlı olarak 8 Wooden Stands, 16 &eGold Powder&r ve bir Oak veya Jungle Sapling kullanılarak çok bloklu bir yapı oluşturularak yapılabilir.\\n\\nBir ritüeli başlatmak için tarif için gereken eşyaları Wooden Stands üzerine yerleştirin ve gereken Fidanı (Sapling) ortada Büyütün. &eGold Powder&r tarifte tüketilir, bu yüzden çokça ihtiyacınız olacak."
		"{image:atm:textures/questpics/natures_aura/forest_ritual.png width:295 height:150 align:center}"
	]
	quest.497AE687B7E95DE8.title: "&aRitual of the Forest"
	quest.4AD4FDF70B9BFCC9.quest_desc: ["Token'larınızı Offering Table üzerinde kullanmak onları yükseltecektir. Bu yükseltilmiş Token'lara daha gelişmiş üretim tarifleri için ihtiyaç duyulacaktır."]
	quest.4AD4FDF70B9BFCC9.title: "Yükseltilmiş Token'lar"
	quest.4F03B152479C4AC0.quest_desc: ["&bStaff of Riches&r, yaklaşık 1 dakika boyunca 64 blokluk bir yarıçap içindeki tüm depolama kaplarını vurgulamak için aura kullanır.\\n\\nBu, ganimet sandıkları arıyorsanız veya bir yere, örneğin bir madene sandık koyduysanız çok faydalı olabilir."]
	quest.4F03B152479C4AC0.title: "&bStaff of Riches"
	quest.4F9D6109EEA5D26A.quest_desc: ["&eGolden Leaves&r'i kırmak, &eGold Powder&r için gereken bir &eGold Leaf&r düşürme ihtimali yüksektir. "]
	quest.4F9D6109EEA5D26A.quest_subtitle: "Ateş Böcekleriyle Aura"
	quest.4F9D6109EEA5D26A.title: "&eGold Leaves"
	quest.54F7AD64A403C9BF.quest_desc: ["Bu Catalyst'ler &2Natural Altar&r'ınıza sütun başlığı olarak eklenebilir. Daha fazla eşyayı başka eşyalara dönüştürmenize veya onları parçalamanıza olanak tanırlar.\\n\\nCrumbling Catalyst, her bir Gold Leaf'i 2 yerine 4 Gold Powder'a dönüştürmenizi sağlar! "]
	quest.54F7AD64A403C9BF.title: "Katalizörler (Catalysts)"
	quest.5A011CE8EEA3F9D8.quest_desc: ["Aura, havaya Bottle and Cork ile sağ tıklanarak şişelenebilir. Aura, toplandığı yere bağlı olarak farklı biçimler alır.\\n\\nOverworld'de &aSunlight&r olarak, Nether'da &4Ghosts&r olarak ve End'de &0Darkness&r olarak şişelenir.\\n\\nBottle and Cork kullandığınız alanda ciddi bir aura eksikliği varsa, &0Bottled Vacuum&r elde edersiniz."]
	quest.5A011CE8EEA3F9D8.quest_subtitle: "Aurayı Şişelemek"
	quest.5A011CE8EEA3F9D8.title: "Aura Şişeleri"
	quest.5A0EB2ADEBC7EE2B.quest_desc: ["Bu Görev, &6AllTheMods Staff&r veya AllTheMods Modpaketlerinde kullanılmak üzere bir &2Community contributor&r tarafından yazılmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eAll Rights Reserved&r (Tüm Hakları Saklıdır) altında lisanslandığından, bu Görevin &6AllTheMods Team&r tarafından yayınlanmayan hiçbir halka açık pakette açık izin alınmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.5C990F7E5D345A6F.quest_desc: [
		"Offering to the Gods, 1 Offering Table ve 36 Çiçekten (Flowers) yapılan çok bloklu bir yapıdır. Bir sunu yapmak için Spirits of Calling'e ihtiyacınız vardır.\\n"
		"{image:atm:textures/questpics/natures_aura/offering.png width:295 height:150 align:center}"
	]
	quest.5C990F7E5D345A6F.quest_subtitle: "Çiçek Ormanında Tanrılara Bir Kuş Banyosu Sunmak"
	quest.71B6F013C8A60EB6.quest_desc: ["&2Canopy Diminisher&r ve &2Herbivorous Absorber&r aura üretmenin basit ve kolay yollarıdır."]
	quest.71B6F013C8A60EB6.quest_subtitle: "Daha Fazla Aura!"
	quest.71B6F013C8A60EB6.title: "Aura Üretimi"
	quest.7DAED14CEC4CDA51.quest_desc: ["&aNature's Aura&r, &aAura&r kullanmak ve onu yenilemek hakkında bir büyü modudur. Bu görevler sadece bazı temel bilgilerin üzerinden geçecektir.\\n\\nBaşlamak için, &eGold Nuggets&r, &aLeaves&r ve &aGrass&r ile yapılan biraz &eBrilliant Fiber&r yapın. Herhangi bir yaprağa &eBrilliant Fiber&r ile sağ tıklamak onları &eGolden Leaves&r'e dönüştürecektir.\\n\\n&aBook of Natural Aura&r'yı okuduğunuzdan emin olun, onu &aNature's Aura&r'daki çok bloklu yapıların nasıl yapılacağını görmek için de kullanabilirsiniz."]
	quest.7DAED14CEC4CDA51.title: "&aNature's Aura&r'ya &eHoş Geldiniz"
