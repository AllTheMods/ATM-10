{
	chapter.0D990A1D1E088701.title: "Steam Age: Yeni Başlangıçlar"
	chapter_group.6700DB960E16A321.title: "Modern Industrialization"
	quest.088CA7B6D4899846.quest_desc: ["&#65C2A6Packer&r, &#53E67BDouble Ingots&r, &#53E67BBlades&r ve &#53E67BCables&r oluşturmak için kullanılır. Bununla birlikte makinenin başka birçok kullanım alanı vardır, ancak bunlar sizin için ana olanlar olacaktır."]
	quest.0DAF5D42694EA8C9.quest_desc: [
		"&#6E6D6D&nForge Hammer&r yolculuğunuzun başlangıcıdır. Cevherlerinizden &#B53A3Adaha iyi bir verim&r elde etmekten, gelecekteki üretimler için &#DBD25Acomponents&r yapmaya kadar birçok kullanım alanı vardır."
		""
		"Ürettiğiniz &7Hammer&r bir tarif için gerekli değildir ancak ürettiğiniz &#DBD25Acomponents&r üzerinde size daha iyi bir çıktı verecektir."
	]
	quest.0DAF5D42694EA8C9.title: "&#949494Forge Hammer"
	quest.1036837C9AD3F301.quest_desc: ["&#6E6D6DForge Hammer&r, &#FFAC3BCopper&r Ingot'ları veya cevher formlarını kolayca Dust'larına ezmenizi sağlayacaktır."]
	quest.12F9705ACB8FB300.quest_desc: [
		"&#EDD653&nCutting Machine&r birçok üretim yapmanızı sağlar. Önemli olanları Bolt'lardır. "
		""
		"&#EDD653&nCutting Machine&r, &#EDD653&nMixer&r kullanılarak elde edilen &#E3993DLubricant&r ile çalışır."
	]
	quest.12FB3990CA1653A4.quest_desc: [
		"&#DBA15ASteam Drill&r, oyunun başlarındaki madencilik için en iyi arkadaşınız olacak. &53'e 3&r'lük bir kazı alanı yapabilir, ayrıca &#EEF768açılıp kapanabilen ipeksi dokunuş&r'a (silk touch) sahiptir."
		""
		"Varsayılan olarak &7'Y'&r tuşuna atanmış olan \"Toggle 3x3 Mining\" kısayoluna basarak &53'e 3&r madenciliği açıp kapatabilirsiniz."
		""
		"&#EEF768Silk Touch&r, Steam Drill ile &7Eğilerek Sağ Tıklayarak&r açılıp kapatılabilir."
		""
		"&#DBA15ASteam Drill&r'i doldurmak için, envanterinizde matkabı bir &6yakıtın&r (fuel) üzerinde tutup &7Sağ Tıklayabilirsiniz&r. &9Water&r için dünyada &7Sağ Tıklanabilir&r veya yanınızda bir su kovası taşıyabilirsiniz."
	]
	quest.1C9D3FC67D58AC02.quest_desc: ["&#EDD653&nMixer&r, eşyaları ve sıvıları birleştirmemizi sağlayacaktır. Eşyaları boyamak veya hatta çoğaltmak için kullanılabilirler."]
	quest.1E4E462928F2A71C.quest_desc: [
		"&7&nCoke Oven&r, &#787777Coal&r'u &#696464Coke&r'a dönüştürmek için kullanılacaktır. &#696464Coke&r, yakıt olarak &#787777Coal&r'dan 4 kat daha etkilidir."
		""
		"Multiblock, boş veya ana elinizde bir &#D1D15Ewrench&r tutularak önizlenebilir. Elinizde &#B4D95Dhatches&r tutmak size onlar için olası pozisyonları söyleyecektir."
		""
		"&7&nCoke Oven&r, çoğunlukla tuğlalardan yapılmış içi boş bir multiblock'tur."
	]
	quest.21A4FE1741E4E78C.quest_desc: [
		"&#65C2A6Quarry&r kaynak üretmek için kullanılan bir multiblock'tur. Çalışması için &aDrills&r ve &7Steam&r gerektirir."
		""
		"Her bir çalışma döngüsü &aDrill&r'i tüketme şansına sahiptir. Daha iyi &aDrills&r daha iyi kaynaklar verir."
		""
		"Steam Quarry sadece &#DEA14BCopper&r ve &#DE9531Bronze Drills&r kullanabilir. Ayrıca Stone'lar üretmek için &#8A5C1EDirt&r kullanabilir."
	]
	quest.21A4FE1741E4E78C.quest_subtitle: "Sonsuz Kaynaklar"
	quest.23708582B1064C9D.quest_desc: ["Bir &#46DBBBCircuit&r çalışmak için bu temel bileşenlerden bazılarını gerektirecektir, bunların parçalarını otomatikleştirmek gelecekte yararlı olacaktır."]
	quest.23708582B1064C9D.title: "Kapasitans ve Direnç"
	quest.24285F25F9563B02.quest_desc: ["&#467FDB&nAnalog Circuit&r, ah! sonunda başardın. Genelde diğer insanlar senin harcadığın zamanın yarısını harcardı ama bunu sana karşı kullanmayacağım..."]
	quest.24285F25F9563B02.quest_subtitle: "Elektroniğin Temelleri"
	quest.253822C64BBBB1EB.quest_desc: ["&#6E6D6DForge Hammer&r, &#9AD5EDTin&r Ingot'ları veya cevher formlarını kolayca Dust'larına ezmenizi sağlayacaktır."]
	quest.357DDE894EB512F7.quest_desc: ["&#65C2A6Wiremill&r, bizim için &#53E67BWires&r yapmak üzere tam olarak doğru miktarda kuvvet uygulayabilir. Şok edici!! Biliyorum..."]
	quest.3AA4D1B60E4E71A5.quest_desc: ["Tüm &cmultiblock'lar&r, içlerine yerleştirilen &ehatches&r ile tanımlanır. &cmultiblock'lardaki&r bu &ehatches&r yükseltmek, makineyi bir bütün olarak yükseltecektir."]
	quest.41877F44CD3D1EDB.quest_desc: ["&#E3BC19Bronze Furnace&r tıpkı normal bir fırın gibi çalışır, tek büyük farkı steam ile çalışması ve iki kat daha hızlı olmasıdır."]
	quest.458BFDB636F8B495.quest_desc: ["Coke dust'ı Iron ile birleştirmek size Uncooked Steel Dust verecektir. Bunu Steam Blast Furnace'ta pişirmek, gelecekteki ilerleme için gerekli olan Steel Ingot'ları kazandıracaktır."]
	quest.478C1AF86610A8B7.quest_desc: ["&#EDD653&nCompressor&r, &#53EDAAPlates&r, &#53EDAACurved Plates&r ve &#53EDAARings&r yapmak için kullanılır."]
	quest.48F77A0BE1F33B29.quest_desc: ["Yeni inşa edilen &#65C2A6Wiremill&r'i kullanarak, artık bizi elektrik çağına götürecek &#53E67BWires&r ve &#53E67BFine Wires&r yapabiliriz."]
	quest.48F77A0BE1F33B29.title: "Dire Wire"
	quest.4E69C6ABFE467C25.quest_desc: ["&#65C2A6Alloy Smelter&r, &#3187C4Extended Industrialization&r modundan gelir. &#4C4BDEMixer&r ve &#954BDEFurnace&r'ın görevlerini tek bir cihazda birleştirerek işi daha az sıkıcı hale getirir."]
	quest.55C6BBC996B51838.quest_desc: [
		"&#ED9553Bronze Boiler&r, &9water&r'ı steam'e dönüştürür. Steam, makinelerinizin &7&nSteam Age&r'de çalışması için yakıt görevi görecektir."
		""
		"Makineyi kullanmak için, sadece &9water&r ve herhangi bir &#ED5353furnace fuel&r sağlayın. Bu makinenin sıcaklığını artıracaktır, maksimum sıcaklıkta 4 makineyi aynı anda idare edebilecektir."
	]
	quest.55C6BBC996B51838.quest_subtitle: "Kaynayan su"
	quest.589DFDB8FB7211AA.quest_desc: ["&#C1DB46&nThe Electric Age&r'e geçişiniz için &7Rubber&r üretimi önemsizdir. Bunu en erken aşamada otomatikleştirmek, sizi inandığınızdan daha ileriye taşıyacaktır."]
	quest.589DFDB8FB7211AA.title: "Kauçuk ve Devre Kartı"
	quest.5CCF92238B23EDC9.quest_desc: [
		"&#A0DE45&nModern Industrialization&r, doğası gereği &#D93D3DIC2&r ve &#D93D3DGregTech&r'e benzeyen bir moddur ancak bu 2 moddan farklı şekilde ilerlemelisiniz."
		""
		"Bu görevler aracılığıyla, &#E8C843AllTheMods Star&r ve daha sonra &#43E898Infinity Armor&r için gerekli parçaları yapmanızda size rehberlik edeceğim."
	]
	quest.5CCF92238B23EDC9.quest_subtitle: "Okumak yardımcı olacaktır"
	quest.5CCF92238B23EDC9.title: "&#A0DE45Modern Industrialization'a Hoş Geldiniz"
	quest.5E191081662C2F1A.quest_desc: ["&#6E6D6DForge Hammer&r, &#A0DE45Modern Industrialization&r köylüsü için iş istasyonu bloğu görevi görür. Bu köylü size çok çeşitli yararlı takaslar sunacaktır."]
	quest.68EAB0248989FC97.quest_desc: [
		"&#EDD653&nSteam Blast Furnace&r ilerlemenin yeni ufuklarını açar. Bu, gelecekteki çabalarınızda kilit bir multiblock olacaktır."
		""
		"Bu multiblock sadece &7Steel Ingots&r yapmanızı sağlamakla kalmaz, aynı zamanda daha sonra &#36472ARubber&r ve daha birçok şey için kullanılacak olan &#696E60Raw Synthetic Oil&r'i &#494D43Synthetic Oil&r'e dönüştürmenize de olanak tanır."
	]
	quest.7282DCB1547CEB63.quest_desc: ["&#ED9553Bronze&r, &7&nSteam Age&r'in yapı taşı olarak görev yapacaktır. Bu tozu pişirmek, daha sonra kullanacağımız &#ED9553Bronze Ingots&r'ları elde etmenizi sağlayacaktır."]
	quest.7282DCB1547CEB63.title: "&#EDD653Bronze"
	quest.7A873E48E38B5C0E.quest_desc: ["Steel makineler, Bronze olanlara göre iki kat daha fazla steam kullanır ancak aynı zamanda hızı iki kat artırarak bunu telafi ederler."]
	quest.7D220876E8FF7AED.quest_desc: [
		"&#65C2A6Unpacker&r'ın, &#53E67BBlock into Ingots&r işlemi yapmaktan ve makinelerin &#53E67Bparçalarını geri dönüştürmeye&r kadar birçok kullanım alanı vardır."
		""
		"&oHatta ondan daha kolay Silicon Ingots bile elde edebilirsiniz.&r"
	]
	task.198A217D6A4C951C.title: "Köylü Takasları"
	task.31BE41B971794377.title: "Çelik Çağı"
	task.45C5CAC94406DF41.title: "Multiblock Seviyeleri"
