{
	chapter.56B11606F5F4DAB2.title: "Dijital Çağ"
	chapter_group.6700DB960E16A321.title: "Modern Industrialization"
	quest.00C95A190BE2CBF9.quest_desc: ["&#994ABAStiren&r elde etmek için &#C2C969Demir Tozu&r, &#69C9B6Etilbenzen&r ve buhar tepkimeye sokulmalıdır. &#69C9B6Etilbenzen&r ise &#CDCF95Buharla Parçalanmış Nafta&r'nın damıtılmasıyla elde edilir."]
	quest.00C95A190BE2CBF9.title: "Gelişmiş Damıtma"
	quest.011B8BD02D80DDD4.quest_desc: ["Dünyada kolayca &#6E2D6ETungsten Cevheri&r bulabilirsiniz. Cevheri kırdığınızda &#A140A1Ham Tungsten&r elde edersiniz."]
	quest.024BD22824C7F53A.quest_desc: ["&#F0C87DBuharla Parçalanmış Nafta&r damıtılarak &#8FD5E3Toluen&r elde edilebilir."]
	quest.09BE81548CD81068.quest_desc: ["Sonunda &#FFEB6EAllthemods Star&r için gereken bileşenlere ulaştınız!"]
	quest.0B60DA8F65E5DF06.quest_desc: ["&#C452C4Tungsten Tozu&r elde etmek için &#A140A1Ham Tungsten&r'ı çeşitli yöntemlerle öğütebilirsiniz."]
	quest.0C229BE9B57269EF.quest_desc: ["&#EBA844Kanthal Tozu&r, &#816DF7Elektrikli Maden Eritme Ocağı&r içerisinde eritilmelidir."]
	quest.0CD36928116E868E.quest_desc: ["&#F36EF5PolyVinil Klorür&r elde etmek için &#F783F3Vinil Klorür&r; &#9683F7Kurşun Küçük Toz&r veya &#FEA8FFKrom Küçük Toz&r ile karıştırılabilir."]
	quest.0EA327E405EDFF02.quest_desc: ["&#9C6C35Asetilen&r ile &#DEAB6DHidroklorik Asit&r karıştırılarak &#F783F3Vinil Klorür&r elde edilebilir."]
	quest.18C0EF38430C3E67.quest_subtitle: "Dijital Çağ"
	quest.1A83615B7E1D3540.quest_desc: ["&#45BF56Reaktör&r içerisine yakıt ve &9Su&r yerleştirmek &#8F49C4Döteryum&r üretir. Farklı yöntemler bulunsa da &#45BF56Reaktör&r en hızlı yolu sunar."]
	quest.226187AA3F1B6DB1.quest_desc: ["&#D4C35DKum&r, &8Çakmaktaşı&r, &#8DF0EENitrojen&r ve &#69C9C7Toluen&r karıştırılarak &#D66D40Endüstriyel TNT&r elde edilir."]
	quest.22B8D57337944D9C.quest_desc: ["&#DF9DE0Titanyum Sıcak Külçeler&r, &#5CD1CFVakumlu Dondurucu&r içinde soğutularak kullanılabilir &#F069F0Titanyum Külçelerine&r dönüştürülür."]
	quest.22B8D57337944D9C.title: "&#F069F0Titanyum Külçe"
	quest.23DB52ECA259F36D.quest_desc: [
		"&#45BF56Reaktör&r içindeki Ağır Su; &#EB5266Trityum&r ve &#C09EDEAğır Su Buharı&r üretir."
		""
		"&#EB5266Trityum&r gelişmiş bileşenler için kullanılırken &#C09EDEAğır Su Buharı&r ise &#DEAB47Isı Değiştirici&r içinde yeniden &#8C47C9Ağır Su&r'a dönüştürülebilir."
	]
	quest.267A357B28228694.quest_desc: ["&#4DB85ERastgele Erişimli Bellek&r, &#5EC7E6Kimyasal Reaktör&r içerisinde &#A1A1A1Stiren-Bütadien Kauçuk&r, &#D15EE6Argon&r, &7Antimon Tozu&r, &#5ED2E6Alüminyum Tozu&r ve &#5D76C2Silikon Plaka&r kullanılarak üretilir."]
	quest.282A23C3E7561796.quest_desc: [
		"&#94C0E3İşleme Array&r, makinelerin eşzamanlı (paralel) çalışmasını sağlayan devasa bir çoklu blok yapısıdır. Maksimum &#94E3A264&r adet paralel işlemi destekler."
		""
		"Çoklu blok yapısını inşa etmek için, öncelikle kontrol bloğunun arayüzünden simüle etmek istediğiniz paralel makine miktarını belirleyin."
		""
		"{image:atm:textures/questpics/modernindustrialization/proc_array_gui.png width:175 height:100 align:center}"
		""
		"{@pagebreak}"
		"Sistemi çalıştırmak için simüle edeceğiniz makineyi arayüzün sağındaki yuvaya yerleştirin. İstenen paralel işlem sayısı kadar makine eklenmelidir."
		""
		"Ayrıca &#94C0E3İşleme Array&r tüm yükseltmeleri destekler."
	]
	quest.2A95F4F998835B43.quest_subtitle: "9 Parça -> 1 Külçe"
	quest.3003598CE8B1FAAA.quest_subtitle: "Daha İyi Teknoloji"
	quest.3003598CE8B1FAAA.title: "Daha Gelişmiş Bileşenler"
	quest.31CB278B4BA7B25E.quest_desc: ["&#B5E7F7Sıvı Hava&r santrifüj edildiğinde 3 farklı çıktı elde edilir: &#A5CAD9Oksijen&r, &#78ADC2Nitrojen&r ve &#DD91EDArgon&r. Bu &#DD91EDArgon&r ilerleyen adımlarda gerekecektir."]
	quest.31CB278B4BA7B25E.quest_subtitle: "Mantıklı"
	quest.31CB278B4BA7B25E.title: "Havayı Santrifüjleme"
	quest.352A226915809E1B.quest_desc: ["&#A57DE3Paketleyici&r; &#7DD2E3Paslanmaz Çelik&r, &#B37DE3Tungsten&r ve &#E37DDBTitanyum Külçe&r'ı yeni bir &#3946E3Karışık Patlamaya Dayanıklı Külçe&r halinde birleştirmenizi sağlar."]
	quest.35FDC436DE07635F.quest_desc: ["&#DB62DEİçten Patlamalı Kompresör&r, hammaddeleri sıkıştırmak için patlama gücünden yararlanır. Çok daha verimli bir şekilde &#8762DEKarışık Patlamaya Dayanıklı Alaşım Külçesi&r ve çeşitli değerli kaynaklar üretmek için kullanılır."]
	quest.3601DD545E1D11B4.quest_desc: [
		"&#DD91EDArgon&r; &#83729ESilikon Tozu&r ve &#AAA0BAİridyum Küçük Toz&r ile tepkimeye sokularak &#919191Monokristalin Silikon&r elde edilir."
		""
		"&#AAA0BAİridyum&r dünyada bir cevher olarak bulunur."
	]
	quest.36D35C35BBC0A555.quest_subtitle: "En Verimli Yöntem"
	quest.386ABEB4249D157D.quest_desc: ["Tek bir &#919191Monokristalin Silikon&r dilimlenerek 32 adet &#8FA4B5Silikon Plaka&r elde edilebilir."]
	quest.3891F8D4201E6BFD.quest_desc: [
		"&#EBA844Kanthal Külçe&r önce İnce Tel'e, ardından Kablo'ya dönüştürülerek en sonunda &#EBA844Kanthal Bobin&r üretmek için kullanılır."
		""
		"&#EBA844Kanthal Bobin&r'ler, &#816DF7Elektrikli Maden Eritme Ocağı&r'ın çok daha yüksek &#F76D6Dsıcaklıkta&r çalışmasını sağlayarak yeni tariflerin işlenmesine olanak tanır."
		""
		"Bobinleri &#816DF7Elektrikli Maden Eritme Ocağı&r arayüzü üzerinden değiştirebilirsiniz."
		""
		"{image:atm:textures/questpics/modernindustrialization/switch_to_kanthal.png width:150 height:75 align:center}"
	]
	quest.39A0BA6E2A72A681.quest_desc: ["&#99F0F0Paslanmaz Çelik&r, &#ADDBDBAlüminyum&r ve &#E9A8F7Krom Tozu&r karıştırılarak &#EBA844Kanthal Tozu&r elde edilir."]
	quest.3A0C8BCE197A448B.quest_desc: ["&#A1A1A1Stiren-Bütadien Kauçuk&r üretmek için &#827AFFStiren-Bütadien&r; &#9683F7Kurşun Küçük Toz&r veya &#FEA8FFKrom Küçük Toz&r ile karıştırılabilir."]
	quest.3ACC27B786CDCF22.quest_desc: ["&#3ABEC7Elektrikli Kompresör&r, &#CE5ADBTungsten Küçük Tozunu&r &#AF22BFTungsten Parçalarına&r dönüştürmenizi sağlar."]
	quest.3B1CDC2DD05CAE80.quest_desc: ["&#F36EF5PolyVinil Klorür&r; &#6EBAF5Platin Levha&r, &#C4C362Kadmiyum Pil&r, &#F7BB57Tavlanmış Bakır Kablo&r ve &#57BFF7Dijital Devre Kartı&r ile birleştirilerek &#EBE56Eİşlem Birimi Kartı&r üretilir."]
	quest.3CB05026BC4C5577.quest_desc: ["Şimdilik &#3946E3Karışık Patlamaya Dayanıklı Külçe&r kullanarak &#6F93C7Elektrikli Kompresör&r ile verimsiz de olsa &#986FC7Patlamaya Dayanıklı Alaşım Levha&r üretebilirsiniz."]
	quest.3FE2A649F07DF28D.quest_subtitle: "Plütonyum Tozu İçin Aşırı Reaktörler Blutonium'u Öğütülebilir"
	quest.3FE489E6B1FAC24B.quest_subtitle: "Tükenmiş Çubukları Geri Dönüştürmek"
	quest.3FE489E6B1FAC24B.title: "Plütonyum Elde Etmek"
	quest.40F2EDB9384CE782.quest_desc: ["&#DBE37FBuharla Parçalanmış Hafif Yakıt&r damıtıldığında ürün olarak &#9C6C35Asetilen&r elde edilir."]
	quest.4A06CCE1FE0F333C.quest_desc: ["&#74C3DBHava Girişi&r, &#46CAF2Vakumlu Dondurucu&r içerisine yerleştirildiğinde &#B5E7F7Sıvı Hava&r üretir."]
	quest.4A618CA66AD6223D.quest_subtitle: "Daha Fazla Güç Girişi"
	quest.4F870252E9FB1A41.quest_desc: ["Reaktör, yakıt çubukları ile beslenebilir; bunlar üretebileceğiniz en temel yakıt çubuklarıdır."]
	quest.50F97171D25CD2EE.quest_desc: ["&#6EDDFFSon Derece Gelişmiş Yükseltme&r modülleri, eklenen her yükseltme başına &#FFEB6E512 EU/t&r kapasite kazandırır."]
	quest.56A4F5D301BC1E93.quest_desc: ["&#6EDDFFTurbo Yükseltme&r yükseltmeleri, eklenen her modül başına &#FFEB6E64EU/t&r kapasite artışı sağlar."]
	quest.58F7C11C241DD7A4.quest_desc: [
		"&#6AADD9Damıtma Kulesi&r, &#A3D2F0Damıtma Tesisi&r makinesinin gelişmiş versiyonudur. En büyük avantajı, tek bir girdiden aynı anda birden fazla çıktı elde etmeyi sağlamasıdır."
		""
		"Yapıyı inşa etmek için &#6AADD9Damıtma Kulesi&r ana bloğunun arayüzünü açıp kule yüksekliğini belirleyin. Yükseklik, alacağınız çıktı sayısına bağlıdır. Örneğin &#76759EHam Petrol&r işlemek için 3 blok yüksekliğinde bir yapı gerekir."
	]
	quest.58F7C11C241DD7A4.quest_subtitle: "Verimlilik Önemlidir"
	quest.5A4406F89DB802F0.quest_desc: ["&#BB95CFStiren&r ve &#D46C85Bütadien&r tepkimesi sonucunda &#827AFFStiren-Bütadien&r elde edilir."]
	quest.5B45AB96953FA61C.title: "Dijital Çağ"
	quest.633D6361DA680C75.quest_desc: ["&#E6ED98Hafif Yakıt&r; buhar ile karıştırıldığında &#DBE37FBuharla Parçalanmış Hafif Yakıt&r elde edilir."]
	quest.66E78F599CD50579.quest_desc: [
		"&#49C472Nükleer Reaktör&r, üst düzey kaynakları işlemenizi sağlar. Bu yapıyı &#8F49C4Döteryum&r ve &#EB5266Trityum&r üretmek için kullanacağız."
		""
		"Bu kaynak listesi \"Geniş\" boyutunda bir Reaktör kurmanıza yardımcı olacaktır. Hız ve verimlilik açısından daha küçük boyutlar tavsiye edilmez."
		"{@pagebreak}"
		"Verimli bir reaktör kurmanın detayları oldukça geniş kapsamlıdır; ancak aşağıda en ideal tasarımları bulabilirsiniz."
		""
		"İşte &#8F49C4Döteryum&r üretimi için ideal &#49C472Geniş Reaktör&r tasarımı:"
		"{image:atm:textures/questpics/modernindustrialization/large_reactor.png width:100 height:100 align:center}"
		""
		"İşte &#EB5266Trityum&r üretimi için ideal &#49C472Aşırı Reaktör&r tasarımı:"
		""
		"{image:atm:textures/questpics/modernindustrialization/largest_reactor.png width:100 height:100 align:center}"
	]
	quest.66E78F599CD50579.quest_subtitle: "Patlamazlar!"
	quest.672B69448F1D458B.quest_desc: ["&#FAAD28Isı Değiştirici&r, &#4D7DFFAşırı Reaktörler&r türbin meraklıları için mükemmel bir makinedir. İnanılmaz derecede yüksek miktarda buhar üretebilir."]
	quest.672B69448F1D458B.quest_subtitle: "Buhar Go Brrr"
	quest.6A9AE3514B5151C9.quest_desc: ["&#CFB951Kanthal Bobinleri&r, &#C356C4Ham Titanyum&r hammaddesini &#DF9DE0Titanyum Sıcak Külçelerine&r dönüştürmenizi sağlar. Bu işlem için &#D49B70Manganez Sülfürik Solüsyonu&r gereklidir."]
	quest.6F183B06683D1213.quest_desc: ["&#EBA844Kanthal Sıcak Külçe&r, &#6DC0F7Vakumlu Dondurucu&r kullanılarak soğutulabilir."]
	quest.6F3974CAAA555FD0.quest_subtitle: "RAM Yönetimi"
	quest.75619C7174C6703C.quest_desc: ["&#83729EUranyum Tozu&r santrifüjlendiğinde, daha gelişmiş yakıt çubuklarının yapımında kullanılan uranyum izotopları elde edilir."]
	quest.75619C7174C6703C.title: "Uranyum Tozu Santrifüjleme"
	quest.78EC7D19BE24FE06.quest_subtitle: "Patlamaz"
	quest.7AF6C95816E82861.quest_desc: ["&#8F49C4Döteryum&r ve &#AABBFAOksijen&r &#5B75D4kimyasal reaksiyona sokulduğunda&r &#9C51DBAğır Su&r elde edilir. Elde edilen ağır su tekrar &#45BF56Reaktör&r içerisine aktarılabilir."]
	quest.7C73740F1B515F2C.quest_desc: ["&#C452C4Tungsten Tozu&r işlenebilmek için daha küçük toz parçacıklarına ayrıştırılmalıdır."]
	task.08F68CC089765088.title: "Bypass Taktiği"
}
