{
	chapter.56B11606F5F4DAB2.title: "Dijital Çağ"
	chapter_group.6700DB960E16A321.title: "Modern Industrialization"
	quest.00C95A190BE2CBF9.quest_desc: ["&#994ABAStyrene&r elde etmek için &#C2C969Iron Dust&r, &#69C9B6EthylBenzene&r ve buhar (Steam) tepkimeye sokulmalıdır. &#69C9B6EthylBenzene&r ise &#CDCF95Steam Cracked Naptha&r'nın damıtılmasıyla elde edilir."]
	quest.00C95A190BE2CBF9.title: "Gelişmiş Damıtma"
	quest.011B8BD02D80DDD4.quest_desc: ["Dünyada kolayca &#6E2D6ETungsten Ore&r bulabilirsiniz. Cevheri kırdığınızda &#A140A1Raw Tungsten&r elde edersiniz."]
	quest.024BD22824C7F53A.quest_desc: ["&#F0C87DSteam-Cracked Naptha&r damıtılarak &#8FD5E3Toluene&r elde edilebilir."]
	quest.09BE81548CD81068.quest_desc: ["Sonunda &#FFEB6EAllthemods Star&r için gereken bileşenlere ulaştınız!"]
	quest.0B60DA8F65E5DF06.quest_desc: ["&#C452C4Tungsten Dust&r elde etmek için &#A140A1Raw Tungsten&r'ı çeşitli yöntemlerle öğütebilirsiniz."]
	quest.0C229BE9B57269EF.quest_desc: ["&#EBA844Kanthal Dust&r, &#816DF7Electric Blast Furnace&r içerisinde eritilmelidir."]
	quest.0CD36928116E868E.quest_desc: ["&#F36EF5PolyVinyl Chloride&r elde etmek için &#F783F3Vinyl Chloride&r; &#9683F7Lead Tiny Dust&r veya &#FEA8FFChromium Tiny Dust&r ile karıştırılabilir."]
	quest.0EA327E405EDFF02.quest_desc: ["&#9C6C35Acetylene&r ile &#DEAB6DHydroChloric Acid&r karıştırılarak &#F783F3Vinyl Chloride&r elde edilebilir."]
	quest.18C0EF38430C3E67.quest_subtitle: "Dijital Çağ"
	quest.1A83615B7E1D3540.quest_desc: ["&#45BF56Reactor&r içerisine yakıt ve &9Su&r yerleştirmek &#8F49C4Deuterium&r üretir. Farklı yöntemler bulunsa da &#45BF56Reactor&r en hızlı yolu sunar."]
	quest.226187AA3F1B6DB1.quest_desc: ["&#D4C35DKum&r, &8Çakmaktaşı&r, &#8DF0EENitrogen&r ve &#69C9C7Toluene&r karıştırılarak &#D66D40Industrial TNT&r elde edilir."]
	quest.22B8D57337944D9C.quest_desc: ["&#DF9DE0Titanium Hot Ingot&r'lar, &#5CD1CFVacuum Freezer&r dondurucusunda soğutularak kullanılabilir &#F069F0Titanium Ingot&r külçelerine dönüştürülür."]
	quest.22B8D57337944D9C.title: "&#F069F0Titanium Ingot"
	quest.23DB52ECA259F36D.quest_desc: [
		"&#45BF56Reactor&r içindeki Heavy Water; &#EB5266Tritium&r ve &#C09EDEHeavy Water Steam&r üretir."
		""
		"&#EB5266Tritium&r gelişmiş bileşenler için kullanılırken &#C09EDEHeavy Water Steam&r ise &#DEAB47Heat Exchanger&r içinde yeniden &#8C47C9Heavy Water&r'a dönüştürülebilir."
	]
	quest.267A357B28228694.quest_desc: ["&#4DB85ERandom Access Memory&r, &#5EC7E6Chemical Reactor&r içerisinde &#A1A1A1Styrene-Butadiene Rubber&r, &#D15EE6Argon&r, &7Antimony Dust&r, &#5ED2E6Aluminum Dust&r ve &#5D76C2Silicon Wafer&r kullanılarak üretilir."]
	quest.282A23C3E7561796.quest_desc: [
		"&#94C0E3Processing Array&r, makinelerin eşzamanlı (paralel) çalışmasını sağlayan devasa bir çoklu blok yapısıdır. Maksimum &#94E3A264&r adet paralel işlemi destekler."
		""
		"Çoklu blok yapısını inşa etmek için, öncelikle kontrol bloğunun arayüzünden simüle etmek istediğiniz paralel makine miktarını belirleyin."
		""
		"{image:atm:textures/questpics/modernindustrialization/proc_array_gui.png width:175 height:100 align:center}"
		""
		"{@pagebreak}"
		"Sistemi çalıştırmak için simüle edeceğiniz makineyi arayüzün sağındaki yuvaya yerleştirin. İstenen paralel işlem sayısı kadar makine eklenmelidir."
		""
		"Ayrıca &#94C0E3Processing Array&r tüm yükseltmeleri destekler."
	]
	quest.2A95F4F998835B43.quest_subtitle: "9 Parça -> 1 Külçe"
	quest.3003598CE8B1FAAA.quest_subtitle: "Daha İyi Teknoloji"
	quest.3003598CE8B1FAAA.title: "Daha Gelişmiş Bileşenler"
	quest.31CB278B4BA7B25E.quest_desc: ["&#B5E7F7Liquid Air&r santrifüj edildiğinde 3 farklı çıktı elde edilir: &#A5CAD9Oxygen&r, &#78ADC2Nitrogen&r ve &#DD91EDArgon&r. Bu &#DD91EDArgon&r ilerleyen adımlarda gerekecektir."]
	quest.31CB278B4BA7B25E.quest_subtitle: "Mantıklı"
	quest.31CB278B4BA7B25E.title: "Havayı Santrifüjleme"
	quest.352A226915809E1B.quest_desc: ["&#A57DE3Packer&r; &#7DD2E3Stainless Steel&r, &#B37DE3Tungsten&r ve &#E37DDBTitanium Ingot&r'ı yeni bir &#3946E3Mixed Blastproof Ingot&r halinde birleştirmenizi sağlar."]
	quest.35FDC436DE07635F.quest_desc: ["&#DB62DEImplosion Compressor&r, hammaddeleri sıkıştırmak için patlama gücünden yararlanır. Çok daha verimli bir şekilde &#8762DEMixed Blastproof Alloy Ingot&r ve çeşitli değerli kaynaklar üretmek için kullanılır."]
	quest.3601DD545E1D11B4.quest_desc: [
		"&#DD91EDArgon&r; &#83729ESilicon Dust&r ve &#AAA0BAIridium Tiny Dust&r ile tepkimeye sokularak &#919191Monocrystalline Silicon&r elde edilir."
		""
		"&#AAA0BAIridium&r dünyada bir cevher olarak bulunur."
	]
	quest.36D35C35BBC0A555.quest_subtitle: "En Verimli Yöntem"
	quest.386ABEB4249D157D.quest_desc: ["Tek bir &#919191Monocrystalline Silicon&r dilimlenerek 32 adet &#8FA4B5Silicon Wafer&r elde edilebilir."]
	quest.3891F8D4201E6BFD.quest_desc: [
		"&#EBA844Kanthal Ingot&r önce Fine Wire'a, ardından Cable'a dönüştürülerek en sonunda &#EBA844Kanthal Coil&r üretmek için kullanılır."
		""
		"&#EBA844Kanthal Coil&r'ler, &#816DF7Electric Blast Furnace&r'ın çok daha yüksek &#F76D6Dsıcaklıkta&r çalışmasını sağlayarak yeni tariflerin işlenmesine olanak tanır."
		""
		"Bobinleri &#816DF7Electric Blast Furnace&r arayüzü üzerinden değiştirebilirsiniz."
		""
		"{image:atm:textures/questpics/modernindustrialization/switch_to_kanthal.png width:150 height:75 align:center}"
	]
	quest.39A0BA6E2A72A681.quest_desc: ["&#99F0F0Stainless Steel&r, &#ADDBDBAluminium&r ve &#E9A8F7Chromium Dust&r karıştırılarak &#EBA844Kanthal Dust&r elde edilir."]
	quest.3A0C8BCE197A448B.quest_desc: ["&#A1A1A1Styrene-Butadiene Rubber&r üretmek için &#827AFFStyrene-Butadiene&r; &#9683F7Lead Tiny Dust&r veya &#FEA8FFChromium Tiny Dust&r ile karıştırılabilir."]
	quest.3ACC27B786CDCF22.quest_desc: ["&#3ABEC7Electric Compressor&r, &#CE5ADBTungsten Tiny Dust&r tozunu &#AF22BFTungsten Nugget&r parçalarına dönüştürmenizi sağlar."]
	quest.3B1CDC2DD05CAE80.quest_desc: ["&#F36EF5PolyVinyl Chloride&r; &#6EBAF5Platinum Plate&r, &#C4C362Cadmium Battery&r, &#F7BB57Annealed Copper Cable&r ve &#57BFF7Digital Circuit Board&r ile birleştirilerek &#EBE56EProcessing Unit Board&r üretilir."]
	quest.3CB05026BC4C5577.quest_desc: ["Şimdilik &#3946E3Mixed Blastproof Ingot&r kullanarak &#6F93C7Electric Compressor&r ile verimsiz de olsa &#986FC7Blastproof Alloy Plate&r üretebilirsiniz."]
	quest.3FE2A649F07DF28D.quest_subtitle: "Plutonium Dust İçin Extreme Reactors Blutonium'u Öğütülebilir"
	quest.3FE489E6B1FAC24B.quest_subtitle: "Tükenmiş Çubukları Geri Dönüştürmek"
	quest.3FE489E6B1FAC24B.title: "Plütonyum Elde Etmek"
	quest.40F2EDB9384CE782.quest_desc: ["&#DBE37FSteam Cracked Light Fuel&r damıtıldığında ürün olarak &#9C6C35Acetylene&r elde edilir."]
	quest.4A06CCE1FE0F333C.quest_desc: ["&#74C3DBAir Intake&r, &#46CAF2Vacuum Freezer&r içerisine yerleştirildiğinde &#B5E7F7Liquid Air&r üretir."]
	quest.4A618CA66AD6223D.quest_subtitle: "Daha Fazla Güç Girişi"
	quest.4F870252E9FB1A41.quest_desc: ["Reaktör, yakıt çubukları (Fuel Rods) ile beslenebilir; bunlar üretebileceğiniz en temel yakıt çubuklarıdır."]
	quest.50F97171D25CD2EE.quest_desc: ["&#6EDDFFHighly Advanced Upgrade&r modülleri, eklenen her yükseltme başına &#FFEB6E512 EU/t&r kapasite kazandırır."]
	quest.56A4F5D301BC1E93.quest_desc: ["&#6EDDFFTurbo Upgrade&r yükseltmeleri, eklenen her modül başına &#FFEB6E64EU/t&r kapasite artışı sağlar."]
	quest.58F7C11C241DD7A4.quest_desc: [
		"&#6AADD9Distillation Tower&r, &#A3D2F0Distillery&r makinesinin gelişmiş versiyonudur. En büyük avantajı, tek bir girdiden aynı anda birden fazla çıktı elde etmeyi sağlamasıdır."
		""
		"Yapıyı inşa etmek için &#6AADD9Distillation Tower&r ana bloğunun arayüzünü açıp kule yüksekliğini belirleyin. Yükseklik, alacağınız çıktı sayısına bağlıdır. Örneğin &#76759ECrude Oil&r işlemek için 3 blok yüksekliğinde bir yapı gerekir."
	]
	quest.58F7C11C241DD7A4.quest_subtitle: "Verimlilik Önemlidir"
	quest.5A4406F89DB802F0.quest_desc: ["&#BB95CFStyrene&r ve &#D46C85Butadiene&r tepkimesi sonucunda &#827AFFStyrene-Butadiene&r elde edilir."]
	quest.5B45AB96953FA61C.title: "Dijital Çağ"
	quest.633D6361DA680C75.quest_desc: ["&#E6ED98Light Fuel&r; buhar (Steam) ile karıştırıldığında &#DBE37FSteam Cracked Light Fuel&r elde edilir."]
	quest.66E78F599CD50579.quest_desc: [
		"&#49C472Nuclear Reactor&r, üst düzey kaynakları işlemenizi sağlar. Bu yapıyı &#8F49C4Deuterium&r ve &#EB5266Tritium&r üretmek için kullanacağız."
		""
		"Bu kaynak listesi \"Large\" boyutunda bir Reactor kurmanıza yardımcı olacaktır. Hız ve verimlilik açısından daha küçük boyutlar tavsiye edilmez."
		"{@pagebreak}"
		"Verimli bir reaktör kurmanın detayları oldukça geniş kapsamlıdır; ancak aşağıda en ideal tasarımları bulabilirsiniz."
		""
		"İşte &#8F49C4Deuterium&r üretimi için ideal &#49C472Large Reactor&r tasarımı:"
		"{image:atm:textures/questpics/modernindustrialization/large_reactor.png width:100 height:100 align:center}"
		""
		"İşte &#EB5266Tritium&r üretimi için ideal &#49C472Extreme Reactor&r tasarımı:"
		""
		"{image:atm:textures/questpics/modernindustrialization/largest_reactor.png width:100 height:100 align:center}"
	]
	quest.66E78F599CD50579.quest_subtitle: "Patlamazlar!"
	quest.672B69448F1D458B.quest_desc: ["&#FAAD28Heat Exchanger&r, &#4D7DFFExtreme Reactors&r türbin meraklıları için mükemmel bir makinedir. İnanılmaz derecede yüksek miktarda buhar (Steam) üretebilir."]
	quest.672B69448F1D458B.quest_subtitle: "Steam Go Brrr"
	quest.6A9AE3514B5151C9.quest_desc: ["&#CFB951Kanthal Coil&r bobinleri, &#C356C4Raw Titanium&r hammaddesini &#DF9DE0Titanium Hot Ingot&r külçelerine dönüştürmenizi sağlar. Bu işlem için &#D49B70Manganese Sulfuric Solution&r gereklidir."]
	quest.6F183B06683D1213.quest_desc: ["&#EBA844Kanthal Hot Ingot&r, &#6DC0F7Vacuum Freezer&r dondurucusunda soğutulabilir."]
	quest.6F3974CAAA555FD0.quest_subtitle: "RAM Yönetimi"
	quest.75619C7174C6703C.quest_desc: ["&#83729EUranium Dust&r santrifüjlendiğinde, daha gelişmiş yakıt çubuklarının yapımında kullanılan uranyum izotopları elde edilir."]
	quest.75619C7174C6703C.title: "Uranyum Santrifüjleme"
	quest.78EC7D19BE24FE06.quest_subtitle: "Patlamaz"
	quest.7AF6C95816E82861.quest_desc: ["&#8F49C4Deuterium&r ve &#AABBFAOxygen&r &#5B75D4kimyasal reaksiyona sokulduğunda&r &#9C51DBHeavy Water&r elde edilir. Elde edilen ağır su tekrar &#45BF56Reactor&r içerisine aktarılabilir."]
	quest.7C73740F1B515F2C.quest_desc: ["&#C452C4Tungsten Dust&r işlenebilmek için daha küçük toz parçacıklarına ayrıştırılmalıdır."]
