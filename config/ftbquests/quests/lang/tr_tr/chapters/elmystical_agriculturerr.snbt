	quest.33D23C65E7274A8F.quest_desc: ["Supremium Özü'nü uyandırmak için Uyanış Sunağı, 4 adet Kaide ve 4 adet &cÖz Kabı&r üretmeniz gerekir.\\n\\nÖz Kabı kaplarını doldurmak için temel element özleri gereklidir: Ateş, Su, Toprak ve Hava."]
	quest.33D23C65E7274A8F.title: "&dUyanış&r"
