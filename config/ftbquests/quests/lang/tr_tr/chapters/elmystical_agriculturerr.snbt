	quest.1C4ABF4518638A82.quest_desc: ["Güçlendirmeler:\\n\\n - Hasar Emilimi II (3:00)\\n - Hız II (3:00)\\n - Direnç II (3:00)\\n - Yenilenme II (3:00)\\n - Kuvvet II (3:00)"]
	quest.1C4ABF4518638A82.title: "&4Supremium Elması"
	quest.1CC4F8570A7A99EB.quest_desc: ["&dÖz&r, Mystical Agriculture'daki tüm tarım ihtiyaçlarınızın başlangıç noktasıdır.\\n\\n&eInferium Özü&r, tüm özlerin ilk kademesidir. Madencilik yaparak, yaratıkları öldürerek veya tohumlarını ekip yetiştirerek elde edebilirsiniz!\\n\\nDaha üst kademe özler üretmek için bir &9İnfüzyon Kristali&r yapmanız gerekecek."]
	quest.1CC4F8570A7A99EB.quest_subtitle: "Aşama: &e1"
	quest.1CC4F8570A7A99EB.title: "&aInferium"
	quest.1CF8263756EE8F2A.quest_desc: ["Bu özel tozu (&eBilişsel Toz&r), Wither veya Ender Ejderhası'nı &dMistik Aydınlanma&r büyülü bir &dÖz Silahı&r ile katlettiğinizde elde edersiniz."]
	quest.1CF8263756EE8F2A.title: "&5Bilişsel Toz&r"
	quest.1E0F92F07FDD162E.quest_desc: ["Kaynak ekinleri yetiştirmek için &bProsperity Tohum Temeli&r'lere ihtiyacınız olacak."]
	quest.1E0F92F07FDD162E.quest_subtitle: "Her Şeyin Temeli"
