	quest.1C4ABF4518638A82.title: "&4Supremium Elma"
	quest.1CC4F8570A7A99EB.quest_desc: ["&dEssence&r, Mystical Agriculture'daki tüm yetiştirme ihtiyaçlarınızın başlangıç noktasıdır.\\n\\n&eInferium Essence&r, tüm özlerin temel kademesidir. Bunu madencilik yaparak, yaratıkları öldürerek veya yetiştirmek için tohumlar üreterek elde edebilirsiniz!\\n\\nDaha büyük ve daha iyi özler yapmak için bir &9Infusion Crystal&r üretmeniz gerekir."]
	quest.1CC4F8570A7A99EB.quest_subtitle: "Kademe: &e1"
	quest.1CC4F8570A7A99EB.title: "&aInferium"
	quest.1CF8263756EE8F2A.quest_desc: ["Bu özel &eDust&r, &dMystical Enlightenment&r ile büyülenmiş bir &dEssence Weapon&r tarafından öldürülen Wither ve Ender Dragon'dan düşer."]
	quest.1CF8263756EE8F2A.title: "&5Cognizant Tozu&r"
	quest.1E0F92F07FDD162E.quest_desc: ["Resource Crops oluşturmak için &bProsperity Seed Bases&r gerekir."]
