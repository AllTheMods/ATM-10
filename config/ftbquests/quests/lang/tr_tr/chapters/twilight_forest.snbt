{
	chapter.7732CF7AAA63DB3A.title: "Twilight Forest"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.0107D516E038E0DB.quest_desc: ["&eLich Kulesi&r, &eLich&r'e ev sahipliği yapar! Dövüş 3 aşamadan oluşur:\n\nAşama 1: &eLich&r etrafını kalkanlarla çevreler ve üzerinize Ghast ateş topları gibi fırlayan &5Ender İncileri&r ile saldırır. Kalkanlarını kırmak için bunları &eLich&r'e geri sektirin! Kalkanları kırıldıkça dikkatinizi dağıtmak için kopyalarını çıkaracaktır.\n\nAşama 2: &eLich&r, savaşta kendisine yardım edecek Zombiler çağırmak için asa değiştirir. Savunması düştüğünde ona yakın dövüşle saldırma fırsatı bulacaksınız!\n\nAşama 3: Asasındaki tüm yükler bittiğinde bir &eAltın Kılıç&r'a geçer ve gözü döner. Onu hızlıca öldürün!"]
	quest.0107D516E038E0DB.title: "&eÖlüleri Çıkarın"
	quest.01748C2CD9C97523.quest_desc: ["&cYeniden Beliren Bloklar&r harika geçici kapı alternatifleridir. Sağ tıkladığınızda kısa bir süreliğine kaybolurlar.\\n\\n&cKaybolan Bloklar&r ise sağ tıklandığında yok olur ve geri gelmezler."]
	quest.01748C2CD9C97523.title: "&cYeniden Beliren \\& Kaybolan Bloklar"
	quest.04440BB2EFFD6DD9.quest_desc: ["Labirent Bataklığı'nın derinliklerinde devasa bir &cMinoshroom&r yaşar.\\n\\nYenildiğinde &eMeef Stroganoff&r düşürür. Bir sonraki bölgenin kilidini açmak için bunu yemeniz gerekir."]
	quest.04440BB2EFFD6DD9.title: "&cGüçlü Meef Stroganoff"
	quest.0990D6CEE042F44E.quest_desc: ["Bu harita &9Twilight Forest&r için olmazsa olmazdır.\\n\\n&eBoş Büyülü Harita&r kullandığınızda, yakındaki patronları ve yapıları simgelerle gösteren özel bir haritaya dönüşür."]
	quest.0990D6CEE042F44E.title: "&eBüyülü Harita"
	quest.0A207A437AF153AA.quest_desc: ["&2Hayalet Zırhı&r, &2Hayalet Şövalye&r sandıklarında nadiren çıkabilir."]
	quest.0A207A437AF153AA.title: "&2Hayalet Zırhı"
	quest.0E9DE6293DF611E1.quest_desc: ["&aNormal Dünya&r'nın daha çok &9Twilight Forest&r havasına bürünmesini ister misiniz?\\n\\nHayvanları &9Twilight Forest&r varyantlarına dönüştürmek için bu tozu üzerlerinde kullanabilirsiniz.\\n\\nBu tozu &9Twilight Forest&r zindan sandıklarında bulabilirsiniz."]
	quest.0ED7B25DC1AA767B.quest_desc: ["&9Twilight Forest&r'nda nadir fidanlar içeren ganimet sandıkları bulabilirsiniz.\\n\\nHepsini toplayın!"]
	quest.0ED7B25DC1AA767B.quest_subtitle: "Ağaç Yetiştirme"
	quest.0ED7B25DC1AA767B.title: "&aGerçek Son Patron"
	quest.111F2EE85FB0A455.quest_desc: ["Hydra'dan elde edilen &cAteşli Kan&r ile güçlü aletler yapabilirsiniz.\\n\\n&cAteşli Kılıç&r doğuştan Alevden Çehre II büyülüdür.\\n\\n&cAteşli Kazma&r ise otomatik eritme özelliğine sahiptir."]
	quest.111F2EE85FB0A455.title: "&cAteşli Aletler"
	quest.1464D45C474464DB.quest_subtitle: "Gelişmiş Yaprak Üfleyici"
	quest.15006CF73F8CAB7C.quest_desc: ["Tıpkı &cYaşam Tılsımı I&r gibi, &eYaşam Tılsımı II&r de sizi ölümden kurtarır. Devreye girdiğinde tüm canınızı yeniler ve 30 saniye boyunca Yenilenme IV, Direnç ve Ateş Direnci kazandırır.\\n\\n4 adet &cYaşam Tılsımı I&r birleştirilerek üretilebilir."]
	quest.15006CF73F8CAB7C.title: "&eYaşam Tılsımı II"
	quest.1FF5906DF721D091.quest_desc: ["&2Hydra&r, &cAteşli Zırh&r yapımında kullanılan &cAteşli Kan&r düşürür.\\n\\nSetin tamamını giydiğinizde size saldıran düşmanlar 10 saniye boyunca alev alır."]
	quest.1FF5906DF721D091.title: "&cAteşli Zırh"
	quest.20436AFCC7E6855D.quest_desc: ["&9Sihirli Fasulye&r ve &6Bereketli Toprak&r edindikten sonra dağlık biyomlarda devasa bir bulut aramalısınız.\\n\\nSihirli fasulyeleri toprağa ekerek fasulye sırığının bulutlara tırmanmasını sağlayın. Bulutların üstünde Devleri bulacaksınız.\\n\\nİlerlemek için Madenci Dev'i yenip kazmasını almalısınız."]
	quest.20436AFCC7E6855D.quest_subtitle: "Devler bana benziyor ama kesinlikle BENİM GİBİ değiller"
	quest.212EC1F41227184D.quest_desc: ["&eLich&r gibi Ender atışları yapmak ister misiniz? Eğer öyleyse &9Alacakaranlık Asası&r tam size göre!\n\nYeniden doldurmak için üretim penceresinde &5Ender İncisi&r ile birleştirin."]
	quest.212EC1F41227184D.quest_subtitle: "Ender Atışları Fırlatır"
	quest.212EC1F41227184D.title: "&9Alacakaranlık Asası"
	quest.25906B43A198B72F.quest_desc: ["&6Şövalye Metali Zırhı&r, Şövalye Metali Külçeleri ile üretilebilir veya &2Hayalet Şövalye&r sandıklarından çıkabilir."]
	quest.25906B43A198B72F.title: "&6Şövalye Metali Zırhı"
	quest.2951B1D7080C5EF9.quest_desc: ["&6Kül Lambası&r'nı kullanarak Dikenli Topraklar biyomundaki sarmaşık dikenleri yakıp temizleyebilirsiniz.\\n\\n&2Zirve Platosu&r'na ilerleyebilmek için biraz &cDiken Gülü&r toplayın."]
	quest.2951B1D7080C5EF9.title: "Her Dikenin Bir Gülü Vardır"
	quest.2A0B3C91D72E8B75.quest_desc: ["Küçük Yetiler ve Kış Kurtları, &6Kutup Zırhı&r yapımında kullanılan Kutup Kürkü düşürür."]
	quest.2A0B3C91D72E8B75.quest_subtitle: "Boyanabilir!"
	quest.2A0B3C91D72E8B75.title: "&6Kutup Zırhı"
	quest.2BEBF66D7EA594FA.quest_desc: ["Bu zırh &2Naga&r zırhından biraz daha güçlüdür ve doğuştan büyülü olarak üretilir.\\n\\n&9Twilight Forest&r'nda &2Çelik Yaprak&r toplayarak üretebilirsiniz."]
	quest.2BEBF66D7EA594FA.title: "&2Çelik Yaprak Zırhı"
	quest.31BB7EB95CE73C1A.quest_desc: ["&cUr-Ghast&r'ı yendikten sonra Karlı Orman biyomlarının kilidi açılır.\\n\\nBurada savaşacak pek çok yaratık bulunsa da yolunuza devam edebilmek için Alfa Yeti'yi yenmelisiniz.\\n\\nAlfa Yeti devasa bir Yeti Mağarası'nda yaşar. İlerlemek için onu alt edin."]
	quest.31BB7EB95CE73C1A.quest_subtitle: "Haberin Bile Yoktu"
	quest.31BB7EB95CE73C1A.title: "Karlı Biyomlara Doğru!"
	quest.3371570F189DF994.quest_desc: ["&6Sağlamlaştırma Asası&r sizi korumak için etrafınızda kalkanlar oluşturur.\\n\\nYeniden doldurmak için üretim penceresinde &6Altın Elma&r ile birleştirin."]
	quest.3371570F189DF994.quest_subtitle: "Kalkan Oluşturur"
	quest.3371570F189DF994.title: "&6Sağlamlaştırma Asası"
	quest.3531B28F14CF72A2.quest_desc: ["&9Twilight Forest&r maceranızda karşılaşacağınız ilk patron Naga Avlusu'nda bulunur.\\n\\n&2Naga&r, çok sayıda gövde boğumundan oluşan dev bir yılandır. Hasar verdikçe boğumları tek tek yok olur.\\n\\n&2Naga&r'yı yendiğinizde değerli ganimetler kazanır ve bir sonraki patron olan Lich'in kulesine giriş hakkı elde edersiniz."]
	quest.3531B28F14CF72A2.title: "&2Pulları Eşitlemek"
	quest.38ADDF7FF4E4892D.quest_desc: ["&7Cam Kılıç&r 40 kalp hasar verir, ancak yalnızca 1 dayanıklılığı vardır.\n\nKullanmak istiyorsanız onu kırılmaz hale getirebilirsiniz.\n\nBunlar &bAurora Sarayı&r ganimet sandıklarında nadiren bulunur."]
	quest.38ADDF7FF4E4892D.title: "&7Cam Kılıç"
	quest.3908F7C80154D9CA.quest_desc: ["&2Zombi Asası&r var, çünkü kim kendi &2Zombilerini&r çağırmak istemez ki?\n\nYeniden doldurmak için üretim penceresinde &cÇürük Et&r ile birleştirin."]
	quest.3908F7C80154D9CA.quest_subtitle: "Zombi Ordusu Çağırır"
	quest.3908F7C80154D9CA.title: "&2Zombi Asası"
	quest.3A3ED88027331A6C.quest_desc: ["&eKoruma Tılsımı III&r, öldüğünüzde envanterinizdeki tüm eşyaları koruyarak kaybetmenizi engeller."]
	quest.3A3ED88027331A6C.title: "&eKoruma Tılsımı III"
	quest.3C8724C3A9459507.quest_desc: ["&6Yeti Zırhı&r, Alfa Yeti Kürkü kullanılarak üretilir."]
	quest.3C8724C3A9459507.title: "&6Yeti Zırhı"
	quest.3D29EF7F150F5334.quest_desc: ["&3Ender Yayı&r, &bAurora Sarayı&r sandıklarında nadiren bulunur.\\n\\nOk bir düşmana isabet ettiğinde hedefinizle anında yer değiştirirsiniz. Havada uçan yaratıkları vururken aman dikkat!"]
	quest.3D29EF7F150F5334.title: "&3Ender Yayı"
	quest.3DCF26B53AE1EBF6.quest_desc: ["&2Karanlık Orman&r'ın içinde yeraltına uzanan bir yapı bulacaksınız.\n\nİçeri girmek için kazandığınız patron kupalarından birini yakındaki kaideye yerleştirmeniz gerekir; hangisini koyduğunuz önemli değil, sonradan geri alabilirsiniz.\n\n3. katta Hayalet Şövalyeleri bulacaksınız. Bir sonraki patronun kilidini açmak için bunları yenin."]
	quest.3DCF26B53AE1EBF6.quest_subtitle: "Ormanın En Karanlık Köşesi"
	quest.3DCF26B53AE1EBF6.title: "&2Karanlık Orman"
	quest.40258842B0359A2D.quest_desc: ["&6Demir Ağaç Zırhı&r, &6Demir Ağaç Külçesi&r kullanılarak üretilir ve doğuştan büyülü olarak gelir."]
	quest.40258842B0359A2D.title: "&6Demir Ağaç Zırhı"
	quest.4193303999597249.quest_desc: [
		"&9Twilight Forest&r, oyuna Twilight Forest boyutunu ekleyen bir moddur. Bu boyut yepyeni eşyalar, biyomlar, yaratıklar ve patronlarla doludur!\n\n&9Twilight Forest&r'na gitmek için gereken portalı oluşturmak adına, yere 2x2'lik bir çukur kazın ve suyla doldurun. Çukurun kenarlarını çiçeklerle çevreleyin ve suya bir Elmas atın.\n\nİşlemi doğru yaptıysanız Thor size bir işaret verecek ve portal etkinleşecektir.\n"
		"{image:atm:textures/questpics/gettingstarted/twilight_portal.png width:100 height:100 align:center fit:true}"
	]
	quest.4193303999597249.quest_subtitle: "Twilight Forest'a Girin"
	quest.4193303999597249.title: "&9Twilight Forest&r'a Hoş Geldiniz!"
	quest.420158B1736A1354.quest_desc: ["...henüz oyuna eklenmedi.\n\nBunun yerine, Zirve Platosu'ndaki dev kaleye gidip birkaç kapı bloğu kapın!\n\nBurada \"yer tutucu\" olarak doğan bir Kobold var ancak onu öldürdüğünüzde hiçbir şey elde edemezsiniz."]
	quest.420158B1736A1354.title: "&cSon Patron"
	quest.4665E6FD0AAED164.quest_desc: ["&fKoruma Tılsımı II&r, &6Koruma Tılsımı I&r ile aynı şekilde çalışır ancak öldüğünüzde hızlı erişim çubuğunuzdaki (hotbar) eşyaları da kaybetmenizi engeller."]
	quest.4665E6FD0AAED164.title: "&fKoruma Tılsımı II"
	quest.49EE6D2A3684A510.quest_desc: ["&bBuz Yayı&r sandıklarda rastgele bulunabilir. İsabet ettiği hedefe 10 saniye boyunca Yavaşlık III etkisi verir."]
	quest.49EE6D2A3684A510.title: "&bBuz Yayı"
	quest.4B95D48D7525FFAD.quest_desc: ["Artık &2Bataklıklar&r'a gitme zamanı geldi! &2Bataklıklar&r bölgesinde tepesinde giriş olan höyük benzeri bir yapı göreceksiniz. Burası &cMinoshroom Labirenti&r!\\n\\nİçeride &eLabirent Haritası Odağı&r düşüren yeni yaratıklarla savaşacaksınız. Bu odak, bir &eLabirent Haritası&r üretmek için gereklidir.\\n\\nBu harita labirentteki yolunuzu bulmanızı sağlar. Klasik mini haritalar bu yeraltı labirentinde çalışmaz!\\n\\nAyrıca labirentte gizlenmiş özel ganimet odalarını da keşfedebilirsiniz."]
	quest.4B95D48D7525FFAD.quest_subtitle: "Shrek Nerede?"
	quest.4B95D48D7525FFAD.title: "&2Bataklıklara Doğru!"
	quest.4D4AB60B3B1CD437.quest_desc: ["&2Naga&r pullarını kullanarak özel zırhlar üretebilirsiniz.\\n\\nÇok yüksek koruma sağlamasa da oldukça şık bir görünüme sahiptir."]
	quest.4D4AB60B3B1CD437.title: "&2Naga Pulu Zırhı"
	quest.4DA0725E089D7C91.quest_desc: ["&cG&6ö&er&2e&3v &9K&5o&cç&6u&r'nu bulun! Kendisine 16 farklı renkte &cG&6ö&ek&2k&3u&9ş&5a&cğ&6ı &eY&2ü&3n&9ü&r getirenlere cömert ödüller verir.\\n\\nİpucu: Koç'un yer aldığı kalıntılarda başınızın hizasında duran Fırlatıcı işinize yarayabilir."]
	quest.4DA0725E089D7C91.quest_subtitle: "Görevler?"
	quest.4DA0725E089D7C91.title: "&cK&6o&eç&2l&3a&9ş&5m&ca"
	quest.4F66DF6B494BEFF3.quest_desc: ["Bir &8Kuzgun Tüyü&r'nü &eMeşale Meyvesi&r ve &6Işıktaşı Tozu&r ile birleştirerek bir &eBüyülü Harita Odağı&r elde edebilirsiniz."]
	quest.4F66DF6B494BEFF3.title: "&eBüyülü Harita Odağı"
	quest.51BC981AB4CFAD95.quest_desc: ["&bLabirentkıran&r, labirentlerdeki gizli odalarda nadiren bulunan özel bir kazmadır.\\n\\nLabirent duvarlarını kırarken diğer kazmalar 16 kat fazla dayanıklılık kaybederken bu kazma yalnızca 1 dayanıklılık harcar!"]
	quest.51BC981AB4CFAD95.quest_subtitle: "Tuzaklı Oda, Sakın Girme!"
	quest.53A79338994088FD.quest_desc: ["&dÜçlü Yay&r, &3Kar Kraliçesi&r mağlup edildiğinde düşer. Yalnızca 1 ok harcayarak tek seferde 3 ok birden fırlatır."]
	quest.53A79338994088FD.quest_subtitle: "Bir Lynel'den mi?"
	quest.53A79338994088FD.title: "&dÜçlü Yay"
	quest.575E405B270BBCBC.quest_desc: ["&9Twilight Forest&r'nda karşılaşacağınız pek çok yeni yaratık bulunur.\\n\\nKulağı tırmalayan sesiyle Ağustos Böceği en sinir bozucu olanlardan biridir! Bu görevi tamamlamak için onu veya herhangi bir Twilight Forest yaratığını avlayabilirsiniz."]
	quest.575E405B270BBCBC.title: "Ormanın Sessizliği"
	quest.57940981E8DE55D4.quest_desc: ["&9Twilight Forest&r'nda yolunuzu kaybetmek işten bile değildir. Keşif yaparken devasa &5Obsidyen Sütunlar&r göreceksiniz.\\n\\nBu sütunların etrafında uçuşan &8Kuzgunlar&r bulunur. Harita yapımında kullanacağınız tüyleri elde etmek için onları avlayın."]
	quest.57940981E8DE55D4.title: "&8Kuzgun Tüyleri"
	quest.58BD1063A19777DC.quest_desc: ["&2Dağlık&r biyomun kilidini açtıktan sonra oraya gidip Trolleri avlayın.\\n\\nTrollerden &9Sihirli Fasulye&r düşebilir. Ayrıca mağara sandıklarında bu fasulyeleri dikmek için gereken &6Bereketli Toprak&r'ı bulabilirsiniz."]
	quest.58BD1063A19777DC.quest_subtitle: "Jack Nerede?"
	quest.58BD1063A19777DC.title: "Devleri Ziyaret"
	quest.5CBA8C89FE717B9C.quest_desc: ["Ele geçirdiğiniz &8Dev Kazması&r ile Trol Mağaralarına dönüp &5Dev Obsidyen&r bloğunu kırın.\\n\\nBloğun içindeki sandıktan &6Kül Lambası&r'nı alarak maceranıza devam edin."]
	quest.5CBA8C89FE717B9C.title: "&6Kül Lambası"
	quest.5FE4DAE8F41B1437.quest_desc: ["&cCevher Mıknatısı&r, yerin altındaki kömür dışındaki tüm cevherleri yüzeye çekmeye yarar.\\n\\n&2Oyuk Tepe&r sandıklarında bulunabilir."]
	quest.5FE4DAE8F41B1437.title: "&cCevher Mıknatısı"
	quest.604F2B68B27885BF.quest_desc: ["&9Twilight Forest&r malzemeleriyle yapabileceğiniz pek çok lezzetli yiyecek var!\\n\\nHepsini tadın!"]
	quest.604F2B68B27885BF.title: "Süslü Yiyecekler"
	quest.607D592CE102C82E.title: "&6Şövalye Metali Aletler"
	quest.60FC2DAEA954A849.quest_desc: ["&6Aykurdu Kraliçesi&r adeta bir meşale fırlatıcıdır. Nişan aldığınız bloğa bir &eAykurdu&r fırlatarak orayı meşale gibi aydınlatır.\\n\\n&2Oyuk Tepe&r ve &eLich Kulesi&r sandıklarında bulunabilir."]
	quest.60FC2DAEA954A849.title: "&6Aykurdu Kraliçesi"
	quest.610F9E9D0B5131C7.quest_desc: ["&6Koruma Tılsımı I&r, öldüğünüzde elinizdeki, ikincil elinizdeki eşyaları ve üzerinizdeki zırhları korur."]
	quest.610F9E9D0B5131C7.title: "&6Koruma Tılsımı I"
	quest.688C911ECFB2F134.quest_desc: ["&2Karanlık Orman&r'ın ortasında yükselen devasa &8Karanlık Kule&r'yi keşfedin.\\n\\nKuleye girmek için tabandaki yenilenen blokları kullanın ve labirent gibi katları tırmanarak en tepedeki &cUr-Ghast&r'a ulaşın.\\n\\n&cUr-Ghast&r ile savaşırken menzilli silahlar tercih etmeniz önerilir. Patron katında ona ciddi hasar veren 4 adet Ghast tuzağı bulunur.\\n\\nTuzaklar etraftaki &cGhastling&r'leri avlayarak şarj edilir ve Redstone sinyaliyle tetiklenir. Kullanmak zorunlu olmasa da savaşı çok kolaylaştırır."]
	quest.688C911ECFB2F134.quest_subtitle: "Karanlık Karminit Kulesi"
	quest.688C911ECFB2F134.title: "&cAteş Gözyaşları"
	quest.6CB1BFBA10DF24E4.quest_desc: ["&cYaşam Sömürme Asası&r ile düşmanlarınızın canını emerek kendinizi iyileştirebilirsiniz!\\n\\nAsayı yeniden doldurmak için üretim penceresinde &cMayalı Örümcek Gözü&r ile birleştirin."]
	quest.6CB1BFBA10DF24E4.quest_subtitle: "Can Sömürür"
	quest.6CB1BFBA10DF24E4.title: "&cYaşam Sömürme Asası"
	quest.6F67079A453DAABE.quest_desc: ["&cYaşam Tılsımı I&r, ölümü engelleyen tek kullanımlık bir eşyadır. Ölmek yerine tılsım tüketilir ve size kısa bir süreliğine can yenilenmesi verilir.\n\nBunlar ganimet sandıklarında bulunabilir."]
	quest.6F67079A453DAABE.title: "&cYaşam Tılsımı I"
	quest.6FD41DF7704466A4.quest_desc: ["Alfa Yeti'yi yenmek &9Buzul&r biyomunun kilidini açar. Burada sevimli küçük Penguenleri ve &3Kar Kraliçesi&r'ni bulacaksınız.\n\n&bAurora Sarayı&r'nın en üstünde &3Kar Kraliçesi&r kendisini korumak için Buz kristalleri çağıracaktır.\n\nAyrıca zemini kırabilen ve devasa hasar veren &3Buz&r kütlelerini yere çarpacaktır.\n\n&3Buz&r ile korunduğu için yalnızca üst yarısına vurabilirsiniz.\n\n&3Kar Kraliçesi&r'ni yendikten sonra &2Dağlık&r biyomlara erişimin kilidini açacaksınız."]
	quest.6FD41DF7704466A4.title: "&bAçık Gökyüzü"
	quest.7026E46FD8B3A81D.quest_desc: ["&9Hydra&r, Yunan Mitolojisindeki meşhur çok başlı canavardır.\n\nMenzilli saldırılar pek etkili değildir, bu yüzden yaklaşıp göğüs göğüse dövüşmeniz gerekecek.\n\nYenildiğinde, bir sonraki patronu &2Karanlık Ormanda&r bulabileceksiniz."]
	quest.7026E46FD8B3A81D.quest_subtitle: "Ateşli Bataklık"
	quest.7026E46FD8B3A81D.title: "&9Hydra Avcısı"
	quest.730AF9210F00018E.quest_desc: ["&bElmas Minotor Baltası&r, &cMinoshroom&r mağlup edildiğinde düşer. Koşarak (depar atarak) saldırdığınızda ekstra hasar verir."]
	quest.730AF9210F00018E.title: "&bMinotor Baltası"
	quest.7509E4093010EA4C.quest_desc: ["&aArayıcı Yay&r, &3Kar Kraliçesi&r'nden düşer. Fırlattığı oklar kendiliğinden hedefe kilitlenir. Artık ok kaçırmak yok!"]
	quest.7509E4093010EA4C.quest_subtitle: "Nişanın Kötü mü?"
	quest.7509E4093010EA4C.title: "&aArayıcı Yay"
	quest.78CE2ECEF0B651DA.quest_desc: ["&bAurora Sarayı&r sandıklarında bulunan &3Buz Kılıcı&r, vurduğu düşmanları 10 saniye boyunca &bDonma&r etkisi altında bırakır."]
	quest.78CE2ECEF0B651DA.title: "&3Buz Kılıcı"
	quest.7B4A687EB505C2FF.quest_desc: ["&cKarminit İnşacıları&r, Redstone sinyali aldığında sinyalin yönünde geçici bloklar oluşturur.\\n\\n&cKarminit Reaktörü&r ise çevresindeki Obsidyen ve Netherrack bloklarını &eSahte Altın&r ile &3Sahte Elmas&r'a dönüştürür. Ardından bu blokları içine çekip patlayarak etrafa &cKarminit Ghastling&r'ler saçar."]
	quest.7B4A687EB505C2FF.title: "&cKarminit İnşacıları \\& Reaktörleri"
}
