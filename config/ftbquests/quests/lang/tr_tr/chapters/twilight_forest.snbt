{
	chapter.7732CF7AAA63DB3A.title: "Alacakaranlık Ormanı"
	chapter_group.5A4775CCD6D26C80.title: "Keşif"
	quest.0107D516E038E0DB.quest_desc: ["&eLich Tower&r, &eLich&r'e ev sahipliği yapar! Savaş 3 aşamadan oluşur:\\n\\nAşama 1: &eLich&r kendini kalkanlarla çevreler ve size Ghast ateş topları gibi fırlayan &5Ender Pearls&r ile saldırır. Kalkanlarını kırmak için onları &eLich&r'e geri yansıtın! Kalkanları kırıldıkça, dikkatinizi dağıtmak için kopyalarını gönderecektir.\\n\\nAşama 2: &eLich&r, savaşta kendisine yardım etmeleri için Zombies çağırmak üzere asalarını değiştirir. Savunması düştüğünde, onunla yakın dövüşebileceksiniz!\\n\\nAşama 3: Asasındaki tüm yükler bittiğinde, bir &eGolden Sword&r'a geçecek ve çılgına dönecektir. Onu hızlıca öldürün!"]
	quest.0107D516E038E0DB.title: "&eÖlülerinizi Dışarı Çıkarın"
	quest.01748C2CD9C97523.quest_desc: ["&cReappearing Blocks&r gerçekten harika kapılar gibidir. Sağ tıklandığında kısa bir süreliğine kaybolurlar.\\n\\n&cVanishing Blocks&r sağ tıklandığında kaybolur, ancak geri gelmezler."]
	quest.01748C2CD9C97523.title: "&cReappearing \\& Vanishing Blocks"
	quest.04440BB2EFFD6DD9.quest_desc: ["Labyrinth Swamp'ın derinliklerinde dev bir &cMinoshroom&r bulunur.\\n\\nYenildiğinde, &eMeef Stroganoff&r düşürecektir. Bir sonraki alanın kilidini açmak için onu yemelisin."]
	quest.04440BB2EFFD6DD9.title: "&cKudretli Meef Stroganoff"
	quest.0990D6CEE042F44E.quest_desc: ["Bu harita &9Twilight Forest&r için mutlaka sahip olunması gereken bir şeydir.\\n\\nBir &eBlank Magic Map&r kullanmak size yakındaki patronların ve yapıların simgelerini gösteren bir harita verecektir."]
	quest.0990D6CEE042F44E.title: "&eMagic Map"
	quest.0A207A437AF153AA.quest_desc: ["&2Phantom Armor&r, &2Knight Phantom&r sandıklarında bulunma şansına sahiptir."]
	quest.0A207A437AF153AA.title: "&2Phantom Armor"
	quest.0E9DE6293DF611E1.quest_desc: ["&aOverworld&r'ün biraz daha &9Twilight Forest&r gibi hissettirmesini ister misin?\\n\\nBu tozu Overworld'deki hayvanları &9Twilight Forest&r varyantlarına dönüştürmek için kullanabilirsin.\\n\\nBunu &9Twilight Forest&r'daki zindan sandıklarında bulabilirsin."]
	quest.0ED7B25DC1AA767B.quest_desc: ["&9Twilight Forest&r içinde sana nadir fidanlar verebilecek ganimet sandıkları vardır.\\n\\nHepsini topla!"]
	quest.0ED7B25DC1AA767B.quest_subtitle: "Ağaç Yetiştirmek"
	quest.0ED7B25DC1AA767B.title: "&aGerçek Final Boss'u"
	quest.111F2EE85FB0A455.quest_desc: ["Hydra'dan elde edilen &cFiery Blood&r'ı kullanarak birkaç alet yapabilirsin.\\n\\nFiery Sword, Fire Aspect II ile birlikte gelir.\\n\\nFiery Pickaxe, otomatik eritme ile birlikte gelir."]
	quest.111F2EE85FB0A455.title: "&cFiery Tools"
	quest.1464D45C474464DB.quest_subtitle: "Görkemli Bir Yaprak Üfleyici"
	quest.15006CF73F8CAB7C.quest_desc: ["Tıpkı &cCharm of Life I&r gibi, &eCharm of Life II&r de ölümünüzü engellemek için tüketilir. Tüketildiğinde, tüm sağlığınızı yenileyecek ve 30 saniyeliğine Regen IV, Resistance ve Fire Resistance verecektir.\\n\\nBunlar 4 adet &cCharms of Life I&r ile üretilebilir."]
	quest.15006CF73F8CAB7C.title: "&eCharm of Life II"
	quest.1FF5906DF721D091.quest_desc: ["&2Hyrda&r, &cFiery Armor&r yapmak için kullanılabilecek &cFiery Blood&r düşürür.\\n\\nTam seti giydiğinizde, size saldıran düşmanlar 10 saniyeliğine ateşe verilir."]
	quest.1FF5906DF721D091.title: "&cFiery Armor"
	quest.20436AFCC7E6855D.quest_desc: ["Magic Beans ve Uberous Soil ile, dağlık biyomlarda büyük bir bulut aramak isteyeceksiniz.\\n\\nFasulye sırığını ta yukarıya kadar büyütmek için sihirli fasulyeleri toprağa ekin. Burada Giants'ı bulacaksınız.\\n\\nDevam etmek için Miner Giant'ı öldürmeniz ve kazmalarını almanız gerekecek."]
	quest.20436AFCC7E6855D.quest_subtitle: "Devler bana benziyor, ama HİÇ bana benzemiyorlar"
	quest.212EC1F41227184D.quest_desc: ["&eLich&r gibi Ender patlamaları fırlatabilmek ister misin? Eğer öyleyse, &9Scepter of Twilight&r tam sana göre bir asa!.\\n\\nŞarj etmek için, üretim ızgarasında bir &5Ender Pearl&r ile birleştir."]
	quest.212EC1F41227184D.quest_subtitle: "Ender Patlamaları Fırlatır"
	quest.212EC1F41227184D.title: "&9Scepter of Twilight"
	quest.25906B43A198B72F.quest_desc: ["Knightmetal Armor&r, Knightmetal Ingots ile üretilebilir ve &2Knight Phantom&r sandıklarında bulunma şansı vardır."]
	quest.25906B43A198B72F.title: "Knightmetal Armor"
	quest.2951B1D7080C5EF9.quest_desc: ["&6Lamp of Cinders&r kullanarak Thornland Biome'daki Thorns'ları kırabilirsin.\\n\\n&2Final Plateau&r'a devam etmek için biraz &cThorn Roses&r topla."]
	quest.2951B1D7080C5EF9.title: "Her Dikenin Gülü Vardır"
	quest.2A0B3C91D72E8B75.quest_desc: ["Small Yetis ve Winter Wolves, &6Arctic Armor&r yapmak için kullanılabilen Arctic Fur düşürür."]
	quest.2A0B3C91D72E8B75.quest_subtitle: "Boyanabilir!"
	quest.2A0B3C91D72E8B75.title: "&6Arctic Armor"
	quest.2BEBF66D7EA594FA.quest_desc: ["Bu, &2Naga&r zırhından biraz daha güçlüdür ve tamamen efsunlu olarak gelir.\\n\\nBunları &9Twilight Forest&r içinde &2Steeleaf&r bularak yapabilirsin."]
	quest.2BEBF66D7EA594FA.title: "&2Steeleaf Armor"
	quest.31BB7EB95CE73C1A.quest_desc: ["&cUr-Ghast&r'ı yendikten sonra, Snowy Forest biyomlarının kilidini açacaksınız.\\n\\nSavaşacak birçok yaratık var, ancak ilerlemenize devam etmek için Alpha Yeti'yi öldürmeniz gerekecek.\\n\\nAlpha Yeti'yi devasa bir Yeti mağarasında bulabilirsiniz. Devam etmek için onu alt edin."]
	quest.31BB7EB95CE73C1A.quest_subtitle: "Kardan haberin yoktu"
	quest.31BB7EB95CE73C1A.title: "Kar Biyomlarına!"
	quest.3371570F189DF994.quest_desc: ["&6Scepter of Fortification&r, koruma sağlamak için etrafınızda kalkanlar çağırır.\\n\\nŞarj etmek için, bir üretim ızgarasında &6Golden Apples&r ile birleştirin."]
	quest.3371570F189DF994.quest_subtitle: "Kalkanlar Çağırır"
	quest.3371570F189DF994.title: "&6Scepter of Fortification"
	quest.3531B28F14CF72A2.quest_desc: ["&9Twilight Forest&r'daki maceranızda öldürmeniz gereken ilk patron Courtyard içinde bulunabilir.\\n\\n&2Naga&r, birden fazla parçadan oluşan yeşil bir yılandır, ona hasar verdikçe parçaları kaybolacaktır.\\n\\n&2Naga&r'yı öldürmek güzel eşyalar düşürecek ve bir sonraki patron olan Lich'in evine girmenizi sağlayacaktır."]
	quest.3531B28F14CF72A2.title: "&2Pulları Eşitlemek"
	quest.38ADDF7FF4E4892D.quest_desc: ["&7Glass Sword&r 40 kalp hasar verir, ancak sadece 1 dayanıklılığa sahiptir.\\n\\nKullanmak istersen onu kırılmaz yapabilirsin.\\n\\nBunlar nadiren &bAurora Palace&r'daki ganimet sandıklarında bulunur."]
	quest.38ADDF7FF4E4892D.title: "&7Glass Sword"
	quest.3908F7C80154D9CA.quest_desc: ["&2Zombie Scepter&r var, çünkü kim kendi &2Zombies&r'lerini çağırmak istemez ki?\\n\\nŞarj etmek için, üretim ızgarasında &cRotten Flesh&r ile birleştirin."]
	quest.3908F7C80154D9CA.quest_subtitle: "Zombies Çağırır"
	quest.3908F7C80154D9CA.title: "&2Zombie Scepter"
	quest.3A3ED88027331A6C.quest_desc: ["&eCharm of Keeping III&r diğer Charms of Keeping gibi çalışır, ancak envanterinizdeki tüm eşyaları kaybetmenizi engeller."]
	quest.3A3ED88027331A6C.title: "&eCharm of Keeping III"
	quest.3C8724C3A9459507.quest_desc: ["Yeti Armor, Alpha Yeti Fur ile üretilebilir."]
	quest.3C8724C3A9459507.title: "Yeti Armor"
	quest.3D29EF7F150F5334.quest_desc: ["&3Ender Bow&r nadiren &bAurora Palace&r'da bulunur.\\n\\nBir düşman bu yaydan çıkan bir okla vurulduğunda, onunla yer değiştirirsiniz. Gökyüzündeki şeylere ateş ederken dikkatli olun!"]
	quest.3D29EF7F150F5334.title: "&3Ender Bow"
	quest.3DCF26B53AE1EBF6.quest_desc: ["&2Dark Forest&r içinde yeraltına giden bir yapı bulacaksınız.\\n\\nGirmek için, elde ettiğiniz boss kupalarından birini yakındaki kaideye yerleştirmeniz gerekecek, hangisini yerleştirdiğiniz konusunda endişelenmeyin, onu geri alabilirsiniz.\\n\\n3. katmanda Knight Phantoms'u bulacaksınız. Bir sonraki patronun kilidini açmak için bunları yenin."]
	quest.3DCF26B53AE1EBF6.quest_subtitle: "Ormanların En Karanlığı"
	quest.3DCF26B53AE1EBF6.title: "&2The Dark Forest"
	quest.40258842B0359A2D.quest_desc: ["&6Ironwood Armor&r, &6Ironwood&r kullanılarak üretilebilir ve otomatik olarak efsunlu gelir."]
	quest.40258842B0359A2D.title: "&6Ironwood Armor"
	quest.4193303999597249.quest_desc: [
		"&9Twilight Forest&r, oyuna Twilight Forest boyutunu ekleyen bir moddur. Bu boyut yepyeni eşyalar, biyomlar, yaratıklar ve patronlarla doludur!\\n\\n&9Twilight Forest&r'a gitmek için portalı oluşturmak adına yere 2x2'lik bir çukur açın ve içini suyla doldurun. Çukurun kenarlarını çiçeklerle çevreleyin ve suya bir Diamond atın.\\n\\nBunu doğru yaptığınızı varsayarsak, Thor size bir işaret verecek ve portal aktif hale gelecektir.\\n"
		"{image:atm:textures/questpics/gettingstarted/twilight_portal.png width:100 height:100 align:center fit:true}"
	]
	quest.4193303999597249.quest_subtitle: "Twilight Forest'a Girin"
	quest.4193303999597249.title: "&9Twilight Forest&r'a Hoş Geldiniz!"
	quest.420158B1736A1354.quest_desc: ["...henüz uygulanmadı.\\n\\nBunun yerine, Final Plateau'daki dev kaleye gidin ve biraz kapı bloğu alın!\\n\\n\"Yer tutucu\" olarak ortaya çıkan bir Kobold var, ancak onu öldürmekten hiçbir şey elde edemeyeceksiniz."]
	quest.420158B1736A1354.title: "&cFinal Boss"
	quest.4665E6FD0AAED164.quest_desc: ["&fCharm of Keeping II&r, &6Charm of Keeping I&r ile aynı şekilde çalışır ancak öldüğünüzde hotbar'ınızdaki eşyaları kaybetmenizi de engeller."]
	quest.4665E6FD0AAED164.title: "&fCharm of Keeping II"
	quest.49EE6D2A3684A510.quest_desc: ["&bIce bow&r rastgele ganimet sandıklarında bulunabilir, vurulduğunda 10 saniyeliğine Slowness III uygular."]
	quest.49EE6D2A3684A510.title: "&bIce Bow"
	quest.4B95D48D7525FFAD.quest_desc: ["&2Swamps&r'a gitme zamanı! &2Swamps&r'da, tepesinde bir giriş olan tuhaf görünümlü bir tepe bulacaksınız. Bu &cMinoshroom Labyrinth&r!\\n\\nİçeride, &eMaze Map Focus&r düşürebilecek birkaç yeni düşmanla savaşacaksınız. Bu, bir &eMaze Map&r yapmak için gereklidir.\\n\\nBu, &cMinoshroom Labyrinth&r etrafında yolunuzu çizecek özel bir haritadır. Mini haritaların burada hiçbir gücü yoktur.\\n\\nAyrıca Labirent için özel ganimetler içeren birkaç ganimet odası bulabilirsiniz!"]
	quest.4B95D48D7525FFAD.quest_subtitle: "Shrek Nerede?"
	quest.4B95D48D7525FFAD.title: "&2Bataklıklara Doğru!"
	quest.4D4AB60B3B1CD437.quest_desc: ["&2Naga&r'nın pullarından biraz zırh üretebilirsiniz.\\n\\nZırh çok güçlü değildir, ancak güzel görünür."]
	quest.4D4AB60B3B1CD437.title: "&2Naga Scale Armor"
	quest.4DA0725E089D7C91.quest_desc: ["&cQ&6u&ee&2s&3t&9i&5n&cg &6R&ea&2m&r'i bulun, çünkü o kendisine &cR&6a&ei&2n&3b&9o&5w &6W&eo&2o&3l&r (16 renk) verenlere zenginlik bahşeder.\\n\\nİpucu: Ram'in bulunduğu harabelerde başınızın üstünde bir Dispenser var. Faydalı olabilir."]
	quest.4DA0725E089D7C91.quest_subtitle: "Görevler?"
	quest.4DA0725E089D7C91.title: "&cR&6a&em&2i&3f&9i&5c&ca&6t&ei&2o&3n"
	quest.4F66DF6B494BEFF3.quest_desc: ["Bir &8Raven Feather&r'ı &eTorchberries&r ve &6Glowstone&r ile birleştirmek size bir &eMagic Map Focus&r verecektir."]
	quest.4F66DF6B494BEFF3.title: "&eMagic Map Focus"
	quest.51BC981AB4CFAD95.quest_desc: ["Mazebreaker, Labirentlerde nadiren bulunan özel bir kazmadır.\\n\\nBu kazma, Maze Walls kırılırken diğer tüm kazmalar için olan 16 hasar yerine sadece 1 hasar alacaktır!"]
	quest.51BC981AB4CFAD95.quest_subtitle: "Tuzaklı Oda, girmeyin?"
	quest.53A79338994088FD.quest_desc: ["&dTri-Bow&r, &3Snow Queen&r'den düşer, sadece 1 ok kullanırken aynı anda 3 ok atabilir."]
	quest.53A79338994088FD.quest_subtitle: "Bir Lynel'den mi?"
	quest.53A79338994088FD.title: "&dTri-Bow"
	quest.575E405B270BBCBC.quest_desc: ["&9Twilight Forest&r içinde, keşfedilecek bir sürü yeni yaratık var.\\n\\nBu yaratıkların en kötülerinden biri Cicada'dır. Bunun için bunu öldürmeni öneririm, ancak herhangi bir Twilight Forest yaratığını öldürmek işe yarayacaktır."]
	quest.575E405B270BBCBC.title: "Ormanın Sessizliği"
	quest.57940981E8DE55D4.quest_desc: ["&9Twilight Forest&r içinde kaybolmak kolaydır. Seyahatlerinizde, &5Obsidian Pillars&r ile karşılaşacaksınız.\\n\\nBu sütunların etrafında &8Ravens&r olacaktır. Onları öldürün, tüylerini düşüreceklerdir ve bunları &9Twilight Forest&r için bir harita oluşturmak adına kullanabilirsiniz!"]
	quest.57940981E8DE55D4.title: "&8Raven Feathers"
	quest.58BD1063A19777DC.quest_desc: ["&2Highland&r biyomunun kilidini açtığınızda, oraya gidin ve öldürmek için birkaç Trolls bulun.\\n\\nBiraz &9Magic Beans&r düşürebilirler. Ayrıca Magi Beans yetiştirmek için gereken Uberus Soil veren sandıklar da bulacaksınız."]
	quest.58BD1063A19777DC.quest_subtitle: "Jack Nerede?"
	quest.58BD1063A19777DC.title: "Devleri Ziyaret Etmek"
	quest.5CBA8C89FE717B9C.quest_desc: ["Bir &8Giant's Pickaxe&r ile, &5Giant Obsidian&r bulmak için Troll Mağaralarına geri dönmek isteyeceksiniz.\\n\\nOnu kırmak için &8Giant's Pickaxe&r'ı kullanın, ve biraz ganimet bulacaksınız. Devam etmek için &6Lamp of Cinders&r'ı elde edin."]
	quest.5CBA8C89FE717B9C.title: "&6Lamp of Cinders"
	quest.5FE4DAE8F41B1437.quest_desc: ["&cOre Magnet&r, Coal hariç adında Ore geçen her şeyi çekebilir.\\n\\nBu, &2Hollow Hill&r sandıklarında bulunabilir."]
	quest.5FE4DAE8F41B1437.title: "&cOre Magnet"
	quest.604F2B68B27885BF.quest_desc: ["&9Twilight Forest&r'dan yapabileceğiniz çok farklı yiyecekler var!\\n\\nHepsini deneyin!"]
	quest.604F2B68B27885BF.title: "Süslü Yemekler"
	quest.607D592CE102C82E.title: "Knightmetal Tools"
	quest.60FC2DAEA954A849.quest_desc: ["&6Moonworm Queen&r tıpkı bir meşale fırlatıcı gibidir. Hedeflenen bloğa, bloğu tıpkı bir meşale gibi aydınlatan &eMoonworms&r fırlatır.\\n\\nBunlar bazı &2Hollow Hill&r ve &eLich Tower&r ganimet sandıklarında bulunabilir."]
	quest.60FC2DAEA954A849.title: "&6Moonworm Queen"
	quest.610F9E9D0B5131C7.quest_desc: ["&6Charm of Keeping I&r, öldüğünüzde ana elinizdeki ve diğer elinizdeki eşyaları ve giydiğiniz herhangi bir zırhı kaybetmenizi önleyecektir."]
	quest.610F9E9D0B5131C7.title: "&6Charm of Keeping I"
	quest.688C911ECFB2F134.quest_desc: ["&2Dark Forest&r içinde, &8Dark Tower&r'ı bulacaksınız.\\n\\nGirmek için tabanda yeniden beliren blokları arayın. &cUr-Ghast&r ile savaşmak için labirentin içinden en son kata kadar yolunuzu bulun.\\n\\n&cUr-Ghast&r'ı menzilli bir silahla öldürmeniz önerilir. Boss katında bulunan, &cUr-Ghast&r'a hasar vermek için kullanılabilecek 4 Ghast tuzağı vardır.\\n\\nBunlar &cGhastling&r öldürmeleriyle yüklenir, ardından Redstone ile etkinleştirilir. Bunları kullanmak zorunda değilsiniz, ancak faydalı olabilirler."]
	quest.688C911ECFB2F134.quest_subtitle: "Karanlık Carmonite Kulesi"
	quest.688C911ECFB2F134.title: "&cAteşin Gözyaşları"
	quest.6CB1BFBA10DF24E4.quest_desc: ["&cScepter of Life Draining&r'ı kullanarak düşmanlarınızın canını emebilirsiniz!\\n\\nAsayı şarj etmek için üretim ızgarasında &cFermented Spider Eyes&r ile birleştirin."]
	quest.6CB1BFBA10DF24E4.quest_subtitle: "Can Emer"
	quest.6CB1BFBA10DF24E4.title: "&cScepter of Life Draining"
	quest.6F67079A453DAABE.quest_desc: ["&cCharm of Life I&r, ölümü önleyecek tek kullanımlık bir eşyadır. Ölmek yerine, tılsım tüketilecek ve size kısa bir süreliğine can yenilenmesi verilecektir.\\n\\nBunlar ganimet sandıklarında bulunabilir."]
	quest.6F67079A453DAABE.title: "&cCharm of Life I"
	quest.6FD41DF7704466A4.quest_desc: ["Alpha Yeti'yi yenmek &9Glacier&r biyomunun kilidini açar. Burada sevimli küçük Penguins ve &3Snow Queen&r'i bulacaksınız.\\n\\n&bAurora Palace&r'ın tepesinde, &3Snow Queen&r kendini korumak için Buz kristalleri çağıracaktır.\\n\\nAyrıca zemini yok edebilecek ve büyük hasar verebilecek &3Ice&r çarpacaktır.\\n\\n&3Ice&r tarafından korunduğu için, sadece üst yarısına vurabileceksiniz.\\n\\n&3Snow Queen&r'i yendikten sonra, &2Highlands&r erişiminin kilidini açacaksınız."]
	quest.6FD41DF7704466A4.title: "&bAçık Gökyüzü"
	quest.7026E46FD8B3A81D.quest_desc: ["&9Hydra&r, Yunan Mitolojisindeki meşhur çok başlı canavardır.\\n\\nMenzilli saldırılar o kadar etkili değildir, bu da yaklaşıp kişisel dövüşmeniz gerektiği anlamına gelir.\\n\\nYenildiğinde, bir sonraki patronu &2Dark Forest&r'da bulabileceksiniz."]
	quest.7026E46FD8B3A81D.quest_subtitle: "Ateşli Bataklık"
	quest.7026E46FD8B3A81D.title: "&9Hydra Avcısı"
	quest.730AF9210F00018E.quest_desc: ["&bDiamond Minotaur Axe&r, &cMinoshroom&r tarafından düşürülür. Kullanıcı depar atarken daha fazla hasar verir."]
	quest.730AF9210F00018E.title: "&bMinotaur Axe"
	quest.7509E4093010EA4C.quest_desc: ["&aSeeker Bow&r, &3Snow Queen&r'den düşer, hedeflerinize güdümlü giden Oklar atabilir. Artık ıskalamak yok!"]
	quest.7509E4093010EA4C.quest_subtitle: "Kötü Nişan?"
	quest.7509E4093010EA4C.title: "&aSeeker Bow"
	quest.78CE2ECEF0B651DA.quest_desc: ["&bAurora Palace&r'da bulunan &3Ice Sword&r, hasar verdiğinde düşmanlara 10 saniyeliğine &bFrosted&r verecektir."]
	quest.78CE2ECEF0B651DA.title: "&3Ice Sword"
	quest.7B4A687EB505C2FF.quest_desc: ["&cCarminite Builders&r, bir Redstone sinyaliyle güçlendirildiğinde, sinyalin geldiği yönde geçici bloklar oluşturacaktır.\\n\\n&cCarminite Reactor&r, yakındaki Obsidian ve Netherack'ı &eFalse Gold&r ve &3False Diamond&r'a dönüştürecektir. Kısa bir süre sonra bu, etrafındaki blokları içine çekecek ve patlayarak etrafında &cCarminite Ghastlings&r oluşturacaktır."]
	quest.7B4A687EB505C2FF.title: "&cCarmanite Builders \\& Reactors"
}
