{
	chapter.007B547630FF0478.title: "Theurgy"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.02593CD4B4AE814C.quest_desc: [
		"&bSalt&r, &eAlchemical Sulfurs&r'ı Incubate Etmek için önemlidir! \\n\\n&bSalt&r elde etmek için bazı Eşyaları pişirmemiz gerekecek. Yine de farklı Eşyalar farklı &bSalts&r yapar. &bSalts&r'ın farklı Aşama'ları vardır ve ne kadar nadirlerse o kadar yükselirler. \\n\\n&bSalt&r'ı pişirip çıkarmak için Eşyaları Oven'a koymamız ve onu Isıtmak için bir Isı kaynağı kullanmamız gerekir. Ardından &bSalt&r'ı Oven'dan çıkarın!"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "Tuzdan Arındırma Tesisi"
	quest.0460DDEEFDEB0AAF.quest_desc: ["Divination Rods, belirli Eşyaları bulmak üzere ruhlarla iletişim kurmak için kullandığımız Aletlerimizdir. \\n\\nİlk olarak, Rod ile Eğilip Sağ Tıklayarak veya Rod'u &eAlchemical Sulfur&r ile üreterek Bloğu veya Eşyayı seçmeniz gerekecektir!\\n\\nOnları tutarak ve Sağ Tıklamaya basılı tutarak Rod seçili bir Eşyayı arayacaktır. Bir ses çıkaracak ve Rod, Bloğun veya Eşyanın ne kadar yakında olduğuna göre yanacaktır. \\n\\nYeterince yakınsa, Eşyanın yolunu gösteren bir küre belirebilir."]
	quest.0460DDEEFDEB0AAF.title: "Divination Rods"
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r, Simya için Sihri kullanma sanatıdır! Veya bizim açımızdan daha fazla veya farklı Eşyalar yapmak için Makineler ve Eşyalar kullanmaktır! \\n\\n&l&6Theurgy&r için ihtiyaç duyduğumuz Makinelerin çoğu Copper'a ihtiyaç duyar, bu yüzden oradan başlayın!"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"Tıpkı bir Termometre gibi bunlar &cMercury&r tutar! \\n\\nİster &cMercury Crystals&r ister &cShards&r, &cMercury&r tutar."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&cMercury&r Vessel"
	quest.0830195863384CF0.quest_desc: ["&bStrata&r, Stone, Sand veya Obsidian gibi normal bloklardan üretilen ilk ve en temel olandır. \\n\\n&bMineral Salt&r üretmek için 5 adet &bStrata Salt&r kullanabilirsiniz."]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.0854AD352218E1C3.quest_desc: ["Tüm bu güce sahip olup da Isıtma olmamasından nefret etmiyor musunuz? \\n\\nArtık bunu Caloric Flux Emitter ile değiştirebilirsiniz! Bir Makineye bağlamak için onunla Eğilip Sağ Tıklayın. Ardından onu yere koyun ve Isı göndermek için güç verin. \\n\\nBirden fazla Makineye ayarlanamaz!"]
	quest.0854AD352218E1C3.quest_subtitle: "Nasıl?"
	quest.0854AD352218E1C3.title: "Kablosuz Isı"
	quest.0EADCEA9AB001FC7.quest_desc: [
		"Çok basit bir Isı Kaynağı. Makinenin altına yerleştirin ve ona Furnace Fuel verin: Coal, Logs, Dried Kelp Blocks."
		"{image:atm:textures/questpics/theurgy/theurgy_brazier.png width:100 height:100 align:center}"
	]
	quest.0EADCEA9AB001FC7.title: "Furnace Gibi Isı"
	quest.0F7BB4ECCA5C082C.quest_desc: [
		"Burası &eAlchemical Sulfur&r'ı içine koyacağınız yerdir. \\n\\n&eAlchemical Sulfur&r içindeki Eşya ne ise, Incubation işleminden sonra tekrar o Eşyaya dönüştürülecektir!"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_3.png width:100 height:125 align:center}"
	]
	quest.0F7BB4ECCA5C082C.title: "&eSulfur&r Vessel"
	quest.161E7D934A21F849.quest_desc: [
		"Reformation, bir &eAlchemical Sulfur&r'ı bir diğerine dönüştürmek veya daha fazlasına dönüşmek için &3Alchemical Niter&r kullanmaktır! \\n\\nİlk adım Source Pedestal'dır, burası başka bir tanesine dönüştürülmesini istediğiniz &eSulfur&r'ı koyduğunuz yerdir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_1.png width:100 height:100 align:center}"
	]
	quest.161E7D934A21F849.title: "1. Adım: Source Pedestal"
	quest.16B88F46021E956D.quest_desc: ["&l&6Theurgy&r Makineleri vardır, bu yüzden elbette Lojistiğe de ihtiyacı vardır!\\n\\n(Lojistik hakkında daha fazla bilgi edinmek için Basic Logistics Sayfasına göz atın).\\n\\n&cMercury&r ile &cMercury Wires&r ve diğer Eşyaları kullanarak Eşyaları ve Sıvıları bir yerden başka bir yere taşıyabilirsiniz! Eşyaları gerçekten hareket ettirecek olan şey Tellerdir."]
	quest.16B88F46021E956D.title: "&cMercury&r ile Lojistik"
	quest.19A2016B54C6FA34.quest_desc: ["&l&6Theurgy&r'deki bazı Makinelerin çalışmaya başlaması için Isıya ihtiyacı vardır! Ancak &l&6Theurgy&r Makinelerinin Isıyı nasıl elde ettiği konusunda çok kıskançtır, Isı kaynağı olarak yalnızca bu iki Makineyi kullanabilirsiniz. \\n\\n(Isı kullanan Makineler şunlardır: Liquefaction Cauldron, Calcination Oven, &cMercury&r Distiller ve Incubator.)"]
	quest.19A2016B54C6FA34.quest_subtitle: "Dostum çok Sıcaksın!"
	quest.19A2016B54C6FA34.title: "Dostum çok Sıcaksın!"
	quest.1A46A97A00A31C03.quest_desc: [
		"İkinci adım Target Pedestal'dır. Burası, ilk olanın dönüştürülmesini istediğiniz &eSulfur&r'ı koyduğunuz yerdir. \\n\\nVeya &3Alchemical Niter&r'ı koyduğunuz yerdir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_2.png width:100 height:100 align:center}"
	]
	quest.1A46A97A00A31C03.title: "2. Adım: Target Pedestal"
	quest.1C829609915E0012.quest_desc: [
		"İçeri &cMercury&r koyun, \\nDışarı Güç alın. \\n\\nMF, Metal Face veya birine hitap etmek için kaba bir ifade değil, &cMercury&r Flux anlamına gelir!"
		"{image:atm:textures/questpics/theurgy/theurgy_mercuryflux.png width:100 height:100 align:center}"
	]
	quest.1C829609915E0012.title: "&cMercury &aİle Güç Üretmek"
	quest.20C3AADEE2D4800D.quest_desc: [
		"Sıvıları bir Tanktan diğerine &cMercury&r ile de taşıyabilirsiniz. \\n\\nSıvının alınmasını istediğiniz yere, örneğin bir Sink'e Fluid Extrator takın. Ardından Fluid Inserter'ı Sıvının gitmesini istediğiniz yere, örneğin bir &dSal Ammoniac&r Accumulator'a yerleştirin. İkisini de Wires ile birbirine bağlayın, böylece hareket etmeye başlayacaktır!"
		"{image:atm:textures/questpics/theurgy/theurgy_fluid.png width:200 height:75 align:center}"
	]
	quest.20C3AADEE2D4800D.title: "Sıvı Hareketi"
	quest.26B462F2F41A77C7.quest_desc: ["Doğa Ana'nın tüm armağanları... bir Oven'da acımasızca yakılıp geriye sadece &bSalt&r kalabilir! \\n\\nLogs, Leaves ve Crops, kızartılıp &bPlant Salts&r'a dönüştürülebilir."]
	quest.26B462F2F41A77C7.title: "&bPlant Salt"
	quest.285B3FB38B12F8CA.quest_desc: [
		"&dSal Ammoniac&r yapmak için bu iki Bloğa ihtiyacımız olacak (buna Multi-block demek geldi içimden ama 2 Bloğun Multi-Block olduğunu düşünmüyorum). Altta bir &dSal Ammoniac&r Tank, üzerinde ise bir &dSal Ammoniac Accumulator&r. \\n\\n&dSal Ammoniac Accumulator&r, &9Water&r ve &dCrystals&r'ın gideceği yerdir; 10.000mB &9Water&r veya 10 Buckets ile bir yığın &dSal Ammoniac Crystals&r tutabilir. Tank ise üretilen &dSal Ammoniac&r'ı tutacak ve 2.000mB veya 2 Buckets tutabilecektir."
		"{image:atm:textures/questpics/theurgy/theurgy_sal_front.png width:100 height:200 align:center}"
	]
	quest.285B3FB38B12F8CA.title: "&dSal Ammoniac &aYapımı"
	quest.2B29E9AB9447E1C6.quest_desc: [
		"İşte bu bir Multiblock Makinesi! \\n\\nEşyaları &eAlchemical Sulfur&r'dan geri almak için onları Incubate Etmemiz gerekecek. Bu, Incubator'ın 3 Vessels'ın tamamının ona bitişik olmasını gerektirir. Alt yarıya temas ettikleri sürece sıranın bir önemi yoktur. \\n\\nVessels içindeki tüm Eşyalara ve Isıya sahip olduğunda Eşyalarınızı Incubate Etmeye başlayacaktır! İçinden Duman parçacıkları çıktığında çalıştığını anlayacaksınız."
		"{image:atm:textures/questpics/theurgy/theurgy_incubator.png width:200 height:200 align:center}"
	]
	quest.2F0D6267569F740B.quest_desc: ["Common Materials, Abundant'tan bir basamak daha yüksek ve nadirdir. Bunlar çoğunlukla Ingots ve Ender Pearls veya Rabbit Hide gibi daha nadir Mob Drops'lardır. \\n\\nYine listenin tamamını Tags bölümünde görebilirsiniz."]
	quest.36926B5EBFF6E55A.quest_desc: [
		"&cMercury&r, &l&6Theurgy&r için en önemli malzemelerden biridir! \\n\\nBunu elde etmek için &cMercury&r Distiller'da biraz damıtmamız gerekecek. Distiller'a Eşyaları koyun ve ona biraz Isı verin! \\n\\n1 &cMercury&r için 10 Stone gereken Stone'a kıyasla, 1 Diamond için 10 &cMercury&r verecek Diamonds gibi bazı Eşyalar daha fazla &cMercury&r verir."
		"{image:atm:textures/questpics/theurgy/theurgy_distiller.png width:100 height:150 align:center}"
	]
	quest.36926B5EBFF6E55A.title: "&cMercury &aYapımı"
	quest.393DA9C9D808A851.quest_desc: ["&l&6Theurgy&r'nin Wrench'i &cMercurial&r Wand'dir. Modlarını değiştirmek için Eğilip Kaydırabilirsiniz. \\n\\nTellerin aktarım yapmasını durdurmak için Etkinleştirebilirsiniz/Devre Dışı Bırakabilirsiniz. \\n\\nEşyaların Nereden Çıkarılacağı veya Nereye Ekleneceği tarafını değiştirebilirsiniz. \\n\\nVe Frekans Kanalını değiştirebilirsiniz!"]
	quest.393DA9C9D808A851.quest_subtitle: "Bunun bir sihir modu olduğunu sanıyordum..."
	quest.393DA9C9D808A851.title: "Elbette Bir Wrench Var"
	quest.3B6F723B03C4BF55.quest_desc: ["Digestion (işlemenin çok kaba hali), &3Alchemical Niters&r'ı farklı biçimlere dönüştürmemizin yoludur. \\n\\nİlk olarak, Gold, &bAlchemical Salt&r ve &9Water&r'ı Digestion Vat'e koyarak yapılan ve tıpkı Fermentation Vat gibi Eğilip Sağ Tıklayarak kapatılabilen Purified Gold'a ihtiyacımız olacak. \\n\\nArdından, daha yüksek bir Aşama elde etmek için bir &3Alchemical Niter&r'dan 4 tanesini Purified Gold ve &dSal Ammoniac&r ile birleştirebilir veya daha düşük bir Aşama elde etmek için tam tersini yapabiliriz."]
	quest.3B6F723B03C4BF55.title: "Digestion Vat"
	quest.3C5734448FEC128B.quest_desc: ["En ucuz Divination Rod, yani Glass Divination Rod. \\n\\nBir Stone Pickaxe'in kazabileceği tüm Cevherleri bulabilir. Yani Copper, Coal ve Iron. Daha yükseğini değil."]
	quest.3EB63AF53E70C931.quest_desc: [
		"Reformation'ın çalışması için Mercury Flux gerekir! Bunları ayarlamak için Sulfuric Flux Emitter ile 3 Pedestals'ın tümüne Eğilip Sağ Tıklamanız gerekecektir. Ardından Emitter'ı yerleştirin ve ona güç verin.\\n\\nBundan sonra Reform yapmaya hazır olmalı!"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_setup.png width:200 height:50 align:center}"
	]
	quest.3EB63AF53E70C931.title: "4. Adım: Ona Güç Vermek"
	quest.41ABC09C798CA8BE.quest_desc: ["Bu Görev &6AllTheMods Ekibi&r veya AllTheMods Mod Paketlerinde kullanılması için &2Topluluk katılımcısı&r tarafından yazılmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına sahip olduğundan, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir açık pakette açık izin olmadan kullanılmasına izin verilmez.\\n\\nBu görev kasıtlı olarak gizlenmiştir, bunu görüyorsanız düzenleme modundasınız demektir."]
	quest.457CAE66B0FA4CCF.quest_desc: ["Tüm &2Vanilla&r Cevherleri Diamond Divination Rod ile bulunabilir. Netherite da dahil olmak üzere hepsini bulabilir!"]
	quest.45996B848792379E.quest_desc: ["&2Overworld&r'de &dSal Ammoniac Crystals&r kazabilirsiniz ancak bu o kadar kolay değildir. &eAlchemical Sulfur&r yapmak üzere &dSal Ammoniac&r elde etmek için hala &9Water&r'a ve Makinelere ihtiyacımız olacak. \\n\\n&dCrystals&r isteğe bağlıdır ancak çok yardımcı olur; sadece Water ile 1000mB, 100mB &dSal Ammoniac&r'a dönüştürülecektir. 1000mB &9Water&r ve bir &dSal Ammoniac Crystal&r ile bunun yerine 1000mB &dSal Ammoniac&r elde edeceğiz. \\n\\nSadece tek bir Eşya fazlasıyla 10 kat daha fazla üretim!"]
	quest.45996B848792379E.quest_subtitle: "Eğer onu sadece Kazabiliyorsak neden Makinelere ihtiyacımız var?"
	quest.45996B848792379E.title: "Neden Makineler?"
	quest.48EE6C807C1668D4.quest_desc: ["Wires'ın daha uzağa gitmesi veya daha fazla yere bağlanması gerekiyorsa, bir Connector Node'a ihtiyacınız olabilir. \\n\\nBu kadar basit!"]
	quest.48EE6C807C1668D4.title: "Teller Buraya Gider, Teller Şuraya Gider"
	quest.49D1B01E07ABA471.quest_desc: [
		"Eşyaları &cMercury&r kullanarak aktarabilirsiniz. \\nEşyaların alınmasını istediğiniz yere bir Item Extrator bağlayın. Ardından Item Inserter'ı Eşyaların gitmesini istediğiniz yere bağlayın. Her ikisini de &cMercury Wires&r ile bağlayın, Eşyalar hareket etmeye başlayacaktır! \\n\\nBu, otomasyon için &l&6Theurgy&r Makinelerinde kullanılabilir!"
		"{image:atm:textures/questpics/theurgy/theurgy_item.png width:200 height:75 align:center}"
	]
	quest.49D1B01E07ABA471.title: "Eşya Hareketi"
	quest.4EE482B9D61B5933.quest_desc: ["Elbette &2Vanilla&r bizim zirvemiz değil, Modlu olanda çok daha fazlası ve çok daha nadirleri var! "]
	quest.54F0C5C48CFC94D0.quest_desc: ["Lojistik ile Filtering'e ihtiyacımız var. List ve Attribute olmak üzere iki farklı Filtre vardır. \\nList Filter'da içine Eşyalar eklersiniz ve bunun beyaz liste mi yoksa kara liste mi olduğunu ve NBT Verilerine saygı duyup duymadığını değiştirirsiniz. \\n\\nAttribute Filter, bir referans Eşya alır, ardından seçili bir Özelliğe göre Filtreler. Buna etiketler ve Furnace Fuel olarak kullanılıp kullanılamayacağı veya aktarılıp aktarılamayacağı gibi diğer şeyler de dahildir!"]
	quest.55E321EFBE8956DE.quest_desc: ["Fermenting Tarifleri konusunda ucuza kaçmak istiyorsanız Fermentation Starter tam size göre. \\n\\nFermenting işlemindeki diğer Eşyalar için çok ucuz bir yedektir."]
	quest.55E321EFBE8956DE.title: "Daha Kolay Fermenting"
	quest.5844DD2BEE5EC3DC.quest_desc: ["Onu yemeyin! \\n\\n&cMercury&r 3 farklı şey için kullanılabilir: Incubation, Power Creation ve Lojistik!"]
	quest.5844DD2BEE5EC3DC.quest_subtitle: "Venüs... hayır &cMercury&r!"
	quest.5844DD2BEE5EC3DC.title: "Mercury"
	quest.616364E6AE05C341.quest_desc: ["&bMineral Salts&r, tahmin edeceğiniz üzere Minerals'dan yapılır. \\n\\nBir tür Cevher olarak Kazılan her şey &bSalt&r'a dönüştürülebilir. Raw Ores, Ingots, Gems, hepsi &bMineral Salt&r olur! \\n\\nUnobtainium bile &bSalt&r'a dönüştürülebilir! Lütfen yapmayın, çok daha iyi alternatifler var."]
	quest.616364E6AE05C341.title: "&bMineral Salt"
	quest.61DA3D61D7103647.quest_desc: ["&eAlchemical Sulfurs&r hemen hemen her şeyden yapılabilir ve hemen hemen her şeye dönüştürülebilir! \\n\\n&eAlchemical Sulfurs&r'da başka bir Görevde daha fazla açıklanabilecek birkaç farklı Eşya grubu vardır. \\n\\n&eAlchemical Sulfurs&r'ı işlemekle ilgili izleyebileceğiniz 3 farklı yol vardır. 1. Niter yapmak için Fermentation ve Digestion. 2. O Eşyaları tekrar yapmak için Incubation ve 3. Reformation ile Eşyayı değiştirmek."]
	quest.61DA3D61D7103647.title: "&eAlchemical Sulfurs"
	quest.6A8E748B642DD16F.quest_desc: [
		"Burası &bSalt&r'ın tutulacağı yerdir. \\n\\n&bSalt&r türü, neyi Incubate Etmeye çalışacağınız açısından önemlidir. Unobtainium yapmak istiyorsanız &bMineral Salt&r'a, Wheat istiyorsanız &bPlant Salt&r'a vb. ihtiyacınız olacaktır."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_2.png width:100 height:125 align:center}"
	]
	quest.6A8E748B642DD16F.title: "&bSalt&r Vessel"
	quest.6C6F4EB5CBE2FBC2.quest_desc: ["Iron Divination Rod, bir Iron Pickaxe'in kazabileceği Cevherleri bulabildiği için bir tık daha yüksektir! Yani Diamonds, Redstone ve Gold."]
	quest.6CAD27627A3F8FD7.quest_desc: [
		"Şimdi Mod'un en önemli kısmına, &eAlchemical Sulfurs&r'a geliyoruz! \\n\\nBunları yapmak için bir Liquefaction Cauldron, bir Eşya, &dSal Ammoniac&r ve bir Isıtıcıya ihtiyacımız olacak. \\n\\nIsı başka bir Görevde açıklanmıştır ancak Isıtmak için Cauldron'un altında Pyromantic Brazier veya Caloric Flux Emitter'a ihtiyacınız olacaktır. \\n\\nSonra içindeki Sıvı &dSal Ammoniac&r. \\n\\nVe son olarak bir &eAlchemical Sulfur&r'a dönüştürülmesini istediğiniz Eşya. \\n\\nBaloncuklar çıkardığında çalıştığını anlayacaksınız."
		"{image:atm:textures/questpics/theurgy/theurgy_lique.png width:100 height:100 align:center}"
	]
	quest.6CAD27627A3F8FD7.title: "&eAlchemical Sulfur &aYapımı"
	quest.7119F8C352D057BC.quest_desc: ["Şimdi eğlenceli şeylere geliyoruz! Rare eşyalar Elytra'ya bile çıkıyor! Evet, bence Rare'den daha iyiler ama bu sınıflandırmayı ben yapmadım."]
	quest.7198ED7E97A256A4.quest_desc: ["Üretilen ilk özel Divination Rod, Abundant Material Rod'dur! \\n\\nRod'u bir Eşyanın &eAlchemical Sulfur&r'ı ile ürettiğinizde, Rod o Eşyaya ayarlanacaktır. \\n\\nAbundant Materials listesini Tags'de görebilirsiniz, Görevlerde okuyamayacağım kadar büyük.  "]
	quest.72FADEAEE2DA03AF.quest_desc: [
		"Üçüncü adım, yeni değiştirilen &eSulfur&r'ın gideceği Result Pedestal'dır. Bir kez yeniden şekillendirildiğinde buraya gelecektir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "3. Adım: Result Pedestal"
	quest.730F2D3329C4FF88.quest_desc: ["&nFermentation&r: \\nGlikoz gibi moleküllerin anaerobik olarak parçalandığı kimyasal süreç. \\n\\nYani &9Water&r ve zaman olayları değiştirir! \\n\\nFermentation Vat kullanmak için Eşyaları ve Sıvıyı Vat'e koyun ve kapatmak için Eğilip Sağ Tıklayın. \\n\\nBir süre sonra mayalanması gerekir! &eAlchemical Sulfur&r'ı, daha fazla Eşyaya dönüştürülebilen &3Alchemical Niter&r'a bu şekilde dönüştürüyoruz!"]
	quest.730F2D3329C4FF88.title: "Fermentation Vat"
	quest.76F675A898EAB4E8.quest_desc: ["&dSal Ammoniac&r, Eşyaları yapmak ve çoğaltmak için kullanacağımız &eAlchemical Sulfur&r'ın kritik bir parçasıdır. \\n\\n&dSal Ammoniac&r elde etmek için biraz &9Water&r'a ihtiyacımız olacak. "]
	quest.76F675A898EAB4E8.title: "&dSal Ammoniac"
	quest.7878F190BC8ADC82.quest_desc: ["İyinin de iyisi. Diamonds'tan Nether Star'a ve Allthemodium'a kadar. Bu Rod sadece en iyi Eşyaları bulur!"]
	quest.7A1C117CA8FB7C31.quest_desc: ["Bu eşsiz!\\n\\nCevherleri bulmak yerine Budding Amethyst bloklarını bulacak!\\n\\nArtık Geode bulmak için uğraşmanıza gerek yok iyi bayım!"]
	quest.7A271F425C3934CE.quest_desc: ["Şu anda bu yalnızca 2 &bPlant Salts&r'ın 1 &bCreature Salt&r olacak şekilde pişirilmesiyle üretilebilir. \\n\\nUmarım daha yeni güncellemelerde &bSalt&r için daha fazla canlı yaratık öldürebiliriz!"]
