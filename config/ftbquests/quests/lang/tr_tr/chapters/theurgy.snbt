{
	chapter.007B547630FF0478.title: "Theurgy"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.02593CD4B4AE814C.quest_desc: [
		"&eAlchemical Sulfurs&r'ün kuluçkalanması için &bSalt&r çok önemlidir! \\n\\n&bSalt&r elde etmek için çeşitli eşyaları kireçleme fırınında pişirmemiz gerekir. Farklı eşyalar farklı &bSalt&r türleri üretir ve bu tuzlar nadirliklerine göre seviyelere ayrılır. \\n\\n&bSalt&r üretmek için eşyaları fırına koyup altına bir ısı kaynağı yerleştirin. Ardından elde ettiğiniz &bSalt&r'ı fırından alın!"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "Tuzdan Arındırma Tesisi"
	quest.0460DDEEFDEB0AAF.quest_desc: ["Kehanet Asaları, belirli eşyaları bulmak için ruhlarla iletişim kurmamızı sağlayan araçlardır. \n\nİlk olarak, asayla bloğa veya eşyaya Shift + Sağ Tıklayarak ya da asayı onun &eAlchemical Sulfur&r'ü ile üreterek hedefinizi seçmeniz gerekir!\n\nAsayı elinizde tutup Sağ Tıka basılı tuttuğunuzda seçilen eşyayı aramaya başlar. Bloğun veya eşyanın ne kadar yakın olduğuna bağlı olarak ses çıkarır ve asa parlar. \n\nYeterince yakınsanız size eşyaya giden yolu gösteren bir küre belirebilir."]
	quest.0460DDEEFDEB0AAF.title: "Kehanet Asaları"
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r, simya için Büyü kullanma sanatıdır! Ya da bizim anlamımızla, daha fazla veya farklı eşyalar üretmek için Makineleri ve Eşyaları kullanmaktır! \n\n&l&6Theurgy&r için ihtiyacımız olan makinelerin çoğu Bakır gerektirir, bu yüzden oradan başlayın!"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"Bir termometre gibi bunlar da &cMercury&r depolar! \n\nİster &cMercury Crystals&r ister &cShards&r olsun, &cMercury&r depolar."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&cMercury&r Kabı"
	quest.0830195863384CF0.quest_desc: ["&bStrata Salt&r; taş, kum veya obsidyen gibi temel bloklardan pişirilen en başlangıç seviye tuzdur. \\n\\n5 adet &bStrata Salt&r birleştirerek &bMineral Salt&r elde edebilirsiniz."]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.0854AD352218E1C3.quest_desc: ["O kadar güce sahip olup da makineleri sürekli manuel ısıtmaktan bıktınız mı? \\n\\nCaloric Flux Emitter ile bu sorunu çözebilirsiniz! Cihazı makineye bağlamak için önce makineye Shift + sağ tıklayın. Ardından yere yerleştirip enerji vererek ısı aktarımını başlatın. \\n\\nAynı anda yalnızca tek bir makineye bağlanabilir!"]
	quest.0854AD352218E1C3.quest_subtitle: "Nasıl?"
	quest.0854AD352218E1C3.title: "Kablosuz Isı"
	quest.0EADCEA9AB001FC7.quest_desc: [
		"Oldukça basit bir ısı kaynağı. Makinenin altına yerleştirip kömür, odun kütükleri veya kurutulmuş su yosunu blokları gibi standart fırın yakıtlarıyla besleyin."
		"{image:atm:textures/questpics/theurgy/theurgy_brazier.png width:100 height:100 align:center}"
	]
	quest.0EADCEA9AB001FC7.title: "Fırın Benzeri Isı"
	quest.0F7BB4ECCA5C082C.quest_desc: [
		"Kuluçka işleminde kullanılacak &eAlchemical Sulfur&r'ü koyacağınız kaptır. \\n\\nKükürdün temsil ettiği eşya ne ise, kuluçkalama tamamlandığında nihai olarak o eşya elde edilir!"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_3.png width:100 height:125 align:center}"
	]
	quest.0F7BB4ECCA5C082C.title: "&eSulfur&r Kabı"
	quest.161E7D934A21F849.quest_desc: [
		"Yeniden biçimlendirme, bir &eAlchemical Sulfur&r'ü başka bir kükürde dönüştürmek veya miktarını artırmak için &3Alchemical Niter&r kullanma işlemidir! \\n\\nİşlemin ilk adımı Kaynak Kaidesidir (Source Pedestal); dönüştürmek istediğiniz kaynak &eSulfur&r'ü buraya yerleştirirsiniz."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_1.png width:100 height:100 align:center}"
	]
	quest.161E7D934A21F849.title: "1. Adım: Source Pedestal"
	quest.16B88F46021E956D.quest_desc: ["&l&6Theurgy&r makineleriniz varsa, elbette bir lojistik sistemine de ihtiyacınız var!\\n\\n(Lojistik hakkında detaylı bilgi için Temel Lojistik sekmesine göz atın).\\n\\n&cMercury&r gücünü kullanarak &cMercury Wires&r (Cıva Kabloları) ve lojistik parçaları sayesinde eşyaları ve sıvıları taşıyabilirsiniz. Eşya ve sıvı akışını sağlayan asıl unsur bu kablolardır."]
	quest.16B88F46021E956D.title: "&cMercury&r Lojistiği"
	quest.19A2016B54C6FA34.quest_desc: ["&l&6Theurgy&r modundaki bazı makinelerin çalışmaya başlaması için Isıya ihtiyacı vardır! Ancak &l&6Theurgy&r makinelerinin ısı alımı konusunda oldukça kıskançtır, ısı kaynağı olarak yalnızca bu iki makineyi kullanabilirsiniz. \n\n(Isı kullanan makineler: Liquefaction Cauldron, Calcination Oven, &cMercury&r Distiller ve Incubator.)"]
	quest.19A2016B54C6FA34.quest_subtitle: "Burası Çok Sıcak Oldu!"
	quest.19A2016B54C6FA34.title: "Burası Çok Sıcak Oldu!"
	quest.1A46A97A00A31C03.quest_desc: [
		"İkinci adım Hedef Kaidesidir (Target Pedestal). Kaynak kükürdün dönüşmesini istediğiniz hedef &eSulfur&r'ü buraya koyarsınız. \\n\\nAyrıca işlem için gerekli &3Alchemical Niter&r da buraya yerleştirilir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_2.png width:100 height:100 align:center}"
	]
	quest.1A46A97A00A31C03.title: "2. Adım: Target Pedestal"
	quest.1C829609915E0012.quest_desc: [
		"&cMercury&r koyun, \nEnerji alın. \n\nMF, Metal Face ya da birine sövmek için kullanılan kaba bir tabir değil, &cMercury&r Flux anlamına gelir!"
		"{image:atm:textures/questpics/theurgy/theurgy_mercuryflux.png width:100 height:100 align:center}"
	]
	quest.1C829609915E0012.title: "&cMercury&r ile Enerji Üretimi"
	quest.20C3AADEE2D4800D.quest_desc: [
		"Sıvıları depolardan depolara aktarmak için de &cMercury&r gücünü kullanabilirsiniz. \\n\\nSıvıyı çekmek istediğiniz kaynağa Fluid Extractor (Sıvı Çıkarıcı) bağlayın. Ardından hedef noktaya (&dSal Ammoniac&r Accumulator gibi) Fluid Inserter (Sıvı Yerleştirici) yerleştirin. İki ucu kablolarla birleştirdiğinizde sıvı akışı başlayacaktır!"
		"{image:atm:textures/questpics/theurgy/theurgy_fluid.png width:200 height:75 align:center}"
	]
	quest.20C3AADEE2D4800D.title: "Sıvı Transferi"
	quest.26B462F2F41A77C7.quest_desc: ["Doğa Ana'nın tüm cömertliği... fırında yakılarak geriye yalnızca &bSalt&r kalacak şekilde küllerine ayrıştırılabilir! \\n\\nKütükler, yapraklar ve ekinler yakılarak &bPlant Salt&r (Bitkisel Tuz) elde edilir."]
	quest.26B462F2F41A77C7.title: "&bPlant Salt"
	quest.285B3FB38B12F8CA.quest_desc: [
		"&dSal Ammoniac&r üretmek için bu iki bloğa ihtiyacımız var (buna Çoklu Blok diyesim geldi ama 2 bloğu Çoklu Blok saymıyorum). Alt kısımda bir &dSal Ammoniac&r Tankı ve üstünde bir &dSal Ammoniac Accumulator&r. \n\n&dSal Ammoniac Accumulator&r, &9Water&r ve &dCrystals&r'ın koyulacağı yerdir; 10.000mb &9Water&r (veya 10 Kova) ve bir yığın &dSal Ammoniac Crystals&r tutabilir. Tank ise üretilen &dSal Ammoniac&r'ı tutar ve 2.000mb veya 2 Kova depolayabilir."
		"{image:atm:textures/questpics/theurgy/theurgy_sal_front.png width:100 height:200 align:center}"
	]
	quest.285B3FB38B12F8CA.title: "&dSal Ammoniac&r Üretimi"
	quest.2B29E9AB9447E1C6.quest_desc: [
		"Bakın, gerçek bir çoklu blok yapı tam olarak budur! \\n\\n&eAlchemical Sulfur&r'den eşyaları geri almak için onları kuluçkalamanız (Incubation) gerekir. Bunun için bir Incubator ve ona temas eden 3 adet Vessel (Kap) gereklidir. Alt bloğa temas ettikleri sürece kapların yerleşim sırası önemli değildir. \\n\\nKaplarda gerekli malzemeler yer aldığında ve altından ısı sağlandığında kuluçka işlemine başlar! Üzerinden duman parçacıkları çıktığında makinenin çalıştığını anlayabilirsiniz."
		"{image:atm:textures/questpics/theurgy/theurgy_incubator.png width:200 height:200 align:center}"
	]
	quest.2F0D6267569F740B.quest_desc: ["Yaygın materyaller, Abundant seviyesinden bir tık daha nadirdir. Çoğunlukla külçeler ile Ender incisi veya tavşan postu gibi yaratık ganimetlerini kapsar. \\n\\nTam listeyi etiketler bölümünden inceleyebilirsiniz."]
	quest.36926B5EBFF6E55A.quest_desc: [
		"&cMercury&r, &l&6Theurgy&r için en önemli malzemelerden biridir! \n\nElde etmek için &cMercury&r Distiller'da biraz damıtma yapmamız gerekir. Eşyaları Distiller'a koyun ve biraz Isı verin! \n\nElmas gibi bazı eşyalar daha fazla &cMercury&r verir (1 Elmas için 10 &cMercury&r); 1 &cMercury&r için 10 Taş gereken Taş ile karşılaştırıldığında."
		"{image:atm:textures/questpics/theurgy/theurgy_distiller.png width:100 height:150 align:center}"
	]
	quest.36926B5EBFF6E55A.title: "&cMercury&r Üretimi"
	quest.393DA9C9D808A851.quest_desc: ["&l&6Theurgy&r modunun İngiliz anahtarı &cMercurial Wand&r'dır! Shift tuşuna basılı tutarak fare tekerleğiyle modlar arasında geçiş yapabilirsiniz. \\n\\nKablolardan geçen aktarımı durdurabilir veya başlatabilir,\\n\\nEşyaların çekileceği veya aktarılacağı yüzeyi değiştirebilir,\\n\\nVe frekans kanallarını ayarlayabilirsiniz!"]
	quest.393DA9C9D808A851.quest_subtitle: "Bunun bir büyü modu olduğunu sanıyordum..."
	quest.393DA9C9D808A851.title: "Olmazsa Olmaz İngiliz Anahtarı"
	quest.3B6F723B03C4BF55.quest_desc: ["Sindirim (çok ilkel bir işleme türü), &3Alchemical Niters&r'ı farklı formlara dönüştürme yöntemimizdir. \n\nİlk olarak Altın, &bAlchemical Salt&r ve &9Water&r'ı Digestion Vat'e koyup Fermentation Vat gibi Shift + Sağ Tıklayarak üretebileceğimiz Purified Gold'a ihtiyacımız var. \n\nArdından bir &3Alchemical Niter&r'dan 4 tanesini Purified Gold ve &dSal Ammoniac&r ile birleştirerek daha yüksek bir Seviye elde edebilir veya daha düşük bir Seviye için bunun tersini yapabiliriz."]
	quest.3B6F723B03C4BF55.title: "Digestion Vat"
	quest.3C5734448FEC128B.quest_desc: ["En temel kehanet asası Glass Divination Rod'dur (Cam Kehanet Asası). \\n\\nTaş kazmayla kazılabilen tüm cevherleri tespit edebilir: bakır, kömür ve demir. Daha yüksek seviyeli madenleri bulamaz."]
	quest.3EB63AF53E70C931.quest_desc: [
		"Yeniden biçimlendirme düzeneğinin çalışması için Mercury Flux (Cıva Enerjisi) gerekir! Sulfuric Flux Emitter elinizdeyken 3 kaideye de tek tek Shift + sağ tıklayarak bağlantı kurun. Ardından Emitter'ı yere yerleştirip enerji verin.\\n\\nArtık dönüştürme işlemine başlayabilirsiniz!"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_setup.png width:200 height:50 align:center}"
	]
	quest.3EB63AF53E70C931.title: "4. Adım: Enerji Bağlantısı"
	quest.41ABC09C798CA8BE.quest_desc: ["Bu görev, AllTheMods paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya &2topluluk üyeleri&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansına tabi olduğundan, izinsiz başka halka açık paketlerde kullanılamaz. \\n\\nBu görev gizlidir; görüyorsanız düzenleme modundasınız demektir."]
	quest.457CAE66B0FA4CCF.quest_desc: ["Tüm temel &2Vanilla&r cevherleri Diamond Divination Rod ile bulabilirsiniz. Üstelik Netherite bulma yeteneğine de sahiptir!"]
	quest.45996B848792379E.quest_desc: ["&2Overworld&r'da &dSal Ammoniac Crystals&r kazabilirsiniz ama o kadar kolay değildir. &eAlchemical Sulfur&r üretmek amacıyla &dSal Ammoniac&r yapmak için yine de &9Water&r'a ve Makinelere ihtiyacımız olacak. \n\n&dCrystals&r isteğe bağlıdır ama çok yardımcı olur; sadece Su ile 1000mb su, 100mb &dSal Ammoniac&r'a dönüşür. 1000mb &9Water&r ve bir &dSal Ammoniac Crystal&r ile bunun yerine 1000mb &dSal Ammoniac&r elde ederiz. \n\nSadece tek bir fazla Eşya ile 10 kat daha fazla üretim!"]
	quest.45996B848792379E.quest_subtitle: "Madenini Yapabiliyorsak Makineye Ne Gerek Var?"
	quest.45996B848792379E.title: "Neden Makineler?"
	quest.48EE6C807C1668D4.quest_desc: ["Kabloları daha uzak mesafelere uzatmak veya birden fazla yöne dallandırmak istiyorsanız bir Connector Node (Bağlayıcı Düğüm) kullanabilirsiniz. \\n\\nİşte bu kadar basit!"]
	quest.48EE6C807C1668D4.title: "Kablolar Buraya, Kablolar Şuraya"
	quest.49D1B01E07ABA471.quest_desc: [
		"Eşya transferi için de &cMercury&r gücünden yararlanabilirsiniz. \\nEşyanın alınacağı sandık veya makineye Item Extractor (Eşya Çıkarıcı), hedef yere ise Item Inserter (Eşya Yerleştirici) bağlayın. Ardından iki ucu &cMercury Wires&r (Cıva Kabloları) ile birleştirin; eşyalar akmaya başlayacaktır! \\n\\nBu sistemi &l&6Theurgy&r makinelerinizi otomatikleştirmek için kullanabilirsiniz!"
		"{image:atm:textures/questpics/theurgy/theurgy_item.png width:200 height:75 align:center}"
	]
	quest.49D1B01E07ABA471.title: "Eşya Transferi"
	quest.4EE482B9D61B5933.quest_desc: ["Elbette &2Vanilla&r sınırımız değil, Modlu içerikte çok daha fazlası ve çok daha nadiri var! "]
	quest.54F0C5C48CFC94D0.quest_desc: ["Lojistikte Filtrelemeye ihtiyacımız var. İki farklı Filtre vardır: List ve Attribute. \nList Filter içine Eşyalar eklersiniz ve beyaz liste veya kara liste olup olmadığını ve NBT Verilerine dikkat edip etmeyeceğini değiştirirsiniz. \n\nAttribute Filter bir referans Eşya alır ve seçilen bir Niteliğe göre filtreler. Buna etiketler ve Fırın Yakıtı olarak kullanılıp kullanılamayacağı ya da patika oluşturup oluşturamayacağı gibi diğer şeyler dahildir!"]
	quest.55E321EFBE8956DE.quest_desc: ["Fermantasyon tariflerinde maliyeti düşürmek istiyorsanız Fermentation Starter tam size göre! \\n\\nFermantasyon tariflerindeki pahalı girdilerin yerine geçebilen oldukça ucuz bir maya ikamesidir."]
	quest.55E321EFBE8956DE.title: "Daha Kolay Fermantasyon"
	quest.5844DD2BEE5EC3DC.quest_desc: ["Sakın içmeye kalkışmayın! \\n\\n&cMercury&r (Cıva) 3 temel alanda kullanılır: Kuluçkalama (Incubation), Enerji Üretimi (Power Generation) ve Lojistik!"]
	quest.5844DD2BEE5EC3DC.quest_subtitle: "Venüs Değil, &cMercury&r!"
	quest.5844DD2BEE5EC3DC.title: "Mercury (Cıva)"
	quest.616364E6AE05C341.quest_desc: ["&bMineral Salts&r... şey, Minerallerden yapılır. \n\nCevher şeklinde kazılan her şey &bSalt&r yapılabilir. Ham Cevherler, Külçeler, Değerli Taşlar; hepsi &bMineral Salt&r olur! \n\nUnobtainium bile &bSalt&r yapılabilir! Ama lütfen yapmayın, çok daha iyi alternatifler var."]
	quest.616364E6AE05C341.title: "&bMineral Salt"
	quest.61DA3D61D7103647.quest_desc: ["&eAlchemical Sulfurs&r neredeyse her şeyden yapılabilir ve neredeyse her şeye dönüştürülebilir! \n\n&eAlchemical Sulfurs&r içinde, başka bir Görevde daha ayrıntılı açıklanabilecek birkaç farklı Eşya grubu vardır. \n\n&eAlchemical Sulfurs&r işlerken izleyebileceğiniz 3 farklı yol vardır: 1. Niter yapmak için Fermentation ve Digestion. 2. O Eşyaları tekrar yapmak için Incubation ve 3. Eşyayı Reformation ile değiştirmek."]
	quest.61DA3D61D7103647.title: "&eAlchemical Sulfurs"
	quest.6A8E748B642DD16F.quest_desc: [
		"Burası kuluçka işleminde gerekli &bSalt&r türünün koyulacağı kaptır. \\n\\nKullanılan tuz türü kuluçkalanacak eşyaya göre değişir. Örneğin Unobtainium üretmek için &bMineral Salt&r, buğday üretmek için ise &bPlant Salt&r gereklidir."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_2.png width:100 height:125 align:center}"
	]
	quest.6A8E748B642DD16F.title: "&bSalt&r Kabı"
	quest.6C6F4EB5CBE2FBC2.quest_desc: ["Iron Divination Rod (Demir Kehanet Asası) bir üst seviyedir ve demir kazmayla kazılabilen tüm cevherleri tespit edebilir: Elmas, Kızıltaş ve Altın!"]
	quest.6CAD27627A3F8FD7.quest_desc: [
		"Şimdi nihayet modun ana konusuna geldik: &eAlchemical Sulfurs&r! \n\nBunları yapmak için bir Liquefaction Cauldron, bir Eşya, &dSal Ammoniac&r ve bir Isıtıcıya ihtiyacımız var. \n\nIsı konusu başka bir Görevde açıklanmıştır ancak kazanı ısıtmak için altına Pyromantic Brazier veya Caloric Flux Emitter koymanız gerekir. \n\nArdından içine sıvı &dSal Ammoniac&r ekleyin. \n\nVe son olarak &eAlchemical Sulfur&r'e dönüştürülmesini istediğiniz Eşyayı koyun. \n\nFokurdamaya başladığında çalıştığını anlayacaksınız."
		"{image:atm:textures/questpics/theurgy/theurgy_lique.png width:100 height:100 align:center}"
	]
	quest.6CAD27627A3F8FD7.title: "&eAlchemical Sulfur&r Üretimi"
	quest.7119F8C352D057BC.quest_desc: ["Şimdi işin eğlenceli kısmına geliyoruz! Nadir (Rare) seviye materyaller Elytra'ya kadar uzanır. Bana kalırsa Elytra 'Rare'den daha üstün ama sıralamayı ben belirlemedim!"]
	quest.7198ED7E97A256A4.quest_desc: ["Üretilen ilk özel Divination Rod, Abundant Material Rod'dur! \n\nAsayı bir Eşyanın &eAlchemical Sulfur&r'ü ile ürettiğinizde, Asa o Eşyaya uyum sağlar. \n\nAbundant Malzemelerinin listesini Etiketlerde görebilirsiniz, Görevlerde tek tek sayamayacağım kadar büyük bir listedir.  "]
	quest.72FADEAEE2DA03AF.quest_desc: [
		"Üçüncü adım Sonuç Kaidesidir (Result Pedestal). Dönüştürülen yeni &eSulfur&r bu kaidede belirir."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "3. Adım: Result Pedestal"
	quest.730F2D3329C4FF88.quest_desc: ["&nFermentation&r: \nGlikoz gibi moleküllerin havasız ortamda parçalandığı kimyasal süreç. \n\nYani &9Water&r ve zamanın bir şeyleri değiştirmesi! \n\nFermentation Vat'i kullanmak için Eşyaları ve Sıvıyı Vat'e koyun, ardından kapatmak için Shift + Sağ Tıklayın. \n\nBir süre sonra fermente olmalıdır! &eAlchemical Sulfur&r'ü daha fazla Eşyaya dönüştürülebilecek &3Alchemical Niter&r'a bu şekilde dönüştürürüz!"]
	quest.730F2D3329C4FF88.title: "Fermentation Vat"
	quest.76F675A898EAB4E8.quest_desc: ["&dSal Ammoniac&r, eşya üretimi ve çoğaltılmasında kullanılan &eAlchemical Sulfur&r sentezinin en kritik bileşenidir. \\n\\n&dSal Ammoniac&r üretmek için bol miktarda &9Su&r gerekecektir."]
	quest.76F675A898EAB4E8.title: "&dSal Ammoniac"
	quest.7878F190BC8ADC82.quest_desc: ["En üst seviye kehanet asası! Elmaslardan Nether Star ve Allthemodium'a kadar yalnızca en değerli cevher ve malzemeleri bulur."]
	quest.7A1C117CA8FB7C31.quest_desc: ["Bu asa oldukça özeldir! Cevher aramak yerine doğrudan Budding Amethyst bloklarının yerini tespit eder. \\n\\nArtık ametist jeotları aramak için dünyayı dolanmanıza gerek kalmadı efendim!"]
	quest.7A271F425C3934CE.quest_desc: ["Şu anki tariflerde 2 adet &bPlant Salt&r fırınlanarak 1 adet &bCreature Salt&r (Hayvansal Tuz) elde edilebilir. \\n\\nUmarız gelecek güncellemelerde yaratıkları avlayarak da bu tuzu elde etme şansımız olur!"]
	quest.7A271F425C3934CE.title: "&bCreature Salt"
