{
	chapter.6AEDA2F9BEB57759.title: "Ars Nouveau"
	chapter_group.02FE661031A105D8.title: "Büyü"
	quest.04D9F6587EF8D9B7.quest_desc: ["&9İksir Kavanozu&r, 100 iksire kadar depolayabilir. Boş bir şişeyi veya İksir Şişesini kavanozda kullanarak iksiri dışarı alabilirsiniz. \\n\\nWixie'ler bu kavanozları otomatik iksir üretiminde kullanır."]
	quest.04D9F6587EF8D9B7.quest_subtitle: "İksir Depolama"
	quest.088FCB5267CB7A89.quest_desc: ["Bu kemer, kısa süreliğine rastgele olumlu iksir etkileri sağlar. Etkilerin gücü değişkenlik gösterebilir."]
	quest.0A1ABE9CF7740AAA.quest_desc: ["Küçük İndirim Yüzüğü ve Büyük İndirim Yüzüğü, azami mananıza ve mana yenilenmenize bonus sağlar. Ayrıca büyü yapma maliyetini de düşürür."]
	quest.0A1ABE9CF7740AAA.title: "İndirim Yüzükleri"
	quest.0D330FAD6C993DBC.quest_desc: ["Bu, Büyü Kitabınız için bir sonraki yükseltmedir! \\n\\nToplam mananızı ve mana yenilenmenizi artırmanın yanı sıra Seviye 2 Glifleri oluşturup kullanmanıza olanak tanır."]
	quest.0E2AD156E5EF263A.quest_desc: ["Yazıcı Masası kullanılarak üzerine büyü yazılır."]
	quest.111649D7E16D869F.quest_desc: ["&9Enchanter's Wand&r yalnızca tek bir büyü kabul eder ve Yazıcı Masası kullanılarak yazılır. \\n\\nAsa büyüleri her zaman Mermi > Hızlanmak ile başlamalı ve başka bir biçim glifi (Dokunmak, öz vb.) içermeyen bir büyüyle yazılmalıdır. \\n\\nBu sayede 10 büyü sınırına takılmadan büyü yapabilirsiniz. Örneğin Kırmak glifini kullanmak istiyorsanız, asaya yalnızca Kırmak glifini yazmanız yeterlidir."]
	quest.14DB8A515CA50932.quest_desc: ["&9Büyücünün Kılıcı&r, kılıca Dokunmak biçimli bir büyü bağlamanızı sağlar. \\n\\nKılıçtaki tüm büyülerin son etkisi, 1 ek Yükseltmek güçlendirmesi kazanır. \\n\\nKılıca büyü eklemek için Yazıcı Masası kullanın. Büyüyü herhangi bir biçim glifi eklemeden oluşturun."]
	quest.151648179684B088.quest_desc: ["Runik Tebeşir, yerde kalıcı rünler çizmek için kullanılır. Bu rünler üzerlerinden geçen varlıklarda büyüyü tetikler. \\n\\nBir rüne büyü eklemek için Yazıcı Masası kullanarak bir &eBüyülü Parşömen&r hazırlayın.\\n\\nNot: Rünün çalışması için Kaynak gereklidir."]
	quest.151648179684B088.quest_subtitle: "Yerleştirilebilir Büyüler"
	quest.17D7D34F519F7E5F.quest_desc: ["Büyü Kitabınızın son aşamasını hazırlamak için &6Yabani Chimera'yı&r katletmeniz gerekir. \\n\\nBu işlem &9ritüel mangal&r kullanılarak gerçekleştirilen bir ritüeldir."]
	quest.18A2FBE2D4133FA2.quest_desc: ["Esrarengiz Kaideler, ritüel mangal kullanılarak yapılan ritüellerde ve Büyüleyici Aparat ile eşya üretiminde gereklidir. \\n\\nKendinize 8 adet üretin!"]
	quest.18A2FBE2D4133FA2.quest_subtitle: "Süslü Masalar"
	quest.18A2FBE2D4133FA2.title: "Esrarengiz Kaideler"
	quest.19D02325579F2AA8.quest_desc: ["Volkanik Kaynak Bağlantısı, yanıcı maddeleri tüketerek Kaynak üretir. Archwood kütükleri ekstra Kaynak sağlar. \\n\\nEşyaları yaktıkça etrafındaki taşları lava dönüştürür. \\n\\nAyrıca lav zambağı da üretir."]
	quest.1D86B2E553503E53.quest_desc: ["Hakimiyet Asası, dünyada karşılaştığınız yaratıkları yönlendirmenizi sağlar! Her yaratık asaya farklı tepki vereceğinden detaylar için Aşınmış Defter rehberine göz atmayı unutmayın!"]
	quest.1D86B2E553503E53.title: "Yardım Çağır!"
	quest.227DBA8836021B0B.quest_desc: ["Ars Nouveau'daki düzeneklerin güç kaynağına &9Kaynak&r denir. \\n\\nKaynak depolamaya başlamak için bir Kaynak Kavanozu üretmeniz gerekir. \\n\\nKaynak; kovalarla veya içi dolu Kaynak Kavanozları kırılıp alınarak taşınabilir."]
	quest.227DBA8836021B0B.quest_subtitle: "Kaynak Depolama"
	quest.295C77EEC89000FC.quest_subtitle: "Ölümlerden ve Üremeden Kaynak Üretimi"
	quest.2D0CF18C8B2ABB7D.quest_desc: ["Büyüyen bitkilerin veya fidanların yanına yerleştirildiğinde Kaynak üretir. Archwood ağaçları çok daha fazla Kaynak sağlar! \\n\\nNot: Kemik tozu ile büyütme Kaynak üretmez."]
	quest.2D0CF18C8B2ABB7D.quest_subtitle: "Bitki Büyümesiyle Kaynak Üretimi"
	quest.3142A40E1EAEBAA3.quest_desc: ["&6Maden Çubuğu&r kullanıldığında çevredeki sihiri ve kaynakları tespit etmenizi sağlar. \\n\\nYakındaki sihirli yaratıkları ve ametist kristallerini kolayca görmenize yardımcı olur!"]
	quest.3142A40E1EAEBAA3.quest_subtitle: "Sihir Bulucu"
	quest.3182E8AF755104E4.quest_desc: ["&9Büyücünün Kalkanı&r saldırıları engellediğinde kullanıcıya geçici Mana Yenilenmesi ve Büyü Hasarı bonusu kazandırır. \\n\\nAyrıca kullanıcının manasını tüketerek zamanla kendini onarır."]
	quest.33682F4B44950123.quest_desc: ["Ars Nouveau gereçlerini üretmek için özel bir büyü odununa ihtiyacınız olacak! \\n\\nArchwood ağaçlarını Dünyada (Overworld) doğal olarak bulabilirsiniz."]
	quest.36CDA39C23D3AA2B.quest_desc: ["Bu görev, AllTheMods mod paketlerinde kullanılmak üzere &6AllTheMods Ekibi&r veya &2Topluluk üyeleri&r tarafından oluşturulmuştur. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı altında olduğundan, bu görevin izinsiz biçimde başka hiçbir halka açık pakette kullanılmasına izin verilmez. \\n\\nBu görev gizlenmiştir; görüyorsanız düzenleme modundasınız demektir."]
	quest.3D4D88B8BE881351.quest_desc: ["Daha güçlü büyüler yapmak için &6Yazıcı Masası&r kullanarak Büyü Kitabınıza yeni glifler kazandırmanız gerekir. \\n\\nAçılabilir 3 seviye glif bulunur ve her biri tecrübe puanı ile belirli eşyalar gerektirir. \\n\\nYazıcı Masası ayrıca Büyülü Parşömenlere büyü yazmak için de kullanılır. Masaya bir Büyülü Parşömen yerleştirip Büyü Kitabınızdan büyüyü seçin, ardından eğilerek (Shift) kitabınızla masaya sağ tıklayın. \\n\\nGlif üretmek için masaya Büyü Kitabınızla sağ tıklayın. İstediğiniz glifi seçtikten sonra gerekli malzemelerle masaya sağ tıkladığınızda glif oluşturulur. Glifi sağ tıklayarak öğrenin. \\n\\nNot: Masa, yakındaki sandıklardan otomatik malzeme çekebilir."]
	quest.3D4D88B8BE881351.quest_subtitle: "Glif Kilidi Açma"
	quest.3D862A3D3F83CA26.quest_desc: [
		"&9Büyüleyici Aparat&r, moddaki gelişmiş eşyaları üretmek için kullanılır. Çalışması için Kaynak gerektirir.\\n\\nÇevresine Esrarengiz Kaideler dizilerek oluşturulan çok bloklu (multiblock) bir yapıdır.\\n\\nYere bir Esrarengiz Çekirdek yerleştirip üzerine Büyüleyici Aparatı koyun, ardından etrafını Esrarengiz Kaideler ile çevreleyin.\\n"
		"{image:atm:textures/questpics/ars/enchanting_app.png width:200 height:175 align:1}"
	]
	quest.3D862A3D3F83CA26.title: "Büyüleyici Aparat"
	quest.3FD702B5AB006402.quest_desc: ["Gittiğiniz her yerde havada süzülmeye ne dersiniz? \\n\\nBu kemer süzülmenizi sağlar. Etkinleştirmek için havada zıplarken veya düşerken eğilmeniz (Shift) yeterlidir."]
	quest.40BC67BDEE15D1DE.quest_desc: ["Kaynak Cevheri üretmek için İmplant Odası içerisine Lapis Lazuli veya Ametist Parçası yerleştirin. Oda zamanla bunları Kaynak Cevherine dönüştürür!"]
	quest.40BC67BDEE15D1DE.title: "&5Kaynak Cevheri"
	quest.41A0BE357C8A74E1.quest_desc: ["&9Simyasal Kaynak Bağlantısı&r, bitişiğindeki İksir Kavanozlarından Kaynak üretir. \\n\\nÜretilen Kaynak miktarı iksirin türüne ve karmaşıklığına göre değişir."]
	quest.41A0BE357C8A74E1.quest_subtitle: "İksirlerden Kaynak Üretme"
	quest.441C0659ED28D935.quest_desc: ["Seviye 1 Glifleri üretmek 3 tecrübe seviyesi gerektirir."]
	quest.457DE8C154641437.quest_desc: ["&9ritüel mangal&r ritüeller gerçekleştirmek için kullanılır. İstenirse dekoratif olarak da yakılabilir (üzerinde Magelight'ı Büyüle büyüsü kullanmanız yeterlidir). \\n\\nRitüeller için etrafta Esrarengiz Kaideler bulunmalıdır. Birçok farklı ritüel olduğu için ayrıntılara &6Aşınmış Defter&r rehberinden bakabilirsiniz! \\n\\n(Kitap envanterinizdeyken ritüel mangala bakıp Ctrl basılı tutarak ritüel tariflerini inceleyebilirsiniz.)"]
	quest.51162B9185A45BB1.quest_desc: ["&9Büyücünün Yayı&r üzerine Yazıcı Masası ile bir büyü yazılabilir. \\n\\nMana harcayarak atılan oklar büyü okuna dönüşür ve çarptığı hedefte büyüyü tetikler. \\n\\nEnvanterinizde ok yoksa 0 hasar veren sihirli bir ok atılır. Mananız yetersizse normal ok fırlatılır. \\n\\nAyrıca büyü etkisini artırmak için özel Artırma Okları da kullanılabilir."]
	quest.542C6D76B579886C.quest_desc: ["Büyülü Çiçek Tohumlarını yetiştirip hasat ederek &5Büyülü Elyaf&r elde edebilirsiniz. \\n\\nBu lifler sihirli zırh ve giysilerin yapımında kullanılır!"]
	quest.5766C8B9E850C186.quest_desc: [
		"Ars Nouveau'nun temel ham maddelerinden &9Kaynak Cevheri&r üretmek için bir &6İmplant Odası&r yapmalısınız. \\n\\nİmplant Odası eşyaları dönüştürmek için Kaynak harcar. Yavaşça kendi Kaynağını üretebilir fakat yakındaki Kaynak Kavanozlarından da güç çekebilir. \\n\\nGelişmiş tarifler için çevresine Esrarengiz Kaideler yerleştirmek gerekir.\\n"
		"{image:atm:textures/questpics/ars/imbuement.png width:200 height:150 align:1}"
	]
	quest.5766C8B9E850C186.quest_subtitle: "Kaynak Cevheri Üretimi"
	quest.58EC47584C773B82.quest_desc: ["Büyüleyici Aparat düzeneğini kullanarak ilk sihirli tohumumuz olan &5Büyülü Çiçek Tohumu&r üretmelisiniz. \\n\\nBu bitkiden elde edilen ürünler sihirli zırh ve giysilerin yapımında kullanılır!"]
	quest.58EC47584C773B82.quest_subtitle: "Sihirli Tarım"
	quest.58EC47584C773B82.title: "Büyülü Çiçek Tohumu"
	quest.5C3FF43CF16BCF30.quest_desc: ["Kaynak Cevheri kullanarak &5kaynak taşı&r blokları üretebilir ve modun çeşitli yapı gereçlerini imal etmeye başlayabilirsiniz."]
	quest.5C3FF43CF16BCF30.quest_subtitle: "Eski adıyla \"Arcane Stone\""
	quest.5C3FF43CF16BCF30.title: "kaynak taşı"
	quest.5CFBA24B3E0CDEDD.quest_desc: [
		"Büyü Kitabınızı elinizde tutarken büyü oluşturma menüsünü açmak için &9C&r tuşuna basın. \\n\\nHer büyünün bir biçim glifi (form) bulunmalıdır. Başlangıçta 3 temel biçim mevcuttur: Mermi, öz ve Dokunmak. \\n\\nEtki glifleri ise büyünün ne yapacağını belirler. Tek bir büyüye 9 adede kadar etki glifi ekleyebilirsiniz. \\n\\nBaşlangıçta Zarar ve Kırmak etki gliflerine sahipsiniz. \\n\\nBir Biçim ve bir Etki seçin, büyünüze bir isim verin ve Oluştur butonuna tıklayın!"
		""
		"{image:atm:textures/questpics/ars/spellbook.png width:200 height:150 align:1}"
	]
	quest.632BC46928CC9A8C.quest_desc: ["&9Büyücünün Aynası&r kullanıldığında üzerinizde (öz) büyü tetikler. \\n\\nAyna aracılığıyla yapılan büyüler daha az mana harcar ve etki süreleri artar. \\n\\nAynaya büyü atamak için Yazıcı Masası kullanın. Büyüyü herhangi bir biçim glifi eklemeden yazmanız gerekir."]
	quest.63DD7F5A4441ACE7.quest_desc: ["Seviye 2 Glifleri üretmek 5 tecrübe seviyesi gerektirir. \\n\\nAyrıca bu işlem için &9Büyücünün Büyü Kitabı'na&r sahip olmanız gerekir."]
	quest.64D0E66CB4FBEC82.quest_desc: ["Sihir yolculuğunuza başlamak için bir &6Acemi Büyü Kitabı&r üretmelisiniz! \\n\\nBurası büyülerinizi tasarlayıp sakladığınız ana kitabınızdır. \\n\\n&9C&r tuşuna basarak büyü oluşturma menüsünü açabilirsiniz. Sol taraftaki sekmelerden en önemlileri: Büyü Oluşturma, Renk Seçimi ve Yoldaşlar'dır. \\n\\nBu temel kitap yalnızca Seviye 1 Glifleri destekler. Daha güçlü büyüler yapmak için kitabınızı zamanla yükseltmelisiniz!"]
	quest.64D0E66CB4FBEC82.quest_subtitle: "İlk Büyü Kitabı"
	quest.64D0E66CB4FBEC82.title: "Büyü Kitapları"
	quest.6A1C0B17B22CE50F.quest_desc: ["&9Mana Takviyesi Tılsımı&r azami mana miktarınızı artırır. \\n\\n&6Mana Yenilenmesi Tılsımı&r ise mana yenilenme hızınızı yükseltir."]
	quest.6A1C0B17B22CE50F.title: "Tılsımlar"
	quest.6B511C8B572E8940.quest_desc: ["Ekranın sol alt köşesindeki mavi gösterge mana havuzunuzdur! \\n\\nGeliştikçe mana kapasitenizi artırmanın ve büyülerin mana maliyetini düşürmenin çeşitli yollarını bulacaksınız. Büyü kitabınızı yükseltmek de mana kapasitenizi doğrudan artırır!"]
	quest.6B511C8B572E8940.quest_subtitle: "Büyücü Gücü"
	quest.6B511C8B572E8940.title: "Mana"
	quest.6DAA82B5F94AF9F8.quest_desc: ["&9Işık Kavanozu&r, sizi takip eden süzülen bir ışık küresi çağırır. \\n\\n&6İşeme Kavanozu&r, belirlenen eşyaları mana karşılığında yok eder. Filtrelenebilir. \\n\\nYok edilecek eşyaları ayarlamak için eşya sol elinizdeyken kavanoza sağ tıklayın veya kavanozu Yazıcı Masası üzerine koyup eşyayı masada kullanın. \\n\\nİşlevini sürdürmesi için kavanozun hotbar'da bulunması gerekir."]
	quest.6DAA82B5F94AF9F8.title: "Kavanozlar"
	quest.6E0E13806F388D7E.quest_desc: ["&aArs Nouveau&f moduna hoş geldiniz! \\n\\nArs Nouveau, farklı glifleri kombinleyerek kendi özel büyülerinizi tasarlamanıza imkan tanıyan kapsamlı bir sihir modudur!"]
	quest.6E0E13806F388D7E.title: "&aArs Nouveau&f Moduna Hoş Geldiniz!"
	quest.6F3602F5600A6221.quest_desc: ["Seviye 3 Glifleri üretmek 10 tecrübe seviyesi gerektirir. \\n\\nAyrıca bu işlem için &6Archmage Büyü Kitabı'na&r sahip olmanız gerekir."]
	quest.77145113CD5B26FB.quest_desc: ["Misel Kaynak Bağlantısı, kaynak üzümü kullanıldığında diğer yiyeceklere kıyasla daha fazla Kaynak üretir. \\n\\nAyrıca 3x3'lük alandaki toprak ve çimleri Miselyuma dönüştürür ve boş alanlarda mantar üretir."]
	quest.77145113CD5B26FB.quest_subtitle: "Yiyecek ve Meyvelerden Kaynak Üretimi"
	task.01FD75641E5EA5E4.title: "Mana"
	task.03EB390E79866058.title: "kaynak taşı"
	task.0E6876A34D1975EB.title: "TümHaklarıSaklıdır"
	task.15C6E9C02D1FBEC0.title: "Seviye 2 Glifler"
	task.1B916AE67F84E6D7.title: "İlk Büyünüzü Oluşturma"
	task.1CC556A6921208B8.title: "Seviye 1 Glifler"
	task.2BC0F5A88E2F03C3.title: "Archwood Kütükleri"
	task.388545A0E3B4930D.title: "TümHaklarıSaklıdır"
	task.65D68BEEB36FC805.title: "Seviye 3 Glifler"
}
