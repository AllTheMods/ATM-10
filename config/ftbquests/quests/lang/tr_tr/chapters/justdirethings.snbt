		""
		"Bow tarafından ateşlenen okların Potion Canister'ınıza bağlı olarak bir iksir etkisi uygulamasını sağlar."
	]
	quest.05D8C6EF8FCD6250.quest_desc: [
		"Primogel Goo, JDT tarafından eklenen ilk goo seviyesidir ve üretmek için temel Overworld materyalleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Ferricore"
		"- Primal Coal"
		""
		"Goo Spread Örneği:"
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.07655CA904354E9E.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Etkinleştirildiğinde yakındaki çimenleri ve çiçekleri kırar."
	]
	quest.079A415488A32076.quest_desc: ["Blaze Ember, JDT tarafından eklenen yeni bir materyaldir. Blaze Ember, ikinci seviye veya daha yüksek bir goo kullanılarak Primal Coal Blocks üzerinde Goo Spread gerçekleştirilerek elde edilir. Blaze Ember Ore, fortune (servet) büyüsünden etkilenir."]
	quest.09485B63483B7A15.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Geçici olarak yakındaki düşman mob'ların oyuncuya olan saldırganlığını (aggro) kaybetmesine neden olur, bekleme süresi vardır."
	]
	quest.09D2137B4F42006E.quest_desc: ["Eclipse Ember, JDT tarafından eklenen yeni bir materyaldir. Eclipse Ember, dördüncü seviye goo kullanılarak Voidflame Coal Blocks üzerinde Goo Spread gerçekleştirilerek elde edilir. Eclipse Ember Ore, fortune büyüsünden etkilenir."]
	quest.0A02DBE226C3F44E.quest_desc: [
		"Geçerli Yükseltmeler:"
