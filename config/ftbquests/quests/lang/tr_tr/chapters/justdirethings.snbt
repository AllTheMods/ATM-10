	]
	quest.0B485DB737A036E9.quest_desc: ["Machine Settings Copier, makineler arasındaki ayarları kopyalamanıza olanak tanır."]
	quest.0B9BBE2A764631BF.quest_desc: ["Simple Swapper; üzerindeki eşyaları, blokları, yaratıkları veya oyuncuları bağlı olduğu diğer bir Simple Swapper'a ışınlar. Swapper'ları birbiriyle eşleştirmek için Ferricore Wrench kullanabilirsiniz."]
	quest.0C1D55AA9CC902BD.quest_desc: [
