	quest.1EA02BA24AF02256.quest_desc: ["Eclipse Alloy şablonları; Celestigem zırh ve aletlerini üzerindeki büyüleri ve yükseltmeleri koruyarak Eclipse Alloy seviyesine geliştirmeyi sağlar."]
	quest.1ECFA72CF2BA4B45.quest_desc: ["Tek seferde bırakılacak eşya miktarı ayarlanabilen basit bir bırakıcı."]
