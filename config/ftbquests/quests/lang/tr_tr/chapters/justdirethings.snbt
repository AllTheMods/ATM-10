		""
		"&lYetenek İşlevi:&r"
		""
		"Yay ile atılan okların, Potion Canister'ınızdaki iksir etkisini uygulamasını sağlar."
	]
	quest.05D8C6EF8FCD6250.quest_desc: [
		"Primogel Goo, Just Dire Things modunun ilk aşama goo maddesidir ve üretimi için temel Overworld malzemeleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Ferricore"
		"- Primal Coal"
		""
		"Goo Spread Örneği:"
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.07655CA904354E9E.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Etkinleştirildiğinde yakındaki çim kütlelerini ve çiçekleri biçer."
	]
	quest.079A415488A32076.quest_desc: ["Blaze Ember, Just Dire Things ile eklenen yeni bir malzemedir. Primal Coal bloklarının üzerinde ikinci aşama veya daha yüksek goo maddesiyle Goo Spread gerçekleştirilerek elde edilir. Blaze Ember cevheri Servet büyüsünden etkilenir."]
	quest.09485B63483B7A15.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:"
		""
		"Etkinleştirildiğinde etraftaki düşman yaratıkların oyuncuya olan husumetini geçici olarak sıfırlar. Bekleme süresi vardır."
	]
	quest.09D2137B4F42006E.quest_desc: ["Eclipse Ember, Just Dire Things ile eklenen yeni bir malzemedir. Voidflame Coal blokları üzerinde 4. aşama goo maddesi kullanılarak Goo Spread gerçekleştirilerek elde edilir. Eclipse Ember cevheri Servet büyüsünden etkilenir."]
	quest.0A02DBE226C3F44E.quest_desc: [
		"Geçerli Yükseltmeler:"
