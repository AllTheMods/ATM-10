	quest.7305EE0F7D73C231.quest_desc: ["Blank Upgrades tüm yeteneklerin temelidir. Yetenekler pasif ve aktif olmak üzere iki türe ayrılır.\\n\\nPasif yeteneklerin çalışması için oyuncunun aktif bir girdisine (input) ihtiyacı yoktur, ancak Aktif yetenekler yalnızca oyuncuların yapılandırma menüsünde (configuration menu) belirlediği bir tuş ataması tarafından tetiklendiğinde çalışır, ayrıca aktif yetenekler kullanıldığında dayanıklılık/güç tüketir. Daha yüksek seviyeli zırhlara kurulduğunda Aktif yeteneklerin bekleme süresi (cooldown) azalır ve Pasif yeteneklerin etkileri daha büyük olur.\\n\\nSmithing table, JDT aletlerine ve zırhlarına yükseltmeler uygulamak için kullanılır. JDT aletleri veya zırhları üzerinde gezinirken shift tuşuna basılı tutmak, hangi yükseltmelerin geçerli olduğunu gösterir."]
	quest.73552A4BA0687962.quest_desc: ["Bu yükseltmeler aletlere veya zırhlara eklenebilir."]
	quest.7464CA1290B3474B.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Invulnerability"
	]
	quest.76B1C5AFC5D6B7CF.quest_desc: ["Time Wand, Time in a Bottle'a benzer şekilde blokları x128 hıza kadar hızlandırmak için kullanılabilir. TIAB'ın (Time in a Bottle) aksine, yakıt olarak depolanan zaman yerine FE ve Time Fluid kullanır, bu da yeniden doldurulmasını önemli ölçüde kolaylaştırır.\\n\\nAncak sahte (fake) oyuncular için kara listeye alınmıştır. BUNU otomatikleştirmenizi istemiyoruz."]
	quest.76B1C5AFC5D6B7CF.quest_subtitle: "Time in a Bottle'ın Kuzeni"
	quest.78840993C7832E89.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Drops Teleporter"
		"- Instant Break"
	]
	quest.79BBCC1BEE90DBBB.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Oyuncunun ölümü kandırmasına olanak tanır, çok uzun bir bekleme süresi vardır. Başka bir deyişle, tüketilmeyen (kaybolmayan), bekleme süreli bir Totem of Undying'dir."
	]
	quest.7AEFF81E7C8CF300.quest_desc: ["Bir JDT aleti veya asası (wand) tutarken Shift Sağ Tıklama (Shift Right Click) kullanmak, oyuncunun yetenekleri yapılandırabileceği ve değiştirebileceği yapılandırma menüsünü (configuration menu) açacaktır."]
	quest.7B9486981786AC47.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Yakındaki mob'ların yapay zekasını (AI) kalıcı olarak kaldırır, güç maliyeti nedeniyle aktivasyon başına en fazla beş mob'u etkileyebilir, çok uzun bir bekleme süresi vardır."
	]
	quest.7D1D2A4E07E98709.quest_desc: ["Blokları kırmak için bir alet gerektiren basit bir blok kırıcı (block breaker)."]
	quest.7F0B2D58361FB00E.quest_desc: ["Just Dire Things her işin üstesinden gelen bir moddur. Just Dire Things, Goo Spread adı verilen yeni bir üretim mekaniğinin (crafting mechanic) yanı sıra Goo Spread'in ve diğer yardımcı programların otomasyonuna yardımcı olan makineler ekler."]
	quest.7F0B2D58361FB00E.title: "Just Dire Things"
