	]
	quest.25213DBA6E6CEDD2.quest_desc: [
		"Shadowpulse Goo, JDT tarafından eklenen dördüncü ve son goo seviyesidir ve üretmek için Ancient City ve Warden materyalleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Eclipse Alloy"
		"- Eclipse Ember"
		"- Time Crystal"
	]
	quest.25E915AE1FC53254.quest_desc: ["Celestigem Templates, büyüler ve kurulu yükseltmeler korunurken Blazegold zırhını ve aletlerini Celestigem'e yükseltmek için kullanılır."]
	quest.27FD46A8C958D259.quest_desc: ["Totem of Death Recall, bir oyuncunun öldüğü konuma geri ışınlanmasını sağlayan tek kullanımlık bir eşyadır."]
	quest.283D7E65F2AD45F2.quest_desc: [
