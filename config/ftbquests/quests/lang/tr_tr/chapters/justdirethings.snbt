		"Geçerli Yükseltmeler:"
		"- Mind Fog"
	]
	quest.25213DBA6E6CEDD2.quest_desc: [
		"Shadowpulse Goo, modun dördüncü ve son aşama goo maddesidir. Üretimi Antik Şehir ve Warden bileşenleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Eclipse Alloy"
		"- Eclipse Ember"
		"- Time Crystal"
	]
	quest.25E915AE1FC53254.quest_desc: ["Celestigem şablonları; Blazegold zırh ve aletlerini üzerindeki büyüleri ve yükseltmeleri koruyarak Celestigem seviyesine geliştirmeyi sağlar."]
	quest.27FD46A8C958D259.quest_desc: ["Totem of Death Recall, en son öldüğünüz konuma anında ışınlanmanızı sağlayan tek kullanımlık bir totemdir."]
