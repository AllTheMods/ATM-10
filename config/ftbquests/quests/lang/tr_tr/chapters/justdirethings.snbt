	]
	quest.0B485DB737A036E9.quest_desc: ["Machine Settings Copier, oyuncuların makineler arasında ayarları kopyalamasına olanak tanır."]
	quest.0B9BBE2A764631BF.quest_desc: ["Simple swapper, üzerindeki eşyaları, blokları, yaratıkları veya oyuncuları bağlı olduğu başka bir simple swapper'a ışınlayabilir. Swapper'ları birbirine bağlamak için Ferricore wrench kullanın."]
	quest.0C1D55AA9CC902BD.quest_desc: [
