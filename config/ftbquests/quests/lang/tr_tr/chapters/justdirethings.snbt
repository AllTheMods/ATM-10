	quest.4F9932477EDDCB8E.quest_desc: ["Advanced Portal Gun, çalışmak için hem enerjiye hem de Portal Fluid sıvısına ihtiyaç duyan gelişmiş bir portal silahıdır. Standart modelin aksine kayıtlı konumlar arasında ışınlanmayı sağlar. Konum kaydetme ve hedef seçme menüsünü varsayılan olarak \"V\" tuşu ile açabilirsiniz."]
	quest.5054977BD5354561.quest_desc: [
