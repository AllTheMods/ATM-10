		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Ore Scanner &4&lDEVRE DIŞI&r&f"
	]
	quest.5BD5737703F3F077.quest_desc: ["Ferricore, JDT tarafından eklenen yeni bir materyaldir. Ferricore, birinci seviye veya daha yüksek bir goo kullanılarak Iron Blocks üzerinde Goo Spread gerçekleştirilerek elde edilir. Ferricore Ore, fortune büyüsünden etkilenir."]
	quest.5BD5737703F3F077.title: "Ferricore"
	quest.5C6709350BEF4050.quest_desc: [
		"Voidshimmer Goo, JDT tarafından eklenen üçüncü goo seviyesidir ve üretmek için End materyalleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Celestigem"
		"- Void Flame"
	]
	quest.5D4E51471F3939E0.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Oyuncuyu baktığı yöne doğru fırlatarak bu süreçte dayanıklılık tüketir, daha yüksek seviyeli asalar oyuncuyu daha uzağa fırlatır. Oyuncunun asayı tuttuğu sürece düşme hasarı almayacağını unutmayın."
	]
	quest.5EE7D5DE07A83C7D.quest_desc: ["&lYetenek Türü:&r Aktif\\n\\n&lYetenek İşlevi:&r\\n\\nEtkinleştirildiğinde yakındaki cevherleri yeşil parçacıklarla (particles) vurgular.\\n\\n&4&lBU YETENEĞİN DEVRE DIŞI BIRAKILDIĞINI UNUTMAYIN.&r&f"]
	quest.5F5120451BA5B2FE.quest_desc: ["Gelişmiş (Advanced) makineler, yapılandırılabilir çalışma alanı, daha fazla filtre yuvası ve güç gereksinimi gibi eklemelerle basit varyantlarıyla aynı yeteneklere sahiptir."]
	quest.60A4994078500F63.quest_desc: ["Celestigem, JDT tarafından eklenen yeni bir materyaldir. Celestigem, üçüncü seviye veya daha yüksek bir goo kullanılarak Diamond Blocks üzerinde Goo Spread gerçekleştirilerek elde edilir. Celestigem Ore, fortune büyüsünden etkilenir."]
	quest.61213012615619C5.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Öldürmelerden düşen eşyaları otomatik olarak tütsüler (smokes)."
	]
	quest.636854555AD75DC3.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Eşya droplarını otomatik olarak alete bağlı olan envantere ışınlar. Bir JDT çapası üzerindeyken voidshimmer / shadowpulse farmland'in auto harvest yeteneği tarafından düşürülen öğelerin bağlı envantere ışınlandığını, ayrıca voidshimmer / shadowpulse farmland'e sağ tıklamanın, aletin bağlı envanteri değiştirildiyse onları yeniden bağlayacağını unutmayın."
	]
	quest.6690AEE064DC2A7C.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:"
		""
		"Aynı anda kazılan alanı artırır. Daha yüksek seviyeli aletlere kurulduğunda maksimum kazılan alan artar. Kazılan alan menüden yapılandırılabilir."
	]
	quest.6720F863B907A5F1.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Yaydan (bow) ateşlenen Potion Arrows'un bir Lingering (Kalıcı) etkiye sahip olmasını sağlayarak zamanla bir alana etkiler uygular."
	]
	quest.6737CB17D562B134.quest_desc: ["Sadece kendine verilen eşya ile tıklayan basit bir tıklayıcı (clicker)."]
	quest.67B87570C340C243.title: "Zırh Yükseltmeleri"
	quest.6889EFC6CC291463.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etkinleştirildiğinde yakındaki mob'ları uzaklaştırır, bekleme süresi vardır."
	]
	quest.6A4D31194C4CE156.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Tree Feller"
