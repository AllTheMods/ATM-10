	]
	quest.48E4D75FD3145AD6.quest_desc: ["Time Fluid; Paradox Machine ve Time Wand tarafından kullanılır. Polymorphic Fluid içine bir Time Crystal atılarak elde edilir.\\n\\nElde etmesi meşakkatli bir kristal için bu kadar kolay bir sıvı tarifi sunulması büyük kolaylık."]
	quest.49636B3C6E6D0C2A.quest_desc: ["Herhangi bir işlevi yok ancak görsel olarak oldukça şık."]
	quest.4987759CF379C1EB.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Envanterinizde Time Crystal taşıdığınız sürece Yavaşlık ve Hız efektlerinin uygulanmasını engeller."
	]
	quest.49EF8A4346AEF582.quest_desc: ["Voidflame Fuel içine Eclipse Ember atmak Unrefined Eclipse Ember Fuel oluşturur. 4. aşama goo maddesiyle Goo Spread gerçekleştirmek bunu Eclipse Ember Fuel yakıtına dönüştürür."]
	quest.4A5937F6E5D06BE1.quest_desc: ["Just Dire Things sıvı yakıtlarıyla çalışan pratik bir jeneratör."]
	quest.4ACB72F3A23A5A19.quest_desc: [
