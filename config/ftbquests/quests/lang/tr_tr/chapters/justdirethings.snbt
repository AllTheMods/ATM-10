	quest.7305EE0F7D73C231.quest_desc: ["Blank Upgrade (Boş Yükseltme) şablonları tüm yeteneklerin temelini oluşturur. Yetenekler pasif ve aktif olarak ikiye ayrılır.\\n\\nPasif yetenekler kullanıcı müdahalesi olmadan kendiliğinden çalışır. Aktif yetenekler ise ayarlar menüsünde atadığınız tuşa basıldığında tetiklenir ve kullanımda dayanıklılık veya enerji tüketir. Üst kademe zırh ve aletlere takıldığında aktif yeteneklerin bekleme süreleri kısalır, pasif yeteneklerin etkisi ise güçlenir.\\n\\nSmithing Table (Demirci Masası), Just Dire Things ekipmanlarına yükseltme eklemek için kullanılır. Envanterde eşyanın üzerine gelip Shift tuşuna basarak uyumlu yükseltmeleri görebilirsiniz."]
	quest.73552A4BA0687962.quest_desc: ["Bu yükseltmeler hem aletlere hem de zırhlara takılabilir."]
	quest.7464CA1290B3474B.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Invulnerability"
	]
	quest.76B1C5AFC5D6B7CF.quest_desc: ["Time Wand, tıpkı Time in a Bottle gibi blokların çalışma hızını 128 katına kadar katlayabilir. Time in a Bottle'dan farklı olarak biriken zaman yerine FE enerjisi ve Time Fluid tüketir, bu da dolumunu son derece kolaylaştırır.\\n\\nAncak sahte oyuncu (fake player) otomasyonları için kara listeye alınmıştır. Bunu otomatikleştirmenize izin verilmemektedir!"]
	quest.76B1C5AFC5D6B7CF.quest_subtitle: "Time in a Bottle'ın Kuzeni"
	quest.78840993C7832E89.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Drops Teleporter"
		"- Instant Break"
	]
	quest.79BBCC1BEE90DBBB.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Ölümcül darbe aldığınızda hayatta kalmanızı sağlar (uzun bir bekleme süresine sahiptir). Bir nevi harcanmayan, bekleme süreli Ölümsüzlük Totemi işlevi görür."
	]
	quest.7AEFF81E7C8CF300.quest_desc: ["Elinizde bir Just Dire Things aleti veya asası varken eğilerek sağ tıklamak, yetenekleri ayarlayıp aktif/pasif kılabileceğiniz yapılandırma menüsünü açar."]
	quest.7B9486981786AC47.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etraftaki yaratıkların yapay zekasını kalıcı olarak devre dışı bırakır. Enerji maliyetinden ötürü tek kullanımda en fazla 5 yaratığı etkiler ve uzun bir bekleme süresi bulunur."
	]
	quest.7D1D2A4E07E98709.quest_desc: ["Önündeki blokları kırmak için haznesinde bir alet gerektiren basit bir blok kırıcı."]
	quest.7F0B2D58361FB00E.quest_desc: ["Just Dire Things, oldukça çok yönlü bir teknoloji modudur. Goo Spread (Goo Yayılımı) adında yeni bir dönüşüm mekaniği ve otomasyonu kolaylaştıran çeşitli kullanışlı makineler sunar."]
	quest.7F0B2D58361FB00E.title: "Just Dire Things"
