	quest.3C8C80345D3F5FE8.quest_desc: ["Eşya toplayıcı (item collector) eşyaları toplar ve altındaki envantere koyar."]
	quest.3CBB78C9B8D3665E.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Düşman mob'ların tespit menzilini azaltır."
	]
	quest.3CFD798362605880.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Bow tarafından ateşlenen Potion Arrows'un (İksir Okları) bir Splash etkisine sahip olmasını sağlayarak bir alandaki birden fazla hedefi vurur."
	]
	quest.3D9964CB0440DD5A.quest_desc: ["Blaze Ember'ı Polymorphic Fluid'e düşürmek Unrefined Blaze Ember Fuel yaratacaktır. İkinci Seviye veya daha yüksek goo ile Goo Spread yapmak, Unrefined Blaze Ember Fuel'i Blaze Ember Fuel'e dönüştürecektir."]
	quest.3F3559EF5D08B706.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Okların (Arrows) hedeflerini aktif olarak aramasını sağlar."
	]
	quest.40C5C355B6DA1893.quest_desc: ["Pocket Generator, oyuncunun envanterindeki eşyaları ve aletleri şarj etmek için yakılabilir eşyalar kullanan el tipi bir jeneratördür, Pocket Generator, Fuel Canister ile uyumludur."]
	quest.41E8C93A44559E48.quest_desc: ["&7Paradox Machine&r, çok fazla Güç ve &aTime Fluid&r karşılığında, belirlenen alandaki blokların ve varlıkların (entities) Anlık Görüntüsünü (Snapshot) alabilir; ardından onu çoğaltabilir. \\n\\nBirçok Blok ve Varlık yapılandırmalar tarafından kara listeye alınmıştır, yani Arıları çoğaltmak yok!"]
	quest.433117EEA55B6A54.quest_desc: ["Sadece basit bir sıvı yerleştirici (fluid placer)."]
	quest.441F37A95AB66E6B.quest_desc: ["Bu Görev, &6AllTheMods Ekibi&r veya AllTheMods Modpaketlerinde kullanılmak üzere bir &2Topluluk katılımcısı&r tarafından hazırlanmıştır. \\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r kapsamında lisanslandığından, bu Görevin &6AllTheMods Ekibi&r tarafından yayınlanmayan hiçbir halka açık pakette açık izin olmadan kullanılmasına izin verilmez. \\n\\nBu görev kasıtlı olarak gizlenmiştir, eğer bunu görüyorsanız, düzenleme modundasınız demektir."]
	quest.4458F8829800A950.quest_desc: ["Polymorphic Fluid, JDT'deki tüm Sıvıların / Yakıtların temelidir. Polymorphic Fluid, Polymorphic Catalyst'i suya düşürerek üretilir."]
	quest.446A37C7FCDACF84.quest_desc: ["Voidflame Coal, JDT tarafından eklenen yeni bir materyaldir. Voidflame, üçüncü seviye veya daha yüksek bir goo kullanılarak Blaze Ember Blocks üzerinde Goo Spread gerçekleştirilerek elde edilir. Voidflame Coal Ore, fortune büyüsünden etkilenir."]
	quest.454662617304E299.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Pantolona (leggings) uygulandığında oyuncunun blokların içinden yürümesine izin verir. İçinden geçilemeyecek blokları kara listeye almak için bir blok etiketi (block tag) vardır."
		"Bir yaya (bow) uygulandığında, okların duvarlardan geçmesine (phase) izin verir."
	]
	quest.454CA1F8CC198D9D.quest_desc: [
