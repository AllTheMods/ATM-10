	quest.3971FF7D044D1FE5.quest_desc: ["Zırh yetenekleri yapılandırma menüsünden ayarlanabilir ve açılıp kapatılabilir. Menüyü açmak için bir JDT aleti veya asası kullanın ve o zırh parçasının yeteneklerini yapılandırmak için zırhınıza tıklayın."]
	quest.3A471716A29F5172.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Oyuncuya bir Elytra sağlar, bu yükseltme tarafından sağlanan Elytra'nın Walk ve Run Speed yükseltmelerinden etkilendiğini unutmayın."
	]
	quest.3AE1811C32B94A66.quest_desc: [
