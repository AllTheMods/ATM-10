	quest.5B02719C13B1FFE2.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Fırlatma mesafesi daha da artırıldı."
		"- Void Shift: Işınlanma mesafesi artırıldı."
		"- Eclipse Gate: 3x3'lük bir alanda taşınabilir bir delik oluşturur, yön hedeflenen bloğun yüzüne bağlıdır. Oluşturulan deliğin mesafesi yapılandırılabilir. Eclipse Gate'in tile entity'lerde çalışmadığını unutmayın."
	]
	quest.5B910F1389C0B915.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Fırlatma mesafesi artırıldı ve FE tüketiyor."
		"- Void Shift: Oyuncuyu baktığı yöne doğru ışınlayarak bu süreçte FE tüketir."
	]
