	quest.3971FF7D044D1FE5.quest_desc: ["Zırh yetenekleri yapılandırma menüsü üzerinden ayarlanabilir ve açılıp kapatılabilir. Menüyü açmak için elinize bir Just Dire Things aleti veya asası alıp zırh parçanıza sağ tıklayın."]
	quest.3A471716A29F5172.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Kullanıcıya Elytra süzülme yeteneği kazandırır. Bu yükseltmenin sağladığı uçuş hızının Yürüme ve Koşma Hızı yükseltmelerinden doğrudan etkilendiğini unutmayın."
	]
	quest.3AE1811C32B94A66.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Alev aldığınızda sizi anında söndürür. Bekleme süresi vardır."
	]
	quest.3B3E3D81843BB358.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
