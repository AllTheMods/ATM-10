	quest.5B02719C13B1FFE2.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Fırlatma mesafesi önemli ölçüde artırıldı."
		"- Void Shift: Işınlanma menzili genişletildi."
		"- Eclipse Gate: Hedeflenen yüzeyde 3x3 boyutunda geçici bir delik açar. Geçit derinliği ayarlanabilir. Eclipse Gate yeteneğinin konteyner ve makine bloklarında (tile entity) çalışmadığını unutmayın."
	]
	quest.5B910F1389C0B915.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Fırlatma mesafesi artırıldı; çalışma esnasında FE tüketir."
		"- Void Shift: Kullanıcıyı baktığı yöne doğru ışınlar; işlem sırasında FE tüketir."
	]
	quest.5BBE8B30ED7518B8.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Ore Scanner &4&lDEVRE DIŞI&r&f"
	]
	quest.5BD5737703F3F077.quest_desc: ["Ferricore, Just Dire Things ile eklenen yeni bir malzemedir. Demir blokları üzerinde 1. aşama veya üzeri bir goo ile Goo Spread uygulanarak elde edilir. Ferricore cevheri Servet büyüsünden etkilenir."]
	quest.5BD5737703F3F077.title: "Ferricore"
	quest.5C6709350BEF4050.quest_desc: [
		"Voidshimmer Goo, modun üçüncü aşama goo maddesidir. Üretimi End boyutu bileşenleri gerektirir."
		""
		"Açılan Üretimler:"
		"- Celestigem"
		"- Void Flame"
	]
	quest.5D4E51471F3939E0.quest_desc: [
		"Yetenekler:"
		"- Air Burst: Kullanıcıyı baktığı yöne doğru fırlatır ve dayanıklılık tüketir. Daha üst seviye asalar daha uzağa fırlatır. Asayı elinizde tuttuğunuz sürece düşme hasarı almazsınız."
	]
	quest.5EE7D5DE07A83C7D.quest_desc: ["&lYetenek Türü:&r Aktif\\n\\n&lYetenek İşlevi:&r\\n\\nEtkinleştirildiğinde etraftaki cevherleri yeşil parçacıklarla belirginleştirir.\\n\\n&4&lBU YETENEK DEVRE DIŞI BIRAKILMIŞTIR.&r&f"]
	quest.5F5120451BA5B2FE.quest_desc: ["Gelişmiş makineler basit modellerinin tüm özelliklerini barındırır. Ek olarak ayarlanabilir çalışma alanı, genişletilmiş filtre yuvaları sunar ve enerji tüketir."]
	quest.60A4994078500F63.quest_desc: ["Celestigem, Just Dire Things ile eklenen yeni bir malzemedir. Elmas blokları üzerinde 3. aşama veya üzeri goo maddesiyle Goo Spread uygulanarak elde edilir. Celestigem cevheri Servet büyüsünden etkilenir."]
	quest.61213012615619C5.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Düşmanları katlettiğinizde düşen et ve gıdaları otomatik olarak tütsüler."
	]
	quest.636854555AD75DC3.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Düşen eşyaları otomatik olarak alete bağlı depoya ışınlar. Alet elinizdeyken bir depoya eğilerek sağ tıklamak bağlantıyı sağlar. Just Dire Things çapalarında Voidshimmer/Shadowpulse tarım arazisinin otomatik hasat yeteneğiyle toplanan mahsuller de bu depoya aktarılır. Depoyu değiştirdiğinizde tarım arazisine sağ tıklayarak bağlantıyı güncelleyebilirsiniz."
	]
	quest.6690AEE064DC2A7C.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:"
		""
		"Tek seferde kazılan etki alanını genişletir. Üst seviye aletlere takıldığında kazı alanı daha da büyür. Etki alanı ayarlar menüsünden yapılandırılabilir."
	]
	quest.6720F863B907A5F1.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Ateşlenen iksirli okların kalıcı bir etki alanı (Lingering) bırakmasını ve zamana yayılan iksir etkisi uygulamasını sağlar."
	]
	quest.6737CB17D562B134.quest_desc: ["Haznesindeki eşyayla otomatik tıklama gerçekleştiren basit bir otomatik tıklayıcı."]
	quest.67B87570C340C243.title: "Zırh Yükseltmeleri"
	quest.6889EFC6CC291463.quest_desc: [
		"&lYetenek Türü:&r Aktif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Etkinleştirildiğinde yakındaki yaratıkları geriye iter. Bekleme süresi vardır."
	]
	quest.6A4D31194C4CE156.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Ore Miner"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
		"- X-Ray"
		"- Instant Break"
	]
	quest.6ADE6F9E004055F7.quest_desc: [
		"Time Crystal (Zaman Kristali), Just Dire Things ile eklenen özel bir malzemedir. Tomurcuklanmış Amatis veya Time Crystal bloklarında Goo Spread uygulanarak elde edilen Budding Time Crystal (Filizlenen Zaman Kristali) bloklarında yetişir.\\n\\nANCAK bu bloğun Zaman Kristali Kümeleri yetiştirebilmesi için &9Overworld&r, &6Nether&r ve &aThe End&r boyutlarından sırayla zaman emmesi gerekir. Filizlenen Zaman Kristali blokları kazmayla veya İpeksi Dokunuş ile kırılıp alınamaz. Taşımak için Swapper, Karton Box veya Cut Paste Gadget kullanmalısınız.\\n\\nBelirli bir süre sonra bloğun &2şarjı tükenecektir&r ve tekrar &9Overworld&r, &6Nether&r ve &aThe End&r yolculuğuna çıkarılması gerekecektir."
		"{@pagebreak}"
		"Bu süreci otomatikleştirmek için görev başlığındaki görselde bağlantısı verilen videoyu inceleyebilirsiniz.\\n\\nÖnceki sayfadaki &2r&9en&6k k&aodlaması&r karmaşık geldiyse, blok aşamalarını ayırt etmeniz için aşağıya bir referans görseli ekledik."
		""
		"{image:atm:textures/questpics/justdirethings/budding_time_crystal_reference.png width:250 height:125 align:center}"
	]
	quest.6ADE6F9E004055F7.quest_subtitle: "Zamanla İlgili Şeyler"
	quest.6ADE6F9E004055F7.title: "Time Crystal"
	quest.6D9CFCD81A23BB3B.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Oyuncuyu lav hasarına karşı tamamen bağışık kılar."
	]
	quest.6F709652A2B88C78.quest_desc: ["Energy Transmitter, etki alanındaki bloklara kablosuz enerji aktarır. Yalnızca alt yüzünden enerji girişi kabul eder."]
	quest.6FD4C60B547F4131.quest_desc: [
