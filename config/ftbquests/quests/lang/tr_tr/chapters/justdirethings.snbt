	]
	quest.48E4D75FD3145AD6.quest_desc: ["Time Fluid, Paradox Machine ve Time Wand tarafından kullanılır. Polymorphic Fluid içine bir Time Crystal düşürülerek elde edilir.\\n\\nElde etmesi çok zor bir kristal için, bize kolay bir sıvı verdiklerine sevindim."]
	quest.49636B3C6E6D0C2A.quest_desc: ["Hiçbir kullanımı yok, yine de havalı görünüyor."]
	quest.4987759CF379C1EB.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Envanterinizde Time Crystals varken yavaşlık (slowness) ve hız (speed) efektlerinin verilmesini engeller."
	]
	quest.49EF8A4346AEF582.quest_desc: ["Eclipse Ember'ı Voidflame Fuel içine düşürmek Unrefined Eclipse Ember Fuel yaratacaktır. Dördüncü Seviye goo ile Goo Spread yapmak, Unrefined Eclipse Ember Fuel'i Eclipse Ember Fuel'e dönüştürecektir."]
	quest.4A5937F6E5D06BE1.quest_desc: ["JDT tarafından eklenen sıvı yakıtlarla çalışan basit bir sıvı yakıt jeneratörü."]
