		"- Run Speed"
		"- Walk Speed"
		"- Swim Speed"
		"- Decoy"
	]
	quest.3C8C80345D3F5FE8.quest_desc: ["Item Collector, etraftaki sahipsiz eşyaları toplayarak doğrudan altındaki depoya yerleştirir."]
	quest.3CBB78C9B8D3665E.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Düşman yaratıkların sizi fark etme mesafesini düşürür."
	]
	quest.3CFD798362605880.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Ateşlenen iksirli okların alan etkili (Splash) patlama yapmasını ve tek seferde birden çok hedefi etkilemesini sağlar."
	]
	quest.3D9964CB0440DD5A.quest_desc: ["Blaze Ember kristalini Polymorphic Fluid içine atmak Unrefined Blaze Ember Fuel oluşturur. 2. aşama veya üzeri bir goo ile Goo Spread uygulamak bunu saf Blaze Ember Fuel yakıtına dönüştürür."]
	quest.3F3559EF5D08B706.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Atılan okların kendiliğinden en yakın hedefe yönelmesini ve takip etmesini sağlar."
	]
	quest.40C5C355B6DA1893.quest_desc: ["Pocket Generator, envanterinizdeki araç gereçleri şarj etmek için yakıt tüketen taşınabilir bir jeneratördür. Fuel Canister ile tam uyumlu çalışır."]
	quest.41E8C93A44559E48.quest_desc: ["&7Paradox Machine&r, yüksek miktarda enerji ve &aTime Fluid&r karşılığında belirlenen alandaki blok ve varlıkların anlık durumunu kaydederek kopyalayabilir.\\n\\nBirçok blok ve varlık sunucu ayarlarıyla kara listeye alınmıştır, yani Arıları kopyalayamazsınız!"]
	quest.433117EEA55B6A54.quest_desc: ["Ortama otomatik sıvı yerleştiren basit bir blok."]
	quest.441F37A95AB66E6B.quest_desc: ["Bu görev &6AllTheMods Ekibi&r veya bir &2topluluk üyesi&r tarafından AllTheMods paketlerinde kullanılmak üzere hazırlanmıştır.\\n\\nTüm &6AllTheMods&r paketleri &eTüm Hakları Saklıdır&r lisansı altında korunduğundan, AllTheMods ekibinin izni olmadan başka paketlerde kullanılması yasaktır.\\n\\nBu görev gizlenmiştir; görüyorsanız düzenleme modundasınız demektir."]
	quest.4458F8829800A950.quest_desc: ["Polymorphic Fluid, Just Dire Things bünyesindeki tüm özel sıvı ve yakıtların hammaddesidir. Suya bir Polymorphic Catalyst atılarak elde edilir."]
	quest.446A37C7FCDACF84.quest_desc: ["Voidflame Coal, Just Dire Things ile eklenen yeni bir malzemedir. Blaze Ember bloklarının üzerine 3. aşama veya üzeri goo maddesiyle Goo Spread uygulanarak elde edilir. Voidflame Coal cevheri Servet büyüsünden etkilenir."]
	quest.454662617304E299.quest_desc: [
		"&lYetenek Türü:&r Pasif"
		""
		"&lYetenek İşlevi:&r"
		""
		"Pantolona uygulandığında blokların içinden geçebilmenizi sağlar. Geçilemeyecek bloklar blok etiketleriyle kısıtlanabilir."
		"Yaya uygulandığında atılan okların duvarların içinden geçip hedefe ulaşmasını sağlar."
	]
	quest.454CA1F8CC198D9D.quest_desc: [
		"Geçerli Yükseltmeler:"
		"- Step Assist"
		"- Jump Boost"
	]
	quest.45A25221F54A1DEC.quest_desc: ["Ferricore Wrench, makinelerin yönünü değiştirmeyi sağlar. Ayrıca Swapper bloklarını birbiriyle eşleştirmek için kullanılır."]
