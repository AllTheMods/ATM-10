{
	quest.010607466D565B53.quest_desc: ["Złap kontakt z Matką Naturą, człowieku. \\n\\nW &aRooted Boots&r natura jest Twoim najlepszym przyjacielem! Gdy stoisz na trawie, regenerujesz serca. Poza tym, gdy jesz, stojąc na trawie, działa to tak, jakbyś użył na niej mączki kostnej."]
	quest.010607466D565B53.quest_subtitle: "Stopy"
	quest.010607466D565B53.title: "&aRooted Boots"
	quest.0A1D4228271DECA3.quest_desc: ["Gdzie się podziałeś?\\n\\nAch, po prostu jesteś o połowę mniejszy niż wcześniej. Na tyle mały, że zmieścisz się pod przerwą o wysokości 1 bloku."]
	quest.0A1D4228271DECA3.quest_subtitle: "Naszyjnik"
	quest.0A1D4228271DECA3.title: "&5Charm of Shrinking&r"
	quest.0E716B90E60C486B.quest_desc: ["Czasem najlepszym sposobem walki jest nie walczyć... tylko uciec! \\n\\nGdy dostaniesz cios, &4Panic Necklace&r da Ci na krótki czas efekt Speed. Akurat tyle, by uciec!"]
	quest.0E716B90E60C486B.quest_subtitle: "Naszyjnik"
	quest.0E716B90E60C486B.title: "&4Panic Necklace&r"
	quest.11C5F17C6BB1237B.quest_desc: ["Gdy nosisz &5Withered Bracelet&r, ataki w zwarciu mają szansę nałożyć efekt Wither.\\n\\nPrzykro mi, łucznicy!"]
	quest.11C5F17C6BB1237B.quest_subtitle: "Nadgarstki (Dłonie)"
	quest.11C5F17C6BB1237B.title: "&5Withered Bracelet&r"
	quest.122E6E7CABCB17E7.quest_desc: ["Z jakiegoś powodu Creepery boją się kotów. Są też skrajnie głupie i wierzą, że koty, które przypominają Twoje &7kapcie&r, są prawdziwe.\\n\\nWszystkie Creepery będą przed Tobą uciekać i nie będą wrogie, gdy nosisz te &7kapcie&r.\\n\\nWydają też kocie dźwięki, gdy otrzymasz obrażenia! (Nie zapewniam jednak, że zawsze wylądujesz na czterech łapach)."]
	quest.122E6E7CABCB17E7.quest_subtitle: "Stopy"
	quest.122E6E7CABCB17E7.title: "&7Kitty Slippers&r"
	quest.145E7D1A88B83DDD.quest_desc: ["Gdzie się podziałeś?"]
	quest.145E7D1A88B83DDD.quest_subtitle: "Szalik (Naszyjnik)"
	quest.145E7D1A88B83DDD.title: "&9Scarf of Invisibility&r"
	quest.161A90E134592D0E.quest_desc: ["Podobnie jak zwykłe Raw Beef, &cEverlasting Beef&r można upiec, by dostać &4Eternal Steak&r!\\n\\nDziała tak samo jak &cEverlasting Beef&r, ale daje więcej punktów głodu i Saturation."]
	quest.161A90E134592D0E.quest_subtitle: "Unikat"
	quest.161A90E134592D0E.title: "&4Everlasting Steak"
	quest.16255FB20F35A9D9.quest_desc: ["&3Snorkel&r daje Ci niewielką ilość efektu Water Breathing, gdy wejdziesz do &9wody&r. Podobnie jak Turtle Helmet! Uważaj jednak, bo się wyczerpuje."]
	quest.16255FB20F35A9D9.quest_subtitle: "Głowa"
	quest.16255FB20F35A9D9.title: "&3Snorkel"
	quest.19B393433FB0C62F.quest_desc: ["Sekret chodzenia Striderów po &cLawie&r tkwi w ich nogach. Więc zabraliśmy im te nogi i dajemy je Tobie! \\n\\nGdy się skradasz, możesz bezpiecznie chodzić po &cLawie&r! Gdy przestaniesz się skradać, wpadniesz jednak do &cLawy&r. Pozwalają też bezpiecznie chodzić po blokach magmy i innych gorących blokach!"]
	quest.19B393433FB0C62F.quest_subtitle: "Stopy"
	quest.19B393433FB0C62F.title: "&4Strider Shoes&r"
	quest.1E40ACF3E69A4100.quest_desc: ["Czy trzeba to wypić? Nie wiem, chyba po prostu tam siedzi i działa... \\n\\nGdy masz &6Antidote Vessel&r, negatywne efekty (jak Wither czy Poison) będą trwać krócej! Bardzo pomocne w starciu z Witches lub Wither Skeletons."]
	quest.1E40ACF3E69A4100.quest_subtitle: "Pas"
	quest.1E40ACF3E69A4100.title: "&6Antidote Vessel&r"
	quest.2215FB0777D7029D.quest_desc: ["Kolce, korki, raki - czymkolwiek są! \\n\\n&7Steadfast Boots&r utrzymują Cię stabilnie na nogach. Ataki nie odrzucą Cię, a na lodzie już się nie poślizgniesz."]
	quest.2215FB0777D7029D.quest_subtitle: "Stopy"
	quest.2215FB0777D7029D.title: "&7Steadfast Boots&r"
	quest.221C9EDA651144BA.quest_desc: ["Jaka &9woda&r? \\n\\nZ &3Charm of Sinking&r poruszasz się w &9wodzie&r jak w powietrzu! Pod wodą nadal jednak nie da się oddychać..."]
	quest.221C9EDA651144BA.quest_subtitle: "Naszyjnik"
	quest.221C9EDA651144BA.title: "&3Charm of Sinking&r"
	quest.2607F3DC07049785.quest_desc: ["Po co tracić czas na siadanie i jedzenie przyzwoitego domowego posiłku, skoro możesz po prostu szybko jeść i pić! \\n\\nW tym bardzo stylowym &6kapeluszu&r jedzenie i picie jest znacznie szybsze."]
	quest.2607F3DC07049785.quest_subtitle: "Głowa"
	quest.2607F3DC07049785.title: "&6Plastic Drinking Hat"
	quest.27E951F4F4F6F847.quest_desc: ["Podobny do &aThorn Pendant&r, tylko trochę gorętszy. Nie, czekaj, znacznie gorętszy! \\n\\n&cFlame Pendant&r ma szansę podpalić Twoich napastników! Gdy płoną, &cPendant&r da Ci też Fire Resistance."]
	quest.27E951F4F4F6F847.quest_subtitle: "Naszyjnik"
	quest.27E951F4F4F6F847.title: "&cFlame Pendant&r"
	quest.29448D08C8777425.quest_desc: ["Dziś w nocy będzie spał z rybami. \\n\\n&cAngler Hat&r pomaga wabić ryby i zwiększa szansę na zdobycie rzadkiego dropu!"]
	quest.29448D08C8777425.quest_subtitle: "Głowa"
	quest.29448D08C8777425.title: "&cAngler's Hat"
	quest.2AD78E22988A92D3.quest_desc: ["Widzę Cię! \\n\\nGdy masz na sobie &2Night Vision Goggles&r, możesz widzieć w ciemności! Nic więcej w nich nie ma..."]
	quest.2AD78E22988A92D3.quest_subtitle: "Głowa"
	quest.2AD78E22988A92D3.title: "&2Night Vision Goggles"
	quest.321F16645640C462.quest_desc: ["Ender Pearls to fajny sposób podróżowania! (Przydatne w Bumblezone, ciekawe, czy dostaniemy rozdział zadań dla tego moda!) Ale czy nie wkurza Cię, że Ender Pearl jest zużywana przy użyciu i zadaje 2 serca obrażeń za każdym razem? \\n\\nZ &9Warp Drive&r to wszystko znika, co jasno pokazuje, że Ender Pearls to najlepszy środek transportu! Zamiast Ender Pearl zużywany jest głód i nie dostajesz już obrażeń od użycia Ender Pearl. Gdy wszystkie paski głodu się wyczerpią, wróci do zużywania Ender Pearls."]
	quest.321F16645640C462.quest_subtitle: "Pas"
	quest.321F16645640C462.title: "&9Warp Drive&r"
	quest.3446803FB59D8875.quest_desc: ["Daje Ci Thorns. Nie Twojej zbroi, Tobie! Jak Pufferfish!"]
	quest.3446803FB59D8875.quest_subtitle: "Naszyjnik"
	quest.3446803FB59D8875.title: "&aThorn Pendant&r"
	quest.3525D5DCC3A534D9.quest_desc: ["To jedne z moich ulubionych! \\n\\n&9Digging Claws&r zwiększają Twoją prędkość kopania (w zasadzie o poziom Efficiency na wszystkich kilofach), a Twoje pięści działają jak Stone Pickaxe! \\n\\nSuper przydatne do budowania i w ogóle do zabawy!"]
	quest.3525D5DCC3A534D9.quest_subtitle: "Dłonie"
	quest.3525D5DCC3A534D9.title: "&9Digging Claws&r"
	quest.3705D303CF423804.quest_desc: ["Druga strona &aFeral Claws&r - zwiększają obrażenia, które zadajesz, gdy je nosisz."]
	quest.3705D303CF423804.quest_subtitle: "Dłonie"
	quest.3705D303CF423804.title: "&ePower Glove&r"
	quest.3B3BD39BA02DCA13.quest_desc: ["Z &6Pocket Piston&r Twoje ataki odrzucą Twoich wrogów znacznie dalej! \\n\\nCiekawe, co wygra: &6Pocket Piston&r czy &7Steadfast Boots&r?"]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Dłonie"
	quest.3B3BD39BA02DCA13.title: "&6Pocket Piston&r"
	quest.3E0643EA9183CDAE.quest_desc: ["'To był jego kapelusz, panie Krabs! Był numerem 1!' \\n\\nRobi dokładnie to samo co zwykły &6Drinking Hat&r, tylko wygląda znacznie fajniej!"]
	quest.3E0643EA9183CDAE.quest_subtitle: "Głowa"
	quest.3E0643EA9183CDAE.title: "&9Novelty Drinking Hat"
	quest.3E1A3BC8642390B3.quest_desc: ["'Jestem Mary Poppins, ludzie!' \\n\\n&4The Umbrella&r to bardzo przydatne narzędzie dodane przez &l&3Artifacts&r! Można ją trzymać przed sobą jak tarczę, przytrzymując prawy przycisk myszy. Albo użyć jej do spowolnienia upadku, po prostu trzymając ją w ręku! "]
	quest.3E1A3BC8642390B3.quest_subtitle: "Unikat"
	quest.3E1A3BC8642390B3.title: "&4Umbrella&r"
	quest.3EC8A0B89788D079.quest_desc: ["Nie mam rąk, mam &9Flippers&r. \\n\\n&9Flippers&r działają jak znacznie lepszy Depth Strider. Możesz pływać i chodzić w &9wodzie&r znacznie szybciej!"]
	quest.3EC8A0B89788D079.quest_subtitle: "Stopy"
	quest.3EC8A0B89788D079.title: "&9Flippers&r"
	quest.427014BDE06DE631.quest_desc: ["Wszystko, w co uderzę, staje w płomieniach!!!!!"]
	quest.427014BDE06DE631.quest_subtitle: "Dłonie"
	quest.427014BDE06DE631.title: "&cFire Gauntlet&r"
	quest.436E4E3515BCCDE9.quest_desc: ["Z założonym &bCloud in a Bottle&r możesz dwukrotnie nacisnąć Spację, by wykonać podwójny skok! Bardzo przydatne w parkourze! \\n\\nZwiększa też wysokość, z jakiej możesz spaść, tak jak &dBunny Hoppers&r!"]
	quest.436E4E3515BCCDE9.quest_subtitle: "Pas"
	quest.436E4E3515BCCDE9.title: "&bCloud in a Bottle&r"
	quest.4564B577CB4EC046.quest_desc: ["Gdy będziesz mordować setki krów, możesz trafić na rzadką wołowinę. Nie tę z chorobą szalonych krów, tylko &cEverlasting Beef&r!\\n\\n&cEverlasting Beef&r można zjeść jak zwykłe Raw Beef, ale nie znika po zjedzeniu! Zamiast tego ma czas odnowienia, zanim znów będziesz mógł ją zjeść.\\n\\n(Działa też z plecakami z automatycznym karmieniem!)"]
	quest.4564B577CB4EC046.quest_subtitle: "Unikat"
	quest.4564B577CB4EC046.title: "&cEverlasting Beef&r"
	quest.4933CF4675E77D50.quest_desc: ["Po otrzymaniu obrażeń od ognia &5Obsidian Skull&r aktywuje się i da Ci okres Fire Resistance. Miejmy nadzieję, że wystarczająco długi, by uciec z płomieni!"]
	quest.4933CF4675E77D50.quest_subtitle: "Pas"
	quest.4933CF4675E77D50.title: "&5Obsidian Skull&r"
	quest.4A7AEBEB87CEC274.quest_desc: ["Chyba nie mam pozwolenia na użycie konkretnej marki &cRunning Shoes&r, więc użyj wyobraźni, żeby domyślić się, o którą chodzi. \\n\\n&cRunning Shoes&r dają Ci zwiększoną prędkość podczas sprintu, więc będziesz jeszcze szybszy podczas biegu! Dają też automatyczny skok podczas sprintu..."]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Stopy"
	quest.4A7AEBEB87CEC274.title: "&cRunning Shoes&r"
	quest.4D3379D38237F830.quest_desc: ["Gdy masz &bje&r na stopach, możesz dokonać cudu: chodzić po &9wodzie&r!\\n\\nTak naprawdę biegać po &9wodzie&r - musisz sprintować, aby móc biec po &9wodzie&r. Gdy przestaniesz sprintować, zaczniesz tonąć."]
	quest.4D3379D38237F830.quest_subtitle: "Stopy"
	quest.4D3379D38237F830.title: "&bAqua-Dashers&r"
	quest.5040B3D29F238BC0.quest_desc: ["Króliczek, hop. Króliczek, hop. Króliczek, hop.\\n\\nZ &dBunny Hoppers&r skaczesz dwa razy wyżej i otrzymujesz o połowę mniej obrażeń od upadku niż zwykle! Nie czyni Cię to niewrażliwym na obrażenia od upadku, nadal możesz zginąć, tylko trudniej."]
	quest.5040B3D29F238BC0.quest_subtitle: "Stopy"
	quest.5040B3D29F238BC0.title: "&dBunny Hoppers&r"
	quest.50A32AC6EDBC5854.quest_desc: ["Samo jedzenie bywa dość nudne, ale jest znacznie lepsze, gdy do dania masz dodatek! A konkretnie (a) &6Onion Ring&r!\\n\\nGdy nosisz &6Onion Ring&r, wszystko, co zjesz, da Ci lekki Haste."]
	quest.50A32AC6EDBC5854.quest_subtitle: "Dłonie"
	quest.50A32AC6EDBC5854.title: "&6Onion Ring&r"
	quest.589F1D502F680075.quest_desc: ["Idealne na imprezy przy basenie! \\n\\nPoza tym, że wygląda uroczo i zabawnie, &dHelium Flamingo&r pozwala pływać w powietrzu. Tak, dobrze słyszałeś! Pływać... w... powietrzu... \\n\\nGdy jesteś w powietrzu, np. podczas skoku, możesz nacisnąć CTRL, by zacząć pływać w powietrzu. Możesz poruszać się tak jak w wodzie: płyń w górę, płyń w dół, płyń wszędzie!"]
	quest.589F1D502F680075.quest_subtitle: "Pas"
	quest.589F1D502F680075.title: "&dHelium Flamingo&r"
	quest.5CE44C58A470E48E.quest_desc: ["&l&3Artifacts&r to wspaniały mod, który dodaje &l&3Artifacts&r, dzięki którym Twoja gra w Minecrafta będzie znacznie łatwiejsza i przyjemniejsza!\\n\\nWszystkie &l&3Artifacts&r można znaleźć podczas eksploracji, archeologii lub zabijania Mimiców!\\n\\nMimici występują w obozach pod ziemią i wyglądają jak zwykłe skrzynie! Ale gdy podejdziesz zbyt blisko, zaatakują!"]
	quest.5CE44C58A470E48E.title: "&l&3Artifacts"
	quest.5DE7C4FD5FA29236.quest_desc: ["Nie wkurza Cię, gdy już masz zabić Endermana, a on się teleportuje? No dobra, nie wkurza Cię, Ty to kochasz! Jesteś po prostu zły, bo zazdrościsz! Chcesz tego! \\n\\nI z &5Chorus Belt&r możesz to mieć! Teleportujesz się przy ciosie, który by Cię zabił."]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Pas"
	quest.5DE7C4FD5FA29236.title: "&5Chorus Belt&r"
	quest.5EB7CE3A1DCD3E9B.quest_desc: ["To &cMagnes&r."]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Pas"
	quest.5EB7CE3A1DCD3E9B.title: "&cUniversal Attractor&r"
	quest.5F5E43B3F51CAE9E.quest_desc: ["'Są magicznie pyszne!' \\n\\n&aSuperstitious Hat&r daje dodatkowy poziom Looting przeciwko mobom, które zabijesz! \\n\\nSumuje się z zaklęciami! "]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Głowa"
	quest.5F5E43B3F51CAE9E.title: "&aSuperstitious Hat"
	quest.5FD6A738754F6013.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.623796B1D7981E59.quest_desc: ["'Spróbuj też Terrarii!'\\n\\nGdy go nosisz, zyskujesz 5 dodatkowych serc! Czyli 10 całych punktów zdrowia! W sumie domyślnie daje to 30 zdrowia."]
	quest.623796B1D7981E59.quest_subtitle: "Pas"
	quest.623796B1D7981E59.title: "&4Crystal Heart&r"
	quest.62622137648A4F56.quest_desc: ["Nie wkurza Cię konieczność wydobywania, a potem przetapiania rud za pomocą dwóch różnych przedmiotów? Teraz możesz być bardziej leniwy niż kiedykolwiek z &7Pickaxe Heater&r!\\n\\nGdy nosisz &7Pickaxe Heater&r, rudy, które wydobędziesz, zostaną automatycznie przetopione!\\n\\nMoże warto z nim uważać, jeśli chcesz przetwarzać rudy."]
	quest.62622137648A4F56.quest_subtitle: "Dłonie"
	quest.62622137648A4F56.title: "&7Pickaxe Heater&r"
	quest.6A452BFC8A967C39.quest_desc: ["Noszenie tych &apazurów&r sprawia, że czujesz się w określony sposób. Adrenalina pompuje, myśli cichną, siła rośnie jak nigdy!\\n\\nZ &aFeral Claws&r atakujesz znacznie szybciej swoją bronią lub pięściami."]
	quest.6A452BFC8A967C39.quest_subtitle: "Dłonie"
	quest.6A452BFC8A967C39.title: "&aFeral Claws&r"
	quest.6FBE5B5D5027B32C.quest_desc: ["Jak założysz ten tu &7kapelusz&r, to Twoje zwierzaki popędzą jak wiatr!\\n\\nA do tego jest ładny jak malowanie."]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Głowa"
	quest.6FBE5B5D5027B32C.title: "&7Cowboy Hat"
	quest.70C7D92844089DEB.quest_desc: ["Podobnie jak inne Pendants, ma szansę zranić napastnika, tylko Piorunem! \\n\\nSprawia też, że jeśli masz (nie)szczęście zostać uderzonym przez Piorun, nie zrani Cię."]
	quest.70C7D92844089DEB.quest_subtitle: "Naszyjnik"
	quest.70C7D92844089DEB.title: "&bShock Pendant&r"
	quest.7188DC06A28AE30E.quest_desc: ["Jak założysz ten &eGolden Hook&r, to dostaniesz więcej doświadczenia od wrogów przeciągniętych pod kilem!"]
	quest.7188DC06A28AE30E.quest_subtitle: "Dłonie"
	quest.7188DC06A28AE30E.title: "&eGolden Hook&r"
	quest.72D6265E35814927.quest_desc: ["W większości gier z systemem zdrowia i obrażeń istnieją klatki nietykalności. Po otrzymaniu obrażeń masz kilka klatek nietykalności, więc 1. nie zginiesz w jednej chwili od prostego ataku i 2. masz czas, by oddać cios. \\n\\nZ &eCross Necklace&r dostajesz kilka klatek nietykalności więcej. Co oznacza kilka dodatkowych szans na oddanie ciosu!"]
	quest.72D6265E35814927.quest_subtitle: "Naszyjnik"
	quest.72D6265E35814927.title: "&eCross Necklace&r"
	quest.73B73870B29DFAD9.quest_desc: ["Jeden z nas! Jeden z nas! \\n\\n&eVillager Hat&r sprawia, że Villagerzy wierzą, że jesteś z tej samej wioski, więc znoszą podatek od przyjezdnych. Wymiany z Villagerami są tańsze."]
	quest.73B73870B29DFAD9.quest_subtitle: "Głowa"
	quest.73B73870B29DFAD9.title: "&eVillager Hat"
	quest.73FC51144FC2DA52.quest_desc: ["W tej &7rękawicy&r wyssiesz życie z każdego wroga, którego uderzysz!\\n\\nAch tak, przepraszam, zapomniałem... bleh bleh blehhh!"]
	quest.73FC51144FC2DA52.quest_subtitle: "Dłonie"
	quest.73FC51144FC2DA52.title: "&7Vampiric Glove&r"
	quest.74B352457BF1541B.quest_desc: ["Jeśli jesteś taki jak ja albo każdy zdrowy na umyśle człowiek, nienawidzisz Powdered Snow. Na szczęście &l&3Artifacts&r daje nam narzędzie do radzenia sobie z nim! Rakiety śnieżne! \\n\\nRakiety śnieżne pozwolą Ci bezpiecznie chodzić po Powdered Snow, tak jak Leather Boots. Dostaniesz też zwiększoną prędkość podczas chodzenia po jakimkolwiek śniegu!"]
	quest.74B352457BF1541B.quest_subtitle: "Stopy"
	quest.7503823ACDDB0491.quest_desc: ["To i &aSuperstitious Hat&r dają Ci wszystkie szczęśliwe talizmany, jakich możesz potrzebować!\\n&2Lucky Scarf&r daje dodatkowy poziom Fortune Twoim kilofom."]
	quest.7503823ACDDB0491.quest_subtitle: "Szalik (Naszyjnik)"
	quest.7503823ACDDB0491.title: "&2Lucky Scarf&r"
	quest.789AF6D0A6321945.quest_desc: [
		"Ten najważniejszy! Najpotężniejszy! Najniebezpieczniejszy &l&3Artifact&r ze wszystkich!"
		"{@pagebreak}"
		"Nie jestem pewien, czy powinienem tłumaczyć, co robi - jest zbyt niebezpieczny!"
		"{@pagebreak}"
		"Jeśli jesteś pewien, że poradzisz sobie z jego mocą, to może czytaj dalej..."
		"{@pagebreak}"
		"Jeszcze nie jest za późno, by zawrócić!"
		"{@pagebreak}"
		"No dobra, ostrzegałem..."
		"{@pagebreak}"
		"Naciśnij Shift, by mieć szansę na puszczenie bąka, gdy masz założoną &dWhoopie Cushion&r."
	]
