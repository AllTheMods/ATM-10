{
	quest.051E0C85E7B71CE0.quest_desc: ["Zakładam, że już trochę kopałeś, prawda? W końcu to MINEcraft.\\n\\nZnajdziesz mnóstwo nowych rud, które mogą Cię zmylić, ale na początek możesz trzymać się materiałów z vanilli!\\n\\nMiedź jest powszechna i ma mnóstwo zastosowań, np. do &aOre Hammers&r czy &eDrawer Upgrades&r, więc zbierz jej sporo!\\n\\nŻelazo to prawdopodobnie jedna z najważniejszych rud, którą warto zbierać za każdym razem, gdy na nią trafisz. Świat modowanego MC w zasadzie działa na żelazie."]
	quest.051E0C85E7B71CE0.title: "Epoka &9Metali&r"
	quest.0F026D5A17CCCF51.quest_desc: ["&dNetherytowe&r przedmioty są ogólnie jeszcze lepsze i nie płoną w lawie! Ty jednak tak, nawet nosząc zbroję. Nie próbuj.\\n\\nZ tych przedmiotów można wytworzyć jedne z najlepszych narzędzi i zbroi w grze."]
	quest.0F026D5A17CCCF51.title: "&dPoziom Netherytu"
	quest.0F3D51FFD2FE8DCB.quest_desc: [
		"Mając kilof na poziomie diamentowym, wykopiesz &dObsidian&r. Z bloku Obsidian można stworzyć portal do &cNetheru&r.\\n\\nRamka portalu może mieć wiele rozmiarów, ale większość wybiera podstawowy kształt 'Drzwi'. To pusta ramka 4x5, do której potrzeba minimum 10 bloków Obsidian. Nie musisz używać Obsidian na rogi, tylko na samą ramkę!\\n"
		"{image:atm:textures/questpics/gettingstarted/example_netherportal.png width:175 height:201 align:1}"
	]
	quest.0F3D51FFD2FE8DCB.title: "&cCzas na Nether&r!"
	quest.110BF3A2BE85F911.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.110BF3A2BE85F911.title: "WszelkiePrawaZastrzeżone"
	quest.1E1EB7DC19DDCFB7.quest_desc: ["Aby wytworzyć netherytowe narzędzia i zbroję, musisz znaleźć &6Netherite Smithing Template&r w skrzyniach w Bastionach.\\n\\nMożna go połączyć ze sztabką &cNetherite&r i diamentowym narzędziem lub częścią zbroi w &aSmithing Table&r, aby ulepszyć ją do poziomu &cNetherite&r.\\n\\nWskazówka: Nie zużywaj wszystkich szablonów naraz! Możesz stworzyć duplikaty, używając receptury, aby wytworzyć kolejny."]
	quest.1E1EB7DC19DDCFB7.title: "&6Szablon Netherytu&r"
	quest.24C9BA6DC32CFAD9.quest_desc: ["Węgiel to Twoje pierwsze prawdziwe źródło energii. Jeśli masz go mało i nie możesz znaleźć żadnego, alternatywą jest Charcoal."]
	quest.24C9BA6DC32CFAD9.quest_subtitle: "Przepal swoje pnie"
	quest.24C9BA6DC32CFAD9.title: "Węgiel"
	quest.282CE3A088AE5CFB.quest_desc: ["Zakładam, że już coś wytwarzałeś, prawda? W końcu to mineCRAFT.\\n\\nOczywiście możesz wytwarzać w ekwipunku na siatce wytwarzania 2x2, ale daleko tak nie zajdziesz. Czas na ulepszenie, czyli Crafting Table!"]
	quest.282CE3A088AE5CFB.title: "Wytwarzanie w Minecraftcie"
	quest.2AEBE3F28996A6ED.quest_desc: ["Dzięki nowym metalom możemy ulepszyć nasz piec za pomocą modyfikacji &aIron Furnaces&r!\\n\\nIron Furnaces (piece z samej modyfikacji, nie tylko wersja żelazna) pozwalają dodawać &aAugments&r, które zwiększają prędkość pieca, zmieniają jego działanie i wiele więcej!\\n\\nTe piece ułatwiają automatyzację, pozwalając automatycznie wyciągać lub wkładać przedmioty z boków za pomocą konfiguracji po lewej stronie interfejsu."]
	quest.2AEBE3F28996A6ED.title: "&aUlepszenia Pieców&r!"
	quest.2CCAA7C0FEDEB573.quest_desc: ["Jeśli jesteś jak większość, to właśnie tej energii szukasz. Wystarczy postawić ten wiatrak jak najwyżej i masz darmową energię."]
	quest.2CCAA7C0FEDEB573.title: "Energia Wiatrowa"
	quest.2EC9668ED4EA47CB.quest_desc: ["To zadanie wymaga stworzenia tylko jednego diamentowego narzędzia lub części zbroi, ale warto zrobić cały komplet!\\n\\nDiamentowe narzędzia mają wysoką wytrzymałość, a zbroja oferuje świetną ochronę.\\n\\nAby wytworzyć lepsze narzędzia i zbroję w grze, potrzebujesz diamentowych przedmiotów jako bazy!"]
	quest.2EC9668ED4EA47CB.title: "&9Dozbrojenie"
	quest.346860B8EBC4C28C.quest_desc: ["Skoro masz już tyle lawy, co z nią zrobisz? Więcej energii na wczesnym etapie gry!"]
	quest.346860B8EBC4C28C.title: "Energia z Lawy"
	quest.378BF828DC931F0C.quest_desc: ["Osobiście nie znoszę biegać do bloku tylko po to, żeby coś wytworzyć. Od tego jest &2Crafting Table on a Stick&r!\\n\\nTen przedmiot działa jak &aprzenośny stół rzemieślniczy&r!\\n\\nWskazówka: Możesz też włożyć go do slotu &aCurios&r i ustawić &bskrót klawiszowy&r, aby go otworzyć!"]
	quest.378BF828DC931F0C.title: "Wytwarzanie, ale na Stick"
	quest.3ADCAD65EA6900BA.quest_desc: ["&2Archeologia&r pozwala graczom znajdować przedmioty w &aSuspicious&r blokach, takich jak Sand i Gravel.\\n\\nTe bloki można znaleźć w różnych strukturach, np. Warm Ocean Ruins, Desert Pyramids, Desert Wells i &eTrail Ruins&r.\\n\\nAby odkryć przedmiot w bloku Suspicious, musisz stworzyć &aBrush&r i zamieść blok, by odsłonić przedmiot."]
	quest.3ADCAD65EA6900BA.title: "&2Archeologia&r!"
	quest.3B6F1BD64C0C570F.quest_desc: ["Podobnie jak energia wiatru, daje dużo energii bez zużywania żadnych zasobów. Jedynym minusem jest to, że musi być dzień."]
	quest.3B6F1BD64C0C570F.title: "Energia Solarna"
	quest.4869C413646CC4CC.quest_desc: [
		"Przesyłanie energii z generatorów to prawdopodobnie dobry pomysł, ale jak to zrobić?"
		""
		"Na początek możesz użyć &cEnergy Pipes&r z modyfikacji &aPipez&r albo &cEnergy Cables&r z modyfikacji &9Powah&r, jeśli już zacząłeś z niej korzystać."
		""
		"Albo, jeśli lubisz wracać do korzeni, ta paczka zawiera &6EnderIO&r i możesz użyć jego &6Energy Conduits&r."
	]
	quest.4869C413646CC4CC.title: "Kable Energetyczne"
	quest.4A4C71C43519D5FE.quest_desc: [
		"Aby przyzwać bossa Netheru, musimy najpierw zebrać kilka przedmiotów."
		""
		"Potrzebujemy co najmniej 3 &5Wither Skeleton Skulls&r. Są to rzadkie dropy z &7Wither Skeletons&r, można je też wytworzyć z częściej wypadających &3Wither Skull Fragments&r."
		""
		"Potrzebujesz też co najmniej 4 bloków Soul Sand i prawdopodobnie całkiem dobrej zbroi."
	]
	quest.4A4C71C43519D5FE.title: "&6Przyzwanie &5Withera"
	quest.4DE1158931F84F22.quest_desc: [
		"Gdy będziesz mieć żelazny lub lepszy kilof, wykopiesz &cRedstone&r."
		""
		"Redstone rozpoczyna Twoją przygodę z wieloma technicznymi modyfikacjami, np. przy wytwarzaniu energii czy tworzeniu fajnych gadżetów."
		""
		"Tego surowca będziesz potrzebować dużo!"
	]
	quest.4DE1158931F84F22.title: "&cRedstone&r"
	quest.4E5238F00CEED8B2.quest_desc: ["Przepalanie surowych rud na początku jest konieczne, ale tracisz przez to dodatkowe zasoby!\\n\\nJest kilka sposobów na podwojenie uzysku z jednej surowej rudy, a jednym z najłatwiejszych jest wytworzenie i używanie &eOre Hammer&r.\\n\\nRozbija on 1 surową rudę na 2 pyły rudy, które można przepalić na sztabki, co skutecznie podwaja ich liczbę!\\n\\nChcesz więcej z jednej surowej rudy? Sprawdź modyfikację &5Occultism&r!"]
	quest.4E5238F00CEED8B2.title: "&ePodstawowe Podwajanie Rud"
	quest.5792CC9E3AFAB229.quest_desc: ["Mamy też modyfikację &aGenerators Galore&r! Dodaje ona unikalne generatory, które używają węgla lub innych przedmiotów."]
	quest.5792CC9E3AFAB229.title: "Miedziany Generator"
	quest.5CF320E9C4C1B1E1.quest_desc: ["ATM10 to paczka typu &aKitchensink&r, co oznacza, że możesz swobodnie eksplorować i grać w nią w dowolny sposób!\\n\\nJest jednak cel na końcową fazę gry: wytworzenie &6ATM Star&r!\\n\\nTa ścieżka zadań to przewodnik dla wszystkich graczy, niezależnie od tego, czy dopiero zaczynasz przygodę z Minecraftem, czy grałeś już w poprzednie paczki ATM.\\n\\nTak jak w prawie każdej paczce, zacznij od zebrania drewna!"]
	quest.5CF320E9C4C1B1E1.title: "&eWitaj w Pierwszych Krokach&r!"
	quest.5E799B92358A8732.quest_desc: ["W &cNetherze&r natrafisz na &6Ancient Debris&r. Można je przepalić na odłamki, które w połączeniu ze złotem pozwalają wytworzyć &6Netherite Ingots&r - metal końcowej fazy gry, używany do wytwarzania jednych z najsilniejszych narzędzi i zbroi w grze."]
	quest.5E799B92358A8732.title: "&dPradawne Metale"
	quest.61C49BC2B384FB80.quest_desc: ["Gdy zbierzesz dość Ender Pearls i Blaze Powder, możesz ruszyć do End Portal w Overworldzie.\\n\\nWytwórz kilka &dEyes of Ender&r i kliknij prawym przyciskiem myszy, aby rzucić je w niebo. Wskażą one kierunek najbliższego End Portal.\\n\\nDotrzyj do Stronghold, znajdź End Portal i uzupełnij ramkę za pomocą Eyes of Ender, aby stworzyć portal do &dThe End&r."]
	quest.61C49BC2B384FB80.title: "&aZnalezienie &dEndu"
	quest.672134A1A620EEAB.quest_desc: [
		"Jest wiele sposobów na przechowywanie energii!"
		""
		"&9Powah&r oferuje świetne magazyny w postaci &aEnergy Cells&r, które można ulepszać, albo możesz wybrać multiblokowy styl &aRFTools&r z &aPowercells&r! Wybór należy do Ciebie."
		""
		"Uwaga: Aby ukończyć zadanie, wystarczy wytworzyć jeden z tych przedmiotów."
	]
	quest.672134A1A620EEAB.title: "Magazyny Energii"
	quest.698A959C9E449592.quest_desc: ["Kolejnym krokiem postępu jest wykonanie Iron Pickaxe.\\n\\nTen kilof pozwala wydobyć niektóre z rzadszych rud w grze, w tym Diamond!"]
	quest.698A959C9E449592.title: "&aŻelazny&r Kilof"
	quest.69A517AB8A801939.quest_desc: ["&5Wither&r to jeden z najtrudniejszych do pokonania bossów w Minecrafcie. Głównie dlatego, że lata. I wybucha. I jest szybki. Rozumiesz, o co chodzi.\\n\\nAby go przyzwać, ustaw 4 bloki Soul Sand w kształcie litery T. Połóż 3 Wither Skeleton Skulls na górze litery 'T', a &5Wither&r się pojawi.\\n\\nWskazówka: Wybucha. Dużo. Nie rób tego w pobliżu bazy."]
	quest.69A517AB8A801939.title: "&6Zabij &5Withera"
	quest.6D09511D64DDC282.quest_desc: ["&dWarden&r można przyzwać, uruchamiając co najmniej 3 razy &5Sculk Sensor&r znajdujący się w pobliżu &3Sculk Shrieker&r.\\n\\nCiekawostka: Warden jest ślepy! Znajdzie Cię tylko wtedy, gdy Cię usłyszy, więc lataj albo skradaj się!\\n\\nWskazówka: Nie ma znaczenia, czy używasz ataków dystansowych, czy wręcz, bo i tak Cię znajdzie. I uderzy. Jeśli oddalisz się zbyt daleko, zakopie się w ziemi i wyłoni tuż obok Ciebie! Powodzenia :D"]
	quest.6D09511D64DDC282.title: "&5Zabij Wardena"
	quest.6EDAB29FBD3C60A3.quest_desc: ["Ten biom został wprowadzony w Wild Update!\\n\\nUważaj! Możesz przypadkowo przyzwać nowego przyjaciela.\\n\\nPS: Nie jest przyjazny."]
	quest.6EDAB29FBD3C60A3.title: "&6Odwiedź &dThe Deep Dark&r!"
	quest.6EE5BE5693E8ACE4.quest_desc: ["W wymiarze &dThe End&r znajdziesz końcowego bossa Vanilla Minecraft: &5Ender Dragon&r.\\n\\nNa szczycie każdego filaru z Obsidian znajdziesz End Crystal, który leczy Smoka. Zniszcz je w pierwszej kolejności! Przy wybuchu zadają też spore obrażenia, więc zachowaj dystans!\\n\\nPo pokonaniu Smoka na szczycie Portalu wyjściowego pojawi się &dDragon Egg&r. Nie można go wykopać jak zwykłych bloków, ale działa na nie grawitacja."]
	quest.6EE5BE5693E8ACE4.title: "&5The End"
	quest.72989212DD45DC10.quest_desc: ["Aby znaleźć to jajo, musisz zamieść pędzlem &aSuspicious Sand&r w Warm Ocean Ruins.\\n\\nMożesz położyć jajo w świecie, a powoli wykluje się z niego &dSnifflet&r. Zwykle trwa to około 20 minut, ale jeśli położysz je na bloku mchu, czas wykluwania się skróci o połowę - do 10 minut.\\n\\nSnifflet w końcu urośnie w dorosłego &dSniffera&r, który wywęszy takie rzeczy jak &2Torchflower Seeds&r czy &2Pitcher Pods&r, gdy będzie przechodził nad blokami, w których może kopać.\\n\\nDwa dorosłe Sniffery możesz rozmnożyć za pomocą Torchflowers."]
	quest.72989212DD45DC10.quest_subtitle: "Daleki Kuzyn Scruffa McGruffa"
	quest.72989212DD45DC10.title: "&aThe &5Sniffer"
	quest.72E1C19156633391.quest_desc: ["Wiadra i Tanks to świetny sposób na wczesne przenoszenie lawy."]
	quest.72E1C19156633391.title: "Lava Bucket"
	quest.76406EFFF8CBA6B4.quest_desc: ["Diamenty to jeden z najlepszych materiałów do wytwarzania narzędzi, ale pozwalają też odwiedzać nowe wymiary, takie jak Twilight Forest!"]
	quest.76406EFFF8CBA6B4.title: "Wydobyliśmy &bDiamenty&r!"
	quest.7741905EA8380B25.quest_desc: ["&aArmor Trims&r to przedmioty służące do dodawania wykończeń do Twojej zbroi! Robi się to w blokach Smithing Table.\\n\\nChoć mają recepturę, większość wykończeń to rzadkie znaleziska w skrzyniach z łupem lub wykopaliskach archeologicznych. Gdy znajdziesz jedno, możesz zduplikować Template, używając receptury, aby wytworzyć więcej!"]
	quest.7741905EA8380B25.title: "&dWykończenia Zbroi"
	quest.790EC3EDC2DB1FB0.quest_desc: ["Jak już wspomniano, ta modyfikacja dodaje mnóstwo ciekawych sposobów generowania energii, które wymagają konkretnych konstrukcji."]
	quest.790EC3EDC2DB1FB0.title: "Generators Galore"
	quest.7975C7145572C438.quest_desc: ["Niezależnie od tego, czy jesteś doświadczonym graczem modów, czy zupełnym nowicjuszem w MC, każdy musi stworzyć &2Wooden Pickaxe&r.\\n\\nKilofy pozwalają niszczyć większość bloków kamienia i metali. Ten drewniany długo nie wytrzyma, więc zbierz nim trochę &3Cobblestone&r!"]
	quest.7975C7145572C438.title: "Nasz Pierwszy Kilof"
	quest.7D38BC3DB3406F51.quest_desc: ["Z Wooden Pickaxe kamień nie powinien być problemem!\\n\\n&3Cobblestone&r odblokowuje kolejny etap postępu, pozwalając wytworzyć piec do przepalania rud.\\n\\nBędziesz też chciał ulepszyć kilof do kamiennego, by wydobywać lepsze rudy, jak &bżelazo&r!"]
	quest.7D38BC3DB3406F51.title: "Epoka Kamienia"
	quest.7EC01E7DB045DB05.quest_desc: ["&aAugments&r to ulepszenia pieca, które mogą zmienić lub ulepszyć jego działanie.\\n\\n - Blasting: Pozwala piecowi używać tylko receptur Blast Furnace.\\n\\n - Smoking: Pozwala piecowi używać tylko receptur Smoker.\\n\\n - Factory: Zamienia piec tak, by używał energii zamiast paliwa, i ulepsza go do fabryki, pozwalając przepalać wiele przedmiotów naraz. Zależy to od poziomu pieca.\\n\\n - Speed: Podwaja prędkość pieca kosztem podwójnego zużycia paliwa.\\n\\n - Fuel Efficiency: Podwaja liczbę przedmiotów przepalanych z jednej jednostki paliwa, ale zmniejsza prędkość o 25%"]
	quest.7EC01E7DB045DB05.title: "Furnace &aAugments"
	task.0AFA64F1025569A2.title: "Sprzęt z Netherite"
	task.1693B07767081FB3.title: "Wykończenia Zbroi"
	task.173044E1C1134A80.title: "Cobblestone"
	task.1869893A4F8E9E9C.title: "Ore Hammers"
	task.1960B985B54B9FBD.title: "Kable Energetyczne"
	task.26CDA4EADF919D5C.title: "Generatory"
	task.285A53DB9D54595D.title: "Pnie"
	task.2CE553B282962E01.title: "Wiadra"
	task.2E49798B39BAA192.title: "Energia Solarna"
	task.3209E46C9B05C163.title: "Sprzęt Diamentowy"
	task.3BEA6C6A41D5ABEA.title: "Furnace Augments"
	task.3C95552D03C16F3D.title: "Magazyny Energii"
	task.44CEA28EBD6C0898.title: "AllRightsReserved"
	task.539C6F64C251543B.title: "Węgiel"
	task.6CAD0E4CF3577BEB.title: "Zabij 1 Nadzorcę"
	task.76C41881A02F2098.title: "Zabij 1 Withera"
	task.7C6F7EF2B3AC2824.title: "AllRightsReserved"
	task.7C88F80D05E62AC7.title: "Iron Furnaces"
}
