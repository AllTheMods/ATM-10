{
	quest.01F18150EC923482.quest_desc: ["&3Refined Storage&r (RS lub RS2) to mod masowego magazynowania, oferujący sieciowy system magazynowy.\\\\n\\\\nNa początek będziesz chciał zrobić &3Controller&r.\\\\n\\\\nController to „rdzeń” Twojej sieci magazynowej. Gdy dostarczysz mu energię, ożywia wszystkie podłączone komponenty RS."]
	quest.01F18150EC923482.quest_subtitle: "Wersja 2"
	quest.01F18150EC923482.title: "&3Refined Storage"
	quest.03C78165C5CBD9E1.title: "&a16k Storage Part"
	quest.0945EC53626F58E6.quest_desc: ["Oprócz przedmiotów i płynów &3Refined Storage&r może też przechowywać &aChemicals&r, dzięki modowi Refined Storage - Mekanism Integration.\\n\\nMożesz też magazynować &4Energy&r, &5Source&r i &9Souls&r, dzięki modowi Refined Types."]
	quest.0945EC53626F58E6.title: "&5Inne Storage Parts"
	quest.0D4FE97640F2CA60.quest_desc: ["&bUltra Destructor&r ma 36 slotów filtra, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.0D4FE97640F2CA60.title: "&bUltra Destructor"
	quest.0F00BBDF3618B3BA.quest_desc: ["&3Crafting Grid&r daje dostęp do Twojego magazynu, ale z interfejsem wytwarzania!\\n\\nBądźmy szczerzy, nikt nie używa zwykłych &3Grid.&r"]
	quest.0F00BBDF3618B3BA.title: "&3Lepszy Grid"
	quest.1187F9D4F4E0D254.quest_desc: ["&3Wrench&r to narzędzie, które potrafi dwie rzeczy:\\n- Obracać bloki.\\n- Zdejmować osłony (covers) Refined Storage.\\n\\nPo prostu kucnij i kliknij prawym przyciskiem myszy, trzymając Wrench."]
	quest.1187F9D4F4E0D254.quest_subtitle: "Kręcisz mną w kółko'"
	quest.1187F9D4F4E0D254.title: "&3Wrench"
	quest.123807F4BBE75120.title: "&b16384k Storage Part"
	quest.12A43F82FC67A289.quest_desc: ["Aby przechowywać przedmioty, musisz stworzyć dyski, które można umieścić w &9Disk Drives&r podłączonych do Twojej sieci.\\n\\nKażdy z nich ma 8 slotów na Storage Disks"]
	quest.12A43F82FC67A289.quest_subtitle: "Czas na dyskietki!"
	quest.13A0714444BA79AB.quest_desc: ["&bUltra Importer&r ma 36 slotów filtra, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.13A0714444BA79AB.title: "&bUltra Importer"
	quest.15ECBC8E174FA39B.quest_desc: ["Pozwala uzyskać bezprzewodowy dostęp do magazynu Twojej sieci."]
	quest.15ECBC8E174FA39B.quest_subtitle: "Grid w Podróży"
	quest.17920C436DDBBD07.title: "&2262kB Fluid Storage Part"
	quest.189018F641FBB44E.quest_desc: ["&4Mega Autocrafter&r ma 54 sloty na wzorce, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.189018F641FBB44E.title: "&4Mega Autocrafter"
	quest.1D2700821045CCF2.title: "&565536k Storage Part"
	quest.1F55A483008F74FE.quest_desc: ["&bUltra Constructor&r ma 36 slotów filtra, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.1F55A483008F74FE.title: "&bUltra Constructor"
	quest.22F80D267321BFC5.quest_desc: ["&3Autocrafter Manager&r pozwala uzyskać dostęp do wszystkich Twoich &3Autocrafters&r z jednego bloku.\\n\\nMam nadzieję, że nie będziesz próbował wszystkiego uporządkować - dla własnego dobra."]
	quest.22F80D267321BFC5.title: "&3Zarządzanie Autocrafters"
	quest.23F691FC053F2319.quest_desc: ["Disk Interface pozwala przenosić przedmioty i płyny z jednego dysku na dyski innego gridu."]
	quest.23F691FC053F2319.quest_subtitle: "Koniec z manipulacjami!"
	quest.24D3F605315ADB03.quest_desc: ["&9Wireless Universal Grid&r daje bezprzewodowy dostęp do magazynu Twojej sieci, do Twojej sieci magazynowej z wbudowanym interfejsem wytwarzania oraz do kolejki wytwarzania."]
	quest.24D3F605315ADB03.title: "&dWireless Universal Grid"
	quest.253657BE5D9D9162.quest_desc: ["External Storage to rodzaj interfejsu kabla, który jest jednym z najważniejszych przedmiotów, jakie można zrobić w podróży przez &3Refined Storage&r.\\n\\nTen rodzaj interfejsu kabla łączy zewnętrzny magazyn z Twoją siecią. W zasadzie pozwala RS zajrzeć do pojemnika magazynowego, abyś mógł uzyskać do niego dostęp w swoim &3Grid&r!\\n\\nDziała to z wieloma rzeczami, między innymi ze skrzyniami, beczkami, Drawers, Drawer Controllers i nie tylko!\\n\\nJeśli nie możesz zrobić dysków, a wszędzie masz mnóstwo skrzyń, to najlepsza opcja na stworzenie sieci magazynowej!"]
	quest.2B27E4E04A628C60.quest_desc: ["&eSpeed Upgrade&r robi dokładnie to, co mówi jego nazwa. Zwiększa szybkość działania interfejsu lub bloku. Potrzebujesz, by importer pobierał szybciej? Chcesz, aby Twoje Crafters pracowały szybciej? To właśnie to ulepszenie!\\n\\n&eStack Upgrade&r zwiększa szybkość transferu do całego stosu przedmiotów, a nie tylko jednego. Połącz z Speed Upgrades, aby uzyskać wydajniejsze sieci!"]
	quest.2B27E4E04A628C60.title: "&ePrzyspieszanie Wszystkiego!"
	quest.2CFEE04BA574921E.quest_desc: ["&bConstructor&r to interfejs, który stawia wskazany blok w kierunku, w którym jest skierowany.\\n\\nBlok możesz wskazać w GUI. Może to być przydatne do automatyzacji!"]
	quest.2CFEE04BA574921E.quest_subtitle: "Stawianie bloków!"
	quest.2E2811D1A0F2A492.quest_desc: ["Aby zwiększyć zasięg bezprzewodowego połączenia z Twoim systemem, możesz wytworzyć &bRange Upgrades&r.\\n\\nWireless Transmitter może pomieścić ich łącznie tylko 4."]
	quest.2E2811D1A0F2A492.quest_subtitle: "Lepszy Sygnał"
	quest.2E2811D1A0F2A492.title: "&bZwiększanie Zasięgu Wi-Fi"
	quest.30700E99091B712A.quest_desc: ["&cRegulator Upgrade&r pozwala utrzymywać określoną ilość przedmiotów w bloku lub maszynie. Świetnym przykładem jest nakazanie sieci, by trzymała 64 sztuki węgla w piecu. Umieszczasz ulepszenie w bloku Exporter podłączonym do pieca, a następnie ustawiasz 64. Twój system będzie wtedy próbował utrzymywać piec pełen paliwa!\\n\\nAle co, jeśli potrzebny przedmiot trzeba wytworzyć? Robi to właśnie &6Crafting Upgrade&r. Jeśli masz recepturę w bloku Autocrafter, dodanie tego ulepszenia do interfejsu da mu znać, by wytworzył przedmiot, gdy Ci się skończy.\\n\\nWracając do naszego przykładu: powiedzmy, że masz farmę &aMystical Agriculture&r i Coal Essence. Możemy wtedy umieścić recepturę na węgiel w bloku Autocrafter podłączonym do systemu, a następnie włożyć to ulepszenie do tego samego bloku Exporter, który zaopatruje piec w paliwo. Jeśli w systemie skończy się węgiel, &6Crafting Upgrade&r pozwoli systemowi wytworzyć go więcej!"]
	quest.30700E99091B712A.title: "&cRegulator Upgrade"
	quest.33105698C75093C2.quest_desc: ["&4Mega Destructor&r ma 54 sloty filtra, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.33105698C75093C2.title: "&4Mega Destructor"
	quest.34F7325C2AFA6DA7.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.3751015CD5C84134.title: "&b4096B Fluid Storage Part"
	quest.39C8E1705EF1CD31.title: "&e256B Fluid Storage Part"
	quest.3B062B9EC2CEF592.quest_desc: ["&4Mega Exporter&r ma 54 sloty filtra, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.3B062B9EC2CEF592.title: "&4Mega Exporter"
	quest.3B84215240D9F2CB.quest_desc: ["&3Security Manager&r pozwala nadawać użytkownikom dostęp i uprawnienia w Twojej sieci.\\\\n\\\\nPo umieszczeniu w systemie będziesz potrzebować &3Security Card&r dla każdego gracza, któremu chcesz skonfigurować uprawnienia. Gdy nie ma żadnych kart, każdy ma dostęp do wszystkich uprawnień.\\\\n\\\\nAby ograniczyć uprawnienia i dostęp wszystkim nieskonfigurowanym graczom, skonfiguruj kartę, która nie jest przypisana do żadnego gracza, i włóż ją do managera. Osoba, która postawiła &3Security Manager&r, zawsze będzie miała do niego dostęp."]
	quest.3B84215240D9F2CB.quest_subtitle: "Zabezpiecz swój Grid!"
	quest.3B84215240D9F2CB.title: "&3Security Manager"
	quest.3E890BABC4C41370.quest_desc: ["Z powodu limitu bloków Controller pewnie będziesz chciał połączyć różne systemy ze swoim głównym węzłem bez miliarda kabli.\\n\\nRobi się to za pomocą &3Network Transmitters&r i &3Network Receivers&r.\\n\\n&9Transmitters&r powinny być podłączone do Twojego głównego systemu, tam gdzie jest Controller.\\n\\n&9Receiver&r powinien trafić tam, gdzie chcesz mieć sieć zewnętrzną. Może to być na przykład oddzielna część bazy, w której masz pszczoły, farmę mobów i tym podobne.\\n\\nAby połączyć Receiver z główną siecią, musisz użyć &3Network Card&r. Aby przypisać Network Card, kliknij prawym przyciskiem myszy Receiver, a następnie włóż Network Card do Transmitter podłączonego do Twojego głównego systemu"]
	quest.3E890BABC4C41370.quest_subtitle: "Bezprzewodowe Łączenie Sieci"
	quest.3E890BABC4C41370.title: "&3Sieci Grid"
	quest.3F8EEE1AD4420702.title: "&b64k Storage Part"
	quest.3FD801D7DE9176FB.title: "&e4k Storage Part"
	quest.4101F8275B41C79B.title: "&61k Storage Part"
	quest.43E8912CB307E421.quest_desc: ["Świetnie! Możemy przechowywać rzeczy wirtualnie, ale jak zobaczyć, co jest w sieci?\\n\\nAby uzyskać dostęp do systemu, musisz stworzyć &3Grid&r. To najprostsza forma „wyświetlacza” przedmiotów w Twojej sieci.\\n\\n&3Grid&r może przechowywać przedmioty, płyny, energię, Source, Souls i Chemicals."]
	quest.43E8912CB307E421.quest_subtitle: "Nie schodź z Grida"
	quest.43E8912CB307E421.title: "&3Grid"
	quest.44881E39AB1D62AA.quest_desc: ["&3Autocrafter&r to miejsce, w którym przechowujemy wzorce (Patterns), aby nasza sieć wiedziała, jak wytwarzać przedmioty. Gdy receptura zostanie umieszczona w maszynie, będziesz mógł „zażądać” wytworzenia przedmiotu ze swojego &3Grid&r. Możesz to zrobić, naciskając Control + Shift i klikając przedmiot, do którego masz recepturę, aby wyświetlić interfejs wytwarzania.\\n\\nTen blok można też postawić zwrócony w stronę maszyny, aby używać &6Processing Patterns&r. Na przykład jeśli skierujesz &3Autocrafter&r na piec, możesz włożyć do niego recepturę, do której potrzebny jest piec, jak przetapianie Raw Processors. Dopóki &3Autocrafter&r jest podłączony do systemu, a do pieca podłączony jest Importer, Crafter pozwoli Ci zażądać przetopionej wersji procesora!"]
	quest.44881E39AB1D62AA.quest_subtitle: "Zautomatyzowane wytwarzanie!"
	quest.44881E39AB1D62AA.title: "&3Autocrafter"
	quest.45FF08E4DB6F7F0E.quest_desc: ["Elite Autocrafter ma 18 slotów na wzorce i działa 2 razy szybciej."]
	quest.4966162FBA933453.title: "&4262m Storage Part"
	quest.49772923B8AF0F1F.title: "&b1048kB Fluid Storage Part"
	quest.4A198E875A6B0A64.quest_desc: ["&bUltra Autocrafter&r ma 36 slotów na wzorce, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.4A198E875A6B0A64.title: "&bUltra Autocrafter"
	quest.4A99CAB529BB9F75.quest_desc: ["&4Mega Constructor&r ma 54 sloty filtra, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.4A99CAB529BB9F75.title: "&4Mega Constructor"
	quest.4B81E84CAE814BA9.title: "&664B Fluid Storage Part"
	quest.4C1F13F5A0E273EF.title: "&6256k Storage Part"
	quest.4CD83943865018EA.quest_desc: ["&9Exporter&r służy do wypychania przedmiotów z Twojego systemu do bloku z magazynu Twojej sieci.\\n\\nMożna go użyć do napełniania pieców rudami lub paliwem, wypychania materiałów do wyznaczonych skrzyń i tym podobnych.\\n\\nMożesz też filtrować, jakie przedmioty są wypychane."]
	quest.4CD83943865018EA.quest_subtitle: "Eksportowanie przedmiotów!"
	quest.52ACADDFCB0E22AB.title: "&a4096k Storage Part"
	quest.532229D285CA4858.quest_desc: ["&9Importer&r to interfejs, który może pobierać przedmioty z podłączonego bloku.\\n\\nMożesz na przykład używać ich na piecach, aby wyciągać gotowy produkt do swojego systemu.\\n\\nMożesz też filtrować, jakie przedmioty są pobierane."]
	quest.532229D285CA4858.quest_subtitle: "Importowanie przedmiotów!"
	quest.53CA0D6B4D5A17D5.title: "&616384B Fluid Storage Part"
	quest.59F5ED931FD70C55.quest_desc: ["&9Patterns&r to chleb powszedni autocraftingu. Przechowują receptury, dzięki którym Twoja sieć RS wie, jak wytwarzać przedmioty."]
	quest.59F5ED931FD70C55.quest_subtitle: "Podążaj za wzorcem"
	quest.59F5ED931FD70C55.title: "Autocrafting"
	quest.5BB7648DC10E1E08.quest_desc: ["&bUltra Exporter&r ma 36 slotów filtra, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.5BB7648DC10E1E08.title: "&bUltra Exporter"
	quest.5CAC395680027354.quest_desc: ["&bInterdimensional Wireless Transmitter&r to ulepszona wersja &3Wireless Transmitter&r o nieskończonym zasięgu, nawet między wymiarami."]
	quest.5CAC395680027354.quest_subtitle: "W skrócie: dobre Wi-Fi"
	quest.5CAC395680027354.title: "&dInterdimensional Wireless Transmitter"
	quest.5EAD916C4F15335F.quest_desc: ["&4Mega Importer&r ma 54 sloty filtra, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.5EAD916C4F15335F.title: "&4Mega Importer"
	quest.60244F26B9ABED49.title: "&a1024B Fluid Storage Part"
	quest.6092490EC9008A05.quest_desc: ["&4Destructor&r to interfejs, który automatycznie niszczy blok, do którego jest podłączony.\\n\\nMożesz też ustawić go na białą listę bloków, co przydaje się do automatyzacji niektórych procesów, jak tworzenie Casings w &6Create.&r"]
	quest.6092490EC9008A05.quest_subtitle: "Niszczenie bloków!"
	quest.616B6046EF5DDF21.quest_desc: ["Elite Importer ma 18 slotów filtra i działa 2 razy szybciej."]
	quest.64D6C395B6304F40.title: "&e65536B Fluid Storage Part"
	quest.64E85274D24FE394.quest_desc: ["Po podłączeniu do systemu &9Storage Monitor&r będzie wyświetlał aktualną liczbę danego przedmiotu w Twojej sieci."]
	quest.65C8A43FEDBA3835.quest_desc: ["&3Pattern Grid&r pozwala odciskać receptury na wzorcach (Patterns) dla Twojej sieci.\\n\\nNajłatwiej utworzyć recepturę dla wzorca, wyszukując przedmiot w JEI i klikając przycisk „+” w prawym dolnym rogu receptury. Receptura trafi wtedy do gridu.\\n\\nPo prawej stronie górny slot służy do przechowywania pustych wzorców. Gdy w środku będzie pusty wzorzec, powinieneś móc kliknąć strzałkę poniżej, aby odcisnąć recepturę na wzorcu.\\n\\nNastępnie będziesz chciał włożyć wzorzec do &3Autocrafter&r!"]
	quest.65C8A43FEDBA3835.title: "&3Pattern Grid"
	quest.66D85424EC74EDCC.quest_desc: ["&9Portable Grid&r to przenośny system magazynowy, który nie jest podłączony do sieci.\\n\\nPozwala korzystać z &9Storage Disk&r bez połączenia z siecią."]
	quest.6904EC449FBEE387.quest_desc: ["&9Cables&r służą do łączenia bloków i przedmiotów z Twoim systemem.\\\\n\\\\nNa początku wystarczy stawiać bloki obok siebie, by podłączyć je do systemu, ale Cables pozwalają sięgnąć dalej! To podstawa każdej dużej sieci RS."]
	quest.6904EC449FBEE387.quest_subtitle: "Łączenie systemu"
	quest.6904EC449FBEE387.title: "Cables"
	quest.6973A5923AF7BF05.quest_desc: ["Elite Exporter ma 18 slotów filtra i działa 2 razy szybciej."]
	quest.6B04FC81351CD1AB.quest_desc: ["Jeśli chcesz uzyskać bezprzewodowy dostęp do swojej sieci RS, zacznij od stworzenia &3Wireless Transmitter&r.\\n\\nMożesz go podłączyć w dowolnym miejscu systemu. Jest potrzebny, aby używać &9Wireless Grids&r."]
	quest.6B04FC81351CD1AB.quest_subtitle: "XXI wiek"
	quest.6B04FC81351CD1AB.title: "&5Dostęp Bezprzewodowy"
	quest.6D81DF90E9C2C049.quest_desc: ["Elite Destructor ma 18 slotów filtra i działa 2 razy szybciej."]
	quest.6DB06E3984D0CF97.quest_desc: ["Elite Constructor ma 18 slotów filtra i działa 2 razy szybciej."]
	quest.7044EAB5EDF32BBC.quest_desc: ["Po podłączeniu do systemu &9Crafting Monitor&r pozwala zobaczyć, jakie przedmioty są obecnie w kolejce wytwarzania.\\n\\nBędziesz go potrzebować, jeśli chcesz móc anulować wytwarzanie, które nie działa lub jest zbugowane."]
	quest.7044EAB5EDF32BBC.title: "&3Monitorowanie Autocraftingu"
	quest.718A2040D868E09F.title: "&21048m Storage Part"
	quest.723E0CD3C8DD36B1.quest_desc: ["Elite Disk Interface ma 18 slotów filtra i działa 2 razy szybciej."]
	quest.723F67A9C6993018.quest_desc: ["&bUltra Disk Interface&r ma 36 slotów filtra, działa 5 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.723F67A9C6993018.title: "&bUltra Disk Interface"
	quest.744842B2AED28344.quest_desc: ["Pozwala uzyskać bezprzewodowy dostęp do magazynu Twojej sieci z wbudowanym interfejsem wytwarzania."]
	quest.7604D8B3C9FCCFD9.quest_desc: ["Czas stworzyć „dyski twarde” Refined Storage. W tym celu potrzebujemy &9Storage Housing&r, który połączymy z &6Storage Part&r, aby stworzyć &9Storage Disk&r. Po prostu zrób część o wybranym rozmiarze, a następnie połącz ją ze Storage Housing, aby uzyskać dysk.\\n\\n&9Storage Disk&r służy do wirtualnego przechowywania przedmiotów po umieszczeniu w &9Disk Drive&r. Musi być włożony do &9Disk Drive&r. Storage Disk nie znika, gdy zostanie upuszczony w świecie."]
	quest.787415570026FFAA.quest_desc: ["Te ulepszenia dodają zaklęcia do Twojego &4Destructor&r.\\n\\nZastanawiasz się, po co ich używać? Wyobraź sobie, że Builder lub Quarry pompuje do Twojego systemu rudy wydobyte z Silk Touch. Możesz kazać &bConstructor&r postawić te rudy, a następnie &4Destructor&r z zaklęciem &eFortune&r je rozbić, aby dostać jeszcze więcej surowych rud."]
	quest.787415570026FFAA.title: "Destructor Upgrades"
	quest.796E922CA69BAE82.quest_desc: ["&4Mega Disk Interface&r ma 54 sloty filtra, działa 8 razy szybciej i ma wbudowany &eStack Upgrade&r."]
	quest.796E922CA69BAE82.title: "&4Mega Disk Interface"
	quest.7C94F6AE2A793858.title: "&e1024k Storage Part"
	quest.7DD638E4111D66E7.quest_desc: ["Advanced Storage Housing&r jest wymagany do wytworzenia &9Storage Disks&r wysokiego poziomu."]
	quest.7DD638E4111D66E7.title: "&8Advanced Storage Housing"
	quest.7FA85713C86166DA.quest_desc: ["Pozwala uzyskać bezprzewodowy dostęp do kolejki wytwarzania Twojej sieci."]
	task.086992D773D34C15.title: "Fortune Upgrades"
	task.2AEFA81B8D7EB62B.title: "AllRightsReserved"
	task.7D72E6723FFA5BB7.title: "AllRightsReserved"
}
