{
	quest.00075A5F9AC120ED.quest_desc: ["Zabierze przedmioty z Twojej skrzyni wejściowej."]
	quest.00075A5F9AC120ED.quest_subtitle: "Zawsze wymagane"
	quest.002163B909070CF8.quest_desc: [
		"Pozwala zobaczyć szczegóły niektórych bloków i płynów, nawet przez ściany.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
	]
	quest.002163B909070CF8.quest_subtitle: "Maks.: 1"
	quest.00D7BCC68D971A53.quest_desc: ["Pobliskie żywe stworzenia będą automatycznie śledzone, nawet przez ściany. Jeśli to agresywny mob, dostaniesz ostrzeżenie, gdy obierze Cię na cel."]
	quest.00D7BCC68D971A53.quest_subtitle: "Maks.: 1"
	quest.02643BAD1AE747C6.quest_desc: ["&3Advanced Liquid Compressor&r działa tak samo jak Liquid Compressor, tylko o wiele lepiej!"]
	quest.04BE9F63E6003475.quest_desc: ["&3LPG&r można wykorzystać do produkcji Molten Plastic."]
	quest.04BE9F63E6003475.quest_subtitle: "Ten, którego potrzebujemy"
	quest.04BE9F63E6003475.title: "LPG"
	quest.0672462DA3599484.quest_subtitle: "512,000mb"
	quest.09BA45CBBFB4AE26.quest_desc: ["Kolejny etap tego moda wymaga zbudowania &3Assembly Lines&r. Głównym elementem &3Assembly Line&r jest &3Assembly Controller&r.\\n\\nTo tutaj trafi ciśnienie."]
	quest.09BA45CBBFB4AE26.quest_subtitle: "Zawsze wymagane"
	quest.0A912B2E2BE34920.quest_desc: [
		"Choć Crude Oil można znaleźć na powierzchni, wiercenie to świetny sposób na zdobycie jej większej ilości. Najpierw używaj &3Seismic Sensor&r, aż znajdziesz ropę pod sobą, a potem wywierć ją za pomocą &3Gas Lift&r wypełnionego rurami wiertniczymi (do działania wymaga ciśnienia).\\n"
		"{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
	]
	quest.0A912B2E2BE34920.quest_subtitle: "Wiercenie w poszukiwaniu ropy"
	quest.0AEAEA976ED0C470.quest_desc: ["&3Charging Station&r służy do ładowania ciśnieniem różnych narzędzi i gadżetów z &aPneumaticCraft&r."]
	quest.0AEAEA976ED0C470.quest_subtitle: "Gdzie jest kabel?"
	quest.0CC48C2AA553A314.quest_desc: ["&3Drill Bits&r można używać w Pneumatic Jackhammer."]
	quest.0D2F5CC96269F9E3.quest_desc: ["Kolejny krok w produkcji PCB to użycie &3Etching Tank&r z Etching Acid. Do działania potrzebuje ciepła."]
	quest.0D2F5CC96269F9E3.quest_subtitle: "Czas na trawienie!"
	quest.0D31CD79BE6CC8D2.quest_desc: ["Dlaczego zwykły chleb nie potrzebuje drożdży?"]
	quest.0D31CD79BE6CC8D2.quest_subtitle: "Drożdże Twoich problemów"
	quest.0D31CD79BE6CC8D2.title: "Yeast"
	quest.0D5015B8FF482D0A.quest_desc: [
		"Aby kontynuować postęp, musimy zamówić trochę rzeczy u &3Amadrona&r za pomocą &3Amadron Tablet&r. Aby jej użyć, kliknij prawym przyciskiem myszy ze Shiftem skrzynię i zbiornik na płyny, włóż walutę (Emeralds itp.) do połączonego pojemnika i złóż zamówienie. Zobaczysz, jak Amadrone zlatuje po Twoje pieniądze, a drugi Amadrone przylatuje z zamówionym towarem."
		""
		"{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
	]
	quest.0D5015B8FF482D0A.quest_subtitle: "Ciekawe, czy mają dostawę w jeden dzień?"
	quest.0D5015B8FF482D0A.title: "Amadron"
	quest.0D50BDEFA0319EA1.quest_desc: ["Wrzuci gotowy produkt do Twojej skrzyni wyjściowej."]
	quest.0D50BDEFA0319EA1.quest_subtitle: "Zawsze wymagane"
	quest.0D9560C8E247F9E7.quest_desc: ["Kliknij gdzieś prawym przyciskiem, a będziesz mógł wytyczyć sobie drogę powrotną. Jeśli jesteś wystarczająco blisko i masz bezpośrednią trasę, pojawi się ścieżka."]
	quest.0D9560C8E247F9E7.quest_subtitle: "Maks.: 1"
	quest.0E65BE9460B74000.quest_desc: [
		"Logistic Frames muszą być połączone z &3Logistics Module&r, aby działały."
		""
		"{image:pneumaticcraft:textures/patchouli/logistics_module.png width:100 height:100 align:left fit:true}"
	]
	quest.0F49E9167B5E97C9.quest_desc: ["Każde obrażenia, które otrzymasz od upadku (z pominięciem zbroi), zostaną też zadane pobliskim mobom."]
	quest.0F49E9167B5E97C9.quest_subtitle: "Maks.: 1"
	quest.0FF050EC1EA6EAED.quest_desc: ["&3Liquid Hopper&r to lejek, ale do płynów. Nie zastępuje rur."]
	quest.0FF050EC1EA6EAED.quest_subtitle: "Komu potrzebne rury?"
	quest.122EDEC12C9A05D2.quest_desc: ["Czy wspomniałem, że wszystko może wybuchnąć? ...\\n\\nNa szczęście jest proste rozwiązanie! &3Security Upgrade&r umieszczone w maszynie sprawia, że ta nie wybuchnie. Włóż je do każdej maszyny, do której pasuje."]
	quest.122EDEC12C9A05D2.quest_subtitle: "Gdyby tylko istniało proste rozwiązanie..."
	quest.122EDEC12C9A05D2.title: "Zapobieganie Wybuchom?"
	quest.132DF9ECEFFB3B71.quest_desc: ["&3Module Expansion Card&r sprawia, że Charging Module jest jeszcze lepszy."]
	quest.13F68CA518CD287C.quest_desc: ["&3Diesel&r można wykorzystać do produkcji większej ilości Kerosene albo Lubricant."]
	quest.13F68CA518CD287C.quest_subtitle: "Biedny Diesel"
	quest.13F68CA518CD287C.title: "Diesel"
	quest.1427B3AB09510D20.quest_desc: ["Połącz w siatce wytwarzania swój Unassembled PCB z 2 Capacitors i 2 Transistors, aby otrzymać &3Finished PCB&r."]
	quest.1427B3AB09510D20.quest_subtitle: "Udało się!"
	quest.142C67218BD16867.quest_desc: ["Załaduj swój Minigun tym &3Minigun Ammo&r, aby z niego strzelać."]
	quest.15007DCAF701B361.quest_desc: ["Ładuje inne przedmioty ciśnieniowe z Twojego ekwipunku ciśnieniem z magazynu napierśnika."]
	quest.15007DCAF701B361.quest_subtitle: "Maks.: 6"
	quest.15D355EB164EBE68.quest_subtitle: "Potrzebne do Finished PCB"
	quest.15D355EB164EBE68.title: "Capacitors"
	quest.187816477B732517.quest_desc: ["&3Transfer Gadget&r działa jak Hopper, który można umieścić pomiędzy blokami."]
	quest.187816477B732517.quest_subtitle: "Mniejszy Hopper"
	quest.21624A6500545C42.quest_desc: [
		"&3Crop Supports&r można umieścić nad uprawami, aby rosły szybciej."
		""
		"{image:atm:textures/questpics/pneumaticcraft/crop_support.png width:200 height:100 align:center}"
	]
	quest.21624A6500545C42.quest_subtitle: "Szybsze uprawy"
	quest.22572456571C3F8D.quest_desc: ["&3Charging Module&r rozładowuje ciśnienie ze wszystkich przedmiotów ciśnieniowych w pojemnikach, na które jest skierowany."]
	quest.230463E830D6FFEB.quest_desc: ["Skoro mamy już plastik, następnym krokiem jest zdobycie Finished PCB. Najpierw wytwórz kilka &3Empty PCBs&r w Pressure Chamber."]
	quest.230463E830D6FFEB.quest_subtitle: "Droga do PCB"
	quest.2338E5269CA23C91.quest_desc: ["&3Netherite Drill Bit&r to najlepszy Drill Bit, jest nawet lepszy od Diamond Drill Bit."]
	quest.2338E5269CA23C91.quest_subtitle: "To najlepsza końcówka"
	quest.23737103592776C2.quest_desc: ["&3Kerosene Lamp&r to świetne źródło światła, które do działania zużywa paliwo (najlepszy jest Kerosene)."]
	quest.23737103592776C2.quest_subtitle: "Mega pochodnie to pestka!"
	quest.24042326B4632DD4.quest_desc: ["Na początek z logistyką wytwórz &3Logistics Core&r. Polecam przeczytać PNC:R Manual, w którym jest pełny samouczek użycia tych przedmiotów."]
	quest.24042326B4632DD4.quest_subtitle: "Transport przedmiotów i płynów"
	quest.24042326B4632DD4.title: "Logistyka"
	quest.26BEA64C80ECE1A6.quest_desc: ["Każdy &3Logistic Frame&r może służyć do innego rodzaju automatyzacji."]
	quest.2745297337E13E9E.quest_desc: ["&3Advanced Air Compressor&r działa tak samo jak Air Compressor, tylko o wiele lepiej!"]
	quest.2745297337E13E9E.quest_subtitle: "Koniec z nudnymi starymi Air Compressors!"
	quest.2801B7B6BF61E978.quest_desc: ["&3Kerosene&r można wykorzystać do produkcji Gasoline albo jako paliwo w Kerosene Lamp."]
	quest.2801B7B6BF61E978.quest_subtitle: "Kero-widziałeś to?"
	quest.2801B7B6BF61E978.title: "Kerosene"
	quest.2AED15E3AC0346FE.quest_desc: [
		"Poniżej znajdziesz kilka &3Upgrades&r, których możesz użyć na początku przygody z tym modem. Przytrzymaj Shift, najeżdżając na &3Upgrade&r, aby zobaczyć, w czym można go użyć, albo przytrzymaj Shift, najeżdżając na dany przedmiot, aby zobaczyć, jakich ulepszeń może użyć."
		""
		"Uwaga: Podtytuł podpowie Ci, jaką maksymalną liczbę danego &3Upgrade&r można włożyć do przedmiotu."
	]
	quest.2AED15E3AC0346FE.quest_subtitle: "Bardzo przydatne rzeczy"
	quest.2AED15E3AC0346FE.title: "Proste Ulepszenia"
	quest.2C5D78630C7AD57F.quest_desc: ["Zwiększa zasięg, a w różnych przedmiotach robi różne rzeczy."]
	quest.2C5D78630C7AD57F.quest_subtitle: "Podejdź bliżej!"
	quest.2CC56A4F06E53307.quest_desc: [
		"Umieść swoje Empty PCBs w &3UV Light Box&r, aby je naładować. Potrzebuje ciśnienia i dostępu do światła słonecznego."
		"{image:atm:textures/questpics/pneumaticcraft/uv_charging.png width:300 height:150 align:center}"
	]
	quest.2CC56A4F06E53307.quest_subtitle: "Mam nadzieję, że masz okulary przeciwsłoneczne!"
	quest.2CC56A4F06E53307.title: "Ładowanie Promieniami UV"
	quest.2DE7CC686B56881F.quest_desc: ["Chroni Cię przed promieniowaniem z Mekanism."]
	quest.2DE7CC686B56881F.quest_subtitle: "Maks.: 1"
	quest.2E8F851A4E98F741.quest_desc: [
		"&3Pneumatic Armor&r sama w sobie jest całkiem świetna, ale jeśli chcesz, by była wspaniała, musisz zainstalować ulepszenia. Domyślnie naciśnij 'U', aby otworzyć GUI ulepszeń; niektóre ulepszenia zużywają ciśnienie, a inne nie."
		""
		"Tak jak przy ulepszaniu innych narzędzi w PneumaticCraft, do ulepszenia &3Pneumatic Armor&r potrzebujesz Charging Station z ciśnieniem."
		""
		"Uwaga: Podtytuł podpowie Ci, jaką maksymalną liczbę danego ulepszenia można włożyć do przedmiotu."
	]
	quest.2E8F851A4E98F741.quest_subtitle: "Skompresowany Iron Man"
	quest.2E8F851A4E98F741.title: "Pneumatic Armor"
	quest.30AD7B15682E4D0E.quest_desc: ["Inteligentna tabliczka, która potrafi przechowywać i wyświetlać dowolną ilość tekstu, skalowanego tak, by zawsze się mieścił.\\n\\nKliknij prawym przyciskiem myszy dowolnym barwnikiem, aby zmienić kolor kafelka; obramowanie i tło możesz kolorować niezależnie."]
	quest.30AD7B15682E4D0E.quest_subtitle: "Tabliczki? Nigdy o nich nie słyszałem!"
	quest.312331F6DB0CE5F4.quest_desc: ["Działa szybciej niż Tier I."]
	quest.312331F6DB0CE5F4.quest_subtitle: "Maks.: 1"
	quest.31BCE63F5E016323.quest_desc: ["&3Solar Compressor&r generuje ciśnienie za pomocą światła słonecznego - im jest cieplej, tym więcej ciśnienia wytworzy.\\n\\nUważaj jednak: jeśli zrobi się zbyt gorąco, zacznie się psuć i trzeba będzie go naprawić."]
	quest.31BCE63F5E016323.quest_subtitle: "W mojej dłoni..."
	quest.31BCE63F5E016323.title: "Ciśnienie ze Słońca"
	quest.325483DEB0C602F8.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.32C3E14578D48E6C.quest_desc: ["Działają jak zwykłe &3Pressure Tubes&r, tyle że mogą utrzymać 10 barów ciśnienia."]
	quest.32C3E14578D48E6C.quest_subtitle: "Ulepszone Pressure Tubes"
	quest.3334D15766A47A46.quest_desc: ["Za pomocą Laser Assembly Program możesz przyspieszyć produkcję &3Unassembled PCBs&r. Wystarczy włożyć Empty PCB do skrzyni wejściowej, wpompować trochę ciśnienia i czekać."]
	quest.3334D15766A47A46.title: "Automatyzacja PCB"
	quest.36D72D759C4E8823.quest_desc: ["Może nawet odrobinę za szybko."]
	quest.36D72D759C4E8823.quest_subtitle: "Maks.: 1"
	quest.371A34B297C8A8EF.quest_desc: ["PneumaticCraft kręci się wokół ciśnienia! Te zadania nie omówią wszystkiego, co oferuje mod, ale i tak poruszą naprawdę dużo! Pamiętaj, aby zaglądać do JEI, czytać opisy przedmiotów i czytać PCB:R - wszystko to jest bardzo przydatne.\\n\\nNa początek będziesz musiał wytworzyć trochę &3Compressed Iron Ingots&r! Najłatwiej zrobić to tak: wykop dziurę w ziemi, wrzuć do niej sztabki żelaza (lub bloki), a potem wysadź wszystko TNT!\\n\\nCzęść może zginąć w wybuchu, ale to ryzyko, które musimy podjąć!"]
	quest.371A34B297C8A8EF.quest_subtitle: "Potęga powietrza"
	quest.371A34B297C8A8EF.title: "PneumaticCraft: Repressurized"
	quest.39F142224D5210A9.quest_desc: ["&3Biodeisel&r można wykorzystać do produkcji &3Lubricant&r i &3Molten Plastic&r."]
	quest.39F142224D5210A9.quest_subtitle: "Bio/Diesel"
	quest.39F142224D5210A9.title: "Biodeisel"
	quest.3A9AC6AB4407DC32.quest_desc: ["Choć nie każda receptura wymaga tych samych komponentów, możesz skonfigurować swoje &3Assembly Lines&r ze wszystkim zainstalowanym. Prosty układ &3Assembly Line&r, który nadaje się do wszystkiego, pokazano na obrazku poniżej. Przeczytaj zadania dotyczące każdego komponentu, aby poznać ważne informacje o nich.\\n\\nSpeed Upgrades sprawiają, że wszystko idzie o wiele szybciej!"]
	quest.3A9AC6AB4407DC32.quest_subtitle: "Wymagany montaż"
	quest.3A9AC6AB4407DC32.title: "Korzystanie z Assembly Lines"
	quest.3CFE522A4B7CC2EC.quest_desc: [
		"&3Reinforced Chest&r to odporna na wybuchy skrzynia z 36 miejscami. Nie da się z niej zrobić Double Chest. Działa też jak Shulker Box."
		"{image:atm:textures/questpics/pneumaticcraft/reinforced_chest_ui.png width:200 height:100 align:center}"
	]
	quest.3CFE522A4B7CC2EC.quest_subtitle: "Lepsza od zwykłej skrzyni"
	quest.3D819550074CA376.quest_desc: ["Przedmiot musi zostać tu umieszczony, zanim zostanie podniesiony z powrotem."]
	quest.3D819550074CA376.quest_subtitle: "Zawsze wymagane"
	quest.3E16CF590C911129.quest_desc: ["&3Air Compressor&r to łatwy sposób na wytwarzanie ciśnienia - wystarczy włożyć do niego palne przedmioty i patrzeć, jak dzieje się magia! (Polecam zrobić na początek co najmniej 3 takie)."]
	quest.3E16CF590C911129.quest_subtitle: "Poczuj ciśnienie"
	quest.3E16CF590C911129.title: "Wytwarzanie Ciśnienia"
	quest.3F9CCCFEF4E84166.quest_desc: ["Aby zwiększyć produkcję ciepła, umieść &3Heat Sink&r po zimnej stronie swojego Vortex Tube."]
	quest.3F9CCCFEF4E84166.quest_subtitle: "Więcej ciepła"
	quest.3F9CCCFEF4E84166.title: "Lepsza Produkcja Ciepła"
	quest.40924F0D64253A38.quest_desc: ["Sprawia, że przedmioty mogą wydawać inne przedmioty."]
	quest.40924F0D64253A38.quest_subtitle: "Poszło!"
	quest.40F634AC38F42B88.quest_desc: ["Aby przemieszczać ciśnienie, będziesz potrzebować &3Pressure Tubes&r. Jakie ciśnienie, możesz zapytać? Kontynuuj ścieżkę zadań, aby dowiedzieć się, do czego służą."]
	quest.40F634AC38F42B88.quest_subtitle: "Jakie ciśnienie?"
	quest.40F634AC38F42B88.title: "Przemieszczanie Ciśnienia"
	quest.423B8DA485C1308C.quest_desc: ["&3Gasoline&r można wykorzystać do produkcji LPG."]
	quest.423B8DA485C1308C.quest_subtitle: "Gaz, gaz, gaz"
	quest.423B8DA485C1308C.title: "Gasoline"
	quest.42951D14ADCD9332.quest_desc: ["Poproszę to z puree z groszku i fasolą na tostach, szefie?"]
	quest.42951D14ADCD9332.quest_subtitle: "Masz ochotę na Fish \\& Chips?"
	quest.42951D14ADCD9332.title: "Fish \\& Chips!"
	quest.43CDC28DC56BB3E2.quest_subtitle: "128,000mb"
	quest.43EF5513A1C52A37.quest_desc: ["&3Thermopneumatic Processing Plant&r posłuży do produkcji Molten Plastic - wystarczy wpompować trochę LPG, węgla i ciepła."]
	quest.43EF5513A1C52A37.quest_subtitle: "Im dłuższa nazwa, tym lepiej"
	quest.43EF5513A1C52A37.title: "Thermopneumatic Processing"
	quest.440B1E1D4951F808.quest_desc: [
		"&3Smart Chest&r to odporna na wybuchy skrzynia z 72 miejscami, zawierająca wbudowany, w pełni konfigurowalny Omnidirectional Hopper i miejsca na ulepszenia. Nie da się z niej zrobić Double Chest. Działa też jak Shulker Box."
		"{image:atm:textures/questpics/pneumaticcraft/smart_chest_ui.png width:200 height:100 align:center}"
	]
	quest.440B1E1D4951F808.quest_subtitle: "Nerdy wśród skrzyń"
	quest.456B9DD108CF340F.quest_desc: ["Przyspiesza działanie."]
	quest.456B9DD108CF340F.quest_subtitle: "Szybciutko!"
	quest.461C8F1E88AA58D9.quest_desc: [
		"Można ich używać w recepturach wykorzystujących wiaderkowe wersje płynów z PneumaticCraft.\\n\\nGdy &3Fluid Tank&r postawisz na innym &3Fluid Tank&r i połączysz je kluczem, staną się jednym dużym zbiornikiem.\\n"
		"{image:pneumaticcraft:textures/patchouli/small_tanks.png width:250 height:250 align:center fit:true}"
	]
	quest.461C8F1E88AA58D9.quest_subtitle: "32,000mb"
	quest.46BE62C20C720D10.quest_desc: ["Sprawia, że Endermen nie wpadają w gniew na Twój widok, tak jak przy Carved Pumpkin."]
	quest.46BE62C20C720D10.quest_subtitle: "Maks.: 1"
	quest.482E558BCFEE6B7E.quest_desc: ["&3Construction Bricks&r to fajne bloki budowlane, ale uważaj, bo bolą. Wytwórz je ponownie, aby były gładkie."]
	quest.482E558BCFEE6B7E.quest_subtitle: "Nie ma gorszego bólu niż nadepnięcie na nie"
	quest.495DCA49B4E80852.quest_desc: ["&3Minigun&r to broń, która do działania potrzebuje ciśnienia i amunicji. Przeczytaj opis przedmiotu, aby dowiedzieć się więcej."]
	quest.495DCA49B4E80852.quest_subtitle: "Pif-paf!"
	quest.4A076530297F4A97.quest_desc: [
		"Dzięki tym 3 komponentom możesz zbudować wspaniałe &3Elevators&r.\\n"
		"{image:pneumaticcraft:textures/patchouli/elevator.png width:1 height:1 align:left fit:true}"
	]
	quest.4A076530297F4A97.title: "Windy"
	quest.4B4F5341D6DBDD19.quest_desc: ["Pozwala oddychać pod wodą - gdy Twoje bąbelki spadną do 5, zostaną uzupełnione! Dzięki temu pod wodą widzisz też o wiele lepiej!"]
	quest.4B4F5341D6DBDD19.quest_subtitle: "Maks.: 1"
	quest.4C0D00B5305117A1.quest_desc: [
		"&3Sentry Turret&r można gdzieś postawić i ustawić tak, aby atakowała moby lub graczy w swoim zasięgu. Potrzebuje tylko Minigun Ammo."
		""
		"{image:pneumaticcraft:textures/patchouli/sentry_turret.png width:100 height:100 align:left fit:true}"
	]
	quest.4C0D00B5305117A1.quest_subtitle: "Pif-paf (bez Ciebie)"
	quest.4CA17B0A80020B2F.quest_desc: ["&3Manometer&r służy do wyświetlania dodatkowych informacji o maszynie."]
	quest.4CA17B0A80020B2F.quest_subtitle: "Potrzebuję więcej informacji!"
	quest.4E1E31EDD544EE10.quest_subtitle: "64,000mb"
	quest.4F5348D0C83C3B0D.quest_desc: ["&3Solar Cells&r służą do wytwarzania Solar Compressors."]
	quest.4F5348D0C83C3B0D.quest_subtitle: "Ogniwa Słońca"
	quest.4F5348D0C83C3B0D.title: "Solar Cells"
	quest.4FCC20D9F8F87B2F.quest_desc: ["&3Pneumatic Wrench&r służy do przenoszenia lub niszczenia Twoich maszyn i rur."]
	quest.4FCC20D9F8F87B2F.quest_subtitle: "Gadka o narzędziach i momencie obrotowym!"
	quest.5103C817381181DE.quest_desc: ["Pozwala używać Elytra, mając jednocześnie na sobie Pneumatic Chestplate."]
	quest.5103C817381181DE.quest_subtitle: "Maks.: 1"
	quest.520EFA7F446AFBF2.quest_desc: ["&3Lubricant&r można wykorzystać do produkcji Drill Bits."]
	quest.520EFA7F446AFBF2.quest_subtitle: "Produkcja smaru!"
	quest.520EFA7F446AFBF2.title: "Lubricant"
	quest.521656D425E2FDBA.quest_desc: ["Działa jeszcze szybciej niż Tier II."]
	quest.521656D425E2FDBA.quest_subtitle: "Maks.: 1"
	quest.52D3697F1F5625C7.quest_desc: ["&3Etching Acid&r powstaje w Pressure Chamber z Molten Plastic... i kilku innych rzeczy. Używa się go w Etching Tank."]
	quest.52D3697F1F5625C7.quest_subtitle: "Nie pytaj..."
	quest.5303509A1C2B1CCD.quest_desc: ["&3Pneumatic Jackhammer&r wykorzystuje ciśnienie do kopania i można go ulepszyć, by był wspaniały!"]
	quest.5303509A1C2B1CCD.quest_subtitle: "Przepraszam, Jack!"
	quest.53518D4ED99A242F.quest_desc: ["&3Camouflage Applicator&r pozwala ukryć maszyny PneumaticCraft wewnątrz innych bloków."]
	quest.53518D4ED99A242F.quest_subtitle: "Chcesz, żeby Twoja konstrukcja wyglądała fajnie?"
	quest.54169B69725C49DF.quest_desc: ["Wylej Liquid Plastic na ziemię albo przechowuj trochę w skrzyni z przymocowanym Heat Frame, a otrzymasz &3Plastic Sheet&r!"]
	quest.54169B69725C49DF.quest_subtitle: "Nareszcie!"
	quest.54169B69725C49DF.title: "&fPlastic"
	quest.5A0860631323B5E3.quest_desc: ["Wytwarzana z &3Wheat Flour&r. Można jej użyć do zrobienia Salmon Tempura i Sourdough Bread."]
	quest.5A0860631323B5E3.quest_subtitle: "Trzeba to zagnieść"
	quest.5A9D6672385D3D82.quest_desc: ["Do ulepszenia wystarczy 1 Lapis zamiast 4."]
	quest.5A9D6672385D3D82.quest_subtitle: "Oszczędzanie Lapis"
	quest.5AEE86EB39FD4087.quest_desc: ["&3Vortex Tube&r rozdziela ciśnienie na gorące i zimne powietrze. Zimne powietrze trafia na niebieską stronę, a gorące na czerwoną."]
	quest.5AEE86EB39FD4087.quest_subtitle: "Wciąż nie RF..."
	quest.5AEE86EB39FD4087.title: "Produkcja Ciepła"
	quest.5B9F933ECD6B24FD.quest_desc: ["Pozwala skakać wyżej niż Tier II."]
	quest.5B9F933ECD6B24FD.quest_subtitle: "Maks.: 1"
	quest.5C7D9BCDF19B86BD.quest_desc: ["Zapobiega wybuchom."]
	quest.5C7D9BCDF19B86BD.quest_subtitle: "Bezpiecznie!"
	quest.5D64250B940BC8FD.quest_desc: ["Z Compressed Iron można wytworzyć &3Compressed Iron Armor&r - to to samo co Iron Armor, ale z lepszym Armor Toughness i Knockback Resistance.\\n\\nZbroję można wytworzyć albo często znaleźć w skrzyniach z łupem."]
	quest.5D64250B940BC8FD.quest_subtitle: "Świetny Knockback Resistance"
	quest.5D64250B940BC8FD.title: "Compressed Iron Armor"
	quest.5D71ED16FD4E725A.quest_desc: ["Sprawia, że piglini są pokojowo nastawieni (tak samo jak przy noszeniu złotej zbroi); ulepszenie wystarczy umieścić tylko w jednym elemencie."]
	quest.5D71ED16FD4E725A.quest_subtitle: "Maks.: 1"
	quest.5D7B34761E8FD212.quest_desc: [
		"&3Electrostatic Compressor&r generuje ogromną ilość ciśnienia z uderzeń pioruna.\\n\\nWięcej informacji znajdziesz w zakładce „Information” w JEI.\\n"
		"{image:pneumaticcraft:textures/patchouli/electrostatic_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.5D7B34761E8FD212.title: "Ciśnienie z Błyskawic"
	quest.5E71F8A046C60346.quest_desc: ["Kto Ci powiedział, że PneumaticCraft nie dotyczy wytwarzania energii?\\n\\n&3Pneumatic Dynamo&r pozwala zamienić ciśnienie na FE. Przeczytaj opis przedmiotu albo zajrzyj do PNC:R, aby dowiedzieć się, jak to działa."]
	quest.5E71F8A046C60346.quest_subtitle: "Ciśnienie = Energia"
	quest.5E71F8A046C60346.title: "Wytwarzanie Energii"
	quest.602C3E88D96F8843.quest_desc: ["Włóż Charged Empty PCB do Etching Tank z odrobiną Etching Acid i ciepłem, a otrzymasz &3Unassembled PCBs&r."]
	quest.602C3E88D96F8843.quest_subtitle: "Już prawie!"
	quest.61AD2207E770CD7F.quest_desc: ["Pozwala podnosić przedmioty i doświadczenie z większej odległości."]
	quest.61AD2207E770CD7F.quest_subtitle: "Maks.: 6"
	quest.61B479079DC1C69C.quest_desc: ["Pozwala skakać wyżej niż Tier I."]
	quest.61B479079DC1C69C.quest_subtitle: "Maks.: 1"
	quest.61BA2932EC86DA2E.quest_desc: ["Pozwala skakać BARDZO wysoko."]
	quest.61BA2932EC86DA2E.quest_subtitle: "Maks.: 1"
	quest.63F6F4EBCEB914B0.quest_desc: ["&3Pressure Chamber&r to ważny multiblok zbudowany z &3Pressure Chamber Walls&r (ściany można zastąpić &3Pressure Chamber Glass&r). Pressure Chamber może mieć rozmiar od 3x3x3 do 5x5x5. Do ukończenia tego zadania potrzebne są bloki na wersję 5x5x5.\\n\\nAby użyć Pressure Chamber, musisz doprowadzić ciśnienie do &3Pressure Chamber Valve&r za pomocą wykonanych wcześniej &3Pressure Tubes&r. Pamiętaj, aby włożyć Security Upgrade do Pressure Valve. &lRóżne receptury wymagają różnych ilości ciśnienia&r.\\n\\nMusisz też móc wkładać przedmioty do Pressure Chamber i je z niej wyjmować - do tego służą &3Pressure Chamber Interfaces&r. Niebieski kolor na zewnątrz oznacza wejście przedmiotów, a złoty na zewnątrz oznacza ich wyjście; umieść po jednym z każdego rodzaju na dowolnej ścianie."]
	quest.63F6F4EBCEB914B0.quest_subtitle: "Pod ciśnieniem!"
	quest.63F6F4EBCEB914B0.title: "The Pressure Chamber"
	quest.649167FC31EB916E.quest_desc: ["&3Vegetable Oil&r można uzyskać, wkładając uprawy albo nasiona do &3Thermopneumatic Processing Plant&r."]
	quest.649167FC31EB916E.quest_subtitle: "Lepszy olej"
	quest.649167FC31EB916E.title: "Vegetable Oil"
	quest.64D34A6C3487C5DF.quest_desc: ["&3Aerial Interface&r służy do uzupełniania ciśnienia w Twoich przedmiotach ciśnieniowych. Teraz możesz używać Pneumatic Armor bez konieczności ładowania!\\n\\nBędziesz potrzebować jednego z nich do wytworzenia &6ATM Star&r."]
	quest.64D34A6C3487C5DF.quest_subtitle: "Bezprzewodowe ciśnienie!"
	quest.64E2E05B228EA53E.quest_desc: ["&3Advanced Pressure Tubes&r to najlepsze dostępne Pressure Tubes, wytrzymujące aż 20 barów ciśnienia!\\n\\nChoć same w sobie są naprawdę fajne, można ich użyć także w jeszcze fajniejszych recepturach."]
	quest.64E2E05B228EA53E.quest_subtitle: "Zupełnie nowy poziom!"
	quest.657DB994B029F61C.quest_desc: [
		"Gdy &3Heat Frame&r umieścisz na pojemniku z niektórymi płynami i wystarczająco go schłodzisz, zamieni te płyny w przedmioty."
		""
		"Zamienia Molten Plastic w Plastic."
		"Zamienia Wodę w Ice."
		"Zamienia Lawę w Obsidian."
	]
	quest.65E2AF881709C896.quest_desc: ["Jednym z najważniejszych materiałów, jakich będziesz potrzebować, jest &3Reinforced Stone&r - zacznij od zrobienia 32 sztuk z Compressed Iron i zwykłego kamienia."]
	quest.65E2AF881709C896.quest_subtitle: "Będziesz tego potrzebować mnóstwo"
	quest.65E2AF881709C896.title: "Reinforced Stone"
	quest.6674270897997BF7.quest_desc: ["Pozwala skakać wyżej niż zwykle i sprawia, że stajesz się sprężysty, co przyspiesza podróżowanie.\\n\\nW nogawicach możesz mieć naraz tylko jeden poziom tych ulepszeń."]
	quest.6674270897997BF7.quest_subtitle: "Maks.: 1"
	quest.681A3F31FB242555.quest_desc: ["&3Ethanol&r można wykorzystać do produkcji Biodiesel."]
	quest.681A3F31FB242555.title: "Ethanol"
	quest.68F92455A9483AD6.quest_desc: ["To zadanie zobaczysz tylko wtedy, gdy użyłeś Jet Boots.\\n\\nNie da się używać Jet Boots bez otrzymywania obrażeń, nawet nie próbuj..."]
	quest.68F92455A9483AD6.quest_subtitle: "Myślałeś, że latanie na Elytrach jest trudne?"
	quest.68F92455A9483AD6.title: "Jet Boots"
	quest.6B1C06C753C10E44.quest_desc: ["&3Logistics Configurator&r służy do konfigurowania Logistic Frames i Transfer Gadgets."]
	quest.6CA01DCE1F4A0EC3.quest_desc: ["Kolejny etap moda wymaga zebrania &3Crude Oil&r. Tę ropę można znaleźć naturalnie na powierzchni Overworldu."]
	quest.6CA01DCE1F4A0EC3.quest_subtitle: "Droga do plastiku"
	quest.6CA01DCE1F4A0EC3.title: "Crude Oil"
	quest.6D124ACF4AE80490.quest_desc: ["Dzięki Micromissiles możesz wystrzeliwać eksplozje z daleka! Teraz nikt nie ucieknie!\\n\\nSą one potrzebne do wytworzenia &6ATM Star&r."]
	quest.6D124ACF4AE80490.quest_subtitle: "Wystrzeliwanie eksplozji z daleka!"
	quest.6EB53CDCB80D4B66.quest_desc: [
		"&3Pneumatic Door&r to automatyczne drzwi, które można ustawić tak, aby otwierały się tylko dla Ciebie!"
		""
		"{image:pneumaticcraft:textures/patchouli/pneumatic_door.png width:200 height:200 align:right fit:true}"
	]
	quest.6FD65139CD50A8C0.quest_desc: ["Czy to w ogóle możliwe?\\n\\nJeśli chcesz zautomatyzować ten proces, możesz użyć &eProductive Bees&r albo &aMystical Agriculture&r. Albo, jak sądzę, możesz zautomatyzować go za pomocą... wybuchów."]
	quest.6FD65139CD50A8C0.quest_subtitle: "Zmęczony wysadzaniem rzeczy?"
	quest.7040CA41C0A3C2F2.quest_desc: [
		"&3PCB Blueprints&r TERAZ W PROMOCJI za 8 Emeralds. (Tylko przez ograniczony czas)."
		"{@pagebreak}"
	]
	quest.7040CA41C0A3C2F2.quest_subtitle: "Dzięki, Amadron!"
	quest.7040CA41C0A3C2F2.title: "&9PCB Blueprint"
	quest.715B86DC82EA636B.quest_desc: [
		"&3Liquid Compressor&r wytwarza ciśnienie z użyciem niektórych płynów. Paliwo możesz wlać, klikając wiaderkiem prawym przyciskiem na maszynę, wpompowując płyn albo wkładając wiaderko do górnego slotu w GUI."
		""
		"{image:pneumaticcraft:textures/gui/gui_liquid_compressor.png width:200 height:200 align:center fit:true}"
	]
	quest.715B86DC82EA636B.title: "Ciśnienie z Płynów"
	quest.7177E49BF9ECA5CF.quest_desc: [
		"&3Thermal Compressor&r wytwarza ciśnienie za pomocą ciepła! Umieść coś gorącego po jednej stronie, a coś zimnego po drugiej, aby wytworzyć ciśnienie."
		""
		"{image:pneumaticcraft:textures/patchouli/thermal_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.7177E49BF9ECA5CF.title: "Ciśnienie z Ciepła"
	quest.718DABA6C9E5982A.quest_desc: ["Daje graczowi Night Vision, gdy jest noszone."]
	quest.718DABA6C9E5982A.quest_subtitle: "Maks.: 1"
	quest.72C09FD89C28B1EC.quest_desc: [
		"&3Oil Refinery&r, które zbudujemy, to multiblok 1x1x5 składający się z 1 &3Refinery Controller&r (na dole) i czterech &3Refinery Outputs&r (na górze). Do działania musisz doprowadzić ropę i ciepło. Wytworzy Diesel, Kerosene, Gasoline i LPG. Umieszczenie &3Thermal Laggings&r po bokach pomaga utrzymać ciepło."
		""
		"{image:atm:textures/questpics/pneumaticcraft/oil_refinery.png width:300 height:150 align:center}"
	]
	quest.72C09FD89C28B1EC.quest_subtitle: "Zaczyna się dziać"
	quest.72C09FD89C28B1EC.title: "Oil Refinery"
	quest.7386A8433698946C.quest_desc: [
		"Wybierz przedmiot, a to ulepszenie będzie go szukać w pobliżu w skrzyniach albo na ziemi. Aby znaleźć go w skrzyniach, potrzebuje Block Tracker Upgrade, a aby znaleźć go na ziemi - Entity Tracker Upgrade.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/item_search_upgrade.png width:200 height:200 align:center}"
	]
	quest.7386A8433698946C.quest_subtitle: "Maks.: 1"
	quest.7395B41685F4BC1A.quest_desc: ["&3Flux Compressor&r potrafi wytworzyć mnóstwo ciśnienia z energii. Wystarczy wpompować trochę FE, a zacznie je wytwarzać. Jeśli masz FE na zbyciu, to chyba najłatwiejszy sposób na wytwarzanie ciśnienia."]
	quest.7395B41685F4BC1A.quest_subtitle: "Energia = Ciśnienie"
	quest.7395B41685F4BC1A.title: "Ciśnienie z Energii"
	quest.74015945716FD10A.quest_desc: ["&3Omnidirectional Hopper&r może przyjmować przedmioty z dowolnej strony, a dodatkowo można go ulepszyć, by działał znacznie szybciej niż zwykły lejek! Przydaje się, gdy rury nie są potrzebne."]
	quest.74015945716FD10A.quest_subtitle: "Konfigurowalny lejek"
	quest.74AE214747A3DB1A.quest_desc: ["Zwiększa ilość ciśnienia, jaką mogą utrzymać przedmioty."]
	quest.74AE214747A3DB1A.quest_subtitle: "Podkręć to!"
	quest.75D3F3C1D4A3EAA2.quest_desc: ["Aby przemieszczać ciepło wytwarzane przez Vortex Tube, zrób trochę &3Heat Pipes&r."]
	quest.75D3F3C1D4A3EAA2.quest_subtitle: "Mamy ciepło do przeniesienia :)"
	quest.75D3F3C1D4A3EAA2.title: "Przemieszczanie Ciepła"
	quest.762B8309E1A31B99.quest_desc: ["Każde ulepszenie dodaje +0,5 Armor Defence i +1 Armor Toughness."]
	quest.762B8309E1A31B99.quest_subtitle: "Max: 4"
	quest.7770F0D62457096D.quest_desc: ["Choć te zadania nie omówią dronów, są one niesamowite! Jeśli chcesz, zajrzyj do nich."]
	quest.7770F0D62457096D.title: "Programowanie Dronów"
	quest.795143471F31A64A.quest_subtitle: "Wymagane do receptur z laserem"
	quest.7953C87C488A2AF7.quest_desc: ["Pozwala latać jak Iron Man.\\n\\nW butach możesz mieć naraz tylko jeden poziom tych ulepszeń. Każdy poziom zużywa więcej ciśnienia niż poprzedni.\\n\\nUżywaj tych ulepszeń, nie tylko je wytwarzaj."]
	quest.7953C87C488A2AF7.quest_subtitle: "Maks.: 1"
	quest.7B2008977702D0C8.quest_desc: ["Gdy wytwarzasz ciśnienie w Air Compressor, a nie masz dokąd go odprowadzić, po prostu zniknie. Upewnij się, że masz gdzie skierować ciśnienie, zanim zaczniesz je wytwarzać."]
	quest.7B2008977702D0C8.quest_subtitle: "Co się stało z RF i FE?"
	quest.7BFC24607189B6D0.quest_desc: ["Sprawia, że pływasz szybciej."]
	quest.7BFC24607189B6D0.quest_subtitle: "Maks.: 1"
	quest.7BFE7DAF18981843.quest_subtitle: "Wymagane do receptur z wiertłem"
	quest.7D6B4AEF806AF62E.quest_desc: ["100% za szybko! Staraj się nie zginąć!"]
	quest.7D6B4AEF806AF62E.quest_subtitle: "Maks.: 1"
	quest.7D81F2381516204D.quest_subtitle: "Potrzebne do Finished PCB"
	quest.7D81F2381516204D.title: "Transistors"
	quest.7FB12EC3A5888123.quest_desc: ["&3Tube Junction&r daje większą kontrolę nad transportem ciśnienia, pozwalając poprowadzić Pressure Tubes w większej liczbie kierunków."]
	quest.7FB12EC3A5888123.quest_subtitle: "Nie, idź tędy!"
