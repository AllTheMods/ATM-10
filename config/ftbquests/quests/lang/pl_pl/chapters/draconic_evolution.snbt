{
	quest.0000A88BB40B2149.quest_desc: ["Zanim udasz się na Chaos Island, polecam się przygotować. Może wyglądać jak Ender Dragon, ale ten jest znacznie trudniejszy. Przydadzą Ci się Draconic Weapons lub Tools zadające dużo obrażeń, bo znacznie ułatwią walkę. Zadaje też mnóstwo obrażeń, więc dobra zbroja, np. z Unobtainium albo Meka-Suit, jest bardzo wskazana. (Pomogą też efekty Regeneration, Absorption i Resistance}. Spokojnie, zawsze możesz wrócić i walczyć innym razem, jeśli nie jesteś jeszcze gotowy."]
	quest.0000A88BB40B2149.title: "Będzie Ciężko, Musisz się Przygotować"
	quest.01612963DBBAC9A1.quest_desc: ["Miejmy nadzieję, że to Cię ochroni."]
	quest.01612963DBBAC9A1.title: "Chaotic Chestplate"
	quest.0252B8F77A038D17.title: "Wyvern Auto Feed Module"
	quest.04695DA1BD3BF1B2.title: "Chaotic Damage Module"
	quest.0499A372F55D04C8.title: "Draconic Projectile Velocity Module"
	quest.04BF68E4554D69AA.quest_desc: [
		"Ostatni i najlepszy - Tier 8! Potrzebujesz 378 bloków Awakened Draconium i 786 bloków Draconium Ingot! Czy warto?"
		"{image:atm:textures/questpics/draconic/draconic_core_8off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_8on.png width:100 height:100 align:1}"
	]
	quest.04BF68E4554D69AA.quest_subtitle: "Magazynuje: prawie nieskończoność"
	quest.04BF68E4554D69AA.title: "Tier 8"
	quest.052E261F934AB439.quest_desc: ["Potrafi też tworzyć ścieżki!"]
	quest.052E261F934AB439.title: "Chaotic Shovel"
	quest.070F8045CC14B50D.title: "Draconic Projectile Penetration Module"
	quest.0817FD6E45C127E8.quest_desc: ["Technicznie jest to opcjonalne, ale zalecane! Dzięki większej liczbie Pylons możesz wpuszczać i wypuszczać więcej OP!"]
	quest.0817FD6E45C127E8.title: "Więcej Pylons {Opcjonalnie)"
	quest.0AE8B51D63327EC3.title: "Chaotic Shield Recovery Module"
	quest.0AE930BA037DC565.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Działa jak zwykły łuk, czyli strzela strzałami. Każdy strzał zabiera trochę energii z samego łuku, więc tak, potrzebujesz przynajmniej Energy Modules."]
	quest.0AE930BA037DC565.title: "Wyvern Bow"
	quest.0E487EACA837EA9B.title: "Chaotic Shield Control Module"
	quest.10690FDB9E892250.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Zamachnij się i w coś uderz. No weź, to miecz, nie potrafię już tego bardziej wyjaśnić."]
	quest.10690FDB9E892250.title: "Wyvern Sword"
	quest.106D08542AAFA166.quest_desc: [
		"Pierwsza faza walki polega na niszczeniu kryształów, które podtrzymują tarczę Chaos Guardian. Dopóki nie zostaną zniszczone, nie możesz go zranić. Bez broni Draconic nie jest to łatwe zadanie. Kule ognia Chaos Guardian mogą osłabić tę tarczę, co pozwoli Ci ją zniszczyć. (Tak, musi strzelać w Ciebie/trafiać w kryształy). Gdy kryształ jest podatny na obrażenia, zauważysz wydobywające się z niego cząsteczki, a trafiony wyda dźwięk. Im bliżej zniszczenia, tym głębszy dźwięk i tym ciemniejszy kryształ. Gdy wszystkie zostaną zniszczone, w końcu możesz go zranić!"
		"{image:atm:textures/questpics/draconic/draconic_end_crystal.png width:150 height:100 align:1}"
	]
	quest.106D08542AAFA166.title: "Znajdź i Zniszcz 14 Guardian Crystals"
	quest.10E4ADA1D0063EB7.title: "Chaotic Projectile Velocity Module"
	quest.120B403D56EE5C79.title: "Wyvern Energy Module"
	quest.12469CC0CCFBA1C5.quest_desc: ["Najlepszy miecz plus najszybszy kilof plus łopata?!?! Czego chcieć więcej!"]
	quest.12469CC0CCFBA1C5.title: "Chaotic Staff"
	quest.129E09C03E40BA57.quest_desc: ["Reaktor jako paliwa używa Awakened Draconium, ale spokojnie, jest wydajny! Fuel Conversion określa, kiedy Awakened Draconium zmieni się w Chaos. Mieści tylko 8 bloków naraz i można go zasilać paliwem lub uzupełniać je tylko wtedy, gdy reaktor jest wyłączony. Tryb SAS to ułatwia! Paliwo trafia też do slotów w prawym dolnym rogu."]
	quest.129E09C03E40BA57.title: "Paliwo do Naszego Reaktora"
	quest.12BDE512C734D19A.quest_desc: ["Draconium Cores to kluczowy składnik wielu receptur w Draconic Evolution. Zwłaszcza dla przedmiotów poziomu Basic."]
	quest.12BDE512C734D19A.title: "Basic (Draconium) Core"
	quest.131AA933D59D3017.quest_desc: [
		"Tier 5 wymaga 90 bloków Draconium Ingot i 80 bloków redstone oraz 4 Advanced Stabilizers lub 36 Stabilizers."
		"{image:atm:textures/questpics/draconic/draconic_core_5off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_5on.png width:100 height:100 align:1}"
	]
	quest.131AA933D59D3017.quest_subtitle: "Magazynuje: 59,300,000,000 RF"
	quest.131AA933D59D3017.title: "Poziom 5"
	quest.154D9EA863FD2A32.title: "Chaotic Projectile Penetration Module"
	quest.164BBBD98163F64C.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Potrafi zrobić pole uprawne albo zabrać Twoje pieniądze. Moment, to motyka z Minecrafta, przepraszam, myślałem o innej."]
	quest.164BBBD98163F64C.title: "Wyvern Hoe"
	quest.165030137EF59299.title: "Wyvern Area-Of-Effect Module"
	quest.166D2A191871F80E.quest_desc: ["Ulepszona wersja Wyvern Pickaxe."]
	quest.166D2A191871F80E.title: "Draconic Pickaxe"
	quest.16FF2219F110F50A.quest_desc: ["Undying działa jak Recovery Totem! Gdy Twoje serca spadną do 0, zamiast umrzeć, moduł się aktywuje, dając Ci Absorption i Regeneration, i ratując Ci życie. Ma czas odnowienia i potrzebuje OP, aby naładować się ponownie. Postaraj się nie zginąć w tym czasie! Lepsze ulepszenia oznaczają krótsze czasy odnowienia."]
	quest.16FF2219F110F50A.title: "Wyvern Undying Module"
	quest.1830412AB77E9526.quest_desc: ["Po tak prymitywnej broni jak łuk nie można oczekiwać idealnej celności. No cóż, można, jeśli użyjesz tych modułów. Strzała znacznie częściej trafi w cel i nie zboczy z kursu."]
	quest.1830412AB77E9526.title: "Wyvern Projectile Accuracy Module"
	quest.1A53B6544782442E.quest_desc: ["Shield Control zmienia rozmiar Twojej tarczy i to, kiedy się regeneruje."]
	quest.1A53B6544782442E.title: "Wyvern Shield Control Module"
	quest.1C8210712349A2E3.quest_desc: ["Dość prosty pomysł: topory i miecze zadają więcej obrażeń. Tak, to się kumuluje!"]
	quest.1C8210712349A2E3.title: "Basic Damage Module"
	quest.1D3E2363CFD4C5E0.quest_desc: ["Fusion Crafting ma poziomy, które zależą od Injectors. Poziomy idą w kolejności rosnącej: Draconium (nazywam go Basic, żeby łatwiej było je odróżnić), Wyvern, Draconic i Chaotic. Injectors trzeba ustawić po lewej i prawej stronie Fusion Crafting Core, kilka bloków od niego. Można je rozmieścić w kształcie krzyża, maksymalnie po 5 z każdej strony Crafting Core. Aby dostarczyć im energię, wystarczy podłączyć do nich Relay IO Crystals - zajrzyj do zadania Crystal Binding, by dowiedzieć się więcej."]
	quest.1D3E2363CFD4C5E0.title: "Poziom Basic"
	quest.1E41A5071854DEC8.title: "Wyvern Damage Module"
	quest.1F7D147C9AF6A4FC.quest_desc: [
		"Tier 4 jest inny. Najpierw potrzebuje 26 bloków redstone otaczających Core. Następnie nad redstonem potrzebuje 56 bloków Draconium Ingot."
		"{image:atm:textures/questpics/draconic/draconic_core_4off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_4on.png width:100 height:100 align:1}"
	]
	quest.1F7D147C9AF6A4FC.quest_subtitle: "Magazynuje: 9,880,000,000 RF"
	quest.1F7D147C9AF6A4FC.title: "Poziom 4"
	quest.20D8DA523E900A52.quest_desc: ["Wireless Energy Links sprawiają, że Wireless Crystals mogą ładować Twoje przedmioty. Im więcej modułów, tym więcej OP może przyjąć i tym szybciej."]
	quest.20D8DA523E900A52.title: "Wireless Energy Link"
	quest.2158A566C2F54AA9.title: "Draconic Shield Control Module"
	quest.22D383BAEF8A2B39.quest_desc: ["Znasz legendarny Paxel? Połączenie kilofa, topora i łopaty? To jest podobne, tylko łączy miecz, kilof i łopatę! Robi wszystko to, co narzędzia Draconic!"]
	quest.22D383BAEF8A2B39.title: "Draconic Staff"
	quest.236C936FE3BA8396.title: "Chaotic Flight Module"
	quest.265D0DB0E8CED73B.title: "Draconic Projectile Gravity Compensation Module"
	quest.26DF1427AC3966DE.quest_desc: ["Witaj w Draconic Evolution, bardzo zabawnej i OP modyfikacji! Na początek musisz wydobyć Draconic Ore, aby zdobyć Draconic Dust. Występuje we wszystkich wymiarach (vanilla), ale najwięcej jest w Endzie!"]
	quest.26DF1427AC3966DE.title: "Draconic Evolution"
	quest.285656AF1F870AF8.quest_desc: ["1 z 2 infuzji poziomu Basic, ale nie lekceważ Draconic Chest. Mieści więcej niż duża skrzynia, potrafi przetapiać i wytwarzać przedmioty, a co najlepsze, może zmieniać kolory! Bez wątpienia moja ulubiona skrzynia ze wszystkich modyfikacji!"]
	quest.285656AF1F870AF8.title: "Draconium Chest"
	quest.28AF8DD34412CBAA.title: "Draconic Speed Module"
	quest.295EB6CFEC029AE2.quest_desc: ["Zanim tu dotrzesz, potrzebujesz przedmiotu, który przyjmuje OP: Wyvern Bow, Chaotic Capacitor, Staff of Power - cokolwiek. Potem potrzebujesz Energy Module w tym przedmiocie, bo to on określa pojemność OP przedmiotu i z niego przedmiot będzie czerpał energię. Gdy to masz, wytwórz i postaw Energy Transfuser, wpuść do niego OP, a następnie włóż do niego swój przedmiot! Poznasz, że działa, gdy OP w nim się zaświeci i zacznie się poruszać."]
	quest.295EB6CFEC029AE2.title: "Dodawanie OP do Przedmiotów"
	quest.2A5C5B44E9643A5D.title: "Chaotic Speed Module"
	quest.2AA08313F927981E.title: "Wyvern Speed Module"
	quest.2AAE61752728EA8D.quest_desc: ["Gdy „spadasz”, Twoje kopanie jest spowolnione. Dotyczy to też latania w trybie kreatywnym, a nawet odbijania się w wodzie. Na szczęście możesz użyć zaklęcia Air Affinity, aby to zniwelować! To nie jest zaklęcie z vanilli, ale i tak jest pomocne! Moment, miałem mówić o module... to samo!"]
	quest.2AAE61752728EA8D.title: "Mining Stabilizer Module"
	quest.2B6D71DAF72EAFA4.quest_desc: ["Capacitors to akumulatory Draconic Evolution. Potrzebują Energy Modules, aby faktycznie przechowywać energię, i pamiętaj: „im więcej, tym lepiej!”."]
	quest.2B6D71DAF72EAFA4.title: "Wyvern Capacitor"
	quest.2D9AF97C03C5AEC7.quest_desc: ["Dla Tier 5-8 potrzebujesz Advanced Stabilizers. Czym jest Advanced Stabilizer? To 9 Stabilizers w obszarze 3x1x3. Jeśli zrobisz to dobrze, zmienią się w okrąg! Zrób to tak samo, jak przy 1 Stabilizer."]
	quest.2D9AF97C03C5AEC7.title: "Advanced Stabilizers"
	quest.2DB2A4A1182FE0BB.quest_desc: [
		"Tier 6 wymaga 150 bloków Draconium Ingot i 178 bloków redstone (nie zapomnij o 36 Stabilizers)."
		"{image:atm:textures/questpics/draconic/draconic_core_6off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_6on.png width:100 height:100 align:1}"
	]
	quest.2DB2A4A1182FE0BB.quest_subtitle: "Magazynuje: 356,000,000,000 RF"
	quest.2DB2A4A1182FE0BB.title: "Poziom 6"
	quest.2E74B5149D4BD0A0.quest_desc: ["Basic (Energy Relay) Crystal to początek przesyłania energii w Draconic Evolution! "]
	quest.2E74B5149D4BD0A0.title: "Basic Energy Relay Crystal"
	quest.30F97EB743B0A07F.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Wyvern Axe przypomina topory z Minecrafta po Combat Updates. Można go używać jako broni do zabijania wrogów albo jako narzędzia do ścinania drzew."]
	quest.30F97EB743B0A07F.title: "Wyvern Axe"
	quest.3235FBD9CE21D5EE.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Wiem, co naprawdę Was obchodzi, drodzy gracze: Wyvern Shovel. Nie musicie już spędzać bezsennych nocy, bo teraz już wiecie: łopaty DE potrafią robić ścieżki."]
	quest.3235FBD9CE21D5EE.title: "Wyvern Shovel"
	quest.32EBB3D53AA91E09.quest_desc: ["Chyba że jesteś małym oszustem używającym paczek tekstur z widzeniem w ciemności, ciemność może Cię trochę przerażać. Na szczęście Night Vision Module w Draconic Chestplate pomaga przezwyciężyć strach przed brakiem widoczności w ciemności. Ale nie strach przed tym, co w niej siedzi..."]
	quest.32EBB3D53AA91E09.title: "Night Vision Module"
	quest.33D2901594655A77.title: "Chaotic Area-Of-Effect Module"
	quest.34D3F6D54F5B26C2.quest_desc: ["Ulepszona motyka, czyli po prostu miła i dobra pani?"]
	quest.34D3F6D54F5B26C2.title: "Draconic Hoe"
	quest.35767977FB9E0B1B.quest_desc: [
		"Tier 2 wymaga 6 bloków Draconium Ingot, po 1 z każdej strony Core. Oczywiście trzeba też wytworzyć 4 Stabilizers."
		"{image:atm:textures/questpics/draconic/draconic_core_2off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_2on.png width:100 height:100 align:1}"
	]
	quest.35767977FB9E0B1B.quest_subtitle: "Magazynuje: 273,000,000 RF"
	quest.35767977FB9E0B1B.title: "Poziom 2"
	quest.35A674E2C6F66673.title: "Chaotic Projectile Accuracy Module"
	quest.366431661CC43A6E.quest_desc: [
		"To zadanie zostało napisane przez &6AllTheMods Staff&r lub &2współtwórcę z Community&r na potrzeby paczek AllTheMods."
		"Ponieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody."
		""
		""
		""
		"To zadanie jest celowo ukryte. Jeśli to widzisz, jesteś w trybie edycji."
	]
	quest.36DAFC3FECC67406.quest_desc: ["Najlepszy akumulator energii, jaki oferuje DE."]
	quest.36DAFC3FECC67406.title: "Chaotic Capacitor"
	quest.36F123B2A6B52A01.quest_desc: ["Przesyłają więcej energii i mają więcej połączeń. Najwyższy poziom Energy Crystals."]
	quest.36F123B2A6B52A01.title: "Draconic Energy Relay Crystal"
	quest.3765485408041FC6.quest_desc: ["Zajrzyj do zadania Modules, aby dowiedzieć się, jak używać i ulepszać przedmioty DE! Kilofy działają jak zwykły kilof poziomu 6. Wydobędą każdy poziom bloków, od Stone po Unobtainium. Wydobyte przedmioty trafiają automatycznie do Twojego ekwipunku."]
	quest.3765485408041FC6.title: "Wyvern Pickaxe"
	quest.376D154F27A00BCD.quest_desc: ["Co jest z fizyką i DE, że ją zdradzają? Grawitacja ściąga strzałę w dół w miarę lotu. Gravity Compensation sprawia, że mniej musimy się tym martwić."]
	quest.376D154F27A00BCD.title: "Wyvern Projectile Gravity Compensation Module"
	quest.37CC51B689CB8A40.quest_desc: ["Napierśniki działają podobnie do Meka-Suit. Wszelkie obrażenia, które miałyby Cię trafić, są niwelowane i zamiast tego odejmowane od Twojej tarczy. Shield capacity to ilość tarczy, jaką możesz pomieścić, recharge rate to szybkość jej napełniania, a OP jest zużywane podczas ładowania."]
	quest.37CC51B689CB8A40.title: "Wyvern Shield Capacity Module"
	quest.389655CD41C7A691.quest_desc: [
		"Tier 1 wymaga tylko Core i wytworzenia 4 Stabilizers."
		"{image:atm:textures/questpics/draconic/draconic_core_1off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_1on.png width:100 height:100 align:1}"
	]
	quest.389655CD41C7A691.quest_subtitle: "Magazynuje: 45,500,000 RF"
	quest.389655CD41C7A691.title: "Poziom 1"
	quest.38AD547C36BDF4C4.title: "Draconic Projectile Accuracy Module"
	quest.39865681B03CABAA.quest_desc: ["Woda jest nieco lepka, a przynajmniej gęstsza od powietrza. Dlatego kopanie pod wodą jest wolniejsze. Możesz użyć zaklęcia Aqua Affinity albo tego modułu. Twój wybór!"]
	quest.39865681B03CABAA.title: "Aqua Adapt Module"
	quest.39AF9B1A996DA949.quest_desc: ["To jak Netherite Sword, tylko znacznie lepszy i fajniejszy!"]
	quest.39AF9B1A996DA949.title: "Chaotic Sword"
	quest.3B4CEE8A8CE0D6CB.quest_desc: [
		"Prawie u celu! Tier 7. 210 sztabek Draconium Ingot i 328 bloków redstone!"
		"{image:atm:textures/questpics/draconic/draconic_core_7off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_7on.png width:100 height:100 align:1}"
	]
	quest.3B4CEE8A8CE0D6CB.quest_subtitle: "Magazynuje: 2,140,000,000,000 RF"
	quest.3B4CEE8A8CE0D6CB.title: "Poziom 7"
	quest.3BE3B54B4A681668.quest_desc: ["Wszystko sprowadza się do tego: wolisz ranić wrogów jak ciężarówka, tylko znacznie wolniej? Czy raczej być normalną osobą, która używa miecza?"]
	quest.3BE3B54B4A681668.title: "Chaotic Axe"
	quest.3CB8F5F1D33C8F9F.quest_desc: ["To samo co w poprzednim zadaniu, tylko więcej, dużo więcej."]
	quest.3CB8F5F1D33C8F9F.title: "Wyvern Large Shield Capacity Module"
	quest.3DF794EBCAA7AE1A.title: "Draconic Tree Harvester"
	quest.3FD19A001899D8C6.quest_desc: ["No dobra, ten daje zarówno szybowanie, jak i prawdziwe latanie, a dokładniej Creative Flight."]
	quest.3FD19A001899D8C6.title: "Draconic Flight Module"
	quest.40F34EBE09DA7752.quest_desc: ["Auto-Feed automatycznie karmi Cię dowolnym jedzeniem z ekwipunku, gdy jesteś głodny. Ma jednak limit magazynowanych punktów głodu, a każdy pełny pasek to 2 punkty. Wersja Basic mieści więc tylko 8 Steaks."]
	quest.40F34EBE09DA7752.title: "Basic Auto Feed Module"
	quest.41BD497108CA109F.quest_desc: ["Awakened Draconium powstaje przez Fusion Crafting bloków. Bloki można rozłożyć na 9 sztabek. Są to drugie najważniejsze sztabki w Draconic Evolution, bardzo potrzebne na poziomach Wyvern i Draconic."]
	quest.41BD497108CA109F.title: "Awakened Draconium"
	quest.421954D7D46FAAD6.quest_desc: ["Energy Core Stabilizers... stabilizują? Core. Dla pierwszych 4 poziomów Cores potrzebujesz tylko 4 Stabilizers wokół niego. Przez Stabilizers możesz też otworzyć GUI Core. Jeśli są ustawione zbyt blisko Core lub w złych miejscach, wyświetli się informacja, że jest nieprawidłowo."]
	quest.421954D7D46FAAD6.title: "Energy Core Stabilizers"
	quest.43C2B07AB25C708E.quest_desc: ["Ulepszona wersja Wyvern Bow."]
	quest.43C2B07AB25C708E.title: "Draconic Bow"
	quest.45EE60207C466D6C.quest_desc: ["Aby wejść w Draconic Evolution, potrzebujesz Chaos Shards. Chaos Shards znajdują się na Chaos Islands strzeżonych przez Chaos Guardians w Endzie. Udaj się do Endu na współrzędne X/Z będące wielokrotnością 10k. 10k, 10k / 10k, 20k / 20k, 20k itd."]
	quest.45EE60207C466D6C.quest_subtitle: "Odnajdywanie Chaos Island"
	quest.45EE60207C466D6C.title: "Gdzie On Jest?"
	quest.4638F21544D6D337.title: "Chaos-Entangled Quantum Energy Tunnel"
	quest.46C816844C513D5D.quest_desc: ["Ulepszona wersja Wyvern Shovel."]
	quest.46C816844C513D5D.title: "Draconic Shovel"
	quest.4903BDC389C73082.title: "Draconic Projectile Damage Module"
	quest.4A3A5684302C8627.title: "Chaotic Shield Capacity Module"
	quest.4AAADEC52D16461A.quest_desc: ["Zasadniczo włącza automatyczne skakanie. Osobiście je lubię, ale to Ty decydujesz, czy z niego korzystać!"]
	quest.4AAADEC52D16461A.title: "Hill Step Module"
	quest.4AB564420C48579B.quest_desc: ["Draconic Evolution nie widzi potrzeby okrywania całego ciała żałosną zbroją, skoro można użyć jednego napierśnika z wbudowanymi tarczami. Moment, one nie są wbudowane, potrzebujesz do nich modułów... przepraszam."]
	quest.4AB564420C48579B.title: "Wyvern Chestplate"
	quest.4ABEF61DADBD0640.quest_desc: ["Większość łuków jest półautomatyczna. Trzeba naciągnąć cięciwę, puścić, włożyć kolejną strzałę i powtórzyć. Zamiast tego pomiń to wszystko i pozwól łukowi strzelać automatycznie za każdym razem, gdy jest w pełni naciągnięty. Po prostu przytrzymaj prawy przycisk myszy i patrz, jak leci!"]
	quest.4ABEF61DADBD0640.title: "Auto Fire Module"
	quest.4B7840F1A8CF1378.quest_desc: ["Fusion Crafting to sposób wytwarzania większości przedmiotów (przynajmniej tych fajnych). Aby zacząć, potrzebujesz Fusion Crafting Core, postaw go mniej więcej blok nad ziemią. Do Core można automatycznie wstawiać receptury z JEI; tu trafia środkowy przedmiot i tu pojawi się przedmiot końcowy. Potrzebne będą też Injectors ustawione kilka bloków od niego, zwrócone w stronę Core, po dwóch jego stronach. Więcej o nich w następnym zadaniu. Injectors potrzebują też energii, co zostanie wyjaśnione dokładniej w zadaniu Crystal Binding."]
	quest.4B7840F1A8CF1378.title: "Fusion Crafting"
	quest.4B9FF9E972B0E530.quest_desc: ["Oczywiście im lepszy Energy Link lub Tunnel, tym więcej OP może przesłać, ale mogłeś też zauważyć, że czegoś brakuje w Energy Link. Nie działa między wymiarami! Na szczęście lepsze wersje potrafią, tylko upewnij się, że druga strona jest załadowana (chunkloaded)."]
	quest.4B9FF9E972B0E530.title: "Quantum Energy Tunnel"
	quest.4CD2ADD3601B8191.quest_desc: ["Chcesz, aby Twój Shield wracał nie tylko wtedy, gdy prawie giniesz? Wtedy potrzebujesz Recovery Modules. Im więcej modułów, tym szybciej się regeneruje."]
	quest.4CD2ADD3601B8191.title: "Wyvern Shield Recovery Module"
	quest.4E27182763DA83DC.quest_desc: ["Ulepszona wersja Wyvern Chestplate."]
	quest.4E27182763DA83DC.title: "Draconic Chestplate"
	quest.4EFFE300EC781C3E.quest_desc: ["Moduły są bardzo ważne dla naszych przedmiotów DE. Tak ważne, że bez nich nie działają! Większość modułów wytwarza się z Module Core lub poprzedniego modułu. Trzymając przedmiot, naciśnij Shift i C, aby otworzyć menu modułów. Zobaczysz tam sloty i przyciski! W slotach umieszcza się moduły, a siatka określa, ile modułów się zmieści. Moduł oznaczony 1x1 zajmie tylko 1 slot, a ten z oznaczeniem 2z2 zajmie 4 sloty. Najniższy przycisk po prawej pokaże, jakie moduły można zastosować w trzymanym przedmiocie. Pozostałe zmieniają tylko wygląd GUI."]
	quest.4EFFE300EC781C3E.title: "Moduły!"
	quest.4F6A9F1AEFD535F5.title: "Draconic Large Shield Capacity Module"
	quest.50013DD7370F8EDB.title: "Chaotic Jump Module"
	quest.5021D159A5EC2315.title: "Draconic Energy Module"
	quest.51CF09EC333DB1A3.quest_desc: ["Aby awansować na wyższy poziom w Fusion Crafting w Draconic Evolution, Injectors wymagane do receptury muszą być co najmniej tego poziomu lub wyższe. Na przykład, jeśli chcesz wytworzyć Wyvern Axe, potrzebujesz co najmniej 6 Wyvern Injectors, po 3 z każdej strony. Spokojnie, Crafting Core pozostaje ten sam!"]
	quest.51CF09EC333DB1A3.title: "Poziom Wyvern"
	quest.529123A789D790E3.title: "Wyvern Jump Module"
	quest.52C301DF1776E0D8.title: "Chaotic Projectile Damage Module"
	quest.52C3F61D678B00F5.quest_desc: ["Chaotic Hoe, kiedyś chodziłem z jedną taką."]
	quest.52C3F61D678B00F5.title: "Chaotic Hoe"
	quest.52EA9793A7100E75.title: "Chaotic Undying Module"
	quest.542AD6FD1927C3E6.title: "Draconic Undying Module"
	quest.5443E15E226DFC86.quest_desc: ["Pylons służą do wprowadzania OP do Energy Core i wyprowadzania go z niego. Ustaw je przynajmniej w pobliżu Core, 2 sztuki - 1 na wejście i 1 na wyjście (możesz użyć więcej). Następnie połóż na nich Glass, a złożą się automatycznie, celując w najbliższy Energy Core. Kliknij prawym przyciskiem myszy nowo powstałe kule na Pylons, aby zmienić, czy są wejściem (Input), czy wyjściem (Output) - poznasz to po strzałkach i wyglądzie. Potem możesz podłączyć do nich Crystals, aby przenosić OP w obie strony!"]
	quest.5443E15E226DFC86.title: "Przez Nie Energia Wpływa i Wypływa"
	quest.54F78C9A945CF0E7.title: "Chaotic Energy Module"
	quest.574E5806D1A98FE5.quest_desc: ["Energy Modules to najważniejsze moduły i są potrzebne do używania przedmiotów DE. Ilość w nich określa, ile OP przedmiot może pomieścić i przyjąć; zajrzyj do zadania Energy Infuser, aby dowiedzieć się więcej o ładowaniu. Im wyższy poziom Energy Module, tym więcej OP przedmioty mogą pomieścić i zużyć. To ważne, bo ulepszone przedmioty zużywają więcej OP na użycie."]
	quest.574E5806D1A98FE5.title: "Basic Energy Module"
	quest.5895B7FA5497BD68.quest_desc: ["Ulepszona wersja Wyvern Axe."]
	quest.5895B7FA5497BD68.title: "Draconic Axe"
	quest.594BBD31461F212D.title: "Draconic Shield Recovery Module"
	quest.5ADFC45B03BAB852.quest_desc: ["Do tego służą Draconic Cores."]
	quest.5ADFC45B03BAB852.title: "Poziom Draconic"
	quest.5BC6CC3C09F512A7.quest_desc: [
		"Reactor Core to najważniejsza część reaktora, czyli jego serce (Core)! Postaw go co najmniej 5 bloków od Injector i Stabilizers, a po kliknięciu prawym przyciskiem myszy zobaczysz jego GUI: kilka pasków, kulę, przyciski i sloty. Paski od lewej do prawej to: Heat, Containment Field, Energy Saturation i Fuel Conversion. Field i Energy już poznałeś, a o Fuel dowiesz się w następnym zadaniu. Heat jest dość ważne, bo podczas rozgrzewania wzrośnie do 2000C, zanim reaktor będzie gotowy do aktywacji. Dopilnuj, żeby nie wzrosło zbyt wysoko, bo inaczej... awaria (meltdown)! Kula to obraz Twojego Core, ale mam teraz błąd, przez który Core nie ma tekstury, więc nie mogę wiele wyjaśnić. Przyciski zmieniają wygląd GUI, aktywują lub wyłączają reaktor i ładują go."
		"{image:atm:textures/questpics/draconic/draconic_reactor_off_down.png width:200 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_reactor_off_up.png width:150 height:150 align:1}"
	]
	quest.5BC6CC3C09F512A7.quest_subtitle: "NIEOGRANICZONA MOC"
	quest.5BC6CC3C09F512A7.title: "Budowa Reaktora"
	quest.5C2CF51D28F84CBE.quest_desc: [
		"Teraz zaczyna się właściwa walka. Ma dwa paski zdrowia i oba trzeba zbić do 0, aby zdobyć Chaos Shards. Nie podchodź zbyt blisko, bo uderzy Cię salwą kul ognia! {Nawiasem mówiąc, w starszych wersjach Chaos Guardian potrafił zabić nawet kogoś w trybie kreatywnym! Na szczęście już nie może)"
		"{image:atm:textures/questpics/draconic/draconic_guardian.png width:150 height:100 align:1}"
	]
	quest.5C2CF51D28F84CBE.title: "Pokonaj Chaos Guardian"
	quest.5D87088E8D71DB9B.quest_desc: ["IO Crystals działają jak bloki, które można ze sobą łączyć i przesyłać między nimi energię. Aby je połączyć, przytrzymaj Shift i kliknij prawym przyciskiem myszy, trzymając Crystal Binder, by ustawić jeden, a potem kliknij prawym przyciskiem ten Crystal, który chcesz połączyć. Gdy na niego spojrzysz, wyświetli się Input from block albo Output to block. Input to ten, z którego chcesz pobierać OP, a Output to miejsce, do którego ma trafiać."]
	quest.5D87088E8D71DB9B.title: "Przenoszenie OP"
	quest.5E0D78B7B2CF1729.quest_desc: ["Wiem, że to poziom Wyvern, więc czemu jest tu przedmiot Draconic? Żeby dotrzeć do poziomu Draconic, potrzebujesz Draconic Injectors. Żeby zdobyć Draconic Injectors, potrzebujesz Draconic Cores. Widzisz teraz, dlaczego tu są?"]
	quest.5E0D78B7B2CF1729.title: "Draconic Core"
	quest.5E671F1F370DDE43.title: "Draconic Auto Feed Module"
	quest.5E8D527DE9D7DD46.quest_desc: ["Z tym na Chestplate możesz szybować! Jakbyś używał Elytra (ale bez kosztu zbroi). Nie lubię nazywać tego lataniem, raczej „spadaniem ze stylem”."]
	quest.5E8D527DE9D7DD46.title: "Wyvern Flight Module"
	quest.607337D8AA20FA18.quest_desc: ["Wszystkie drzewa połączone ze ściętym zostają ścięte razem z nim."]
	quest.607337D8AA20FA18.title: "Wyvern Tree Harvester"
	quest.60C27206F1414DD6.quest_desc: ["Dzięki Newtonowi wiemy, że każdej akcji towarzyszy równa jej, przeciwnie skierowana reakcja. W skrócie, gdy strzała trafia moba, siła moba działa na strzałę i ją spowalnia. Chyba że masz ten moduł. Nie działa tak, jakby każdy mob był z papieru, tylko tak, jakby żaden mob nie stał na drodze. Strzały nie zwalniają po przebiciu celu."]
	quest.60C27206F1414DD6.title: "Projectile Immunity Cancellation Module"
	quest.61419D230687CBB5.quest_desc: ["Prędkość to szybkość przedmiotu w danym kierunku. Ponieważ nasze strzały nie pochodzą ze Strażników Galaktyki, w zasadzie oznacza to po prostu szybkość strzały. Z każdym ulepszeniem strzała potrzebuje mniej czasu, by dolecieć z łuku do celu. Kosztem jest niewielka utrata celności."]
	quest.61419D230687CBB5.title: "Wyvern Projectile Velocity Module"
	quest.655BE42CD5BB9D82.title: "Draconic Area-Of-Effect Module"
	quest.6601ACCDDF6CA5FF.quest_desc: ["Reaktor pomieści tylko 1 miliard OP i choć może się to wydawać dużo, szybko przestanie. Gdy Energy Saturation osiągnie 100%%, Heat mocno wzrośnie, co może doprowadzić do awarii (Meltdown). Do aktywacji potrzeba 500,000,000 OP, a Flux Gate pomoże ograniczyć, ile OP wchodzi i wychodzi. (Nawiasem mówiąc, 1 RF = 1 OP) Wymagają redstone do aktywacji i mogą służyć zarówno do dodawania OP, jak i jego wyprowadzania. Musisz odprowadzać energię, żeby nie doszło do awarii - spróbuj podłączyć ją do Energy Core!"]
	quest.6601ACCDDF6CA5FF.title: "Rozruch"
	quest.6616A62426ED4D15.quest_desc: ["Injector musi stać po innej stronie niż wszystkie Stabilizers i leżeć na tej samej osi co Core. To stąd trzeba będzie wpompowywać OP! Aby aktywować i wytwarzać OP, trzeba nieco podnieść Energy Saturation. Energy Saturation to zmagazynowana energia i energia, która wkrótce powstanie."]
	quest.6616A62426ED4D15.title: "Reactor Energy Injector"
	quest.69396F87A09FBD85.quest_desc: ["Wszystkie kilofy wydobywają na tym samym poziomie, więc jedyny powód do ulepszenia to szybkość i zdobycie Staffs."]
	quest.69396F87A09FBD85.title: "Chaotic Pickaxe"
	quest.69986817D58AC8BE.quest_desc: ["Stabilizers tworzą Containment Field (pole siłowe wokół Reactor Core). Gdy Containment Shield spadnie do 0 przy włączonym reaktorze, rozpocznie się awaria (Meltdown). Wszystkie 4 Stabilizers muszą stać kilka bloków (5 lub więcej) od Core i mniej więcej na tej samej osi co Core, aby działać. To też tędy odprowadzasz OP z reaktora, tylko nie za dużo!"]
	quest.69986817D58AC8BE.title: "Reactor Stabilizers"
	quest.6B0CD6732BE0E819.quest_desc: ["Serio, to po prostu Jump Boost."]
	quest.6B0CD6732BE0E819.title: "Basic Jump Module"
	quest.6B8F2E05429C185F.quest_desc: [
		"Po pokonaniu wypadnie z niego EXP, Dragon Heart i, co najważniejsze, uwolni Chaos Shards. Sprawdź, gdzie uderzy piorun, i kop pod tym miejscem. Znajdziesz tam Chaos Shard. Wykop go, aby otrzymać 5 Chaos Shards, które można przerobić na jego mniejsze części!"
		"{image:atm:textures/questpics/draconic/draconic_shard.png width:150 height:100 align:1}"
	]
	quest.6B8F2E05429C185F.title: "Chaos Shard{s}"
	quest.6DBD81BA83B1D0A5.quest_desc: ["Jeszcze więcej Operational Potential!"]
	quest.6DBD81BA83B1D0A5.title: "Draconic Capacitor"
	quest.7081E9BF44EFBCB0.title: "Chaotic Large Shield Capacity Module"
	quest.710C7FEFAA6C0979.quest_desc: ["Ulepszona wersja Wyvern Sword."]
	quest.710C7FEFAA6C0979.title: "Draconic Sword"
	quest.713D3B3954E58C4A.quest_desc: [
		"Poziom 3 wymaga 26 bloków Draconium Ingot w pełni otaczających Core."
		"{image:atm:textures/questpics/draconic/draconic_core_3off.png width:100 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_core_3on.png width:100 height:100 align:1}"
	]
	quest.713D3B3954E58C4A.quest_subtitle: "Magazynuje: 1,640,000,000 RF"
	quest.713D3B3954E58C4A.title: "Poziom 3"
	quest.7143CE930D08F160.quest_desc: ["Area of Effect to pojęcie, które zna większość graczy. W skrócie ulepsza obszar działania narzędzia, w które jest zamontowany. Kilofy z AOE 3x3 będą kopać na obszarze 3x3. Miecze z AOE 3x3 zabiją wszystkie moby trafione w tym obszarze. Im lepsze ulepszenie, tym większy obszar. Nie, to się nie kumuluje!"]
	quest.7143CE930D08F160.title: "Basic Area-Of-Effect Module"
	quest.715F9F7107374299.quest_desc: ["Wyvern (Energy Relay) Crystal. Robi dokładnie to samo co Basic Crystal, tylko z większą ilością energii i większą liczbą połączeń."]
	quest.715F9F7107374299.title: "Wyvern Energy Relay Crystal"
	quest.731A70C25C2C7281.quest_desc: ["Przedmioty zdobyte narzędziem z tym modułem trafią do Twojej Ender Chest. Tej z Minecrafta, nie z moda."]
	quest.731A70C25C2C7281.title: "Ender Collection Module"
	quest.7496B2380A23FDC6.title: "Chaotic Tree Harvester"
	quest.74C715F8F24B8BAE.quest_desc: ["To samo, ale z opcjami filtrowania."]
	quest.74C715F8F24B8BAE.title: "Filterable Ender Collection Module"
	quest.75F0405FFAB9C080.quest_desc: ["To będzie potrzebne do ostatniego poziomu, Chaotic Tier. Mam nadzieję, że przeszedłeś gałąź zadań, która wyjaśnia, jak zdobyć Chaos Shards!"]
	quest.75F0405FFAB9C080.title: "Chaotic Core"
	quest.76064465104B1C28.title: "Draconic Shield Capacity Module"
	quest.763EB5C911D7E78C.quest_desc: ["Koniec drogi dla Crafting Infusions, Chaotic Tier. Gdy tu dotrzesz, możesz stworzyć wszystko. Nie tylko narzędzia, ale też wszystko, czego potrzebujesz do reaktora."]
	quest.763EB5C911D7E78C.title: "Chaotic Tier"
	quest.78FBB0C88182040E.quest_desc: ["Jeśli nie grałeś w Minecrafta od wersji 1.13, może Cię to zmylić, ale znasz kusze i Piercing. To zaklęcie pozwala strzałom przechodzić przez wiele celów i stale zadawać obrażenia. Ten moduł robi dokładnie to samo!"]
	quest.78FBB0C88182040E.title: "Wyvern Projectile Penetration Module"
	quest.79886D63280DBBF3.quest_desc: ["Filtrowanie to za mało?!?! Chcesz, żeby przedmioty zostały zniszczone?!?! Potworze!"]
	quest.79886D63280DBBF3.title: "Selective Incineration Module"
	quest.79FC674836B6340E.title: "Draconic Jump Module"
	quest.7A4ABFCD12202A91.quest_desc: ["Operational Potential to źródło energii w Draconic Evolution. Głównym sposobem (nie jedynym) przesyłania OP są IO Relay Crystals. Aby faktycznie wprowadzić OP do przedmiotów, potrzebujesz Energy Transfer."]
	quest.7A4ABFCD12202A91.title: "Czym Jest Energia, Czyli po Naszemu OP?"
	quest.7B9F5EEC76FDD0D4.title: "Draconic Damage Module"
	quest.7C54581562D2EA75.quest_desc: ["Speed Modules są fajne - działają w prawie wszystkim i sprawiają, że działają szybciej! Miecze wymachują się szybciej, kilofy kopią szybciej, siekiery ścinają szybciej, łuki strzelają szybciej, a Chestplate sprawia, że poruszasz się szybciej. Im lepszy Speed Module, tym większa prędkość! (BTW dobra okazja, by wspomnieć, że większość statystyk się sumuje. 2 Basic Speed Modules zwiększą wtedy prędkość o 20%%!)"]
	quest.7C54581562D2EA75.title: "Basic Speed Module"
	quest.7D159D333B2AC57E.quest_desc: [
		"500 milionów OP? Jest. Paliwo? Jest. Ciepło 2000 C? Jest. Kliknij przycisk aktywacji i módl się, żeby nie doszło do Meltdown!"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_down.png width:200 height:100 align:1}"
		"{image:atm:textures/questpics/draconic/draconic_reactor_on_up.png width:150 height:150 align:1}"
	]
	quest.7D159D333B2AC57E.quest_subtitle: "Teraz się modlimy i mamy nadzieję..."
	quest.7D159D333B2AC57E.title: "Aktywacja Reaktora"
	quest.7D7E4C31DFE59E29.quest_desc: ["Te moduły są tylko do łuków DE, w przeciwieństwie do poprzednich. Projectile Damage Module zwiększa obrażenia strzał wystrzeliwanych z łuku. Niektóre moduły mają negatywne skutki - te na przykład nieco zmniejszają celność łuków. Wszystkie się kumulują!"]
	quest.7D7E4C31DFE59E29.title: "Wyvern Projectile Damage Module"
	quest.7EB1C1AE52A0027F.title: "Chaotic Projectile Gravity Compensation Module"
	quest.7EB97C0DDE60DED4.quest_desc: ["Najlepszy łuk z Draconic Evolution, także z większą liczbą miejsc na moduły!"]
	quest.7EB97C0DDE60DED4.title: "Chaotic Bow"
	quest.7F757CD6F8C57733.quest_desc: ["Energy Core to jeden z największych, jeśli nie największy magazyn energii w całym Minecrafcie. A wszystko zaczyna się od Core. To środek i serce multibloku Energy Core (upewnij się, że znajduje się nieco nad ziemią). Gdy go postawisz, zobaczysz jego GUI z opcjami: Build Guide, Tier Down, Tier Up i Assemble Core. Poziomy (Tiers) określają, jak duży i potężny jest Core. Build Guide pokazuje, jak złożyć dany poziom Core. Jeśli masz wszystkie potrzebne bloki, możesz nacisnąć Assemble Core, a zrobi to automatycznie!"]
	quest.7F757CD6F8C57733.quest_subtitle: "Draconic Power Storage"
	quest.7F757CD6F8C57733.title: "Multiblok Energy Core"
	task.1EFD3D7C04F9682A.title: "Zadania od AllTheMods"
	task.2AE8A0F6A6C2D453.title: "Zadania od AllTheMods"
	task.61CCAD2018478894.title: "Aktywacja"
	task.6EAC5BBFAA0184BC.title: "Przygotowanie"
}
