	quest.208F759905CF7744.quest_desc: [
		"Drone ports są dość szybkie, ale do działania wymagają odległości co najmniej &450 bloków&r."
		""
		"Aby ich użyć, postaw 2 takie bloki i &akliknij prawym przyciskiem z Shiftem&r swoim &5target designator&r jeden z nich, aby zapisać jego położenie. Otwórz interfejs drugiego i umieść w nim swój &5target designator&r."
		""
		"Gdy drone port, w którym umieściłeś &5target designator&r, będzie miał przedmioty, wystrzeli drona, który je przetransportuje. "
	]
	quest.208F759905CF7744.quest_subtitle: "Tak, są drony"
	quest.24310BEACE75749D.quest_desc: [
		"Addons działają jak ulepszenia, a zarazem moduły dla &5Oritech&r. "
		""
		"Addons wkłada się w gniazda wyglądające jak wtyczki. Ich liczba zależy od użytych machine cores."
		""
		""
		"{image:atm:textures/questpics/oritech/ori-addon-slot.png width:50 height:100 align:left}"
		""
		"Addons dodają też maszynom nowe funkcje. Czasami będziesz musiał dodać konkretne addons, aby receptury zaczęły działać"
	]
	quest.24310BEACE75749D.quest_subtitle: "Żeby było warto"
