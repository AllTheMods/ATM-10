{
	quest.030AC1AF8F735550.quest_desc: ["Aby wprowadzić płyny do Tank, potrzebujesz jakichś Pipes.\\n\\nHydro Pump może automatycznie wpompowywać do nich wodę, powoli, ale za darmo!"]
	quest.030AC1AF8F735550.title: "Pipes"
	quest.06B85804163DD18B.quest_desc: ["Soaryn Box (Soaryn jest autorem XyCraft) to skrzynia z XyCraft.\\n\\nNie zachowa przedmiotów po zniszczeniu bloku! Ciekawe, do czego służą te kwadraty na nim?"]
	quest.08E484DD3E751697.quest_subtitle: "B jak w Roy G. Biv"
	quest.08E484DD3E751697.title: "&bBlue Xychorium Gems"
	quest.0D01524F249E25D7.quest_subtitle: "Kto Wyłączył Światło?"
	quest.0D01524F249E25D7.title: "&8Dark Xychorium Gems"
	quest.15540271BF17C2E4.quest_desc: ["&lWitaj w XyCraft!&r\\n\\nTa seria modyfikacji jest w większości poświęcona XyCraft: World and Machines!\\nWorld daje nam klejnoty, które można znaleźć podczas kopania."]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.16B4A00948D1F60D.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.1A96C595CBA42840.quest_desc: ["Kivi Seeds można użyć do wyhodowania Kivi Essence, z której można wytworzyć Kivi!"]
	quest.1A96C595CBA42840.title: "Automatyzacja Kivi"
	quest.1E00DBAACDF4404F.quest_desc: ["Collector działa jak bardzo tani Absorption Hopper.\\n\\nPodnosi wszystkie przedmioty w promieniu 3 bloków i umieszcza je w ekwipunku pod sobą albo we własnym. Można go wyłączyć za pomocą redstone!"]
	quest.2278A98DCDF713D7.quest_desc: ["Czas zbudować Tank! Najpierw potrzebujesz Building Blocks i co najmniej 1 Valve. Glass i Item IOs są opcjonalne.\\n\\nTank musi być zbudowany z ramy z Building Blocks. Building Blocks to wszystko, co nie jest przezroczyste, nie podlega grawitacji ani nie jest naturalną ziemią ani trawą.\\n\\nPrzedmioty takie jak kamień, drewno czy metal muszą tworzyć ramę i krawędzie. Glass, Valves i Item IOs muszą być umieszczone w ścianach, a wnętrze musi być puste.\\n\\nMoże mieć maksymalnie 13x13x13 bloków. Gdy to wszystko zrobisz, kliknij prawym przyciskiem myszy Valve, a pokaże komunikat 'Formed' albo powie Ci, jaki jest problem."]
	quest.2278A98DCDF713D7.title: "&lThe Tank"
	quest.2AC7BC448C007BDB.quest_desc: ["Wzmocnij Kivi za pomocą aluminium, a dostaniesz Machine Frames, które są potrzebne do wytwarzania maszyn."]
	quest.2B5E14A47062F83C.quest_subtitle: "R jak w Roy G. Biv"
	quest.2B5E14A47062F83C.title: "&cRed Xychorium Gems"
	quest.2C4ECA4F5B1639F4.quest_desc: ["Light Field nie świeci zbyt mocno, ale działa jak Mega Torch.\\n\\nMoby nie pojawiają się na ustalonym obszarze wokół niego. Ten obszar ma promień około 32 bloków."]
	quest.2C4ECA4F5B1639F4.title: "&fLight Field"
	quest.2C7D62231AD6406A.quest_desc: ["XyCraft ma świetny multiblok Fluid Tank!"]
	quest.2C7D62231AD6406A.title: "&bPrzechowywanie Płynów i Manipulacja Nimi"
	quest.355244420EA47546.quest_desc: ["Fabricator to Auto-Crafter. Pobiera przedmioty z ekwipunku pod sobą i wytwarza ustaloną recepturę.\\n\\nMożesz zablokować receptury, klikając z wciśniętym CTRL. Wytworzone przedmioty trzeba jednak odprowadzić rurami."]
	quest.355244420EA47546.quest_subtitle: "Auto-Crafter"
	quest.39E4FC9BA89E44BC.quest_desc: ["Balloon on a Stick to wczesne i ograniczone źródło lotu jak w trybie Creative.\\n\\nPostaw patyk, a zostaniesz przyczepiony do balonu! Dwukrotnie naciśnij spację, aby zacząć latać, tylko nie za daleko. Jeśli odlecisz za daleko, odczepisz się i spadniesz."]
	quest.39E4FC9BA89E44BC.quest_subtitle: "W Górę!"
	quest.3E970E76372AB094.quest_desc: ["&2Accelerated Planter&r działa podobnie do zwykłej ziemi uprawnej, ale z kilkoma zmianami.\\n\\nJest automatycznie nawadniana i działa szybciej niż zwykła ziemia uprawna."]
	quest.3E970E76372AB094.title: "&2Accelerated Planter"
	quest.3F68BA498E877C8C.quest_subtitle: "Drugie Imię Roya Biva"
	quest.3F68BA498E877C8C.title: "&aGreen Xychorium Gems"
	quest.43F08B510FC1C06F.quest_desc: ["Item IOs dają nam możliwość przenoszenia przedmiotów do Tank i z niego. Można je przełączać między wyjściem a wejściem."]
	quest.43F08B510FC1C06F.quest_subtitle: "Gdzie Przedmioty Przychodzą i Odchodzą"
	quest.43F08B510FC1C06F.title: "Item IOs"
	quest.4A92237E17ED5F1C.quest_desc: ["Void Container zamienia każdy ekwipunek w kosz na śmieci. Połóż go na ekwipunku i koniec z przedmiotami!"]
	quest.5E1D4169C083ACEF.quest_desc: ["&cIgnition Plate&r wytwarza ogień przed sobą, gdy dostanie sygnał redstone.\\n\\nGasi ogień, gdy sygnał ustaje."]
	quest.5E1D4169C083ACEF.title: "&cIgnition Plate"
	quest.623E6A855B363C8D.quest_desc: ["&9Water Block&r działa jak woda, tylko bez całej tej ruchomej części.\\n\\nMożna z niego zrobić generatory Cobble Gens, nawadniać nim ziemię uprawną, tylko nie da się nim zrobić MLG clutcha. (Ryby też będą próbowały do niego wpłynąć, ale i tak zginą)."]
	quest.623E6A855B363C8D.quest_subtitle: "Woda, ale Stała, Ice?"
	quest.623E6A855B363C8D.title: "&9Water Block"
	quest.643FB1A3ED0EA9EC.quest_desc: ["Valve to serce Twojego Tank. To tutaj pompujesz płyny lub doprowadzasz je rurami."]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Gdzie Płyn Przychodzi i Odchodzi"
	quest.643FB1A3ED0EA9EC.title: "Valves"
	quest.64D0D69ADB8820DA.quest_desc: ["&8Fluid Void&r to blok, który zatrzymuje całą połączoną z nim wodę.\\n\\nBloki źródła czy płynąca woda, wszystko w promieniu 1 bloku znika."]
	quest.64D0D69ADB8820DA.title: "&8Fluid Void"
	quest.69F11A94D44AB5CF.quest_subtitle: "Za Dużo Światła!"
	quest.69F11A94D44AB5CF.title: "&fLight Xychorium Gems"
	quest.6D0876A402C22067.quest_desc: ["XyCraft ma trochę przechowywania i manipulacji przedmiotami. Nie tyle co przechowywania i manipulacji płynami!"]
	quest.6D0876A402C22067.title: "&6Przechowywanie Przedmiotów i Manipulacja Nimi"
	quest.71D133BA3EC6F4FD.quest_desc: ["Extractor będzie \"hodować\" blok lub przedmiot pod sobą i przenosić go do ekwipunku nad sobą.\\n\\nMożna to wykorzystać do generatora Cobblestone, który działa z wieloma rodzajami kamienia, generatora ametystu, a nawet generatora Dragon Egg, i nie tylko!"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Farmienie Skał! (i Nie Tylko)"
	quest.7574A782DCFB87CE.quest_desc: ["Kivi można użyć do kilku rzeczy, głównie do dekoracji i maszyn.\\n\\nPotrzebujesz Kivi do Machine Frames i innych maszyn w XyCraft. Można go użyć z Xychorium Gems w bloku Stonecutter do wytworzenia bloków dekoracyjnych."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	task.4EEF358CAC170CC4.title: "Xychorium Gems"
	task.55DD09212E3DB168.title: "Fluid Pipes"
	task.706FA543A6C675D3.title: "AllRightsReserved"
}
