	quest.3971FF7D044D1FE5.quest_desc: ["Umiejętności zbroi można konfigurować i przełączać w menu konfiguracji. Użyj narzędzia lub różdżki JDT, aby otworzyć menu, i kliknij swoją zbroję, aby skonfigurować umiejętności tego elementu zbroi."]
	quest.3A471716A29F5172.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Zapewnia graczowi Elytra. Uwaga: na Elytra z tego ulepszenia wpływają ulepszenia Walk Speed i Run Speed."
	]
	quest.3AE1811C32B94A66.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Gasi gracza, jeśli ten się pali, ma czas odnowienia."
	]
