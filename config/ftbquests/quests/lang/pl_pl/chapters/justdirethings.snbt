	quest.2409EAD96CE3BDF7.quest_desc: ["Blazegold Templates służą do ulepszania zbroi i narzędzi Ferricore do Blazegold z zachowaniem zaklęć i zainstalowanych ulepszeń."]
	quest.242F74010488F261.quest_desc: ["Fuel Canister to przedmiot pozwalający efektywniej wykorzystywać paliwo. Może przechowywać 50,000 paliwa; każdy palny przedmiot ma inną wartość paliwa, zależną od liczby przetopionych przedmiotów. Jedna jednostka paliwa wystarcza do przetopienia jednego przedmiotu."]
	quest.24BA4B4EED0A9DBD.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Mind Fog"
	]
	quest.25213DBA6E6CEDD2.quest_desc: [
		"Shadowpulse Goo to czwarty i ostatni poziom goo dodanego przez JDT i do wytworzenia wymaga materiałów z Ancient City i od Warden."
		""
		"Odblokowane wytwarzanie:"
		"- Eclipse Alloy"
		"- Eclipse Ember"
		"- Time Crystal"
	]
	quest.25E915AE1FC53254.quest_desc: ["Celestigem Templates służą do ulepszania zbroi i narzędzi Blazegold do Celestigem z zachowaniem zaklęć i zainstalowanych ulepszeń."]
	quest.27FD46A8C958D259.quest_desc: ["Totem of Death Recall to przedmiot jednorazowego użytku, który pozwala graczowi teleportować się z powrotem w miejsce swojej śmierci."]
	quest.283D7E65F2AD45F2.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Ulepszona wersja Mob Scanner, która po aktywacji nakłada Glowing na pobliskie moby."
	]
	quest.2875FACD3BFB0A8E.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Po aktywacji zapewnia niewielkie leczenie, ale można ją aktywować tylko wtedy, gdy gracz niedawno otrzymał obrażenia lub właśnie je otrzymuje."
	]
	quest.2A01CE9206DD4F8A.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Wydobywa sąsiednie bloki rudy naraz, ale wydobycie trwa nieco dłużej."
	]
	quest.2A919F73CB09CF8B.quest_desc: [
		"Dozwolone ulepszenia:"
