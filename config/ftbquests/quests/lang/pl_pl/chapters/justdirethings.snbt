	quest.1EA02BA24AF02256.quest_desc: ["Eclipse Alloy Templates służą do ulepszania zbroi i narzędzi Celestigem do Eclipse Alloy z zachowaniem zaklęć i zainstalowanych ulepszeń."]
	quest.1ECFA72CF2BA4B45.quest_desc: ["Prosty wyrzutnik, w którym można skonfigurować, ile przedmiotów wyrzuca naraz."]
