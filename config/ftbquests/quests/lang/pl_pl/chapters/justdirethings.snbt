	quest.05056CAA64E3971B.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Sprawia, że strzały wystrzelone z łuku nakładają efekt mikstury zależny od Twojego Potion Canister."
	]
	quest.05D8C6EF8FCD6250.quest_desc: [
		"Primogel Goo to pierwszy poziom goo dodanego przez JDT i do wytworzenia wymaga podstawowych materiałów z Overworldu."
		""
		"Odblokowane wytwarzanie:"
		"- Ferricore"
		"- Primal Coal"
		""
		"Przykład Goo Spread:"
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.07655CA904354E9E.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:"
		""
		"Po aktywacji niszczy pobliską trawę i kwiaty."
	]
	quest.079A415488A32076.quest_desc: ["Blaze Ember to nowy materiał dodany przez JDT. Blaze Ember zdobywa się, wykonując Goo Spread na Primal Coal Blocks przy użyciu goo drugiego poziomu lub wyższego. Na Blaze Ember Ore działa Fortune."]
	quest.09485B63483B7A15.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:"
		""
		"Tymczasowo sprawia, że pobliskie wrogie moby tracą agresję wobec gracza, ma czas odnowienia."
	]
	quest.09D2137B4F42006E.quest_desc: ["Eclipse Ember to nowy materiał dodany przez JDT. Eclipse Ember zdobywa się, wykonując Goo Spread na Voidflame Coal Blocks przy użyciu goo czwartego poziomu. Na Eclipse Ember Ore działa Fortune."]
	quest.0A02DBE226C3F44E.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Mind Fog"
		"- Stupefy"
		"- Night Vision"
		"- Debuff Remover"
		"- Mental Obliteration"
	]
	quest.0B485DB737A036E9.quest_desc: ["Machine Settings Copier pozwala graczom kopiować ustawienia między maszynami."]
	quest.0B9BBE2A764631BF.quest_desc: ["Simple swapper potrafi teleportować przedmioty, bloki, moby lub graczy znajdujących się nad nim do innego simple swapper, z którym jest połączony. Aby połączyć swappery, użyj Ferricore wrench."]
	quest.0C1D55AA9CC902BD.quest_desc: [
