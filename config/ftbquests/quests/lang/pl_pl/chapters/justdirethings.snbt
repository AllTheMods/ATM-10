	quest.02B0CCD5607FF3B5.quest_desc: ["Player accessor działa jak skrzynia połączona z ekwipunkiem gracza. W GUI można skonfigurować jego strony tak, aby łączyły się z ekwipunkiem gracza, drugą ręką lub slotami zbroi."]
	quest.02B8F50721F12CFF.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:"
		""
		"Zapobiega otrzymywaniu przez gracza obrażeń od upadku."
	]
	quest.03ED9B0DFE8B4574.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Mind Fog"
		"- Stupefy"
