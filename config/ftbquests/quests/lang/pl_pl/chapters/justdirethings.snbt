		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Automatycznie usuwa wszelkie bloki podlegające grawitacji znajdujące się bezpośrednio nad wydobytym blokiem."
	]
	quest.4773421DC70009AB.quest_desc: [
		"Wbudowana umiejętność:"
		"- No Trampling"
		"- Accelerated Crop Growth I"
	]
	quest.48E4D75FD3145AD6.quest_desc: ["Time Fluid jest używany przez Paradox Machine i Time Wand. Zdobywa się go, wrzucając Time Crystal do Polymorphic Fluid.\\n\\nJak na kryształ tak trudny do zdobycia, cieszę się, że tym razem dali nam łatwy płyn."]
	quest.49636B3C6E6D0C2A.quest_desc: ["Nie ma zastosowań, ale wygląda fajnie."]
	quest.4987759CF379C1EB.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Zapobiega nakładaniu efektów spowolnienia i szybkości, gdy masz w ekwipunku Time Crystals."
	]
	quest.49EF8A4346AEF582.quest_desc: ["Wrzucenie Eclipse Ember do Voidflame Fuel utworzy Unrefined Eclipse Ember Fuel. Wykonanie Goo Spread przy użyciu goo czwartego poziomu zamieni Unrefined Eclipse Ember Fuel w Eclipse Ember Fuel."]
	quest.4A5937F6E5D06BE1.quest_desc: ["Prosty generator na paliwo płynne, który działa na płynnych paliwach dodanych przez JDT."]
	quest.4ACB72F3A23A5A19.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Zwiększa prędkość pływania."
	]
	quest.4B1E4FC4599DB916.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Invulnerability"
		"- Extinguish"
		"- Elytra"
	]
	quest.4B3F20E5C7E3BCFB.quest_desc: ["Primal Coal to nowy materiał dodany przez JDT. Primal Coal zdobywa się, wykonując Goo Spread na Coal Blocks przy użyciu goo pierwszego poziomu lub wyższego. Na Primal Coal Ore działa Fortune."]
	quest.4C54BD57CAB8A54B.quest_desc: [
		"Blazebloom Goo to drugi poziom goo dodanego przez JDT i do wytworzenia wymaga materiałów z Netheru."
		""
		"Odblokowane wytwarzanie:"
		"- Blazegold"
		"- Blaze Ember"
	]
	quest.4D98D2123BD5BFB3.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Wydobywa sąsiednie pnie naraz; uwaga: przy wydobywaniu wielu pni wydłuża to czas niszczenia."
	]
	quest.4E03AE15BEF86178.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Mob Scanner"
		"- Auto Smoker"
		"- Cauterize Wounds"
		"- Drops Teleporter"
	]
	quest.4E9B35DCA018FD42.title: "Ulepszenia Narzędzi"
	quest.4F9932477EDDCB8E.quest_desc: ["Advanced Portal Gun to ulepszona wersja Portal Gun, która do działania wymaga zarówno energii, jak i Portal Fluid. W przeciwieństwie do Portal Gun, Advanced Portal Gun pozwala graczowi teleportować się między zakodowanymi lokacjami. Za pomocą „V” (domyślny skrót klawiszowy) otwiera się menu służące do kodowania i wyboru miejsc docelowych teleportacji."]
	quest.5054977BD5354561.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Tree Feller"
		"- Leaf Breaker"
	]
	quest.515C0527226BA50C.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Daje graczowi lot jak w trybie kreatywnym."
	]
	quest.517F0135926B15EE.quest_desc: ["Wszystkie simple machines mają sterowanie redstone, a niektóre także filtrowanie."]
	quest.52EC86E03EB50525.quest_desc: [
		"Wbudowana umiejętność:"
		"- Lava Repair"
		"- No Trampling"
		"- Auto Harvesting"
		"- Accelerated Crop Growth II"
	]
	quest.53F9E5CE7EE6F852.quest_desc: ["Creature Catcher pozwala przenosić moby. Moby można wykluczyć za pomocą tagu bytów."]
	quest.567005978482235F.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Potion Arrow"
		"- Splash"
		""
		"Wbudowana umiejętność:"
		"- Lava Repair"
	]
	quest.5961C1ED32522BEF.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:&r "
		""
		"Przywołuje wabik gracza, który odciąga agresję od gracza, ma czas odnowienia."
	]
	quest.5A1AB1AD7DEFDD9A.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Invulnerability"
		"- Extinguish"
		"- Elytra"
		"- Death Protection"
		"- Flight"
		"- Lava Immunity"
		"- Time Protection"
	]
	quest.5A38E9F68570F7F3.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Run Speed"
		"- Walk Speed"
		"- Swim Speed"
		""
		"Wbudowana umiejętność:"
		"- Lava Repair"
	]
	quest.5A9436B100FC1E67.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Potion Arrow"
	]
	quest.5B02719C13B1FFE2.quest_desc: [
		"Umiejętności:"
		"- Air Burst: Jeszcze większy dystans wystrzału."
		"- Void Shift: Większy dystans teleportacji."
		"- Eclipse Gate: Tworzy przenośną dziurę na obszarze 3x3, a jej kierunek zależy od ściany namierzonego bloku. Odległość utworzonej dziury można skonfigurować. Uwaga: Eclipse Gate nie działa na tile entities."
	]
	quest.5B910F1389C0B915.quest_desc: [
		"Umiejętności:"
		"- Air Burst: Większy dystans wystrzału, zużywa FE."
		"- Void Shift: Teleportuje gracza w kierunku, w którym patrzy, zużywając przy tym FE."
	]
	quest.5BBE8B30ED7518B8.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Ore Miner"
		"- Ore Scanner &4&lDISABLED&r&f"
	]
	quest.5BD5737703F3F077.quest_desc: ["Ferricore to nowy materiał dodany przez JDT. Ferricore zdobywa się, wykonując Goo Spread na Iron Blocks przy użyciu goo pierwszego poziomu lub wyższego."]
	quest.5BD5737703F3F077.title: "Ferricore"
	quest.5C6709350BEF4050.quest_desc: [
		"Voidshimmer Goo to trzeci poziom goo dodanego przez JDT i do wytworzenia wymaga materiałów z Endu."
		""
		"Odblokowane wytwarzanie:"
		"- Celestigem"
		"- Void Flame"
	]
	quest.5D4E51471F3939E0.quest_desc: [
		"Umiejętności:"
		"- Air Burst: Wystrzeliwuje gracza w kierunku, w którym patrzy, zużywając przy tym wytrzymałość; różdżki wyższego poziomu wystrzeliwują gracza dalej. Uwaga: gracz nie otrzymuje obrażeń od upadku, dopóki trzyma różdżkę."
	]
	quest.5EE7D5DE07A83C7D.quest_desc: ["&lTyp umiejętności:&r Aktywna\\n\\n&lFunkcja umiejętności:&r\\n\\nPo aktywacji podświetla pobliskie rudy zielonymi cząsteczkami.\\n\\n&4&lUWAGA: TA UMIEJĘTNOŚĆ ZOSTAŁA WYŁĄCZONA.&r&f"]
	quest.5F5120451BA5B2FE.quest_desc: ["Zaawansowane maszyny mają te same możliwości co ich proste warianty, a dodatkowo konfigurowalny obszar roboczy, więcej slotów filtra i wymagają energii."]
	quest.60A4994078500F63.quest_desc: ["Celestigem to nowy materiał dodany przez JDT. Celestigem zdobywa się, wykonując Goo Spread na Diamond Blocks przy użyciu goo trzeciego poziomu lub wyższego."]
	quest.61213012615619C5.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Automatycznie wędzi przedmioty wypadające z pokonanych mobów."
	]
	quest.636854555AD75DC3.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Automatycznie teleportuje wypadające przedmioty do ekwipunku powiązanego z narzędziem. Kliknięcie narzędziem prawym przyciskiem z Shiftem na ekwipunku wiąże je z nim. Uwaga: gdy używasz motyki JDT, przedmioty wypadające dzięki umiejętności automatycznego zbioru z voidshimmer / shadowpulse farmland są teleportowane do powiązanego ekwipunku; ponadto kliknięcie prawym przyciskiem voidshimmer / shadowpulse farmland ponownie je powiąże, jeśli powiązany ekwipunek narzędzia uległ zmianie."
	]
	quest.6690AEE064DC2A7C.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:"
		""
		"Zwiększa obszar wydobywany jednocześnie. Po zainstalowaniu w narzędziach wyższego poziomu maksymalny wydobywany obszar rośnie. Wydobywany obszar można skonfigurować w menu."
	]
	quest.6720F863B907A5F1.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Sprawia, że Potion Arrows wystrzelone z łuku mają efekt Lingering, nakładając efekty na obszar z upływem czasu."
	]
	quest.6737CB17D562B134.quest_desc: ["Zwykły klikacz, który klika przedmiotem, który mu dasz."]
	quest.67B87570C340C243.title: "Ulepszenia Zbroi"
	quest.6889EFC6CC291463.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Po aktywacji odpycha pobliskie moby, ma czas odnowienia."
	]
	quest.6A4D31194C4CE156.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Ore Miner"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
		"- X-Ray"
		"- Instant Break"
	]
	quest.6ADE6F9E004055F7.quest_desc: [
		"Time Crystals to nowy materiał dodany przez JDT. Rosną na Budding Time Crystal Blocks, które tworzy się, wykonując goo spread na Budding Amethyst lub Time Crystal Block.\\n\\nJEDNAK Budding Time Crystal Block musi zebrać czas z &9Overworld&r, &6Nether&r i &aThe End&r, aby móc hodować Time Crystal Clusters. NIE MOŻNA go zniszczyć ani zebrać z Silk Touch. Aby go przenieść, musisz użyć narzędzia Swapper, Cardboard Box lub Cut Paste Gadget.\\n\\nPo pewnym czasie Budding Time Crystal Block &2wyczerpie energię&r i musi wyruszyć w kolejną podróż do &9Overworld&r, &6Nether&r i &aThe End&r."
		"{@pagebreak}"
		"Aby zautomatyzować ten proces, obejrzyj film podlinkowany w obrazku powyżej tego questa.\\n\\nA jeśli &2ko&9lo&6ro&awanie&r na poprzedniej stronie nie wystarczyło, dodałem obrazek, który pomoże Ci rozpoznać, który etap to który Budding Time Crystal Block."
		""
		"{image:atm:textures/questpics/justdirethings/budding_time_crystal_reference.png width:250 height:125 align:center}"
	]
	quest.6ADE6F9E004055F7.quest_subtitle: "Timey Wimey"
	quest.6ADE6F9E004055F7.title: "Time Crystal"
	quest.6D9CFCD81A23BB3B.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Czyni gracza odpornym na lawę."
	]
	quest.6F709652A2B88C78.quest_desc: ["Energy transmitter dostarcza energię blokom w swoim zasięgu działania; przyjmuje energię tylko od dołu."]
	quest.6FD4C60B547F4131.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Ore Miner"
		"- Ore Scanner &4&lDISABLED&r&f"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
	]
	quest.703BDCDC88DD813C.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Lawnmower"
		"- Sky Sweeper"
		"- Auto Smelter"
		"- Hammer"
		"- Drops Teleporter"
		"- Instant Break"
	]
	quest.70AD088336748892.quest_desc: ["Zwykły generator na węgiel."]
	quest.70BF85E2D235BAD5.quest_desc: ["Wrzucenie Voidflame Coal do Blaze Ember Fuel utworzy Unrefined Voidflame Fuel. Wykonanie Goo Spread przy użyciu goo trzeciego poziomu lub wyższego zamieni Unrefined Voidflame Fuel w Voidflame Fuel."]
	quest.70C404E5685E4E91.quest_desc: ["Zwykły stawiacz bloków."]
	quest.71128E508D810DDF.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Potion Arrow"
		"- Splash"
		"- Lingering"
		"- Homing Arrow"
		"- Phase"
		"- Yondu Arrow"
	]
	quest.71441DFA05FD73E5.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Mind Fog"
		"- Stupefy"
		"- Night Vision"
	]
	quest.7305EE0F7D73C231.quest_desc: ["Blank Upgrades są bazą wszystkich umiejętności. Umiejętności dzielą się na dwa typy: pasywne i aktywne.\\n\\nUmiejętności pasywne działają bez żadnych działań gracza, natomiast umiejętności aktywne działają tylko po uruchomieniu skrótem klawiszowym ustawionym przez gracza w menu konfiguracji; ponadto umiejętności aktywne zużywają wytrzymałość/energię podczas użycia. Po zainstalowaniu w zbroi wyższego poziomu umiejętności aktywne mają krótsze czasy odnowienia, a pasywne silniejsze efekty.\\n\\nStół kowalski służy do nakładania ulepszeń na narzędzia i zbroję JDT. Przytrzymanie Shift po najechaniu na narzędzia lub zbroję JDT pokazuje, jakie ulepszenia są dozwolone."]
	quest.73552A4BA0687962.quest_desc: ["Te ulepszenia mogą trafić zarówno do narzędzi, jak i do zbroi."]
	quest.7464CA1290B3474B.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Invulnerability"
	]
	quest.76B1C5AFC5D6B7CF.quest_desc: ["Time Wand może przyspieszać bloki, podobnie jak Time in a Bottle, do prędkości x128. W przeciwieństwie do TIAB zużywa FE i Time Fluid zamiast zgromadzonego czasu jako paliwa, co znacznie ułatwia jego uzupełnianie.\\n\\nJest jednak na czarnej liście dla fałszywych graczy. Nie chcemy, żebyś automatyzował TO."]
	quest.76B1C5AFC5D6B7CF.quest_subtitle: "Kuzyn Time in a Bottle"
	quest.78840993C7832E89.quest_desc: [
		"Dozwolone ulepszenia:"
		"- Tree Feller"
		"- Leaf Breaker"
		"- Auto Smelter"
		"- Drops Teleporter"
		"- Instant Break"
	]
	quest.79BBCC1BEE90DBBB.quest_desc: [
		"&lTyp umiejętności:&r Pasywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Pozwala graczowi oszukać śmierć, ma bardzo długi czas odnowienia. Czyli w zasadzie Totem of Undying z czasem odnowienia, który nie jest zużywany."
	]
	quest.7AEFF81E7C8CF300.quest_desc: ["Użycie Shift + prawego przycisku myszy z narzędziem lub różdżką JDT w ręku otworzy menu konfiguracji, w którym gracz może konfigurować i przełączać umiejętności."]
	quest.7B9486981786AC47.quest_desc: [
		"&lTyp umiejętności:&r Aktywna"
		""
		"&lFunkcja umiejętności:&r"
		""
		"Trwale usuwa AI pobliskich mobów; z powodu kosztu energii może wpłynąć najwyżej na pięć mobów na aktywację, ma bardzo długi czas odnowienia."
	]
	quest.7D1D2A4E07E98709.quest_desc: ["Prosty niszczyciel bloków, który wymaga narzędzia do ich niszczenia."]
	quest.7F0B2D58361FB00E.quest_desc: ["Just Dire Things to mod do wszystkiego. Just Dire Things dodaje nową mechanikę wytwarzania zwaną Goo Spread, a także maszyny wspomagające automatyzację Goo Spread oraz inne narzędzia użytkowe."]
	quest.7F0B2D58361FB00E.title: "Just Dire Things"
