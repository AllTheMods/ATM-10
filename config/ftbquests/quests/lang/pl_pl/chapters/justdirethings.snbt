	]
	quest.0FAF274ADA65B26A.quest_desc: ["Portal Fluid to tajemniczy zielony płyn kluczowy dla działania Advanced Portal Gun.\\n\\nWrzucenie Portal Fluid Catalyst do Polymorphic Fluid utworzy Unstable Portal Fluid, ALE Unstable Portal Fluid może istnieć tylko w Endzie. Wykonanie Goo Spread przy użyciu goo trzeciego poziomu lub wyższego zamieni Unstable Portal Fluid w Portal Fluid."]
	quest.120DCA89A919C7AF.quest_desc: [
