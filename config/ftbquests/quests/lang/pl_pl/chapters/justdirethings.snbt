		"- Run Speed"
		"- Walk Speed"
		"- Swim Speed"
		"- Decoy"
	]
	quest.3C8C80345D3F5FE8.quest_desc: ["Item collecter zbiera przedmioty i wkłada je do ekwipunku pod sobą."]
	quest.3CBB78C9B8D3665E.quest_desc: [
