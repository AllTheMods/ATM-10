{
	quest.0052E5592A6BBEC1.quest_desc: [
		"To jest &2&lMinecraft&r, nie mogę Ci powiedzieć, jak budować..."
		"{@pagebreak}"
		"Ale mogę dać Ci wskazówki!"
	]
	quest.0052E5592A6BBEC1.title: "&lWskazówki Budowlane!&r"
	quest.005CC8A3325FE2BD.quest_desc: ["&bFroststeel&r, &7Cloggrum&r i &eRegalium&r można wydobyć. \\n&cUtheric&r i &aForgotten&r zdobędziesz tylko, zabijając. \\n\\nJakieś inne pytania?"]
	quest.005CC8A3325FE2BD.title: "Metale &2&lUndergarden&r"
	quest.01516BC726013B7C.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.01516BC726013B7C.title: "WszelkiePrawaZastrzeżone"
	quest.027E6E294D9E1375.quest_desc: ["Rób notatki, &lCorail&r! Tak się robi święta! (Mówię to ze 100% miłością, kochamy Cię, &lCorail&r!) \\n\\nTen dodatek wprowadza mnóstwo dekoracji na Boże Narodzenie i Halloween. \\n\\nOd choinek, prezentów i lampek świątecznych po Pumpkins, Spiders i Witch Hats na Halloween."]
	quest.027E6E294D9E1375.title: "&b&lMacaw's Holidays&r"
	quest.034DB3C64F24C7B7.quest_desc: ["&6&lAllTheOres&r to mod stworzony we własnym zakresie, który ma ujednolicać rudy.\\n\\nWraz z nim pojawia się mnóstwo przydatnych bloków dekoracyjnych!\\n\\n&dFluorite&r i &9Sapphire&r wyglądają naprawdę czadowo!"]
	quest.034DB3C64F24C7B7.title: "Bloki &l&6AllTheOres&r"
	quest.04F5846E2468E807.quest_desc: ["&b&lMacaw's Doors&r dodaje różne rodzaje drzwi i ich warianty. \\nChcesz wzór drzwi brzozowych, ale ze Spruce Wood? Proszę bardzo! \\n\\nSą nawet drzwi szpitalne!"]
	quest.04F5846E2468E807.title: "&b&lMacaw's Doors"
	quest.0539AF15A10B2859.quest_desc: ["&lCompact Machines&r pozwalają Ci wejść do skompaktowanego wymiaru. Po postawieniu &lCompact Machine&r możesz do niego wejść za pomocą Personal Shrinking Device.\\n\\nRozmiar &lCompact Machine&r zależy od receptury i waha się od 5x5x5 do 45x45x45!\\n\\nNie możesz zniszczyć ścian &lCompact Machine&r, a wyjść możesz, klikając prawym przyciskiem myszy z Personal Shrinking Device w ręku."]
	quest.0539AF15A10B2859.title: "&lCompact Machines"
	quest.0589911EB4D30FAD.quest_desc: ["&l&cRegions Unexplored&r pozwala też malować deski tak, jakby były wełną lub szkłem!"]
	quest.0589911EB4D30FAD.title: "Malowane Deski"
	quest.0596F6C70758EEC0.quest_desc: ["Choć są najdroższe, są też najładniejsze! \\n\\nA to właśnie liczy się w budowlach!"]
	quest.06FFBB12CFA87815.quest_desc: ["Pnie z &2Vanilla &lMinecrafta&r, które znajdziesz w różnych biomach &2Vanilla&r! \\n\\nChyba nie trzeba nic więcej tłumaczyć!"]
	quest.06FFBB12CFA87815.title: "Pnie &2Vanilla&r"
	quest.08C66BCA3AAE765B.quest_desc: ["Ten dodaje bloki spoza &2&lMinecrafta&r, więc wolałbym o nim nie rozmawiać."]
	quest.08C66BCA3AAE765B.title: "&b&lMacaw's Roofs"
	quest.09955CF85F579E0F.quest_desc: ["Prędzej czy później go zdobędziesz, to dosłownie najbardziej powszechny blok w &2&lMinecraft&r."]
	quest.09955CF85F579E0F.title: "Kamienne Bloki"
	quest.09F49ED309152E24.quest_desc: ["&l&cChisel Reborn&r to kolejny mod oparty na &lChiseled&r. \\n\\nIstotą moda jest używanie narzędzia Chisel do zmiany wyglądu niektórych bloków. \\n\\nKliknij prawym przyciskiem myszy z Chisel w ręku, aby otworzyć jego GUI. Możesz tam włożyć do jednego stacka bloków, wybrać wzór, a następnie je wyjąć. Możesz też zostawić je w Chisel, choć nie wiem, po co miałbyś to robić. \\n\\nMożesz też kliknąć blok lewym przyciskiem myszy z Chisel w ręku, aby zmienić jego wygląd bez otwierania GUI! \\n\\nNie martw się, ten nie ma wytrzymałości."]
	quest.09F49ED309152E24.title: "&l&cChisel Reborn"
	quest.0A21773B773F34F8.quest_desc: ["Kolor to jedna z najważniejszych rzeczy, które ożywiają budowlę! \\n\\nDaje jej życie, osobowość i barwę! \\n\\nZacznij od barwników!"]
	quest.0A21773B773F34F8.title: "Kolorowe Bloki"
	quest.0BC106B34AD386E5.quest_desc: ["&l&cRegions Unexplored&r to kolejny mod z biomami, tym razem nowy w &l&6AllTheMods!&r \\n\\nOczywiście z biomami przychodzi więcej drzew!"]
	quest.0BC106B34AD386E5.title: "Pnie &l&cRegions Unexplored&r"
	quest.0C82CE3AFBD48C1E.quest_desc: ["&l&aSushi Go Crafting&r nie dodaje wielu bloków, ale gorąco polecam używać tych, które dodaje, w Twojej kuchni! \\n\\nZwłaszcza Rice Cooker - już nigdy nie będziesz gotować ryżu w mikrofalówce."]
	quest.0C82CE3AFBD48C1E.title: "&l&aSushi Go Crafting&r"
	quest.0EB6ED88895366D0.quest_desc: ["Pamiętasz czasy, gdy istniał tylko Stone i Cobblestone?"]
	quest.0EB6ED88895366D0.title: "Kamienie &2Vanilla&r"
	quest.0FE30548F25FEDB1.quest_desc: ["Jeśli tak jak ja nie lubisz mieszkać w pudełku (za bardzo przypomina mi szkołę), to spodoba Ci się szkło w Twoich budowlach, przez które widać, co jest na zewnątrz. \\n\\nZwykłe szkło z Minecrafta oczywiście jest fajne, ale można zrobić dużo lepsze! \\n\\nMożemy je nawet w jakiś sposób wykorzystać!"]
	quest.106884349C9FF3BA.quest_desc: ["Stary, niektóre źródła światła są po prostu paskudne! \\n\\nZmieńmy to!"]
	quest.106884349C9FF3BA.title: "Światła &l&bChipped&r"
	quest.10A2E758D7743DD0.quest_desc: ["&5&lEternal Starlight&r to dom wielu wyjątkowych przedmiotów, mobów i bloków. \\n\\nDrzew również! \\n\\nTe drzewa znajdziesz w całym wymiarze, w prawie każdym biomie."]
	quest.10A2E758D7743DD0.title: "Drzewa &5&lEternal Starlight&r"
	quest.11C43962B06D5092.quest_desc: ["Czy to naprawdę konieczne?"]
	quest.11C43962B06D5092.title: "Teraz Już Tylko się Popisujesz"
	quest.156605859D553276.quest_desc: ["Okna, szyby, okiennice, zasłony, żaluzje, a nawet parapety! \\n\\nSam nawet nie wiem, co to jest!"]
	quest.156605859D553276.title: "&l&bMacaw's Windows&r"
	quest.1591013DDD4766E1.quest_desc: ["&l&cCooking for Blockheads&r skupia się na tym, by kuchnia stała się Twoim domem. \\n\\nPolecam używać wszystkiego, co oferuje, bo każdy przedmiot ma zastosowanie i wygląda świetnie!"]
	quest.1591013DDD4766E1.title: "&l&cCooking for Blockheads&r"
	quest.1625C3A30E69D634.quest_desc: ["Te nowe kamienie znajdziesz w biomach &l&cRegions Unexplored&r! \\n\\nNie, Mossy Stone nie jest tym samym co w &l&aOh The Biomes We've Gone&r. \\n\\nNie, to nie to samo co Mossy Stone Bricks."]
	quest.1625C3A30E69D634.title: "Kamienie &l&cRegions Unexplored&r"
	quest.1972B36F72808D55.quest_desc: ["Tylko niektóre z tych kamieni są jednak wyszczerbione."]
	quest.1972B36F72808D55.title: "Kamienie &l&bChipped&r"
	quest.1FD60B7448CED1EB.quest_desc: ["Ten mod &b&lMacaw&r dodaje nowe rodzaje płotów, furtek i murków. \\n\\nTak, drut kolczasty Cię pokaleczy. \\n\\nNie, żadnego z nich nie da się normalnie przeskoczyć."]
	quest.1FD60B7448CED1EB.title: "&b&lMacaw's Fences and Walls"
	quest.1FDC8725105D822A.quest_desc: ["W kuchni znajdziesz wiele bloków, które potrafią przechowywać, konserwować i gotować jedzenie! \\n\\nWiększość bloków, które gotują lub przygotowują jedzenie, potrzebuje energii, więc zajrzyj do Zestawu Elektrycznego, aby dowiedzieć się więcej!"]
	quest.1FDC8725105D822A.title: "Zestaw Kuchenny"
	quest.2094D1CE4BA66091.quest_desc: ["Światło to bardzo ważna część każdej bazy. \\n\\nChroni przed pojawianiem się potworów, pomaga widzieć, a nawet dodaje budowlom więcej koloru i życia! \\n\\nMożesz też po prostu użyć Night Vision, ale gdzie w tym zabawa!"]
	quest.22D2CFDDB06C720C.quest_desc: ["Narzędzia są bardzo ważne w &2&lMinecraftcie&r, ale miejsce w ekwipunku także. Dlaczego więc nie zrobić trochę miejsca, tworząc Paxel! \\nPaxel to połączenie kilofa (P), siekiery (axe) i łopaty (el). \\n\\nPotrafi zdzierać korę, tworzyć ścieżki i wydobywać wszystkie bloki, które potrafi kilof/siekiera/łopata jego poziomu!"]
	quest.22D2CFDDB06C720C.title: "Paxel"
	quest.22E007025C19EC0A.quest_desc: ["&l&7Railcraft&r, oprócz pociągów, dodaje też kamienie do dekoracji! \\n\\nZ Quarried i Abyssal Stone można wytworzyć razem wersje Polished, Chiseled lub Brick! \\n\\nI nie zapomnij o schodach i płytach!"]
	quest.22E007025C19EC0A.title: "Kamienie &l&7Railcraft&r"
	quest.23631A4A743D4F0C.quest_desc: ["Nawet nie narzekaj. \\n\\nŻelazo można zdobyć na dziesiątki sposobów i jest potrzebne nawet do zwykłego postępu. \\n\\nZdobędziesz żelazo, zamienisz je w blok i sprawisz, że będzie ładne!"]
	quest.23631A4A743D4F0C.title: "Metale &l&bChipped&r"
	quest.266127E7947CB3D4.quest_desc: ["Wszystkie piękne budowle, które widzisz na tej stronie zadania, pochodzą od osób z Discorda ATM! \\n\\nSpokojnie, wszyscy wyrazili zgodę na udostępnienie swoich budowli i zostali wymienieni jako autorzy! \\n\\nJeśli chcesz podzielić się własnymi budowlami, zajrzyj na kanał artwork-builds-showoff na Discordzie! \\n\\n(Nie mogę zagwarantować, że wszystkie budowle powstały wyłącznie w ATM10, a jedynie że stworzyli je inni gracze Minecrafta. Podobnie jak niektórzy mogą używać shaderów, więc jeśli Twoje budowle nie wyglądają dokładnie tak samo, może to być powodem!)"]
	quest.26FADB78B04F592B.quest_desc: ["&l&aBuilding Gadgets 2&r to mod, który dodaje kilka bardzo pomocnych przedmiotów. \\n\\nWszystkie służą oczywiście do budowania! \\n\\nKażdy wymaga do działania &cenergii&r i ma menu otwierane domyślnie klawiszem &lG&r.\\n\\nMożesz je nawet połączyć z siecią AE2, wkładając do Wireless Access Point!"]
	quest.26FADB78B04F592B.title: "&l&aBuilding Gadgets&r"
	quest.28FDB2D13D0DDE8E.quest_desc: ["&b&lChipped&r jest podobny do modów z Chisel, bo zmienia wygląd bloków, ale &b&lChipped&r robi to po swojemu! \\n\\n&b&lChipped&r używa stacji, do których musisz podejść, aby zmienić bloki. \\n\\nJest 7 różnych stacji, z których każda zmienia inne bloki: Carpenters Table zmienia drewno, Glassblower zmienia szkło. \\n\\nA 6 z tych stacji można zamienić w przedmiot trzymany w ręku, dla łatwiejszego dostępu. \\n\\nSą nawet ulepszenia do plecaków!"]
	quest.28FDB2D13D0DDE8E.title: "&l&bChipped&r"
	quest.2B4801CD3E90BD40.quest_desc: ["&l&3Handcrafted&r dotyczy wszelkiej dekoracji. \\n\\nSą łóżka (wyglądają na tyle dobrze, że chce się w nich spać, a jestem wybredny!) i szafki nocne do sypialni. \\n\\nSą krzesła i stoły do salonu. \\n\\nJest piekarnik, talerze i miski do kuchni. \\n\\nSą nawet posągi, którymi można się chwalić!"]
	quest.2B4801CD3E90BD40.title: "&l&3Handcrafted&r"
	quest.2B864D741F7C7549.quest_desc: ["&lProductive Trees&r to mod o drzewach i hodowli drzew, z których powstaje jeszcze więcej drzew. \\n\\nMożesz więc zgadywać, że dodaje do &2&lMinecrafta&r więcej rodzajów drewna! \\n\\nNawet specjalne drewno!"]
	quest.2B864D741F7C7549.title: "&lProductive Trees"
	quest.2BA0E5D48E234FE9.quest_desc: ["Magiczna kraina &d&lArs Nouveau&r daje nam Magelight! Źródła światła z czystej magii! \\n\\nMożna je stawiać normalnie za pomocą zaklęć albo wytworzyć Magelight Lantern i postawić ją zamiast tego."]
	quest.2BA0E5D48E234FE9.title: "Światła &d&lArs Nouveau&r"
	quest.30B3BC91460C9B19.quest_desc: ["&bMacaw Sketch&r to bardzo popularny twórca modów. Jest znany z modów dekoracyjnych. \\nOd okien, przez ścieżki, po szuflady. Tworzy właściwie wszystko. \\n\\nCzy dasz radę wytworzyć to wszystko?"]
	quest.30B3BC91460C9B19.title: "&bMacaw's Mods"
	quest.313F5AFF459201EB.quest_desc: ["&l&5Eternal Starlight&r to zupełnie nowy wymiar do odkrywania! \\n\\nA dla tych, którzy szukają wyłącznie budowania w &2&lMinecraftcie&r, znajdziesz tam mnóstwo nowych kamieni! \\n\\nAby dostać się do tego wymiaru, musisz znaleźć jego portal!"]
	quest.313F5AFF459201EB.title: "Kamienie &l&5Eternal Starlight&r"
	quest.318A2CC03D1D0B04.quest_desc: ["Tęsknisz za &lConstruction Wands&r? \\n\\nNo cóż, ja tak, i &9Mrbysco&r też! Więc stworzył &l&6Construction Sticks&r! \\n\\nJest kilka różnych poziomów &6Construction Stick&r. Im droższe, tym więcej mają wytrzymałości i tym więcej bloków mogą postawić. \\n\\nNa początku po prostu wypełniają przestrzeń blokami, ale ich opcje można zmienić, otwierając ich GUI. Skrót klawiszowy do tego musisz ustawić samodzielnie. \\n\\nPo otwarciu możesz zmienić w nich wszystko. Gdzie stawiają bloki, w jakim wzorze, a nawet jakie bloki mają stawiać! \\n\\nMają też własne ulepszenia, które możesz wytworzyć. Aby ich użyć, połącz ulepszenie ze swoim &6Construction Stick&r w bloku Smithing Table. "]
	quest.318A2CC03D1D0B04.title: "&l&6Construction Sticks"
	quest.3497C2E05DF5A87C.quest_desc: ["&cRedstone&r, &9Lapis&r, Quartz, &5Amethyst&r, &aEmerald&r i &bDiamonds&r to szlachetne klejnoty. \\n\\nWięc oczywiście zamieniamy je w bloki, a dokładnie w bardzo ładne, szlachetne bloki!"]
	quest.3497C2E05DF5A87C.title: "Bloki Klejnotów &l&bChipped&r"
	quest.35C46E6E27C9CB1A.quest_desc: ["&2Vanilla&r ma 10 rodzajów pni, które są wspaniałe, ale mają tylko kilka wzorów! \\n\\nWięc oczywiście &l&bChipped&r dorzuca swoje, dodając dziesiątki nowych wzorów tych pni!"]
	quest.35C46E6E27C9CB1A.title: "Pnie &l&bChipped&r"
	quest.3889D0255074CE85.quest_desc: ["&bMacaw&r uznał, że meble to za mało - jego dom Macaw potrzebuje czegoś więcej niż naturalne światło z jego &b&lMacaw Windows&r. \\n\\nDlatego mamy teraz &b&lMacaw's Lights and Lamps&r, które dodaje różne źródła światła. \\n\\nOd lamp, przez Lanterns, po żyrandole!"]
	quest.3889D0255074CE85.title: "&l&bMacaw's Lights and Lamps&r"
	quest.392F34FD4FCC794A.quest_desc: ["Może i są drogie, ale za to jakie stylowe!"]
	quest.392F34FD4FCC794A.title: "Bloki &2&lMystical Agriculture&r"
	quest.3BA4504DEFB87264.quest_desc: ["Działa podobnie do &lSimply Lights&r: wersja Inverted świeci, gdy nie ma sygnału redstone, a zwykła działa tylko z redstone. \\n\\nTe lampy trzeba jednak przymocować do ściany."]
	quest.3BA4504DEFB87264.title: "Lampy Ścienne"
	quest.3D1D5CB45D81A6E4.quest_desc: ["Podobnie jak &b&lMacaw's Doors&r, ten mod dodaje różne typy i wersje klap. \\n\\nChcesz Jungle Trapdoor ze wzorem świerku? Teraz możesz go mieć!"]
	quest.3D1D5CB45D81A6E4.title: "&b&lMacaw's Trapdoors"
	quest.3E4B27759C973006.quest_desc: ["&l&6Framed Blocks&r to najważniejszy mod budowlany. Co więcej, jeśli dasz mi paczkę, w której nie ma &l&6Framed Blocks&r, nie zagram. Jest aż tak ważny! \\n\\n&l&6Framed Blocks&r daje nam atrapy bloków, które można wypełnić dowolnym blokiem niebędącym Block Entity (Block Entity to bloki takie jak Crafting Table, Furnace czy Enrichment Chamber). \\n\\nTe ramki mogą mieć praktycznie dowolny kształt! Od pionowych płyt, przez skosy, po ćwierćbloki! \\n\\nChcesz schody z &5Netherite&r? Użyj Framed Blocks! Chcesz Crafting Table z beli siana? Możesz go mieć! Chcesz idealne kąty w budowli? Zacznij robić &l&6Framed Blocks&r!"]
	quest.3E4B27759C973006.title: "&l&6Framed Blocks&r"
	quest.3E76BC1D0FC3E9A8.quest_desc: ["Wiele przedmiotów z modu &cMr Crayfish's&r używa energii! \\n\\nAby je zasilić, potrzebujesz Electricity Generator. Zasila się go węglem lub innym paliwem do pieców! \\n\\nNastępnie potrzebujesz Wrench, aby połączyć generator z blokami wymagającymi energii. \\n\\nGdy generator zostanie włączony przełącznikiem na górze i ma paliwo, zasili wszystko, co jest do niego podłączone."]
	quest.3E76BC1D0FC3E9A8.title: "Zestaw Elektryczny"
	quest.3ED8365BAD406CC5.quest_desc: ["To mody, które uważam za idealne do dekorowania Twojego domu lub bazy! \\n\\nŚmiało sprawdź też inne niż te pokazane tutaj!"]
	quest.3ED8365BAD406CC5.title: "Mody Dekoracyjne!"
	quest.3EEF17C57375CC39.quest_desc: ["&lSimply Lights&r dodaje bardzo proste w wytworzeniu i łatwe w użyciu światła.\\n\\nW wersji inverted działają bez redstone i wyłączają się, gdy sygnał redstone je aktywuje.\\n\\nJest wiele kolorów i kształtów!"]
	quest.3EEF17C57375CC39.title: "&lSimply Light&r"
	quest.3F185554793CCE54.quest_desc: ["Do budowania potrzebujesz narzędzi. I będziesz ich chciał.\\n\\nNarzędzi, które pomogą Ci zdobywać bloki, ich różne wersje i stawiać bloki!\\n\\nZacznij od... Patyka!"]
	quest.3F185554793CCE54.title: "Narzędzia!"
	quest.3FD9DC6B7844A79C.quest_desc: ["Zawsze nienawidziłem tego, jak nudny jest beton, zwłaszcza w prawdziwym życiu. \\n\\nPrzynajmniej w &2&lMinecraftcie&r z modem &l&bChipped&r możemy uzyskać dla niego różne wzory!"]
	quest.3FD9DC6B7844A79C.title: "Beton &l&bChipped&r"
	quest.408F48C4442CE180.quest_desc: ["Mnóstwo świateł i miejsca na przechowywanie w Twoim miejscu odpoczynku."]
	quest.408F48C4442CE180.title: "Zestaw Sypialniany"
	quest.40C068B2B8AC0F33.quest_desc: ["Terraformowanie jest ważną częścią nawet najprostszych budowli. Ale my, gracze &2&lMinecrafta&r, po prostu nie mamy na to czasu ani siły. \\n\\nCzemu więc nie oddać tego maszynom? \\n\\nKamieniołomy są bardzo łatwym sposobem, ale wszystko zaczyna się od Block Breakers. Simple Block Breaker niszczy tylko to, co jest przed nim, niezbyt pomocne... \\n\\nAle Advanced Block Breaker wydobywa bloki z wyznaczonego obszaru! Dużo lepsze do terraformowania!"]
	quest.40C068B2B8AC0F33.title: "Kamieniołomy i Kopalnie"
	quest.44688FC2E34FF09F.quest_desc: ["Minecraft już dodaje setki bloków, a mody dodają ich setki więcej! Ale czasem to wciąż za mało. \\n\\nDzięki niektórym modom możemy zmieniać bloki, które już mamy, w takie o innych kształtach, wzorach, a nawet w zupełnie nowe bloki!"]
	quest.44688FC2E34FF09F.title: "Zmiana Bloków"
	quest.44BD0B40EB5451AF.quest_desc: ["Supply Camps/Ships to przedmioty dodane przez &lMinecolonies&r. Służą do natychmiastowego stworzenia bazy, w której zamieszkasz i założysz kolonię! \\n\\nKliknij je prawym przyciskiem myszy, aby otworzyć menu i wybrać typ Camp/Ship! \\n\\nNastępnie znajdź miejsce, w którym go postawisz. Teren musi być płaski, a bloki z czerwonym obrysem pokazują, co trzeba usunąć! \\n\\nGdy wszystko będzie gotowe, Twój nowy Camp/Ship zostanie zbudowany całkowicie za darmo! \\n\\nBędzie miał Townhall, łóżka, zaopatrzenie i znacznie więcej!"]
	quest.44BD0B40EB5451AF.title: "Oszukiwanie"
	quest.48971CE964CF037F.quest_desc: ["Ochrona naszych reaktorów jądrowych jest ważna, a podgląd ich wnętrza wiąże się z bezpieczeństwem. \\n\\nSzkło można też wykorzystać, by nasze bazy wyglądały lepiej! \\n\\nA co tak naprawdę jest ważniejsze: bezpieczeństwo i ochrona naszych reaktorów jądrowych czy ładniejsza baza!"]
	quest.48971CE964CF037F.title: "Szkła Reaktorowe"
	quest.4AE8D8826F894EC7.quest_desc: ["&l&5Domun Ornamentum&r to coś w rodzaju &l&6Framed Blocks&r i &l&bChipped&r razem wziętych! \\n\\nZa pomocą Architects Cutter możemy tworzyć mnóstwo kształtów i wariantów bloków. \\n\\nPrzy tworzeniu bloku najpierw wybierz grupę: drzwi, światła itd.\\nNastępnie wybierz wariant.\\nPotem dodaj bloki, z których ma być wykonany! Niektóre bloki wymagają dwóch różnych bloków, inne tylko jednego."]
	quest.4AE8D8826F894EC7.title: "&l&5Domun Ornamentum&r"
	quest.4B552E9D05FF5415.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r kręci się wokół 5 kolorów, także w blokach! \\n\\n&aZielone&r, &cczerwone&r, &9niebieskie&r, &8ciemne&r i jasne bloki wszelkiego rodzaju!"]
	quest.4B552E9D05FF5415.title: "&l&9X&cy&aC&8r&aa&cf&9t&r &lWorld"
	quest.4BC27F16229BBF46.quest_desc: ["&l&6Storage Delight&r dotyczy przechowywania przedmiotów, ale w ładnej oprawie. \\n\\nJest tu mnóstwo szuflad w różnych wzorach i kolorach. \\n\\nMają to samo zastosowanie i pojemność co beczka."]
	quest.4BC27F16229BBF46.title: "&l&6Storage Delight&r"
	quest.4EA2DB12E8F0068F.quest_desc: ["&l&aOh The Biomes We've Gone&r to kontynuacja &l&aOh The Biomes You'll Go&r, które jest grą słów nawiązującą do książki Dr. Seussa \"Oh the Places You'll Go\".\\n\\nDodaje mnóstwo wspaniałych nowych biomów! Z nowymi roślinami, skałami i oczywiście drzewami!"]
	quest.4EA2DB12E8F0068F.title: "Drewno &l&aOh The Biomes We've Gone&r"
	quest.51E77B9CD3FB6DEA.quest_desc: ["To nie jest konieczne, ale uważam to za bardzo pomocne. \\n\\nDigging Claws zwiększają poziom kilofa dla Twoich rąk. Możesz więc wydobywać Iron Ore gołymi pięściami! \\n\\nDotyczy to też Stone, Terracotta i Concrete. I możesz je wydobywać, trzymając w rękach bloki. \\n\\nSzczerze mówiąc, to jest w zasadzie niezbędne."]
	quest.51E77B9CD3FB6DEA.title: "Digging Claws"
	quest.537B39B42C7D21ED.quest_desc: ["W nowych biomach dodanych przez &l&aOh The Biomes We've Gone&r znajdziesz 4 nowe rodzaje kamienia: Dacite, Red Rock, Mossy Stone i Rocky Stone. \\n\\nChciałbym teraz wiedzieć, czym Rocky Stone różni się od innych kamieni, że zasłużył na miano „skalistego”."]
	quest.537B39B42C7D21ED.title: "Kamienie &l&aOh The Biomes We've Gone&r"
	quest.53CE66D760CEFD7E.quest_desc: ["Zlewy, toalety i wanny! \\n\\nWszystko, czego potrzebujesz, by być świeżym i zadbanym! \\n\\nWszystkie zawierają wodę i tak, na toaletach można siedzieć."]
	quest.53CE66D760CEFD7E.title: "Zestaw Łazienkowy"
	quest.55160BAFFD9E2988.quest_desc: ["To kwintesencja modów &9Macaw&r, &9&lMacaw's Furniture&r! \\n\\nDodaje wszystko, czego potrzebujesz! Krzesła, stoły, regały na książki, a nawet szuflady!"]
	quest.55160BAFFD9E2988.title: "&l&9Macaw's Furniture&r"
	quest.5716E84828EC0C23.quest_desc: ["Plastic Construction Bricks to bloki tworzone dzięki &l&7PneumaticCraft: Repressurized&r. \\n\\nPodobnie jak ich prawdziwe odpowiedniki, bolą, gdy na nie nadepniesz! \\n\\nWięc albo załóż buty, albo wygładź klocki."]
	quest.5716E84828EC0C23.title: "Plastic Construction Bricks"
	quest.59B6C6BF0550D13D.quest_desc: ["Nowe rodzaje szkła, których możesz użyć w pociągach! Albo w bazach, \\n\\nNie mogę Cię zmuszać do użycia ich w jakikolwiek konkretny sposób."]
	quest.59B6C6BF0550D13D.title: "Szkło &7&lRailcraft&r"
	quest.5AD09CCEEDC0B50F.quest_desc: ["Te są naprawdę bardzo pomocne, koniecznie je sprawdź! \\n\\nPrawdziwym źródłem światła jest Feral Flare Lantern. Stawia niewidzialne źródła światła w promieniu około 20 bloków lub więcej. \\n\\nMega Torch działa inaczej: nie emituje światła, ale blokuje pojawianie się wrogich mobów w promieniu 64 bloków! Przydatne dla używających Night Vision. \\n\\nDread Lamp robi coś odwrotnego - blokuje pojawianie się pasywnych mobów w tym samym obszarze."]
	quest.5AD09CCEEDC0B50F.title: "&l&eTorchmaster&r"
	quest.5C2B30655A44227F.quest_desc: ["Myślisz, że &5&lEternal Starlight&r pozwoli Ci zdobyć te wszystkie metale łatwo? \\n\\nHA! Nie bądź głupi. Będziesz musiał walczyć z bossami, przekopywać się przez błoto i szukać deszczy meteorytów!"]
	quest.5C2B30655A44227F.title: "Metale &5&lEternal Starlight&r"
	quest.5D5563142917495A.quest_desc: ["&l&eFarmer's Delight&r dotyczy uprawy i gotowania jedzenia! Tych samych przedmiotów możemy używać też do dekoracji! \\n\\nKuchenka, garnki i patelnie idealnie pasują do kuchni. \\n\\nFood Barrels świetnie sprawdzają się w spiżarni. \\n\\nRzeczy rolnicze świetnie nadają się na dekorację na zewnątrz, a szafki pasują wszędzie!"]
	quest.5D5563142917495A.title: "&l&eFarmer's Delight&r"
	quest.5E5D5D28D82F6891.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r dodaje mnóstwo szkieł dzięki swojemu &lWorld Core&r! \\n\\nOd takich, przez które można przechodzić, przez świecące, po wytrzymalsze!"]
	quest.5E5D5D28D82F6891.title: "Szkło &l&9X&cy&aC&8r&aa&cf&9t&r"
	quest.5EB488C393B084C4.quest_desc: ["Kontynuacja &lChiseled&r - &4&lRechiseled&r! \\n\\nCały ten mod działa w narzędziu Chisel; kliknij nim prawym przyciskiem myszy, aby otworzyć GUI. \\nPo lewej wybierasz wzór, a w prawym dolnym rogu umieszczasz bloki. \\n\\nPowyżej możesz obejrzeć wzór w ustalonych układach: pojedynczy blok, 3x1 bloki lub ściana 3x3 z tego bloku. Możesz też kliknięciem przycisku włączyć lub wyłączyć obracanie obrazu! \\n\\nObok miejsca na bloki możesz kliknąć Chisel, co ustawi wybrany wzór na każdym bloku w Twoim ekwipunku, który da się zmienić. \\n\\nTen też nie ma wytrzymałości!"]
	quest.5EB488C393B084C4.title: "&4&lRechiseled&r"
	quest.5F7F753FD72BFBBF.quest_desc: ["Więcej bloków dodanych przez &l&7Railcraft&r? Zaczynam wątpić, że w ogóle chodzi o pociągi!"]
	quest.5F7F753FD72BFBBF.title: "Kolorowe Bloki &l&7Railcraft&r"
	quest.6012D6C3253895F0.quest_desc: ["&cMr Crayfish&r to nazwa synonimiczna ze zmodowanym &2&lMinecraftem&r. \\n\\nJego najczęściej pobierany mod to oczywiście mod z meblami! \\n\\nNa początek potrzebujesz Workbench, który do działania wymaga energii."]
	quest.6012D6C3253895F0.title: "&cMr Crayfish's Mods&c"
	quest.616ED6C49C37EB91.quest_desc: ["&b&lPaths and Pathways&r dodaje mnóstwo bloków podobnych do dywanów (a także pełne bloki i płyty). \\n\\nOczywiście służą jako ścieżki, tylko wyglądają dużo ładniej niż blok ścieżki z &2&lMinecrafta&r."]
	quest.616ED6C49C37EB91.title: "&b&lMacaw's Paths and Pavings"
	quest.61BE7882EE0E6FAF.quest_desc: ["Co po schodach się toczy \\nSamo albo we dwoje... \\nPrzetoczy się po psie sąsiada \\nCo dobre na przekąskę \\nI mieści się na plecach? \\nTo Kłoda! Kłoda! Kłoda!"]
	quest.61BE7882EE0E6FAF.title: "Pnie"
	quest.6258F26293B9C1C1.quest_desc: ["Co nam daje &9&lCrystalix&r, pytasz? \\nDaje szkło! Wszystkie rodzaje szkła! Jest Normal, Clear i Bordered. \\n\\nBordered to normalny wzór szkła z &2&lMinecrafta&r. Ma obramowania i piksele w pobliżu rogów, żeby dać znać, że to szkło. Clear ma obramowania, ale nie ma pikseli przy rogach, więc środek jest całkiem przezroczysty. Normal nie ma obramowań ani pikseli, jest w 100% przezroczyste i jednokolorowe. \\n\\nKażde szkło &9&lCrystalix&r ma też własne właściwości: Shadeless, Reinforced, Light i Ghost. \\n\\nShadeless wpływa na to, jak reaguje na shadery, a nawet na oświetlenie &2&lMinecrafta&r. Reinforced wpływa na odporność na wybuchy. Light wpływa na to, czy daje światło, ignoruje światło, czy działa jak normalne szkło, przepuszczając światło. Ghost pozwala zmienić, kto może przechodzić przez szkło, i ma najwięcej ustawień."]
	quest.6258F26293B9C1C1.title: "&9&lCrystalix"
	quest.655BD0A54AF1E1CA.quest_desc: ["Widzieliśmy już dość mebli do środka, ale co na zewnątrz? Nie urządzisz przecież grilla na Czwartego Lipca w domu! \\n\\nZestaw zewnętrzny daje nam grille, lodówki turystyczne i dzwonki do drzwi, w które goście mogą zadzwonić, by dać nam znać, że przybyli z patriotycznym sercem!"]
	quest.655BD0A54AF1E1CA.title: "Zestaw Zewnętrzny"
	quest.6607E5CDB3D17D67.quest_desc: ["Nie martw się, te się nie zapalą!"]
	quest.6607E5CDB3D17D67.title: "Wełna &l&bChipped&r"
	quest.667CD7C6E87A05F4.quest_desc: ["&l&9X&cy&aC&8r&aa&cf&9t&r, jako że kręci się wokół kolorów, ma też światła oparte na kolorach. \\n\\nŚwiatła RGB będą w kolorze barwnika, z którego je wytworzono. \\n\\nChodzi o barwnik, a nie o klejnot."]
	quest.667CD7C6E87A05F4.title: "Światła &l&9X&cy&aC&8r&aa&cf&9t&r"
	quest.69B5D716568AA9EB.quest_desc: [
		"&d&lCamol&r to odpowiedź na kamuflowanie &lWSZYSTKIEGO.&r Od Pipez przez kable Mekanism po ATM Stars, i wszystko oprócz... nie, czekaj, zlewu kuchennego też.\\n\\nWytwórz &d&lCamo Block&r razem z blokiem, którego chcesz użyć do kamuflażu, a potem kliknij nim prawym przyciskiem myszy blok, który chcesz zakamuflować, na przykład jakiś kabel czy coś.\\n\\nDomyślnie &d&lCamo Block&r przyjmie kształt kolizji zakamuflowanego bloku. Możesz to zmienić na wersję Shape Retaining, wkładając go samego do siatki wytwarzania. Wtedy przyjmie kształt bloku kamuflującego.\\n\\nJeśli chcesz usunąć &d&lCamo Block&r, kliknij prawym przyciskiem myszy zakamuflowany blok innym Camo Block."
		"{@pagebreak}"
		"{image:atm:textures/questpics/building_tips/camol_example.png width:200 height:100 align:center}"
	]
	quest.69B5D716568AA9EB.title: "&d&lCamol"
	quest.6AC85C203E7C3482.quest_desc: ["Masz po jednej rzeczy z &b&lMacaw's Mods&r. Myślę, że na to zasłużyłeś. \\n\\nA przez to mam na myśli własną &bMacaw&r!"]
	quest.6AC85C203E7C3482.title: "Ukończony &bMacaw&r"
	quest.6B0D84B730C6C76C.quest_desc: ["16 kolorów, które daje &2&lMinecraft&r, to za mało? \\n\\nCóż, możesz mieć 18 więcej! \\n\\n&l&cDy&6en&ea&ami&bcs&r dodaje 18 nowych barwników, których można używać do dokładnie tych samych przedmiotów i bloków co barwniki &2&lMinecrafta&r! \\n\\nChcesz Candle w kolorze &6Peach&r? Proszę bardzo! Chcesz Shulkera w kolorze &dBubblegum&r? Czemu nie! Chcesz łóżko w kolorze &eFluorescent&r? Oczywiście!"]
	quest.6B0D84B730C6C76C.title: "&l&cDy&6en&ea&ami&bcs&r"
	quest.6BC78AF7C9D93F11.quest_desc: ["Nawet wersje glazurowane!"]
	quest.6BC78AF7C9D93F11.title: "Terakota &l&bChipped&r"
	quest.6F65216B13E9FFA9.quest_desc: ["Zdobądź blok. Dosłownie dowolny blok. \\n\\nKażdy gracz powinien wiedzieć, że bloki są podstawą budowania. Żeby cokolwiek zbudować, potrzebujesz bloków."]
	quest.6F65216B13E9FFA9.title: "Bloki!"
	quest.72DB967E59EEA729.quest_desc: ["&3&lGlassential&r to bardzo ważny mod do budowania, nawet dla budowli z przeznaczeniem! \\nTo nie tylko zwykłe szkło - te mają zdolności, które możesz przeczytać, najeżdżając kursorem na przedmiot! \\n\\nNa przykład Ethereal Glass, przez które możesz przechodzić, a moby nie. (Użyłem go do mojej kopuły dla pszczół w 9sky!)"]
	quest.72DB967E59EEA729.title: "&3&lGlassential&r"
	quest.7C2ED69E07988DF4.quest_desc: ["Pierwotne krzesło &2&lMinecrafta&r - schody. \\n\\nWitaj w zmodowanym &2&lMinecraftcie&r, mamy dużo więcej niż schody do dekoracji. \\n\\nJest mnóstwo modów dodających dekoracje i jeszcze więcej dodających przedmioty, których można użyć do dekoracji!"]
	quest.7C2ED69E07988DF4.title: "Dekoracje!"
	quest.7CF13A4941F608E5.quest_desc: ["Od zwykłego szkła, przez szkło z szybami, po mozaiki!"]
	quest.7CF13A4941F608E5.title: "Szkło &l&bChipped&r"
	quest.7DA8ACE06DE8097F.quest_desc: ["&6Miedź&r to najpowszechniejsza ruda w &2&lMinecraftcie&r, a jej głównym zastosowaniem jest dekoracja. \\n\\n&2&lMinecraft&r dodaje już sporo wariantów, ale &l&bChipped&r uznał, że to za mało! Więc mamy więcej! \\n\\nNawet warianty dla utlenionych wersji. \\n\\nMożesz zrobić fałszywe &aEmerald Blocks&r."]
	quest.7DA8ACE06DE8097F.title: "&l&bChipped &6Copper"
	quest.7DABD82393713B5A.quest_desc: ["&c&lLuminax&r to bardzo prosty mod. Lubisz kolorowe światła? Możesz je mieć. \\n\\nWszystkie są jednokolorowe, bez tekstur, i mogą mieć różne kształty, takie jak schody, płyty, a nawet płyty naciskowe! \\n\\nDziałają nawet z &l&cDy&6en&ea&ami&bcs&r!"]
	quest.7DABD82393713B5A.title: "&l&cLuminax"
	quest.7E49C985A0433B20.quest_desc: ["&d&lArs Nouveau&r to bardzo fajny mod o magii, który wnosi własny zestaw drewna! \\n\\nArchwood występuje w 5 różnych kolorach drzew, które pojawiają się w większości biomów, ale głównie w biomie Archwood!"]
	quest.7E49C985A0433B20.title: "Pnie &d&lArs Nouveau&r"
