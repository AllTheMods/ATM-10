{
	quest.00AC7CC291A3E590.quest_desc: ["Pewnie (na pewno) widziałeś na świecie struktury, z których wydobywa się coś w rodzaju Beaconów. Są zrobione z bruku, mają 4 nogi i wiszą dość wysoko w powietrzu! \\n\\nMam nadzieję, że wiesz, że nazywają się &8Dark Temples&r i mają &aEnviromental Accumulator&r, którego potrzebujemy. \\n\\nMusisz poczekać na burzę z piorunami, żeby napełnić swój Weather Container. Wtedy możesz stworzyć swoją &3Lightning Bomb&r!"]
	quest.00AC7CC291A3E590.title: "&3Lightning Bomb"
	quest.022C38096F79EF07.quest_desc: ["&6&lForbidden \\& Arcanus&r to używanie Arkanów do rytuałów przy Kuźni, aby stać się silniejszym! \\n\\nAlbo to, z czego większość go zna, czyli Eternal Stella. W tym modzie jest tego więcej, wiesz? "]
	quest.022C38096F79EF07.title: "&6&lForbidden \\& Arcanus"
	quest.03564837ECB5CC79.quest_desc: ["Kolejny rytuał, oczywiście, tym razem &2Ihagan's Enthrallment&r. (Przy okazji, aby złożyć w ofierze konia, musi on być w pobliżu podczas rytuału) \\n\\nGdy skończysz, dostaniesz &2Dragon Familiar&r. Musisz rzucić w niego Creature Catcher, żeby użyć go do &6&lATM Star&r.\\n\\nTen będzie za Tobą chodził i można go głaskać, klikając go prawym przyciskiem myszy z Shiftem."]
	quest.03564837ECB5CC79.title: "&2Dragon Familiar&r w Creature Catcher"
	quest.038812A14456236C.quest_desc: ["Łącząc kilka Processorów, Energy Cell i dowolny Dense Cable, otrzymujemy ME Quantum Ring. \\n\\nZwykle używalibyśmy go do połączenia naszego systemu ME między wymiarami, ale zależy nam tylko na &6&lATM Star&r!"]
	quest.0573B6F1BE5110FD.quest_desc: ["Pszczoły z &2&lMinecrafta&r są urocze, ale te ograniczone rzeczy, które daje miód, nie uzasadniają pracy włożonej w jego zdobycie. \\n\\nNo chyba że z pszczół da się zdobyć praktycznie wszystko, wtedy sprawa wygląda inaczej!"]
	quest.0573B6F1BE5110FD.title: "&e&lProductive Bees&r"
	quest.05850541675B2493.quest_desc: ["Tak. \\n\\nStworzyłeś &6&lATM Star&r, czyli pokonałeś paczkę!\\n\\nWięc co dalej?"]
	quest.05850541675B2493.quest_subtitle: "Czy to znaczy, że wygrałeś?"
	quest.05850541675B2493.title: "&6&lATM Star"
	quest.0848056FDD3F9BDA.quest_desc: ["&9Singularity&r to teoretyczny punkt ostatecznej gęstości. Naukowcy uważają, że wszechświat, w którym żyjemy, był kiedyś &9Singularity&r. Każda cząsteczka naszego wszechświata w jednym punkcie mniejszym niż ziarnko piasku. \\n\\nOczywiście skoro &l&bAE2&r dryfuje w stronę nauk teoretycznych, ma własną &9Singularity&r. \\n\\nSą 2 sposoby jej wytworzenia, ale każdy wymaga skondensowania mnóstwa przedmiotów w jeden punkt!"]
	quest.0848056FDD3F9BDA.title: "&9Singularity"
	quest.08CE14FFED813992.quest_subtitle: "13 Wet Dark Pink Blocks"
	quest.08E47A27EFFB7C6B.quest_subtitle: "5 Dry Pink Blocks"
	quest.0923C941A9696122.quest_desc: ["Na wypadek gdybyś musiał zabrać ze sobą na przygodę 256 milionów przedmiotów! \\n\\nBędziesz potrzebować kilku prostych przedmiotów, takich jak &8MEGA Item Cell Housing&r, &5ME Chest&r i &5Dense Energy Cell&r. \\n\\nA potem potrzebujemy &d256M MEGA Storage Component&r... ten jest znacznie trudniejszy do zrobienia. \\n\\nJeśli powtarzalne wytwarzanie sprawia, że nienawidzisz &2&lMinecrafta&r, możesz zamiast tego wytworzyć &2Blastproof Casing&r! \\n\\nDo wytworzenia &3&lImprobable Probability Device&r potrzebujemy albo 2 256M Portable Item Cells, 2 &2Blastproof Casings&r, albo mieszanki obu."]
	quest.0923C941A9696122.title: "256M Portable Item Cell"
	quest.09D76E9B8CABC31E.quest_desc: ["Do &5&lCreative Essence&r potrzebujesz 4 &5Insanium Essence Blocks&r. Każdy blok to 9 &5Essence&r, a teraz policzmy... \\n\\nPotrzebujesz 9 216 &aInferium Essence&r, żeby zdobyć tylko jeden taki blok. Czyli łącznie potrzebujesz 36 864 &aInferium Essence&r!"]
	quest.09D76E9B8CABC31E.title: "4 &5Insanium Blocks"
	quest.0AE28C998A3BF136.quest_subtitle: "531,441 Netherrack"
	quest.0C7D96DB3573EF9C.quest_subtitle: "&oZdolność tworzenia życia."
	quest.0C7D96DB3573EF9C.title: "&5&lCreative Essence"
	quest.0E03F5EAE4963ECB.quest_subtitle: "8 Dry Green Blocks"
	quest.0F1CA44520BDEFEA.quest_subtitle: "6,561 Diamond Blocks"
	quest.103834774B57D611.quest_desc: ["Mini End Portal będzie wymagał sporo &dEndshelves&r. To ostatnie poziomy półek, jakie zdobędziesz z &5&lApotheosis&r. Do ich wytworzenia potrzebujesz &dInfused Dragon's Breath&r. \\n\\nPotem potrzebujesz już tylko Eyes of Ender, które musiałeś mieć, aby w ogóle zdobyć &dEndshelves&r. \\n\\nJeśli jakimś cudem dotarłeś do &d&lThe End&r i zdobyłeś półki bez Eyes of Ender, to jestem pod wrażeniem!"]
	quest.11374A3B5BD644F5.quest_desc: ["&lIndustrial Foregoing&r to mod technologiczny z mnóstwem maszyn i narzędzi. Wszystkie mają ten sam kod kolorów! \\n\\nMusisz zacząć od Rubber, i tak, jest na nią osobna strona zadań!"]
	quest.11374A3B5BD644F5.title: "&lIndustrial Foregoing"
	quest.14B7EEBE0F6C2776.quest_desc: ["&dInfused Dragon's Breath&r zdobywa się przez... no cóż, infuzję &dDragon's Breath&r. \\n\\nMożesz użyć 2 &9Soul-Touched Sculkshelves&r, 3 &bHeart-Forged Seashelves&r, 8 zwykłych półek na książki i 1 &6Geode-Encased Bookshelf of Stability&r. \\n\\nBędzie też potrzebny do innych receptur, ale o tym nie mówimy!"]
	quest.14B7EEBE0F6C2776.title: "&dInfused Dragon's Breath"
	quest.1682CED78D9D4BA7.quest_desc: ["&9&lTwilight Forest&r to jeden z najbardziej znanych i uznanych modów, i to z dobrego powodu. Praktycznie zdefiniował mody przygodowe! \\n\\nAby się tam dostać, wystarczy zrobić oczko wodne 2x2, otoczyć je kwiatami i wrzucić do niego Diamond! \\n\\nWtedy Twój portal się otworzy i możesz wejść do &l&9Twilight Forest&r. \\n\\nTam musisz zabijać bossów w ścisłej kolejności i w ten sposób postępować!"]
	quest.1682CED78D9D4BA7.title: "&9&lTwilight Forest"
	quest.174D18D9D732EC10.quest_subtitle: "8 Wet Green Blocks"
	quest.17542D7633FBF098.quest_subtitle: "&oSzkoda, że SpongeBob nie jest gwiazdą."
	quest.17542D7633FBF098.title: "&d&lPatrick &aStar&r"
	quest.17598C171E610752.quest_desc: ["Nawet nie wiem, co powiedzieć. Gubię się, przeglądając receptury. Wolałbym wypisać wszystkie drzewa genealogiczne dla &l&2Productive Trees&r. \\n\\nZdobądź &6Advanced Motors&r i połącz je z &dTitanium Rods&r oraz &9Processing Unit&r, aby stworzyć &6Large Advanced Motor&r. \\nAlbo możesz użyć &6Mechanical Arm&r, ale nie obiecuję, że łatwiej je wytworzyć!"]
	quest.17598C171E610752.title: "&6Large Advanced Motor"
	quest.1CE7B24E7E62C25B.quest_subtitle: "&oNieznane, a jednak to wszystko, co wiemy."
	quest.1CE7B24E7E62C25B.title: "&d&lPulsating &8Black Hole"
	quest.1EB04FE105ACA4BE.quest_desc: ["Gdy &9Warden&r umiera, ma szansę upuścić &9Heart of the Deep&r. \\n\\nMożna go użyć do &6&lATM Star&r albo do aktywacji portalu w Ancient City! \\n\\nW portalu nie może niczego być, żeby go aktywować, a to obejmuje &9Sculk&r!"]
	quest.1EB04FE105ACA4BE.title: "&9Heart of the Deep"
	quest.1FCC474860587169.quest_desc: ["Aby zdobyć późniejsze receptury, najprawdopodobniej będziesz potrzebować &6Smelter Prism&r i spokojnie, do jego zdobycia wystarczy nam Kuźnia 1. poziomu! \\n\\nMożesz sprawdzić w JEI, ile każdej statystyki w Kuźni potrzebujesz! Do tego potrzebujesz 4 &6Blaze Powder&r, 2 &8Coal&r i &bArcane Crystal&r. \\n\\nNa koniec potrzebujesz &9Elementarium&r, które można znaleźć w Jungle Temples, Desert Pyramids i Underwater Ruins!"]
	quest.1FCC474860587169.title: "&6Smelter Prism"
	quest.215AD616E6847E9A.quest_desc: ["Każdy &5Insanium Gemstone&r to 2 &5Insanium Essence&r. Czyli każdy &5Gemstone Block&r to 18 &5Insanium Essence&r. \\n\\nTo znaczy, że możemy wziąć nasze 9 216 &aInferium Essence&r na &5Insanium Blocks&r i podwoić je, żeby otrzymać 18 432 &aInferium Essence&r tylko na 4 &5Insanium Gemstone Blocks&r."]
	quest.215AD616E6847E9A.title: "4 &5Insanium Gemstone Blocks"
	quest.216DA9782EBDFF34.quest_desc: ["Uważam, że ten mod jest nierealistyczny. Nie obchodzi mnie, jakie książki czy przedmioty masz, nie sądzę, żeby demony wykonywały każde Twoje polecenie i pracowały dla Ciebie jak niewolnik. \\n\\nTak czy inaczej, możesz podążać za zadaniami, żeby to zrobić."]
	quest.216DA9782EBDFF34.title: "&b&lOccultism"
	quest.2171DC0B13C4BD43.quest_desc: ["&a&lRoots Classic&r może wyglądać na niewielki w JEI, ale obiecuję, że jest w nim bardzo dużo! \\n\\nRoots polega na wykorzystywaniu darów natury do rytuałów.\\n\\nUwierz mi, te przedmioty znajdziesz wszędzie!"]
	quest.2171DC0B13C4BD43.title: "&a&lRoots Classic"
	quest.217DF3B66A07A8DE.quest_subtitle: "&oOgród Eden w jednym nasionku."
	quest.217DF3B66A07A8DE.title: "&3&lDimensional &2Seed"
	quest.2188C52C1F384DE4.quest_subtitle: "&oPaliwo, które pali się wiecznie (niezupełnie)."
	quest.2188C52C1F384DE4.title: "&c&lPhilosopher's Fuel"
	quest.21AB14A8553896E9.quest_desc: ["Ludzie, chyba mnie źle usłyszeliście, powiedziałem &e&lProductive Bees&r! A, czekaj, jest jeszcze jeden mod! \\n\\nTen jest powiązany z &e&lProductive Bees&r, bo potrzebujesz ich do rozmnażania drzew. \\n\\nNie, drzewa nie rozmnażają się za pomocą pszenicy, tylko pszczół. \\n\\n&oDrzewa i pszczoły&r."]
	quest.21AB14A8553896E9.title: "&2&lProductive Trees"
	quest.23254CE8487D2E68.quest_desc: ["&8Wither Builder&r to jedna z największych maszyn z &lIndustrial Foregoing&r, i dlatego jest droga. \\n\\nNajpierw potrzebujesz części, z których składa się &8Wither&r, oraz drop z &8Withera&r. \\n\\nPotem potrzebujesz &6Supreme Machine Frame&r, do którego wytworzenia potrzebujesz &bEther Gas&r. Zgadnij, czego potrzebujesz do &bEther Gas&r? Zgadza się! &8Withera&r! Musisz użyć Laser Drill na &8Witherze&r, żeby go zdobyć. \\n\\n&8Withery&r lubią odlatywać i zabijać różne rzeczy, więc Stasis Chamber ułatwi ich dojenie! "]
	quest.23254CE8487D2E68.title: "&8Wither Builder"
	quest.23AE395433AED3C0.quest_desc: ["&6&lATM Star&r potrzebuje kilku bloków, które utrzymają razem różne przedmioty i nadadzą mu gwiazdowy kształt! \\n\\nPierwsze bloki to &5Unobtainium&r - &6Allthemodium&r &5Alloy&r &6Blocks&r. Aby je zrobić, musisz użyć Enchanting Apparatus z &d&lArs Nouveau&r. A dokładnie 28 sztuk. \\n\\nNa 17 X3 Netherstar Blocks potrzebujesz 111 537 Nether Stars. (Błagam, użyj &l&bHNN&r, tylko nie przywołuj i nie zabijaj 111 537 Witherów, proszę!)"]
	quest.23AE395433AED3C0.title: "&6&lThe Star's&r Casing"
	quest.24F3E90C14BFD1B4.quest_desc: ["&7&lModern Industrialization&r to mod tak duży jak jego nazwa! \\n\\nMa wiele poziomów maszyn i na szczęście nie musimy dochodzić do ostatniego, żeby zdobyć &6&lStar&r. \\n\\nCo więcej, teraz jest to całkowicie opcjonalne! Jeśli wolisz pobawić się &6&lCreate&r, żeby stworzyć (rozumiesz?) &6&lATM Star&r, możesz!"]
	quest.24F3E90C14BFD1B4.title: "&7&lModern Industrialization"
	quest.263C9A0FC04472AB.quest_desc: ["Ten potrafi pochłaniać &clawę&r jak żaden inny, albo można go użyć do &6&lStar&r. \\n\\nTo ciężka sprawa, lubię patrzeć, jak &clawa&r znika, zamiast moich rzeczy znikających w &clawie&r."]
	quest.263C9A0FC04472AB.title: "&464x Magmatic Generator"
	quest.268EA2DEC8840D13.quest_desc: ["Podczas pracy nad &4Computers&r, zwłaszcza Quantum, młotki i szczypce na Crafting Table nie wytworzą tego, czego potrzebujemy, więc potrzebujemy &bCrystal Assembler&r. \\n\\nDo tego potrzebujemy całej masy &9Singularities&r!"]
	quest.268EA2DEC8840D13.title: "&4Quantum Computer Multi-Threader"
	quest.28DB59B20109D0D4.quest_desc: ["&6&lOritech&r to mod technologiczny (kto by pomyślał!) znany z wielu &lMultiblock Machines&r, niebezpiecznych bloków i kolorowych kafelkowych bloków! \\n\\nBędziesz potrzebować mnóstwa maszyn, wielu różnych stopów i materiałów oraz mnóstwa czasu. \\n\\nNa początek potrzebujesz &6Magnetic Coil&r i powodzenia!"]
	quest.28DB59B20109D0D4.title: "&6&lOritech"
	quest.29D28983E0200A3C.quest_desc: ["&l&dArs Nouveau&r polega na używaniu glifów w księgach czarów, aby rzucać je jako zaklęcia!"]
	quest.29D28983E0200A3C.title: "&d&lArs Nouveau"
	quest.2A444F4CCC72545D.quest_desc: ["Najłatwiejszym przedmiotem z &4&lCataclysm&r, którego potrzebujemy do &6&lATM Star&r, jest &5Abyssal Sacrifice&r. \\n\\nNajbardziej podstawowe potrzebne przedmioty to bloki sztabek i ametystu, które są po prostu przedmiotami z &2&lVanilli&r. \\n\\nPotem potrzebujesz Nautilus Shell i Heart of the Sea. To przedmioty z &2&lVanilli&r, które trudno zdobyć... chyba że zabijesz &5Deeplings&r, które mogą je upuścić. \\n\\nPotrzebujesz też Athame, czyli broni używanej przez &5Deepling Warlocks &fi &5Priests&r i upuszczanej przez nich po śmierci. \\nOstatnia część daje nam wybór: Crystallized Coral albo Coral Chunk. Oba są dropami z &5Coral Golem&r i &5Coralssus&r."]
	quest.2A444F4CCC72545D.title: "&5Abyssal Sacrifice"
	quest.2A72B262AF4F11C9.quest_desc: ["Aby zdobyć sadzonkę &6Socotra Dragon&r, musisz skrzyżować &7Wenge&r z &4Cocobolo&r. \\n\\nAby zdobyć &7Wenge&r, musisz skrzyżować &4Cocobolo&r z &fBalsa&r. \\n\\nAby zdobyć &4Cocobolo&r, musisz skrzyżować Balsa z &8Dark Oak&r. \\n\\nAby zdobyć &fBalsa&r, musisz skrzyżować &cAcacia&r z &eTeak&r. \\n\\nAby zdobyć &fTeak&r, możesz skrzyżować &2Jungle&r i &8Dark Oak&r."]
	quest.2A72B262AF4F11C9.title: "&6Socotra Dragon&r Sapling"
	quest.2B0C3AAAA6D0B0D2.quest_desc: ["&aUranium Quad Fuel Rods&r to połączenie wielu różnych stopów odpornych na wybuchy i promieniowanie oraz oczywiście radioaktywnych materiałów. \\n\\nWszystko to razem tworzy wspaniałe paliwo do reaktora! Albo &c&lPhilosopher's Fuel&r!  \\n\\nAlbo możesz po prostu użyć &cBlaze Burner&r... ale daj spokój, to żadna zabawa!"]
	quest.2B0C3AAAA6D0B0D2.title: "&aUranium Quad Fuel Rods"
	quest.2B57C8D2F98A9279.quest_desc: ["&l&7Pocket Storage&r to mod, który dodaje proste przenośne magazyny. \\n\\nKliknij prawym przyciskiem myszy, aby go otworzyć i włożyć do niego przedmioty. Ma maksymalną pojemność, a każdy przedmiot włożony ponad nią zostanie zniszczony. Będzie też zasysał przedmioty leżące na ziemi, które są takie same jak te w środku. \\n\\nSą też sposoby, aby szybko wysypać go do skrzyń lub wyjąć z nich zawartość. \\n\\nIm wyższy poziom, tym więcej slotów i większa maksymalna liczba przedmiotów."]
	quest.2B57C8D2F98A9279.title: "&l&7Pocket Storage"
	quest.2CECCA9D05D3EF12.quest_desc: ["&2Eternal Stella&r jest dość droga. Najpierw potrzebujesz Kuźni 3. poziomu! \\n\\nPotem potrzebujesz &7Stellarite Piece&r, które możesz wykopać. I musisz zdobyć 3 &aXpetried Orbs&r, których już nie da się wykopać. Zamiast tego musisz nakarmić Black Hole &aEXP&r, żeby je dostać! \\n\\nNa koniec potrzebujesz &6AllTheModium Ingot&r, żeby otrzymać &2Eternal Stella&r. Nic dziwnego, że jest taka droga, bo można ją połączyć z dowolnym narzędziem, aby uczynić je niezniszczalnym!"]
	quest.2CECCA9D05D3EF12.title: "&2Eternal Stella"
	quest.2D474F8075E9DBD0.quest_desc: ["Najpierw musisz ustawić Casting Altar i Standing Stones we wzorze podanym w JEI. \\n\\nPotem musisz włożyć do Casting Altar Diamond Block, Stick i Blaze Powder. \\n\\nNastępnie ustaw 4 Incense Blaziers wokół Casting Altar, włóż Block of Coal do jednego, Acacia Bark do drugiego, Verdant Bark do trzeciego, a Birch Bark do ostatniego. I zapal je wszystkie za pomocą Flint and Steel! \\n\\nPotem kliknij Casting Altar prawym przyciskiem myszy z Shiftem, aby rozpocząć rytuał! Jeśli nie zadziałało, sprawdź wzór, w jakim stoją Standing Stones."]
	quest.2D64EF8D803AF9DA.quest_desc: ["Najdroższy portal, jaki możemy zrobić. Po pierwsze, jeśli chodzi o &dDragon Eggs&r, nie musisz w kółko doić &dSmoka&r, możesz użyć &l&bHNN&r lub &l&2MA&r, żeby je zdobyć, albo Extractora, żeby zrobić więcej! \\n\\nPotem potrzebujesz &dInfused Dragon's Breath&r z zaklinania. \\n\\nTam potrzebujesz &9Soul-Touched Sculkshelves&r, żeby je zaklinać i zrobić portal. \\n\\nJeśli zastanawiasz się, dlaczego portal nie działa, to dlatego, że już jesteś w &2&lOverworldzie&r! Żartuję, nie możesz go użyć!"]
	quest.2E88CCBC7B97A1F0.quest_desc: ["Gdyby tylko ten gigantyczny portal w Ancient City coś robił! A, czekaj, z &9&lDeeper and Darker&r może! \\n\\nPotrzebujesz tylko..."]
	quest.2E88CCBC7B97A1F0.title: "&9&lDeeper and Darker"
	quest.2F76D074AEA84A4D.quest_desc: ["Klikając prawym przyciskiem myszy &dEnder Dragon&r pustym &bData Model&r, możesz stworzyć &dEnder Dragon &bData Model&r. \\n\\nZadanie wymaga dowolnej wersji, ale &d&lDragon Soul&r wymaga, aby &bData Model&r był &6Self Aware&r. \\n\\nAby osiągnąć &6Self Aware&r, musisz ciągle zabijać &dEnder Dragona&r albo zrobić mnóstwo symulacji &a&lTraining&r!"]
	quest.2F76D074AEA84A4D.title: "&dEnder Dragon &bData Model"
	quest.309B0B2898893B4E.quest_desc: ["&b&lSteve's Carts&r polega na ulepszaniu... no cóż, Twoich wagoników! \\n\\nJakie ulepszenia? Praktycznie wszystko oprócz zlewu kuchennego! \\n\\nOd wierteł, przez karabiny, po automaty do gier! Czego więcej możesz chcieć do swoich wagoników?"]
	quest.309B0B2898893B4E.title: "&l&bSteve's Carts"
	quest.30CC20E33EFA2EDA.quest_desc: ["&cBlaze Burner&r to chyba jeden z najłatwiejszych składników &6&lStar&r! \\n\\nNajpierw potrzebujemy &cEmpty Blaze Burner&r. To po prostu 4 &7Iron Plates&r i jeden &cNetherrack&r. \\n\\nPotem weź swój &cEmpty Blaze Burner&r i znajdź &cBlaze&r. Powinieneś wiedzieć, gdzie się pojawiają, ale na wypadek gdybyś nie wiedział: &cBlaze&r pojawiają się w strukturach w &c&lThe Nether&r. Wystarczy kliknąć &cBlaze&r prawym przyciskiem myszy za pomocą &cEmpty Blaze Burner&r, aby go schwytać! \\n\\nPo schwytaniu można go użyć w zamian za &aUranium Quad Fuel Rods&r do stworzenia &c&lPhilosopher's Fuel&r."]
	quest.30CC20E33EFA2EDA.title: "&cBlaze Burner"
	quest.3145B847A15F97F2.quest_desc: ["Możesz połączyć Essences z &2&lMystical Agriculture&r, aby zrobić... &8Coal&r. \\n\\nOczywiście działa jako świetne źródło paliwa, ale &5Insanium Coal&r wydaje mi się trochę zbyt szalony. "]
	quest.3145B847A15F97F2.title: "&5Insanium Coal Block"
	quest.31B0267C47DB9D98.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.31B0267C47DB9D98.title: "WszelkiePrawaZastrzeżone"
	quest.3331EBE1BB4BF64D.quest_desc: ["Reaktory jądrowe mogą być dla niektórych dość przerażające, zwłaszcza przez ich niebezpieczne skutki! \\n\\nNa szczęście jedyną przerażającą rzeczą w &a&lExtreme Reactors&r jest to, jak mylące może być podążanie za recepturami! \\n\\nNie ta wybuchowa część, bo one tego nie robią."]
	quest.3331EBE1BB4BF64D.title: "&a&lExtreme Reactors"
	quest.340CDF4357E22A43.quest_desc: ["Iron obdarzył nas bardzo zabawnym modem eksploracyjno-magicznym! Walka z magią i za magię! Nie ma nic fajniejszego! \\n\\nMa stronę zadań, nie ma za co. "]
	quest.340CDF4357E22A43.title: "&e&lIron's Spells and Spellbooks"
	quest.36CF8D1DD1EF6307.quest_subtitle: "2 Wet Light Green Blocks"
	quest.36DF0D83EBC2B6A9.quest_subtitle: "&oBrak mądrości to już przeszłość dzięki temu."
	quest.36DF0D83EBC2B6A9.title: "&3&lImprobable Probability Device"
	quest.372B5BF416CA83A4.quest_desc: ["&5&lMekanism&r to jeden z najpopularniejszych modów o maszynach i technologii. Szczerze mówiąc, trudno mi go podsumować, bo ma w sobie tak wiele! \\n\\nMa tyle, że musieliśmy zrobić dla niego 2 strony zadań! \\n\\nRzeczy, których potrzebujemy do &6&lATM Star&r, są na stronie Reactors, ale żeby tam dotrzeć, musisz przejść przez stronę Mekanism."]
	quest.372B5BF416CA83A4.title: "&5&lMekanism"
	quest.39B4F361EF611927.quest_subtitle: "&oWładza nad samą śmiercią."
	quest.39B4F361EF611927.title: "&l&8Wither's Compass"
	quest.39F9C825B03DA317.quest_desc: ["&8Aerial Interface&r działa jako połączenie między własnym wewnętrznym magazynem a Twoim ekwipunkiem. Zasadniczo cokolwiek do niego trafi, trafia do Ciebie. \\n\\nDo jego wytworzenia potrzebujesz całej linii montażowej, a zadania powinny Ci pomóc!"]
	quest.39F9C825B03DA317.title: "&8Aerial Interface"
	quest.3AAB71E9BDFD4C1E.quest_desc: ["Bez presji! No dobrze, tak naprawdę przy &4&lPneumaticCraft&r będziesz potrzebować dużo ciśnienia. \\n\\nNa tym to mniej więcej polega..."]
	quest.3AAB71E9BDFD4C1E.title: "&4&lPneumaticCraft"
	quest.3BE5CD0C7CC4BCC6.quest_desc: [
		"Soul Lava jest częścią &6&lAllthemodium&r. Można ją znaleźć w &b&lThe Other&r bardzo rzadko pod ziemią albo często w wioskach piglinów! \\n\\nMusimy wziąć wiadro &9Soul Lava&r i wylać ją na jajo Ghostly Bee, aby stworzyć &9Soul Lava Bee egg&r.\\n"
		"{image:atm:textures/questpics/soul_lava_process.png width:100 height:100 align:center}"
	]
	quest.3BE5CD0C7CC4BCC6.title: "&9Soul Lava Bee&r Spawn Egg"
	quest.3C7C9EE57AD00A76.quest_desc: ["Można je wytworzyć?!?!?! Ja zawsze tylko je zdobywałem z łupów. \\n\\nMożesz zmienić, czy namierzają cele, czy lecą prosto. Podczas namierzania możesz zmieniać ustawienia &cSpeed&r, &6Damage&r i &aTurn Speed&r."]
	quest.3C7C9EE57AD00A76.title: "&cMicromissiles"
	quest.3CFD27F273B97FDD.quest_desc: ["Mody &5&lApothic&r mają wiele rdzeni, a każdy zmienia inne części &2&lMinecrafta&r.\\n\\nMody Attributes i Enchanting to te, za którymi musisz podążać, aby zdobyć &6&lATM Star&r!"]
	quest.3CFD27F273B97FDD.title: "Mody &5&lApothic&r"
	quest.3F5B5D6B788E0A73.quest_desc: ["Krew, ciało, rytuały - jeśli coś jest złe, możesz być pewien, że pochodzi z &4&lEvilCraft&r! "]
	quest.3F5B5D6B788E0A73.title: "&4&lEvilCraft"
	quest.3F8AEBB994716318.quest_desc: ["&8Wither&r to efekt w &l&2Vanilli&r, więc oczywiście potrzebujemy własnego sposobu na jego używanie i nadużywanie! \\n\\nMożesz uwarzyć Awkward Potion z &8Wither Skeleton Skull&r, aby go stworzyć. Potem możesz wytwarzać z nim strzały!"]
	quest.4195800B4D7631E2.quest_desc: ["Dzięki rytuałowi &6Eziveus' Spectral Compulsion&r możemy połączyć &7Wormhole Frame&r, 2 Quartz i &3Enderpearl&r, aby zdobyć nasz Wormhole!"]
	quest.4195800B4D7631E2.title: "&6Stable Wormhole"
	quest.42AF4EBDA5D6CC36.quest_desc: ["Możesz stworzyć &2Blastproof Alloy&r, łącząc trzy najmocniejsze dostępne metale: &5Tungsten&r, &dTitanium&r i &7Stainless Steel&r. Tak, najwyraźniej plamy mają znaczenie. \\n\\nŁącząc je, możesz zrobić &2Casing&r. \\n\\nDo &3&lImprobable Probablity Device&r potrzebujemy albo 2 &2Blastproof Casings&r, albo 2 256M Portable Item Cells, albo możemy użyć mieszanki obu!"]
	quest.42AF4EBDA5D6CC36.title: "&2Blastproof Casing"
	quest.4485C4ABD57874EB.quest_desc: ["&b&lApplied Energistics&r nie jest modem magazynowym, to &lTEN&r mod magazynowy. \\n\\nOsobiście niewiele o nim wiem, ale strona zadań powinna Ci pomóc go poznać!"]
	quest.4485C4ABD57874EB.title: "&b&lApplied Energistics"
	quest.45D10F53CA18B8EE.quest_desc: ["Niestety nie można zdobyć Run &5Lightning&r z dropu moba, zamiast tego musimy je wytworzyć z &5Bottle O' Lightning&r. \\n\\n&5Bottle O' Lightning&r zdobywamy, używając Empty Bottle na Naładowanym Creeperze. \\n\\nNiebezpieczne, wiem..."]
	quest.45D10F53CA18B8EE.title: "&5Lightning&r Upgrade Orb"
	quest.486B5A605D79EA10.quest_desc: ["&cManhattan &aModule&r to skomplikowana receptura. Potrzebuje &cTNT&r, &dPlutonium Pellets&r i &5Heisenberg Compensators&r. Dobra, może tylko 2/3 jest skomplikowane. \\n\\nAby zrobić &dPlutonium Pellets&r, zacznij od energizowania &5Amethyst Shards&r. Powstanie &5Fluxite&r, którego można użyć z &aUranium Dust&r w &l&5Particle Accelerator&r, aby zrobić &dPlutonium Dust&r. \\n\\n&dPlutonium Dust&r można wytworzyć z Plastic Sheets i sztabką, aby uzyskać nasze &dPellets&r. \\n\\n&5Heisenberg Compensator&r ma 2 receptury, z których możemy skorzystać. Każda wymaga &c&lAtomic Forge&r, aby &cwygrawerować&r je za pomocą &bAdamant Ingots&r. \\n\\n1. Za pomocą &bUnholy Intelligence&r. Powstaje przez napełnienie &2Dubious Container&r za pomocą &5Strange Matter&r. &5Strange Matter&r zdobywa się, przepuszczając &clawę&r i &3Enderic Compound&r przez &d&lFluid Refinery&r z 2 dodatkowymi komorami. \\n\\n2. Za pomocą &eSuper AI Chip&r. AI w &2&lMinecrafcie&r? Tak, i wymaga drzewka receptur &cEngraving&r z &c&lAtomic Forge&r do wytworzenia. Na pewno dużo &8Silicon&r."]
	quest.486B5A605D79EA10.title: "&cManhattan &aModule"
	quest.49FDD8666356A3E7.quest_desc: ["Do wytworzenia &3&lImprobable Probability Device&r możemy użyć albo &2Blastproof Casing&r, albo 256M Portable Item Cells, albo obu. \\n\\nCzekaj, czy powiedziałem albo, albo obu? \\n\\nTak! Możemy użyć 2 &2Blastproof Casings&r albo 2 256M Portable Item Cells albo po jednym z każdego."]
	quest.49FDD8666356A3E7.title: "Albo &2Blastproof Casings&f, albo 256M Portable Item Cells"
	quest.4B12425E74C5E511.quest_desc: ["&cExplosive Mycelial Generator&r świetnie pochłania eksplozje. \\n\\nMoglibyśmy użyć go do &d&lPulsating &8Black Hole&r!"]
	quest.4B12425E74C5E511.title: "&cExplosive Mycelial Generator"
	quest.4B7D387CEFF9667E.quest_desc: ["W końcu! &6&lCreate&r został zaktualizowany i zdecydowanie warto było czekać! \\n\\n&6&lCreate&r polega na obracaniu i używaniu Energii obrotowej... praktycznie do wszystkiego! Wytwarzania, kruszenia, mieszania, warzenia itp. \\n\\nJeśli minęło tyle czasu, że nie pamiętasz, jak używać &6&lCreate&r, możesz użyć &7&lModern Industrialization&r do wytworzenia &6&lATM Star&r."]
	quest.4B7D387CEFF9667E.title: "&6&lCreate"
	quest.4BD203AD481DDE8F.quest_desc: ["&4Meat Shredder&r jest zrobiony z &4Witherite&r, które jest dropem z &4&lThe Harbinger&r. \\n\\nMusisz znaleźć &4Ancient Factory&r, która leży głęboko pod ziemią w &2&lOverworldzie&r. \\n\\nTam znajdziesz wyłączonego &4&lHarbinger&r, a żeby go włączyć, musimy dać mu Nether Star! \\n\\nPotem, po bardzo trudnej i długiej walce z bossem, możesz wytworzyć &4Meat Shredder&r!"]
	quest.4BD203AD481DDE8F.title: "&4Meat Shredder"
	quest.4CB488E5CF10F3A4.quest_desc: ["Najpotężniejszy i najdroższy generator z &c&lGenerator Galore&r. \\n\\nPotrzebujesz &9Echo Shard&r, &bConduit&r i mnóstwa Netherstar Generators!"]
	quest.4D7D4C718837BCA5.quest_desc: ["Główną częścią receptury Miniature Nether Portal jest &3Hellshelf of Masterful Sight&r. Zwykle służy do sprawdzania, jakie zaklęcia dostaniesz, ale my jesteśmy tu dla &6&lATM Star&r, nie dla zaklęć. \\n\\nWystarczy zaklinać tylko do &4Infused Hellshelf&r, które możesz zdobyć z kilku półek. Potem musisz wytworzyć z nim coś, żeby ulepszyć je jeszcze bardziej! \\n\\nPotem możesz wytworzyć Miniature Nether Portal, przez który nie, nie da się przejść, jesteś za duży!"]
	quest.4E82E843737045D9.quest_subtitle: "&oEsencja najpotężniejszych istot."
	quest.4E82E843737045D9.title: "&d&lDragon Soul"
	quest.4E8C32CD6057A1AB.quest_desc: ["Aby zrobić &c&lPhilosopher's Fuel&r, mamy wybór, czy użyć &cBlaze Burners&r, czy &aUranium Quad Fuel Rods&r. \\n\\nKtórekolwiek łatwiej Ci wytworzyć! \\n\\n(Czyli &cBlaze Burner&r!)"]
	quest.4E8C32CD6057A1AB.title: "&cBlaze Burner&f lub &aUranium Quad Fuel Rods"
	quest.501A0AEEC73C0790.quest_desc: ["&6Piglich&r to boss dodany przez &6&lAllthemodium&r, który mieszka w Ancient Pyramid w &l&bThe Other&r. \\n\\nPo śmierci upuszcza jedno ze swoich serc! Potrzebujesz 9 takich zabójstw, żeby zrobić z nich blok... \\n\\nNa szczęście są sposoby, aby je farmić!"]
	quest.501A0AEEC73C0790.title: "&6Piglich Heart Block"
	quest.535525EA4DF4AB59.quest_desc: ["&cPlayer Transmitter&r będzie zasilać energią każdego, kto ma Binded Card. Obejmuje to energię dla całej zbroi, narzędzi i przedmiotów w ich ekwipunku. \\n\\n&cNitro Tier&r jest potrzebny do &6&lStar&r, który jest oczywiście ostatni i najtrudniejszy do zdobycia."]
	quest.535525EA4DF4AB59.title: "&cNitro Player Transmitter"
	quest.54B1A876E9F6707A.quest_subtitle: "&oMoc i zniszczenie jakich nie ma równych!"
	quest.54B1A876E9F6707A.title: "&5&lOblivion Shard"
	quest.54BAF833344F0AAE.quest_desc: ["To zadanie ma 2 części! Najpierw potrzebujesz &8Dark Tank&r. Receptura jest prosta - wymaga tylko &8Dark Gems&r, żelaza i szkła. \\n\\nNastępnie potrzebujesz &7Eclipse Ember Fuel&r. To już nie takie proste... \\n\\nAby go zdobyć, wrzuć &7Eclipse Ember&r do &3Liquid Voidflame Fuel&r, by powstał &7Unrefined Eclipse Ember&r. Potem potrzebujesz &9Shadowpulse Goo&r, które się na niego rozprzestrzeni i da &7Eclipse Ember Fuel&r. \\n\\nA tak przy okazji, potrzebujesz 16 wiader tego paliwa!"]
	quest.54BAF833344F0AAE.title: "&8Dark Tank&r Pełny &7Eclipse Ember Fuel"
	quest.554F47A0AF7506EC.quest_subtitle: "59,049 End Stone"
	quest.55BF254B1831359B.quest_desc: ["&5Galgadorian Drills&r to najlepsze wiertła, jakie możemy podłączyć do naszych wagoników. \\n\\nPrzez to, że są takie świetne, ich wytworzenie będzie trudniejsze... \\nPowiedzmy tylko, że będziesz potrzebował mnóstwa &3Stabilized Metal&r! Podążaj za recepturami!"]
	quest.55BF254B1831359B.title: "&5Galgadorian Drills"
	quest.5608C74936CA9E81.quest_desc: ["&6Mechanical Arm&r to bardzo zagmatwana, ale też bardzo pomocna maszyna z moda &6&lCreate&r. Dzięki Bogu nie muszę tłumaczyć, jak ich używać, tylko jak je wytworzyć! \\n\\nNajpierw, i najprościej, &8Andesite Alloy&r. To po prostu 2 &8Andesite Blocks&r i 2 &7Zinc/Iron Nuggets&r. \\n\\nNastępnie &eBrass Plates &fi &eCasing&r. Oba oczywiście wymagają &eBrass&r, czyli stopu z &6Copper&r i &7Zinc&r! \\n\\nNa końcu, zdecydowanie najtrudniejszy z tych elementów, &ePrecision Mechanism&r. Potrzebujesz całej konfiguracji z &6Deployers &fi &eBelts&r, które będą przesuwać naszą &eGold Plate&r, aby dodawać do niej kolejne przedmioty. \\n\\n1. krok: użyj &6Deployer&r, aby dodać &dCogwheel&r do naszej &eGold Plate&r. 2. krok: w podobny sposób dodaj do niej &dLarge Cogwheel&r. 3. krok: dodajemy &7Iron Nugget&r za pomocą &6Deployer&r. \\n\\nMusimy to powtórzyć 5 razy, aby (miejmy nadzieję) dostać nasz &ePrecision Mechanism&r! Tak, jest 20% szans, że na końcu nie dostaniesz przedmiotu! \\n\\nHej, jeśli nie podoba Ci się cała ta praca, zawsze możesz wytworzyć &6Large Advanced Motor&r."]
	quest.5608C74936CA9E81.title: "&6Mechanical Arm"
	quest.561B5FB009744D2B.quest_desc: ["Aby zdobyć &aInsanite Blocks&r, potrzebujesz 8 &aInsanite Ingots&r i 1 &cBlock of Inanite&r. Tak, wiem, że to mylące, skoro różni je tylko jedna litera. \\n\\nAby zdobyć &aInsanite Ingots&r, musisz przetworzyć &bBenitoite&r z &4Rossinite&r w bloku Reprocessor. \\n\\n&bBenitoite&r trzeba wydobyć w &c&lNetherze&r. \\n\\n&cInanite Blocks&r powstają z połączenia 8 &cInanite Ingots&r z &cBlock of Netherite&r! &cInanite&r, nie &aInsanite&r. \\n\\nAby zdobyć Inanite Ingots, musisz przetworzyć &dRidiculite&r z &4Rossinite&r w bloku Reprocessor. \\n\\n&dRidiculite&r to kolejny łańcuch receptur, na który szczerze mówiąc mam już dość patrzeć!"]
	quest.561B5FB009744D2B.title: "&aInsanite Blocks"
	quest.5791F3000D18E2C9.quest_desc: ["&8Wither&r ma skłonność do niszczenia i wysadzania bloków. \\n\\nWiększość graczy tego nie lubi, więc &8Witherproof Bricks&r to dokładnie to, czego szukasz! \\n\\nSą jak &8Witherproof Blocks&r, tylko z lepszym wyglądem!"]
	quest.5791F3000D18E2C9.title: "&8Witherproof Bricks"
	quest.57F107892FFA1F52.quest_desc: ["Aby wyhodować Nether Star Seeds, potrzebujesz Crux pod blokiem Farmland. Tak, hodowla Nether Stars musiała być droższa! \\n\\nAby wytworzyć Nether Star Crux, potrzebujesz &7Withering Souls&r, które mają 1/3 szansy na wypadnięcie z &8Withers&r."]
	quest.5869E198DA416346.quest_desc: ["Późna faza gry w &5&lMekanism&r jest po prostu szalona. Na 1 &5Antimatter Pellet&r musisz skrystalizować 1,000mb &5Antimatter&r. \\n\\nNa 1mb &5Antimatter&r musisz przepuścić przez SPS 1,000mb &3Polonium&r. \\n\\nAby zdobyć 1mb &3Polonium&r, musisz aktywować neutrony z 5mb &2Nuclear Waste&r. \\n\\nA &2Nuclear Waste&r dostajesz z przetwarzania &9Fissile Fuel&r w bloku Fission Reactor!"]
	quest.5869E198DA416346.title: "2 &5Antimatter Pellets"
	quest.59EC02C1FBCF14EA.quest_desc: ["Możesz ulepszyć swój &5Obsidian Generator&r do &3Ender Generator&r. \\n\\nWtedy może on używać &3Ender Pearls&r lub &3Eyes of Ender&r do wytwarzania energii! \\n\\nAlbo zrób &6&lStar&r, Twój wybór."]
	quest.59EC02C1FBCF14EA.title: "&3Ender Generator"
	quest.5A6831E0BD2F6AB5.quest_desc: ["Będziesz potrzebował całej masy &8Dark Gems&r!"]
	quest.5A6831E0BD2F6AB5.title: "2 &4Piercing Vengeance Focuses"
	quest.5A955C0F53AED3ED.quest_desc: ["&bChain of Souls&r działa podobnie do haka z liną. \\n\\nMożesz kliknąć prawym przyciskiem myszy, aby wystrzelić &bChain&r, która przyciągnie Cię do bloku, w który ją posłałeś. Kliknij ponownie prawym przyciskiem, aby ją zwolnić. Dodatkowo ma zasięg około 90 bloków, plus minus kilka. \\n\\nAby ją wytworzyć, potrzebujesz &bTrapped Soul&r, 2 &5Tenacious Vines&r i &9Tenacious Petal&r. \\n\\nTe przedmioty zdobędziesz, zabijając &9Lunar Monstrocity&r. "]
	quest.5A955C0F53AED3ED.title: "&bChain of Souls"
	quest.5B2FD54E425D5C9D.quest_desc: ["Ten przedmiot jest ciężki do zdobycia... musimy zabić 2 bossy i jednego minibossa, aby zdobyć wszystko do &dVoid &cForge&r. \\n\\nNajpierw potrzebujemy &4Mechanical Fusion Anvil&r. Aby ją zdobyć, odwiedź &4Ancient Factory&r, która leży pod &2&lOverworldem&r. \\n\\nNastępnie nakarm &4&lThe Harbinger&r Nether Star, aby go wzmocnić, i zabij go! &4&lThe Harbinger&r wyda &4Witherite&r, z którego można wytworzyć &4Mechanical Fusion Anvil&r. \\n\\nPotem potrzebujemy &cInfernal Forge&r. Wypada ona z &c&lNetherite Monstrosity&r. \\n\\nUdaj się do &c&lNetheru&r, aby znaleźć strukturę &cSoul Blacksmith&r. Tam walcz z &c&lNetherite Monstrosity&r i pokonaj ją, aby zdobyć swoje &cInfernal Forge&r! \\n\\nOstatni, i prawdopodobnie najłatwiejszy, jest &dVoid Core&r. Na szczęście nie wypada z bossa, tylko z minibossa! \\n\\nOdwiedź &5&lThe End&r, aby znaleźć &dRuined Citadel&r. W środku znajdziesz &dEnder Golem&r. To on wyda nam &dVoid Core&r. \\n\\nGdy będziesz mieć wszystko, użyj &4Mechanical Fusion Anvil&r, aby połączyć &cInfernal Forge&r i &dVoid Core&r w &dVoid &cForge&r."]
	quest.5B2FD54E425D5C9D.title: "&dVoid &cForge"
	quest.5EC1B868720BF521.quest_desc: ["&8&lImmersive Engineering&r to przede wszystkim maszyny multiblokowe, fajne narzędzia i oczywiście inżynieria. \\n\\nNie martw się, nie potrzebujesz do tego 4 lat studiów! Ale Manual może pomóc Ci zacząć."]
	quest.5EC1B868720BF521.title: "&8&lImmersive Engineering"
	quest.601C719C8FD513F0.quest_desc: ["3 &cNetherite Ingots&r, 3 Wireless Boosters i kupa &2fantazyjnych &eGears&r, a zdobędziemy Infinity Range Booster! \\n\\nNajbardziej mylące są Gears. Nie możemy zrobić sztabek bezpośrednio - musimy zmieszać pyły, a potem przetopić wynik, by dostać sztabki.\\n\\nNie działa to między wymiarami, przepraszam!"]
	quest.60C8272DD1A2B262.quest_desc: [
		"Wszystkie receptury w Runic Star Altar mają &#DE552Cminimalne&r wymaganie energetyczne. Można je zobaczyć, najeżdżając kursorem na ulepszenie na stronie receptury.\\n\\nTo wymaganie energetyczne można spełnić, dając maszynom odpowiednie ulepszenia."
		"{@pagebreak}"
		"1. &n&#A839EDRunic Attuned Crystals&r z &#39EDA5Forbidden and Arcanus&r. Dodadzą one &#EDE02F512 EU/t&r pojemności. Pomija to postęp w &#EDA439Modern Industrialization&r.\\n\\n2. &n&#2278F2Dowolne ulepszenia&r z &#EDA439Modern Industrialization&r. Różne ulepszenia zwiększają pojemność energii o różne wartości. \\n\\nBasic dodają &#EDE02F2 EU/t&r, Advanced dodają &#EDE02F16 EU/t&r, Turbo dodają &#EDE02F64 EU/t&r, Highly Advanced dodają &#EDE02F512 EU/t&r, a Quantum dodają &#EDE02F1,000,000,000 EU/t&r.  "
	]
	quest.60C8272DD1A2B262.quest_subtitle: "Runic Star Altar nie działa bez ulepszeń"
	quest.616F9B78B16B42A5.quest_desc: ["Receptura &6Tesla Coil&r może wydawać się skomplikowana, zwłaszcza w drzewku receptur, ale możemy ją uprościć!\\n\\n&7Aluminum Plates&r są bardzo proste - wystarczy użyć młota na sztabkach albo multiblokowej Metal Press.\\n\\n&8Iron Mechanical Component&r też jest proste - to tylko kilka Iron Plates i &6Copper Ingot&r.\\n\\n&eElectrum Coil Block&r będzie wymagał sporo &eElectrum Ingots&r pociętych na druty. &eElectrum&r to stop &eGold&r i Silver.\\n\\n&6Advanced Electronic Component&r to cała masa pracy z Engineers Workbench i &9Blueprints&r. Jego Duroplast Sheet wymaga dużo rafinacji i fermentacji w maszynach multiblokowych!\\n\\nOstatni element, &cHV Accumulator&r, potrzebuje prostych przedmiotów, takich jak &8Steel&r, &7Aluminum Plate&r, &cRedstone Acid&r i &4Treated Wood&r. Wymaga też bardziej skomplikowanego przedmiotu o nazwie &8HOP Graphite Ingot&r."]
	quest.616F9B78B16B42A5.title: "&6Tesla Coil"
	quest.62B5A84753ADFC35.quest_subtitle: "8 Dry Dark Pink Blocks"
	quest.62DDE5B1287BEB36.quest_desc: ["Kolejna część soczystego wnętrza &6&lATM Star&r to &6Awakened &5Unobtainium&f-&3Vibranium&r Alloy Block, który będę po prostu nazywać blokiem &6Awakened Alloy&r. \\nAby go zdobyć, potrzebujesz multibloku &6&lStar Altar&r (więcej informacji znajdziesz w zadaniu Crafting the Star!) \\n\\nTam musisz wrzucić &5Unobtainium&f-&3Vibranium&r Block, 4 Unbreaking I Books, 4 &6Awakened Supremium Gemstones&r i 4 &6Awakened Supremium Essence&r. \\n\\nNastępnie musisz dostarczyć mu 85 milionów FE... Po tym Twój stop powinien być Awakened!"]
	quest.62DDE5B1287BEB36.title: "&6Awakened &5Unobtainium&f-&3Vibranium&r Alloy Block"
	quest.67C76EDD4BCCFF3F.quest_desc: ["Dzięki &bStrigeor's Higher Binding&r możemy zrobić &bEmpty Soul Gem&r. \\n\\nMożna ich używać do bezpiecznego transportu mobów albo do stworzenia &d&lDragon Soul&r. \\n\\nOsobiście uważam, że powinniśmy zrobić jedno i drugie!"]
	quest.67C76EDD4BCCFF3F.title: "&bEmpty Soul Gem"
	quest.6877F33323910716.quest_desc: ["Pocket Storage poziomu 4 ma 64 sloty na przedmioty, a każdy mieści 1,048,575 przedmiotów. To łącznie 67,108,800 przedmiotów. Przesuńcie się, plecaki, zostałyście zastąpione! \\n\\nKosztuje tylko kilka Nether Stars, co w modowanej grze szczerze mówiąc nie jest drogie jak na to, co dostajesz!"]
	quest.6A12188E50EAEB78.quest_desc: ["&zRainbow Furnaces&r przetapiają cały stack przedmiotów naraz! \\n\\nAby je wytworzyć, potrzebujesz &zRainbow Core&r, do którego trzeba 2 &cNetherite Furnaces&r i wszystkich kolorów &ztęczy&r w szkle! \\n\\nPotem potrzebujesz &zRainbow Plating&r, które dostaniesz, łącząc prawie każdy inny Furnace z tego moda. Potrzebujesz 2 sztuk, aby wytworzyć &3&lImprobable Probability Device&r."]
	quest.6A12188E50EAEB78.title: "2 &zRainbow Furnaces"
	quest.6A46A9F04D2A0748.quest_desc: ["Direwolf to nazwa nierozerwalnie związana z modowanym Minecraftem, a &3&lJust Dire Things&r to jedno z jego dzieci. \\n\\nKręci się wokół Goo, tak, wiem, brzmi zachęcająco!"]
	quest.6A46A9F04D2A0748.title: "&3&lJust Dire Things"
	quest.6CAD67D21E1EA861.quest_subtitle: "&oUniwersalny zdalny dostęp."
	quest.6CAD67D21E1EA861.title: "&7&lNexium Emitter"
	quest.6D1E8399AD39FFC8.quest_desc: ["&7Paradox Machine&r może, za cenę dużej ilości energii i &aTime Fluid&r, zrobić zrzut bloków i bytów w wyznaczonym obszarze, a następnie go zduplikować. \\n\\nWiele bloków i bytów jest na czarnej liście w konfiguracji, więc nie zduplikujesz pszczół!"]
	quest.6D1E8399AD39FFC8.title: "&7Paradox Machine"
	quest.6E3AD764A67829CB.quest_desc: ["Podobnie jak jego gorszy brat, &bInfusion Crystal&r, &cMaster Infusion Crystal&r potrafi wszystko to, co ten pierwszy. \\n\\nTen ma po prostu nieskończoną liczbę użyć i może ulepszyć 4 bloki Essence do następnego w formie bloku! \\n\\nDo jego wytworzenia potrzebny jest &cSupremium&r, ale zaufaj mi, warto!"]
	quest.6E3AD764A67829CB.title: "&cMaster Infusion Crystal"
	quest.70CCE558E03227AB.quest_desc: [
		"&6&lRunic Star Altar&r to multiblok stworzony przez naszego własnego &3Drack.ion&r za pomocą &7&lModern Industrialization&r! \\n\\nTo struktura o wymiarach 15x8x15, która zaczyna się od &5Runic Star Altar Block&r. Postaw go, a następnie użyj na nim &eWrench&r (z &7&lModern Industrialization&r). Dzięki temu zobaczysz podświetlenia, według których zbudujesz multiblok. \\n\\nPo zbudowaniu (z pomocą 2. strony zadania lub &eWrench&r) po każdej stronie &6&lAltar&r możesz zastąpić &9Polished Darkstone&r obok &6Arcane Polished Darkstone&r włazami (Hatches). Są one potrzebne do właściwego wytwarzania &6&lStar&r. \\n\\nUżyj Item Input Hatches (wszystkie z &l&7Modern Industrialization&r) - to tam trafi receptura. Z Item Output Hatches wyjdzie &6&lThe Star&r. A Energy Inputs są potrzebne do zasilania &6&lAltar&r! \\nSkoro mowa o energii, &6&lStar Altar&r będzie potrzebował wzmocnienia, aby dostać wystarczająco FE/t. Aby to osiągnąć, możemy użyć stosów ulepszeń z &7&lModern Industrialization&r. Umieszcza się je w &5Altar Block&r, a gdy przytrzymamy Shift, patrząc na przedmiot, zobaczymy, jak bardzo wzmacnia on &6&lAltar&r! \\n\\nMożesz sprawdzić &5Altar Block&r, aby rozpocząć receptury w &6&lAltar&r, a jeśli nie jest poprawnie zbudowany, poinformuje Cię o tym. \\n\\n(Przy okazji, Loot Bag użyty w jego recepturze pochodzi z &5&lLunar Monstrosity&r. Ponadto kierunek bloków takich jak &9Stairs&r czy &6Pillars&r nie ma znaczenia dla &6Altar&r)."
		"{@pagebreak}"
		"{image:atm:textures/questpics/chap2/atmstar_layer1.png width:125 height:75 align:center}"
		"1. warstwa to tylko &9Polished Darkstone&r, &9Polished Darkstone Stairs&r i &6Arcane Polished Darkstone&r, razem z &5Altar Block&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer2.png width:125 height:75 align:center}"
		"2. warstwa to więcej &9Polished Darkstone&r, &9Stairs&r, a teraz także &6Gilded Chiseled Polished Darkstone&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer3.png width:125 height:100 align:center}"
		"3. dodaje &bArcane Crystal Obelisks&r, &7Rune Blocks&r, &6Arcane Chiseled Polished Darkstone&r i &9Polished Darkstone Slabs&r!"
		"{image:atm:textures/questpics/chap2/atmstar_layer4.png width:125 height:100 align:center}"
		"W 4. warstwie mamy &6Darkstone Pedestals&r, &7Magnetized Darkstone Pedestal&r na środku i &6Arcane Polished Darkstone Pillars&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer5.png width:125 height:100 align:center}"
		"5. warstwa jest dość prosta, to tylko kolejne &6Pillars&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer6.png width:125 height:100 align:center}"
		"6. warstwa potrzebuje więcej &6Pillars&r oraz &7Quantum Injector&r nad &7Magnetized Darkstone Pedestal&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer7.png width:100 height:100 align:center}"
		"7. jest również bardzo prosta, to tylko więcej &6Pillars&r!"
		"{image:atm:textures/questpics/chap2/atmstar_layer8.png width:100 height:100 align:center}"
		"Ostatnia warstwa potrzebuje oczywiście więcej &6Pillars&r, a oprócz tego więcej &7Rune Blocks&r i &bArcane Crystal Blocks&r."
		"{image:atm:textures/questpics/chap2/atmstar_layer9.png width:125 height:100 align:center}"
		"Teraz możemy dodać nasze Utrem Jars! &5Altar Block&r marudził, gdy słoje nie były pełne..."
		"{image:atm:textures/questpics/chap2/atmstar_layer10.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/chap2/atmstar_layer11.png width:200 height:100 align:center}"
		"Ostatnia rzecz, którą musimy zrobić, aby uruchomić &6&lAltar&r, to dodanie Hatches. Umieść je na zewnątrz &6Arcane Polished Darkstone&r, tak jak pokazano - potrzebujesz kilku Item Inputs, Outputs i Energy Inputs."
	]
	quest.70CCE558E03227AB.quest_subtitle: "Wytwarzanie &l&6ATM Star"
	quest.70CCE558E03227AB.title: "&l&6Runic Star Altar"
	quest.7154D73516548149.quest_desc: ["&6&lAllthemodium&r to modyfikacja dodana specjalnie przez &6AllTheMods Team&r, aby dodać więcej zawartości po Netherite! \\n\\nMusisz przez nią przejść w trakcie przygody, aby zdobyć niektóre przedmioty potrzebne do &6&lATM Star&r. \\n\\nIstnieje teraz osobna strona zadań, według której możesz to robić!"]
	quest.7154D73516548149.title: "&l&6Allthemodium"
	quest.71581992E8E4C43E.quest_desc: ["Wrzuć kilka &8Wither Skeleton Skulls&r i &dAbjuration Essence&r, aby stworzyć &8Wither &3Glyph&r! \\n\\nJeśli nie zadziałało, możesz potrzebować więcej &aEXP&r."]
	quest.71581992E8E4C43E.title: "&3Glyph of &8Wither"
	quest.7377C657CED885AC.quest_desc: ["&2&lMystical Agriculture&r to modyfikacja o rolnictwie, ale co właściwie uprawiasz?\\n\\nPraktycznie wszystko, od miodu przez stal po Wither Skeletons.\\n\\nMusisz się nieźle narolnić z tą modyfikacją, aby wytworzyć &6&lATM Star&r!"]
	quest.7377C657CED885AC.title: "&2&lMystical Agriculture"
	quest.73BE1EB3E69814E9.quest_desc: ["Pierwszą i najłatwiejszą częścią tej receptury są &5Evil Sticks&r. Potrzebujesz tylko &8Dark Gems&r, które trzeba wydobyć, i &cUndead Planks&r, które dostajesz z &cUndead Trees&r. \\n\\nNastępnie &5Empowered Inverted Potentia&r. Nie jest trudne do zrobienia - po prostu wytwórz &7Inverted Potentia&r, potem trzymaj go w &aEnviromental Accumulator&r i niech zostanie rażony piorunem! \\n\\nOstatnia część to długi ciąg &aEmpty Promises&r; będziesz musiał wlać w nie bardzo dużo. \\n\\nMam nadzieję, że masz mnóstwo &4Blood&r! Skoro już o tym mowa, będziesz też musiał napełnić &5Mace&r za pomocą &4Blood&r."]
	quest.73BE1EB3E69814E9.title: "&5Mace of Destruction"
	quest.73E2A53A088AD29A.quest_subtitle: "11 Wet Pink Blocks"
	quest.750B6316267CF574.quest_desc: ["Gdy Twoje ule są puste i ciemne, możesz znaleźć małego pszczelego gościa - Skeletal Bee. \\n\\nMożesz wtedy nakarmić nowego gościa &8Wither Rose&r, aby zamienić go w &8Withered Bee&r. "]
	quest.750B6316267CF574.title: "&8Withered Comb Block"
	quest.752DD0BF36B70D88.quest_desc: ["Piece po prostu nie są wystarczająco szybkie w zwykłym &2&lMinecrafcie&r, więc jak myślisz, jak poradzą sobie w modowanej grze!?\\n\\nNa szczęście &7&lIron Furnaces&r znacznie je przyspieszają! \\n\\nMa też stronę zadań, tylko że dzieli ją z &c&lGenerator Galore&r."]
	quest.752DD0BF36B70D88.title: "&7&lIron Furnaces"
	quest.75EE965CBA598FEA.quest_desc: ["Receptura może wyglądać na zagmatwaną, ale zaufaj mi, jest dość łatwa. Wytwórz dowolne &dWireless Terminals&r, a następnie połącz je w siatce wytwarzania, aby uzyskać &dUniversal Wireless Terminal&r. \\n\\nZachowa on także wszystko, co miałeś w &dTerminal&r, na przykład Extended Patterns, co jest bardzo pomocne przy używaniu &b&lAE2&r, ale nie ma znaczenia dla &6&lATM Star&r!"]
	quest.75EE965CBA598FEA.title: "&dUniversal Wireless Terminal"
	quest.764609E41957DA69.quest_subtitle: "6,561 Emerald Blocks"
	quest.76C63670624C3C56.quest_desc: ["&c&lGenerator Galore&r daje nam mnóstwo pomocnych i prostych generatorów energii! \\n\\nNiektóre można nawet łączyć ze sobą, aby były mocniejsze. \\n\\nIstnieje dla nich strona zadań, tylko że dzielą ją z &7&lIron Furnaces&r."]
	quest.76C63670624C3C56.title: "&c&lGenerator Galore"
	quest.7766E66A14643F4D.quest_desc: ["&6Awakening&r to stosunkowo nowy dodatek do &2&lMystical Agriculture&r. Dzięki &6Awakening Ritual&r możesz stworzyć &6Awakened Essence&r. \\n\\nNastępnie możesz połączyć je ze sztabkami, aby zdobyć ten blok!"]
	quest.7766E66A14643F4D.title: "&6Awakened Supremium Ingot Block"
	quest.779CA0C49F93C4F9.quest_subtitle: "59,049 Obsidian"
	quest.77F2271C45DB49BA.quest_desc: ["Ten moduł, umieszczony w napierśniku &aMekaSuit&r, da Ci Creative Flight. \\nDo jego wytworzenia potrzebujesz jedynie kilku najdroższych przedmiotów w grze!"]
	quest.792990DC06DB98F9.quest_desc: ["W &2&lOverworldzie&r możesz znaleźć &5&lEternal Starlight&r Portal Ruins. Tam możesz wyzwać Gatekeepera na walkę! \\n\\nJeśli wygrasz, da Ci kilka przedmiotów, za pomocą których możesz wejść przez portal do zupełnie nowego świata do odkrywania!"]
	quest.792990DC06DB98F9.title: "&5&lEternal Starlight"
	quest.7A579E233C69871F.quest_desc: ["&b&lHostile Neural Networks&r polega na symulowaniu mobów, aby farmić ich łupy! \\n\\nNie ma tu wiele więcej."]
	quest.7A579E233C69871F.title: "&b&lHostile Neural Networks"
	quest.7B140A034DF1291C.quest_desc: ["&7&lNexium Emitter&r potrzebuje czegoś, co będzie go poruszać - może to być &6Mechanical Arm&f lub &6Large Advanced Motor&r! \\n\\nOba się poruszają, więc działa każdy z nich!"]
	quest.7B140A034DF1291C.title: "&6Mechanical Arm&f lub &6Large Advanced Motor"
	quest.7BC616DDB5933479.quest_desc: ["Ten można stworzyć z &5Blood Vial&r i zwykłych składników na zwoje. \\nMusisz upewnić się, że ma poziom 10 i jest &6Legendary&r, do czego możesz go ulepszyć."]
	quest.7BC616DDB5933479.title: "&4Wither Skull Scroll"
	quest.7D1A27CBF1508712.quest_desc: ["&3Snow Queen&r mieszka w &bAurora Palace&r w biomie Glacier. \\n\\nAby wejść do biomu Glacier, musisz zabić Alpha Yeti. \\n\\nGdy zostanie pokonana, wyda mnóstwo łupów, w tym Trophy!"]
	quest.7D1A27CBF1508712.title: "&3Snow Queen &eTrophy"
	quest.7D359283625C1869.quest_desc: ["&4&lCataclysm&r to przygodowa modyfikacja, w całości poświęcona dodawaniu nowych bossów! I wszystkiego, co z nimi związane! \\n\\nStruktury znajdziesz w całym &2&lOverworldzie&r, &4&lNetherze&r i &5&lEndzie&r. \\n\\nW środku będą nowe moby, miniboss i bardzo trudne bossy. Możesz pokonać je wszystkie, aby zdobyć nową broń, zbroje i przedmioty!"]
	quest.7D359283625C1869.title: "&4&lCataclysm"
	quest.7D972A3C4211EB26.quest_desc: ["&zRainbow Coal&r zdobywa się, wysadzając &zRainbow Furnace&r."]
	quest.7D972A3C4211EB26.title: "&zRainbow Coal"
	quest.7E4367252A39BE6C.quest_desc: ["&c&lPowah&r kręci się wokół energii! Generowania energii takiej jak FE do zasilania maszyn z innych modyfikacji, takich jak &5&lMekanism&r czy &lIndustrial Foregoing&r! \\n\\nIstnieją różne poziomy, do których będziesz musiał się dopracować, i oczywiście ostatni będzie nam potrzebny do &6&lStar&r!"]
	quest.7E4367252A39BE6C.title: "&c&lPowah"
	task.1230A5C0C9D1A0CF.title: "Ulepszenia"
	task.644EBD9EBC93EB3C.title: "AllRightsReserved"
	task.662F6B4EF078E3A2.title: "AllRightsReserved"
}
