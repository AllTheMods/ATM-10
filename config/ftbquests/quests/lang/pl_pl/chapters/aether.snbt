{
	quest.04833C4BB0CCCBB7.quest_desc: ["Tak samo jak kamienne bronie, tylko że &7Miecz &rupuszcza &eAmbrosium Shards&r po uderzeniu moba, a &7Siekiera&r upuszcza je przy ścinaniu &2drzew&r."]
	quest.04833C4BB0CCCBB7.title: "Bronie &7Holystone&r"
	quest.0483D3B051665F07.quest_desc: ["&5Zanite&r ma o wiele więcej zastosowań niż poprzednie przedmioty. \\n\\nMożemy z niego zrobić narzędzia i zbroję. \\n\\nA nawet specjalne przedmioty, takie jak &5Nature Staff&r i &5&lAltar&r."]
	quest.0483D3B051665F07.title: "&5Zanite"
	quest.04B92FAB179A74C9.quest_desc: ["&dGravitite Sword&r podrzuca w powietrze wszystko, w co uderzy. Jak Knockback... tylko w górę! \\n\\n&dGravitite Axe&r to jedyny sposób na ścięcie &eGolden Oak Trees&r. "]
	quest.04B92FAB179A74C9.title: "Bronie &dGravitite&r"
	quest.08788F976B5C3281.quest_desc: ["&6Holy Sword&r jest jak &bDiamond Sword&r z zaklęciem Smite. \\n\\nSmite zadaje dodatkowe obrażenia nieumarłym mobom. &6Holy Sword&r robi to samo. \\n\\nNajlepsze jest to, że możesz zaklinać go zaklęciem Smite, by zadawał jeszcze więcej obrażeń!"]
	quest.08788F976B5C3281.title: "&6Holy Sword"
	quest.08E4892F96828EC4.quest_desc: [
		"Nie możesz uderzyć &c&lSun Spirit&r. Aby rozpocząć z nim walkę, musisz kliknąć go prawym przyciskiem myszy, żeby z nim porozmawiać. \\n\\nZrób to jeszcze kilka razy... potem jeszcze kilka... a po tuzinie dodatkowych razy będzie wystarczająco wściekły, by zacząć walkę! \\n\\n&c&lSun Spirit&r zacznie krążyć po sali, rozniecając &cogień&r wszędzie, gdzie się pojawi. \\n\\nBędzie też strzelał &cFire Crystals&r i &bIce Crystals&r. Aby zadać mu obrażenia, musisz odbić w jego stronę &bIce Crystals&r, co go zamrozi! Dopiero wtedy możesz go uderzyć. \\n\\nPo zamrożeniu przywoła też &cFire Minions&r, które mu pomogą. \\n\\nGdy zostanie pokonany, upuści..."
		"{image:atm:textures/questpics/aether/aether_gold2.png width:200 height:100 align:center}"
	]
	quest.08E4892F96828EC4.title: "&c&lSun Spirit"
	quest.0D2BF2C5D784FCBE.quest_desc: ["&eValkyrie Cape&r działa jak Slow Falling Potion. \\n\\nPrzydatna w &e&lThe Aether&r i &d&lThe End&r!"]
	quest.0D2BF2C5D784FCBE.title: "&eValkyrie Cape"
	quest.0D2F07FC0F804223.quest_desc: [
		"Przynieś jej 10 &eVictory Medals&r, a będziesz mógł z nią walczyć! \\n\\n&e&lQueen&r ma 500 &4serc&r. Będzie biegać po sali i wymachiwać w Twoją stronę mieczem. \\n\\nCzasem rzuci w Ciebie Thunders Crystals, które przywołują piorun, co po 1. powinno być niemożliwe z powodu sufitu, a po 2. jest zdecydowanie oszustwem. \\n\\nGdy zostanie pokonana, da Ci swój &eGold Sword&r i..."
		"{image:atm:textures/questpics/aether/aether_silver2.png width:200 height:100 align:center}"
	]
	quest.0D2F07FC0F804223.title: "&e&lValkyrie Queen"
	quest.102DD961706E861A.quest_desc: ["&5Aechor Plants&r to wrogie żywe rośliny. Chwila, przecież wszystkie rośliny są żywe... no, ale te mają siedem i pół &4serca&r, czego inne rośliny z &2&lMinecrafta&r nie mają. \\n\\n&5Aechor Plants&r strzelają strzałkami, którymi jeśli Cię trafią, dostaniesz efekt &5Inebreviation&r. Działa jak Poison połączony z Nausea i jeszcze jednym, zupełnie nowym efektem. \\n\\nPo zabiciu upuszczają swój &5Petal&r."]
	quest.102DD961706E861A.title: "&5Aechor Plant"
	quest.1B7B377CB757867E.quest_desc: ["Wszystkie &dGravitite Tools&r można kliknąć prawym przyciskiem myszy na blokach, które potrafią wydobyć, aby wystrzelić je w niebo! \\n\\nSą też najlepszymi narzędziami, jakie oferuje &l&eThe Aether&r."]
	quest.1B7B377CB757867E.title: "Narzędzia &dGravitite&r"
	quest.1ECAEC7BE573BB9C.quest_desc: ["&5&lAltar&r to bardzo przydatny blok. \\n\\nPotrafi &5zaklinać&r przedmioty oraz naprawiać narzędzia z &e&lAether&r i &2&lVanilla&r. \\n\\nGdy mowa o zaklinaniu, nie chodzi o &2&lVanilla&r zaklęcia z ksiąg. Po prostu przekształca on niektóre przedmioty z &e&lAether&r! \\n\\nPaliwem do &5&lAltar&r jest &eAmbrosium&r."]
	quest.1ECAEC7BE573BB9C.title: "&5&lAltar"
	quest.1F446EF3AD20DC6B.quest_desc: ["Ten &5Hammer&r jest bronią zarówno dystansową, jak i do walki w zwarciu. \\n\\nMożesz bić moby jak zwykle albo kliknąć prawym przyciskiem myszy, aby wystrzelić pociski. \\n\\nPociski odrzucają moby, podobnie jak Breezeballs, i zadają obrażenia."]
	quest.1F446EF3AD20DC6B.title: "&5Hammer of Kingbdogz"
	quest.20C2A09007E1309A.quest_desc: ["&dGravitite Ore&r nie przetapia się, lecz jest &5zaklinana&r w &5&lAltar&r. \\n\\nPo &5zaklęciu&r możemy zrobić z niej narzędzia i zbroję. Oraz Jukebox!"]
	quest.20C2A09007E1309A.title: "&dGravitite"
	quest.20D957B3C350CDE2.quest_desc: ["&dGravitite Armor&r daje 20 punktów pancerza i 8 wytrzymałości pancerza. \\n\\nGdy założysz wszystkie 5 części (tak, &dGloves&r też się liczą), nie będziesz skakać w powietrze, tylko szybować wielkimi susami! \\n\\nChroni też przed obrażeniami od upadku!"]
	quest.20D957B3C350CDE2.title: "Zbroja &dGravitite&r"
	quest.242C183437A4CCD4.quest_desc: ["&7Sentry Boots&r niwelują wszystkie obrażenia od upadku!"]
	quest.242C183437A4CCD4.title: "&7Sentry Boots"
	quest.24E124F12CFF2A50.quest_desc: [
		"&7&lSlider&r jest bossem &7Bronze Dungeon&r. \\n\\nTo sześcian... Ma 400 &4serc&r, a żeby zadać mu obrażenia, potrzebujesz kilofa. Im lepszy kilof, tym większe obrażenia. \\n\\n&l&7Slider&r jest bardzo prosty: porusza się tylko w jednym kierunku naraz i na zaledwie kilka bloków. Bardzo łatwo go uniknąć. \\n\\nGdy zbijesz go do 100 &4serc&r, jego oczy zrobią się &4czerwone&r i zacznie poruszać się szybciej. \\n\\nJeśli go \"wykopiesz\", dostaniesz..."
		"{image:atm:textures/questpics/aether/aether_bronze2.png width:200 height:100 align:center}"
	]
	quest.24E124F12CFF2A50.title: "&l&7The Slider"
	quest.26D6FC091B7A8B38.quest_desc: ["&eSilver Key&r! \\n\\nTreasure Chest otwiera się pod tronem &e&lQueen&r."]
	quest.26D6FC091B7A8B38.title: "&eSilver Key"
	quest.27F62C4B42B16015.quest_desc: ["Wystarczy ustawić prostokąt 4x5 z &eGlowstone&r, tak jak &cNether Portal&r, i wylać do środka &9Wodę&r, by stworzyć &eAether Portal&r? \\n\\nJasne, nie mam 7 lat, drugi raz się na to nie nabiorę! "]
	quest.27F62C4B42B16015.title: "&eAether Portal"
	quest.29E6EFC8C19912BD.quest_desc: ["&7Sentries&r to hybryda &aSlime &fi &aCreeperów&r. \\n\\nSkaczą jak &aSlimy&r i EKSPLODUJĄ jak &aCreepery&r! \\n\\nJeśli zabijesz je, zanim wybuchną, upuszczą &7Carved Stone&r."]
	quest.29E6EFC8C19912BD.title: "&7Sentries"
	quest.2E05F4FB1A1FDE2D.quest_desc: ["&9Blue Swets&r mają 6 &4serc&r. \\n\\nNie zadają obrażeń... a przynajmniej nie same z siebie. Zamiast tego chwytają Cię i wyskakują wysoko w powietrze, zabierając Cię ze sobą. \\n\\nGdy zostaniesz schwytany, jedynym sposobem na uwolnienie się jest uderzenie ich. \\n\\nPo śmierci &9Blue Swets&r upuszczają &9Swet Balls&r i &bBlue Aeroclouds&r."]
	quest.2E05F4FB1A1FDE2D.title: "&9Blue Swet"
	quest.31A2B9C5C0962160.quest_desc: ["&bDiamond Sword&r z Fire Aspect."]
	quest.31A2B9C5C0962160.title: "&cFlaming Sword"
	quest.326452FFA7F5C6CA.quest_desc: ["&eGolden Swets&r zachowują się jak &9Blue Swets&r. Tyle samo zdrowia, ten sam atak. \\n\\nTylko że te potrafią przeżyć wyższe skoki, co oznacza, że skaczą więcej razy i wyżej niż &9Blue Swets&r. \\n\\n&eGolden Swets&r upuszczają &ejasnopył&r! Przydatny do odbudowy &ePortal&r."]
	quest.326452FFA7F5C6CA.title: "&eGolden Swet"
	quest.3417FF406CF0479E.quest_desc: ["&2Skyroot&r to jedyne drzewo oprócz &eGolden Oak&r, jakie znajdziemy. \\n\\nSą też Crystal Trees, ale one też używają &2Skyroot Logs&r, więc na jedno wychodzi! \\n\\n&2Skyroot&r, jak każde drewno, pozwala tworzyć bloki, narzędzia itp."]
	quest.3417FF406CF0479E.title: "&2Skyroot Trees"
	quest.34FBB18ADA647010.quest_desc: ["Cloud Staff przywołuje 2 Cloud Minions, które krążą wokół Ciebie po kliknięciu prawym przyciskiem myszy. \\n\\nJeśli po ich przywołaniu klikniesz lewym przyciskiem myszy, oba wystrzelą Ice Crystals w miejsce, w które celujesz. \\n\\nGdy się nimi znudzisz, wystarczy kliknąć prawym przyciskiem myszy z Shiftem, aby się ich pozbyć."]
	quest.362F529D5E7C37A4.quest_desc: ["Jeśli staniesz w &9Wodzie&r w &6Phoenix Armor&r, dostaniesz &5Obsidian Armor&r. \\n\\n&5Obsidian Armor&r rezygnuje z Fire Protection na rzecz dodatkowych 4 punktów wytrzymałości pancerza."]
	quest.362F529D5E7C37A4.title: "&5Obsidian Armor"
	quest.3666C6DA23E15F78.quest_desc: ["Łuk, który podpala wszystkie strzały &cOGNIEM&r!"]
	quest.3666C6DA23E15F78.title: "&6Phoenix Bow"
	quest.36D9FB96D3557266.quest_desc: ["&9Moa&r to duże, przyjazne ptaki. \\n\\nMają 17 i pół &4serca&r i upuszczają Feathers. \\n\\nLosowo upuszczają &9Moa Eggs&r, dzięki którym możesz je oswoić. Sprawdź &c&lIncubator&r, aby dowiedzieć się więcej!"]
	quest.36D9FB96D3557266.title: "&9Moa"
	quest.3781DB4807A89375.quest_desc: ["&5Zanite Sword&r zadaje obrażenia mniej więcej jak Iron Sword... dopóki nie straci wytrzymałości. \\n\\nTak jest, ten &5miecz&r zadaje tym więcej obrażeń, im mniej ma wytrzymałości! \\n\\n&5Axe&r ścina &2drzewa&r tym szybciej, im mniej ma wytrzymałości."]
	quest.3781DB4807A89375.title: "Bronie &5Zanite&r"
	quest.3887FD4B14BB993D.quest_desc: ["&cRegeneration Stones&r stale leczą Cię, gdy je nosisz. \\n\\nMożesz nawet trzymać dwa naraz, a ich leczenie się zsumuje!"]
	quest.3887FD4B14BB993D.title: "&cRegeneration Stone"
	quest.38E3ABEEFCE6A0B9.quest_desc: ["&9Shield of Repulsion&r, gdy jest noszona, odbija pociski od Ciebie z powrotem w tego, kto je rzucił. \\n\\nMa jednak wytrzymałość..."]
	quest.38E3ABEEFCE6A0B9.title: "&9Shield of Repulsion"
	quest.39E1211455224291.quest_desc: ["&bZephyrs&r to wściekłe chmury. \\n\\nMają tylko 2 i pół &4serca&r, a strzelają w Ciebie Airballs. Jak Ghast, który strzela Breezeballs. \\n\\nPo zabiciu upuszczają Cold Aeroclouds."]
	quest.39E1211455224291.title: "&bZephyr"
	quest.3A8AF52A5AE7C6CB.quest_desc: ["Daje Water Breathing."]
	quest.3A8AF52A5AE7C6CB.title: "&7Iron Bubble"
	quest.3C62EDBB44D83A41.quest_desc: ["&5Nature Staff&r działa na oswojone &9Moa&r. \\n\\nChcesz, żeby usiadły? Użyj &5Staff&r."]
	quest.3C62EDBB44D83A41.title: "&5Nature Staff"
	quest.3DB036804AD70497.quest_desc: ["&7Bronze Key&r! \\n\\nTreasure Chest znajduje się pod miejscem, w którym spoczywał uśpiony &7&lSlider&r."]
	quest.3DB036804AD70497.title: "&7Bronze Key"
	quest.3EE51A812E593135.quest_desc: ["&c&lIncubator&r ma jedno zadanie: wykluwać &9Moa Eggs&r. \\n\\nJako paliwa używa &eAmbriosium Torches&r. Na każde &9jajo&r potrzebujesz 2, aby się wykluło. \\n\\nGdy &9jajo&r się wykluje, pojawi się młode &9Moa&r! \\n\\nDorośnięcie zajmie 20 minut, a potem możesz na nim jeździć z siodłem. Możesz też wydawać im polecenia za pomocą &5Nature Staff&r."]
	quest.3EE51A812E593135.title: "&c&lIncubator"
	quest.3FE994532AF53ABB.quest_desc: ["W przeciwieństwie do młodszego brata, &3Lightning Sword&r działa jak zwykły miecz. \\n\\nTylko że wszystko, w co uderzy, zostanie rażone piorunem!"]
	quest.3FE994532AF53ABB.title: "&3Lightning Sword"
	quest.40AD1851C6851925.quest_desc: ["Haha! Ktoś spadł! \\n\\nMam nadzieję, że zabrałeś coś, co zamortyzuje upadek. \\n\\nNastępnym razem po prostu użyj &ePortal&r!"]
	quest.40AD1851C6851925.title: "Ups!"
	quest.4394AEF0823FB4D2.quest_desc: ["Ten sam poziom co drewniane narzędzia, więc nie wydobędzie żelaza ani &5Zanite Ore&r. \\n\\nAle każde &2Skyroot&r podwaja zdobycz. \\n\\n&2Skyroot Pickaxe&r podwaja rudy, &2Shovel&r podwaja ziemię, a &2Hoe&r podwaja zdobycz z roślin."]
	quest.4394AEF0823FB4D2.title: "Narzędzia &2Skyroot&r"
	quest.48530C6C1187F613.quest_desc: ["Aerogel powstaje po wylaniu &clawy&r w &l&eThe Aether&r. \\n\\nNie niszczą go eksplozje i można z niego tworzyć inne dekoracje!"]
	quest.4974F265003DAEC9.quest_desc: ["&eValkyrie Tools&r są jak zwykłe narzędzia, tylko z podwójnym zasięgiem!"]
	quest.4974F265003DAEC9.title: "&eValkyrie Tools"
	quest.4AED9EF9E0F68483.quest_desc: ["&7Holystone Pickaxe&r potrafi wydobyć &5Zanite&r, ale nie &dGravitite&r. \\n\\nWszystkie te narzędzia losowo upuszczają &eAmbrosium Shards&r podczas niszczenia bloków."]
	quest.4AED9EF9E0F68483.title: "Narzędzia &7Holystone&r"
	quest.4BF7F82F1C8680B9.quest_desc: [
		"&7Bronze Dungeon&r to najłatwiejszy i najprostszy loch. \\n\\nPojawia się pod ziemią i składa się z dużych kwadratowych komnat zbudowanych z &7Carved Stone&r. Znajdziesz go, szukając Mossy Holystone nad ziemią i podążając nim w dół. \\n\\nW każdej komnacie pojawiają się &7Sentries&r, a w komnacie bossa znajdziesz &7&lSlider&r."
		"{image:atm:textures/questpics/aether/aether_bronze1.png width:200 height:100 align:center}"
	]
	quest.4BF7F82F1C8680B9.title: "&7Bronze Dungeon"
	quest.4E847B0288265DA3.quest_desc: ["&dCockatrice&r wyglądają jak &9Moa&r, tylko ze świecącymi oczami i Feathers. \\n\\nTe pierzaste wrogi pojawiają się tylko w ciemności. \\n\\nPluną w Ciebie, a trafienie da Ci efekt &5Inebreviation&r. Dokładniejszy opis tego efektu znajdziesz przy &5Aechor Plant&r. \\n\\n&dCockatrice&r mają 10 &4punktów zdrowia&r i po zabiciu upuszczają Feathers."]
	quest.4E847B0288265DA3.title: "&dCockatrice"
	quest.4F2DB9CDE2BACB69.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.52007C01B52F7295.quest_desc: ["&eValkyries&r pojawiają się w &eSilver Dungeon&r. \\n\\nMusisz pokonać 10 z nich, aby walczyć z &e&lValkyrie Queen&r. \\n\\nKażda ma 50 &4serc&r i jest neutralna, dopóki jej nie uderzysz. Na szczęście walczą pojedynczo."]
	quest.52007C01B52F7295.title: "10 &eVictory Medals"
	quest.57DD886985DBFD97.quest_desc: ["Otwierając skrzynie w lochach, możesz natknąć się na przerażającą podróbkę: &4Mimic&r. \\n\\n&4Mimics&r mają 20 &4serc&r i zadają mnóstwo obrażeń. \\n\\nNie martw się o łup, który mogłeś dostać ze skrzyni, bo po zabiciu &4Mimic&r upuści podobny łup!"]
	quest.57DD886985DBFD97.title: "&4Mimic"
	quest.58006FC06C34F6CA.quest_desc: ["&5Zanite Armor&r daje łącznie 15 punktów pancerza. \\n\\nNic specjalnego, to po prostu zbroja!"]
	quest.58006FC06C34F6CA.title: "Zbroja &5Zanite&r"
	quest.5825892699A8DCB7.quest_desc: ["Wow, udało się... \\n\\nWitaj w &e&lThe Aether&r, jednym z modpacków z naszego dzieciństwa! I tak, jest dokładnie taki, jak go pamiętamy! \\n\\n&e&lThe Aether&r to wymiar na niebie, wysoko nad &2&lOverworldem&r. Są tu pływające wyspy, struktury i chmury! Mnóstwo chmur. \\n\\nZnajdziesz tu też nowe przedmioty, moby, a nawet lochy."]
	quest.5825892699A8DCB7.title: "&l&eThe Aether"
	quest.5900ADCC247CD5F9.quest_desc: [
		"&eSilver Dungeon&r to najłatwiejszy do znalezienia loch, bo znajduje się nad ziemią. \\n\\nI to na ogromnych chmurach. \\n\\nI jest zbudowany z &eAngelic Stone&r. \\n\\nMa kształt greckiej architektury, co jest dziwne, bo &eValkyries&r pochodzą z mitologii nordyckiej. \\n\\nAby znaleźć &e&lValkyrie Queen&r, musisz wejść na najwyższe piętro, znaleźć schody z tyłu i zejść nimi w dół. Po rozmowie z nią powie Ci, że zanim będziesz mógł z nią walczyć, musisz zdobyć 10 &eVictory Medals&r."
		"{image:atm:textures/questpics/aether/aether_silver1.png width:200 height:100 align:center}"
	]
	quest.5900ADCC247CD5F9.title: "&eSilver Dungeon"
	quest.5A5D4DFE4175FB42.quest_desc: [
		"&cGold Dungeon&r również znajduje się pod ziemią. \\n\\nTym razem łatwiej go zauważyć, bo pojawia się pod ogromnym kopcem porośniętym &eGolden Oak Trees&r. \\n\\nLoch jest dość prosty: to po prostu sala z bossem."
		"{image:atm:textures/questpics/aether/aether_gold1.png width:200 height:100 align:center}"
	]
	quest.5A5D4DFE4175FB42.title: "&cGold Dungeon"
	quest.5BB5EE00BB4F9691.quest_desc: ["&7Flying Cows&r to krowy ze skrzydłami! \\n\\nNiewiele nowego... \\n\\n5 &4serc&r, upuszczają Raw Beef i Leather, można je doić. \\n\\nTylko że te szybują, więc nie otrzymują obrażeń od upadku."]
	quest.5BB5EE00BB4F9691.title: "&7Flying Cow"
	quest.5C6BA6BBEC75EB71.quest_desc: ["&cGold Key&r! \\n\\nTreasure Chest otwiera się za ścianą naprzeciwko wejścia."]
	quest.5C6BA6BBEC75EB71.title: "&cGold Key"
	quest.5F44BF9A1DAE8B99.quest_desc: ["&9Neptune Armor&r daje 15 punktów pancerza i 4 wytrzymałości pancerza. \\n\\nCały zestaw sprawi, że będziesz pływać w &9Wodzie&r szybciej! I tyle."]
	quest.5F44BF9A1DAE8B99.title: "&9Neptune Armor"
	quest.6149E5F1F9CF8DC6.quest_desc: ["Phyg! (Czy to nadal wymawia się jak pig?). \\n\\nKiedy świnie zaczną latać? Właśnie teraz! Świnie dostały skrzydła. Szybują więc jak kurczaki, by uniknąć obrażeń od upadku. \\n\\nMają 5 serc, a po śmierci upuszczają Raw Porkchops i Feathers."]
	quest.6149E5F1F9CF8DC6.title: "&dPhyg"
	quest.6188A57F52F29D33.quest_desc: ["Grałeś kiedyś w Terrarię? Pamiętasz Life Crystals? Te działają bardzo podobnie. \\n\\nGdy użyjesz &cLife Shard&r, zyskasz dodatkowe &4serce&r! \\n\\nNie wiem, jaki jest maksymalny limit &4serc&r... daj mi znać, jak się dowiesz!"]
	quest.6188A57F52F29D33.title: "&cLife Shard"
	quest.63D4621C06BA747C.quest_desc: ["Te same obrażenia co drewniane bronie, ale &2Skyroot&r daje podwójną zdobycz. \\n\\n&2Skyroot Sword&r daje dwa razy więcej łupów z mobów, a &2Skyroot Axe&r daje dwa razy więcej kłód z &2drzew&r."]
	quest.63D4621C06BA747C.title: "Bronie &2Skyroot&r"
	quest.6797E67E0136D96A.quest_desc: ["&7Holystone&r jest wszędzie. To kamień z &e&lThe Aether&r. \\n\\nDo jego wydobycia potrzebujesz kilofa, a możesz z niego tworzyć narzędzia lub bloki."]
	quest.6797E67E0136D96A.title: "&7Holystone"
	quest.6B3328B6AE8704D2.quest_desc: ["&bLightning Knives&r to rzucane pociski, które przywołują piorun wszędzie tam, gdzie trafią! \\n\\nPo rzucie jednak znikają, więc używaj ich mądrze."]
	quest.6B3328B6AE8704D2.title: "&bLightning Knife"
	quest.6C8766679D0AA8F6.quest_desc: ["Ta broń zabija świnie, Piglins i Zombified Piglins jednym ciosem. \\n\\nHoglins i Zoglins - dwoma. \\n\\nPiglin Brutes - trzema."]
	quest.6C8766679D0AA8F6.title: "&dPig Slayer"
	quest.6D2425DAEA1FC211.quest_desc: ["&cSun Altar&r potrafi zmienić porę dnia w &e&lThe Aether&r. \\n\\nTak, mimo że w &l&eThe Aether&r nie ma cyklu dnia i nocy, ten mały blok potrafi to zmienić. \\n\\nWystarczy przewinąć do wybranej pory! \\n\\nJeśli ustawisz noc, możesz użyć łóżka w &l&eThe Aether&r, aby ustawić punkt odrodzenia."]
	quest.6D2425DAEA1FC211.title: "&cSun Altar"
	quest.705AEEDA95C52C99.quest_desc: ["&b&lFreezer&r robi dokładnie to, co sugeruje nazwa: &bzamraża&r niektóre rzeczy. \\n\\n&9Wodę &fw &bIce&f, &bIce &fw &bPacked Ice&f, &bPacked Ice &fw &9Blue Ice&r, a &cLawę &fw &5Obsidian&r. \\n\\nSą też Ice Rings i Pendants! \\n\\n&b&lFreezer&r jako paliwa używa Icestone."]
	quest.705AEEDA95C52C99.title: "&b&lFreezer"
	quest.714960DF26EFFA53.quest_desc: ["Wszystkie &5Tools&r wydobywają bloki szybciej, gdy tracą wytrzymałość. \\n\\nPonadto &5Pickaxe&r potrafi wydobyć &dGravitite&r."]
	quest.714960DF26EFFA53.title: "Narzędzia &5Zanite&r"
	quest.72133DD1B3237493.quest_desc: ["&4Vampire Blade&r ma kradzież życia. \\n\\nGdy zadajesz obrażenia, w zamian odzyskujesz trochę &4serc&r!"]
	quest.72133DD1B3237493.title: "&4Vampire Blade"
	quest.7597D3D06E761759.quest_desc: ["&eValkyrie Lance&r to broń do walki w zwarciu z ogromnym zasięgiem! \\n\\n10 bloków!"]
	quest.7597D3D06E761759.title: "&eValkyrie Lance"
	quest.75C5BFAEADEB486E.quest_desc: ["&eValkyrie Armor&r ma takie same statystyki jak &cnetherytowa zbroja&r. \\n\\nZabawa zaczyna się, gdy założysz ją całą naraz: hełm, napierśnik, nogawice, buty i rękawice. \\n\\nGdy nosisz wszystkie 5 części, możesz przytrzymać spację, aby latać! Ale tylko przez krótką chwilę."]
	quest.75C5BFAEADEB486E.title: "&eValkyrie Armor"
	quest.765F6A5A9779CF6D.quest_desc: ["Aerclouds pojawiają się w całym &l&eThe Aether&r. W końcu to wymiar na niebie, więc można się było tego spodziewać. \\n\\nCold Aerclouds i &eGolden Aerclouds&r działają tak samo. Zapadasz się w nie lekko. Trochę jak w &6miód&r, tylko mniej lepkie. Pochłaniają też obrażenia od upadku. \\n\\n&bBlue Aerclouds&r są inne. Jeśli odbijesz się od nich, zostaniesz wystrzelony wysoko w niebo. Gdy się skradasz, przepadniesz przez nie na wylot. \\n\\nAerclouds możesz podnieść w dowolnym miejscu. Możesz też &5zaklinać&r Cold Aerclouds, aby uzyskać &eGolden Aerclouds&r, lub &bzamrażać&r Cold Aerclouds, aby uzyskać &bBlue Aerclouds&r."]
	quest.765F6A5A9779CF6D.title: "Aerclouds"
	quest.769B23E692CBA16B.quest_desc: ["Działają jak zwykłe wiadra i łodzie. \\n\\nTylko z &l&eThe Aether&r!"]
	quest.769B23E692CBA16B.title: "&2Skyroot&r Boat i Bucket"
	quest.78AAFE5AF04A13AC.quest_desc: ["&bAerbunnys&r skaczą po powietrzu. Gdybyś mógł, też byś tak robił! \\n\\nSą pasywne i mają tylko 3 &4serca&r. \\n\\nJeśli jesteś na tyle zły, by któregoś zabić, upuści String."]
	quest.78AAFE5AF04A13AC.title: "&bAerbunny"
	quest.78BD3D4FBA42D3DC.quest_desc: ["Sheepuffs to zabawne małe zwierzęta spotykane w The Aether. \\n\\nWyglądają jak zwykłe owce, ale czasem losowo podskakują w powietrze i powoli opadają. Nie wiem dlaczego, może dla zabawy! \\n\\nCzasami Sheepuffs nadymają się dodatkową wełną i można je ostrzyc dwa razy z rzędu! \\n\\nMają 4 serca i upuszczają Raw Mutton i Wool."]
	quest.78BD3D4FBA42D3DC.title: "Sheepuff"
	quest.79A1A63BCE7A541B.quest_desc: ["&bInvisibility Cloak&r sprawi, że staniesz się niewidzialny. Zupełnie jak sugeruje nazwa i popkultura! \\n\\nMoby Cię nie zobaczą, gdy jesteś niewidzialny, chyba że podejdziesz zbyt blisko lub je uderzysz."]
	quest.79A1A63BCE7A541B.title: "&bInvisibility Cloak"
	quest.7A4B51313FB134EA.quest_desc: ["&6Phoenix Armor&r daje łącznie 20 punktów pancerza i 8 wytrzymałości, tak samo jak &cNetherite&r. \\n\\nTylko że &6Phoenix Armor&r naprawdę zapewnia Fire Protection: gdy ją nosisz, nie otrzymasz obrażeń od &cOgnia &fani &cLawy&r! \\n\\nUważaj, wchodząc w niej do &9Wody&r, bo możesz skończyć z..."]
	quest.7A4B51313FB134EA.title: "&6Phoenix Armor"
	quest.7AD4ED72AC31D912.quest_desc: ["&3Aerwhales&r to ogromne, szybkie, latające i pasywne moby z &l&eThe Aether&r. \\n\\nNiczego nie upuszczają po śmierci, są po prostu ładne."]
	quest.7AD4ED72AC31D912.title: "&3Aerwhale"
	quest.7BFB4DA68A7912E5.quest_desc: ["Ambrosium to węgiel z &e&lThe Aether&r. \\n\\nMożemy z niego robić pochodnie albo używać go jako paliwa do pieca! \\n\\nMożesz też użyć go na Aether Grass, aby ją ulepszyć."]
	quest.7BFB4DA68A7912E5.title: "&eAmbrosium"
	quest.7D7BB45D84A4E94A.quest_desc: ["Gdy nosisz &3Swet Cape&r, &9Swets&r stają się przyjazne! \\n\\nZamiast Cię chwytać, możesz bezpiecznie na nich jeździć. \\n\\nOtrzymują dużo mniejsze obrażenia od upadku, gdy nie próbują Cię zabić."]
	quest.7D7BB45D84A4E94A.title: "&3Swet Cape"
	task.079FEE70B6D6944F.title: "Narzędzia Gravitite"
