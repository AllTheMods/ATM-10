	quest.31ED0C236C41A837.quest_subtitle: "Podaj Lava Bucket pszczole Magmatic Bee"
	quest.31ED0C236C41A837.title: "Lava Bee"
	quest.32FDC5FFA000DAF8.quest_desc: ["Jesteś dumny ze swoich pszczół?\\n\\nChcesz je włożyć do słoika, żeby się pochwalić?\\n\\nPostaw Bee Jar i użyj Pipe albo Hopper, aby wsunąć pszczołę w klatce do słoika."]
	quest.32FDC5FFA000DAF8.quest_subtitle: "Pokazujemy pszczoły"
	quest.33422FBDAE11AE82.quest_subtitle: "Podaj Fluix Pearl pszczole Spatial Bee"
	quest.33422FBDAE11AE82.title: "Fluix Bee"
	quest.33A0E06FE5CFD8F3.quest_desc: ["&9Centrifuge&r służy do przetwarzania Combs od pszczół na przydatne przedmioty i miód! Na początku śmiało możesz używać zwykłej &9Centrifuge&r, ale wkrótce po tym zdobycie &6Powered Centrifuge&r to konieczność. To szybsza Centrifuge zasilana energią!\\n\\nJeśli szukasz najlepszego sposobu przetwarzania Combs, &cHeated Centrifuge&r jest jeszcze szybsza i przetwarza &aComb Blocks&r zamiast Combs!\\n\\nWszystkie można przyspieszyć za pomocą Speed Upgrades."]
	quest.33A0E06FE5CFD8F3.quest_subtitle: "Przetwarzanie Honeycombs"
