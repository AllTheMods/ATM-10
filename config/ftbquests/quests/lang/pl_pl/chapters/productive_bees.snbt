	quest.419DD6FE84B91749.quest_desc: ["Podczas zbierania genów otrzymasz procent danej cechy. Możesz połączyć je w stole rzemieślniczym, aby je zsumować, albo umieścić w Gene Indexer, aby połączyły się automatycznie."]
