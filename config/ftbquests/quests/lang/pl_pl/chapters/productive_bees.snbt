	quest.6F978C4D561F35EC.quest_desc: [
		"Bottler ma dwa zastosowania: butelkowanie miodu i zgniatanie pszczół w celu zdobycia genów.\\n\\nAby zdobyć geny z pszczół, umieść tłok nad Bottler, zostawiając między nimi jeden blok wolnego miejsca.\\n\\nPołóż pszczołę na Bottler i uruchom tłok, aby zgnieść ją na geny. Powstałą zgniecioną butelkę można następnie umieścić w Centrifuge.\\n\\nUwaga: upewnij się, że w Bottler są butelki."
		"{image:atm:textures/questpics/bees/bottler.png width:100 height:150 align:1}"
	]
