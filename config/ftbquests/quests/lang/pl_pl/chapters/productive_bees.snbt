	quest.4FE7F45C72EF5DC1.title: "Nickel Bee"
	quest.500BEAD94C97DF96.quest_desc: ["Można umieścić w ulu lub w Centrifuge.\\n\\nW ulu skraca czas, jaki pszczoły spędzają w ulu, o 20%.\\n\\nW Centrifuge zwiększa szybkość przetwarzania.\\n\\nEfekty się kumulują."]
	quest.500BEAD94C97DF96.quest_subtitle: "Sonic Bees"
