{
	quest.062AA943A1629A86.quest_desc: ["Wysadziłeś &zRainbow Furnace&r?!?! Po prostu odpaliłeś TNT tuż obok? Oszalałeś? Tyle pieców i zasobów poszło na to, a Ty to wysadziłeś!!! Czy chociaż dostałeś coś porządnego? &zRainbow Coal&r? Węgiel, który starcza na bardzo długo? No dobra, to faktycznie jest tego warte."]
	quest.062AA943A1629A86.title: "&zRainbow Coal"
	quest.076A648E3E3245C9.quest_desc: ["Bardzo szybkie tempo wytwarzania energii z paliwa, przez co jest bardzo wydajny. Jedyny problem: nie da się go już ulepszać. Nadal używa zwykłego Furnace Fuel."]
	quest.076A648E3E3245C9.title: "&aEmerald Generator"
	quest.07753C5D94312A50.quest_desc: [
		"&3Augment&r: Generator jest przeciwieństwem &3Augment&r: Factory - zamiast używać energii do przetapiania, przetapia, aby wytworzyć energię. Nie przetopisz w nim już żadnych przedmiotów, każda jednostka paliwa zostanie zamieniona w energię!"
		""
		"(Zastanawiam się, czy lepiej połączyć Generator i Factory Furnaces, zamiast po prostu używać paliwa w jednym)"
	]
	quest.07753C5D94312A50.title: "&3Augment&r: Generator"
	quest.07BEB974DF1E5AD3.quest_desc: ["Wytwarza energię w tym samym tempie co &aEmerald Generator&r, ale ma znacznie większą szybkość przesyłu. Można też uznać, że jest tańszy, bo wymaga mniej przedmiotów, tyle że tym przedmiotem jest &5Netherite&r, więc..."]
	quest.07BEB974DF1E5AD3.title: "&5Netherite Generator"
	quest.0AD2B11565B484E7.quest_desc: ["Potrzebujesz do tego każdego pieca sprzed &5Netherite&r. Tak, wszystkich, nawet &6Copper&r! Nawet &7Silver&r! Nawet &3Crystal&r!"]
	quest.0AD2B11565B484E7.title: "&zRainbow Plating"
	quest.0ADBE90B33ACC9FB.quest_desc: ["&zRainbow Generator&r wzmacnia &zRainbow Furnace&r, gdy ten używa &3Augment&r: Generator. Jeśli wszystkie pozostałe 9 pieców (nie licząc AllTheModium Furnace i wyższych) znajduje się wokół &zRainbow Furnace&r, ma &3Augment&r: Generator i aktywnie wytwarza energię (ma paliwo i nie jest pełny), to dadzą one premię &zRainbow Furnace&r, który ma &3Augment&r: Generator i pracuje. Będzie wytwarzał o 2k FE na tick więcej!"]
	quest.0ADBE90B33ACC9FB.title: "&zRainbow Generator"
	quest.1843C79133DFB024.quest_desc: ["Najpotężniejszy i najwydajniejszy generator, Netherstar Generator. Zgadnij, z czego wytwarza energię!"]
	quest.1C73E60FC70408D4.quest_desc: ["Wreszcie wyjątkowy generator! Culinary to nazwa sztuki kulinarnej. Te generatory nie biorą węgla, lawy ani nawet kłód, tylko jedzenie. Można użyć wszystkiego, co ma punkty głodu, a ilość wytworzonej energii zależy od liczby punktów głodu, jakie daje dane jedzenie. Steak da więcej energii niż Carrot."]
	quest.20EC8001A05CE2C8.quest_desc: ["Wireless Heat to fajny i prosty sposób zasilania pieców. Najpierw postaw Wireless Heat Transmitter i włóż do niego energię. Potem włóż Receiver do Transmitter, aby je ze sobą powiązać. Na końcu włóż Receiver do miejsca na paliwo w piecu, aby zacząć go zasilać!"]
	quest.21EA29A8C7F950CE.quest_desc: ["&bDiamonds&r - podstawa &2Minecrafta&r, a najwyraźniej także ulepszonych pieców...\\n \\nTe działają jeszcze szybciej - przetopienie przedmiotów zajmuje tylko 80 ticków, czyli 4 sekundy. To nawet szybciej niż Blast Furnace! \\n \\nWytwarza się je tylko z &eGold Furnace&r, a można z nich wytworzyć &3Crystal&r lub &aEmerald Furnace&r."]
	quest.21EA29A8C7F950CE.title: "&bDiamond Furnace"
	quest.2354BC5330350DF6.quest_desc: ["Jeśli &aSmaragdy&r nie są dla Ciebie, może spodoba Ci się &3Crystal Furnace&r! \\n \\nDziała tak samo jak &aEmerald Furnace&r, czyli 40 ticków. \\n \\nWytwarza się go z &bDiamond Furnace&r, a można z niego wytworzyć &dObsidian Furnace&r. \\n \\n(Nie, nie zobaczysz przetapianych w nim przedmiotów, po prostu jest przezroczysty)"]
	quest.2354BC5330350DF6.title: "&3Crystal Furnace"
	quest.25080E3295B1DF01.quest_desc: ["&5Unobtainium Furnace&r przetapia przedmioty szybciej niż jakikolwiek inny piec w paczce!"]
	quest.25080E3295B1DF01.title: "&5Unobtainium Furnace"
	quest.25A3E30F722B38B6.quest_desc: ["Dlaczego dziwisz się, że &ezłoto&r faktycznie jest używane w modach? Widziałeś je w prawdziwym życiu, ma mnóstwo zastosowań! Poza tym otwiera drogę do kolejnych wyjątkowych generatorów, które nie biorą samego paliwa do pieców!"]
	quest.25A3E30F722B38B6.title: "&eGold Generator"
	quest.2748ACEAB96A5F60.quest_desc: ["Iron Furnaces (nie myl tego - każdy tytuł z &lIron Furnaces&r to nazwa moda i nazwa przedmiotu) działają szybciej niż zwykłe i Copper Furnaces. Pracują 160 ticków, czyli 8 sekund.\\n\\nMożna je wytworzyć ze zwykłego pieca albo &6Copper Furnace&r! A z nich można wytworzyć &7Silver Furnace&r lub &eGold Furnace&r."]
	quest.2748ACEAB96A5F60.title: "&fIron Furnace"
	quest.28FEB4C11AD1AE7C.quest_desc: ["&bDiamonds&r są zwykle drogie... w vanilli, ale tu jest modowana gra, więc wystarczy ich na co najmniej 1 &bDiamond Generator&r. Nadal używa zwykłego paliwa do pieców."]
	quest.28FEB4C11AD1AE7C.title: "&bDiamond Generator"
	quest.2E85D6E2CFCC356E.quest_desc: ["&3Vibranium Furnace&r jest nawet lepszy niż &6Allthemodium Furnace&r!"]
	quest.2E85D6E2CFCC356E.title: "&3Vibranium Furnace"
	quest.2EE8FCB63A338BC4.quest_desc: [
		"&zRainbow Furnace&r do wytworzenia potrzebuje dosłownie każdego innego pieca. 8 &zRainbow Plating&r i 1 &zRainbow Core&r dają nam najlepszy piec, jaki możemy sobie wyobrazić!"
		""
		"Tak, przetapianie zajmuje 20 ticków, czyli 1 sekundę, ale nie przetapia 1 przedmiotu. Ile przedmiotów, pytasz? Ile mieści się w stosie przedmiotów?"
	]
	quest.2EE8FCB63A338BC4.title: "&zRainbow Furnace"
	quest.311F43D48B9C26FF.quest_desc: ["&dObsidian Generator&r jest wolniejszy niż &aEmerald&r i &5Netherite Generator&r, ale ma więcej ulepszeń niż wszystkie one razem wzięte!"]
	quest.311F43D48B9C26FF.title: "&dObsidian Generator"
	quest.32C7D8AE859BF89E.quest_desc: [
		"Może i jest z &dObsidianu&r, ale spokojnie - &bDiamond Pickaxe&r nie jest potrzebny, żeby go podnieść, tylko żeby go wytworzyć."
		""
		"Działa co 20 ticków, czyli co sekundę. Tak, nie co sekundy, tylko co sekundę."
		""
		"Można go wytworzyć z &3Crystal Furnace&r lub &aEmerald Furnace&r, a z niego można wytworzyć &5Netherite Furnace&r!"
	]
	quest.32C7D8AE859BF89E.title: "&dObsidian Furnace"
	quest.33436ED0D9F128BD.quest_desc: ["&4Augment&r: Smoking zmienia Twój Iron Furnace w Iron Smoker. Teraz będzie wędzić tylko jedzenie, ale dwa razy szybciej! Tak jak &4Augment&r: Blasting, ten również kumuluje się z innymi ulepszeniami!"]
	quest.33436ED0D9F128BD.title: "&4Augment&r: Smoking"
	quest.39605F1FEB1A5A1C.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.39605F1FEB1A5A1C.title: "AllRightsReserved"
	quest.3A4C17878FC8315B.quest_desc: ["&6Allthemodium Furnace&r jest w zasadzie taki sam jak Netherite Furnace. Będziesz go potrzebował, aby wytworzyć &3Vibranium Furnace&r."]
	quest.3A4C17878FC8315B.title: "&6Allthemodium Furnace"
	quest.40DB6E3DE87F16EF.quest_desc: [
		"&dDragon's Breath&r to potężny, (śmierdzący) i tajemniczy przedmiot. Potężny, czyli możemy z niego wytworzyć energię, i to dużo! &5Halitosis Generator&r wytwarza energię z &dDragon's Breath&r!"
		""
		"(Przy okazji, &dDragon's Breath&r możesz farmić za pomocą Extractora z XyCraft z Dragon's Head)."
	]
	quest.40DB6E3DE87F16EF.title: "&5Halitosis Generator"
	quest.420FE84DEE12CCE0.quest_desc: ["&eGold Furnace&r jest lepszy od Iron Furnaces, z czasem pracy 120 ticków.\\n\\nMożna go wytworzyć z &7Silver Furnace&r lub Iron Furnace, a z niego wytwarza się &bDiamond Furnace&r!"]
	quest.420FE84DEE12CCE0.title: "&eGolden Furnace"
	quest.47750F3CB020104C.quest_desc: ["&lGenerator's Galore&r i &lIron Furnaces&r to dwa różne, ale też podobne mody. Oba zaczynają się od legendarnego pieca!"]
	quest.47750F3CB020104C.quest_subtitle: "Wszystko zaczyna się tutaj"
	quest.47750F3CB020104C.title: "Piec"
	quest.49F08DE190AAD0D8.quest_desc: ["&3Augment&r: Factory sprawia, że Twój piec bardziej przypomina Smelting Factory z Mekanism. Zamiast paliwa będzie teraz używał energii! Doprowadź rurami trochę energii, a zacznie przetapiać."]
	quest.49F08DE190AAD0D8.title: "&3Augment&r: Factory"
	quest.538821E23E39BE97.quest_desc: ["&2Augment&r: Fuel Efficiency jest dla wszystkich miłośników natury, tulących drzewa, wielbicieli Kapitana Planety i hipisów. Piec zużywa o połowę mniej paliwa kosztem połowy czasu. Węgiel nie przetopi 8 przedmiotów, lecz 16!"]
	quest.538821E23E39BE97.title: "&2Augment&r: Fuel Efficiency"
	quest.552CA2ABE659A507.quest_desc: ["&cLawa&r wchodzi. Energia wychodzi."]
	quest.552CA2ABE659A507.title: "&cMagmatic Generator"
	quest.553220A2CD7CAFE4.quest_desc: ["W Boże Narodzenie wszystkie skrzynie wyglądają jak prezenty... ale piece po prostu rzucają się w oczy! Teraz można to zmienić za pomocą Wrapping Paper! Możesz kliknąć nim prawym przyciskiem myszy dowolny &lIron Furnace&r i będzie gotowy na święta! A po sezonie możesz kliknąć prawym przyciskiem myszy z Shiftem, aby go rozpakować!"]
	quest.553220A2CD7CAFE4.quest_subtitle: "Wszystko zapakowane"
	quest.61847F47CCA225D9.quest_desc: ["Zgodnie z tym samym schematem, te przetapiają w 140 ticków, czyli 7 sekund.\\n\\nMożna je wytworzyć z &6Copper Furnace&r lub Iron Furnace i użyć do wytworzenia &eGold Furnace&r."]
	quest.61847F47CCA225D9.title: "Silver Furnace"
	quest.618F1434757C8E69.quest_desc: ["&lGenerator's Galore&r dodaje bardzo proste generatory. Te najprostsze działają jak piece z &3Augment&r: Generator. Biorą paliwo i zamieniają je w energię! \\n \\nTak, musisz zacząć od &6Copper Generator&r."]
	quest.618F1434757C8E69.title: "&6Copper Generator&r"
	quest.61F265D9A5713A4D.quest_desc: ["Każde ulepszenie ulepsza wszystko - od ilości wytwarzanej energii, przez pojemność, po to, ile może przesyłać do innych bloków! \\n \\nPotrzebujesz &6Copper Generator&r, aby wytworzyć Iron Generator, przepraszam wszystkich, którzy nie lubią &6Copper&r."]
	quest.61F265D9A5713A4D.title: "&fIron Generator"
	quest.661C072E48F8D41F.quest_desc: [
		"&6Miedź&r to jedna z najpowszechniejszych rud, o ile nie najpowszechniejsza, więc czemu nie wykorzystać mnóstwa zbędnej &6miedzi&r do ulepszenia pieca!"
		""
		"Zwykłe piece przetapiają 1 przedmiot 200 ticków (20 ticków = 1 sekunda), a &6Copper Furnaces&r - 180 ticków."
		""
		"Można z nich wytworzyć &7Silver&r lub &fIron Furnaces&r."
	]
	quest.661C072E48F8D41F.title: "&6Copper Furnace"
	quest.686B25F2E9D8CC97.quest_desc: ["W chwili pisania tego tekstu jest koniec lipca, więc do Halloween zostały mi około 3 miesiące. Ale nigdy nie jest za wcześnie, żeby zacząć się straszyć! Tak jak Spirit Halloween, możemy zacząć straszyć 3 miesiące przed faktycznym początkiem. Tym razem klikając piec prawym przyciskiem myszy za pomocą Spook-alatora! Gdy trzeba będzie szykować się na Święto Dziękczynienia, kliknij je prawym przyciskiem myszy z Shiftem, aby je Un-Spook-Alate!"]
	quest.686B25F2E9D8CC97.quest_subtitle: "\"This is Halloween\""
	quest.68972BA647FDCF8F.quest_desc: ["Jeśli znasz &l&6Productive Bees&r, powinieneś znać LobsterJonna. Stworzył &l&6Productive Bees&r i &lGenerator's Galore&r (oraz wiele innych). &6Honey Generator&r to dobry sposób na połączenie tych dwóch modów! &6Honey Generator&r używa &6Liquid Honey&r do wytwarzania energii. "]
	quest.68972BA647FDCF8F.title: "&6Honey Generator"
	quest.69201157ECFBB426.quest_desc: ["Zawsze mnie irytuje, gdy mam farmę &5Endermanów&r na XP lub Apotheosis Gems, a kończę z całą masą &3Ender Pearls&r (hehe, kończę, &3Ender Pearls&r). Teraz możesz użyć tych &3Ender Pearls&r do wytwarzania energii za pomocą &3Ender Generator&r. Możesz nawet zrobić &aEyes of Ender&r, żeby mieć jeszcze więcej energii!"]
	quest.69201157ECFBB426.title: "&3Ender Generator"
	quest.6A1145678E80FB8E.quest_desc: ["Jest mnóstwo bezużytecznych &5zaklęć&r, więc czemu nie wyciągnąć z nich trochę energii! &bEnchantment Generator&r używa &5Enchanted Books&r do wytwarzania energii. Poziom i rzadkość &5Enchanted Books&r zmieniają ilość energii, jaką z nich dostaniesz."]
	quest.6A1145678E80FB8E.title: "&bEnchantment Generator"
	quest.711DDD55CEC439E5.quest_desc: ["&aEmerald Furnace&r - ciekawe, czy Villagers będą nim handlować? \\n \\nPracuje w 40 ticków, czyli tylko 2 sekundy na przetopienie! Mrugnij, a możesz to przegapić. \\n \\nWytwarza się go z &bDiamond Furnace&r, a można z niego wytworzyć &dObsidian Furnace&r."]
	quest.711DDD55CEC439E5.title: "&aEmerald Furnace"
	quest.7297391D026EE9A6.quest_desc: ["Chcesz czegoś ekscytującego i nowego do wytwarzania energii? A może &dmikstury&r! Właśnie to robi &dPotion Generator&r - weźmie Twoje &dmikstury&r i wytworzy z nich energię w zależności od ich mocy i czasu trwania."]
	quest.7297391D026EE9A6.title: "&dPotion Generator"
	quest.72A287DCAEEFE49F.quest_desc: [
		"Wytworzenie 8 takich samych generatorów 8x razem z Conduit łączy je w 1 ogromny generator! Działa tak samo jak 64 zwykłe generatory, ale zajmuje miejsce tylko 1."
		""
		"64x Magmatic Generator jest potrzebny do wytworzenia ATM Star."
	]
	quest.73FF01D830A669AA.quest_desc: ["&4Augment&r: Blasting zmienia Twój Iron Furnace w Iron Blast Furnace! Teraz będzie przetapiać tylko rudy, ale dwa razy szybciej! Tak, kumuluje się to z efektami innych przedmiotów Augment i różnych poziomów pieców."]
	quest.73FF01D830A669AA.title: "&4Augment&r: Blasting"
	quest.757B14D08A9A03C4.quest_desc: [" Jak większość modowanych maszyn, Iron Furnaces mają konfigurację. Konfigurację znajdziesz, klikając lewy górny róg. Są tam wejścia, wyjścia i aktywacja redstone. Aktywacja redstone zmienia moment, w którym piec będzie przetapiał. Górne przyciski określają, czy wejście lub wyjście działa automatycznie, czyli czy przedmioty będą same przenoszone do podłączonych ekwipunków i z nich. Pola to poszczególne strony pieca i określają, czy jest tam wejście, wyjście, jedno i drugie, wejście paliwa, czy nic. Ma to znaczenie przy przesyłaniu przedmiotów rurami do środka lub na zewnątrz. Furnace Settings Linker skopiuje wszystkie te ustawienia do innych pieców!"]
	quest.757B14D08A9A03C4.title: "Konfiguracja"
	quest.78D1C97A542133D8.quest_desc: [
		"Przedmioty Augment to ulepszenia do Iron Furnace!"
		""
		"W prawym górnym rogu GUI pieca znajduje się przycisk do sekcji przedmiotów Augment. Są tam czerwone, zielone i niebieskie miejsce, a każde może pomieścić 1 Augment swojego koloru. "
	]
	quest.78D1C97A542133D8.title: "&lAugments"
	quest.79C4CF8D7312FC28.quest_desc: ["Najlepsze z vanilli! &5Netherite&r! Spokojnie, nie potrzebujesz do tego Smithing Template, tylko całej masy &5Netherite&r. \\n \\nPrzetapia przedmiot co 5 ticków, czyli 4 przetopione przedmioty na sekundę. Tak, to już nie S.P.S. (sekundy na przetopienie), tylko S.P.S. (przetopienia na sekundę). \\n \\nWytwarza się go z &dObsidian Furnace&r... zaraz, to nie jest ostatni piec?"]
	quest.79C4CF8D7312FC28.title: "&5Netherite Furnace&r"
	quest.7A615E2A152917AD.quest_desc: ["Potrzebujesz do tego 2 &5Netherite Furnaces&r i 7 kawałków szkła w kolorach tęczy. &cCzerwone&r, &6pomarańczowe&r, &eżółte&r, &2zielone&r, &3niebieskie&r, &9indyg&r- &5fioletowe&r i &5Fio&r-&dmagenta&r. Tak! Cała tęcza!"]
	quest.7A615E2A152917AD.title: "&zRainbow Core"
	quest.7CE86300AF8E9BCA.quest_desc: ["Wytworzenie 8 takich samych generatorów razem z Echo Shard łączy je w 1 ogromny generator! Działa tak samo jak 8 zwykłych generatorów, ale zajmuje miejsce tylko 1."]
	quest.7CE86300AF8E9BCA.title: "8x Co za Okazja!"
	quest.7F67849DE9F700D8.quest_desc: ["&2Augment&r: Speed sprawia, że Twój piec jest szybszy! &bDiamond Furnace&r będzie przetapiał co 40 ticków zamiast co 80. Kosztem dwukrotnie większego zużycia paliwa."]
	quest.7F67849DE9F700D8.title: "&2Augment&r: Speed"
	task.31E6FDB712244B72.title: "64x Generatory"
	task.37641D5607F6D00A.title: "8x Generatory"
	task.38B6F45109CB033A.title: "AllRightsReserved"
	task.5DB7A437BEC3E2D4.title: "AllRightsReserved"
}
