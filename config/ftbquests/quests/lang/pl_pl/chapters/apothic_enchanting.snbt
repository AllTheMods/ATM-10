{
	quest.001A348054127235.quest_desc: ["&5Budding Amethyst&r przydaje się w recepturach, a nawet po prostu do hodowli &5Amethyst&r! \\n\\nMając &5Amethyst Block&r, &a60 Eterna&r, od &c30% &fdo &c50% Quanta&r i &550% Arcana&r, możesz przeprowadzić &d&linfuzję&r. \\n\\nAby uzyskać wszystkie te statystyki, użyj 10 &9Deepshelves&r (nie &9Dormant&r), 2 &2Melonshelves&r i 7 &7Basic Bookshelves&r.\\n\\nAlbo, jeśli wybrałeś &bSeashelves&r, użyj 11 &bCrystalline Seashelves&r i 1 &bInfused Seashelf&r."]
	quest.001A348054127235.title: "Tworzenie &5Budding Amethyst"
	quest.0518551637F76C50.quest_desc: ["Do ulepszenia &9Echoing&r potrzebujesz kilku różnych przedmiotów. \\n\\nCandles, które są stosunkowo łatwe do zdobycia! I &9Echo Shards&r... które zdecydowanie takie nie są... \\n\\nNajwiększą szansę na ich zdobycie daje plądrowanie &6Ancient City&r, ale możesz je wytworzyć za pomocą kilku różnych rytuałów. \\n\\n(Albo, w późniejszym etapie, nawet dzięki &5zaklinaniu&r!) \\n\\n&9Echoing Deepshelves&r dają o wiele więcej &5Arcana&r, bo aż &515%&r! Podnoszą też maksymalną &aEterna&r do &a75&r."]
	quest.0518551637F76C50.title: "&9Echoing Deepshelf"
	quest.06F70F6CA37168CC.quest_desc: ["&6&oGem Case of House Fabergé&r to ulepszony &5Gem Case&r. \\n\\nMieści większe ilości &aklejnotów&r.\\n\\n&5Gem Case&r mieści 32768, a &6&oGem Case of House Fabergé&r - aż 2,1 miliarda każdego unikalnego &aklejnotu&r! \\n\\nAby go zdobyć, musisz przeprowadzić &d&linfuzję&r &5Gem Case&r. \\n\\nUżyj 4 &9Soul-Touched Sculkshelves&f, 4 &9Echoing Sculkshelves&f, 2 &dDraconic Endshelves&f, 7 &7Stoneshelves&r i 1 &7Basic Bookshelf&r."]
	quest.06F70F6CA37168CC.quest_subtitle: "Gustav Fabergé byłby dumny"
	quest.06F70F6CA37168CC.title: "&6&oGem Case of House Fabergé"
	quest.091957223C32B094.quest_desc: ["Na tym etapie potrzebne jest kolejne podniesienie &aMax Eterna&r. Tym razem do &a60&r na &e&lAscent&r, czyli kolejnym &lWorld Tier&r."]
	quest.091957223C32B094.quest_subtitle: "Max Eterna do 60"
	quest.091957223C32B094.title: "Do 60 na &e&lAscent&r"
	quest.0A3C464EF7CDD5F6.quest_desc: [
		"&4Hellshelves&r to Twoje wprowadzenie do &cQuanta&r, dają &c3% Quanta&r i &a3 Eterna&r. \\n\\nLepsze niż zwykłe półki, prawda? \\n\\nPotrzebujesz ich 16 do następnego kroku: 15 &4Hellshelves&r wokół &5stołu do zaklinania&r i 1 w Twoim ekwipunku. \\n\\nZrób pierwsze 11, a ostatnie 5 &4Hellshelves&r dam Ci ja!"
		"{image:atm:textures/questpics/apothic/enchant_hellshelf.png width:100 height:100 align:center}"
	]
	quest.0A3C464EF7CDD5F6.title: "&4Hellshelves"
	quest.0F3A0A4DC18E5E55.quest_desc: ["&aEterna&r określa &5poziom zaklęcia&r, od którego zależy, jakie &5zaklęcia&r możesz zdobyć! \\n\\nDomyślnie wynosi &a0&r, a jej maksimum zależy od Twojego &lWorld Tier&r.\\n\\n&a30&r na &9&lHaven&r.\\n&a45&r na &2&lFrontier&r.\\n&a60&r na &e&lAscent&r.\\n&a75&r na &6&lSummit&r.\\n&a100&r na &4&lPinnacle&r.\\n\\nSprawdź rozdział Apotheosis Gear albo powiązane zadania w tym rozdziale, aby dowiedzieć się więcej o &lWorld Tierach&r!\\n\\nPrawie wszystkie &7biblioteczki&r dają &aEterna&r, ale każda ma własny limit, do którego może ją podnieść."]
	quest.0F3A0A4DC18E5E55.title: "&aEterna"
	quest.105442DA79829777.quest_desc: ["Mając 8 &7Books&r i Anvil, możesz wytworzyć &8Tome of Scrapping&r. No, właściwie 8 sztuk, ale rozumiesz, o co chodzi! \\n\\nŁącząc przedmiot z &8Tome&r na kowadle, możesz zdjąć z niego połowę &5zaklęć&r. \\n\\nPo wszystkim przedmiot się zniszczy i przepadnie. Nie polecam tego używać, lepiej go ulepsz!"]
	quest.105442DA79829777.quest_subtitle: "Połowa zaklęć, niszczy przedmiot"
	quest.105442DA79829777.title: "&8Tome of Scrapping"
	quest.1113BF457DB7F1DE.quest_desc: ["Ten nie jest wymagany do głównego postępu półek, ale jest niezbędny do niektórych &d&linfuzji&r.\\n\\nPrzedostatni &lWorld Tier&r, &6&lSummit&r, podnosi Twoją &aMax Eterna&r do &a75&r."]
	quest.1113BF457DB7F1DE.quest_subtitle: "Max Eterna do 75"
	quest.1113BF457DB7F1DE.title: "Aby Osiągnąć &6&lSummit"
	quest.148A33CC36B2563A.quest_desc: ["&dDraconic Shelf&r to ostatnia półka potrzebna do idealnego zestawu. \\n\\nDaje tylko &aEterna&r, ale ma maksymalną &aEterna&r równą &a100&r. \\n\\nAby ją wytworzyć, potrzebujesz 5 &3Ender Pearls&r i &dDragon Head&r. To właśnie dzięki niej jest &dDraconic&r! \\n\\nMożesz je zdobyć za pomocą &a&lMA&r albo znaleźć na &dEnd Ships&r. &dEnd Ships&r to struktury w wymiarze &d&lThe End&r, a na dziobie (z przodu) znajduje się &dDragon Head&r. "]
	quest.148A33CC36B2563A.title: "&dDraconic Endshelf"
	quest.158F872A3A2C3650.quest_desc: ["Skoro Twoja maksymalna &aEterna&r wynosi &a80&r, możesz zacząć &d&linfuzję&r &dDragon's Breath&r! \\n\\n&dDragon's Breath&r zdobędziesz, walcząc z &d&lEnder Dragonem&r. Gdy siedzi nad swoim gniazdem, może wystrzelić w Ciebie &dróżową&r mgłę. Będąc w niej, kliknij prawym przyciskiem myszy z pustą butelką, aby zdobyć &dDragon's Breath&r! \\n\\nNajlepszy sposób na uzyskanie potrzebnych poziomów to 4 &9Echoing Sculkshelves&r, 4 &9Soul-Touched Sculkshelves&r i 6 &6Geode-Encased Bookshelves of Stability&r. \\n\\nDadzą Ci &a80 Eterna&r, &c25% Quanta&r i &5100% Arcana&r. Idealne do &d&linfuzji&r!"]
	quest.158F872A3A2C3650.title: "&dInfused Dragon's Breath"
	quest.1617C1935F22FBD1.quest_desc: ["Skoro Twoja maksymalna &aEterna&r wynosi &a100&r, możesz zacząć &d&linfuzję&r &6Godforged Pearls&r!\\n\\n&6Godforged Pearls&r zdobędziesz, rozbierając &eprzedmioty&r rzadkości &6Mythic&r w &c&lSalvaging Table&r.\\n\\nPotrzebujesz &a100 Eterna&r, &c9,65-11,00% Quanta&r i &558,75-60,0% Arcana&r.\\n\\nOsiągniesz to z 1 &dDraconic Endshelf&r, 6 &6Geode-Encased Bookshelves of Stability&r, 1 &9Echoing Sculkshelf&r, 5 &9Soul-Touched Sculkshelves&r, 1 &7Stoneshelf&r i 1 Candle."]
	quest.1617C1935F22FBD1.quest_subtitle: "W tym tempie zainfuzujesz WSZYSTKO"
	quest.1617C1935F22FBD1.title: "&6God-Fused Pearl"
	quest.1873205CF5247E3E.quest_desc: [
		"Ostatnie i największe z &7Bookshelves&r - &dEndshelves&r! \\n\\nWytwarza się je z 6 &eEndstone Bricks&r, 1 &3Ender Pearl&r, 1 &7Bookshelf&r i oczywiście &dInfused Dragon's Breath&r. \\n\\nIch statystyki nie są obecnie najlepsze, każda daje tylko po 5. Za to maksymalna &aEterna&r wynosząca &a90&r jest niesamowita! \\n\\nAha, i można je wytwarzać z innymi przedmiotami, aby je ulepszać!"
		"{image:atm:textures/questpics/apothic/enchant_endshelf.png width:100 height:100 align:center}"
	]
	quest.1873205CF5247E3E.title: "&dEndshelves"
	quest.18AA64DF63F68762.quest_desc: ["To powinna być ostatnia bramka w tym rozdziale"]
	quest.18AA64DF63F68762.title: "Kolejna Bramka"
	quest.191A7F3C9FBA4C13.quest_desc: ["Możesz wytworzyć &bInfused Seashelves&r z &bPrismarine Crystals&r, aby uzyskać &bCrystalline Seashelves&r. \\n\\n&bCrystalline Seashelves&r zachowują te same &a5 Eterna&r i &55% Arcana&r, a dodatkowo dają &c3% Quanta&r. \\n\\nMając 12 z nich, uzyskasz dość poziomów, aby przeprowadzić &d&linfuzję&r &9Dormant Deepshelves&r i zamienić je w zwykłe &9Deepshelves&r!"]
	quest.191A7F3C9FBA4C13.title: "&bCrystalline Seashelf"
	quest.1F748ACA3976A92F.quest_desc: ["Ta bramka istnieje tylko po to, by umożliwić podążanie ścieżką Seashelf lub Hellshelf, a jednocześnie wymusić wykonanie zadania World Tier Frontier z rozdziału Apotheosis Gear."]
	quest.1F748ACA3976A92F.title: "Bramka"
	quest.1FAFDB20F504688E.quest_desc: ["&5Zaklinanie&r zmienia się trochę wraz z &5&lApotheosis&r. \\n\\nKrótko mówiąc, 15 &7biblioteczek&r już nie wystarczy. \\n\\nPojawiły się nowe biblioteczki i nowe działania, które możesz wykonywać na &5stołach do zaklinania&r, a mam nadzieję, że te zadania pomogą Ci to zrozumieć."]
	quest.1FAFDB20F504688E.title: "&5&lApothic Enchanting"
	quest.224716A537F2FFA0.quest_desc: ["&8Armor Tomes&r służą do zdobywania &5zaklęć&r, które można nakładać wyłącznie na zbroje. Wszystkie &8Tomes&r mogą dać &5Protection&f, &5Blast Protection&f i &5Fire Protection&r. \\n\\nKażdy daje też zaklęcia zarezerwowane dla określonej części zbroi. Buty dają &5Depth Strider&r, a hełmy &5Aqua Affinity&r. \\n\\nJeśli chcesz mieć największą szansę na samą &5Protection&r, spróbuj &8Chestplate Tome&r!"]
	quest.224716A537F2FFA0.title: "&8Księgi Zbroi"
	quest.235E3C386E8D36A3.quest_desc: [
		"Tu kończy się rozdzielenie ścieżek &4Hellshelves&r i &bSeashelves&r! \\n\\nNajpierw musisz wytworzyć &9Dormant Deepshelf&r. To po prostu 6 &8Cracked Deepslate Tiles&r i 3 &7Books&r. \\n\\nPotem potrzebujesz &a60 Eterna&r, &c40% Quanta&r i &540% Arcana&r. Uzyskasz to z 12 &bCrystalline Seashelves&r lub 13 &4Glowing Hellshelves&r! \\n\\nNa koniec możesz przeprowadzić &d&linfuzję&r swoich &9Dormant Deepshelves&r, aby zamienić je w zwykłe &9Deepshelves&r!"
		"{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"
	]
	quest.235E3C386E8D36A3.title: "&9Deepshelf"
	quest.24391162F4FF0587.quest_desc: ["Mając 15 &bSeashelves&r wokół &5Enchanting Table&r, możesz przeprowadzić &d&linfuzję&r swojej ostatniej &bSeashelf&r! \\n\\n&bInfused Seashelves&r dają więcej &aEterna&r - 5, z maksimum &a60&r. Dają też więcej &5Arcana&r, bo &55%&r. \\n\\nMożna je przerobić na różne &7Bookshelves&r, a ta, której szukasz do &6maksymalnego zaklinania&r, to &bCrystalline Seashelf&r. \\n\\nPotrzebujesz 12 takich, więc potrzebujesz 12 &bInfused Seashelves&r. Wytwórz 8, a resztę dostaniesz ode mnie w nagrodę!"]
	quest.24391162F4FF0587.title: "&bInfused Seashelf"
	quest.24C757B8AA6841F6.quest_desc: ["&5&lApotheosis&r wie, jak irytujące bywa zdobywanie &3Tridentów&r, więc to ułatwił... no, przynajmniej trochę! \\n\\nMożesz teraz wytworzyć &3Inert Trident&r i przeprowadzić jego &d&linfuzję&r, aby otrzymać zwykły &3Trident&r. \\n\\n&3Trident&r wymaga od &a40 Eterna&r, &c20%-50% Quanta&r i co najmniej &535% Arcana&r. \\n\\nOsiągniesz to z 5 &7Basic Bookshelves&r i 3 &9Echoing Sculkshelves&r.\\n\\nAlbo, jeśli naprawdę chcesz mieć &3Trident&r na &2&lFrontier&r, możesz to uzyskać też z 2 &bCrystalline Seashelves&r i 4 &bInfused Seashelves&r."]
	quest.24C757B8AA6841F6.title: "Tworzenie Prawdziwego &3Trident"
	quest.24FCFF18296ED907.quest_desc: ["Aby jeszcze bardziej ulepszyć &9Deepshelves&r, o dziwo nie potrzebujesz &d&linfuzji&r! Zamiast tego potrzeba więcej wytwarzania! \\n\\nNa początek 5 &3Sculk Blocks&r i &3Sculk Catalyst&r. Oba znajdziesz w &9Deep Dark&r, a do ich zebrania potrzebny jest &5Silk Touch&r. \\n\\nNa końcu &9Warden Tendril&r... to łup po &9&lWardenie&r... Tak, musisz zabić &9&lWardena&r. \\n\\nMając to wszystko, możesz wytworzyć jedną z najlepszych &7Bookshelves&r! Daje &a10 Eterna&r, &c15% Quanta&r i &510% Arcana&r. \\n\\nI co najważniejsze, daje maksymalną &aEterna&r równą &a80&r! Prawie do 100!"]
	quest.24FCFF18296ED907.title: "&9Soul-Touched Sculkshelf"
	quest.2EC2FA680076C07D.quest_desc: ["Aby jeszcze bardziej ulepszyć &9Deepshelves&r, o dziwo nie potrzebujesz &d&linfuzji&r! Zamiast tego potrzeba więcej wytwarzania! \\n\\nNa początek 5 &3Sculk Blocks&r i &3Sculk Catalyst&r. Oba znajdziesz w &9Deep Dark&r, a do ich zebrania potrzebny jest &5Silk Touch&r. \\n\\nNa końcu &9Warden Tendril&r... to łup po &9&lWardenie&r... Tak, musisz zabić &9&lWardena&r. \\n\\nMając to wszystko, możesz wytworzyć jedną z najlepszych &7Bookshelves&r! Daje &a10 Eterna&r, &c10% Quanta&r i &515% Arcana&r. \\n\\nI co najważniejsze, daje maksymalną &aEterna&r równą &a80&r! Prawie do 100!"]
	quest.2EC2FA680076C07D.title: "&9Echoing Sculkshelf"
	quest.31E7F7464D79F881.quest_desc: ["Nie tylko &7biblioteczki&r można poddać &d&linfuzji!&r"]
	quest.31E7F7464D79F881.title: "Inne Przedmioty do &d&lInfuzji&r"
	quest.3311B79A8F6C6ADD.quest_desc: ["&6&lEnchanting Table of the Raven&r to potężne ulepszenie &5Enchanting Table&r, pozwalające dostosować wartości &aEterna&r, &cQuanta&r i &5Arcana&r w &5Table&r bez potrzeby używania półek.\\n\\nDzięki temu z łatwością przeprowadzisz każdą &d&linfuzję&r.\\n\\nGems of the Royal Family można zdobyć w Overworldzie."]
	quest.3311B79A8F6C6ADD.quest_subtitle: "Kruk rzekł: „Nigdy więcej”"
	quest.3311B79A8F6C6ADD.title: "&6&lEnchanting Table of the Raven"
	quest.377D6CF86BC1C64F.quest_desc: ["&8Tome of Scrapping&r zdejmie tylko połowę &5zaklęć&r, a &8Tome of Superior Scrapping&r zdejmie z przedmiotu każde &5zaklęcie&r! \\n\\nOba te &8Tomes&r zniszczą jednak używany przedmiot. \\n\\nAby przeprowadzić &d&linfuzję&r &8Tome of Scrapping&r w &8Tome of Superior Scrapping&r, użyj 3 &9Echoing Sculkshelves&r i 15 &7Basic Bookshelves&r.\\n\\nAlbo, jeśli chcesz mieć ten &8Tome&r na &2&lFrontier&r, użyj 8 &bCrystalline Seashelves&r."]
	quest.377D6CF86BC1C64F.quest_subtitle: "Wszystkie zaklęcia, niszczy przedmiot"
	quest.377D6CF86BC1C64F.title: "&8Tome of Superior Scrapping"
	quest.37E556B4A730E5AA.quest_desc: ["Mogłeś zauważyć, że Twoja &aEterna&r nie chce przekroczyć &a30&r, nawet jeśli użyłeś &4Hellshelves&r lub &bSeashelves&r. Dzieje się tak, bo teraz o Twojej &aMax Eterna&r decydują &lWorld Tiery&r.\\n\\nNa &9&lHaven&r (pierwszym &lWorld Tier&r) wynosi ona &a30&r. Na &2&lFrontier&r - &a45&r.\\n\\nSprawdź rozdział Apotheosis Gear albo powiązane zadania w sekcji &lWorld Tiers&r tego rozdziału, aby dowiedzieć się więcej o &lWorld Tierach&r."]
	quest.37E556B4A730E5AA.quest_subtitle: "Dlaczego moja Eterna jest ograniczona do 30?"
	quest.37E556B4A730E5AA.title: "&2&lFrontier&r Wzywa"
	quest.3D31B94CC42BCE43.quest_desc: ["&8Tome of Extraction&r to &8Tome&r, którego szukasz! Zdejmie wszystkie &5zaklęcia&r i zostawi przedmiot w spokoju!\\n\\nAby go zrobić, musisz przeprowadzić &d&linfuzję&r swojego &8Tome of Superior Scrapping&r. \\n\\nMożesz po prostu użyć poprzedniego zestawu &9Sculkshelf&r."]
	quest.3D31B94CC42BCE43.quest_subtitle: "Wszystkie zaklęcia, nie niszczy"
	quest.42746659C66CF17F.quest_desc: ["&6&oLibrary of Alexandria&r to ulepszona &5Enchantment Library&r. \\n\\nMoże przechowywać wyższe poziomy &5Enchanted Books&r, ale do wyjęcia książki na danym poziomie nadal potrzebny jest odpowiedni poziom &5Book&r. \\n\\nMieści też więcej punktów. &5Enchantment Library&r mieści 32768, a &6&oLibrary of Alexandria&r - 1,1 miliarda punktów każdej &5Book&r! \\n\\nAby ją zdobyć, musisz przeprowadzić &d&linfuzję&r &5Enchantment Library&r. \\n\\nUżyj 4 &9Soul-Touched Sculkshelves&f, 4 &9Echoing Sculkshelves&f, 1 &dDraconic Endshelf&f, 5 &6Geode-Encased Bookshelves of Stability&r i Skeleton Skull."]
	quest.42746659C66CF17F.quest_subtitle: "Wyobraź sobie, że Rzym nigdy nie spłonął..."
	quest.42746659C66CF17F.title: "&6&oLibrary of Alexandria"
	quest.43167C59036E79A7.quest_desc: ["&8Tome of Miners&r pomoże Ci w całym wydobyciu. Daje &5Efficiency&f, &5Fortune&f i &5Silk Touch&r. \\n\\nDziałają na kilofy, siekiery, łopaty, a nawet motyki! \\n\\n&8Tome of the Fishers&r daje tylko &5zaklęcia&r do wędki, a tych jest całkiem sporo."]
	quest.43167C59036E79A7.title: "&8Księgi Narzędzi"
	quest.45161821C221EF0B.quest_desc: ["Gdy ustawisz te 15 &4Hellshelves&r wokół &5stołu do zaklinania&r, Twój &5stół&r będzie miał &a45 Eterna&r i &c30% Quanta&r. \\n\\nTo idealna ilość, by przeprowadzić &d&linfuzję&r &4Hellshelves&r! \\n\\n&4Infused Hellshelves&r dają &a5 Eterna&r z maksimum &a60 Eterna&r, a do tego &c5% Quanta&r. \\n\\nMożna je łączyć w wytwarzaniu z innymi przedmiotami, by uzyskać różne &7biblioteczki&r - do tych, których szukasz, potrzeba 13 &4Infused Hellshelves&r! \\n\\nOczywiście, ponieważ jestem tak hojny, wystarczy, że zbierzesz tylko 8!"]
	quest.45161821C221EF0B.title: "&4Infused Hellshelves"
	quest.4E895C54651A3CB3.quest_desc: ["&8Tomes&r to &7Books&r... tylko bardziej użyteczne &7Books&r! \\n\\nKażdy &8Tome&r wytwarza się z &7Books&r, Sticks, &cBlaze Rods &fi &cPowder&r. \\n\\n&8Tomes&r można &5zaklinać&r, tak jak przedmioty, aby uzyskać określone &5zaklęcia&r. \\n\\nSą też &8Tomes of Scrapping&r, których można używać na kowadłach, aby zdejmować &5zaklęcia&r z przedmiotów."]
	quest.4E895C54651A3CB3.title: "&8&lKsięgi"
	quest.4EE6824A970EEB35.quest_desc: ["Spawner Runes służą do wytwarzania różnych przedmiotów modyfikujących spawnery. Infused Spawner Runes są wymagane do potężniejszych modyfikacji.\\n\\nPotrzebujesz co najmniej &a70 Eterna&r, &c30% Quanta&r i &550% Arcana&r. \\n\\nAby to osiągnąć, możesz użyć jednego z poniższych zestawów:\\n\\n14 &9Deepshelves&r, które nie są &9Dormant&r!\\n13 &4Glowing Hellshelves&r i 2 &9Deepshelves&r!\\n12 &bCrystalline Seashelves&r i 2 &9Deepshelves&r!"]
	quest.4EE6824A970EEB35.title: "&d&lInfuzja&r Spawner Runes"
	quest.516E66BE01EE5B31.quest_desc: ["&8Tomes of Weaponry&r dają &5zaklęcia&r do mieczy i siekier. \\n\\nGłównie te, które pomagają w zabijaniu! Jak &5Sharpness &fi &5Fire Aspect&r.\\n&8Tomes of Archery&r dają &5zaklęcia&r do broni dystansowej, łuku i kuszy. \\n\\n&5Piercing&f, &5Power&f i &5Knockback&r!"]
	quest.516E66BE01EE5B31.title: "&8Księgi Broni"
	quest.51E554305FFEBA1D.quest_desc: ["&4Blazing Hellshelves&r dają trochę &cQuanta&r i &aEterna&r, ale nie są tanią opcją, której szukasz do swoich &d&linfuzji&r!"]
	quest.51E554305FFEBA1D.title: "&4Blazing Hellshelf"
	quest.523DC411241B470A.quest_desc: [
		"Wszystkie &5zaklęcia&r z &5Enchanting Table&r zależą od poziomów &aEterna&r, &cQuanta&r i &5Arcana&r. \\n\\nPulę dostępnych &5zaklęć&r możesz sprawdzić, klikając ? w prawym górnym rogu GUI &5Enchanting Table&r, gdy przedmiot jest &5zaklinany&r. \\n\\nIm wyższa &cQuanta&r, tym większa szansa na wylosowanie słabszego &5zaklęcia&r. \\n\\n&6Geode-Encased Bookshelf of Stability&r eliminuje zwiększoną szansę na gorsze &5zaklęcia&r."
		"{@pagebreak}"
		"Aby go wytworzyć, potrzebujesz &7Bookshelf&r, 7 sztuk Calcite i 1 &5Budding Amethyst&r. \\n\\n&5Budding Amethyst&r nie da się zdobyć przez wydobycie, nawet z &5Silk Touch&r. Potrzebny jest więc rytuał lub infuzja!"
	]
	quest.523DC411241B470A.title: "&6Usuwanie Negatywnych Zaklęć"
	quest.586D5DE28EEC8014.quest_desc: ["&cQuanta&r pomaga przemieszać pulę &5zaklęć&r, ułatwiając zdobycie wielu różnych &5zaklęć&r. \\n\\n&cQuanta&r może jednak działać przeciwko Tobie: im więcej jej masz, tym częściej trafiają się słabsze &5zaklęcia&r. \\n\\nWcześniej używało się &eRectification&r, a teraz zamiast tego używasz &6Geode-Encased Bookshelves of Stability&r! \\n\\nDomyślna &cQuanta&r wynosi &c15%&r, a jej maksimum to &c100%&r."]
	quest.586D5DE28EEC8014.title: "&cQuanta"
	quest.5C73247A48E72FB3.quest_desc: ["Jeśli chcesz usunąć konkretne &5zaklęcie&r z &5puli zaklęć&r, możesz użyć tej &bBookshelf&r w swoim zestawie do &5zaklinania&r! \\n\\nUmieść &5Enchantment Book&r, którą chcesz wpisać na czarną listę, w pustym miejscu w tej &bSeashelf&r. \\n\\nPotem, gdy będziesz &5zaklinać&r, to &5zaklęcie&r nie pojawi się na przedmiotach ani książkach."]
	quest.5C73247A48E72FB3.title: "Usuń &5Zaklęcia&r z Puli"
	quest.5DE45BC0258D1B0B.quest_desc: ["&dPearlescent Endshelf&r to całkiem niezła &7półka&r, zwłaszcza za swoją cenę. \\n\\nWytwarza się ją, łącząc &dEndshelf&r z 4 &7End Rods&r i 2 &3Ender Pearls&r. \\n\\nDaje maksymalną &aEterna 90&r, ale to nie jest to, czego potrzebujesz do maksymalnego &5zaklinania&r."]
	quest.5DE45BC0258D1B0B.title: "&dPearlescent Endshelf"
	quest.60850E717C747A78.quest_desc: ["Czy zdarzyło Ci się spędzić 3 miesiące na nauce &okodu galaktycznego&r, by w końcu zrozumieć język &5stołu do zaklinania&r, a potem okazało się, że to bełkot? \\n\\nNie? \\n\\nMnie też nie, ale &9Enchanting Clues&r to Twój prawdziwy tłumacz! \\n\\nKażdy &9Enchanting Clue&r powie Ci o 1 &5zaklęciu&r, zanim faktycznie go użyjesz."]
	quest.60850E717C747A78.title: "&3Wskazówki Zaklinania"
	quest.61217D80BFF8A858.quest_desc: ["Oto trzeci i ostatni poziom &5Ender Lead&r! Ten jest niezniszczalny i potrafi nawet przywiązywać moby do spawnerów. Wymaga znacznie trudniejszego zestawu do &d&linfuzji&r. Potrzebujesz co najmniej &a75 Eterna&r, &c85% Quanta&r i &560-85% Arcana&r.\\n\\nOsiągniesz to z 4 &9Soul-Touched Sculkshelves&r, 4 &9Echoing Sculkshelves&r, 3 &7Stoneshelves&r i 2 &7Basic Bookshelves&r. Aha, do tej &d&linfuzji&r potrzebujesz też Witch złapanej w Ender Lead."]
	quest.61217D80BFF8A858.quest_subtitle: "To nie ma nic wspólnego z Occultism, przysięgam"
	quest.61217D80BFF8A858.title: "&5Occult Ender Lead"
	quest.6220EDE42C813C1B.quest_desc: ["Najgorsze w &eCharms&r jest to, że się psują! Dlaczego te potężne efekty mikstur muszą mieć wytrzymałość! \\n\\nSpokojnie, &5&lApotheosis&r ma na to lekarstwo... w postaci &d&linfuzji&r! \\n\\nPotrzebujesz &a100 Eterna&r, od &c8,5% &fdo &c13,5% Quanta&r oraz od &532,5% &fdo &537,5% Arcana&r. \\n\\nMożesz użyć 10 &4Glowing Hellshelves&r, 4 &6Geode-Encased Bookshelves of Stability&r, 2 &dDraconic Endshelves&r i Skeleton Skull! \\n\\nTak, niektóre czaszki i inne przedmioty poza &7Bookshelves&r dają statystyki!"]
	quest.6220EDE42C813C1B.title: "Niezniszczalne &eCharms"
	quest.62D39F68DE6E44A4.quest_desc: ["&5Arcana&r to bardzo ważna wartość: zwiększa liczbę otrzymywanych &5zaklęć&r i sprawia, że rzadkie &5zaklęcia&r występują częściej. \\n\\nPrzykładowo dla mieczy: &5Smite&r to bardzo częste &5zaklęcie&r, ale &5Looting&r jest znacznie rzadsza. \\n\\nDomyślna &5Arcana&r wynosi &50%&r, a maksymalna &5100%&r."]
	quest.62D39F68DE6E44A4.title: "&5Arcana"
	quest.6852BEFDD4DE4E4B.quest_desc: ["&9Soul-Touched Deepshelves&r to ulepszenie &9Deepshelves&r. \\n\\nWytwarza się je z &bSoul Lantern&r i 3 &3Sculk Blocks&r. Do podniesienia &3Sculk Blocks&r potrzebny jest &5Silk Touch&r. \\n\\nPotem możesz wytworzyć wersję &9Soul-Touched&r. Daje ona mnóstwo więcej &cQuanta&r - aż &c15%&r! \\n\\nZwiększa też maksymalną &aEterna&r do &a75&r."]
	quest.6852BEFDD4DE4E4B.title: "&9Soul-Touched Deepshelf"
	quest.6884E25641A1020C.quest_desc: ["&5Enchantment Library&r to absolutnie najlepszy magazyn &5Enchanted Books&r! \\n\\nAby ją wytworzyć, potrzebujesz 4 &3Ender Chests&r, 1 &5Enchanting Table&r i 4 dowolnych &d&lzainfuzowanych&r &7Bookshelves&r: &4Infused Hellshelf&r, &bInfused Seashelves&r i &9Deepshelves&r. \\n\\nAby jej używać, kliknij &5Enchanted Books&r lewym przyciskiem myszy z Shiftem albo przenieś je do &9niebieskiego slotu&r. Dodasz w ten sposób &5Books&r do &5Library&r. \\n\\n&5Books&r są sortowane według nazwy i przechowywane w punktach. Każdy poziom &5Enchanted Book&r ma swoją wartość, zależną od tego, ile &5Books&r byłoby potrzebnych do uzyskania tego poziomu. Poziom 1 to 1 punkt. Poziom 2 to 2 punkty. Poziom 3 to 4 punkty. Poziom 4 to 8 punktów. \\n\\nKażda &5Book&r jest przechowywana maksymalnie w ilości 32768 punktów i możesz ją wyjąć, klikając lewym przyciskiem myszy przechowywaną &5Book&r. Każde kliknięcie doda kolejny poziom do &5Book&r w &6pomarańczowym slocie&r. \\n\\nMożesz klikać różne &5Books&r, aby dodawać je do &5Book&r w &6pomarańczowym slocie&r, podobnie jak przy łączeniu &5Books&r na kowadle. \\n\\nMaksymalny poziom &5Enchanted Book&r zależy od najwyższego poziomu &5Book&r, jaki do niej włożyłeś. Nie ma znaczenia, że masz 32000 punktów - jeśli włożyłeś tylko &5Sharpness III&r, wyjmiesz tylko &5Sharpness III&r."]
	quest.6884E25641A1020C.title: "&5Enchantment Library"
	quest.695889817162EFC7.quest_desc: ["&aEXP&r jest bardzo ważne dla &5&lApotheosis Enchanting&r! Potrzebuje go każde &5zaklęcie&r! (Jak myślisz, dlaczego daję je w każdej nagrodzie?) \\n\\nDzięki &d&linfuzji&r możesz zamieniać &6Honey Bottles&r w &aBottles O' Enchanting&r. Właściwie są aż 3 różne &d&linfuzje&r! Dają kolejno 1 &aBottle O' Enchanting&r, 8, a potem 32! \\n\\nPierwsza daje 1 &aBottle&r i wymaga tylko 2 &9Echoing Sculkshelves&r. \\n\\nDruga daje 8 &aBottles&r i wymaga 5 &9Echoing Sculkshelves&r i 1 &9Soul-Touched Sculkshelf&r. \\n\\nOstatnia daje 32 &aBottles O' Enchanting&r i wymaga 5 &9Echoing Sculkshelves&f, 3 &9Soul-Touched&f i 1 &dDraconic Endshelf&r!"]
	quest.695889817162EFC7.title: "Wytwarzanie &aEXP&r?"
	quest.6A07D09831428CB9.quest_desc: [
		"&4&lNether&r bywa dość straszny, a jeśli wolisz podróżować po &bmorzu&r, użyj &bSeashelves&r! \\n\\n&bSeashelves&r to Twoje wprowadzenie do &5Arcana&r, dają &53% Arcana&r i &a3 Eterna&r. \\n\\nLepsze niż zwykłe &7półki&r, prawda? \\n\\nPotrzebujesz ich 16 do &d&linfuzji&r... a właściwie 15 do &d&linfuzji&r i 1 do &d&lzainfuzowania&r! \\n\\nTak jak w przypadku &4Hellshelves&r, dam Ci dodatkowe, wystarczy, że teraz zbierzesz 11!"
		"{image:atm:textures/questpics/apothic/enchant_seashelf.png width:100 height:100 align:center}"
	]
	quest.6A07D09831428CB9.title: "&bSeashelves"
	quest.6C2C135B9B7B9402.quest_desc: ["&d&lInfuzja&r to specjalna wersja &5zaklinania&r, która, o ironio, służy do uzyskiwania lepszych &5zaklęć&r. \\n\\nGdy osiągniesz odpowiednią ilość &aEterna&r, &cQuanta&r i &5Arcana&r, &5zaklęcia&r zaoferują &d&linfuzję&r. \\n\\n(Aby poznać potrzebne poziomy, możesz zajrzeć do JEI lub wykonywać te zadania)"]
	quest.6C2C135B9B7B9402.title: "&l&dInfuzja"
	quest.6C57D64518FF22C0.quest_desc: ["Pozostałe &5zaklęcia&r pochodzą z tego &8Tome&r. \\n\\n&5Unbreaking&r... nie wiem, co jeszcze..."]
	quest.6C57D64518FF22C0.title: "&8Pozostałe Tomes"
	quest.70D2C5FAC661E01A.quest_desc: ["&bHeart-Forged Seashelf&r to kolejne ulepszenie &bInfused Seashelf&r. \\n\\nJest trochę droższa, ale daje mnóstwo &5Arcana&r! \\n\\nBardzo przyda się przy późniejszych &d&linfuzjach&r wymagających dużo &5Arcana&r."]
	quest.70D2C5FAC661E01A.title: "&bHeart-Forged Seashelf"
	quest.73E09ED46A94B812.quest_desc: ["&4&lPinnacle&r to ostatni World Tier, co oznacza, że po jego osiągnięciu Twoja &aMax Eterna&r wzrośnie najwyżej, jak się da, do &a100&r.\\n\\n&8Tym razem przynajmniej nie trzeba bramki.&r"]
	quest.73E09ED46A94B812.quest_subtitle: "Max Eterna do 100"
	quest.73E09ED46A94B812.title: "Ach, &4&lPinnacle&r, Wreszcie"
	quest.77D3C3CA4EE2FBD1.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.784466C3813AA506.quest_desc: ["Chciałeś kiedyś podnosić moby? Mamy do tego... Soul Gems i Creature Catchers.\\n\\nNa razie je pomiń i skup się na opcji, którą oferuje &5&lApotheosis&r. &5Flimsy Ender Lead&r to najtańszy wariant &5Ender Lead&r, ale też najsłabszy i najbardziej kruchy. Może przechowywać tylko zwierzęta i psuje się po 8 użyciach."]
	quest.784466C3813AA506.title: "&5Flimsy Ender Lead"
	quest.78BFDD3A9B996655.quest_desc: ["Znaczący krok naprzód względem &5Flimsy Ender Lead&r. Teraz może przechowywać także wrogie moby i psuje się po 64 użyciach. Aby go zdobyć, potrzebujesz co najmniej &a45 Eterna&r, &c25% Quanta&r i &540% Arcana&r.\\n\\nOsiągniesz to z 9 &bCrystalline Seashelves&r albo, jeśli wybrałeś &4Hellshelves&r, z 9 &4Glowing Hellshelves&r i 8 Candles (Wskazówka: w jednym bloku zmieścisz do 4 świec)"]
	quest.78BFDD3A9B996655.title: "&5Ender Lead"
	quest.78E66F1DE42C747A.quest_desc: ["&9Echo Shards&r bywają dość irytujące do farmienia, a potrzebujesz ich mnóstwo! Czemu więc nie ułatwić sobie farmienia? \\n\\nDzięki &d&linfuzji&r możesz zamienić 1 &9Echo Shard&r w 4! \\n\\nPotrzebujesz &a70 Eterna&r, &c50% Quanta&r i &550% Arcana&r. \\n\\nAby to osiągnąć, możesz użyć jednego z poniższych zestawów:\\n\\n14 &9Deepshelves&r, które nie są &9Dormant&r!\\n13 &4Glowing Hellshelves&r i 2 &9Deepshelves&r!\\n12 &bCrystalline Seashelves&r i 2 &9Deepshelves&r!"]
	quest.78E66F1DE42C747A.title: "Nieskończone &9Echo Shards&r?"
	quest.78FEDE6FA4845585.quest_desc: ["Niektóre &d&linfuzje&r wymagają bardzo, bardzo dokładnych ilości &aEterna&r, &cQuanta&r lub &5Arcana&r. \\n\\nAby je uzyskać, możesz potrzebować jednej z tych &7półek&r. \\n\\nKażda obniża ilość odpowiedniej wartości."]
	quest.78FEDE6FA4845585.title: "&4Ujemne&r Wartości"
	quest.79AF63E77AD70A93.quest_desc: ["&7Basic Bookshelves&r to Twój punkt wyjścia, ale zdecydowanie nie punkt docelowy. Przynajmniej nie &7Basic Bookshelves&r. \\n\\nSamymi &7Basic Bookshelves&r podniesiesz &aEterna&r maksymalnie do 30. \\n(Wkrótce wyjaśnię &5poziomy zaklęć&r, ale wiedz, że musisz je podnieść)\\n\\n(&7Basic Bookshelves&r i zwykłe &7Bookshelves&r są wymienne)"]
	quest.79AF63E77AD70A93.title: "&2&lWaniliowe&r Maksimum To Dopiero Początek"
	quest.7C758209D06ED0E3.quest_desc: ["Łącząc &4Infused Hellshelf&r z odrobiną &eGlowstone&r, możesz wytworzyć &4Glowing Hellshelves&r! \\n\\nMają tę samą &aEterna&r i &cQuanta&r, ale dają &53,3333% Arcana&r. \\n\\nPrzyda się to w późniejszych &d&linfuzjach&r, na przykład gdy użyjesz 13 z nich do &d&linfuzji&r &9Dormant Deepshelf&f w &9Deepshelf&r!"]
	quest.7C758209D06ED0E3.title: "&4Glowing Hellshelf"
	quest.7C9D9D1C054874A7.quest_desc: ["Chcesz mieć najdoskonalsze &5zaklęcia&r? Z maksymalnymi statystykami i każdym dobrym &5zaklęciem&r w zasięgu? Wtedy będziesz potrzebować tego wszystkiego! \\n\\nNa początek 5 &9Soul-Touched Sculkshelves&r i 5 &9Echoing Sculkshelves&r. Dadzą Ci całą &cQuanta&r i &5Arcana&r, jakiej potrzebujesz! \\n\\nDalej &dDraconic Endshelf&r, który da &a100 Eterna&r - tyle wynosi zarówno wartość &aEterna&r, jak i jej maksymalny poziom. \\n\\nTrzeci jest &6Geode-Encased Bookshelf of Stability&r. Dzięki niemu &cQuanta&r nie zagra przeciwko Tobie i nie wylosuje fatalnych &5zaklęć&r! \\n\\nOstatni jest opcjonalny, ale warto go dodać: &6Deepshelf of Arcane Treasures&r. Ta &7Bookshelf&r pozwoli zdobyć &5zaklęcia&r, których normalnie byś nie dostał, na przykład &5Mending&r!"]
	quest.7C9D9D1C054874A7.quest_subtitle: "Bez Enchanting Table of the Raven"
	quest.7C9D9D1C054874A7.title: "&6&lNajlepszy Zestaw do Zaklinania"
	quest.7F007C888C23EC42.quest_desc: ["&5Gem Case&r to absolutnie najlepszy magazyn na &aApotheosis Gem&r! \\n\\nAby go wytworzyć, potrzebujesz 1 &3Ender Chest&r, 1 &5Gem Cutting Table&r, 4 Basalt i 3 Glass. \\n\\nAby z niego korzystać, kliknij &aklejnoty&r lewym przyciskiem myszy z Shiftem albo przenieś je do &9niebieskiego slotu&r. Dodasz w ten sposób &aklejnoty&r do &5Gem Case&r.\\n\\n&5Gem Case&r pomieści do 32768 sztuk każdego unikalnego &aklejnotu&r o danej czystości (na przykład &5Gem Case&r pomieści 32 tys. &zPerfect Gems of the Warlord&r i 32 tys. &aChipped Gems of the Warlord&r). Wyjmiesz je, klikając lewym przyciskiem myszy przechowywany typ &aklejnotu&r, a następnie jedną z wyświetlonych czystości.\\n\\n&5Gem Case&r możesz też używać jako Gem Cutting Table, umieszczając Rarity Materials i &9Gem Dust&r w slotach po lewej. Kliknij lewym przyciskiem myszy przechowywany typ &aklejnotu&r, a potem jeden z młotków, aby ulepszyć 2 takie &aklejnoty&r do następnej czystości."]
	quest.7F007C888C23EC42.title: "&5Gem Case"
	task.3D62C020980A2DEC.title: "Biblioteczki"
	task.432FCFECDAA542F1.title: "Biblioteczki"
	task.4644C76CEC129AA4.title: "Permanent Charms"
	task.52C6DC68BF096122.title: "Księgi Broni"
	task.598F1FCB5B5ED8FC.title: "Księgi Narzędzi"
	task.5AB4C41B6800D7FA.title: "Księgi Zbroi"
	task.79FB7E7194336B30.title: "Stoły do Zaklinania"
}
