{
	quest.00DB5495C3A44999.quest_desc: ["Kliknij ekwipunek prawym przyciskiem myszy z Shiftem, aby go opróżnić."]
	quest.0108F3EFDFD6DFD0.quest_desc: ["Storage Link pozwala połączyć wiele magazynów, które nie są podłączone do Storage Controller ani do żadnych bloków z nim połączonych.\\n\\nJest to więc sposób na bezprzewodowe połączenie \"multibloku\" magazynów bez konieczności klikania prawym przyciskiem każdego z nich.\\n\\nZasięg 14 bloków nadal obowiązuje."]
	quest.019CA0E35F888222.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.019CA0E35F888222.title: "&eAdvanced Restock Upgrade"
	quest.0298A17C2AAC5765.quest_desc: ["Zwiększa rozmiar stosu w plecaku o 8."]
	quest.0298A17C2AAC5765.title: "&bStack Upgrade Tier 3"
	quest.037415D5B965E214.quest_desc: ["To ulepszenie sprawia, że plecak nie może zginąć."]
	quest.0682DC1F2417DAEB.quest_desc: ["Functional Storage to mod o przechowywaniu, który dodaje różne przydatne przedmioty pomagające w magazynowaniu oraz sposoby przechowywania stosów tych samych przedmiotów.\\n\\nMoże to być przydatne np. przy Cobblestone, Dirt i innych."]
	quest.0682DC1F2417DAEB.quest_subtitle: "Dalecy Krewni Storage Drawers"
	quest.0682DC1F2417DAEB.title: "Functional Storage"
	quest.072FBEB0F6F1BC48.quest_desc: ["Służy do łączenia Drawers z Controller oraz do łączenia Ender Drawers.\\n\\nAby połączyć Drawers z Controller, kliknij prawym przyciskiem blok Controller, aby rozpocząć konfigurację. Kliknięcie prawym przyciskiem Drawers doda je do sieci.\\n\\nTrzymanie narzędzia pokaże, które Drawers są połączone z Controller."]
	quest.0CD04A00529FE1C9.quest_desc: ["Copper Chest można wytworzyć, ale nie jest potrzebna do wytworzenia Iron Chest - można jej użyć, jeśli chcesz zaoszczędzić trochę żelaza."]
	quest.0CD04A00529FE1C9.title: "&6Copper Chest"
	quest.0D4C64DD58567758.quest_desc: ["Dodaje do plecaka zbiornik."]
	quest.0E057B7F76401421.quest_subtitle: "Pierwsze Ulepszenie"
	quest.0E057B7F76401421.title: "&6Copper Backpack"
	quest.0E0CAA31480EC0A1.quest_desc: ["Pozwala plecakowi podnosić przedmioty."]
	quest.0E0CAA31480EC0A1.quest_subtitle: "Pozwala plecakowi podnosić przedmioty."
	quest.0E5AE195158CF344.quest_subtitle: "x32 Storage Upgrade"
	quest.0E5AE195158CF344.title: "&dNetherite Upgrade"
	quest.110D27EA86CDA62B.quest_desc: ["Przyciąga przedmioty do plecaka."]
	quest.11D4EEAC61C7E530.quest_desc: ["Collector Upgrade sprawi, że Drawer zasysa przedmioty z jednej ze stron."]
	quest.11D57C768032E3F7.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.11D57C768032E3F7.title: "&eAdvanced Magnet Upgrade"
	quest.122FBF5110E4CFF2.quest_desc: ["Iron Downgrade zmniejszy maksymalną pojemność Drawer do jednego stosu. Może się to przydać, aby utrzymywać zapas przedmiotów, ale nie za duży."]
	quest.1310C1E14C259807.quest_desc: ["Chcesz mieć własne Drawers? Nie szukaj dalej - mogą naśladować teksturę bloku na zewnątrz i inną z przodu.\\n\\nPostępuj zgodnie z opisem w podpowiedzi, aby dowiedzieć się, jak to zrobić."]
	quest.134608BB2B04D96E.quest_desc: ["Skrzynie mają 27 slotów i można je połączyć w dużą skrzynię, aby przechowywać dwa razy tyle."]
	quest.134608BB2B04D96E.quest_subtitle: "The Chest"
	quest.134608BB2B04D96E.title: "Magazyn Vanilla"
	quest.156FF8B7B724DC38.quest_desc: ["Dodaje filtr dla przedmiotów wpompowywanych do plecaka lub z niego wypompowywanych."]
	quest.15CD4BFDC56E9510.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.15CD4BFDC56E9510.title: "&eAdvanced Tool Swapper Upgrade"
	quest.1659A59303C15CC9.quest_desc: ["Beczki działają tak samo jak skrzynie, tylko nie można ich połączyć w jedną całość. Za to fajnie wyglądają."]
	quest.17DC77F7F8C68AE6.quest_desc: ["Trash Cans służą do niszczenia niechcianych przedmiotów, płynów i energii."]
	quest.17DC77F7F8C68AE6.quest_subtitle: "Pozbywanie się Nadmiaru"
	quest.17DC77F7F8C68AE6.title: "Kosze na Śmieci"
	quest.1985CFD1F0425E88.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.1985CFD1F0425E88.title: "&eAdvanced Pickup Upgrade"
	quest.19DFAEB6D88F3580.quest_desc: ["Pusher Upgrade pozwala Drawers wypychać przedmioty na dowolną stronę."]
	quest.1A4B1CA7EC15348E.quest_desc: ["Za pomocą &aLinking Tool&r możesz połączyć 2 Ender Drawers, aby zsynchronizować ich zawartość.\\n\\nDziała to tak jak Ender Chest, ale jako Drawer.\\n\\nAby je połączyć, kliknij lewym przyciskiem pierwszy Ender Drawer za pomocą &aLinking Tool&r (z zewnątrz, nie od strony przodu), a następnie kliknij prawym przyciskiem z kucaniem/Shiftem drugi Ender Drawer."]
	quest.1A4B1CA7EC15348E.quest_subtitle: "Międzywymiarowy Drawer..."
	quest.1A739D36D5E3B1AD.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.1A739D36D5E3B1AD.title: "&eAdvanced Feeding Upgrade"
	quest.1B72E95569B07E18.quest_subtitle: "x24 Storage Upgrade"
	quest.1B72E95569B07E18.title: "&bDiamond Upgrade"
	quest.1CACE201C6AA0913.quest_desc: ["To ulepszenie zniszczy nadmiarowe przedmioty, które trafiają do Drawers, gdy są pełne.\\n\\nMoże się to przydać, by zapobiec przepełnieniu lub zatkaniu się układu z powodu pełnego magazynu."]
	quest.1CD2C6AFD788C35E.quest_desc: ["Kompresuje przedmioty w plecaku do ich receptury 2x2."]
	quest.1E499F94A2A193E1.quest_desc: ["Dodaje do plecaka GUI bloku Blast Furnace."]
	quest.1FE052F643401232.quest_desc: ["Będą Ci potrzebne do wytworzenia Backpack Upgrades."]
	quest.1FE052F643401232.quest_subtitle: "Podstawa Ulepszeń"
	quest.1FE17B1C7C639F88.quest_desc: ["Storage Controller pozwala pracować z wieloma magazynami tak, jakby były jednym dużym multiblokiem magazynu.\\n\\nDzięki temu można stworzyć bardzo dużą sieć magazynową, którą można połączyć z modami takimi jak Applied Energistics lub Integrated Dynamics, ponieważ Storage Controller działa jako punkt wejścia/wyjścia dla wszystkich podłączonych do niego magazynów.\\n\\nPołączenie można wykonać, po prostu stawiając magazyny obok Storage Controller lub obok innych, które są już do niego podłączone (działa to do 14 bloków od kontrolera we wszystkich kierunkach)."]
	quest.209DC1E9AD4C5A84.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.25AFD10D008DF30B.quest_desc: ["Wszystkie Ender Chests dzielą ten sam ekwipunek, a ten ekwipunek jest inny dla każdego gracza. Nie można ich połączyć w jedną."]
	quest.26988E22BD019628.quest_desc: ["Automatycznie przetapia przedmioty w plecaku."]
	quest.26988E22BD019628.quest_subtitle: "Automatyczny"
	quest.26988E22BD019628.title: "&eAuto-Blasting Upgrade"
	quest.26A9F402DAE15EA2.quest_desc: ["Dodaje do plecaka GUI bloku Smoker."]
	quest.2746575C929B6C50.quest_desc: ["Drawers mogą być 1x1, 2x1 lub 2x2. Mogą pomieścić mnóstwo stosów po 1/2/4 przedmioty, w zależności od typu Drawer."]
	quest.2746575C929B6C50.quest_subtitle: "Stosy na Stosach"
	quest.2B422B7E0CE3590D.quest_desc: ["Compacting Drawer potrafi zamieniać umieszczone w nim przedmioty na ich formę bryłek lub bloków.\\n\\nNa przykład: Iron Ingot umieszczony w nim pozwoli wyjąć 9 bryłek, a po dodaniu większej ilości żelaza zamieni je w Iron Blocks."]
	quest.2B422B7E0CE3590D.quest_subtitle: "Automatycznie kompresuje/dekompresuje"
	quest.2F9B0C642A6BE30C.title: "&fIron Backpack"
	quest.2FC15D3916DBF4E4.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.2FC15D3916DBF4E4.title: "&eAdvanced Void Upgrade"
	quest.33882172DA8021F6.quest_desc: ["Utrzymuje ekwipunek gracza uzupełniony przedmiotami z plecaka."]
	quest.33AADC1B97E9F7A9.quest_desc: ["Minecarts with Chests to wagoniki, w których znajdują się skrzynie. Nie można nimi jeździć, ale mogą się przydać do transportu przedmiotów po torach."]
	quest.36BCE35215B2B6E9.quest_desc: ["Automatycznie przetapia przedmioty w plecaku."]
	quest.36BCE35215B2B6E9.quest_subtitle: "Automatyczny"
	quest.36BCE35215B2B6E9.title: "&eAuto-Smoking Upgrade"
	quest.38F9E9A830D3EA0C.quest_desc: ["Jeśli myślałeś, że ten mod służy tylko do przechowywania przedmiotów, mylisz się - są też Fluid Drawers!\\n\\nDziałają tak samo jak zwykłe Drawers, ale przechowują płyny."]
	quest.3A1D07AED2A841E4.quest_desc: ["Automatycznie przetapia przedmioty w plecaku."]
	quest.3A1D07AED2A841E4.quest_subtitle: "Automatyczny"
	quest.3A1D07AED2A841E4.title: "&eAuto-Smelting Upgrade"
	quest.3B570B3DB5F6D2CB.quest_subtitle: "x16 Storage Upgrade"
	quest.3B570B3DB5F6D2CB.title: "&eGold Upgrade&r"
	quest.3D5852E6D0ADF651.title: "Magazyn Międzywymiarowy"
	quest.3E33730DC2115D26.title: "&eGold Chest"
	quest.4007DFA7CC3A5FF2.quest_desc: ["Aby oszczędzić Ci widoku &ocałej sekcji zadań&r zapełnionej ulepszeniami, zerknij na ulepszenia Sophisticated Backpack\\n\\nBędziesz musiał wytworzyć odpowiedniki z Sophisticated Storage, ale działają mniej więcej tak samo."]
	quest.4007DFA7CC3A5FF2.quest_subtitle: "Podstawa Ulepszeń"
	quest.45268A619787288F.title: "&eGold Backpack"
	quest.46D756F4DC6CC894.title: "&dNetherite Backpack"
	quest.485D5664A17E16DF.quest_subtitle: "x8 Storage Upgrade"
	quest.485D5664A17E16DF.title: "&6Copper Upgrade"
	quest.4A854CD5EC70733E.quest_desc: ["Dodaje do plecaka GUI bloku Crafting Table."]
	quest.4B62AF0405F68041.quest_desc: ["Dodaje filtr, który pozwala określić, jakie przedmioty plecak ma mieć zawsze w zapasie. Kliknięcie ekwipunku prawym przyciskiem myszy z Shiftem uzupełni go."]
	quest.4B62AF0405F68041.quest_subtitle: "Pełne Zapasy"
	quest.4C0BDD483CCB40C4.title: "&bDiamond Chest"
	quest.4C0EAB9F795686D0.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.4C0EAB9F795686D0.title: "&eAdvanced Deposit Upgrade"
	quest.4C2A60FC1F1E0328.quest_desc: ["Dodaje do plecaka baterię."]
	quest.4E4C8BCD45766F03.quest_desc: ["Ten Drawer automatycznie zamieni umieszczony w nim przedmiot na jego skompresowaną formę."]
	quest.4E4C8BCD45766F03.quest_subtitle: "Automatycznie kompresuje/dekompresuje"
	quest.508A8366219175FE.quest_desc: ["Configuration Tool służy do blokowania Drawers, aby zapamiętały przedmiot, który mają w środku.\\n\\nMoże to być przydatne, gdy budujesz system wypychający i pobierający przedmioty z Drawers. Zablokowany Drawer nie zmieni przedmiotu, na który został zablokowany!"]
	quest.52672B7FFFD51D16.quest_desc: ["Dodaje do plecaka GUI bloku Stonecutter."]
	quest.53F861876B991C36.quest_desc: ["Dodaje do plecaka GUI bloku Jukebox."]
	quest.53F861876B991C36.quest_subtitle: "Teraz się bawimy"
	quest.544791880F315D5A.quest_desc: ["Boats with Chests to łodzie ze skrzyniami na pokładzie. Skrzynię możesz otworzyć, siedząc w łodzi, albo klikając ją prawym przyciskiem. W łodzi może płynąć tylko jedna osoba naraz."]
	quest.56B80A7EBFE21428.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.56B80A7EBFE21428.title: "&eAdvanced Pump Upgrade"
	quest.57CF8C6C867B9BDA.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.57CF8C6C867B9BDA.title: "&eAdvanced Filter Upgrade"
	quest.58514FDE153FD971.quest_subtitle: "Iron Chests?"
	quest.58514FDE153FD971.title: "&fIron Chest"
	quest.5A94A2664BFDD7B9.quest_desc: ["Witaj w rozdziale Basic Storage!\\n\\nZnajdziesz tu wszystkie podstawowe sposoby przechowywania przedmiotów, które nie wymagają energii, a także przydatne przedmioty do Twoich potrzeb magazynowych!"]
	quest.5A94A2664BFDD7B9.title: "Podstawy Magazynu"
	quest.5E4BC0F59C90433A.quest_desc: ["Sophisticated Storage pozwala ulepszać skrzynie i beczki za pomocą metali, aby zwiększyć ich pojemność! Możesz też dodawać ulepszenia, które zwiększają ich funkcjonalność.\\n\\nTe skrzynie i beczki są takie same jak te z vanilli, ale mają slot na Storage Upgrade!"]
	quest.5E4BC0F59C90433A.quest_subtitle: "\"Vanilla Chest\""
	quest.5E4BC0F59C90433A.title: "Sophisticated Storage"
	quest.5E4FE420B6D2C97F.quest_desc: ["Kompresuje przedmioty w plecaku do ich receptury 3x3."]
	quest.5E4FE420B6D2C97F.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.5E4FE420B6D2C97F.title: "&eAdvanced Compacting Upgrade"
	quest.5FA9BC0D8476D322.quest_desc: ["Automatycznie karmi Cię jedzeniem z plecaka."]
	quest.615B9062FE8CCD36.quest_desc: ["Automatycznie zmienia narzędzie na najskuteczniejsze dla bloku, na który patrzysz."]
	quest.61A22707DBC83818.quest_desc: ["Storage Access Point działa jak Storage Controller, gdy jest do niego podłączony, i można do niego wypychać oraz z niego pobierać. W zasadzie to punkt wejścia dla Drawers."]
	quest.668C313FF46B6005.quest_desc: ["Dodaje do plecaka GUI bloku Furnace."]
	quest.67704F7341EDCC49.title: "&bDiamond Backpack"
	quest.696E063016CAD1B9.quest_desc: ["Dodaje do plecaka GUI stołów Chipped Workbenches."]
	quest.6A2B2C5E2ADCE366.quest_desc: ["Sophisticated Backpacks oferują plecaki z możliwością ulepszania, które mogą używać filtrów, aby dodać poręczne funkcje!\\n\\nPlecaki można nosić w slocie pleców Curios i można je farbować."]
	quest.6A2B2C5E2ADCE366.quest_subtitle: "Ekwipunki są zbyt małe"
	quest.6A2B2C5E2ADCE366.title: "Sophisticated Backpacks"
	quest.6E3D53D1C4569A89.quest_desc: ["Pozwala przepompowywać doświadczenie między Tobą a plecakiem."]
	quest.6E3D53D1C4569A89.quest_subtitle: "Przechowywanie XP"
	quest.6E3D53D1C4569A89.title: "&aExperience Pump Upgrade"
	quest.6E9041744C592573.quest_desc: ["Dodaje możliwość pompowania płynów z Tank Upgrade."]
	quest.6FBAE89EE782DABA.quest_desc: ["Gdy zostanie umieszczony i połączony za pomocą &aLinking Tool&r z innymi Drawers, Controller działa jak \"Hub\".\\n\\nJeśli klikniesz go dwukrotnie prawym przyciskiem, zostaną pobrane wszystkie przedmioty z Twojego ekwipunku, które mają slot w sieci Drawers.\\n\\nKlikając Controller prawym przyciskiem podczas skradania się z pustą ręką, otworzysz kartę ulepszeń - dodaj do tych slotów zwykłe ulepszenia magazynu, aby zwiększyć zasięg Controller. Maksymalny zasięg to 40 bloków na każdą stronę, czyli sześcian 80x80x80."]
	quest.6FBAE89EE782DABA.quest_subtitle: "Mózg Drawers"
	quest.70902EF96F060672.quest_desc: ["To ulepszenie sprawi, że Drawers będą wysyłać sygnał redstone na wszystkie strony, a siła sygnału powie, jak bardzo są pełne/puste.\\n\\nW przypadku Drawers z wieloma slotami ulepszenie można skonfigurować tak, aby monitorowało wybrany slot.\\n\\n0 - oznacza pusty.\\n15 - oznacza pełny."]
	quest.7649D648A3688D4A.quest_desc: ["Puller Upgrade pozwala Drawers pobierać przedmioty z dowolnej strony."]
	quest.77F241BEE9902751.quest_desc: ["Największa ze skrzyń z Sophisticated Storage"]
	quest.77F241BEE9902751.quest_subtitle: "Tyle miejsca do zabawy!"
	quest.77F241BEE9902751.title: "&dNetherite Chest"
	quest.785951190FFDAA21.quest_desc: ["Zwiększa rozmiar stosu w plecaku o 4."]
	quest.785951190FFDAA21.title: "&eStack Upgrade Tier 2"
	quest.78E51D22C16C4686.quest_desc: ["Storage Controller może też łączyć się z innymi magazynami bezprzewodowo. Umożliwia to Storage Tool - wystarczy kliknąć prawym przyciskiem Storage Controller, aby go powiązać, a następnie kliknąć prawym przyciskiem magazyny, aby je połączyć.\\n\\nZasięg połączenia bezprzewodowego jest taki sam jak zwykłego, czyli 14 bloków."]
	quest.7AE3C8134F5ED726.quest_desc: ["Zwiększa rozmiar stosu w plecaku o 16."]
	quest.7AE3C8134F5ED726.title: "&dStack Upgrade Tier 4"
	quest.7C07D6A33F7ADB02.quest_desc: [
		"To ulepszenie plecaka, więc możesz włożyć plecak do plecaka."
		""
		"Dzięki temu możesz mieć plecak w plecaku na wypadek, gdy będziesz potrzebować plecaka w plecaku."
	]
	quest.7C07D6A33F7ADB02.quest_subtitle: "Plecaki w Plecakach?"
	quest.7C0F7A1B3AB9A1A1.quest_subtitle: "Więcej Opcji Filtrowania"
	quest.7C0F7A1B3AB9A1A1.title: "&eAdvanced Refill Upgrade"
	quest.7E9E03274A88347D.quest_desc: ["Zwiększa rozmiar stosu w plecaku o 2."]
	quest.7E9E03274A88347D.title: "&fStack Upgrade Tier 1"
	quest.7EF57BBEAA4B6B08.quest_desc: ["Chcesz stworzyć wirtualny magazyn za pomocą moda takiego jak &9Applied Energistics 2&r?\\n\\nTo świetne sposoby na ulepszenie magazynu, ale ważne jest, by porozmawiać o &eprzedmiotach NBT&r i o tym, jak najlepiej je przechowywać.\\n\\nPrzedmioty NBT to przedmioty z dodatkowymi tagami. Zaklęte przedmioty, przedmioty z wytrzymałością i inne. To przedmioty z dołączonymi tagami NBT. Z tego powodu zwykle nie łączą się w stosy.\\n\\nGdy przechowujesz ich dużo w systemie magazynowym, takim jak AE2, ryzykujesz problemy ze swoim zapisem lub serwerem.\\n\\nDlatego najlepiej przechowywać je w skrzyniach lub workach!"]
	quest.7EFBFF5D0DA018E7.quest_desc: ["Dodaje filtr przedmiotów, które mają być automatycznie usuwane w plecaku."]
	quest.7EFBFF5D0DA018E7.quest_subtitle: "Dodaje filtr przedmiotów, które mają być automatycznie usuwane w plecaku."
	quest.7F990FBC1A691020.quest_desc: ["Trapped Chests są takie same jak zwykłe skrzynie, tylko wysyłają sygnał redstone po otwarciu i nie można ich połączyć w jedną całość."]
	quest.7F990FBC1A691020.quest_subtitle: "\"Ciekawe, Co Tu Jest?\""
	task.00ED02255105A973.title: "Diamond Chests"
	task.0427B441A750316F.title: "Gold Chests"
	task.073D1C45B3018BBA.title: "Skrzynie"
	task.14FA4A933C39A406.title: "Łodzie ze Skrzyniami"
	task.1809DDEA104A9CE8.title: "AllRightsReserved"
	task.200CE35BF3C04F6F.title: "Copper Chests"
	task.21FBC4E0F668347C.title: "NBT i Ty!"
