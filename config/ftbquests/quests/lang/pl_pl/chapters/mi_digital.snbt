{
	quest.00C95A190BE2CBF9.quest_desc: ["Aby uzyskać &#994ABAStyrene&r, musisz poddać reakcji &#C2C969Iron Dust&r z &#69C9B6EthylBenzene&r i parą (Steam). &#69C9B6EthylBenzene&r powstaje w wyniku destylacji &#CDCF95Steam Cracked Naptha&r."]
	quest.00C95A190BE2CBF9.title: "Zaawansowana Destylacja"
	quest.011B8BD02D80DDD4.quest_desc: ["&#6E2D6ETungsten Ore&r bez trudu znajdziesz po całym świecie. Po jej wykopaniu otrzymasz &#A140A1Raw Tungsten&r."]
	quest.024BD22824C7F53A.quest_desc: ["Destylacja &#F0C87DSteam-Cracked Naptha&r da nam &#8FD5E3Toluene&r."]
	quest.09BE81548CD81068.quest_desc: ["W końcu dotarłeś do komponentów potrzebnych do &#FFEB6EAllthemods Star&r!!"]
	quest.0B60DA8F65E5DF06.quest_desc: ["Możesz rozkruszyć &#A140A1Raw Tungsten&r na kilka sposobów, aby otrzymać &#C452C4Tungsten Dust&r."]
	quest.0C229BE9B57269EF.quest_desc: ["&#EBA844Kanthal Dust&r trzeba przetopić w &#816DF7Electric Blast Furnace&r."]
	quest.0CD36928116E868E.quest_desc: ["&#F783F3Vinyl Chloride&r można zmieszać z &#9683F7Lead Tiny Dust&r albo &#FEA8FFChromium Tiny Dust&r, aby otrzymać &#F36EF5PolyVinyl Chloride&r."]
	quest.0EA327E405EDFF02.quest_desc: ["&#9C6C35Acetylene&r zmieszany z &#DEAB6DHydroChloric Acid&r da Ci &#F783F3Vinyl Chloride&r."]
	quest.1A83615B7E1D3540.quest_desc: ["Włożenie &9wody&r do &#45BF56Reactor&r z paliwem da nam &#8F49C4Deuterium&r. Są też inne sposoby na jego zdobycie, ale &#45BF56Reactors&r zapewniają najszybszy z możliwych."]
	quest.226187AA3F1B6DB1.quest_desc: ["Zmieszanie &#D4C35DSand&r, &8Flint&r, &#8DF0EENitrogen&r i &#69C9C7Toluene&r da nam &#D66D40Industrial TNT&r."]
	quest.22B8D57337944D9C.quest_desc: ["&#DF9DE0Titanium Hot Ingots&r można teraz schłodzić w &#5CD1CFVacuum Freezer&r, aby otrzymać użyteczne &#F069F0Titanium Ingots&r."]
	quest.22B8D57337944D9C.title: "&#F069F0Titanium Ingot"
	quest.23DB52ECA259F36D.quest_desc: [
		"Heavy Water w &#45BF56Reactor&r wytwarza &#EB5266Tritium&r i &#C09EDEHeavy Water Steam&r."
		""
		"&#EB5266Tritium&r służy do zaawansowanych komponentów, natomiast &#C09EDEHeavy Water Steam&r można przetworzyć z powrotem na &#8C47C9Heavy Water&r w &#DEAB47Heat Exchanger&r."
	]
	quest.267A357B28228694.quest_desc: ["&#4DB85ERandom Access Memory&r wytwarza się w &#5EC7E6Chemical Reactor&r z &#A1A1A1Styrene-Butadiene Rubber&r, &#D15EE6Argon&r, &7Antimony Dust&r, &#5ED2E6Aluminum Dust&r i &#5D76C2Silicon Wafers&r."]
	quest.282A23C3E7561796.quest_desc: [
		"&#94C0E3Processing Array&r to duży multiblok, który pozwala symulować równoległą pracę maszyn. Maksymalna liczba równoległych operacji to &#94E3A264&r."
		""
		"Aby zbudować multiblok, najpierw wybierz w GUI bloku kontrolera liczbę równoległych maszyn, które chcesz symulować."
		""
		"{image:atm:textures/questpics/modernindustrialization/proc_array_gui.png width:175 height:100 align:center}"
		""
		"{@pagebreak}"
		"Aby użyć maszyny, musisz włożyć maszynę, którą chcesz symulować, do slotu po prawej stronie GUI. Potrzebujesz tylu maszyn, ile chcesz mieć operacji."
		""
		"Ponadto &#94C0E3Processing Array&r przyjmuje też standardowo wszystkie ulepszenia."
	]
	quest.2A95F4F998835B43.quest_subtitle: "9 Nuggets -> 1 Ingot"
	quest.3003598CE8B1FAAA.quest_subtitle: "Lepsza technologia"
	quest.3003598CE8B1FAAA.title: "Jeszcze Bardziej Zaawansowane Komponenty"
	quest.31CB278B4BA7B25E.quest_desc: ["Wirowanie &#B5E7F7Liquid Air&r da Ci 3 produkty: &#A5CAD9Oxygen&r, &#78ADC2Nitrogen&r i &#DD91EDArgon&r. &#DD91EDArgon&r wykorzystamy w niedalekiej przyszłości."]
	quest.31CB278B4BA7B25E.quest_subtitle: "To ma sens"
	quest.31CB278B4BA7B25E.title: "Wirowanie Powietrza"
	quest.352A226915809E1B.quest_desc: ["&#A57DE3Packer&r pozwoli nam teraz połączyć &#7DD2E3Stainless Steel&r, &#B37DE3Tungsten&r i &#E37DDBTitanium Ingot&r w nowy &#3946E3Mixed Blastproof Ingot&r. "]
	quest.35FDC436DE07635F.quest_desc: ["&#DB62DEImplosion Compressor&r wykorzystuje siłę materiałów wybuchowych do łączenia surowców. Można go użyć do uzyskania wydajniejszych &#8762DEMixed Blastproof Alloy Ingots&r, a także wielu innych przydatnych surowców."]
	quest.3601DD545E1D11B4.quest_desc: [
		"&#DD91EDArgon&r reagujący z &#83729ESilicon Dust&r i &#AAA0BAIridium Tiny Dust&r da nam &#919191Monocrystalline Silicon&r."
		""
		"&#AAA0BAIridium&r występuje jako ruda w Overworldzie."
	]
	quest.36D35C35BBC0A555.quest_subtitle: "Najwydajniejszy"
	quest.386ABEB4249D157D.quest_desc: ["Pojedynczy &#919191Monocrystalline Silicon&r można pociąć na 32 &#8FA4B5Silicon Wafers&r."]
	quest.3891F8D4201E6BFD.quest_desc: [
		"&#EBA844Kanthal Ingot&r można przerobić na Fine Wire, z którego można uformować Cable, aby w końcu wytworzyć &#EBA844Kanthal Coils&r. "
		""
		"&#EBA844Kanthal Coils&r pozwalają naszemu &#816DF7Electric Blast Furnace&r pracować w znacznie wyższej &#F76D6Dtemperaturze&r, dzięki czemu działa więcej receptur."
		""
		"Musisz przełączyć cewki w GUI &#816DF7Electric Blast Furnace&r."
		""
		"{image:atm:textures/questpics/modernindustrialization/switch_to_kanthal.png width:150 height:75 align:center}"
	]
	quest.39A0BA6E2A72A681.quest_desc: ["Zmieszanie &#99F0F0Stainless Steel&r, &#ADDBDBAluminium&r i &#E9A8F7Chromium Dust&r da nam &#EBA844Kanthal Dust&r."]
	quest.3A0C8BCE197A448B.quest_desc: ["&#827AFFStyrene-Butadiene&r można zmieszać z &#9683F7Lead Tiny Dust&r albo &#FEA8FFChromium Tiny Dust&r, aby otrzymać &#A1A1A1Styrene-Butadiene Rubber&r."]
	quest.3ACC27B786CDCF22.quest_desc: ["&#3ABEC7Electric Compressor pozwala zamienić &#CE5ADBTungsten Tiny Dust&r w &#AF22BFTungsten Nuggets&r."]
	quest.3B1CDC2DD05CAE80.quest_desc: ["&#F36EF5PolyVinyl Chloride&r z &#6EBAF5Platinum Plate, &#C4C362Cadmium Battery&r, &#F7BB57Annealed Copper Cable&r i &#57BFF7Digital Circuit Board&r da nam &#EBE56EProcessing Unit Board&r."]
	quest.3CB05026BC4C5577.quest_desc: ["Na tę chwilę możesz bardzo nieefektywnie wytwarzać &#986FC7Blastproof Alloy Plates&r w &#6F93C7Electric Compressor&r z użyciem &#3946E3Mixed Blastproof Ingot&r."]
	quest.3FE2A649F07DF28D.quest_subtitle: "Możesz rozkruszyć Blutonium z Extreme Reactors, aby otrzymać Plutonium Dust"
	quest.3FE489E6B1FAC24B.quest_subtitle: "Recykling zużytych prętów"
	quest.3FE489E6B1FAC24B.title: "Zdobywanie Plutonium"
	quest.40F2EDB9384CE782.quest_desc: ["Destylacja &#DBE37FSteam Cracked Light Fuel&r da Ci &#9C6C35Acetylene&r jako produkt."]
	quest.4A06CCE1FE0F333C.quest_desc: ["&#74C3DBAir Intake&r umieszczony w &#46CAF2Vacuum Freezer&r da Ci &#B5E7F7Liquid Air&r."]
	quest.4A618CA66AD6223D.quest_subtitle: "Jeszcze więcej energii na wejściu"
	quest.4F870252E9FB1A41.quest_desc: ["Reaktor można zasilać Fuel Rods; to najprostsze, jakie możesz wytworzyć."]
	quest.50F97171D25CD2EE.quest_desc: ["&#6EDDFFHighly Advanced Upgrades&r zwiększają pojemność o &#FFEB6E512EU/t&r za każde ulepszenie."]
	quest.56A4F5D301BC1E93.quest_desc: ["&#6EDDFFTurbo Upgrades&r zwiększają pojemność o &#FFEB6E64EU/t&r za każde ulepszenie."]
	quest.58F7C11C241DD7A4.quest_desc: [
		"&#6AADD9Distillation Tower&r to ulepszona forma &#A3D2F0Distillery&r. Jej główną zaletą jest to, że daje wiele produktów z tego samego wsadu."
		""
		"Aby zbudować strukturę, musisz otworzyć GUI bloku &#6AADD9Distillation Tower&r i wybrać wysokość. Wysokość zależy od tego, ile potrzebujesz produktów. Do przetwarzania &#76759ECrude Oil&r potrzebujesz wysokości 3 bloków."
	]
	quest.58F7C11C241DD7A4.quest_subtitle: "Wydajność ma znaczenie"
	quest.5A4406F89DB802F0.quest_desc: ["Reakcja &#BB95CFStyrene&r i &#D46C85Butadiene&r prowadzi do powstania &#827AFFStyrene-Butadiene&r."]
	quest.5B45AB96953FA61C.title: "The Digital Age"
	quest.633D6361DA680C75.quest_desc: ["Zmieszanie &#E6ED98Light Fuel&r z parą (Steam) da Ci &#DBE37FSteam Cracked Light Fuel&r."]
	quest.66E78F599CD50579.quest_desc: [
		"&#49C472Nuclear Reactor&r pozwala przetwarzać bardziej zaawansowane surowce. Użyjemy go do wytwarzania &#8F49C4Deuterium&r i &#EB5266Tritium&r."
		""
		"Ta lista surowców pomoże Ci zbudować „Large” Reactor. Mniejsze rozmiary nie są zalecane ze względu na ich szybkość i wydajność."
		"{@pagebreak}"
		"Szczegóły budowy wydajnego reaktora są zbyt skomplikowane, aby je tu podać. Podam Ci jednak najlepsze możliwe projekty."
		""
		"Oto projekt &#49C472Large Reactor&r do produkcji &#8F49C4Deuterium&r."
		"{image:atm:textures/questpics/modernindustrialization/large_reactor.png width:100 height:100 align:center}"
		""
		"A to projekt &#49C472Extreme sized Reactor&r do produkcji &#EB5266Tritium&r."
		""
		"{image:atm:textures/questpics/modernindustrialization/largest_reactor.png width:100 height:100 align:center}"
	]
	quest.66E78F599CD50579.quest_subtitle: "Nie wybuchają"
	quest.672B69448F1D458B.quest_desc: ["&#FAAD28Heat Exchanger&r to raj dla miłośników Turbine z &#4D7DFFExtreme Reactors&r. Ta maszyna potrafi wytworzyć zdumiewająco dużą ilość Steam."]
	quest.672B69448F1D458B.quest_subtitle: "Para jedzie brrr"
	quest.6A9AE3514B5151C9.quest_desc: ["&#CFB951Kanthal Coils&r pozwolą nam przetworzyć &#C356C4Raw Titanium&r w &#DF9DE0Titanium Hot Ingots&r. Ten proces wymaga &#D49B70Manganese Sulfuric Solution&r."]
	quest.6B5AC7E33ACF24FB.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.6F183B06683D1213.quest_desc: ["&#EBA844Kanthal Hot Ingot&r można schłodzić w &#6DC0F7Vacuum Freezer&r."]
	quest.6F3974CAAA555FD0.quest_subtitle: "Zarządzanie tym RAM-em"
	quest.75619C7174C6703C.quest_desc: ["Wirowanie Uranium Dust da nam kilka izotopów uranu, które można dalej przetworzyć na lepsze pręty."]
	quest.75619C7174C6703C.title: "Wirowanie Uranium Dust"
	quest.78EC7D19BE24FE06.quest_subtitle: "Nie wybucha"
	quest.7AF6C95816E82861.quest_desc: ["&#5B75D4Reakcja chemiczna&r &#8F49C4Deuterium&r z &#AABBFAOxygen&r da nam &#9C51DBHeavy Water&r. Można ją włożyć z powrotem do &#45BF56Reactor&r."]
	quest.7C73740F1B515F2C.quest_desc: ["&#C452C4Tungsten Dust&r trzeba rozdrobnić do znacznie mniejszej postaci, aby umożliwić jego przetwarzanie."]
	task.08F68CC089765088.title: "Sztuczka z Obejściem"
