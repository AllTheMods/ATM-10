{
	quest.00764A738DA6451C.quest_desc: ["Zabij 4 &dEndermity&r. \\n\\nNo i teraz po prostu zabijamy wszystko, no nie?"]
	quest.027EF5C8A74B1596.quest_desc: [
		"Główną bronią &6B&8e&6e&8s&r są ich żądła. \\n\\nWięc dlaczego nie użyć ich do własnej broni! Możesz wytworzyć, znaleźć lub wymienić Stinger Spear, który działa jak Trident. \\n\\nTylko że jest znacznie słabszy i nakłada na moby Poison!"
		"{image:atm:textures/questpics/bumblezone/bumble_spear.png width:100 height:150 align:center}"
	]
	quest.02F4C3BEBD8427AD.quest_desc: [
		"Zaufaj mi, poznasz to, gdy to zobaczysz. \\n\\nDziesiątki ogrodów zwisających z sufitu ula. Zawierają setki różnych kwiatów i drzew, a nawet takie z innych modyfikacji, jak Eternal Starlight czy Regions Unexplored!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_garden.png width:200 height:100 align:center}"
	]
	quest.02F4C3BEBD8427AD.title: "Hanging Gardens"
	quest.037E0DAA5ECC5AB8.quest_desc: ["Uderz 24 różne moby za pomocą &ePollen Puffs&r. \\nNajwięcej zabawy jest z uderzaniem nimi &6ps&8zc&6zó&8ł&r!"]
	quest.041D16DA96BC4253.quest_desc: [
		"&e&lPollinated Pillars&r łączą &e&lPollinated Fields&r z &6&lHive Walls&r. \\nTo dobra mieszanka obu! Ogromne, strome ściany &6miodu&r przełożone warstwami &epyłku&r!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_pollenpillar.png width:200 height:100 align:center}"
	]
	quest.041D16DA96BC4253.title: "&e&lPollinated Pillars"
	quest.04665EFC3A37250E.quest_desc: ["Zabij 8 &7Silverfish&r."]
	quest.053483E3349B2F8A.quest_desc: [
		"Ta struktura wygląda podobnie do Hanging Gardens, ale jest tylko jeden ogród, za to ogromny. Rozpoznasz &bBlue Sempiternal Sanctum&r po &bniebieskim&r kolorze &bLuminescent Ancient Wax&r. \\n\\nWejdź do struktury i podążaj do najniższego pomieszczenia (uważaj na Sentry Watchers) - tam znajdziesz &bBlue Essence&r. \\n\\nWejdź w nią i przygotuj się na wstrzymanie oddechu. Pod wodą będziesz musiał odeprzeć hordy Drowneds, Guardians i Elder Guardians. Gdy wszyscy zginą, otrzymasz..."
		"{image:atm:textures/questpics/bumblezone/bumble_blue1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_blue2.png width:200 height:100 align:center}"
	]
	quest.053483E3349B2F8A.title: "&bBlue Sempiternal Sanctum"
	quest.0584073A7383E0EA.quest_desc: [
		"Niektóre zadania &5Queen Bee&r mogą wydawać się irytujące, bo nie ma wielu miejsc, w których można farmić &dEndermites&r i &7Silverfish&r. \\n\\nNo właśnie, nie było - aż do ostatnich aktualizacji! Witaj w Mite Fortress! \\n\\nW ogromnych, kolczastych strukturach z &7Stone&r znajdziesz mnóstwo &7Silverfish&r (plus łup, zwłaszcza w &5Obsidian&r). \\n\\nW środku struktury, gdzie wszystko ma &5fioletowy&r kolor, są &dEndermites&r. \\n\\nA tak przy okazji, wiedziałeś, że &8B&6e&8e&6s&r atakują &dEndermites&r i &7Silverfish&r? Ruszaj z nimi do boju, by zdobyć serce ich &5Queen&r!"
		"{image:atm:textures/questpics/bumblezone/bumble_mite.png width:200 height:100 align:center}"
	]
	quest.0584073A7383E0EA.title: "Mite Fortress"
	quest.05A4496705B6C6AF.quest_desc: [
		"Beehemoth to wyjątkowe &6B&8e&6e&8s&r, które bardziej przypominają latającego dzikiego konia. \\n\\nMożna je oswoić, karmiąc płynnym &6miodem&r w butelce lub wiadrze. \\n\\nMają poziom przyjaźni, który decyduje o tym, czy zostały przez Ciebie oswojone, jak szybko się poruszają i ile mają zdrowia! Karmienie podnosi ten poziom, a otrzymywanie obrażeń go obniża. \\n\\nGdy poziom przyjaźni osiągnie maksimum, staną się &5Queen Beehemoth&r! \\n\\nBędą podążać za &6Honey Buckets&r jak krowy za pszenicą (spróbuj też użyć na nich Royal Jelly). "
		"{image:atm:textures/questpics/bumblezone/bumble_beehemoth.png width:100 height:100 align:center}"
	]
	quest.05A4496705B6C6AF.title: "Beehemoth"
	quest.0910C28A609ECBC1.quest_desc: ["&6Honey Compass&r to bardzo przydatne narzędzie dodane przez &6&lBumblezone&r. \\n\\nMożesz go wytworzyć lub wymienić. \\n\\nKliknij prawym przyciskiem myszy &eul&r, trzymając Shift, by śledzić ten &eul&r (w tym &lProductive Beehives&r), albo kliknij prawym przyciskiem w powietrze, by zlokalizować Cell Maze."]
	quest.0910C28A609ECBC1.title: "&6Honey Compass"
	quest.0980661B2F7FBC10.quest_desc: [
		"Skacz po świecach i nad nimi, by dotrzeć na szczyt! \\n\\nGdy już tam będziesz, znajdziesz kilka Honey Cocoons. \\n\\nNie spal sobie stóp.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_candle.png width:200 height:100 align:center}"
	]
	quest.0980661B2F7FBC10.title: "Candle Parkour"
	quest.0B0BDC37185AF9EC.quest_desc: [
		"Ancient Hoops to wysokie wieże zbudowane z Ancient Wax. \\n\\nNa szczycie mogą znajdować się obręcze, przez które przepływa Windy Air. \\n\\nTam też znajdziesz Cocoons! \\n\\nWygląda na świetne miejsce żeby użyć Elytra!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_hoops.png width:200 height:100 align:center}"
	]
	quest.0B0BDC37185AF9EC.title: "Ancient Hoops"
	quest.0BE2E7C9454058C3.quest_desc: [
		"Częścią pięknych &d&lFloral Meadow&r jest &dwiśnia&r znacznie starsza i większa od pozostałych. \\n\\n&6Ps&8zc&6zo&8ły&r chyba polubiły te &ddrzewa&r i założyły obok nich małe &eule&r pełne swoich młodych!"
		"{image:atm:textures/questpics/bumblezone/bumble_cherry.png width:200 height:100 align:center}"
	]
	quest.0BE2E7C9454058C3.title: "&dCherry Veteran Tree"
	quest.0C8180524757B238.quest_desc: [
		"&7Floaters&r technicznie nie są strukturami w plikach Minecrafta, ale w potocznym rozumieniu jak najbardziej. \\n\\nMogą pojawić się w dowolnym biomie, ale zawsze i licznie występują w &7&lHowling Constructs&r! \\n\\nSą to unoszące się struktury w kształcie dysków, zbudowane z Ancient Wax. Jeśli nie użyłeś jeszcze Essence of Bees, dotykając Ancient Wax, otrzymasz Weakness, Slowness i Mining Fatigue. Są na nich też &6Honey Cocoons&r lub &5kryształy&r!"
		"{image:atm:textures/questpics/bumblezone/bumble_floaters.png width:200 height:100 align:center}"
	]
	quest.0C8180524757B238.title: "&7Floaters"
	quest.0C9C5639D76FDF65.quest_desc: ["Uratuj 12 &6B&8e&6e&8s&r, przyczepiając im z powrotem żądło. \\n\\nGdy &6B&8e&6e&8s&r uderzą moba, a nawet Ciebie, stracą żądło, co nałoży na nie śmiertelny Poison. \\n\\nJeśli klikniesz ją Stingerem prawym przyciskiem myszy, możesz przyczepić je z powrotem i ją uratować!"]
	quest.0E32DB6B8E023764.quest_desc: ["&6&lProductive Bees&r? Co Ty tu robisz? \\n\\nCzasem wzdłuż &6&lHive Walls&r lub &6&lPillars&r możesz znaleźć złoża Combs z &l&6Productive Bees&r! \\n\\nTrochę jak wydobywanie rud w &2Overworld&r."]
	quest.0E32DB6B8E023764.title: "Crossover?"
	quest.0F5549B02D1B383B.quest_desc: ["Zabij 16 Cave Spiders. \\n\\nSpokojnie, w &6&lBumblezone&r jest mnóstwo rzeczy, które pomagają na Poison."]
	quest.1207E5C3E7BD0584.title: "Bee Banner Pattern"
	quest.12EF38830108D02B.quest_desc: ["Zabij 32 zwykłe Spiders."]
	quest.13681866CE6A831C.title: "Swords Banner Pattern"
	quest.13E3DE157B89E847.quest_desc: [
		"Bardzo prosta struktura: kilka &6ps&8zc&6zó&8ł&r i inne rzeczy zostały zamrożone w lodzie na patyku."
		"{image:atm:textures/questpics/bumblezone/bumble_ice.png width:200 height:100 align:center}"
	]
	quest.13E3DE157B89E847.title: "Ice Monolith"
	quest.14F6ED7F0C1DC503.quest_desc: ["Wypij 8 &6Bottles of Honey&r. \\n\\nTo zadanie jest dla mnie najtrudniejsze, nie znoszę dźwięku picia &6Honey Bottles&r."]
	quest.1A67F4F87B3D456C.quest_desc: [
		"&6B&8e&6e&r Cannon można wytworzyć, znaleźć w strukturach lub wymienić z &5Bee Queen&r. \\n\\nJest bardzo prosty: kliknij prawym przyciskiem myszy &6psz&8czo&6łę&r, by ją załadować, a potem przytrzymaj prawy przycisk i puść, by wystrzelić &6psz&8czo&6łę&r! \\n\\nNie staną się przez to wrogie, nie martw się - właściwie to chyba im się to podoba."
		"{image:atm:textures/questpics/bumblezone/bumble_cannon2.png width:75 height:150 align:center}"
	]
	quest.1C6B815C0F43312D.quest_desc: [
		"Zmiana tempa w &6&lBumblezone&r. \\n\\n&d&lFloral Meadow&r ma Grass, Cherry Trees i więcej &dkwiatów&r, niż można sobie wyobrazić. (Przy okazji, powinieneś obserwować Minty Meadow na Twitchu). \\n\\nCzekaj, skoro &6B&8e&6e&8s&r mają &dkwiaty&r w swoich &eulach&r, to po co sadzić &dkwiaty&r na zewnątrz?!?!?!?!"
		"{image:atm:textures/questpics/bumblezone/bumble_meadow.png width:200 height:100 align:center}"
	]
	quest.1C6B815C0F43312D.title: "&d&lFloral Meadow"
	quest.1D4973B187284CBB.quest_desc: ["Bardzo pokojowy i pomocny przedmiot - trzymaj go w drugiej ręce, aby go użyć. W drugiej ręce użyźnia uprawy i sadzonki. \\n\\nLeczy też oswojone moby i pobliskich graczy. \\n\\nUsuwa również Poison i Wither u graczy i oswojonych mobów. Nie wiem, jak Twoje moby zostają dotknięte efektem Wither, ale teraz możemy to naprawić! \\n\\nPo wystarczającej ilości leczenia lub użyźniania będzie miał 10-minutowy czas odnowienia."]
	quest.1D4973B187284CBB.title: "&aEssence of Life"
	quest.206918773B0BD7A0.title: "Ostatni Pierwszy Ostatni"
	quest.20E5C888891FBCFE.quest_desc: ["Gdy trzymasz ją w drugiej ręce, wszystkie pobliskie moby przestaną być wobec Ciebie wrogie. \\n\\nNiezależnie od tego, czy to Ty je wkurzyłeś, czy po prostu są z natury wściekłe, już nie będą. \\n\\nMa 600 użyć naraz, a po wyczerpaniu lub przerwaniu musi poczekać 10 minut w Twoim ekwipunku, by się naładować. \\n\\nMożna ją przerwać, jeśli otrzymasz obrażenia, gdy jest aktywna, lub jeśli uderzysz moba."]
	quest.20E5C888891FBCFE.title: "&bEssence of Calming"
	quest.2149833F65D523E5.quest_desc: [
		"Podobnie jak &6B&8e&6e&r Cannon, Crystal Cannon można wytworzyć, znaleźć w strukturach lub wymienić z &5Bee Queen&r. \\n\\nUżywa się go jak kuszy: jeśli masz w ekwipunku &5Honey Crystal Shards&r, przytrzymaj prawy przycisk myszy, by załadować &5kryształ&r, i puść, by go wystrzelić!"
		"{image:atm:textures/questpics/bumblezone/bumble_cannon1.png width:75 height:150 align:center}"
	]
	quest.21BFDE6AD1C0F62A.quest_desc: ["Oczywiście w prawdziwym życiu jest o wiele więcej niż tylko &6Honey Bees&r czy &6Bumble Bees&r, więc &6&lBumblezone&r dodaje więcej &8B&6e&8e&6s&r i unikalne &8B&6e&8e&6s&r! \\n\\nOd &4&lRedtail&r &8B&6e&8e&6s&r, przez &9Blue&r &8B&6e&8e&6s&r, po Neopolitan &8B&6e&8e&6s&r!"]
	quest.21BFDE6AD1C0F62A.title: "Odmiany &8psz&6cz&8ół&r"
	quest.22BB55249EF2E819.quest_desc: ["&l&6The Bumblezone&r to modyfikacja eksploracyjna, która dodaje zupełnie nowy wymiar wewnątrz naszych &eulów&r. \\n\\nZastanawiałeś się kiedyś, co &6ps&8zc&6zo&8ły&r robią w swoich &eulach&r? Cóż, możesz się tego dowiedzieć, wyruszając na przygodę do środka!"]
	quest.22BB55249EF2E819.quest_subtitle: "Witaj w Bumble!"
	quest.22BB55249EF2E819.title: "&l&6The Bumblezone!"
	quest.253957D992A88C88.quest_desc: [
		"Ta tarcza, jak większość przedmiotów tutaj, może zostać znaleziona w strukturach, wytworzona lub wymieniona z &5Bee Queen&r. \\n\\nDziała jak &2zwykła&r tarcza - trzymaj ją w drugiej ręce i blokuj ataki. \\n\\nTym, co ją wyróżnia (i czyni lepszą), jest to, że po naprawieniu za pomocą &5Honey Crystals&r staje się silniejsza."
		"{image:atm:textures/questpics/bumblezone/bumble_shield.png width:100 height:150 align:center}"
	]
	quest.262B307753106817.title: "Tonąc w Rozpaczy"
	quest.26988330D3E5BF95.title: "Arrows Banner Pattern"
	quest.270498437D938DD4.quest_desc: ["Wytwarzając Super Candle z Royal Jelly i miksturą, otrzymasz Potion Candle! \\n\\nGdy świeca jest zapalona, nadaje efekt mikstury wszystkim w pobliżu."]
	quest.270498437D938DD4.title: "Potion Candle"
	quest.27B5D0329DD92126.quest_desc: ["Zupa... z Bees? Wydaje się trochę nieludzka... \\n\\nZjedzenie/wypicie tego da Ci na jakiś czas efekt Beenergized i daje szansę na Luck! \\n\\nTo także szansa na Levitation, Slow Falling, Poison i Paralized. \\n\\nA skoro mowa o Paralized, za pomocą tej zupy możesz tworzyć Paralizing Potions."]
	quest.27FEF80A08AF43C2.quest_desc: [
		"Sanktuarium w barwach &6B&8e&6e&r! \\n\\nPrzejdź przez strukturę; radzę niczego nie dotykać, co przypomina Lever, Button, Tripwire czy Pressure Plate, bo może to być śmiertelne! \\n\\nGdy dotrzesz do &eYellow Essence&r, szykuj się na bieganie! \\n\\nMusisz biec i skakać przez &eElectric Rings&r. Gdy Ci się uda, pojawią się kolejne! Rób to przez długi czas i może kiedyś uda Ci się to ukończyć."
		"{image:atm:textures/questpics/bumblezone/bumble_yellow1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_yellow2.png width:200 height:100 align:center}"
	]
	quest.27FEF80A08AF43C2.title: "&eYellow Sempiternal Sanctum&r"
	quest.288A4A32CDBB14D5.quest_desc: [
		"Kolejna struktura zbudowana głównie z Ancient Wax. \\n\\nTa wygląda prawie jak antena satelitarna! Jest pełna &epyłku&r, więc uważaj, jeśli masz alergię. \\n\\nW środku znajdziesz blok Emerald i mnóstwo Amethyst."
		"{image:atm:textures/questpics/bumblezone/bumble_dish.png width:200 height:100 align:center}"
	]
	quest.288A4A32CDBB14D5.title: "Ancient Shrine"
	quest.29C78845B488EDF8.quest_desc: [
		"Bardzo wiele &5fioletowych kwiatów&r i &5Purple Luminescent Ancient Wax&r pokazuje nam, że to &5fioletowa struktura&r. \\n\\nPrzejdź przez &5fioletowe tunele wiatrowe&r, zanurz się obok &5fioletowych kanałów&r, przejdź przez &5fioletowe pomieszczenia&r pełne &5fioletowych kwiatów&r, ametystu i zasłon ze sznurka, aby dotrzeć do &5Purple Essence&r. \\nW środku, aby wygrać, musisz przetrwać do końca limitu czasu. Z ziemi będą wyrastać Purple Spikes, które mogą Cię zabić - unikaj ich!|"
		"{image:atm:textures/questpics/bumblezone/bumble_purple1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_purple2.png width:200 height:100 align:center}"
	]
	quest.29C78845B488EDF8.title: "&5Purple Sempiternal Sanctum"
	quest.29DF2E7D0402284F.title: "Blask"
	quest.29E2033EA65E706E.quest_desc: [
		"Tutaj znajdziesz dom Slime Rancher, który po prostu zarabia na życie... zaraz, co? Jak Villager się tu znalazł?\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_ranch.png width:200 height:100 align:center}"
	]
	quest.29E2033EA65E706E.quest_subtitle: "Pewien \"Slime Rancher\""
	quest.29E2033EA65E706E.title: "&6Honey Slime&r Ranch"
	quest.29E9E361DDC8041B.title: "Sun Banner Pattern"
	quest.2A50A687C40DB864.quest_desc: [
		"&6&lHive Walls&r to fundament &l&6Bumblezone&r. \\n\\nSą to ogromne ściany z &6plastrów miodu&r i &ewosku&r, sięgające od podłoża do sufitu. \\n\\nZawierają też Combs z &lProductive Bees&r oraz otwory w &6&lWalls&r, w których pojawiają się Brood Blocks."
		"{image:atm:textures/questpics/bumblezone/bumble_hivewall.png width:200 height:100 align:center}"
	]
	quest.2A50A687C40DB864.title: "&6&lHive Wall"
	quest.2A6FC21142E75DD5.quest_desc: [
		"Jeziora, oceany, stawy i rzeki &l&6Bumblezone&r. \\n\\nPrawdopodobnie pierwotnie była to po prostu &bwoda&r, ale przez cały czas spędzony w &eulu&r zmieniła się w &bSugar Water&r. \\n\\nBardzo pomagają wydostać się z &l&6Bumblezone&r, bo w tym biomie jest o wiele mniej bloków. \\n\\nCzasem pojawiają się tu też &6Honey Slime&r."
		"{image:atm:textures/questpics/bumblezone/bumble_sugar.png width:200 height:100 align:center}"
	]
	quest.2A6FC21142E75DD5.title: "Jeziora z Sugar! (&bWoda&r)"
	quest.2ABAE97E992BB800.title: "Honeycombs Banner Pattern"
	quest.2AD13B965611DC86.quest_desc: [
		"Bez wątpienia najbardziej fascynujący biom &l&6Bumblezone&r, &7&lHowling Constructs&r. \\n\\nNa ziemi znajdują się kolce z Infused Sugar Stone, &eCarvable Wax&r i &6miodu&r. \\n\\nCiekawe jest to, czego na ziemi nie ma. W całych &l&7Howling Constructs&r unoszą się &7latające struktury&r. \\n\\nSą zbudowane z Ancient Wax, o którym z czasem dowiesz się więcej."
		"{image:atm:textures/questpics/bumblezone/bumble_constructs.png width:200 height:100 align:center}"
	]
	quest.2AD13B965611DC86.title: "&7&lHowling Constructs"
	quest.2B857941D7BBA0B8.quest_desc: ["Można je znaleźć w strukturach w &6&lBumblezone&r lub wymienić z &5Bee Queen&r! \\n\\nNie cierpisz utykać na &6Honey Blocks&r? Albo gdy &epyłek&r Cię spowalnia? Nie bój się, Honey Bee Leggings są tutaj! Pomogą Ci lepiej poruszać się po tych blokach. Im więcej elementów Bee Armor nosisz, tym łatwiej będzie się podróżować! \\n\\nMożesz też przemykać przez &epyłek&r z wciśniętym Shiftem, by go zbierać! "]
	quest.2DE2E5A1275E4B20.quest_desc: ["Można go znaleźć w strukturach w &6&lBumblezone&r lub wymienić z &5Bee Queen&r! \\n\\n&6Ps&8zc&6zo&8ły&r mają dość ciekawy sposób znajdowania się nawzajem i komunikowania. Nie wiem, jak to robią, więc zgaduję, że ich czułki wysyłają i odbierają sygnały radiowe. \\n\\nGdy nosisz Stingless Bee Helmet, możesz wcisnąć Shift, by podświetlić wszystkie &6ps&8zc&6zo&8ły&r wokół Ciebie. \\n\\nPoza tym, gdy go nosisz, trucizna i nudności ustępują szybciej."]
	quest.30C12E249F7E2D52.quest_desc: [
		"Jedna z największych struktur w &6&lBumblezone&r, co oczywiście oznacza najwięcej łupów!\\n\\nJest tam mnóstwo różnych pomieszczeń połączonych w coś w rodzaju łamigłówki.\\n\\nJeśli nie użyłeś jeszcze Essence of Bees albo nie masz aktywnego efektu Protection of the Hive, w Cell Maze otrzymasz Wrath of the Hive. Nakarm więc trochę pszczół!\\n\\nPoza tym &5Throne Pillar Compass&r zawsze pojawia się w tej strukturze.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_cell.png width:200 height:100 align:center}"
	]
	quest.30C12E249F7E2D52.title: "Cell Maze"
	quest.3365017C9B24C0A9.quest_desc: ["Użyj łuków lub kusz, by wystrzelić 32 Stingers. \\n\\nTak, da się to zrobić!"]
	quest.339384ADC9CDB944.title: "Wiedza"
	quest.341DF467E3936E78.quest_desc: ["Zabij &dEnder Dragona&r, mając na sobie pełny zestaw &8B&6e&8e&r Armor! \\n\\nTwoje imię będzie pamiętane przez wieki!"]
	quest.351769579833FA9E.title: "Pszczeli Relaks z Ziomeczkami"
	quest.358D4F507521075F.quest_desc: [
		"&eUl&r w &eulu&r, &eul&r-cepcja.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_shrine.png width:200 height:100 align:center}"
	]
	quest.358D4F507521075F.title: "&eHive&r Temple"
	quest.396CEB9D05700927.quest_desc: ["Aby dostać się do &l&6Bumblezone&r, najpierw potrzebujesz &eBeehive&r. Zwykłe &eBeehives&r i &eAdvanced Beehives&r - nie są wybredne! \\n\\nNastępnie musisz albo wrzucić do niego Ender Pearl, albo sprawić, by Piston wepchnął Cię do środka! \\n\\nWtedy znajdziesz się w &eulu&r i wejdziesz do &l&6Bumblezone&r!"]
	quest.396CEB9D05700927.quest_subtitle: "Niepszczelowiarygodne"
	quest.396CEB9D05700927.title: "Do &eUlu"
	quest.3ADC0CBB059FF927.quest_desc: ["Aby tego użyć: 1. trzymaj to w drugiej ręce, 2. niech będzie dzień, 3. stój pod gołym niebem. \\n\\nWtedy otrzymasz Regeneration, Saturation, Speed, Haste i Resistance. Naprawi też wytrzymałość Twojej zbroi. \\n\\nPo wyczerpaniu ma 10-minutowy czas odnowienia."]
	quest.3ADC0CBB059FF927.title: "&eEssence of Radiance"
	quest.3B7BB08D6AA2E7FE.quest_desc: [
		"Teraz &cRed Super Candles&r wreszcie wyglądają na swoim miejscu! Poznajemy &cczerwoną&r strukturę po &cczerwonych kwiatach&r i &cRed Luminescent Ancient Wax&r. \\n\\nPrzejdź przez &cogniście czerwone pomieszczenia&r do &cRed Essence&r. \\n\\nPojawią się dziesiątki różnych wściekłych mobów: Wolves, Polar Bears i Hoglins. Pokonaj je wszystkie, by wygrać!"
		"{image:atm:textures/questpics/bumblezone/bumble_red1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_red2.png width:200 height:100 align:center}"
	]
	quest.3B7BB08D6AA2E7FE.title: "&cRed Sempiternal Sanctum&r"
	quest.3B9E6FBEDABA4F7E.quest_desc: [
		"Głęboko w &6&lHive Walls&r możesz znaleźć jaskinię &6miodu&r! \\n\\nZnajdziesz tu &6Honey Fluid&r, &5Honey Crystals&r, Brood Blocks, a nawet Beehemothy! \\n\\nWszystko związane z &6miodem&r. "
		"{image:atm:textures/questpics/bumblezone/bumble_cave.png width:200 height:100 align:center}"
	]
	quest.3B9E6FBEDABA4F7E.title: "&6Honey&r Cave Room"
	quest.3C413D4A210A3BDE.title: "Honey Bee"
	quest.4040BFCD4BE56621.quest_desc: [
		"&6Honey&r Hotel (Honitel) to duża i stosunkowo bezpieczna struktura, o ile nie liczyć obrażeń od upadku. \\n\\nMa dziesiątki pokoi, w których mogą przebywać &6ps&8zc&6zo&8ły&r. W pokojach jest też mnóstwo łupów do zabrania. \\n\\nMam nadzieję, że będziesz miał wyrzuty sumienia, okradając te niewinne &6ps&8zc&6zo&8ły&r.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_honitel.png width:200 height:100 align:center}"
	]
	quest.4040BFCD4BE56621.quest_subtitle: "Brak wolnych pokoi"
	quest.4040BFCD4BE56621.title: "Honitel"
	quest.41D539DA3B3EC287.quest_desc: [
		"Słowo Goliath nie oddaje rozmiarów tej &6Honey&r Fountain. Pomyśl o czymś bardziej masywnym lub ogromnym! \\n\\nGoliath &6Honey&r Fountain to gigantyczna struktura z oceanem &6Liquid Honey&r w środku. \\n\\nMożesz nawet zwiedzać jej wnętrze, by znaleźć mnóstwo &6Honey Crystals&r i &5ametystu&r."
		"{image:atm:textures/questpics/bumblezone/bumble_goliath.png width:200 height:100 align:center}"
	]
	quest.41D539DA3B3EC287.title: "Goliath &6Honey&r Fountain"
	quest.42CB494F72FA1FD1.quest_desc: ["Wytwórz 6 &eulów&r lub &egniazd pszczół&r. Dotyczy to również &eulów&r z &l&6Productive Bee's&r!"]
	quest.454AC491FDFC3FDB.quest_desc: [
		"W przeciwieństwie do większości sześciennych mobów &6Honey Slime&r są przyjazne! \\n\\nMożna je rozmnażać za pomocą Sugar i można je... doić? Butelkami, by uzyskać &6Honey Bottles&r. Staną się jednak agresywne, jeśli je wydoisz, chyba że masz aktywne Essence of Bees. \\n\\nPo śmierci upuszczają Sugar. \\n\\nZnajdziesz je w niektórych strukturach, &bSugar Lakes&r lub czasem z hodowli &6B&8e&6e&8s&r w Brood Blocks."
		"{image:atm:textures/questpics/bumblezone/bumble_slime.png width:100 height:100 align:center}"
	]
	quest.454AC491FDFC3FDB.quest_subtitle: "Brak Royal Jelly Slimes?"
	quest.454AC491FDFC3FDB.title: "&6Honey Slimes"
	quest.4646DCF463FD913F.quest_desc: ["Zabij Withera za pomocą Stinger Spear. \\n\\nSpróbuj użyć End Exit Portal, by to oszukać."]
	quest.46FEF3DB6A5B52A0.quest_desc: [
		"Battle Cubes to loch w &6&lBumblezone&r! \\n\\nPodobnie jak Trial Chambers mają wiele pomieszczeń ze spawnerami i oczywiście łupami! \\n\\nW pomieszczeniach są Cobwebs i Wool imitujące Spider Eggs, a w nich spawnery Spider lub Cave Spider i czasem cenne łupy, jak bloki Diamond lub Emerald! \\n\\nW ostatnim pomieszczeniu są też Honey Cocoons, które mogą kryć cenne łupy, jak &5Throne Pillar Compass&r!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_cube.png width:200 height:100 align:center}"
	]
	quest.46FEF3DB6A5B52A0.title: "Battle Cubes"
	quest.4718C2728C0CA40F.quest_desc: ["Gdy trzymasz ją w drugiej ręce, zdobędziesz mnóstwo wiedzy! \\n\\nW lewym dolnym rogu zobaczysz strukturę, w której się znajdujesz, jeśli w jakiejś jesteś. \\n\\nWszystkie byty będą też podświetlone, gdy jest używana. Dotyczy to także bytów-bloków, jak skrzynie czy stojaki na zbroję. \\n\\nPo wyczerpaniu wszystkich użyć ma 15-minutowy czas odnowienia. Ma jednak wiele użyć, więc dasz sobie radę!"]
	quest.4718C2728C0CA40F.title: "&5Essence of Knowledge"
	quest.497FA7CA04117995.title: "Życie"
	quest.4A5F84912C755688.quest_desc: [
		"\"The Vengabus is coming\\nAnd everybody's jumping\\nNew York to San Francisco\\nAn intercity disco\\nThe wheels of steel are turning\\nAnd traffic lights are burning\\nSo if you like to party\\nGet on and move your body\".\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_dance.png width:200 height:100 align:center}"
	]
	quest.4A5F84912C755688.title: "Dance Floor"
	quest.4F144E5F70932C7D.quest_desc: [
		"Kolejna latająca struktura! (Chyba zauważam wzór). \\n\\nZnajdziesz tu mnóstwo łupów w Cocoons i pod Glistering Honey Crystals. \\n\\nZnajdziesz tu też mnóstwo Phantoms, stąd nazwa! Przydałoby się coś chroniącego przed obrażeniami od upadku..."
		"{image:atm:textures/questpics/bumblezone/bumble_phantasm.png width:200 height:100 align:center}"
	]
	quest.4F144E5F70932C7D.title: "Phantasm Aviary"
	quest.50150380043F97F9.title: "Lot Trzmiela"
	quest.513060836057E5B7.quest_desc: [
		"&e&lPollinated Fields&r to... APSIK... coś jak biom Plains, ale pełny &epyłku&r! APSIK... &ePyłek&r układa się jak Layered Snow, to... APSIK... piętrzy się na innym &epyłku&r i opada pod wpływem grawitacji... APSIK. Spowalnia podczas chodzenia, podobnie jak... APSIK... Powdered Snow.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_pollenfields.png width:200 height:100 align:center}"
	]
	quest.513060836057E5B7.title: "&e&lPollinated Fields"
	quest.516ECA0396621C32.quest_desc: [
		"Skąd wiemy, że jest &azielone&r? Trawa jest &azielona&r, ale występuje też w każdym innym Sanctum. &aAzaela Bushes&r i &aGreen Luminescent Ancient Wax&r pokazują, że to &azielone&r. \\n\\nPodążaj za Windy Air i mokrymi kanałami do głównej komnaty, by znaleźć &aGreen Essence&r. \\n\\nWejdź do niej, a rozpocznie się walka z bossem Rootmin. Wejdź na drugą platformę i odbijaj w niego Dirt Pellets, by obniżać jego pasek bossa na górze ekranu."
		"{image:atm:textures/questpics/bumblezone/bumble_green1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_green2.png width:200 height:100 align:center}"
	]
	quest.516ECA0396621C32.title: "&aGreen Sempiternal Sanctum"
	quest.5219D2F2B13F57F3.quest_desc: [
		"Jeden z najważniejszych, jeśli nie najważniejszy przedmiot w &6&lBumblezone&r! Buzzing Briefcase to idealny przedmiot do opieki nad &6pszc&8zoł&6ami&r. \\n\\nMożesz kliknąć prawym przyciskiem myszy &6psz&8czo&6łę&r z Briefcase, by ją w nim uwięzić. Potem możesz kliknąć prawym przyciskiem z Shiftem, by zobaczyć &6ps&8zc&6zo&8ły&r w środku. \\n\\nMieści 14 &6ps&8zc&6zó&8ł&r i to dowolnych &6ps&8zc&6zó&8ł&r, także z &lProductive Bees&r. \\n\\nMożesz tu zobaczyć ich zdrowie, imię, rodzaj &6psz&8czo&6ły&r, czy ma żądło, czy ma &epyłek&r i nie tylko! \\n\\nMożesz go też użyć, by wypuścić z niego &6ps&8zc&6zo&8ły&r."
		"{image:atm:textures/questpics/bumblezone/bumble_briefcase.png width:200 height:150 align:center}"
	]
	quest.52C7FAA044E07628.quest_desc: ["Pomyśl o Totem of Undying, a teraz pomyśl, jak można go bardzo wzmocnić. To właśnie &fEssence of Continuity&r. \\n\\nGdy masz otrzymać śmiertelny cios, zostaniesz teleportowany do swojego punktu odrodzenia z pełnym paskiem zdrowia i głodu, a złe efekty znikną. Oczywiście ratuje Ci to życie. \\n\\nOtrzymasz też dziennik opisujący, jak i gdzie byś zginął. \\n\\nPo uratowaniu Ci życia ma 40-minutowy czas odnowienia i nałoży czas odnowienia na każdą inną Essence, którą możesz mieć. "]
	quest.52C7FAA044E07628.title: "&fEssence of Continuity"
	quest.540895E6C9E724AD.quest_desc: [
		"&6&lPillars&r są jak &6&lHive Walls&r, tylko mniejsze. Po prostu tyle."
		"{image:atm:textures/questpics/bumblezone/bumble_hivepillar.png width:200 height:100 align:center}"
	]
	quest.540895E6C9E724AD.title: "&6&lHive Pillar"
	quest.5443AA65C0D0C599.quest_desc: ["Możesz je ukraść &5Bee Queen&r albo zapracować na nie, pomagając jej. Radzę jednak okazywać &5Queen&r szacunek, to przecież członkini rodziny królewskiej! \\n\\nGdy to wypijesz, otrzymasz mnóstwo wspaniałych efektów, a część okropnych zniknie. \\n\\nMożna tego też użyć na &6psz&8czo&6ła&8ch&r i Beehemothach, by nadać im efekty!"]
	quest.54D80939887B3F7D.quest_desc: ["Wymień się z &5Bee Queen&r 128 razy! \\n\\nPowodzenia!"]
	quest.55B9B9C3AA01D323.quest_desc: [
		"Wśród ogromnych &5Glistering Crystals&r w &5&lCrystal Canyon&r leży &5kryształ&r w kształcie &dkwiatu&r. \\n\\nJest piękny, niemal hipnotyzujący. Aż chce się założyć ogród pięknych &dkwiatów&r, ale wiem, że żaden z tych &dkwiatów&r nigdy nie dorówna zachwycającemu &5kryształowi&r &dkwiatu&r... \\n\\nTak czy inaczej znajdziesz mnóstwo &5Honey Crystals&r, &6miodu&r i, co najważniejsze, &5Crystalline Flowers&r!"
		"{image:atm:textures/questpics/bumblezone/bumble_overgrown.png width:200 height:100 align:center}"
	]
	quest.55B9B9C3AA01D323.title: "&5Overgrown Flower"
	quest.565EBD340595EAC4.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.571CC5558B87377D.quest_desc: [
		"Crystal Cannon to bardzo zabawna i niebezpieczna broń dodana przez &6&lBumblezone&r! \\n\\nAle jak wszystkie działa, najlepiej poćwiczyć. Cannon Range jest do tego stworzony! \\n\\nZnajdziesz tam mnóstwo dział, &5kryształów&r i celów do trafiania! Potem możesz odebrać nagrody za trafienie w Target Blocks."
		"{image:atm:textures/questpics/bumblezone/bumble_range.png width:200 height:100 align:center}"
	]
	quest.571CC5558B87377D.title: "Cannon Range"
	quest.5728D87E3240AF0D.quest_desc: [
		"Bardzo prosta struktura, &ePollinated Streams&r. To akwedukty z &bSugar Water&r!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_streams.png width:200 height:100 align:center}"
	]
	quest.5728D87E3240AF0D.title: "&ePollinated Streams"
	quest.58CC2E563F92B4C5.quest_desc: ["&cEssence of Raging&r trzymana w drugiej ręce działa jak system zleceń. \\n\\nPodświetli 4 moby, a gdy zostaną zabite, otrzymasz Strength - im więcej zabijesz, tym wyższa będzie! \\n\\nDo maksimum 16. \\n\\nPo użyciu ma jednak czas odnowienia 30 minut."]
	quest.58CC2E563F92B4C5.title: "&cEssence of Raging"
	quest.5B4397D4EC23E702.quest_desc: [
		"Idealne miejsce dla wszystkich wojowników &6psz&8cz&6ół&r! \\n\\nTutaj możesz zdobyć Stinger Spear i zaklęcia do niego!"
		"{image:atm:textures/questpics/bumblezone/bumble_stingy.png width:200 height:100 align:center}"
	]
	quest.5B4397D4EC23E702.title: "Stinger Spear Shrine"
	quest.5C040191740A53C8.quest_desc: [
		"Jej &5Wysokość&r, &5Bee Queen&r.\\n\\nAbsolutny kolos wśród pszczół, tak ogromna, że sama nie może się nawet ruszyć.\\n\\nPo spotkaniu poprosi Cię o zdobycie dla niej konkretnego przedmiotu. Jeśli to zrobisz, otrzymasz specjalną nagrodę.\\n\\nPoza tym, teraz, gdy ją poznałeś, możesz z nią handlować (sprawdź wszystkie wymiany w JEI) i spełniać jej życzenia.\\n\\nAby posunąć się dalej w Bumblezone, potrzebujesz Essence of Bees, którą zdobywasz, wykonując wszystkie 16 jej zadań.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_queen.png width:200 height:100 align:center}"
	]
	quest.5C040191740A53C8.title: "&5Jej Wysokość"
	quest.5E180764FBEE666B.quest_desc: [
		"Bardzo wyjątkowy i przydatny blok dodany przez &6&lBumblezone&r, który rzadko można znaleźć w niektórych strukturach, najłatwiej w &5Overgrown Flower&r! \\n\\nTo skomplikowany blok, więc słuchaj uważnie. &5Flower&r służy do zaklinania Books i ma poziomy, które trzeba odblokować, by używać zaklęć. \\n\\nBy zdobyć wyższe poziomy, musisz karmić &5Flower&r przedmiotami lub XP. Potem możesz włożyć Book lub Enchanted Book i wybrać zaklęcie, które chcesz na niej umieścić."
		"{image:atm:textures/questpics/bumblezone/bumble_flower.png width:175 height:200 align:center}"
	]
	quest.5E180764FBEE666B.title: "&5Crystalline Flower"
	quest.5F834F8C607A8B77.quest_desc: ["Musisz je znaleźć w strukturach w &6&lBumblezone&r albo wymienić z &5Bee Queen&r, by zdobyć jedną sztukę! \\n\\nGdy je nosisz, możesz przytrzymać spację, by chwilę latać. \\n\\nTyle że, podobnie jak u &6psz&8czo&6ły&r, skrzydła są zbyt małe, by utrzymać Twoje grube ciałko nad ziemią."]
	quest.6013C6B2E0B81D73.quest_desc: [
		"Na zewnątrz &6&lHive Walls&r i &6&lPillars&r znajdziesz coś, co nazywam &6Bee-Daycares&r.\\n\\nSą tam &6Honey Blocks&r i Honeycomb Brood Blocks! W pewnym stadium pojawiają się w nich młode &6B&8e&6e&8s&r. \\n\\nMożesz je karmić: butelkami &bSugar Water&r, &6Honey Bottles&r lub Bee Bread. Ma 4 etapy, a po nakarmieniu w czwartym wyskakuje młoda &6B&8e&6e&r. Czasem pojawiają się też &6Honey Slime&r!\\n\\nPusty Brood Block możesz zanieść do &5Bee Queen&r, by go napełnić!\\n\\nGdy nakarmisz je wystarczająco, otrzymasz Protection of the Hive. Jeśli je wyjmiesz, dostaniesz Wrath of the Hive.\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_daycare.png width:200 height:100 align:center}"
	]
	quest.6013C6B2E0B81D73.title: "&6Daycares"
	quest.612157986673F815.quest_desc: ["Nakarm &8ps&6zc&8zo&6ły&r lub &8psz&6czo&8łę&r czymkolwiek poza &dkwiatami&r 48 razy!"]
	quest.613AC4DF39E5621D.quest_desc: [
		"Gazebuzz Cluster to skupisko dziesiątek i dziesiątek wiszących, niepołączonych ze sobą pomieszczeń. \\n\\nNie mogłem wymienić wszystkiego, co jest w pomieszczeniach, bo pisałbym cały dzień! Ale mogę podsumować: są tam pokoje z &6Honey&r, Leaves, łupami, a nawet zabawnymi pułapkami! \\n\\nPowinieneś więc uważać, zwłaszcza przy &6Honey&r i Paintings..."
		"{image:atm:textures/questpics/bumblezone/bumble_cluster.png width:200 height:100 align:center}"
	]
	quest.613AC4DF39E5621D.title: "Gazebuzz Cluster"
	quest.61500C8F68509E5D.quest_desc: [
		"Podczas pierwszej wizyty w &d&lFloral Meadows&r możesz nawet nie zauważyć tych małych kumpli ukrytych w trawie. \\n\\nRootmin udają Grass Blocks z &dkwiatami&r na głowie. \\n\\nJeśli nie nosisz Bee Armor, mogą strzelać w Ciebie Dirt Pellets, gdy będziesz przechodzić obok. \\n\\nMożesz zmienić &dkwiat&r na ich głowie, klikając ich prawym przyciskiem myszy z innym kwiatem!"
		"{image:atm:textures/questpics/bumblezone/bumble_rootmin2.png width:100 height:150 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_rootmin1.png width:100 height:100 align:center}"
	]
	quest.61500C8F68509E5D.title: "Rootmin"
	quest.61768CFEDA041E4D.quest_desc: ["Gdy już wejdziesz do &6&lBumblezone&r, możesz potrzebować powrotu do &2Overworldu&r. Na przykład na wypadek, gdybyś zostawił włączoną kuchenkę! \\n\\nAby wydostać się z &6&lBumblezone&r, możesz kopać w dół lub w górę, za &eBeehive Beeswax&r, by wejść w Void. \\n\\nTen Void Cię nie zabije, zamiast tego teleportuje Cię z powrotem tam, gdzie byłeś w &2Overworldzie&r!"]
	quest.61768CFEDA041E4D.quest_subtitle: "Wypuść mnie stąd!"
	quest.61768CFEDA041E4D.title: "Ucieczka"
	quest.6434796EAAF2A4EC.quest_desc: ["Po ukończeniu wszystkich tych zadań możesz kliknąć prawym przyciskiem myszy &5Queen&r, by dostać Essence of Bees. \\n\\n&lZjedz ją!&r \\n\\nTeraz możesz tu praktycznie robić wszystko. Możesz bezpiecznie zabierać &6Honey&r ze wszystkich &eHives&r, &6Honeycombs&r i od &6Honey Slime&r. Możesz przechodzić przez Cell Maze bez Wrath of the Hive, wchodzić do &5Throne Pillar&r bez Mining Fatigue i chodzić po Ancient Wax bez okropnych efektów. A gdy wejdziesz w &6Fluid Honey&r lub Royal Jelly, otrzymasz niesamowite efekty. \\n\\nNajlepsze jest to, że zostaje z Tobą nawet po śmierci! Teraz możesz wkroczyć do endgame!"]
	quest.6474FE12450A4A7D.quest_desc: [
		"&5Throne Pillar&r wygląda podobnie do &6&lHive Pillar&r, ale ten jest bogato ozdobiony &5kryształami&r, pajęczynami i &6Honeycombs&r w eleganckich wzorach. \\n\\nW środku &5Pillar&r znajduje się Throne Room, w którym spotkasz..."
		"{image:atm:textures/questpics/bumblezone/bumble_throne.png width:200 height:100 align:center}"
	]
	quest.6474FE12450A4A7D.title: "Throne Pillar"
	quest.64FEF31955CB158D.quest_desc: ["Uderz &dkwiaty&r za pomocą &ePollen Puffs&r, aby pojawiło się 8 kolejnych &dkwiatów&r."]
	quest.65D993EB95726067.title: "Strzeż się Świątyni"
	quest.67A0F6661D658A52.quest_desc: ["Można go znaleźć w każdym z 3 poprzednich zadań, ale zawsze pojawia się w Cell Maze. \\n\\nWskaże Ci najbliższy &5Throne Pillar&r. Podążaj za tym &5kompasem&r!"]
	quest.680E960554CEE76B.quest_desc: [
		"Te piękne &5&lCanyons&r otoczone &6&lHive Walls&r są pełne... zgadłeś! &5Kryształów&r! \\n\\nPodłoga jest zrobiona z &eCarvable Wax&r, a reszta jest pełna małych &5Honey Crystals&r i ogromnych &5Glistering Honey Crystals&r."
		"{image:atm:textures/questpics/bumblezone/bumble_canyon.png width:200 height:100 align:center}"
	]
	quest.680E960554CEE76B.title: "&5&lCrystal Canyons"
	quest.6BC0904E03683190.quest_desc: ["Rozmnóż &8ps&6zc&8zo&6ły&r, aby uzyskać 8 nowych &8ps&6zc&8zó&6ł&r."]
	quest.6C5D61A704DC125A.quest_desc: [
		"To zabawny przedmiot; możesz go znaleźć, wytworzyć lub wymienić.\\n\\nPotem możesz go ufarbować na dowolny kolor i oczywiście nosić na głowie!\\n\\n&6Ps&8zc&6zo&8ły&r pomyślą wtedy, że jesteś kwiatem, i będą za Tobą podążać.\\n\\nPoza tym wyglądasz jak Daffy z \"Duck Amuck\"."
		"{image:atm:textures/questpics/bumblezone/bumble_duckamuck.png width:100 height:100 align:center}"
	]
	quest.719D5CEB4217B734.quest_desc: [
		"To dom w kształcie &8psz&6czo&8ły&r! \\n\\nDom &8psz&6czo&8ły&r! \\n\\nSą w nim bardzo proste łupy, &6miód&r i czasem mieszkaniec - &8psz&6czo&8ła&r!\\n"
		"{image:atm:textures/questpics/bumblezone/bumble_house.png width:200 height:100 align:center}"
	]
	quest.719D5CEB4217B734.title: "&8B&6e&8e&r House"
	quest.7208CB011F6E2ACF.quest_desc: ["Można je znaleźć w strukturach w &l&6Bumblezone&r lub wymienić u &5Bee Queen&r! \\n\\nTe Carpenter Bee Boots są naprawdę niesamowite - możesz biegać po ścianach lub skakać dalej, odbijając się od Wood Planks, Leaves i &6Honey Blocks&r. \\n\\nPoza tym, gdy trzymasz Shift, buty będą kopać blok pod Tobą."]
	quest.7231F6177EEF5BF0.quest_desc: [
		"Mnóstwo kolorowych rur, idealnych do transportu &6ps&8zc&6zó&8ł&r lub Ciebie! \\n\\nWindy Air zabierze Cię wszędzie w Subways, nawet do pomieszczeń pełnych łupów!"
		"{image:atm:textures/questpics/bumblezone/bumble_subway.png width:200 height:100 align:center}"
	]
	quest.7231F6177EEF5BF0.title: "Subway"
	quest.72489FB9D9A5A24B.quest_desc: ["Można je znaleźć w strukturach w &l&6Bumblezone&r lub wymienić u &5Bee Queen&r! \\n\\nTe Carpenter Bee Boots są naprawdę niesamowite - możesz biegać po ścianach lub skakać dalej, odbijając się od Wood Planks, Leaves i &6Honey Blocks&r. \\n\\nPoza tym, gdy trzymasz Shift, buty będą kopać blok pod Tobą."]
	quest.72569275EDE9FA23.quest_desc: ["Rozmnóż razem 6 &6Honey Slime&r za pomocą Sugar."]
	quest.72917C96C322A922.title: "La Bee-da Loca"
	quest.73C7F57B90731010.quest_desc: [
		"Wspaniale zaprojektowana struktura fontanny z płynącym &6miodem&r i &bSugar Water&r."
		"{image:atm:textures/questpics/bumblezone/bumble_fountain.png width:200 height:100 align:center}"
	]
	quest.73C7F57B90731010.title: "&6Honey&r Fountain"
	quest.74D4E51A6381DB24.title: "Eyes Banner Pattern"
	quest.75ACC8CF5873F92D.quest_desc: [
		"White Luminescent Ancient Wax oraz białe i '&7jasnoszare&r' kwiaty mówią nam, że to White Sempiternal Sanctum. \\n\\nCałe miejsce wygląda waniliowo i ma smak &6miodu&r, przez co robię się głodny. \\n\\nPrzechodź przez pomieszczenia, by znaleźć White Essence. \\n\\nMusisz odeprzeć 6 Cosmic Crystal Entities. Wszystkie mają 60 serc i otrzymują tylko 1 obrażenie od uderzenia dowolną bronią."
		"{image:atm:textures/questpics/bumblezone/bumble_white1.png width:200 height:100 align:center}"
		"{image:atm:textures/questpics/bumblezone/bumble_white2.png width:200 height:100 align:center}"
	]
	quest.75ACC8CF5873F92D.title: "&fWhite Sempiternal Sanctum&r"
	quest.772C65FC32AECD6B.title: "Peace Banner Pattern"
	quest.7834734E79E41A3A.quest_desc: ["Rozważ rezygnację z gry z modyfikacją &l&6Bumblezone&r, jeśli cierpisz na którąś z tych fobii: \\n\\nMelissofobia, apifobia, entomofobia, arachnofobia, trypofobia, akrofobia, klaustrofobia i krystalofobia. \\n\\nJeśli cierpisz na trypofobię, możesz użyć paczki zasobów dodanej przez &l&6Bumblezone&r, aby sobie pomóc! Jeśli to cokolwiek innego, masz przechlapane."]
	quest.7834734E79E41A3A.quest_subtitle: "Pszczel-ostrożnie!"
	quest.786073B57C901DB7.title: "Pluses Banner Pattern"
	quest.78B7FC6A868F5C4D.quest_desc: ["Musisz je znaleźć w strukturach w &6&lBumblezone&r albo wymienić z &5Bee Queen&r, by zdobyć jedną sztukę! \\n\\nGdy je nosisz, możesz przytrzymać spację, by chwilę latać. \\n\\nTyle że, podobnie jak u &6psz&8czo&6ły&r, skrzydła są zbyt małe, by utrzymać Twoje grube ciałko nad ziemią."]
	quest.78E40BDB0E54B638.quest_desc: ["Można je znaleźć w strukturach w &6&lBumblezone&r lub wymienić z &5Bee Queen&r! \\n\\nNie cierpisz utykać na &6Honey Blocks&r? Albo gdy &epyłek&r Cię spowalnia? Nie bój się, Honey Bee Leggings są tutaj! Pomogą Ci lepiej poruszać się po tych blokach. Im więcej elementów Bee Armor nosisz, tym łatwiej będzie się podróżować! \\n\\nMożesz też przemykać przez &epyłek&r z wciśniętym Shiftem, by go zbierać! "]
	quest.79FF12D7A4C8E821.quest_desc: [
		"Po 7 &b&lSugar Seas&r żegluje niebezpieczny &bPirate Ship&r pod dowództwem przerażającego kapitana. \\nNa dolnym pokładzie przebywają nawigatorzy. \\nPrzy broni w ładowni trzyma się kwatermistrz. \\n\\nWszędzie na &bstatku&r znajdziesz łupy z wielu przygód piratów!"
		"{image:atm:textures/questpics/bumblezone/bumble_pirates.png width:200 height:100 align:center}"
	]
	quest.79FF12D7A4C8E821.title: "&bPirate Ship"
	quest.7C7C0D3D7FCB0297.quest_desc: ["Można go znaleźć w strukturach w &6&lBumblezone&r lub wymienić z &5Bee Queen&r! \\n\\n&6Ps&8zc&6zo&8ły&r mają dość ciekawy sposób znajdowania się nawzajem i komunikowania. Nie wiem, jak to robią, więc zgaduję, że ich czułki wysyłają i odbierają sygnały radiowe. \\n\\nGdy nosisz Stingless Bee Helmet, możesz wcisnąć Shift, by podświetlić wszystkie &6ps&8zc&6zo&8ły&r wokół Ciebie. \\n\\nPoza tym, gdy go nosisz, trucizna i nudności ustępują szybciej."]
	task.030FFC7C0532E7B2.title: "Zabij 3 Honey Slime"
	task.1256A95F7D5C782F.title: "Comb Blocks z Productive Bees"
	task.1884D3DA3CCC1439.title: "AllRightsReserved"
	task.37C196344D9FD2C3.title: "Zabij 1 Beehemoth"
	task.386645685E595D4D.title: "ALERT FOBII"
	task.4E6F5A4B1FE8CB23.title: "Zabij 5 Rootmin"
	task.5F9F725E2AD5FD3C.title: "AllRightsReserved"
	task.646B54EB48AFB6A4.title: "Zabij 10 Wariantów Bee"
}
