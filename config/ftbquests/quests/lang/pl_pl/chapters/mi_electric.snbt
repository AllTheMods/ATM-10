{
	quest.068128395837AF4F.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.08C870DC50CA49FC.quest_desc: [
		"&#5C5C5CCrude Oil&r sama w sobie niewiele nam się przyda, ale po przepuszczeniu przez destylarnię otrzymujemy produkty, które można wykorzystać na wiele sposobów."
		""
		"Możemy z niej wyprodukować &#C4C241Sulfuric Heavy Fuel&r, &#CECC5FSulfuric Light Fuel&r i &#D9D782Sulfuric Naptha&r."
	]
	quest.08C870DC50CA49FC.title: "&#5C5C5CPrzetwarzanie Crude Oil"
	quest.0903F0D8642449B7.quest_desc: ["Przechodząc od &6układów analogowych&r, możemy teraz przetwarzać więcej niż 2 bity informacji. To otwiera horyzonty dla nowych maszyn."]
	quest.0A9ADDE68342B987.quest_desc: [
		"Aby wytworzyć &#43DEC2Polyethylene&r, musisz przejść przez następujący łańcuch chemikaliów:"
		""
		"&8Crude oil&r -> &#D2CD2DSulfuric Light Fuel&r-> &#DBD658Light Fuel&r-> &#E2DF78Steam Cracked Light fuel&r -> &#44D1DBEthylene&r -> &#43DEC2Polyethylene&r."
	]
	quest.0C94D76B87E49FFD.title: "Przetwarzanie Żelaza"
	quest.103728F2BAD5AE84.title: "Zaawansowane Komponenty"
	quest.1351D0594F1E6551.quest_desc: ["Te &#55EDA4podstawowe komponenty&r poprowadzą nas do kolejnego przełomu w przetwarzaniu."]
	quest.1351D0594F1E6551.title: "Komponenty Układów"
	quest.162807D14C173CB4.quest_desc: ["&#5599EDCentrifuge&r potwierdziła naszą teorię: jeśli zakręcisz czymś wystarczająco szybko, wypadnie z tego nowy materiał. Ma wiele zastosowań, ale będziesz jej potrzebować głównie do przetwarzania &#F2AAE5Chromium&r i &#AD3497Monazite&r. "]
	quest.162807D14C173CB4.quest_subtitle: "You spin my head right round right round.."
	quest.1745124F83D033B9.title: "Podstawowe Komponenty"
	quest.18C0EF38430C3E67.quest_subtitle: "The Digital Age"
	quest.1A84DF4478D55C41.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.1B4CD5AC8F6C3307.quest_desc: ["&#4497DBOverdrive module&r zachowuje wydajność maszyny nawet wtedy, gdy receptura nie jest aktualnie wykonywana. W zamian blokuje maszynę na jej bieżącej recepturze i sprawia, że zawsze zużywa energię."]
	quest.1E0EF28175A7424F.quest_desc: ["Skoro już produkujesz parę, czemu nie użyć jej do wytwarzania elektryczności? Wystarczy postawić &#6363DBTurbine&r, wlać &7parę&r i wyciągnąć &#DBDB63elektryczność&r."]
	quest.1E0EF28175A7424F.quest_subtitle: "Para -> Elektryczność"
	quest.1F21B578FAF4CCAC.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.1F3E18129B871C49.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.22AD9DF2BCC04575.quest_subtitle: "Wytwarzanie energii"
	quest.22AD9DF2BCC04575.title: "Wytwarzanie Elektryczności"
	quest.256C3DBA392B4236.quest_desc: ["Elektroliza Acidic Solutions dla Manganese i Chromium da Ci ich pyły (Dusts), które można wykorzystać w dalszych recepturach."]
	quest.256C3DBA392B4236.quest_subtitle: "9 Tiny Dusts daje 1 Dust"
	quest.2EF0C033C540A7B1.title: "Przetwarzanie Ruby"
	quest.32D585D9F73CD9FD.quest_desc: ["&#EDDF55Electric Blast Furnace&r pozwoli Ci przetopić kilka różnych surowców. Receptury wymagają użycia w strukturze &#B8ED55odpowiedniej cewki&r."]
	quest.374C06B3999BB0D3.quest_desc: ["Zmieszanie &#C2C78BIron&r, &#EDB2EAChromium&r, &#BEC9A3Nickel&r i &7Manganese&r da Ci &#ADF0EEStainless Steel Dust&r."]
	quest.3A03852E282DAA4D.quest_desc: ["&#ED8055Electrolyzer&r potrafi dostarczyć w impulsach tyle energii, że materiały rozpadają się na bardziej podstawowe surowce."]
	quest.3B9D9CB589DB2003.quest_desc: [
		"Maszyny &#71EBB4&nModern Industrialization&r działają inaczej niż w innych modach. Wszystkie maszyny mają &#E5EB71mnożnik wydajności&r, który rośnie, gdy maszyna wykonuje recepturę. &#E5EB71Wydajność&r zwiększa &#E5EB71szybkość&r maszyny. &#E5EB71Wydajność&r zeruje się po zmianie receptury."
		""
		"Zaleca się używanie 1 maszyny do 1 receptury, by pasywnie produkować komponenty. Tak właśnie należy grać w tego moda. Ulepszenia sprawią, że system będzie lepszy. Omówimy to w przyszłości."
		""
		"{image:atm:textures/questpics/modernindustrialization/prod_line.png width:100 height:100 align:center}"
		""
		"{@pagebreak}"
		"Wszystkie maszyny z tego moda przyjmują FE jako energię. &c16 FE&r przelicza się na &#E1EB591 EU&r energii."
	]
	quest.3B9D9CB589DB2003.quest_subtitle: "To pomoże"
	quest.3CE72DAF431269CD.quest_desc: ["&#D6AC2FPolarizer&r potrafi namagnesować wkładane do niego materiały."]
	quest.3EB39C72800A741D.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.401A3FD6A3511870.quest_subtitle: "Sezamie, otwórz się"
	quest.401A3FD6A3511870.title: "Bramy"
	quest.401B559649C54C5C.quest_desc: ["Zmieszanie &#92CCF0Hydrogen&r i &#519BC9Chlorine&r da Ci &#4FB373Hydrochloric Acid&r. Posłuży ona do przetwarzania &#F2A0E1Chromium Dust&r."]
	quest.408EBED932656006.quest_desc: ["Domieszkowanie &7Silicon&r da znacznie lepszą wydajność niż użycie zwykłego &7Silicon&r."]
	quest.408EBED932656006.title: "Domieszkowany Krzem"
	quest.413F338DB07BA88C.quest_subtitle: "To samo co przy parze"
	quest.4A5A143A79809BB6.quest_desc: [
		"Ach tak, w końcu Ci się udało. Witaj w Erze Elektryczności, to prawdziwy początek Twojej przygody."
		""
		"Najpierw potrzebujemy Battery Alloy... do wytwarzania baterii, to szokujące, wiem."
	]
	quest.4A5A143A79809BB6.quest_subtitle: "Battery Alloy"
	quest.4A5A143A79809BB6.title: "Era Elektryczności"
	quest.4E7B1B16C7CDA84C.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.532BCAB3FBF91B1D.quest_desc: [
		"&#44DB9CUpgrades&r dają maszynom możliwość przejścia w stan &#4467DBprzetaktowania&r, co jeszcze bardziej zwiększa maksymalną szybkość maszyny."
		""
		"Maszyna może przyjąć do stacka ulepszeń dowolnego poziomu. &#CEDB44Basic Upgrade&r zwiększa pojemność o &#F7F448+2EU/t&r za każde ulepszenie."
	]
	quest.548274CC00E67EC4.quest_desc: ["Przesyłanie elektryczności jest proste: wystarczy położyć kabel pomiędzy swoimi &#F5B027Generators&r a &#3CC1FAMachines&r. Kable LV mogą przesłać co najwyżej &#EEFA3C256 EU/t&r."]
	quest.548274CC00E67EC4.quest_subtitle: "Limity kabli"
	quest.548274CC00E67EC4.title: "Kable LV"
	quest.54CE9493B63620C4.quest_desc: ["&#AC59EBDiesel Generator&r zamienia różne paliwa płynne na elektryczność. Na początku najłatwiej dostępne będą dla Ciebie &7Creosote Oil&r i &8Synthetic Oil&r."]
	quest.54CE9493B63620C4.quest_subtitle: "Paliwa płynne -> Elektryczność"
	quest.55BB4005BB4CA316.title: "Przetwarzanie Monazite"
	quest.5A62260FB3850092.quest_desc: ["Zmieszanie &eSulfur&r, &#6ACDE6Oxygen&r i &9Water&r da Ci &#D3D955Sulfuric Acid&r. Posłuży ona do przetwarzania &7Manganese Dust&r."]
	quest.5AA8D2A1F3618615.quest_subtitle: "Przesyłanie elektryczności"
	quest.5B50AC47957F0CD7.quest_desc: ["&7Oil Rig&r wywierci dla Ciebie &#7A7A7AShale Oil&r i &#918686Crude Oil&r."]
	quest.5B50AC47957F0CD7.quest_subtitle: "Dźwięki orła"
	quest.5D404ED40C6C2690.quest_subtitle: "Więcej energii na wejściu"
	quest.604C003EE6B1CC6B.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.6256612D46C88C0C.quest_desc: [
		"&#723CFATransformers&r zamieniają jeden zakres energii na inny. "
		""
		"&#723CFATransformers&r z &#EBC471LV&r na &#DDE548MV&r: zamieniają energię &#EBC471LV&r na energię &#DDE548MV&r; mają 5 wejść i 1 wyjście."
		""
		"&#723CFATransformers&r z &#DDE548MV&r na &#EBC471LV&r: zamieniają energię &#DDE548MV&r na energię &#EBC471LV&r; mają 1 wejście i 5 wyjść."
	]
	quest.6256612D46C88C0C.quest_subtitle: "\"Wolność jest prawem wszystkich istot rozumnych\""
	quest.6256612D46C88C0C.title: "Transformers LV-MV"
	quest.6647A9652EFDDCDF.quest_desc: ["Aby schłodzić &#ADF0EEHot Stainless Steel Ingot&r, po prostu włóż go do &#56E3DFVacuum Freezer&r, a zamieni się w użyteczny &#ADF0EEStainless Steel Ingot&r."]
	quest.66D4256F79D5B30B.quest_subtitle: "To samo co przy parze, tylko jeden"
	quest.6A25ED4059E224D2.quest_desc: [
		"&#ED5585Distillery&r służy do destylowania niektórych płynów, aby otrzymać lepsze, bardziej odpowiednie dla nas produkty. "
		""
		"Musisz zablokować recepturę, aby dostać to, czego chcesz, jeśli z jednego wsadu powstaje wiele produktów. Najpierw kliknij ikonę kłódki w GUI, potem kliknij strzałkę, a następnie ikonę &7'+'&r przy wybranej recepturze. "
	]
	quest.6A25ED4059E224D2.quest_subtitle: "Zablokuj recepturę"
	quest.6E7DF4AF86A036EC.title: "Przetwarzanie Shale Oil"
	quest.72FFD9E471242D68.quest_desc: ["Stainless Steel wymaga do przetopienia więcej ciepła niż zwykły piec. Musimy użyć naszego wcześniej zbudowanego Electric Blast Furnace."]
	quest.744E620B7DEBB483.quest_desc: ["&#27CFF5Vacuum Freezer&r posłuży do schładzania &#E6AD1EHot Ingots&r albo niektórych płynów, aby uzyskać lepsze proporcje przedmiotów, które już produkujesz."]
	quest.744E620B7DEBB483.quest_subtitle: "Bing Chilling"
	quest.76660075F254597E.quest_desc: ["&#F5B758Advanced Upgrade&r zwiększa maksymalne zużycie o &#EDE02F16 EU/t&r za każde ulepszenie."]
	quest.7E3B19796870C2B1.quest_desc: ["&#9955EDChemical Reactor&r będzie jedną z najprzydatniejszych maszyn w dalszej grze. Posłuży do wytwarzania kilku chemikaliów."]
	quest.7EDBE88A2CFAB353.quest_desc: [
		"&#562FD6Assemblers&r służą do wytwarzania wielu komponentów i maszyn. Potrafią automatycznie wykonywać zadania wytwarzania."
		"Oferują też &amuch tańsze&r warianty niektórych receptur, których już używałeś."
	]
	quest.7EDBE88A2CFAB353.quest_subtitle: "Będziesz potrzebować ich wielu"
	quest.7FE5864E59D7B827.quest_desc: ["&#6784EBHulls&r kontrolują ilość energii, jaką można wpompować do maszyny. W miarę wkładania ulepszeń do maszyny będziesz potrzebować w niej &#6784EBHull&r wyższego poziomu, aby przyjmowała więcej energii. Poziom &#6784EBHull&r wpływa też na to, jaki kabel można do niego podłączyć."]
	quest.7FE5864E59D7B827.quest_subtitle: "Podstawowy element budulcowy"
	task.12433760FD40CB3A.title: "Przeczytaj To Uważnie"
	task.1489DD401D237541.title: "Elektryczność"
	task.1FE598387B609AE5.title: "Przesył Elektryczności"
