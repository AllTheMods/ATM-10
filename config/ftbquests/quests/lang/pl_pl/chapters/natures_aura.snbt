{
	quest.05E668CE6687AC64.quest_desc: ["&bToken of Joy&r to pierwszy Token, który powinieneś wytworzyć. Tokeny są ważnymi materiałami do wytwarzania przedmiotów w &aNature's Aura&r."]
	quest.05E668CE6687AC64.title: "&bToken of Joy"
	quest.0B6D35F5B3A11FD2.quest_desc: ["&9Aura Cache&r służy do przechowywania &aaury&r!"]
	quest.0B6D35F5B3A11FD2.quest_subtitle: "Zbieramy do skrytki!"
	quest.0B6D35F5B3A11FD2.title: "&9Aura Cache"
	quest.0EFD0A4AE82153E8.quest_desc: ["Te Tokeny też będziesz musiał wytworzyć do innych przedmiotów."]
	quest.0EFD0A4AE82153E8.title: "Inne Tokeny"
	quest.0FD26FD88E801C0E.quest_desc: ["Za pomocą &2Altar of Birthing&r możesz stworzyć dużą liczbę vanillowych mobów. &dSpirits of Birthing&r powstają przez rozmnażanie zwierząt na obszarach z dużą ilością aury. "]
	quest.0FD26FD88E801C0E.quest_subtitle: "Magiczne robienie dzieci"
	quest.0FD26FD88E801C0E.title: "&2Altar of Birthing"
	quest.12D3C7FC4B3DAB23.quest_desc: ["&bEnvironmental Eye&r można wytworzyć za pomocą &aRitual of the Forest&r. Noszony w slocie Charm pokazuje poziomy aury w lewym górnym rogu ekranu."]
	quest.12D3C7FC4B3DAB23.quest_subtitle: "Oko na środowisko"
	quest.1ABEC7DE47BD6286.quest_desc: ["&5Ender Crates&r to &5Ender Chests&r, których można używać do przenoszenia przedmiotów.\\n\\n&5Ender Oculars&r to podręczne wersje &5Ender Crates&r, trzymane w ręku."]
	quest.1ABEC7DE47BD6286.quest_subtitle: "Tu i tam!"
	quest.1ABEC7DE47BD6286.title: "&5Ender Crates i Oculars"
	quest.1D39634260A47C9A.quest_desc: ["Jeśli użyjesz &2Infused Iron Ingots&r albo &6Tainted Gold Ingots&r na Offering Table, otrzymasz &bIngots of the Skies&r."]
	quest.1D39634260A47C9A.title: "&bIngots of the Skies"
	quest.20F9EF925DB1CE05.quest_desc: ["&2Natural Altar&r to struktura typu multiblok zbudowana z 1 &2Natural Altar&r, 20 Planks, 16 Stone Bricks, 8 &eGolden Stone Bricks&r i 4 Chiseled Stone Bricks.\\n\\nNatural Altar zużywa aurę przy każdej recepturze i jest potrzebny, aby dalej postępować w modzie.\\n\\nObraz po prawej stronie tego zadania pokazuje ustawienie multibloku."]
	quest.20F9EF925DB1CE05.title: "&2Natural Altar"
	quest.22ADCF96AE3E609B.quest_desc: ["&dAncient Saplings&r powstają za pomocą &aRitual of the Forest&r. Gdy urosną, drzewa starają się utrzymywać normalny poziom aury (nie za wysoki i nie za niski).\\n\\nJeśli aura spadnie, liście zaczną gnić i odwrócą ten proces."]
	quest.22ADCF96AE3E609B.quest_subtitle: "To nie te Ancient Saplings"
	quest.22ADCF96AE3E609B.title: "Ancient Trees"
	quest.24599D45F5D1606E.quest_desc: ["&bAura Trove&r to ulepszona wersja &9Aura Cache&r."]
	quest.24599D45F5D1606E.quest_subtitle: "Skarbiec!"
	quest.24599D45F5D1606E.title: "&bAura Trove"
	quest.2B4D4E741D855B5A.quest_desc: ["Połączenie w siatce wytwarzania 2 &bIngots of the Skies&r, 2 &6Tainted Gold Ingots&r i 1 &5Netherite Scrap&r da &dIngots of the Depths&r."]
	quest.2B4D4E741D855B5A.title: "&dIngots of the Depths"
	quest.34ABEF75AE1E5A0F.quest_desc: ["Staff of Ancient Knowledge używa aury, aby podświetlić pobliskie &5Ancient Debris&r."]
	quest.34ABEF75AE1E5A0F.quest_subtitle: "Wyszukiwacz Netherytu"
	quest.3C2F5AB815A6C949.quest_desc: ["Aby wytworzyć &2Infused Iron Ingot&r, połóż sztabkę żelaza na &2Natural Altar&r.\\n\\nTen proces będzie szybszy niż w przypadku &6Tainted Gold."]
	quest.3EC90ADA4E322B14.quest_desc: ["Aby wytworzyć &6Tainted Gold Ingot&r, połóż &esztabkę złota&r na &2Natural Altar&r.\\n\\nTen proces potrwa dłużej niż w przypadku &2Infused Iron&r."]
	quest.3EC90ADA4E322B14.quest_subtitle: "Skaź to złoto!"
	quest.3EC90ADA4E322B14.title: "&6Tainted Gold"
	quest.3F8A5CBEAE024748.quest_desc: ["Eye of the Pillager, Eye of the Blaze i Eye of the Shulker służą do lokalizowania konkretnych struktur."]
	quest.3F8A5CBEAE024748.quest_subtitle: "Mam Cię na oku"
	quest.3F8A5CBEAE024748.title: "Wyszukiwacze Struktur"
	quest.497AE687B7E95DE8.quest_desc: [
		"&aRitual of the Forest&r wykonuje się, budując multiblok z 8 Wooden Stands, 16 &eGold Powder&r i Oak albo Jungle Sapling, w zależności od receptury.\\n\\nAby rozpocząć rytuał, połóż przedmioty potrzebne do receptury na Wooden Stands, a pośrodku wyhoduj potrzebną sadzonkę. &eGold Powder&r jest zużywany w recepturze, więc będziesz go potrzebować dużo."
		"{image:atm:textures/questpics/natures_aura/forest_ritual.png width:295 height:150 align:center}"
	]
	quest.497AE687B7E95DE8.title: "&aRitual of the Forest"
	quest.4AD4FDF70B9BFCC9.quest_desc: ["Użycie Tokenów na Offering Table ulepszy je. Takie ulepszone Tokeny będą potrzebne do bardziej zaawansowanych receptur."]
	quest.4AD4FDF70B9BFCC9.title: "Ulepszone Tokeny"
	quest.4F03B152479C4AC0.quest_desc: ["&bStaff of Riches&r używa aury, aby podświetlić wszystkie pojemniki w promieniu 64 bloków na około 1 minutę.\\n\\nMoże to być bardzo przydatne, jeśli szukasz skrzyń z łupem albo jeśli zostawiłeś gdzieś skrzynię w kopalni."]
	quest.4F03B152479C4AC0.title: "&bStaff of Riches"
	quest.4F9D6109EEA5D26A.quest_desc: ["Zniszczenie &eGolden Leaves&r daje dużą szansę na drop &eGold Leaf&r, który jest potrzebny do &eGold Powder&r. "]
	quest.4F9D6109EEA5D26A.quest_subtitle: "Aura ze świetlikami"
	quest.4F9D6109EEA5D26A.title: "&eGold Leaves"
	quest.54F7AD64A403C9BF.quest_desc: ["Te Catalysts można dodać jako zwieńczenia filarów do swojego &2Natural Altar&r. Pozwalają zamieniać więcej przedmiotów w inne albo je rozkładać.\\n\\nCrumbling Catalyst pozwala zamienić każdy Gold Leaf w 4 Gold Powder zamiast 2! "]
	quest.54F7AD64A403C9BF.title: "Katalizatory"
	quest.5A011CE8EEA3F9D8.quest_desc: ["Aurę można zabutelkować, klikając prawym przyciskiem myszy w powietrze z Bottle and Cork. Aura przybiera różne formy w zależności od miejsca, w którym ją zebrano.\\n\\nW Overworldzie zostaje zabutelkowana jako &aSunlight&r, w Netherze jako &4Ghosts&r, a w Endzie jako &0Darkness&r.\\n\\nJeśli na obszarze, w którym użyłeś Bottle and Cork, panuje poważny niedobór aury, otrzymasz &0Bottled Vacuum&r."]
	quest.5A011CE8EEA3F9D8.quest_subtitle: "Butelkowanie aury"
	quest.5A011CE8EEA3F9D8.title: "Butelki Aury"
	quest.5A0EB2ADEBC7EE2B.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.5C990F7E5D345A6F.quest_desc: [
		"Offering to the Gods to struktura typu multiblok zbudowana z 1 Offering Table i 36 kwiatów. Aby złożyć ofiarę, potrzebujesz Spirits of Calling.\\n"
		"{image:atm:textures/questpics/natures_aura/offering.png width:295 height:150 align:center}"
	]
	quest.5C990F7E5D345A6F.quest_subtitle: "Ofiara dla bogów, poidełko w lesie kwiatów"
	quest.71B6F013C8A60EB6.quest_desc: ["&2Canopy Diminisher&r i &2Herbivorous Absorber&r to proste i łatwe sposoby na generowanie aury."]
	quest.71B6F013C8A60EB6.quest_subtitle: "Więcej aury!"
	quest.71B6F013C8A60EB6.title: "Tworzenie Aury"
	quest.7DAED14CEC4CDA51.quest_desc: ["&aNature's Aura&r to magiczny mod o wykorzystywaniu i odnawianiu &aaury&r. Te zadania omówią tylko podstawy.\\n\\nNa początek zrób trochę &eBrilliant Fiber&r, który wytwarza się z &ebryłek złota&r, &aliści&r i &atrawy&r. Kliknięcie dowolnych liści prawym przyciskiem myszy z &eBrilliant Fiber&r zamieni je w &eGolden Leaves&r.\\n\\nKoniecznie przeczytaj &aBook of Natural Aura&r, za jej pomocą możesz też sprawdzić, jak zbudować multibloki w &aNature's Aura&r."]
	quest.7DAED14CEC4CDA51.title: "&eWitaj w &aNature's Aura"
	task.0CA0B32D52395A39.title: "Deski"
	task.15698B55CCAD2433.title: "AllRightsReserved"
	task.2E97226C40818239.title: "Kwiaty"
	task.4C6370D2B7EF8685.title: "AllRightsReserved"
	task.52874F5B79ECAE65.title: "Stone Bricks"
	task.55628B1EECBB5E94.title: "Ritual Saplings"
}
