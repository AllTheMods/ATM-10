{
	quest.04D9F6587EF8D9B7.quest_desc: ["&9Potion Jar&r przechowuje do 100 mikstur. Możesz je wyjąć, używając na słoju pustej butelki lub Potion Flask. \\n\\nWixies będą używać tych słoi podczas automatycznego wytwarzania mikstur."]
	quest.04D9F6587EF8D9B7.quest_subtitle: "Przechowywanie mikstur"
	quest.088FCB5267CB7A89.quest_desc: ["Ten pas daje losowe pozytywne efekty mikstur na krótki czas. Ich siła jest różna."]
	quest.0A1ABE9CF7740AAA.quest_desc: ["Rings of Discount dają niewielką premię do maksymalnej many i jej regeneracji. Zmniejszają też całkowity koszt rzucania czaru."]
	quest.0A1ABE9CF7740AAA.title: "Rings of Discount"
	quest.0D330FAD6C993DBC.quest_desc: ["To kolejne ulepszenie Twojej księgi czarów! \\n\\nZwiększy ona Twoją łączną manę i jej regenerację, a także pozwoli tworzyć i używać glifów poziomu 2."]
	quest.0E2AD156E5EF263A.quest_desc: ["Służy do zapisywania na nim czarów za pomocą Scribe's Table."]
	quest.111649D7E16D869F.quest_desc: ["&9Caster's Wand&r przyjmuje tylko jeden czar i jest zapisywana za pomocą Scribe's Table. \\n\\nCzary różdżki zawsze zaczynają się od Projectile > Accelerate i MUSZĄ być zapisane z czarem, który nie ma innej metody (jak Touch, Self itp.). \\n\\nPozwala to rzucać czary ponad limit 10 czarów. Jeśli chcesz użyć Break, po prostu zapisz na różdżce samo Break."]
	quest.14DB8A515CA50932.quest_desc: ["&9Enchanter's Sword&r pozwala przypisać do miecza czar typu Touch. \\n\\nWszystkie czary na mieczu zyskują 1 dodatkowy augment Amplify do ostatniego efektu czaru. \\n\\nAby przypisać czar do miecza, użyj Scribe's Table. Stwórz czar bez użycia formy."]
	quest.151648179684B088.quest_desc: ["Runic Chalk służy do rysowania trwałych run na ziemi. Runy te będą rzucać czary na istoty, które po nich przejdą. \\n\\nAby przypisać czar do runy, zapisz go na &eSpell Parchment&r za pomocą Scribe's Table.\\n\\nUwaga: Runa potrzebuje Source do działania."]
	quest.151648179684B088.quest_subtitle: "Czary do Rozmieszczania"
	quest.17D7D34F519F7E5F.quest_desc: ["Aby stworzyć ostatni poziom księgi czarów, musisz zabić &6Wilden Chimera&r. \\n\\nTo rytuał, który musisz wykonać za pomocą &9Ritual Brazier&r."]
	quest.18A2FBE2D4133FA2.quest_desc: ["Arcane Pedestals są potrzebne do Ritual Brazier oraz do wytwarzania przedmiotów w Enchanting Apparatus. \\n\\nŚmiało, zrób sobie 8 sztuk!"]
	quest.18A2FBE2D4133FA2.quest_subtitle: "Eleganckie Stoły"
	quest.18A2FBE2D4133FA2.title: "Arcane Pedestals"
	quest.19D02325579F2AA8.quest_desc: ["Volcanic Sourcelink generuje Source, spalając przedmioty palne. Kłody Archwood generują dodatkowy Source. \\n\\nGdy spala przedmioty, zamienia pobliski kamień w lawę. \\n\\nGeneruje też Lava Lilys."]
	quest.1D86B2E553503E53.quest_desc: ["Dominion Wand służy do kontrolowania stworzeń, które możesz spotkać w świecie! Każde z nich inaczej reaguje na różdżkę, więc koniecznie doczytaj w Worn Notebook!"]
	quest.1D86B2E553503E53.title: "Pomoc w Przywoływaniu!"
	quest.227DBA8836021B0B.quest_desc: ["W Ars Nouveau system energii maszyn nazywa się &9Source&r. \\n\\nAby zacząć zbierać Source, potrzebujemy Source Jar. \\n\\nSource można też przenosić wiadrami lub poprzez zniszczenie i podniesienie Source Jars."]
	quest.227DBA8836021B0B.quest_subtitle: "Przechowywanie Source"
	quest.295C77EEC89000FC.quest_subtitle: "Generuje Source ze śmierci mobów i rozmnażania zwierząt"
	quest.2D0CF18C8B2ABB7D.quest_desc: ["Umieszczenie tego w pobliżu rosnących roślin lub sadzonek dostarczy Source. Drzewa Archwood dają więcej Source! \\n\\nUwaga: Użycie mączki kostnej nie wytwarza Source."]
	quest.2D0CF18C8B2ABB7D.quest_subtitle: "Wytwarza Source ze wzrostu roślin"
	quest.3142A40E1EAEBAA3.quest_desc: ["&6Dowsing Rod&r daje Ci Magic Find i Scrying, gdy jej używasz. \\n\\nPozwala to widzieć pobliskie magiczne stworzenia, a także pomaga znajdować ametyst!"]
	quest.3142A40E1EAEBAA3.quest_subtitle: "Wykrywacz Magii"
	quest.3182E8AF755104E4.quest_desc: ["Gdy blokuje obrażenia, &9Enchanter's Shield&r daje użytkownikowi Mana Regen i Spell Damage na krótki czas. \\n\\nDodatkowo tarcza naprawia się z czasem, wykorzystując manę noszącego."]
	quest.33682F4B44950123.quest_desc: ["Aby zdobyć dalszą wiedzę o czarach, potrzebujemy specjalnego rodzaju magicznego drewna! \\n\\nDrzewa Archwood można znaleźć w Overworldzie."]
	quest.36CDA39C23D3AA2B.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.3D4D88B8BE881351.quest_desc: ["Jeśli chcesz rzucać lepsze czary, potrzebujesz &6Scribe's Table&r, aby odblokować nowe glify do swojej księgi czarów. \\n\\nDo odblokowania są 3 poziomy glifów, a każdy wymaga doświadczenia i przedmiotów. \\n\\nScribe's Table służy też do przypisywania czarów do Spell Parchments. Aby to zrobić, połóż Spell Parchment na stole, wybierz czar w księdze czarów, a następnie kliknij prawym przyciskiem myszy księgą na stole, skradając się. \\n\\nAby stworzyć glif, kliknij Scribe's Table prawym przyciskiem myszy z księgą czarów w ręce. Wyszukaj glif, który chcesz stworzyć, a potem kliknij Select na dole. Kliknij stół prawym przyciskiem myszy z wymaganymi przedmiotami, a glif zostanie stworzony. Użyj glifu, aby go poznać. \\n\\nUwaga: Stół może pobierać przedmioty z pobliskich ekwipunków."]
	quest.3D4D88B8BE881351.quest_subtitle: "Ulepszanie Czarów"
	quest.3D862A3D3F83CA26.quest_desc: [
		"&9Enchanting Apparatus&r służy do wytwarzania różnych przedmiotów w tym modzie. Wymaga Source do działania.\\n\\nJest też strukturą typu multiblok, która do wytwarzania wykorzystuje Arcane Pedestals.\\n\\nZacznij od umieszczenia Arcane Core w ziemi, a następnie połóż na nim Enchanting Apparatus. Otocz Apparatus Arcane Pedestals.\\n"
		"{image:atm:textures/questpics/ars/enchanting_app.png width:200 height:175 align:1}"
	]
	quest.3D862A3D3F83CA26.title: "Enchanting Apparatus"
	quest.3FD702B5AB006402.quest_desc: ["Czy kiedykolwiek chciałeś po prostu unosić się wszędzie, gdzie idziesz? \\n\\nTen pas pozwala Ci lewitować. Aby go aktywować, po prostu skradaj się w powietrzu, podczas spadania lub po skoku."]
	quest.40BC67BDEE15D1DE.quest_desc: ["Aby stworzyć Source Gems, musimy włożyć do Imbuement Chamber Lapis lub Amethyst Shards. Z czasem zamienią się w Source Gems!"]
	quest.40BC67BDEE15D1DE.title: "&5Source Gems"
	quest.41A0BE357C8A74E1.quest_desc: ["&9Alchemical Sourcelink&r wytwarza Source z sąsiednich słoi z miksturami. \\n\\nIlość Source zależy od mikstury i jej złożoności."]
	quest.41A0BE357C8A74E1.quest_subtitle: "Energia z mikstur"
	quest.441C0659ED28D935.quest_desc: ["Stworzenie glifów poziomu 1 wymaga 3 poziomów doświadczenia."]
	quest.457DE8C154641437.quest_desc: ["&9Ritual Brazier&r służy do odprawiania rytuałów. Można go też używać jako dekoracji. Aby zapalić Brazier, użyj na nim czaru Light. \\n\\nDo wykonywania rytuałów potrzebujesz też Arcane Pedestals. Ponieważ rytuałów jest tak wiele, koniecznie sprawdź każdy z nich w &6Worn Notebook&r! \\n\\nMożna to zrobić, przytrzymując Ctrl na Ritual Table, gdy książka jest w Twoim ekwipunku."]
	quest.51162B9185A45BB1.quest_desc: ["Na tym łuku można zapisać czar za pomocą Scribe's Table. \\n\\nKosztem many strzały zamienią się w Spell Arrows i zadziałają czarem na swój cel. \\n\\nJeśli nie masz strzał, zostanie rzucona strzała czaru zadająca 0 obrażeń. Jeśli brakuje many, zostaną wystrzelone zwykłe strzały. \\n\\n&9Enchanter's Bow&r może też używać specjalnych Augment Arrows, które wzmacniają zapisany czar."]
	quest.542C6D76B579886C.quest_desc: ["Używając naszej struktury Enchanting Apparatus, wytworzymy nasze pierwsze nasiono, &5Magebloom Seed&r. \\n\\nPosłuży ono do stworzenia magicznych ubrań!"]
	quest.5766C8B9E850C186.quest_desc: [
		"Aby stworzyć jeden z głównych przedmiotów do wytwarzania w Ars, &9Source Gem&r, musimy zbudować &6Imbuement Chamber&r. \\n\\nImbuement Chamber wymaga Source do nasycania przedmiotów. Sama wytwarza niewielką ilość Source, ale może też używać Source Jars jako źródła energii. \\n\\nNiektóre receptury wymagają też ustawienia wokół niej Arcane Pedestals.\\n"
		"{image:atm:textures/questpics/ars/imbuement.png width:200 height:150 align:1}"
	]
	quest.5766C8B9E850C186.quest_subtitle: "Tworzenie Source Gems"
	quest.58EC47584C773B82.quest_desc: ["Używając naszej struktury Enchanting Apparatus, wytworzymy nasze pierwsze nasiono, &5Magebloom Seed&r. \\n\\nPosłuży ono do stworzenia magicznych ubrań!"]
	quest.58EC47584C773B82.quest_subtitle: "Rosnąca Magia"
	quest.58EC47584C773B82.title: "Magebloom Seed"
	quest.5C3FF43CF16BCF30.quest_desc: ["Dzięki Source Gems możesz zacząć wytwarzać różne maszyny, tworząc &5Sourcestones&r."]
	quest.5C3FF43CF16BCF30.quest_subtitle: "Dawniej \"Arcane Stones\""
	quest.5C3FF43CF16BCF30.title: "Sourcestone"
	quest.5CFBA24B3E0CDEDD.quest_desc: [
		"Trzymając księgę czarów, możesz nacisnąć C, aby otworzyć stronę tworzenia czarów. \\n\\nKażdy czar musi mieć formę. Na początku masz 3 podstawowe formy: Projectile, Self-cast i Touch. \\n\\nEfekt określa, co się dzieje po rzuceniu czaru. Możesz mieć do 9 efektów na czar. \\n\\nNa początek masz Harm i Break. \\n\\nWybierz jedną formę i jeden efekt, nazwij czar i kliknij create!"
		""
		"{image:atm:textures/questpics/ars/spellbook.png width:200 height:150 align:1}"
	]
	quest.632BC46928CC9A8C.quest_desc: ["&9Enchanter's Mirror&r po użyciu rzuca czar na siebie. \\n\\nCzary rzucane tym lustrem są tańsze i zyskują dodatkowy czas trwania. \\n\\nAby przypisać czar, użyj Scribe's Table. Stwórz czar bez użycia formy."]
	quest.63DD7F5A4441ACE7.quest_desc: ["Stworzenie glifów poziomu 2 wymaga 5 poziomów doświadczenia. \\n\\nWymagają też &9Mage's Spell Book&r."]
	quest.64D0E66CB4FBEC82.quest_desc: ["Na początek musisz wytworzyć &6Novice Spellbook&r! \\n\\nTo tutaj tworzysz i przechowujesz swoje czary. \\n\\nNaciśnięcie klawisza &9C&r otworzy stronę 'Create a Spell'. Po lewej jest kilka zakładek, ale główne 3 to: Spell Creation, Color Picker i Familiars. \\n\\nTa księga pozwala tworzyć i używać tylko glifów poziomu 1. Aby tworzyć lepsze czary, musisz ją ulepszyć!"]
	quest.64D0E66CB4FBEC82.quest_subtitle: "Nasza Pierwsza Księga Czarów"
	quest.64D0E66CB4FBEC82.title: "Księgi Czarów"
	quest.6A1C0B17B22CE50F.quest_desc: ["&9Amulet of Mana Boost&r zwiększa maksymalną manę. \\n\\n&6Amulet of Mana Regen&r zwiększa regenerację many."]
	quest.6A1C0B17B22CE50F.title: "Amulety"
	quest.6B511C8B572E8940.quest_desc: ["W lewym dolnym rogu ekranu zobaczysz pasek. To Twoja pula many! \\n\\nIstnieje kilka sposobów na zwiększenie puli many lub efektywności czarów w miarę postępów w modzie. Ulepszanie księgi czarów również może zwiększyć Twoją manę!"]
	quest.6B511C8B572E8940.quest_subtitle: "Moc Maga"
	quest.6B511C8B572E8940.title: "Mana"
	quest.6DAA82B5F94AF9F8.quest_desc: ["&9Jar of Light&r przywołuje unoszące się źródło światła, które podąża za Tobą. \\n\\n&6Jar of Voiding&r niszczy podnoszone przez Ciebie przedmioty w zamian za manę. Można to filtrować. \\n\\nAby dodać lub usunąć przedmiot do zniszczenia przez słój, użyj słoja z przedmiotem w drugiej ręce albo użyj przedmiotu na Scribe's Table z postawionym na nim słojem. \\n\\nSłój musi znajdować się na pasku szybkiego dostępu, aby działał."]
	quest.6DAA82B5F94AF9F8.title: "Słoje"
	quest.6E0E13806F388D7E.quest_desc: ["Witaj w &aArs Nouveau&f! \\n\\nArs Nouveau to mod magiczny, który pozwala tworzyć własne czary z różnych glifów dostępnych w modzie!"]
	quest.6E0E13806F388D7E.title: "Witaj w &aArs Nouveau&f!"
	quest.6F3602F5600A6221.quest_desc: ["Stworzenie glifów poziomu 3 wymaga 10 poziomów doświadczenia. \\n\\nWymagają też &6Archmage Spell Book&r."]
	quest.77145113CD5B26FB.quest_desc: ["Source Berries wytwarzają więcej Source niż inne źródła. \\n\\nZamieniają też trawę lub ziemię w Mycelium na obszarze 3x3 wokół siebie. Wokół wyrosną też grzyby, jeśli jest tam wolne miejsce."]
	quest.77145113CD5B26FB.quest_subtitle: "Generuje Source z pobliskiego jedzenia"
	task.01FD75641E5EA5E4.title: "Mana"
	task.03EB390E79866058.title: "Sourcestones"
	task.0E6876A34D1975EB.title: "AllRightsReserved"
	task.15C6E9C02D1FBEC0.title: "Glify Poziomu 2"
	task.1B916AE67F84E6D7.title: "Tworzenie Pierwszego Czaru"
	task.1CC556A6921208B8.title: "Glify Poziomu 1"
	task.2BC0F5A88E2F03C3.title: "Archwood Logs"
	task.388545A0E3B4930D.title: "AllRightsReserved"
	task.65D68BEEB36FC805.title: "Glify Poziomu 3"
}
