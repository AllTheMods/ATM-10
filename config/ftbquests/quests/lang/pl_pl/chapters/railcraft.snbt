{
	quest.008D186B4E0ED14F.quest_desc: [
		"Steam Oven to kolejna maszyna, która wykorzystuje Steam do czegoś przydatnego. \\n\\nGdy wpompujesz Steam do Steam Oven, zacznie działać jak piec na wszystkie znajdujące się w nim przedmioty: wytworzysz sztabki z rud i ugotujesz jedzenie. \\n\\nTo maszyna o wymiarach 2x2x2 zbudowana z bloków Steam Oven."
		"{image:atm:textures/questpics/railcraft/rail_oven.png width:100 height:100 align:center}"
	]
	quest.008D186B4E0ED14F.title: "Steam Oven"
	quest.020E6AF37A0421C8.quest_desc: [
		"Water Tank działa jak beczka pod gołym niebem, tylko znacznie większa. Zbiera wodę i może ją przechowywać dla Steam Locomotives. \\n\\nIlość zbieranej wody zależy od biomu i od tego, czy blok jest widoczny dla nieba. \\n\\nBuduje się go z bloków Water Tank w układzie 3x3x3, ze środkiem pustym."
		"{image:atm:textures/questpics/railcraft/rail_tank.png width:100 height:100 align:center}"
	]
	quest.020E6AF37A0421C8.title: "Water Tank"
	quest.032B654201E71618.quest_desc: ["Te &cTrack Kits&r służą do obsługi istot za pomocą Twoich &7wagoników&r (istoty, czyli moby). \\n\\n&cEmbarking Kit&r zbiera pobliskie moby i umieszcza je w &7wagoniku&r. \\n&cDisembarking Kit&r wyładowuje moby z &7wagoników&r. \\n&cDumping Kit&r zrzuca moby z &7wagoników&r pod &6tory&r, na których się znajduje."]
	quest.032B654201E71618.title: "&cTrack Kits&r do Przewożenia Istot"
	quest.035C52EF63AD23A7.quest_desc: ["Skoro nazwa moda to &lRailCraft&r, a kręci się on wokół &5pociągów&r, &6szyny&r są tu dość ważne. \\n\\nTe z &2Vanilla&r sprawdzą się w wielu przypadkach, ale umówmy się, że są kiepskie. Ulepszone szyny wymagają specjalnych przedmiotów w recepturach! Wytwórz je! (Niektóre przedmioty mogą wymagać użycia maszyn, więc zajrzyj do tej części zadań!)"]
	quest.035C52EF63AD23A7.title: "&6&lSzyny&r!"
	quest.068294A7C21DE550.quest_desc: ["&cTrack Kits&r służą do wytwarzania z &6szynami&r specjalnych &6szyn&r. \\n\\nTe &6szyny&r przydadzą się we wszystkim, co dotyczy &5pociągów&r: zatrzymywaniu &5pociągu&r, rozpędzaniu &5pociągu&r i emitowaniu sygnału redstone."]
	quest.068294A7C21DE550.title: "&c&lTory&r!"
	quest.08457BEED799E600.quest_desc: ["Te nowe &7wagoniki&r służą głównie do układania &6torów&r.\\n\\n&7Track Layer&r układa &6tory&r, a &7Track Remover&r usuwa &6tory&r.\\n\\n&7Track Relayer&r zastępuje &6tory&r innymi, a &7Track UnderCutter&r zastępuje bloki pod &6torami&r."]
	quest.08457BEED799E600.title: "&7Wagoniki&r i &6Tory"
	quest.0A43FD0B5C76C1C5.quest_desc: [
		"&l&7RailCraft&r dodaje multiblok Blast Furnace, w którym przetworzysz żelazo na stal! \\n\\nAby go zbudować, potrzebujesz 34 Blast Furnace Bricks. Struktura ma 3 bloki szerokości, 3 bloki długości i 4 bloki wysokości. Dwa bloki dokładnie pośrodku muszą być puste. Gdy wszystko się połączy i będziesz mógł otworzyć GUI, struktura jest gotowa. \\n\\nTam możesz włożyć żelazo w dowolnej postaci, aby otrzymać Steel i Granulated Sand."
		"{image:atm:textures/questpics/railcraft/rail_furnace.png width:100 height:100 align:center}"
	]
	quest.0A43FD0B5C76C1C5.title: "Blast (Steel) Furnace"
	quest.104049993CC62E7F.quest_desc: ["Advanced Item Loader robi wszystko to, co zwykły, ale można go umieścić w dowolnym miejscu przy &6torze&r: obok, nad nim, obok z drugiej strony. Użyj &4Crowbar&r, aby zmienić jego kierunek."]
	quest.104049993CC62E7F.title: "Advanced Item Loader"
	quest.1698565EBB68DC85.quest_desc: [
		"&6Wye Track&r to drugi rodzaj toru, który wykonasz za pomocą Spike Maul. Łączy dwa &6tory&r w jeden. Jeśli jeden &6tor&r przecina inny, &6Wye&r skieruje &7wagoniki&r z pierwszego &6toru&r na ten przecinający."
		"{image:atm:textures/questpics/railcraft/rail_wye.png width:100 height:100 align:center}"
	]
	quest.1698565EBB68DC85.title: "&6Wye Tracks"
	quest.170118E3C3C072E5.quest_desc: [
		"&6Junction&r to ostatni &6tor&r wykonywany za pomocą Spike Maul. Działa jak zwykłe skrzyżowanie &6torów. &7Wagoniki&r jadą dalej w tym samym kierunku, ale &6tory&r mogą się teraz przecinać. Co się stanie, gdy 2 &7wagoniki&r zderzą się na nim? WYBUCHNĄ!!! Żartuję, ale &eElectric Locomotives&r już tak."
		"{image:atm:textures/questpics/railcraft/rail_junction.png width:100 height:100 align:center}"
	]
	quest.170118E3C3C072E5.title: "&6Junction Tracks"
	quest.175D943160C10646.quest_desc: [
		"&l&7RailCraft&r ma wiele maszyn do różnych zadań, ale głównie do wytwarzania zasobów."
		""
		"Wszystkie zaczynają się od Iron Ingots!"
	]
	quest.175D943160C10646.title: "&l&7Maszyny"
	quest.17F7964611D893BE.quest_desc: ["Fluid Loader pomoże utrzymać Twoje &3Steam Locomotives&r w ruchu. Trzeba go umieścić kilka bloków nad &6torami&r, a będzie wlewał płyny do &5lokomotywy&r lub &7wagoników&r."]
	quest.17F7964611D893BE.title: "Fluid Loader"
	quest.184F98BE0F6710E2.quest_desc: ["Te 2 &cTrack Kits&r służą do obsługi &7wagoników&r z redstonem.\\n\\n&cActivator Kit&r aktywuje każdy &7wagonik&r, który po nim przejedzie. \\n&cDetector Kit&r wysyła sygnał redstone za każdym razem, gdy przejedzie po nim &7wagonik&r. \\n\\nObie są podobne do swoich odpowiedników z &2Vanilla&r dla zwykłych &6torów&r."]
	quest.184F98BE0F6710E2.title: "&cTrack Kits&r do Obsługi Redstone"
	quest.21693C4DE6531D73.quest_desc: [
		"Crusher robi dokładnie to, co sugeruje nazwa. Kruszy bloki, aby uzyskać materiały do wytwarzania, na przykład cegły z ceglanych schodów albo pyły ze sztabek. \\n\\nDo działania potrzebuje jednak energii! \\n\\nAby go zbudować, ułóż bloki Crusher w układzie 3x2x2."
		"{image:atm:textures/questpics/railcraft/rail_crusher.png width:100 height:100 align:center}"
	]
	quest.21693C4DE6531D73.title: "Crusher"
	quest.249E5C6893387E15.quest_desc: ["Te &cTracks&r służą do zatrzymywania &5lokomotyw&r i &7wagoników&r. \\n\\n&cLocking Kit&r zatrzymuje &7wagoniki&r i puszcza je dopiero po otrzymaniu impulsu redstone. \\n&cBuffer Kit&r umieszcza się na końcu &6torów&r, zatrzymuje pojazdy i już ich nie puszcza. \\n&cGated Kit&r po prostu stawia furtkę połączoną z &6torem&r."]
	quest.249E5C6893387E15.title: "&cTrack Kits&r do Zatrzymywania &7Wagoników&r"
	quest.283AB56F81EF03A5.quest_desc: ["Aby zasilić swoje &6Electric Rails&r i &eElectric Locomotive&r, potrzebujesz &eFrames. Frames&r muszą być zasilane i przekazują energię każdemu połączonemu &eFrame&r."]
	quest.283AB56F81EF03A5.title: "&eFrames"
	quest.2869AB982799CF0C.quest_desc: ["&cOne Way Track Kit&r jest bardzo prosty. &7Wagoniki&r mogą jechać tylko w kierunku, w którym wskazuje strzałka."]
	quest.2869AB982799CF0C.title: "&cTrack Kit&r One Way"
	quest.2A30595DC6DDBFF7.quest_desc: [
		"&6Electric Tracks&r są przeznaczone dla &eElectric Locomotives&r. Muszą być zasilane przez &eFrames&r, i tak, jeśli ich dotkniesz, zaboli."
		"{image:atm:textures/questpics/railcraft/rail_electric_rail.png width:150 height:100 align:center}"
	]
	quest.2A30595DC6DDBFF7.title: "&6Electric Tracks"
	quest.2AB0FA084739827A.quest_desc: ["Aby faktycznie używać &9Tunnel Bore&r, potrzebujesz &9Tunnel Bore Head&r. \\n\\nWystępują w 4 różnych wariantach, a sposób kopania zależy od &9Bore Head&r. \\n\\nMożna go zaklinać i ma wytrzymałość, więc warto go zakląć!"]
	quest.2AB0FA084739827A.title: "&9Tunnel Bore, Bore Head"
	quest.2D00F85379A4D591.quest_desc: ["Item Loader to najprostszy dozownik z RailCraft. Musi znajdować się nad &6torem&r i można go skonfigurować tak, aby ładował na Twoje &7wagoniki&r poniżej to, czego potrzebujesz."]
	quest.2D00F85379A4D591.title: "Item Loader"
	quest.31094CC16E710040.quest_desc: ["&4Crowbar&r to główne narzędzie RailCraft. \\n\\nUżyty na &5lokomotywie&r zmienia kierunek, w którym jest zwrócona. \\n\\nGdy klikniesz nim z wciśniętym Shiftem, możesz łączyć &5lokomotywy&r i &7wagoniki&r. \\n\\nUżyty na samych &7wagonikach&r lekko je popycha. \\n\\nA użyty na specjalnych torach zmienia ich tryb. \\n\\nRóżne &4Crowbars&r różnią się tylko wyglądem i wytrzymałością."]
	quest.31094CC16E710040.quest_subtitle: "„Co, chcesz mnie okraść?”"
	quest.365D4B1DC953D406.quest_desc: ["&7Cart&r Dispenser robi to, co sugeruje nazwa. Może wyrzucać dowolne &7wagoniki&r na &6tory&r przed sobą. Do działania potrzebuje sygnału redstone."]
	quest.365D4B1DC953D406.title: "&7Cart&r Dispenser"
	quest.38451B61E3FC075B.quest_desc: [
		"Zaraz, znowu mamy Steel, czy to znaczy, że odzyskamy też (Coal) Coke? Tak! \\nAby zdobyć (Coal) Coke, potrzebujesz Coke Oven. Do jego budowy potrzeba 26 Coke Oven Bricks ułożonych w układzie 3x3x3 z jednym pustym blokiem pośrodku. Gdy będziesz mógł otworzyć GUI, a całość będzie miała jedną teksturę, struktura jest gotowa. \\n\\nWłóż Coal lub Coal Blocks, aby otrzymać (Coal) Coke i Liquid Creosote! Możesz też włożyć dowolne drewno, aby otrzymać Charcoal i Creosote."
		"{image:atm:textures/questpics/railcraft/rail_coke.png width:100 height:100 align:center}"
	]
	quest.38451B61E3FC075B.title: "Coke Oven"
	quest.3E75AFE3482834C5.quest_desc: ["&lRailCraft&r to cały mod oparty na &5pociągach&r! \\n\\nOd &7Minecartów&r, przez &eElectric Locomotives&r, po &9Tunnel Bores&r! Ma też wszystko, co dotyczy akcesoriów do &5pociągów&r: Traffic Lights, Steam Boilers do zasilania &5pociągów&r i automatyzację wszystkiego. \\n\\nModel mod dla miłośników modelowych &5pociągów&r!"]
	quest.3E75AFE3482834C5.title: "&7&lRailCraft"
	quest.3E8C2E7769DFBF35.quest_desc: [
		"W przeciwieństwie do &3Steam Locomotive&r nie musisz niczego wkładać do &eElectric Locomotive&r. \\n\\nZasila się ona energią z &eFrames&r pod &6Electric Tracks&r. \\n\\nTak, może jeździć wyłącznie po &6Electric Tracks&r."
		"{image:atm:textures/questpics/railcraft/rail_electric.png width:100 height:100 align:center}"
	]
	quest.3E8C2E7769DFBF35.title: "&eElectric Locomotive"
	quest.4071BBBE12CACD2D.quest_desc: ["&5Train&r Dispenser to lepsza wersja &7Cart&r Dispenser. Potrafi wyrzucić całą &5lokomotywę&r i nie tylko! Ustaw wzór tego, co ma zostać rozmieszczone, a następnie podaj sygnał redstone."]
	quest.4071BBBE12CACD2D.title: "Train Dispenser"
	quest.425E375A9EC127EB.quest_desc: [
		"&6Reinforced Tracks&r to ulepszona wersja zwykłych &6szyn&r! Są nieco szybsze i nie wybuchają."
		"{@pagebreak}"
		"1"
		"{image:atm:textures/questpics/railcraft/rail_reinforced1.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"2"
		"{image:atm:textures/questpics/railcraft/rail_reinforced2.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"3"
		"{image:atm:textures/questpics/railcraft/rail_reinforced3.png width:150 height:100 align:center}"
		"{@pagebreak}"
		"4"
		"{image:atm:textures/questpics/railcraft/rail_reinforced4.png width:150 height:100 align:center}"
	]
	quest.425E375A9EC127EB.title: "&6Reinforced Tracks"
	quest.475E307844E3AF7F.quest_desc: [
		"Water Boilers to jedne z najprzydatniejszych maszyn z &l&7RailCraft&r. Potrzebują Fuel Firebox i jakiegoś kotła na wierzchu. Fueled Firebox może mieć rozmiar 1x1, 2x2 lub 3x3. Rozmiar Firebox decyduje o tym, jak duży może być kocioł na górze. Dla Firebox 1x1 kocioł może mieć tylko 1x1. Dla Firebox 2x2 może to być kocioł 2x2x3. Dla Firebox 3x3 może to być 3x3x4. Liquid Fuel Firebox do nagrzewania zużywa Creosote. Solid Firebox zużywa wszystko, co można włożyć do pieca."
		"{image:atm:textures/questpics/railcraft/rail_big_boiler.png width:100 height:100 align:center}"
	]
	quest.475E307844E3AF7F.title: "Boilers"
	quest.4A44623D8A307473.quest_desc: [
		"&6High Speed Electric Tracks&r są jak &6Electric Tracks&r, ale szybsze! Wymagają też tego, czego wymagają zwykłe &6High Speed Tracks&r, oraz tego, czego wymagają &6Electric Tracks&r: &cSpeed Boosts&r i &eFrames&r do zasilania. Teraz musisz uważać na zakrętach i przy dotykaniu ich!"
		"{image:atm:textures/questpics/railcraft/rail_electric_speed.png width:150 height:100 align:center}"
	]
	quest.4A44623D8A307473.title: "&6High Speed Electric Tracks"
	quest.50A286C268F38E09.quest_desc: ["Na tej stronie zadań poświęciłem dużo czasu na pokolorowanie tekstów, aby pomóc Ci, graczu, zrozumieć, o co mi chodzi. Potem zdałem sobie sprawę, że może to być jeszcze bardziej mylące, więc oto Legenda! \\n\\n&5Fioletowy&r to każdy pociąg lub lokomotywa, czyli zarówno Electric, jak i Steam Locomotives oraz dołączone wagoniki. \\n&6Złoty&r to wszystkie tory i Rails, wraz ze specjalnymi Rails, ale bez Track Kits. \\n&cJasnoczerwony&r oznacza wszystkie Track Kits. \\n&4Ciemnoczerwony&r to Crowbars. \\n&3Cyjan&r to tylko Steam Locomotive. \\n&eŻółty&r to tylko Electric Locomotive. \\n&9Niebieski&r to Tunnel Bore. \\n&7Szary&r to Minecarts i specjalne wagoniki."]
	quest.50A286C268F38E09.title: "Legenda Kolorów"
	quest.5128B119DFFF0C4C.quest_desc: [
		"&3Steam Locomotive&r to najprostsza &5lokomotywa&r. Zasilasz ją, dostarczając wodę i paliwo do pieca, a potem czekasz. Potrzebuje stałego dopływu wody, by działać. \\n\\nSpokojnie, dym wydobywający się z jej góry to po prostu para wodna, która jest bezpieczna dla środowiska. No, część z węgla nie jest dla niego najlepsza... eh, to &2Minecraft&r, kogo to obchodzi!"
		"{image:atm:textures/questpics/railcraft/rail_steam_locomotive.png width:100 height:100 align:center}"
	]
	quest.5128B119DFFF0C4C.title: "&3Steam Locomotive"
	quest.5180CDD196518F64.quest_desc: [
		"&6Strap Iron Tracks&r, podobnie jak &6Abandoned Tracks&r, są idealne dla skąpców. Jeżdżą po nich znacznie wolniej niż po innych &6torach&r, ale nie ma ryzyka wykolejenia!"
		"{image:atm:textures/questpics/railcraft/rail_strap.png width:150 height:100 align:center}"
	]
	quest.5180CDD196518F64.title: "&6Strap Iron Tracks"
	quest.53594EBA9F7BA840.quest_desc: ["Advanced Item Unloader jest taki jak zwykły, ale można go używać z dowolnego kierunku. Poza kierunkiem nic się nie zmienia."]
	quest.53594EBA9F7BA840.title: "Advanced Item Unloader"
	quest.541D270451DA4320.quest_desc: ["Switch Track będzie potrzebny do przełączania pasów między różnymi specjalnymi &6torami&r. Strzałki na nim pokazują, co dokąd prowadzi."]
	quest.54F2CB52D3A7BA87.quest_desc: ["Item Unloader jest przeciwieństwem Item Loader. Zabiera przedmioty z &7wagoników&r. Ten również musi znajdować się nad &6torem&r."]
	quest.54F2CB52D3A7BA87.title: "Item Unloader"
	quest.55D7CD0FA8F1AE48.quest_desc: ["Powód, dla którego tu wszyscy jesteśmy: &5pociągi&r. Mod nazywa się &l&7RailCraft&r, nie udawaj zaskoczonego. \\n\\nSą 2 główne rodzaje &5pociągów&r i 1 specjalny górniczy &5pociąg&r. \\n\\nTakie samotne &5pociągi&r mogą być trochę nudne, więc dlaczego nie podczepić do nich &7wagoników&r! Łączenie &7wagoników&r z &7wagonikami&r i z &5pociągami&r nazywa się sprzęganiem (Coupling), a ich rozłączanie to Decoupling. Aby sprząc &5pociągi&r i &7wagoniki&r, użyj &4Crowbar&r albo &6toru&r z &cTrack Kit&r typu Coupling."]
	quest.55D7CD0FA8F1AE48.title: "&7&lWagoniki&r i &5&lPociągi&r!"
	quest.5820EDEF71340A1A.quest_desc: [
		"&6Abandoned Tracks&r są dobre dla skąpców i dla estetyki. Można nimi przerzucić most przez kilka bloków bez podpór. Mogą być oddalone najwyżej o 2 bloki od bloków biegnących w tym samym kierunku lub o jeden blok od biegnących w przeciwnym. Wiąże się to z ryzykiem wykolejenia, czyli Twój &7wagonik&r po prostu zostanie zrzucony z &6szyn&r."
		"{image:atm:textures/questpics/railcraft/rail_abandoned.png width:150 height:100 align:center}"
	]
	quest.5820EDEF71340A1A.title: "&6Abandoned Tracks"
	quest.5E750DB2244A67A1.quest_desc: [
		"&6Turnout Track&r to pierwszy tor, który powstaje po uderzeniu &6toru&r za pomocą Spike Maul. Pozwala jechać w dwóch kierunkach: prosto i w bok. Można go przełączać za pomocą Switch obok &6toru&r."
		"{image:atm:textures/questpics/railcraft/rail_turnout.png width:100 height:100 align:center}"
	]
	quest.5E750DB2244A67A1.title: "&6Turnout Tracks"
	quest.5F458D79D43D8842.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.609CA1ACFA981BD5.quest_desc: ["&cRouting Kit&r jest używany z biletami przejazdowymi (passing tickets)."]
	quest.609CA1ACFA981BD5.title: "&cTrack Kit&r Routing"
	quest.61C93ABE07742DCD.quest_desc: [
		"Steam Turbine wykorzystuje Steam do produkcji energii FE i EU. \\n\\nTo konstrukcja 3x2x2 zbudowana wyłącznie z Steam Turbine Housing. Potrzebuje w środku Turbine Motor i doprowadzonego Steam."
		"{image:atm:textures/questpics/railcraft/rail_turbine.png width:100 height:100 align:center}"
	]
	quest.61C93ABE07742DCD.title: "Steam Turbine"
	quest.64C105E1E2F97900.quest_desc: ["Spike Mauls używa się na zwykłych &6torach&r, aby przełączać ich tryby. Bardzo pomocne przy budowie skrzyżowań!"]
	quest.64C105E1E2F97900.title: "„Przełącz Je”"
	quest.677C5D35DADA4A42.quest_desc: ["&cCoupler&r służy do łączenia i rozłączania &7wagoników&r. Łączenie &7wagoników&r nazywa się Coupling. \\n\\nMożna go skonfigurować za pomocą &4Crowbar&r na łączenie, rozłączanie lub automatyczne łączenie. Do działania potrzebuje redstone."]
	quest.677C5D35DADA4A42.title: "&cTrack Kit&r Coupler"
	quest.6C14D1B60124C2B2.quest_desc: [
		"&9Tunnel Bore&r idealnie nadaje się do automatycznego układania &6Rails&r, zwłaszcza pod górami lub wzgórzami. \\n\\nDo działania potrzebuje 3 rzeczy: &9Bore Head&r, paliwa, np. węgla, i &6Rails&r. Gdy już je ma, po prostu go puść! \\n\\nPamiętaj, by pilnować przedmiotów, które do niego trafiają!"
		"{image:atm:textures/questpics/railcraft/rail_tunnel.png width:100 height:100 align:center}"
	]
	quest.6C14D1B60124C2B2.title: "&9Tunnel Bore"
	quest.6C163E005351FF6D.quest_desc: ["&cWhistle Kit&r aktywowany redstonem sprawia, że &5lokomotywy&r uruchamiają swoje gwizdki."]
	quest.6C163E005351FF6D.title: "&cTrack Kit&r Whistle"
	quest.6DB65926EE6D6C2E.quest_desc: ["Te &cTrack Kits&r służą do zmiany pędu Twoich &7wagoników&r. \\n\\n&cTransition Kits&r zmieniają prędkość przejeżdżającej &5lokomotywy&r, wymagają zasilania redstonem. \\n&cBooster Kits&r przyspieszają &7wagonik&r, gdy są zasilane, a gdy nie są, spowalniają &7wagonik&r. \\n&cControl Kit&r lekko popycha &7wagoniki&r, a gdy jest zasilany, zmienia kierunek popychania. \\n&cThrottle Kit&r zmienia prędkość przejeżdżającej &5lokomotywy&r na skonfigurowaną, wymaga zasilania redstonem. \\n&cLauncher Kit&r dosłownie wyrzuci Twój &7wagonik&r!"]
	quest.6DB65926EE6D6C2E.title: "&cTrack Kits&r do Przyspieszania &7Wagoników&r"
	quest.6E7C4228CD2B6BB9.quest_desc: ["Ten &4Crowbar&r ma kilka trybów, z których każdy zmienia wygląd &5lokomotywy&r. Domyślny jest opisany po najechaniu na przedmiot w ekwipunku, none zmienia kolor na &7szary&r, &6H&r&5a&r&6l&r&5l&r&6o&r&5w&r&6e&r&5e&r&6n&r nadaje upiorny wygląd, a &cC&r&2h&r&cr&r&2i&r&cs&r&2t&r&cm&r&2a&r&cs&r nadaje świąteczny!"]
	quest.75DD345164EE5CD9.quest_desc: [
		"&6High Speed Tracks&r są jak &6Reinforced Tracks&r, ale oczywiście szybsze. Potrzebują jednak &cTrack Kits&r, które pomagają się rozpędzić. I uważaj na zakrętach!"
		"{image:atm:textures/questpics/railcraft/rail_speed.png width:150 height:100 align:center}"
	]
	quest.75DD345164EE5CD9.title: "&6High Speed Tracks"
	quest.78D8F40AA9568511.quest_desc: ["Powered Rolling Machine to znacznie lepsza wersja Manual Rolling Machine. \\n\\nNie musisz ciągle zaglądać do maszyny, aby coś wytworzyć, a ona sama wytworzy wszystko automatycznie. \\n\\nJedyny problem w tym, że potrzebuje energii!"]
	quest.7D40B80DBBC4E160.quest_desc: ["Manual Rolling Machine będzie Twoją małą maszyną do wytwarzania wielu materiałów dla railcraft! \\n\\nGdy wstawisz recepturę, a da się wytworzyć więcej niż 1 przedmiot, będzie je wytwarzać automatycznie, dopóki na nią patrzysz. Gdy opuścisz Rolling Machine w trakcie wytwarzania, przerwie ona proces i odda przedmiot do Twojego ekwipunku. \\n\\nOstatnią recepturę musisz wytworzyć ręcznie!"]
	quest.7F187E291C3D5BA7.quest_desc: ["Fluid Unloader jest dokładnym przeciwieństwem Fluid Loader. Zamiast znajdować się nad &6torem&r, jest pod nim. Zamiast dawać &3Steam Locomotives&r wodę, zabiera im ją. Nie wiem, po co miałbyś to robić, ale możesz!"]
	quest.7F187E291C3D5BA7.title: "Fluid Unloader"
	quest.7F4B734CFB0F0306.quest_desc: ["Te nowe &7wagoniki&r są podobne do specjalnych &7wagoników&r z &2Vanilla&r. &7Minecart with a Tank&r przechowuje i przewozi dowolny płyn. &7Minecart with an Energy cell&r zamiast tego przechowuje i przewozi energię!"]
	quest.7F4B734CFB0F0306.title: "Nowe Wagoniki"
