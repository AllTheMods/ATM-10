{
	quest.0107D516E038E0DB.quest_desc: ["W &eLich Tower&r mieszka &eLich&r! Walka ma 3 fazy:\\n\\nFaza 1: &eLich&r otacza się tarczami i atakuje Cię &5Ender Pearls&r, które lecą jak kule ognia Ghasta. Odbij je z powrotem w stronę &eLich&r, aby rozbić jego tarcze! Gdy tarcze pękają, wysyła duplikaty, by Cię rozproszyć.\\n\\nFaza 2: &eLich&r zmienia berło, aby przywołać zombie do pomocy w walce. Gdy jego obrona jest osłabiona, możesz atakować go w zwarciu!\\n\\nFaza 3: Gdy wszystkie ładunki jego berła się wyczerpią, zmieni broń na &eGolden Sword&r i wpadnie w szał. Zabij go szybko!"]
	quest.0107D516E038E0DB.title: "&eWynoście Swoich Zmarłych"
	quest.01748C2CD9C97523.quest_desc: ["&cReappearing Blocks&r są jak naprawdę fajne drzwi. Po kliknięciu prawym przyciskiem znikną na krótki czas.\\n\\n&cVanishing Blocks&r znikają po kliknięciu prawym przyciskiem, ale już nie wracają."]
	quest.01748C2CD9C97523.title: "&cPojawiające się \\& Znikające Bloki"
	quest.04440BB2EFFD6DD9.quest_desc: ["W głębi Labyrinth Swamp znajduje się gigantyczny &cMinoshroom&r.\\n\\nPo pokonaniu upuści &eMeef Stroganoff&r. Aby odblokować kolejny obszar, musisz go zjeść."]
	quest.04440BB2EFFD6DD9.title: "&cMighty Meef Stroganoff"
	quest.0990D6CEE042F44E.quest_desc: ["Ta mapa to absolutna podstawa w &9Twilight Forest&r.\\n\\nUżycie &eBlank Magic Map&r da Ci mapę pokazującą ikony pobliskich bossów i struktur."]
	quest.0990D6CEE042F44E.title: "&eMagic Map"
	quest.0A207A437AF153AA.quest_desc: ["&2Phantom Armor&r można znaleźć w skrzyniach &2Knight Phantom&r z pewną szansą."]
	quest.0A207A437AF153AA.title: "&2Phantom Armor"
	quest.0D2084DA2F3F4BB2.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.0E9DE6293DF611E1.quest_desc: ["Chcesz, aby &aOverworld&r bardziej przypominało &9Twilight Forest&r?\\n\\nMożesz użyć tego proszku na zwierzętach w Overworldzie, aby zamienić je w ich warianty z &9Twilight Forest&r.\\n\\nZnajdziesz go w skrzyniach w lochach w &9Twilight Forest&r."]
	quest.0ED7B25DC1AA767B.quest_desc: ["W &9Twilight Forest&r są skrzynie z łupami, które mogą dać rzadkie sadzonki.\\n\\nZbierz je wszystkie!"]
	quest.0ED7B25DC1AA767B.quest_subtitle: "Rosnące Drzewa"
	quest.0ED7B25DC1AA767B.title: "&aPrawdziwy Końcowy Boss"
	quest.111F2EE85FB0A455.quest_desc: ["Używając &cFiery Blood&r z Hydry, możesz wytworzyć kilka narzędzi.\\n\\nFiery Sword ma Fire Aspect II.\\n\\nFiery Pickaxe ma automatyczne przetapianie."]
	quest.111F2EE85FB0A455.title: "&cFiery Tools"
	quest.1464D45C474464DB.quest_subtitle: "Wychwalana Dmuchawa do Liści"
	quest.15006CF73F8CAB7C.quest_desc: ["Podobnie jak &cCharm of Life I&r, &eCharm of Life II&r zostaje zużyty, aby zapobiec Twojej śmierci. Po zużyciu odzyskasz całe zdrowie i otrzymasz Regen IV, Resistance oraz Fire Resistance na 30 sekund.\\n\\nMożna go wytworzyć z 4 &cCharms of Life I&r."]
	quest.15006CF73F8CAB7C.title: "&eCharm of Life II"
	quest.1FF5906DF721D091.quest_desc: ["&2Hydra&r upuszcza &cFiery Blood&r, z którego można wytworzyć &cFiery Armor&r.\\n\\nGdy nosisz cały komplet, wrogowie, którzy Cię atakują, zostaną podpaleni na 10 sekund."]
	quest.1FF5906DF721D091.title: "&cFiery Armor"
	quest.20436AFCC7E6855D.quest_desc: ["Mając Magic Beans i Uberous Soil, wypatruj dużej chmury w biomach Highland.\\n\\nZasadź magic beans w ziemi, aby wyrosła łodyga aż do nieba. Tam znajdziesz Giants.\\n\\nMusisz zabić Miner Giant i zdobyć jego kilof, aby iść dalej."]
	quest.20436AFCC7E6855D.quest_subtitle: "Giganci Wyglądają jak Ja, Ale Wcale Nie Są do Mnie PODOBNI"
	quest.212EC1F41227184D.quest_desc: ["Chcesz strzelać wybuchami Endu jak &eLich&r? Jeśli tak, &9Scepter of Twilight&r to berło dla Ciebie!\\n\\nAby je naładować, połącz je z &5Ender Pearl&r w siatce wytwarzania."]
	quest.212EC1F41227184D.quest_subtitle: "Strzela Wybuchami Endu"
	quest.212EC1F41227184D.title: "&9Scepter of Twilight"
	quest.25906B43A198B72F.quest_desc: ["Knightmetal Armor&r można wytworzyć z Knightmetal Ingots, a także znaleźć w skrzyniach &2Knight Phantom&r."]
	quest.25906B43A198B72F.title: "Knightmetal Armor"
	quest.2951B1D7080C5EF9.quest_desc: ["Za pomocą &6Lamp of Cinders&r możesz niszczyć Thorns w biomie Thornland.\\n\\nZbierz trochę &cThorn Roses&r, aby przejść do &2Final Plateau&r."]
	quest.2951B1D7080C5EF9.title: "Każdy Cierń Ma Swoją Różę"
	quest.2A0B3C91D72E8B75.quest_desc: ["Małe Yeti i Winter Wolves upuszczają Arctic Fur, z którego można wytworzyć &6Arctic Armor&r."]
	quest.2A0B3C91D72E8B75.quest_subtitle: "Da Się To Farbować!"
	quest.2A0B3C91D72E8B75.title: "&6Arctic Armor"
	quest.2BEBF66D7EA594FA.quest_desc: ["Ta zbroja jest nieco mocniejsza niż zbroja z &2Naga&r i jest w pełni zaklęta.\\n\\nMożesz ją wytworzyć, znajdując &2Steeleaf&r w &9Twilight Forest&r."]
	quest.2BEBF66D7EA594FA.title: "&2Steeleaf Armor"
	quest.31BB7EB95CE73C1A.quest_desc: ["Po pokonaniu &cUr-Ghast&r odblokujesz biomy Snowy Forest.\\n\\nJest tam wiele stworzeń do walki, ale aby kontynuować postęp, musisz zabić Alpha Yeti.\\n\\nAlpha Yeti znajdziesz w ogromnej jaskini Yeti. Pokonaj go, aby ruszyć dalej."]
	quest.31BB7EB95CE73C1A.quest_subtitle: "Miałeś Śnieżny Pomysł"
	quest.31BB7EB95CE73C1A.title: "Do Śnieżnych Biomów!"
	quest.3371570F189DF994.quest_desc: ["&6Scepter of Fortification&r przywołuje wokół Ciebie tarcze dla ochrony.\\n\\nAby go naładować, połącz go z &6Golden Apples&r w siatce wytwarzania."]
	quest.3371570F189DF994.quest_subtitle: "Przywołuje Tarcze"
	quest.3371570F189DF994.title: "&6Scepter of Fortification"
	quest.3531B28F14CF72A2.quest_desc: ["Pierwszego bossa, którego musisz pokonać podczas przygody w &9Twilight Forest&r, znajdziesz na Courtyard.\\n\\n&2Naga&r to zielony wąż złożony z wielu segmentów; w miarę zadawania mu obrażeń jego segmenty będą znikać.\\n\\nZabicie &2Naga&r da Ci kilka fajnych przedmiotów i otworzy wejście do domu kolejnego bossa - Lich."]
	quest.3531B28F14CF72A2.title: "&2Wyrównanie Łusek"
	quest.38ADDF7FF4E4892D.quest_desc: ["&7Glass Sword&r zadaje 40 serc obrażeń, ale ma tylko 1 punkt wytrzymałości.\\n\\nMożesz sprawić, że będzie niezniszczalny, jeśli chcesz go używać.\\n\\nRzadko można go znaleźć w skrzyniach z łupami w &bAurora Palace&r."]
	quest.38ADDF7FF4E4892D.title: "&7Glass Sword"
	quest.3908F7C80154D9CA.quest_desc: ["&2Zombie Scepter&r istnieje, bo kto nie chciałby przywołać własnych &2zombie&r?\\n\\nAby go naładować, połącz go z &cRotten Flesh&r w siatce wytwarzania."]
	quest.3908F7C80154D9CA.quest_subtitle: "Przywołuje Zombie"
	quest.3908F7C80154D9CA.title: "&2Zombie Scepter"
	quest.3A3ED88027331A6C.quest_desc: ["&eCharm of Keeping III&r działa tak samo jak pozostałe Charms of Keeping, ale chroni Cię przed utratą wszystkich rzeczy z ekwipunku."]
	quest.3A3ED88027331A6C.title: "&eCharm of Keeping III"
	quest.3C8724C3A9459507.quest_desc: ["Yeti Armor można wytworzyć z Alpha Yeti Fur."]
	quest.3C8724C3A9459507.title: "Yeti Armor"
	quest.3D29EF7F150F5334.quest_desc: ["&3Ender Bow&r rzadko można znaleźć w &bAurora Palace&r.\\n\\nGdy wróg zostanie trafiony strzałą z tego łuku, zamienisz się z nim miejscami. Uważaj, strzelając do rzeczy na niebie!"]
	quest.3D29EF7F150F5334.title: "&3Ender Bow"
	quest.3DCF26B53AE1EBF6.quest_desc: ["W &2Dark Forest&r znajdziesz strukturę prowadzącą pod ziemię.\\n\\nAby wejść, musisz położyć jedno ze zdobytych trofeów bossów na pobliskim piedestale. Nie martw się, które położysz, możesz je z powrotem podnieść.\\n\\nNa 3. warstwie znajdziesz Knight Phantoms. Pokonaj ich, aby odblokować kolejnego bossa."]
	quest.3DCF26B53AE1EBF6.quest_subtitle: "Najmroczniejszy z Lasów"
	quest.3DCF26B53AE1EBF6.title: "&2Dark Forest"
	quest.40258842B0359A2D.quest_desc: ["&6Ironwood Armor&r można wytworzyć z &6Ironwood&r i jest automatycznie zaklęta."]
	quest.40258842B0359A2D.title: "&6Ironwood Armor"
	quest.4193303999597249.quest_desc: [
		"&9Twilight Forest&r to mod dodający do gry wymiar Twilight Forest. Ten wymiar jest pełen zupełnie nowych przedmiotów, biomów, mobów i bossów!\\n\\nAby stworzyć portal do &9Twilight Forest&r, wykop w ziemi dół 2x2 i wypełnij go wodą. Otocz krawędzie dołu kwiatami i wrzuć Diamond do wody.\\n\\nJeśli zrobiłeś wszystko poprawnie, Thor da Ci znak, a portal się aktywuje.\\n"
		"{image:atm:textures/questpics/gettingstarted/twilight_portal.png width:100 height:100 align:center fit:true}"
	]
	quest.4193303999597249.quest_subtitle: "Wejdź do Twilight Forest"
	quest.4193303999597249.title: "Witaj w &9Twilight Forest&r!"
	quest.420158B1736A1354.quest_desc: ["...nie jest zaimplementowany.\\n\\nZamiast tego udaj się do gigantycznego zamku na Final Plateau i weź trochę bloków drzwi!\\n\\nPojawia się tam Kobold jako \"atrapa\", ale za jego zabicie nic nie dostaniesz."]
	quest.420158B1736A1354.title: "&cOstateczny Boss"
	quest.4665E6FD0AAED164.quest_desc: ["&fCharm of Keeping II&r działa tak samo jak &6Charm of Keeping I&r, ale chroni też rzeczy z paska szybkiego dostępu, gdy umrzesz."]
	quest.4665E6FD0AAED164.title: "&fCharm of Keeping II"
	quest.49EE6D2A3684A510.quest_desc: ["&bIce Bow&r można znaleźć losowo w skrzyniach z łupami; po trafieniu nakłada Slowness III na 10 sekund."]
	quest.49EE6D2A3684A510.title: "&bIce Bow"
	quest.4B95D48D7525FFAD.quest_desc: ["Czas na &2Swamps&r! W &2Swamps&r znajdziesz dziwnie wyglądające wzgórze z wejściem na szczycie. To &cMinoshroom Labyrinth&r!\\n\\nW środku zmierzysz się z kilkoma nowymi wrogami, którzy mogą upuścić &eMaze Map Focus&r. Jest on potrzebny do wytworzenia &eMaze Map&r.\\n\\nTo specjalna mapa, która pokaże Ci drogę po &cMinoshroom Labyrinth&r. Minimapy nie mają tu mocy.\\n\\nZnajdziesz też kilka pomieszczeń z łupami, w których czeka specjalny łup do Labiryntu!"]
	quest.4B95D48D7525FFAD.quest_subtitle: "Gdzie Jest Shrek?"
	quest.4B95D48D7525FFAD.title: "&2Do Swamps!"
	quest.4D4AB60B3B1CD437.quest_desc: ["Z łusek &2Naga&r możesz wytworzyć zbroję.\\n\\nZbroja nie jest zbyt mocna, ale ładnie wygląda."]
	quest.4D4AB60B3B1CD437.title: "&2Naga Scale Armor"
	quest.4DA0725E089D7C91.quest_desc: ["Znajdź &cQ&6u&ee&2s&3t&9i&5n&cg &6R&ea&2m&r, bo obdarowuje bogactwem tych, którzy dadzą mu &cR&6a&ei&2n&3b&9o&5w &6W&eo&2o&3l&r (16 kolorów).\\n\\nWskazówka: Nad Twoją głową w ruinach, gdzie stoi Ram, znajduje się Dispenser. Może się przydać."]
	quest.4DA0725E089D7C91.quest_subtitle: "Zadania?"
	quest.4DA0725E089D7C91.title: "&cR&6a&em&2i&3f&9i&5c&ca&6t&ei&2o&3n"
	quest.4F66DF6B494BEFF3.quest_desc: ["Połączenie &8Raven Feather&r z &eTorchberries&r i &6Glowstone&r da Ci &eMagic Map Focus&r."]
	quest.4F66DF6B494BEFF3.title: "&eMagic Map Focus"
	quest.51BC981AB4CFAD95.quest_desc: ["Mazebreaker to specjalny kilof, który rzadko można znaleźć w Labiryntach.\\n\\nTen kilof otrzymuje 1 punkt uszkodzeń przy niszczeniu Maze Walls, zamiast 16 punktów, jak wszystkie inne kilofy!"]
	quest.51BC981AB4CFAD95.quest_subtitle: "Pułapkowa Komnata, Nie Wchodzić?"
	quest.53A79338994088FD.quest_desc: ["&dTri-Bow&r wypada ze &3Snow Queen&r; strzela 3 strzałami jednocześnie, zużywając tylko jedną."]
	quest.53A79338994088FD.quest_subtitle: "Od Lynela?"
	quest.53A79338994088FD.title: "&dTri-Bow"
	quest.575E405B270BBCBC.quest_desc: ["W &9Twilight Forest&r czeka mnóstwo nowych stworzeń do odkrycia.\\n\\nJednym z najgorszych jest Cicada. Polecam zabić ją w tym celu, ale zadziała zabicie dowolnego moba z Twilight Forest."]
	quest.575E405B270BBCBC.title: "Cisza Lasu"
	quest.57940981E8DE55D4.quest_desc: ["Łatwo zgubić się w &9Twilight Forest&r. Podczas podróży natrafisz na &5Obsidian Pillars&r.\\n\\nWokół tych filarów krążą &8Ravens&r. Zabij je, a upuszczą pióra, z których możesz stworzyć mapę &9Twilight Forest&r!"]
	quest.57940981E8DE55D4.title: "&8Raven Feathers"
	quest.58BD1063A19777DC.quest_desc: ["Gdy odblokujesz biom &2Highland&r, udaj się tam i znajdź kilka Trolls do zabicia.\\n\\nMogą upuścić &9Magic Beans&r. Znajdziesz też skrzynie z Uberus Soil, które jest potrzebne do wyhodowania Magic Beans."]
	quest.58BD1063A19777DC.quest_subtitle: "Gdzie Jest Jaś?"
	quest.58BD1063A19777DC.title: "Wizyta u Giants"
	quest.5CBA8C89FE717B9C.quest_desc: ["Mając &8Giant's Pickaxe&r, wróć do Troll Caves, aby znaleźć &5Giant Obsidian&r.\\n\\nUżyj &8Giant's Pickaxe&r, aby go zniszczyć, a znajdziesz trochę łupów. Zdobądź &6Lamp of Cinders&r, aby iść dalej."]
	quest.5CBA8C89FE717B9C.title: "&6Lamp of Cinders"
	quest.5FE4DAE8F41B1437.quest_desc: ["&cOre Magnet&r przyciąga wszystko, co w nazwie ma „Ore”, poza Coal.\\n\\nMożna go znaleźć w skrzyniach w &2Hollow Hill&r."]
	quest.5FE4DAE8F41B1437.title: "&cOre Magnet"
	quest.604F2B68B27885BF.quest_desc: ["Z &9Twilight Forest&r można zrobić mnóstwo różnych potraw!\\n\\nWypróbuj je wszystkie!"]
	quest.604F2B68B27885BF.title: "Wyszukane Smakołyki"
	quest.607D592CE102C82E.title: "Knightmetal Tools"
	quest.60FC2DAEA954A849.quest_desc: ["&6Moonworm Queen&r jest jak wyrzutnia pochodni. Wystrzeliwuje &eMoonworms&r w wybrany blok, które oświetlają go podobnie jak pochodnia.\\n\\nMożna je znaleźć w niektórych skrzyniach z łupami w &2Hollow Hill&r i &eLich Tower&r."]
	quest.60FC2DAEA954A849.title: "&6Moonworm Queen"
	quest.610F9E9D0B5131C7.quest_desc: ["&6Charm of Keeping I&r zapobiega utracie przedmiotów z głównej i drugiej ręki oraz wszystkich noszonych części zbroi, gdy umrzesz."]
	quest.610F9E9D0B5131C7.title: "&6Charm of Keeping I"
	quest.688C911ECFB2F134.quest_desc: ["W &2Dark Forest&r znajdziesz &8Dark Tower&r.\\n\\nAby wejść, poszukaj Reappearing Blocks u podstawy. Przejdź przez labirynt aż na ostatnie piętro, aby zmierzyć się z &cUr-Ghast&r.\\n\\n&cUr-Ghast&r najlepiej zabijać bronią dystansową. Na piętrze bossa znajdują się 4 pułapki Ghast, które można wykorzystać do zadawania obrażeń &cUr-Ghast&r.\\n\\nŁaduje się je zabijaniem &cGhastling&r, a następnie aktywuje redstonem. Nie musisz ich używać, ale mogą się przydać."]
	quest.688C911ECFB2F134.quest_subtitle: "Mroczna Wieża z Carmonite"
	quest.688C911ECFB2F134.title: "&cTears of Fire"
	quest.6CB1BFBA10DF24E4.quest_desc: ["Za pomocą &cScepter of Life Draining&r możesz wysysać życie swoich wrogów!\\n\\nAby naładować berło, połącz je z &cFermented Spider Eyes&r w siatce wytwarzania."]
	quest.6CB1BFBA10DF24E4.quest_subtitle: "Wysysa Życie"
	quest.6CB1BFBA10DF24E4.title: "&cScepter of Life Draining"
	quest.6F67079A453DAABE.quest_desc: ["&cCharm of Life I&r to przedmiot jednorazowego użytku, który zapobiega śmierci. Zamiast umrzeć, ten Charm zostanie zużyty, a Ty otrzymasz regenerację zdrowia na krótki czas.\\n\\nMożna je znaleźć w skrzyniach z łupami."]
	quest.6F67079A453DAABE.title: "&cCharm of Life I"
	quest.6FD41DF7704466A4.quest_desc: ["Pokonanie Alpha Yeti odblokowuje biom &9Glacier&r. Znajdziesz tam urocze małe pingwiny i &3Snow Queen&r.\\n\\nNa szczycie &bAurora Palace&r &3Snow Queen&r przywoła kryształy lodu, aby się chronić.\\n\\nBędzie też uderzać w dół &3lodem&r, który może zniszczyć podłogę i zadać ogromne obrażenia.\\n\\nTrafisz tylko jej górną połowę, ponieważ reszta jest chroniona &3lodem&r.\\n\\nPo pokonaniu &3Snow Queen&r odblokujesz dostęp do &2Highlands&r."]
	quest.6FD41DF7704466A4.title: "&bBezchmurne Niebo"
	quest.7026E46FD8B3A81D.quest_desc: ["&9Hydra&r to osławiona wielogłowa bestia z mitologii greckiej.\\n\\nAtaki dystansowe nie są tak skuteczne, więc musisz podejść blisko i walczyć w zwarciu.\\n\\nPo jej pokonaniu znajdziesz kolejnego bossa w &2Dark Forest&r."]
	quest.7026E46FD8B3A81D.quest_subtitle: "Ogniste Bagno"
	quest.7026E46FD8B3A81D.title: "&9Pogromca Hydry"
	quest.730AF9210F00018E.quest_desc: ["&bDiamond Minotaur Axe&r wypada z &cMinoshroom&r. Zadaje więcej obrażeń, gdy użytkownik sprintuje."]
	quest.730AF9210F00018E.title: "&bMinotaur Axe"
	quest.7509E4093010EA4C.quest_desc: ["&aSeeker Bow&r wypada ze &3Snow Queen&r; strzela strzałami, które automatycznie naprowadzają się na cele. Koniec z pudłami!"]
	quest.7509E4093010EA4C.quest_subtitle: "Kiepski Cel?"
	quest.7509E4093010EA4C.title: "&aSeeker Bow"
	quest.78CE2ECEF0B651DA.quest_desc: ["Znaleziony w &bAurora Palace&r &3Ice Sword&r nakłada na wrogów &bFrosted&r na 10 sekund po zadaniu obrażeń."]
	quest.78CE2ECEF0B651DA.title: "&3Ice Sword"
	quest.7B4A687EB505C2FF.quest_desc: ["&cCarminite Builders&r, po zasileniu sygnałem redstone, generują tymczasowe bloki w kierunku, z którego przyszedł sygnał.\\n\\n&cCarminite Reactor&r zamienia pobliski Obsidian i Netherrack w &eFalse Gold&r i &3False Diamond&r. Po krótkim czasie wchłonie pobliskie bloki i wybuchnie, tworząc wokół siebie &cCarminite Ghastlings&r."]
	quest.7B4A687EB505C2FF.title: "&cCarmanite Builders \\& Reactors"
}
