{
	quest.00CB8D60E7831A57.quest_desc: ["Catacombs to potężne podziemne budowle z cegieł Depthrock Bricks. Możesz natrafić na ich fragment wystający z ziemi. \\n\\nWewnątrz ogromnego labiryntu kryją się &7Forgottens&r, ukryte skrzynie oraz boss: &aForgotten Guardian&r. \\n\\nMam nadzieję, że jesteś na to przygotowany!"]
	quest.00CB8D60E7831A57.title: "Catacombs"
	quest.01B13BBB41BBB460.quest_desc: ["&cUtherium Armor&r ma takie same statystyki jak Netherite Armor! \\n\\nI to bez potrzeby użycia Smithing Template!"]
	quest.01B13BBB41BBB460.title: "Zbroja &cUtherium&r"
	quest.050D8480EE9D8E62.quest_desc: [
		"Wigglewood Forests to lasy jak wszystkie inne. \\n\\nTyle że tutejsze drzewa rosną, jak im się podoba."
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "Wigglewood Forest"
	quest.06D13E319C26C949.quest_desc: [
		"Blood Mushroom Bog to dom gigantycznych grzybów Blood Mushrooms. \\n\\nKrew mnie niepokoi, więc chyba skrócę ten opis."
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "Blood Mushroom Bog"
	quest.073BA8470EA37A00.quest_desc: [
		"Kolejne morze, tylko że to jest znacznie zimniejsze."
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "Icy Sea"
	quest.08D9C809CF4062E8.quest_desc: ["Jedz je na surowo, piecz je albo nabijaj na patyk. \\n\\nCzego nie da się zrobić z Underbeans!"]
	quest.0A0A991BAC99092C.quest_desc: [
		"Indigo Mushroom Bog jest o wiele bardziej zabagniony niż Blood Mushroom Bog. \\n\\nOczywiście rosną tu Indigo Mushrooms, ale też małe drzewa Smogstem i stawy z Virulent Mix. Ciekawe, co to robi..."
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "Indigo Mushroom Bog"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"&dNargoyles&r to paskudne, wrogie moby, które pojawiają się pod ziemią. \\n\\nMają 7 i pół serca i będą bez wytchnienia próbowały Cię zabić. \\n\\nNiczego nie upuszczają i służą tylko jako przeszkoda dla tych, którzy chcą spokojnie kopać. "
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0C98503A2F20484D.quest_desc: [
		"W pobliżu Frostfields możesz znaleźć Frosty Smogstem Forests. \\n\\nSą dokładnie jak Frostfields, tylko z drzewami Smogstem!"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "Frosty Smogstem Forest"
	quest.0D91A6B36BD2F526.quest_desc: ["Ulepsz swój &7Cloggrum Battleaxe&r, aby stworzyć najlepszą broń, jaką może zaoferować &2&lUndergarden&r!"]
	quest.0D91A6B36BD2F526.title: "Najlepsza Broń!"
	quest.0FA77C28A57E06F1.quest_desc: ["Veiled Mushrooms można znaleźć tylko w ich bagnie. \\n\\nMają brązowe kapelusze, a jeśli pod nimi jest powietrze, wyrastają z nich Mushroom Veils. Stąd ta nazwa!"]
	quest.1054168AFD8520D4.quest_desc: [
		"&aForgotten Guardian&r to ogromny golem zbudowany z &aForgotten Ingots&r. \\n\\nZaatakuje gracza i zrobi wszystko, by go zabić. \\n\\nMa 80 serc, a jeśli uda Ci się go pokonać, upuści &aForgotten Nuggets&r."
		"{image:atm:textures/questpics/undergarden/undergarden_guardian.png width:100 height:200 align:center}"
	]
	quest.1054168AFD8520D4.title: "&aForgotten Guardian&r"
	quest.1190BB433EFA3945.quest_desc: ["Slingshot to bardzo zabawna broń dodana przez &2&lUndergarden&r. Można z niej strzelać czterema rodzajami amunicji: \\n\\nScintling Goo po trafieniu w moba nałoży na niego efekt Gooey. \\n\\nDepthrocks to zwykłe pociski. \\n\\nRotten Blisterberries wybuchają przy uderzeniu. \\n\\nA &eGronglets&r nie zadają żadnych obrażeń, tylko hałasują i są wystrzeliwane!"]
	quest.119242549BD21764.quest_desc: [
		"&eBrutes&r pojawiają się w kilku biomach i są neutralne. \\n\\nJeśli uderzysz jednego, wszystkie w okolicy zaatakują Ciebie. Podobnie jak wilki czy Zombified Piglins. \\n\\nPo śmierci mogą upuścić swoje Tusks, które zastępują Bones!"
		"{image:atm:textures/questpics/undergarden/undergarden_brute.png width:100 height:100 align:center}"
	]
	quest.119242549BD21764.title: "&eBrutes&r"
	quest.130577AD1A1A8222.quest_desc: ["&7Cloggrum&r ma statystyki nieco gorsze niż żelazna zbroja, ale praktycznie rośnie na drzewach, więc chyba to uczciwe. \\n\\nButy dodatkowo pomagają przechodzić przez Scintling Goo!"]
	quest.130577AD1A1A8222.title: "Zbroja &7Cloggrum&r"
	quest.141681FE9E524FB0.quest_desc: [
		"&7Forgottens&r to wojownicy, którzy pojawiają się w strukturze Catacomb. \\n\\nNoszą Ancient Armor i dzierżą narzędzia Cloggrum, które mogą wypaść po ich śmierci. \\n\\nBędą też atakować i zabijać &cRot Mobs&r."
		"{image:atm:textures/questpics/undergarden/undergarden_forgotten.png width:100 height:200 align:center}"
	]
	quest.141681FE9E524FB0.title: "&7Forgotten&r"
	quest.15A8F04BC10E619E.quest_desc: [
		"Niektórzy nie znoszą zwiedzać wielu różnych biomów, żeby zdobyć wszystkie sadzonki drzew. \\n\\nTwórca &2&lUndergarden&r najwyraźniej też, więc umieścił większość z nich w Dense Forest!"
		"{image:atm:textures/questpics/undergarden/undergarden_dense.png width:200 height:100 align:center}"
	]
	quest.15A8F04BC10E619E.title: "Dense Forest"
	quest.16A04B2FC3F0D902.quest_desc: ["Narzędzia &7Cloggrum&r działają tak samo jak żelazne narzędzia, tylko bardziej przypominają błoto niż żelazo! \\n\\nMiecz zadaje jednak większe obrażenia niż Iron Sword."]
	quest.16A04B2FC3F0D902.title: "Narzędzia &7Cloggrum&r"
	quest.17C2C8F64B4AE6EE.quest_desc: [
		"&2Dwellers&r to krowy z &2&lUndergarden&r. \\n\\nSą pasywne, a po śmierci upuszczają Leather i Dweller Meat. \\n\\nDzięki Bogu, że nie da się ich doić, bo nie chcę mleka od &2Dwellers&r."
		"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
	]
	quest.17C2C8F64B4AE6EE.title: "&2Dweller&r"
	quest.19862DBCE9305DE3.quest_desc: ["&3Spear&r to ulubiona broń &7Denizens&r... obok drewnianej siekiery. \\n\\nDo jej wytworzenia potrzebujesz 2 patyków i &3Rogdorium&r. \\n\\nMa te same obrażenia co &bDiamond Sword&r, a do tego większy zasięg! \\n\\nMożna ją też rzucać jak trójząb."]
	quest.19862DBCE9305DE3.title: "&3Spear"
	quest.1A23BBF444D17A63.quest_desc: [
		"&2Greater Dwellers&r pojawiają się poniżej poziomu Y 0. Będziesz potrzebować &aForgotten Pickaxe&r lub &6Allthemodium Pickaxe&r, aby wykopać blokujący drogę Dreadrock. \\n\\n&2Greater Dwellers&r ewoluowały inaczej niż ich mniejsi krewni - Depths są niebezpieczne, więc musiały stać się większe i silniejsze! \\n\\nSą teraz większe i mają 100 serc. Są też neutralne zamiast pasywnych. Podobnie jak Zombified Piglins: jeśli jednego uderzysz, wszystkie zaatakują."
		"{image:atm:textures/questpics/undergarden/undergarden_greater.png width:100 height:100 align:center}"
	]
	quest.1A23BBF444D17A63.title: "&2Greater Dweller"
	quest.1BAE1519E44E40CE.quest_desc: [
		"Wyobraź sobie Ancient Sea. Teraz usuń z niej wszystkie wodorosty oraz wszystkie &bGwibs&r i &bGwiblings&r. \\n\\nTo właśnie jest Dead Sea!"
		"{image:atm:textures/questpics/undergarden/undergarden_dead.png width:200 height:100 align:center}"
	]
	quest.1BAE1519E44E40CE.title: "Dead Sea"
	quest.1C232674CD04024D.quest_desc: ["Wymiar &2&lUndergarden&r jest pełen różnorodnych i obrzydliwych biomów, bogatych w roślinność, moby - przyjazne i nieprzyjazne - a także rudy i przedmioty. \\n\\nMam nadzieję, że jesteś gotowy do walki!"]
	quest.1C232674CD04024D.title: "Witaj w &2&lUndergarden&r!"
	quest.1D2C70F1750E84D0.quest_desc: [
		"Nowy mob &cRot&r? \\n\\n&cRotbelcher&r ma 17 i pół serca oraz 4 punkty pancerza. \\n\\nJeśli jesteś blisko, zamachnie się na Ciebie rękami. Jeśli stoisz trochę dalej, będzie w Ciebie pluł. \\n\\nPrzydałby mu się płyn do płukania ust, skoro jego ślina jest taka paskudna."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbelcher.png width:100 height:200 align:center}"
	]
	quest.1D2C70F1750E84D0.title: "&cRotbelcher"
	quest.1E13D7CE5A9EFF74.quest_desc: [
		"Frostfields to jeden z zimnych biomów w &2&lUndergarden&r. Poznasz, że jest zimny, po ogromnych soplach, Powdered Snow i Frozen Deepturf! \\n\\nTutaj zamiast zwykłego podziemnego Depthrock znajdziesz Shiverstone. \\n\\nShiverstone zachowuje się bardziej jak lód niż prawdziwy kamień. Przynajmniej gdy się na nim stoi!"
		"{image:atm:textures/questpics/undergarden/undergarden_frosty.png width:200 height:100 align:center}"
	]
	quest.1E13D7CE5A9EFF74.title: "Frostfields"
	quest.1E81B903137BB62A.quest_desc: ["Zwykłe narzędzia nie wystarczą, zwłaszcza w starciu z niebezpiecznymi mobami z &2&lUndergarden&r. \\n\\nMożemy wytworzyć &7Cloggrum Shield&r, który działa jak zwykła tarcza. \\n\\nAle &7Battleaxe&r musimy zdobyć jako rzadki łup z &7Forgottens&r."]
	quest.1E81B903137BB62A.title: "Broń z &7Cloggrum&r"
	quest.1FCF946B7BE3C0BD.quest_desc: ["Narzędzia &cUtherium&r są podobne do diamentowych narzędzi, ale ich broń jest skuteczniejsza przeciwko mobom &cRot&r! \\n\\nWykorzystujesz to, co one tworzą, by zadawać im więcej obrażeń! Pewnie mógłbym tu nawiązać do tuzina odniesień z popkultury, ale żadne nie przychodzi mi do głowy..."]
	quest.1FCF946B7BE3C0BD.title: "Narzędzia &cUtheric&r"
	quest.22739522F0D33D7B.quest_desc: ["Gloomgourds pojawiają się i uprawia się je jak dynie. \\n\\nTak samo jak z dyniami, można z nich zrobić ciasto, a nawet Jack-O-Lanterns! \\n\\nW przeciwieństwie do dyń można z nich robić materiały wybuchowe..."]
	quest.24D38DA8E86DD897.quest_desc: [
		"Najmniejszy i najsłabszy z mobów &cRot&r. \\n\\nMają 5 serc. \\n\\nJak wszystkie moby &cRot&r będą atakować &2Stoneborns&r i &7Forgottens&r oraz upuszczać &cUtheric Shards&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotling.png width:100 height:100 align:center}"
	]
	quest.24D38DA8E86DD897.title: "&cRotling&r"
	quest.257893DD23BF5017.quest_desc: ["Aby zdobyć &3Rogdorium&r, musimy odwiedzić Depths pod poziomem Y 0. Potrzebujesz do tego &aForgotten Pickaxe&r lub &6Allthemodium Pickaxe&r. \\n\\nTakiego samego kilofa potrzebujesz też do wykopania &3Rogdorium Ore&r. Występuje ono w całych Depths. \\n\\nMożesz też użyć &aForgotten&r lub &6Allthemodium Axe&r, aby zebrać &3Rogdoric Ancient Root&r. Jest ich znacznie więcej, ale dają tylko &3Rogdorium Nugget&r, w porównaniu z pełną wersją, którą daje &3Ore&r."]
	quest.257893DD23BF5017.title: "&3Rogdorium"
	quest.278D34BBC13356DF.quest_desc: [
		"Fioletowe bagno! \\n\\nWszędzie rosną tu Ink Mushrooms i leży Virulent Mix!"
		"{image:atm:textures/questpics/undergarden/undergarden_ink.png width:200 height:100 align:center}"
	]
	quest.278D34BBC13356DF.title: "Ink Mushroom Bog"
	quest.2A2041098C069772.quest_desc: [
		"&7Denizens&r pojawiają się w Depths, czyli poniżej poziomu Y 0. Aby się tam dokopać, potrzebujesz &aForgotten Pickaxe&r lub kilofa tego samego poziomu. \\n\\n&7Denizens&r wyglądają dziwnie i obrzydliwie po ludzku, noszą Mysterious Masks i trzymają Spear albo drewnianą siekierę. \\n\\n&7Denizens&r są niskie i okrągłe albo wysokie i chude. Ale wszystkie mają 10 serc. \\n\\nNie upuszczają niczego poza ewentualnie swoją bronią."
		"{image:atm:textures/questpics/undergarden/undergarden_denizens.png width:100 height:200 align:center}"
	]
	quest.2A2041098C069772.title: "&7Denizen"
	quest.2C5A7E4CD8B57E08.quest_desc: ["Grongle Trees to wysokie drzewa przypominające drzewa Jungle, które pojawiają się tylko w biomach Gronglegrowth! \\n\\nNa tych drzewach pojawiają się też &eGronglets&r."]
	quest.2E596B5A4EA2ABF4.quest_desc: [
		"Czy ten Smogvent się rusza? Chwila, to tylko &3S'Mog&r! Bliski kuzyn &2Mog&r! \\n\\nZachowują się dokładnie jak &2Mogs&r, tylko te mogą upuszczać Blue Mogmoss."
		"{image:atm:textures/questpics/undergarden/undergarden_smog.png width:100 height:100 align:center}"
	]
	quest.2E596B5A4EA2ABF4.title: "&3S'Mog&r"
	quest.30582B5FBED35FD1.quest_desc: ["&cUtheric Clusters&r i &cShards&r mogą wypaść z wielu różnych mobów, zwłaszcza z potworów &cRot&r. \\n\\n9 &cShards&r daje 1 &cCluster&r. \\n\\nNastępnie musimy użyć bloku Infuser, aby połączyć &3Rogdorium&r i &cUtheric Cluster&r w &cUtheric Crystal&r."]
	quest.30582B5FBED35FD1.title: "&cUtheric&r"
	quest.30D6924003C6E273.quest_desc: ["&7Denizen&r Camps można znaleźć w Depths. Musisz kopać poniżej poziomu Y 0, za Dreadrock. \\n\\nAby wykopać Dreadrock, potrzebujesz &aForgotten Pickaxe&r. To ten sam poziom co &6Allthemodium Pickaxe&r. \\n\\nPojawia się tu wielu &7Denizens&r, a także Mysterious Totems i skrzynie! Rzadko w skrzyni może pojawić się Mysterious Mask, taka sama, jaką noszą &7Denizens&r. \\n\\nNoszenie Mysterious Mask w pobliżu &7Denizens&r jest jak noszenie &ezłota&r przed Piglins. Będą neutralne, dopóki ktoś nie zostanie uderzony (albo nie zrobi się czegoś, co je rozjuszy)."]
	quest.30ED5FF9DF7B34CF.quest_desc: ["Możemy użyć Mysterious Totem, jeśli splądrujemy Denizen Camp albo go wytworzymy! \\n\\nEee... a jak się go używa? \\n\\nPo prostu postaw go, a co kilka sekund da Ci &bPurity&r na 10 sekund. \\n\\n&bPurity&r oczyści Cię z &cRot&r."]
	quest.353AEEC116A5DEEF.quest_desc: [
		"Ancient Seas to rozległe, otwarte morza w &2&lUndergarden&r. \\n\\nNie wiedzieć czemu, mimo całego zanieczyszczenia woda jest bezpieczna do picia. \\n\\nW wodzie żyją też &bGwibs&r i &bGwiblings&r. No i nie można zapomnieć o Glitterkelp!"
		"{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}"
	]
	quest.353AEEC116A5DEEF.title: "Ancient Sea"
	quest.36389696767EFB4E.quest_desc: [
		"Barren Abyss jest, jak sama nazwa wskazuje, jałowa... Nie ma tu nic prócz wrogich mobów i Pebbles. \\n\\nOsobiście wolałbym znajdować Pebbles gdziekolwiek indziej..."
		"{image:atm:textures/questpics/undergarden/undergarden_barren.png width:200 height:100 align:center}"
	]
	quest.36389696767EFB4E.title: "Barren Abyss"
	quest.380D3212D1CBA593.quest_desc: [
		"Średniej wielkości mob &cRot&r, &cRotwalker&r. \\n\\nMają 20 serc. \\n\\nJak wszystkie moby &cRot&r będą atakować &2Stoneborns&r i &7Forgottens&r oraz upuszczać &cUtheric Shards&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotwalker.png width:100 height:200 align:center}"
	]
	quest.380D3212D1CBA593.title: "&cRotwalker&r"
	quest.3AF7446592D19FA6.quest_desc: ["&eRegalium&r to odpowiednik Emerald w &2&lUndergarden&r. \\n\\nNie da się z niego zrobić zbroi ani narzędzi, ale można go użyć do handlu ze &2Stoneborns&r w zamian za inne przedmioty."]
	quest.3AF7446592D19FA6.title: "&eRegalium&r"
	quest.4141EF8B8C316118.quest_desc: ["&7Cloggrum&r to żelazo &2&lUndergarden&r. \\n\\nZnajdziesz go wszędzie i używa się go w tuzinie różnych receptur. \\n\\nNo proszę, nawet niektóre moby go upuszczają!"]
	quest.4141EF8B8C316118.title: "&7Cloggrum&r"
	quest.43A1BC20BB054A14.quest_desc: ["Glitterkelp rośnie w Ancient Seas i Icy Seas. \\n\\nNie robią wiele poza świeceniem i można z nich zrobić ciasto!"]
	quest.43FD4AEBB9548E57.quest_desc: [
		"Smogstem Forest to biom sąsiadujący z Indigo Mushroom Bogs. \\n\\nOczywiście też jest niebieski i rosną w nim Indigo Mushrooms! Tylko drzewa Smogstem są większe!"
		"{image:atm:textures/questpics/undergarden/undergarden_smogstem.png width:200 height:100 align:center}"
	]
	quest.43FD4AEBB9548E57.title: "Smogstem Forest"
	quest.4568C2F465EDB960.quest_desc: ["Droopfruit może wyrosnąć praktycznie w każdym biomie, wystarczy spojrzeć w górę! \\n\\nRośnie na suficie większości biomów i rozwija się podobnie jak świecące jagody."]
	quest.46DCB235D3FEDA61.quest_desc: ["Podobne do żelaznych narzędzi, tylko że wszystkie spowalniają tego, kogo uderzą. \\n\\nPoza motyką, ale kogo obchodzi zwykła motyka?"]
	quest.46DCB235D3FEDA61.title: "Narzędzia &bFroststeel&r"
	quest.4985F82E0D300C6D.quest_desc: ["Jeśli chcesz wrócić do &2&lOverworldu&r, ale nie możesz znaleźć swojego pierwotnego portalu, nie martw się, jest na to sposób! \\n\\nZ 4 Depthrock, 4 &7Cloggrum Ingots&r i &aForgotten Nugget&r możesz wytworzyć Crumbling Catalyst. \\n\\nCrumbling Catalyst działa tak samo jak zwykły Catalyst przy aktywacji portalu. "]
	quest.49EB9FB2133E3219.quest_desc: ["Ancient Armor noszą &7Forgottens&r i to od nich możesz ją zdobyć. \\n\\nNie ma jednak Ancient Boots, najwyraźniej &7Forgottens&r nie mają stóp."]
	quest.49EB9FB2133E3219.title: "Ancient Armor"
	quest.4C5CFA45D9B4F6D3.quest_desc: ["Indigo Mushrooms najwyraźniej bardzo się przyjaźnią ze Smogstem i pojawiają się głównie obok nich! "]
	quest.4C7E006502E30C20.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.4D836B9D9E3B898F.quest_desc: [
		"&aStoneborns&r to idealna mieszanka Villagerów i żelaznych golemów. \\n\\nMożesz z nimi handlować, klikając ich prawym przyciskiem myszy. \\n\\nI będą bronić się przed wrogimi mobami (oraz graczami, którzy je uderzą)."
		"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
	]
	quest.4D836B9D9E3B898F.title: "&aStoneborn&r"
	quest.4E3D548E5D8D7D26.quest_desc: [
		"Forgotten Fields to równiny z &2&lUndergarden&r. \\n\\nNie ma tu drzew, ale jest mnóstwo skał, kwiatów i mobów! \\n\\nNie pojawiają się tu jednak &7Forgottens&r, tak, przykro mi, że psuję Ci entuzjazm."
		"{image:atm:textures/questpics/undergarden/undergarden_field.png width:200 height:100 align:center}"
	]
	quest.4E3D548E5D8D7D26.title: "Forgotten Fields"
	quest.4F3B4990BE6C2A4A.quest_desc: [
		"&7Scintlings&r to małe, niewinne ślimaki spotykane wszędzie w &2&lUndergarden&r. \\n\\nZachowują się jak śnieżne golemy, czyli zostawiają ślad tam, gdzie chodzą. Tylko że ten jest bardziej lepki... \\n\\nPo śmierci upuszczają Scintling Goo, ale możesz je zbierać ze śladów, więc po co je zabijać!"
		"{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}"
	]
	quest.4F3B4990BE6C2A4A.title: "&7Scintling&r"
	quest.4F5A2E2A5C7F4837.quest_desc: ["&aForgotten Ingots&r trzeba zdobyć w Catacombs, plądrując skrzynie albo zabijając &aForgotten Guardian&r. \\n\\nPotrzebny będzie Ci też Smithing Template, który znajdziesz w skrzyniach w Catacombs."]
	quest.4F5A2E2A5C7F4837.title: "&aForgotten&r"
	quest.511144EF336BFAF5.quest_desc: [
		"Smog Spires to... tak, zgadłeś! Stąd bierze się cały smog! No, nie cały, nie można zapominać o &2Mogs&r i &3S'mogs&r. \\n\\nZnajdziesz tu Blisterberries, Coarse Deepsoil i Smog Vents. Nie polecałbym jednak zbliżać się do nich..."
		"{image:atm:textures/questpics/undergarden/undergarden_smogspires.png width:200 height:100 align:center}"
	]
	quest.511144EF336BFAF5.title: "Smog Spires"
	quest.51C59FDF0BD11FDF.quest_desc: ["Chyba jedyna definicja drzewa Wigglewood to to, że ma Wigglewood Logs i liście. Wydaje się, że rosną w dowolnym kierunku, rozmiarze i kształcie. \\n\\nZnajdziesz je w Wigglewood Forests i Dense Forests. \\n\\nMają ładne różowe liście i brązowe pnie podobne do świerka!"]
	quest.51E2728C5E35A152.quest_desc: ["Froststeel występuje w mroźnych biomach: Frostfields, Frosty Smogstem Forests i prawdopodobnie Icy Seas. \\n\\nWystępuje w Shiverstone, który w tych biomach zastępuje Depthrock. Shiverstone zachowuje się podobnie do lodu, czyli jest śliski i trochę Cię spowalnia. \\n\\nNiektóre Nuggets możesz też znaleźć w brzuchach Munchers!"]
	quest.51E2728C5E35A152.title: "&bFroststeel&r"
	quest.53FDC6C536E50A1A.quest_desc: ["&bGwiblings&r to przyjazne ryby żyjące w morzach. \\n\\nSą mniejsze niż &bGwibs&r i zachowują się jak ryby z &2&lVanilli&r!"]
	quest.53FDC6C536E50A1A.title: "&bGwibling&r"
	quest.57545837046F552B.quest_desc: [
		"Chwila, to nie jest zwykły garnek! \\n\\n&2Mysterious Pots&r to żywe stworzenia, które udają garnki. \\n\\nMają 4 serca, a po uderzeniu uciekają. Jeśli uznają, że są bezpieczne, wrócą do swojego przebrania. \\n\\nPo śmierci mogą upuścić &7Cloggrum&r, &bFroststeel Nuggets&r i &cUtheric Shards&r. "
		"{image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
	]
	quest.57545837046F552B.title: "&2Mysterious Pots"
	quest.5AF0E903DB670D65.quest_desc: ["Mając trochę Dreadrock, &3Rogdorium&r i &cUtheric Cluster&r, możemy zbudować Infuser! \\n\\nTo blok, za pomocą którego możemy wytwarzać i nasycać niektóre przedmioty. Na razie nie ma zbyt wielu receptur, ale założę się, że będzie ich więcej! \\n\\nGłównym zastosowaniem będzie wytwarzanie &cUtheric Crystals&r i nasycanie zbroi &3Rogdorium&r. \\n\\nJeśli zbroja zostanie nasycona &3Rogdorium&r, ochroni Cię przed chorobą &cRot&r. "]
	quest.5B4B5C148D63ACA1.quest_desc: [
		"&aForgotten Minions&r nie pojawiają się jak zwykłe moby, trzeba je stworzyć. Tworzy się je, ustawiając Carved Gloomgourd na &aBlock of Forgotten Ingots&r. \\n\\nZachowują się podobnie do śnieżnych golemów, nigdy Cię nie zaatakują, za to strzelają do wrogich mobów. \\n\\nMają 10 serc i nie upuszczają niczego po śmierci... ale w sumie po co miałbyś je zabijać?"
		"{image:atm:textures/questpics/undergarden/undergarden_minion.png width:125 height:100 align:center}"
	]
	quest.5B4B5C148D63ACA1.title: "&aForgotten Minions&r"
	quest.5D229FA3A5F92954.quest_desc: [
		"&4Munchers&r są podobne do innych wrogich mobów w &2&lUndergarden&r, ale to, co upuszczają, czyni je znacznie bardziej przydatnymi! \\n\\nMuncher może po śmierci upuścić &7Cloggrum&r i &bFroststeel Nuggets&r."
		"{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}"
	]
	quest.5D229FA3A5F92954.title: "&4Muncher&r"
	quest.5E63C78CDC44FF95.quest_desc: ["Rotten Blisterberries nie można rzucać, ale gdy zrobi się z nich Blisterbombs, już można! \\n\\nMożesz pójść jeszcze dalej i zrobić Boomgourds, które działają jak TNT rozrzucające Blisterberries na wszystkie strony."]
	quest.5E63C78CDC44FF95.title: "Materiały Wybuchowe!!!"
	quest.5FCA6F5FE97780B7.quest_desc: [
		"&eGronglets&r to technicznie bloki, a nie moby. Ale kocham je zbyt mocno, by ich tu nie umieścić! \\n\\nPojawiają się na Grongle Trees oraz wydają dźwięki i światło! Idealne do dekoracji."
		"{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}"
	]
	quest.5FCA6F5FE97780B7.title: "&eGronglets&r"
	quest.6124C0E9E419694B.quest_desc: ["Ulepsz narzędzia &7Cloggrum&r za pomocą &aForgotten Ingots&r i Smithing Template. \\n\\nTo najlepsze narzędzia, jakie możesz zdobyć, mają już Efficiency, ale tylko dla bloków z &2&lUndergarden&r. \\n\\nA miecz i siekiera zadają większe obrażenia wszystkim mobom z &2&lUndergarden&r poza &cRot Beast&r i &aForgotten Guardian&r!"]
	quest.6124C0E9E419694B.title: "Narzędzia &aForgotten&r"
	quest.647A87E800C703C3.quest_desc: [
		"Mój ulubiony biom, i to zdecydowanie! \\n\\nOgromna zielona dżungla z wielkimi drzewami Gronglegrowth. \\n\\nNa tych drzewach znajdziesz &eGronglets&r!"
		"{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}"
	]
	quest.647A87E800C703C3.title: "Gronglegrowth"
	quest.6751F2651063B3A5.quest_desc: ["Blood Mushrooms można znaleźć w ich bagnach. \\n\\nMają kształt ciemnych dębów i są w większości białe, tylko niektóre bloki mają plamy krwi!"]
	quest.67A2347534269528.quest_desc: [
		"&9Sploogies&r pojawiają się rzadko, ale gdy już się pojawią, ich przeznaczeniem jest Cię irytować. \\n\\nBędą w Ciebie pluć (i wydawać obrzydliwe odgłosy ssania), ale jeśli je uderzysz, uciekną; podobnie jak mały Piglin. \\n\\nPo śmierci upuszczają tylko Depthrock Pebbles."
		"{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}"
	]
	quest.67A2347534269528.title: "&9Sploogie&r"
	quest.6C4B93FE64BD418D.quest_desc: ["Dostanie się do &2&lUndergarden&r jest podobne do dostania się do &c&lThe Nether&r. Musisz wytworzyć portal. \\n\\nMa ten sam kształt i rozmiar co portale do Netheru, ale zamiast Obsidian potrzebujesz wariantu Stone Bricks. Mogą to być Stone Bricks, Mossy Stone Bricks lub Deepslate Bricks. \\n\\nGdy portal będzie gotowy, możesz go aktywować, używając na nim Catalyst. "]
	quest.6C4B93FE64BD418D.quest_subtitle: "Budowa Portalu"
	quest.6C4B93FE64BD418D.title: "The Undergarden"
	quest.6D4FB6291CA8D1A6.quest_desc: ["Drzewa Smogstem są znacznie grubsze w dolnej połowie, podobnie jak baobaby w prawdziwym życiu! \\n\\nMają niebieskie liście i szare pnie. \\nMożesz je znaleźć w wielu biomach: Smogstem Forests, Dense Forests, a nawet w Indigo Mushroom Bogs!"]
	quest.6E7C8537D8A28833.quest_desc: [
		"Poniżej poziomu Y 0 są dwa biomy, a Depths to jeden z nich. \\n\\nAby zejść poniżej poziomu Y 0, musisz wykopać Dreadrock. Do tego potrzebujesz Forgotten Pickaxe lub Allthemodium Pickaxe. \\n\\nPojawiają się tu Greater Dwellers, Denizens i potwory Rot."
		"{image:atm:textures/questpics/undergarden/undergarden_depths.png width:200 height:100 align:center}"
	]
	quest.6E7C8537D8A28833.title: "Depths"
	quest.6F416275B6F6D8F0.quest_desc: ["Blisterberries pojawiają się w Smog Spires. \\n\\nPonieważ rosną w tak obrzydliwym miejscu, niektóre są zgniłe. \\n\\nNie polecam ich jeść, może przydadzą się do czegoś innego!"]
	quest.6F483B77D64F4EE2.quest_desc: [
		"Poniżej poziomu Y 0 są dwa biomy, a Rogdorium Grove to jeden z nich. \\n\\nAby zejść poniżej poziomu Y 0, musisz wykopać Dreadrock. Do tego potrzebujesz Forgotten Pickaxe lub Allthemodium Pickaxe. \\n\\nZnacznie przyjemniejszy biom w porównaniu z Depths. O wiele mniej potworów i o wiele więcej roślin! Teraz z drzewami Smogstem i mnóstwem kwiatów."
		"{image:atm:textures/questpics/undergarden/undergarden_rogdorium.png width:200 height:100 align:center}"
	]
	quest.6F483B77D64F4EE2.title: "Rogdorium Grove"
	quest.70FD8856BFCD9AEE.quest_desc: [
		"Największy i najniebezpieczniejszy mob &cRot&r. \\n\\nMa 80 serc, co moim zdaniem kwalifikuje go jako bossa. \\n\\nJak wszystkie moby &cRot&r będzie atakować &2Stoneborns&r i &7Forgottens&r oraz upuszczać &cUtheric Shards&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
	]
	quest.70FD8856BFCD9AEE.title: "&cRotbeast&r"
	quest.71E1454990DEC451.quest_desc: [
		"&bGwibs&r to większe i bardziej wściekłe wersje &bGwiblings&r. \\n\\nNie upuszczają żadnych przedmiotów i nie da się ich złapać do wiader. Oferują tylko ból!"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&bGwib&r"
	quest.739601B0C43B239B.quest_desc: ["Tak, można z nich zrobić Black Dye!"]
	quest.744DBE831C120B2F.quest_desc: [
		"Czy ta skała się rusza? A nie, to nie skała, tylko &aMog&r! \\n\\n&aMogs&r można rozmnażać za pomocą Depthrock Pebbles, a po śmierci mogą upuścić więcej Pebbles albo Mogmoss! \\n\\nMogmoss przydaje się w wielu różnych recepturach!"
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&aMog&r"
	quest.75A66B81C1181F59.quest_desc: ["Forgotten Vestiges to maleńkie ruiny z cegieł Depthrock Bricks, spotykane w &2&lUndergarden&r. \\n\\nZnajdziesz tu mnóstwo garnków pełnych łupów! \\n\\nWystarczy je stłuc!"]
	quest.75A66B81C1181F59.title: "Forgotten Vestige"
	quest.7617737FC179EA1A.quest_desc: ["Zbroja &bFroststeel&r jest nieco słabsza od Diamond Armor, ale daje też dużą Knockback Resistance. \\n\\nNakłada jednak debuff do szybkości, więc chyba nigdzie nie pójdziemy!"]
	quest.7617737FC179EA1A.title: "Zbroja &bFroststeel&r"
	quest.76CDC18D7A208512.quest_desc: ["W &2&lUndergarden&r moby &cRot&r: &cRotling&f, &cRotwalker&f, &cRotbelcher&f i &cRotbeast&r mogą zarazić Cię &cUtherium&r. \\n\\nPojawi się to jako czerwone paski nad paskiem głodu, jeśli się zarazisz. Po 4 pełnych paskach na ekranie pojawią się czerwone linie. Przy 8 paskach paski zaczną drżeć, ostrzegając, że jest coraz gorzej. Przy 10 paskach wszystkie zaczną świecić i wtedy zaczniesz otrzymywać obrażenia. \\n\\n&cRot&r powoli zniknie sam, chyba że jest pełny. Możesz też zdobyć Purity z Mysterious Totems albo zjeść &3Rogdorium&r, aby się go pozbyć. \\n\\nOba pochodzą z Depths, które pojawiają się poniżej poziomu Y 0. Aby się tam dostać, potrzebujesz &aForgotten Pickaxe&r lub innego kilofa tego samego poziomu, jak &6Allthemodium&r. \\n\\nJedynym sposobem, by zapobiec &cRot&r, jest nasycenie zbroi &3Rogdorium&r za pomocą bloku Infuser."]
	quest.76CDC18D7A208512.title: "Ostrzeżenie"
	quest.79C652E3FCB88550.quest_desc: [
		"&5Gloompers&r są technicznie pasywne, ale mają przeciwko Tobie mechanizm obronny, więc uważam je za neutralne! \\n\\nGdy je uderzysz, zostawią efekt podobny do Lingering Potion. \\n\\nPo śmierci upuszczają nogi (które są bardzo smaczne) i możliwe, że Leather. \\n\\nMożna je też rozmnażać za pomocą Gloomgourds!"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5Gloomper&r"
	quest.7E3DA4168D352B42.quest_desc: [
		"Obiecuję, że to ostatnie Mushroom Bog! \\nTe grzyby wyglądają całkiem normalnie, ale ich sztuczka polega na tym, co z nich pochodzi! \\n\\nVeils! Zdecydowanie przydatny blok dekoracyjny."
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "Veil Mushroom Bog"
	task.39194D9CDF673768.title: "AllRightsReserved"
	task.4AA225E5056787B8.title: "AllRightsReserved"
}
