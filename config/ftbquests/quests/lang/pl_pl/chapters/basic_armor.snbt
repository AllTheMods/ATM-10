	quest.10AA2B20D86747F7.quest_desc: ["&bFerricore&r ma te same statystyki co żelazo, ale ma też inne zdolności, o jakich żelazo może tylko pomarzyć! \\n\\nSprawdź opisy przedmiotów, aby dowiedzieć się, co potrafią!"]
	quest.10AA2B20D86747F7.quest_subtitle: "15"
	quest.10AA2B20D86747F7.title: "&bFerricore Amor"
	quest.1245126B4338C019.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_vex.png width:100 height:150 align:center}"]
	quest.1245126B4338C019.quest_subtitle: "Woodland Mansion"
	quest.1245126B4338C019.title: "Vex Armor Trim"
	quest.13517D17E6BF015F.quest_desc: ["Mając &bDiamond Armor&r i kilka &aInferium Items&r, możemy wytworzyć &aInferium Armor&r! \\n\\nMożna ją też ulepszać za pomocą Tinkeringu!"]
	quest.13517D17E6BF015F.quest_subtitle: "21"
	quest.13517D17E6BF015F.title: "&aInferium Armor"
	quest.1366B946928C873B.quest_desc: ["Zajrzyj na stronę zadań &6&lBumblezone&r, aby dowiedzieć się więcej!"]
	quest.1366B946928C873B.quest_subtitle: "10"
	quest.1366B946928C873B.title: "Bee Armor 1"
	quest.140DF670162C68DA.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_steeleaf.png width:100 height:150 align:center}"]
	quest.140DF670162C68DA.title: "&aSteeleaf"
	quest.1452D9CF827782B5.quest_desc: ["Arctic Gear jest wytwarzany z Arctic Fur. Arctic Fur wypada z Winter Wolves i Yeti! \\n\\nNie, żadnego z nich nie da się ostrzyc. \\n\\nTen ekwipunek można farbować tak jak &7Leather Armor&r!"]
	quest.1452D9CF827782B5.quest_subtitle: "16"
	quest.1452D9CF827782B5.title: "&fArctic Gear"
	quest.15978093237448FE.quest_desc: ["Po co ulepszać &cNetherite&r do &6Allthemodium&r albo czegokolwiek innego, skoro można ją ulepszyć do &3Warden Armor&r! \\n\\nBędziesz jednak potrzebować kilku dropów z Wardena, żeby ją wytworzyć!"]
	quest.15978093237448FE.quest_subtitle: "24"
	quest.15978093237448FE.title: "&3Warden Armor"
	quest.16359196D49A6223.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_froststeel.png width:100 height:150 align:center}"]
	quest.16359196D49A6223.title: "&bFroststeel&r"
	quest.17A68C4E9E9EA2B7.quest_desc: ["&eGolden Armor&r plasuje się pomiędzy Iron a &7Leather&r. Jej wytrzymałość jest jednak znacznie bliższa &7Leather&r. \\n\\nPoza tym, że Piglini są wobec Ciebie neutralni, gdy nosisz jakąś część &eGold Armor&r, nie ma z niej wielkiego pożytku."]
	quest.17A68C4E9E9EA2B7.quest_subtitle: "11"
	quest.17A68C4E9E9EA2B7.title: "&eZłota Zbroja"
	quest.19F58E291A543228.quest_desc: ["&eZłota&r wersja zbroi z &d&lArs&r!"]
	quest.19F58E291A543228.quest_subtitle: "11"
	quest.19F58E291A543228.title: "&5Sorceror's Outfit"
	quest.1A8440C0048EEB02.quest_desc: ["&cBlazegold&r has same stats as Iron but has other abilities Iron wishes it had! \\n\\nCheck out the Item descriptions to learn more of what they can do!"]
	quest.1A8440C0048EEB02.quest_subtitle: "15"
	quest.1A8440C0048EEB02.title: "&cBlazegold Armor"
	quest.1C27C74722A19FC1.quest_desc: ["Za pomocą mnóstwa piekielnie drogich przedmiotów z &l&5Mekanism&r możesz ulepszyć &5Unobtainium Armor&r do &aMekaSuit&r! \\n\\nTeraz może ona magazynować energię, a zamiast odejmować serca przy obrażeniach, będzie zużywać energię. \\n\\nMożesz użyć Upgrade Units, aby uczynić ją jeszcze lepszą!"]
	quest.1C27C74722A19FC1.quest_subtitle: "Tyle energii, ile zdołasz dostarczyć"
	quest.1C27C74722A19FC1.title: "&aMekaSuit"
