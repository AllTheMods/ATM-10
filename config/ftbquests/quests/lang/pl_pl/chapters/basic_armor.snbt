	quest.2FA0F5B348322095.quest_desc: ["&7Cloggrum&r to Iron Ore w &2&lUndergarden&r. Występuje wszędzie."]
	quest.2FA0F5B348322095.quest_subtitle: "14"
	quest.2FA0F5B348322095.title: "&7Cloggrum Armor"
	quest.3061B67330367CE2.quest_desc: ["Jeśli jakimś cudem pokonałeś Hydrę lub Ur-Ghasta, będziesz mieć dostęp do &4Fiery Tears/Blood&r - działa jedno i drugie! \\n\\nTeraz możesz wytworzyć &4Fiery Armor&r, ulepszając swoją żelazną zbroję dowolną z &4Fiery Vials&r. \\n\\nTwoja zbroja będzie wtedy mocniejsza od &cNetherite&r, a każdy pechowiec, który Cię uderzy, stanie w płomieniach!"]
	quest.3061B67330367CE2.quest_subtitle: "24"
	quest.3061B67330367CE2.title: "&4Fiery Armor"
	quest.30A61E1A1EFA81E6.quest_desc: ["&2Steeleaf&r to w zasadzie sztabka, którą można znaleźć w skrzyniach w &9&lThe Twilight Forest&r. \\nKażda część zbroi daje inne zaklęcie!"]
	quest.30A61E1A1EFA81E6.quest_subtitle: "20"
	quest.30A61E1A1EFA81E6.title: "&2Steeleaf Armor"
	quest.3215A3D706CECCEF.quest_desc: ["Łącząc Liveroot, Iron Ingot i &eGold Nugget&r, możesz wytworzyć &7Ironwood&r! \\n\\nBrzmi tak, jakbyś potrzebował siekiery i kilofa, żeby je zdobyć. \\n\\nKażda część &7Ironwood Armor&r daje za darmo poziom Protection!"]
	quest.3215A3D706CECCEF.quest_subtitle: "16"
	quest.3215A3D706CECCEF.title: "&7Ironwood Armor"
	quest.3260EDAD3A619479.quest_desc: ["&5Aethersent Ore&r można znaleźć podczas deszczów meteorytów w &5&lEternal Starlight&r. Małe rozbijają się przy uderzeniu, więc musisz poczekać na duże meteory! \\n\\nA może meteoryty? Jaka jest różnica?"]
	quest.3260EDAD3A619479.quest_subtitle: "14"
	quest.3260EDAD3A619479.title: "&5Aethersent Armor"
	quest.333682022948E2F3.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_thioquartz.png width:100 height:150 align:center}"]
	quest.333682022948E2F3.title: "&2Thioquartz&r"
	quest.338BD467EBE6EE1F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_sentry.png width:100 height:150 align:center}"]
	quest.338BD467EBE6EE1F.quest_subtitle: "Pillager Outpost"
	quest.338BD467EBE6EE1F.title: "Sentry Armor Trim"
	quest.3403D7502F7BC897.quest_desc: ["Dosłownie niezwyciężona - nic nie może Cię trafić i zadać Ci obrażeń. (Poza Laserem Chaos Guardiana.) \\n\\nObecnie musisz ulepszyć &cNetherite Armor&r za pomocą &eQuantum &bUpgrade&r, ale Twoi znajomi z &6&lATM Team&r pracują nad tym, żeby ta receptura była trudniejsza! \\n\\nI nic nie możesz zrobić, żeby ich powstrzymać! &lBWAHAHAHAHA"]
	quest.3403D7502F7BC897.quest_subtitle: "Niezwyciężona"
	quest.3403D7502F7BC897.title: "&eQuantum &bArmor&r (&l&7MI&r)"
	quest.3416DB9F58D8AA2C.quest_desc: ["&3Neptunium&r to nagroda z Neptune's Bounty, które zdobywa się podczas łowienia ryb! \\nDaje też bonusy do przebywania pod wodą."]
	quest.3416DB9F58D8AA2C.quest_subtitle: "28"
	quest.3416DB9F58D8AA2C.title: "&3Neptunium Armor"
	quest.34D14B807A2DAC0F.quest_desc: ["Myślisz, że &5&lMekanism&r i &l&7Modern Industrialization&r mogą się bawić same? \\n\\nTa &5Quantum Armor&r ma domyślne statystyki podobne do &cNetherite Armor&r, ale tak jak &aMekaSuit&r może używać energii jako tarczy, która pochłania 30% obrażeń. \\n\\nMa też ulepszenia, które można zainstalować, aby uczynić Cię jeszcze potężniejszym! Na przykład latanie, Night Vision, a nawet możliwość ładowania. \\n\\nAle najlepsze jest to, że można ją połączyć z Twoim systemem magazynowania! Wtedy możesz automatycznie pobierać z niego energię i wyjmować z niego dowolny przedmiot, gdziekolwiek jesteś. "]
	quest.34D14B807A2DAC0F.quest_subtitle: "Tyle energii, ile zdołasz dostarczyć"
	quest.34D14B807A2DAC0F.title: "&5Quantum Armor&r (&l&bAE2&r)"
