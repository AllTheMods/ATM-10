{
	quest.004D61425172324F.quest_desc: ["&8Chainmail Armor&r jest trochę gorsza od żelaznej. W &l&2Minecraft&r była ceniona głównie za to, że trudno ją zdobyć - można ją było dostać tylko z handlu i z dropów z mobów. \\n\\nOczywiście tutaj mamy mody, więc możemy ją po prostu wytworzyć! Co odbiera jej cały sens..."]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8Kolcza Zbroja"
	quest.041ED280691BB05D.quest_desc: ["&9Froststeel&r to pospolita ruda występująca w zimnych biomach &2&lUndergarden&r. "]
	quest.041ED280691BB05D.quest_subtitle: "18"
	quest.041ED280691BB05D.title: "&9Froststeel Armor"
	quest.04B31A600004F7CB.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.055CCAE237DF3EEF.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ironwood.png width:100 height:150 align:center}"]
	quest.055CCAE237DF3EEF.title: "&8Ironwood"
	quest.05B5E640F1B68A28.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_golem.png width:100 height:150 align:center}"]
	quest.05B5E640F1B68A28.title: "&3Golem Steel&r"
	quest.074EC1E636CD6605.quest_desc: ["&cNetherite Armor&r to najlepsza zbroja, jaką oferuje &l&2Vanilla&r. Ma tyle samo punktów pancerza co &bDiamond&r, ale większą wytrzymałość pancerza. \\n\\nPewnie dlatego, że do jej wytworzenia potrzebny jest &bDiamond&r!"]
	quest.074EC1E636CD6605.quest_subtitle: "20"
	quest.074EC1E636CD6605.title: "&cZbroja z Netherytu"
