	quest.260C7F3C1F51221D.title: "&aArchevoker Outfit"
	quest.28408BFAA54E4FC6.quest_desc: ["&7Leather Armor&r to najgorszy zestaw zbroi, jaki możesz zdobyć. \\n\\nGłównie dlatego, że &c&lMojang&r zakładał, że zdobędziesz ją przed wszystkimi innymi. \\n\\nJa prawie nigdy jej nie mam, bo ciężko mi znaleźć tyle &8K&fr&8ó&fw&r, przepraszam, &c&lMojang&r!"]
	quest.28408BFAA54E4FC6.quest_subtitle: "7"
	quest.28408BFAA54E4FC6.title: "&7Leather Armor"
	quest.2A4FE9644F3B9DC1.quest_desc: ["Ulepszona wersja &2Prudentium&r."]
