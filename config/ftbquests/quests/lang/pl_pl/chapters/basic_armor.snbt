	quest.7C1D407CF67786F6.quest_subtitle: "15"
	quest.7C1D407CF67786F6.title: "&fAethermancer Outfit"
	quest.7F11ABFB2E21B7E4.quest_desc: ["Zbroja jest bardzo ważną częścią &l&2Minecraft&r - to ona chroni Cię przed obrażeniami. \\n\\nRóżne części zbroi dają różną liczbę Armor Points. To one określają skuteczność Twojej zbroi - im więcej, tym lepiej!\\n\\nWiększość zbroi można zmienić na bardziej ozdobną za pomocą wykończeń zbroi - użyj części zbroi z wykończeniem zbroi oraz przedmiotu do barwienia, aby zmienić jej wygląd!"]
	quest.7F11ABFB2E21B7E4.title: "&l&bPodstawy Zbroi&r"
	quest.7F8B6D5F360D985A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_fiery.png width:100 height:150 align:center}"]
	quest.7F8B6D5F360D985A.title: "&eFiery"
	quest.7FABB77A60E7962C.quest_desc: ["Nasycając Obsidian za pomocą &bDiamonds&r, możemy zdobyć Refined Obsidian Dust! \\n\\nNastępnie możemy sprężyć w niego &7Osmium&r, aby uzyskać je w postaci sztabki. \\n\\nPotem możemy zamienić te sztabki w zbroję o lepszych statystykach nawet od &6Allthemodium Armor&r!"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5Refined Obsidian Armor"
