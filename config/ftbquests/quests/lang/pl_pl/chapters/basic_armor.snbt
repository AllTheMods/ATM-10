	quest.7B500E0577BDFF8F.quest_desc: ["&6Bronze&r to połączenie &6Copper&r i Tin. \\n\\nIstnieje kilkanaście różnych sposobów na wytworzenie tego stopu, a ja nie powiem Ci, który jest właściwy."]
