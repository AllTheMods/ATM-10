{
	quest.00C26068B55F4FD9.quest_desc: ["Runes of Silence robią ze spawnerem tylko jedno - uciszają go. Nie podoba Ci się to głupie hałasowanie spawnera? Użyj więc Rune of Silence!"]
	quest.00C26068B55F4FD9.title: "Ciszej, Bo Obudzisz Moby!"
	quest.0E02CE4469FCA4C9.quest_desc: ["Redstone Activation daje Twojemu spawnerowi przełącznik włącz/wyłącz. Bez zasilania redstonem nie będzie spawnować."]
	quest.0E02CE4469FCA4C9.title: "Aktywowany Redstonem"
	quest.0E90577AC72749C4.quest_desc: ["&6Thundering Spawner Upgrade Rune&r, czwarty i ostatni poziom Spawner Upgrade Runes, wydobywa z Twojego spawnera pełen potencjał.\\n\\nUstawia zarówno minimalne, jak i maksymalne opóźnienie spawnu na 20, liczbę spawnów na 16, maksymalną liczbę bytów na 32, a zasięg aktywacji na 48.\\n\\nEndersurge Gems można zdobyć w The End."]
	quest.0F0E227FC3EC0D90.quest_desc: ["To spawnery dodawane przez mody inne niż Apothic Spawners."]
	quest.0F89BFD4A3F63A48.quest_desc: ["Niektóre moby (głównie potwory) potrzebują określonego poziomu światła, aby się pojawić. Wrogie wymagają niższego, a pasywne wyższego. Użycie Rune of Perpetual Twilight sprawia, że nie musisz się przejmować poziomem światła, bo jest on ignorowany! Nie ignoruje to innych wymagań spawnu, na przykład tego, że zwierzęta hodowlane potrzebują trawy."]
	quest.0F89BFD4A3F63A48.title: "Ignorowanie Światła"
	quest.1102B27CBF564127.quest_desc: ["Spawner Agitators różni się od pozostałych wymienionych przedmiotów modyfikujących - ten pochodzi z PneumaticCraft, a nie z Apothic Spawners. Gdy w paczce nie ma moda Apothic Spawners, Agitator na spawnerze sprawia, że spawnuje on moby bez względu na to, gdzie jest gracz. Z Apothic Spawners, które oczywiście mamy, tego nie zmienia, ale za to zapobiega znikaniu zespawnowanych mobów, gdy oddalisz się od chunków."]
	quest.1102B27CBF564127.quest_subtitle: "Nie znikaj mi tu, mobie"
	quest.167E1474644C9908.quest_desc: ["Kwarc robi odwrotność tego, co robi drugi przedmiot. Gdy trzymasz Kwarc w drugiej ręce, a inny przedmiot modyfikujący spawner w głównej, zadziała on odwrotnie do swojej roli. Z Kwarcem i Runes of Spawning Range zasięg spawnu zamiast rosnąć będzie maleć. Z Kwarcem i Runes of Debilitation zwiększy się początkowe zdrowie."]
	quest.167E1474644C9908.title: "Dzień Odwrotności"
	quest.17410BE15A81DD96.quest_desc: ["&9Wayfarer's Spawner Upgrade Rune&r to drugi poziom Spawner Upgrade Runes.\\n\\nUstawia minimalne opóźnienie spawnu na 100, maksymalne na 400, liczbę spawnów na 10, maksymalną liczbę bytów na 18, a zasięg aktywacji na 32.\\n\\nDo wytworzenia tej runy nadaje się dowolny Spawn Egg."]
	quest.17C87EB8ED8A27AB.quest_desc: ["Spawner Runes to podstawowy materiał do modyfikowania spawnerów."]
	quest.17C87EB8ED8A27AB.quest_subtitle: "Podstawowe modyfikacje"
	quest.186593EBCE3FE8D8.quest_desc: ["Zasięg spawnu to obszar, na którym mogą pojawiać się moby. Im większy obszar, tym więcej miejsca na ich pojawianie się. Im mniejszy obszar, tym tańsza farma."]
	quest.186593EBCE3FE8D8.title: "Zasięg Spawnu"
	quest.18E0F5A78F696FA3.quest_desc: ["Runes of Echoes nadają spawnerowi specjalny efekt. Wszystkie zespawnowane moby będą miały pomnożony łup, który upuszczają."]
	quest.18E0F5A78F696FA3.title: "Echo"
	quest.21C2458FED19363C.quest_desc: ["Używa &aEssence&r wraz z mobem w Mob Imprisonment Tool, aby zespawnować kopię tego moba."]
	quest.21C2458FED19363C.quest_subtitle: "Spawner z Industrial Foregoing"
	quest.223A5BDB5056B781.quest_desc: ["Capturing to zaklęcie na miecze, dzięki któremu moby rzadko upuszczają swoje Eggs. Jest rzadkie, więc szukaj go dalej i zajrzyj do &5&lApothic Enchanting&r, aby sobie pomóc. Każdy poziom daje 0,5% szansy na Egg przy każdym zabójstwie, a najwyższy poziom, jaki normalnie można zdobyć, to VII (7)."]
	quest.263860CADB3D76C6.quest_desc: ["Powered Spawner to Mob Spawner wytwarzany z EnderIO. Najpierw będziesz potrzebować wypełnionej Soul Vial i Broken Spawner. (Technicznie do zmiany spawnera potrzebujesz tylko Soul Vial, ale to bez znaczenia). Gdy będziesz mieć Broken Spawner, który Ci odpowiada, wytwórz z niego Powered Spawner! Następnie postaw go, daj mu Capacitor i zasil go. Bum! Teraz spawnujesz moby za pomocą EnderIO.\\n\\nMożesz też sprawić, że ten spawner będzie napełniał Soul Vials bezpośrednio, bez potrzeby użycia bloku Clicker."]
	quest.263860CADB3D76C6.quest_subtitle: "Spawner z EnderIO"
	quest.2D8A7065F8CDDDDD.quest_desc: ["Swabs to mój ulubiony sposób zdobywania Spawn Eggs. Będziesz do tego potrzebować Mob Grinding Utils. Po prostu kliknij moba prawym przyciskiem myszy za pomocą Swab, a następnie wytwórz z niego Chicken Feed, nasion i wiadra dowolnego &aXP Fluid&r. Nie obchodzi mnie, którego rodzaju &aXP Fluid&r użyjesz. Gdy to masz, nakarm tym kurczaka. Niestety kurczak nie przeżyje zabiegu, ale hej, Spawn Eggs!\\n\\nNie wszystkim mobom da radę pobrać wymaz Swabem."]
	quest.2FE4B7B70D90A455.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę ze społeczności&r na potrzeby paczek AllTheMods.\\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6Ekipę AllTheMods&r bez wyraźnej zgody.\\n\\nTo zadanie jest celowo ukryte; jeśli to widzisz, jesteś w trybie edycji."]
	quest.30EB438C66324213.quest_desc: ["Rune of Solitude robi część tego, co Spawner Upgrade Runes, ale znacznie lepiej. Gracze nie muszą już być w pobliżu spawnera. Dopóki jego chunk jest załadowany, będzie spawnować."]
	quest.30EB438C66324213.title: "Ignorowanie Graczy"
	quest.310969B8FE0A94DE.quest_desc: ["Kolejną zmianą w grze, jaką wprowadza Apotheosis, są spawnery. Pamiętasz, jak można było wykopywać spawnery z Silk Touch? Wróciło dzięki Apotheosis! Jest też wiele nowych modyfikacji, które możesz dodać do spawnerów, klikając je prawym przyciskiem myszy którymś z tych przedmiotów."]
	quest.310969B8FE0A94DE.title: "Apothic Spawners"
	quest.321C15EBBE2D3D30.quest_desc: ["Gdy wysadzisz spawner, stanie się bardzo niestabilny: zespawnuje dużą liczbę swoich mobów i zostawi po sobie Spawner Chains.\\n\\nIle łańcuchów, możesz się zastanawiać? W chwili pisania - 48-57.\\n\\nBędziesz potrzebować tych łańcuchów do..."]
	quest.321C15EBBE2D3D30.title: "Wysadzanie Spawnerów"
	quest.39E822440E7D2E04.quest_desc: ["Mob Grinding Utils w całości dotyczy farm mobów, więc oczywiście ma spawner! Entity Spawner! Do działania potrzebuje 3 rzeczy: Spawn Egg, XP Jelly Babies i sygnału Redstone. XP Jelly Babies powstają przez przetworzenie XP w XP Solidifier z XP Mould Jelly Baby. Można je zjeść lub użyć jako paliwa w drugim slocie. Gdy Spawn Egg będzie w górnym slocie, XP Jelly Babies w drugim, a do spawnera dotrze sygnał Redstone, zacznie spawnować moby!"]
	quest.39E822440E7D2E04.quest_subtitle: "Spawner z Mob Grinding Utils"
	quest.3F1430ADB648102F.quest_desc: [
		"Ta Spawner Rune działa inaczej niż pozostałe. Zamiast wpływać na jedną statystykę spawnera, wpływa na kilka naraz. Ustawia też te statystyki na konkretną wartość, zamiast za każdym razem je zwiększać lub zmniejszać.\\n\\n&aFrontiersman's Spawner Upgrade Rune&r to pierwsza z Spawner Upgrade Runes, najtańsza i, rzecz jasna, najsłabsza.\\n\\nUstawia minimalne opóźnienie spawnu na 150, maksymalne na 600, liczbę spawnów na 7, maksymalną liczbę bytów na 12, a zasięg aktywacji na 24."
		"{@pagebreak}"
		"Aby określić, kiedy spawner zespawnuje moby, wybiera on losową liczbę między maksymalnym a minimalnym opóźnieniem spawnu. Szybkość podawana jest w tickach, gdzie 20 ticków to 1 sekunda.\\n\\nZespawnowane moby są losowe, a ich maksymalną liczbę określa liczba spawnów.\\n\\nMax Entities to liczba mobów, które spawner może zespawnować i utrzymać. Jeśli wynosi tylko 6, a 6 mobów już się pojawiło, kolejne nie pojawią się, dopóki tamte nie zginą lub nie zostaną przeniesione.\\n\\nZasięg aktywacji to odległość, w jakiej gracz (Ty) musi być od spawnera, aby ten działał."
	]
	quest.3F55F3CC8519D783.quest_desc: ["Soulium Spawner to spawner, którym obdarowało nas Mystical Agriculture. Do spawnowania mobów używa Mob Essence i energii. Mob Essence zdobywa się ze zbierania Mob Plants, wytwarzanych przez Soul Jars. Musisz więc najpierw zabić moby albo użyć Soul Extractor."]
	quest.3F55F3CC8519D783.quest_subtitle: "Spawner z Mystical Agriculture"
	quest.40096ED0B04C3EC5.quest_desc: ["Obowiązkowa rzecz dla wszystkich spawnerów. Gdy mowa, że ignoruje wszystkie warunki, chodzi o większość. Ignoruje poziom światła, bloki wymagane do spawnu i biomy. Nadal wymagane są jednak warunki przestrzenne, na przykład slimy potrzebują obszaru 3x3, a gracze muszą być w pobliżu."]
	quest.40096ED0B04C3EC5.title: "Ignorowanie Wszystkich Warunków"
	quest.42D7C8CD8E6F5CD7.quest_desc: ["Używając Rune of Stupor na spawnerze, wysysasz dusze z mobów, które się zespawnują, zostawiając tylko pustą skorupę tego, czym były. Moby tracą całą SI, więc robią w zasadzie to, co stojak na zbroję. Nie mogą Cię uderzyć, nie mogą się teleportować, nie mogą poruszać się samodzielnie. Stoją tam gotowe do zabicia, jakie to ekscytujące!"]
	quest.42D7C8CD8E6F5CD7.title: "Brak SI"
	quest.4F7F8F4ED1CA0550.quest_desc: ["Rune of Immolation użyta na spawnerze sprawi, że moby będą pojawiać się w ogniu. Idealne na pyszny Steak."]
	quest.4F7F8F4ED1CA0550.title: "Płonące"
	quest.503AC506720FC59E.quest_desc: ["Do bardziej zaawansowanych modyfikacji spawnerów będziesz musiał &d&lInfuse&r swoje Spawner Runes.\\n\\n\\Potrzebujemy co najmniej &a70 Eterna&r, &c30% Quanta&r i &550% Arcana&r w &5Enchanting Table&r. \\n\\nAby to osiągnąć, możemy użyć jednego z poniższych zestawów:\\n\\n14 &9Deepshelves&r, które nie są &9Dormant&r!\\n13 &4Glowing Hellshelves&r i 2 &9Deepshelves&r!\\n12 &bCrystalline Seashelves&r i 2 &9Deepshelves&r!\\n\\nZajrzyj do rozdziału &5&lApothic Enchanting&r, aby dowiedzieć się więcej o tych mechanikach."]
	quest.503AC506720FC59E.quest_subtitle: "Zaawansowane modyfikacje"
	quest.52FAF122466FDDC9.quest_desc: ["Stabilized Spawner to wersja spawnera z Draconic Evolution. Gdy użyjesz jednego z Cores na spawnerze, stanie się on Stabilized Spawner. Możesz zamieniać Cores, ale nie będziesz mógł zmieniać statystyk, bo teraz ustalają je Cores. Im lepszy Core, tym więcej mobów się pojawia i tym szybciej."]
	quest.52FAF122466FDDC9.quest_subtitle: "Spawner z Draconic Evolution"
	quest.6D3B958E49AE7BDB.quest_desc: ["Charm Fragments można przerobić na Charms albo na Spawn Eggs. Pochodzą z Reliquary i rzadko wypadają z odpowiednich mobów. Niektóre można nawet wytworzyć! Weź 2 i zwykły Egg, a wytworzysz Spawn Egg."]
	quest.6D68D9941049E806.quest_desc: ["Ten spawner, jak sama nazwa wskazuje, używa &dSource&r jako paliwa. Aby wybrać moba do spawnu, będziesz potrzebować Containment Jar z mobem znajdującym się w okolicy."]
	quest.6D68D9941049E806.quest_subtitle: "Spawner z Ars Nouveau"
	quest.6F71FD826C29C31A.quest_desc: ["Ten może być nowością dla osób wracających z wcześniejszych wersji. Użycie Rune of Youth na spawnerze sprawi, że będzie spawnował tylko młode wersje znajdujących się w nim mobów. Działa to tylko z młodymi wersjami mobów z vanilli, nie z modowanych."]
	quest.6F71FD826C29C31A.title: "Odmładzający"
	quest.72AE56D34834D28E.quest_desc: ["Kolejny z PneumaticCraft? A, to jest właściwy spawner, rozumiem. Tak jak Draconic Stabilized Spawner, najpierw potrzebujesz zwykłego spawnera. Gdy go masz, postaw Spawner Extrator nad spawnerem i daj mu poniżej -0,5 bara, aby zaczął działać. Gdy skończy, da Ci Spawner Core wypełniony mobem, który był w środku, a Tobie zostanie Empty Spawner. Następnie użyj Empty Spawner do wytworzenia Pressurized Spawner i włóż do niego Spawner Core. (Aby ulepszyć Core, użyj Vacuum Trap do wciągnięcia mobów, które trafią do Spawner Core). Gdy to zrobisz, spawner będzie wymagał ciśnienia do działania, ignoruje poziom światła i jest aktywowany redstonem."]
	quest.72AE56D34834D28E.quest_subtitle: "Spawner z PneumaticCraft"
	quest.76A3A2A97AB66C43.quest_desc: ["Chcesz stworzyć Spawn Egg z Vengeance Spirit uwięzionego w &9Box of Eternal Closure&r?\\n\\n&9Spirit Reanimator&r robi dokładnie to. Daj mu dużo &cBlood&r i Egg, a także oczywiście &9Box of Eternal Closure&r z duchem, z którego chcesz stworzyć Spawn Egg, a spróbuje go stworzyć!\\n\\nUwaga: Niektórych mobów nie można użyć do tworzenia Spawn Eggs."]
	quest.77A8E8122870BBCE.quest_desc: ["Technicznie to nie jest Spawn Egg, ale i tak go tu umieszczam ze względu na zdolność wiązania mobów ze spawnerami. Zajrzyj do rozdziału &5&lApothic Enchanting&r, aby dowiedzieć się więcej o tym, jak zdobyć ten Lead."]
	quest.77A8E8122870BBCE.quest_subtitle: "To nie jest Spawn Egg!"
	quest.78E94C386B1E7359.quest_desc: ["Zwykle nie da się zdobyć Spawn Eggs, ale ze spawnerami jest tak samo, a jednak tu jesteśmy! Jest kilka sposobów zdobycia Spawn Eggs, a gdy już jeden masz, kliknij nim prawym przyciskiem myszy na spawner, aby zmienić moby, które spawnuje."]
	quest.7AC6A958936636D9.quest_desc: ["&5Mountaineer's Spawner Upgrade Rune&r to trzeci poziom Spawner Upgrade Runes. Tak, będziesz musiał w tym celu zawalczyć z mobem Warden.\\n\\nUstawia minimalne opóźnienie spawnu na 50, maksymalne na 200, liczbę spawnów na 13, maksymalną liczbę bytów na 24, a zasięg aktywacji na 40."]
	quest.7F6B66566C211735.quest_desc: ["Runes of Debilitation użyte na spawnerze zmniejszą maksymalne zdrowie zespawnowanego moba. Może to obniżyć jego zdrowie nawet do 20%."]
	quest.7F6B66566C211735.title: "Zdrowie"
	task.24893D6EDE0BD819.title: "Mob Charm Fragments"
	task.3B219688DA1CF9C8.title: "AllRightsReserved"
	task.45250DA4433007C6.title: "Capturing Enchant"
	task.524CBF7058496E7F.title: "Inne Spawnery"
	task.55587BA32D30318C.title: "Spawn Eggs"
	task.73B56F2139A98F77.title: "AllRightsReserved"
}
