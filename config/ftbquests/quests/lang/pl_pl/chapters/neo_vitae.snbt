{
	quest.02B5E57E9E803F78.quest_desc: [
		"Zbroja sentient działa tak samo jak narzędzia: załóż ją, a będzie uczyć się z tego, na co się narażasz."
		""
		"Opcjonalna linia wyposażenia, ale świetnie pasuje do broni sentient."
	]
	quest.02B5E57E9E803F78.quest_subtitle: "Zbroja z własnym zdaniem"
	quest.02B5E57E9E803F78.title: "Sentient Shell"
	quest.02DF776F9A4C9CB1.quest_desc: [
		"&6Daemonium Pestis&r grasuje w głębszych korytarzach. Nosiciel zarazy, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.02DF776F9A4C9CB1.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.02DF776F9A4C9CB1.title: "Daemonium Pestis"
	quest.07C69759A6163F2D.quest_desc: [
		"Wokół &6Master Ritual Stone&r ustawiasz elementalne kamienie rytualne: powietrza, ziemi, ognia i deus. O tym, co robi rytuał, decyduje układ, który ułożysz."
		""
		"Wytwórz Master Ritual Stone oraz po kilka kamieni każdego żywiołu."
	]
	quest.07C69759A6163F2D.quest_subtitle: "Układ tworzy rytuał"
	quest.07C69759A6163F2D.title: "Kamienie i Mistrz"
	quest.09DEA44456CD5010.quest_desc: [
		"Rytuał Tier II &6Breaching the Edge of Demon Realm&r rozcina zasłonę i zostawia po sobie &lInversion Pillar&r. Dotknij go, a przejdziesz na drugą stronę."
		""
		"To Twoje wejście do &6Antechamber&r, kieszonkowego samouczka w Demon Realm."
	]
	quest.09DEA44456CD5010.quest_subtitle: "Cięcie robi Tier II"
	quest.09DEA44456CD5010.title: "Przebicie Zasłony"
	quest.0ACA535425EA6A81.quest_desc: [
		"Każdy rytuał potrzebuje &6Activation Crystal&r, by się zapalić: Weak do rytuałów niskich poziomów, Awakened i Divinus do tych największych, budowanych z kamieni Deus."
		""
		"Weak Activation Crystal jest tani i dostępny wcześnie. Mocniejsze wymagają pracy w wymiarze. Opcjonalne."
	]
	quest.0ACA535425EA6A81.quest_subtitle: "Klucze do rytuałów, w skrócie"
	quest.0ACA535425EA6A81.title: "Kryształy Aktywacji"
	quest.0BA0AA8A6F07D383.quest_desc: [
		"Potrzebujesz &6Arcane Scribe Tool&r z Tabula Vitae albo z ołtarza. To właśnie nim rysuje się kręgi, z których składają się alchemy arrays."
		""
		"Uderz nim w ziemię i patrz, jak linie się rozświetlają."
	]
	quest.0BA0AA8A6F07D383.quest_subtitle: "Kreda mocy"
	quest.0BA0AA8A6F07D383.title: "Narzędzie Skryby"
	quest.0E3971A4FB822ED0.quest_desc: [
		"Ołtarz osiągnięty, orby związane, aura brzęczy, wymiar podbity. Masz już każde narzędzie, jakie oferuje Vitaemancy."
		""
		"Rozdział kończy się tutaj, ale mod nie. Sieć, rytuały i loch wciąż będą się opłacać."
	]
	quest.0E3971A4FB822ED0.quest_subtitle: "Szczyt to styl życia"
	quest.0E3971A4FB822ED0.title: "Mistrz Vitaemancji"
	quest.11721D2D8F03C20F.quest_desc: [
		"&6Petty Spiritus Gem&r mieści 64 Spiritus i pochłania luźne motes upuszczone w pobliżu."
		""
		"Wyższe poziomy (Lesser 256, Common 1,024, Greater 4,096, Grand 16,384) wykuwa się jeden w drugim."
	]
	quest.11721D2D8F03C20F.quest_subtitle: "64 małe dusze"
	quest.11721D2D8F03C20F.title: "Petty Gem"
	quest.11F6669733F1420B.quest_desc: [
		"&6Magus Orb&r: &l1,000,000 EV&r Anima. Bank o siedmiu cyfrach."
		""
		"To właśnie pod ten orb wyceniono rytuały."
	]
	quest.11F6669733F1420B.quest_subtitle: "Siedmiocyfrowa dusza"
	quest.11F6669733F1420B.title: "Orb Mistrza"
	quest.16F8403D1836717A.quest_desc: [
		"Trzymaj dowolny orb w &ldrugiej ręce&r i naciśnij użycie: przed Tobą wyrośnie kryształowa bariera, która pochłania ataki dystansowe. Strzały, trójzęby, kule ognia, wszystko."
		""
		"Zużywa 50 EV na sekundę i reaguje tylko na zagrożenia dystansowe. Walka wręcz przechodzi przez nią bez przeszkód. Opcjonalne."
	]
	quest.16F8403D1836717A.quest_subtitle: "Strzały niemile widziane"
	quest.16F8403D1836717A.title: "Sanguine Ward"
	quest.18CD5EBD9682E855.quest_desc: [
		"Runy Tier IV mocno zmieniają liczby: Speed IV, Capacity IV, mnożniki ofiar."
		""
		"Koszt wejścia rośnie razem z nagrodą."
	]
	quest.18CD5EBD9682E855.quest_subtitle: "Speed IV, Capacity IV"
	quest.18CD5EBD9682E855.title: "Tier IV: Czwarty Krąg"
	quest.19891A8F26FBAB0A.quest_desc: [
		"&6Divination Sigil&r odczytuje Twój ołtarz i Twoją Anima na głos: poziom napełnienia, bieżącą pracę, wszystko, czego ołtarzowi brakuje."
		""
		"Warto go nosić przy sobie, gdy uczysz się systemu."
	]
	quest.19891A8F26FBAB0A.quest_subtitle: "Sygil plotkarz"
	quest.19891A8F26FBAB0A.title: "Oczy Array"
	quest.1B6642BBDAEB2BD5.quest_desc: [
		"&6Veneficus Orb&r podnosi limit do &l150,000 EV&r. Od tego momentu rytuały i praca z Athanor robią się szybko drogie."
		""
		"Zbieraj dalej; stare orby nadal napełniają się bez problemu."
	]
	quest.1B6642BBDAEB2BD5.quest_subtitle: "Sześć cyfr"
	quest.1B6642BBDAEB2BD5.title: "Orb Magika"
	quest.1BBABB2106D321A4.quest_desc: [
		"Umieść swój orb w &6Orb Vitae Link&r obok ołtarza, a sieć będzie ładować Twoją Anima bez przerwy."
		""
		"Sposób na zasilanie rytuałów bez użycia rąk. Opcjonalne."
	]
	quest.1BBABB2106D321A4.quest_subtitle: "Ładowanie duszy bez użycia rąk"
	quest.1BBABB2106D321A4.title: "Orb Link"
	quest.1C43D98AB4E51F15.quest_desc: [
		"&6Incense Altar&r stoi w ogrodzie z tranquility blocks i daje &6Blessed Sacrifice&r, spory bonus do Twoich ofiar."
		""
		"Ułóż wokół niego pierścienie ścieżek i tranquility blocks; strona z plannerem ogrodu policzy to za Ciebie."
	]
	quest.1C43D98AB4E51F15.quest_subtitle: "Pachnie zwycięstwem"
	quest.1C43D98AB4E51F15.title: "Incense Altar"
	quest.1CBBEFE4A84ABA45.quest_desc: [
		"&6Spiritus Conduit&r bada 16 bloków w każdym z czterech kierunków świata i ściąga aurę w dół, wyrównując chunki bez wysysania żadnego do sucha."
		""
		"Połącz je w łańcuch od nasyconego chunka do Twojego miejsca pracy. Opcjonalne."
	]
	quest.1CBBEFE4A84ABA45.quest_subtitle: "Hydraulika, ale strasznie"
	quest.1CBBEFE4A84ABA45.title: "Przemieszczanie Aury"
	quest.1F7ACF813D8804A6.quest_desc: [
		"&6Alchemy Array&r przyjmuje dwie ofiary upuszczone w kręgu. Niektóre pary wytwarzają przedmioty, inne od razu wywołują efekty."
		""
		"Twój pierwszy sygil, &6Divination Sigil&r, powstaje z receptury array."
	]
	quest.1F7ACF813D8804A6.quest_subtitle: "Dwie ofiary, jedno życzenie"
	quest.1F7ACF813D8804A6.title: "Krąg Zamiaru"
	quest.22CB17C102BB6773.quest_desc: [
		"Po powrocie do domu możesz przerobić Weak Tau na Strong Tau i wytłoczyć Tau Oil; ogród kadzideł chłonie to paliwo."
		""
		"Olej służy też jako odczynnik do lepszych flaszek."
	]
	quest.22CB17C102BB6773.quest_subtitle: "Paliwo do ogrodu"
	quest.22CB17C102BB6773.title: "Rafinacja Tau"
	quest.22D7D3FBACEBE7FB.quest_desc: [
		"Sygile &6Necromancy&r wskrzeszają sługi Husk, Skeleton i Stray, którzy walczą za Ciebie, dopóki ich nie odprawisz."
		""
		"Kosztują Anima, dopóki stoją na nogach. Opcjonalne."
	]
	quest.22D7D3FBACEBE7FB.quest_subtitle: "Pracownik miesiąca: umarlak"
	quest.22D7D3FBACEBE7FB.title: "Umarli, Którzy Służą"
	quest.2355A35C8F4C6A30.quest_desc: [
		"Trzeci krąg otwiera wyższe poziomy run i wszystkie receptury, które się za nimi kryją."
		""
		"Od tego momentu ołtarz przestaje być warsztatem, a staje się halą fabryczną."
	]
	quest.2355A35C8F4C6A30.quest_subtitle: "Hala fabryczna odblokowana"
	quest.2355A35C8F4C6A30.title: "Tier III: Głębsze Runy"
	quest.24C0619EB4A13CA3.quest_desc: [
		"&6Routing nodes&r wyznaczają wejścia i wyjścia, conduits niosą przepływ, a &6Master Routing Node&r zarządza całością."
		""
		"Zacznij od małego: jeden producent, jeden odbiorca. Opcjonalne."
	]
	quest.24C0619EB4A13CA3.quest_subtitle: "Hydraulika, ale strasznie"
	quest.24C0619EB4A13CA3.title: "Układanie Żył"
	quest.2774F4E92DC99642.quest_desc: [
		"Blessed Sacrifice sprawia, że każda ofiara złożona prawym kliknięciem jest warta o wiele więcej, ale potem wrzuca Cię w &lSoul Fray&r, czas odnowienia, który osłabia wszystko, co nadejdzie później."
		""
		"Więc robisz cykl: błogosław, ofiaruj, odpocznij. Opcjonalne."
	]
	quest.2774F4E92DC99642.quest_subtitle: "Pachnie zwycięstwem"
	quest.2774F4E92DC99642.title: "Soul Fray"
	quest.298458E916F65407.quest_desc: [
		"Aura jest &loparta na chunkach&r: Spiritus spalony w jednym chunku napełnia tylko ten chunk, z limitem 100 na aspekt."
		""
		"Prawie każda maszyna ze środkowej fazy gry czerpie z lokalnej aury, a nie z Twojego ekwipunku."
	]
	quest.298458E916F65407.quest_subtitle: "Lokalne powietrze, nawiedzone"
	quest.298458E916F65407.title: "Aura Między Światami"
	quest.29953F9E8F0A0D7B.quest_desc: [
		"&6Daemonium Cruoris&r grasuje w głębszych korytarzach. Łowca krwi, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.29953F9E8F0A0D7B.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.29953F9E8F0A0D7B.title: "Daemonium Cruoris"
	quest.29B003254299103C.quest_desc: [
		"Gemy Greater i Grand sprężają całe zbiorniki w jednym slocie ekwipunku."
		""
		"Poziom Greater wymaga Tabula Spiritus, Weak Blood Shard i Spiritus Crystal. Opcjonalne."
	]
	quest.29B003254299103C.quest_subtitle: "Większe butelki"
	quest.29B003254299103C.title: "W Górę po Drabinie"
	quest.2C0A6D0EC40C766A.quest_desc: [
		"&6Daemonium Ignis&r grasuje w głębszych korytarzach. Płonący, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.2C0A6D0EC40C766A.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.2C0A6D0EC40C766A.title: "Daemonium Ignis"
	quest.2C178EF05E31AE9A.quest_desc: [
		"W środku każdy &6Dungeon Seal&r wymaga &lSimple Dungeon Key&r, a te wypadają tylko ze skrzyń w tym miejscu. Klucz przyniesiony z zewnątrz niczego nie otworzy."
		""
		"Skrzynie dają zaklęty sprzęt, anointments, Spiritus i Twoje pierwsze uprawy Tau."
	]
	quest.2C178EF05E31AE9A.quest_subtitle: "Klucze to łup, nie receptury"
	quest.2C178EF05E31AE9A.title: "Antechamber"
	quest.2E22A601DC126B7B.quest_desc: [
		"&6Spiritus&r to druga ekonomia: waluta dusz zamiast krwi. Dają go zabójstwa oznaczone sztyletem i sentient blades."
		""
		"Luźny Spiritus jednak wszystko zaśmieca, więc potrzebny jest gem."
	]
	quest.2E22A601DC126B7B.quest_subtitle: "Drugi portfel"
	quest.2E22A601DC126B7B.title: "Kryształy z Niczego"
	quest.332F3C08E4014F63.quest_desc: [
		"&6Spirit Accumulator&r to unoszący się zbiornik, który magazynuje 1,000 Spiritus jednego aspektu, a sieć routingu może z niego czerpać."
		""
		"Athanor wykuwa go z Animus Mote, Common Gem, Tabula Spiritus, Raw shard, Blood Tank i 2,000 mB EV, w chunku zawierającym 45 Raw."
	]
	quest.332F3C08E4014F63.quest_subtitle: "Tysiąc w zbiorniku"
	quest.332F3C08E4014F63.title: "Spirit Accumulator"
	quest.3617A216FF8BC06C.quest_desc: [
		"Loch za każdym razem przebudowuje się w nową układankę. Te same pomieszczenia, nowa mapa."
		""
		"Wypatruj &6Spatial Distortions&r: komnat z mackami pustki, które kryją wejście do Mines albo drzwi Foremana. Sam wymiar ostrzega Cię, gdy się pojawią."
	]
	quest.3617A216FF8BC06C.quest_subtitle: "Te same pokoje, nowy koszmar"
	quest.3617A216FF8BC06C.title: "Endless Realm"
	quest.36BA45620B2BED5B.quest_desc: [
		"&6Runes of the Orb&r zwiększają Twoją pojemność Anima ponad to, na co pozwala nawet Divinus Orb."
		""
		"Jeśli orb najwyższego poziomu nadal nie wystarcza, to kolejna dźwignia. Opcjonalne."
	]
	quest.36BA45620B2BED5B.quest_subtitle: "Rozciągnij akumulator"
	quest.36BA45620B2BED5B.title: "Runes of the Orb"
	quest.383F7F715C60252B.quest_desc: [
		"Tier II znów poszerza ołtarz. Więcej miejsc na runy oznacza Twoją pierwszą prawdziwą konstrukcję: działającą mieszankę Speed i Capacity."
		""
		"Odblokowuje też receptury ołtarza, które otwierają środek moda."
	]
	quest.383F7F715C60252B.quest_subtitle: "Więcej miejsca na ambicje"
	quest.383F7F715C60252B.title: "Tier II: Drugi Krąg"
	quest.3CA324BE8531F253.quest_desc: [
		"&6Weak Blood Shard&r to dzieło Athanor, powstaje, gdy maszyna już stoi."
		""
		"Jest kluczem do Greater Gem i receptur wyższych od niej."
	]
	quest.3CA324BE8531F253.quest_subtitle: "Mały odłamek, wielkie klucze"
	quest.3CA324BE8531F253.title: "Weak Blood Shard"
	quest.3E563EED3D77FC35.quest_desc: [
		"&6Daemonium Animaris&r grasuje w głębszych korytarzach. Łowca wymiaru o aspekcie duszy, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.3E563EED3D77FC35.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.3E563EED3D77FC35.title: "Daemonium Animaris"
	quest.3EC65211B94462DA.quest_desc: [
		"&6Animus Mote&r wypada tylko jako łup z wymiaru i jest jedynym elementem, bez którego nie da się wykuć Spirit Accumulator."
		""
		"Zachowaj każdy, który znajdziesz. Opcjonalne przypomnienie."
	]
	quest.3EC65211B94462DA.quest_subtitle: "Rzadki łup, nie zgub"
	quest.3EC65211B94462DA.title: "Animus Mote"
	quest.3ECB062B99C4E4A5.quest_desc: [
		"&6Teleposer&r zamienia bloki między dwoma zaznaczonymi punktami albo przenosi Cię między nimi."
		""
		"Narzędzie na późną fazę gry do przenoszenia spawnerów, upraw i własnych stóp. Opcjonalne."
	]
	quest.3ECB062B99C4E4A5.quest_subtitle: "Dzień przeprowadzki, magicznie"
	quest.3ECB062B99C4E4A5.title: "Teleposer"
	quest.3F2FE793CE5052F0.quest_desc: [
		"&6Routing Network&r to logistyka moda: nodes, conduits i routers przenoszące przedmioty, płyny i Spiritus między maszynami."
		""
		"Dzięki niej ołtarz, tygiel i gemy przestają Cię potrzebować."
	]
	quest.3F2FE793CE5052F0.quest_subtitle: "Rury z charakterem"
	quest.3F2FE793CE5052F0.title: "Routing Network"
	quest.40C32A4F6DE4B782.quest_desc: [
		"&6Athanor&r to trzeci wielki warsztat: tygiel, który warzy odłamki, akumulatory i ciężkie odczynniki, którymi żywi się aura."
		""
		"Potrzebuje jednocześnie EV, aury i materiałów, więc przed odpaleniem sprawdź wskaźnik."
	]
	quest.40C32A4F6DE4B782.quest_subtitle: "Warsztat numer trzy"
	quest.40C32A4F6DE4B782.title: "Athanor"
	quest.419DB4A2A5A5FC58.quest_desc: [
		"&6Foreman&r zarządza głębokimi robotami. To walka z bossem tego wymiaru."
		""
		"Zabij go dla ciężkich dropów: demonite i elementów zasilających pracę z Hellforged."
	]
	quest.419DB4A2A5A5FC58.quest_subtitle: "On tu rządzi"
	quest.419DB4A2A5A5FC58.title: "Foreman"
	quest.4393ADF3E4C8B0D4.quest_desc: [
		"Spiritus występuje w pięciu aspektach: &6Raw, Ruina, Invictus, Nihilum, Vindicta&r. Do różnych prac potrzeba różnych aspektów."
		""
		"Aura liczy je osobno, a nasycenie chunka jednym aspektem to początek pracy z aspektami. Opcjonalna lekcja."
	]
	quest.4393ADF3E4C8B0D4.quest_subtitle: "Wybierz smak"
	quest.4393ADF3E4C8B0D4.title: "Pięć Aspektów"
	quest.4476319FD2019185.quest_desc: [
		"&6Daemonium Voraxis&r grasuje w głębszych korytarzach. Wiecznie głodny, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.4476319FD2019185.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.4476319FD2019185.title: "Daemonium Voraxis"
	quest.44DC32A27B02CDB8.quest_desc: [
		"&6Holding&r i &6Bound Treasures&r zmieniają sygil w dodatkowe kieszenie."
		""
		"Przydatne w długich wyprawach do lochu, gdzie ekwipunek szybko się zapełnia. Opcjonalne."
	]
	quest.44DC32A27B02CDB8.quest_subtitle: "Kieszenie, ale magiczne"
	quest.44DC32A27B02CDB8.title: "Przenoszony Magazyn"
	quest.459F6257FB16AC47.quest_desc: [
		"Ostatni krąg dopełnia Ara Vitae. Każda rodzina run dostaje swoje najwyższe miejsce."
		""
		"Ołtarz, który zaczynałeś jako pojedynczy blok, jest teraz katedrą."
	]
	quest.459F6257FB16AC47.quest_subtitle: "Katedra run"
	quest.459F6257FB16AC47.title: "Tier V: Ostatni Krąg"
	quest.46122A9389875512.quest_desc: [
		"&6Rituals&r to rysowane diagramy kamieni rytualnych wokół Master Ritual Stone: wielkie jednorazowe efekty, od farm po przebijanie się do wymiaru."
		""
		"Ritual Designer planuje je za Ciebie; Diviner mówi, czego dany wzór potrzebuje."
	]
	quest.46122A9389875512.quest_subtitle: "Wielkie efekty, większe rysunki"
	quest.46122A9389875512.title: "Rytuały i Obrzędy"
	quest.4694863405CFB97B.quest_desc: [
		"&6Mines&r to głęboki poziom wymiaru: drzwi na mine keys, groźniejsze daemonium i rudy, dla których naprawdę warto się tu fatygować."
		""
		"Mine keys wypadają z łupów w Endless Realm."
	]
	quest.4694863405CFB97B.quest_subtitle: "Gdzie mieszka dobra ruda"
	quest.4694863405CFB97B.title: "Mines"
	quest.4840F41B536529E3.quest_desc: [
		"&6Tipped Throwing Dagger&r niesie anointment na ostrzu: jeden rzut nakłada na cel to, czym został pomalowany."
		""
		"Do osłabiania celów, które nie ustoją w miejscu na drugi sztylet. Opcjonalne."
	]
	quest.4840F41B536529E3.quest_subtitle: "Pomaluj to"
	quest.4840F41B536529E3.title: "Ostrzejsza Końcówka"
	quest.499B8461225D3E74.quest_desc: [
		"Tabula warzy &6Anointments&r: tymczasowe zaklęcia, które nakładasz na ostrza i narzędzia na czas pracy."
		""
		"Sharpness na noc z bossem, Fortune na wyprawę górniczą. Opcjonalne."
	]
	quest.499B8461225D3E74.quest_subtitle: "Tymczasowa ostrość"
	quest.499B8461225D3E74.title: "Anointments"
	quest.4AE0C2D2D8D145F6.quest_desc: [
		"Wymiar robi się bogatszy wraz z głębią: głębsze pieczęcie, lepsze skrzynie, mote i boss."
		""
		"Opcjonalna ścieżka na trudny koniec gry."
	]
	quest.4AE0C2D2D8D145F6.quest_subtitle: "Klucze to łup, nie receptury"
	quest.4AE0C2D2D8D145F6.title: "Praca w Głębinach"
	quest.4EBC5B191A7B12D9.quest_desc: [
		"Runy otaczają ołtarz, a każda ich rodzina go zmienia: Speed, Capacity, Sacrifice, Orb i inne. Wszystkie zaczynają jako &6Blank Runes&r."
		""
		"Wytwórz teraz całą partię; kolejne kręgi będą ich potrzebować."
	]
	quest.4EBC5B191A7B12D9.quest_subtitle: "Każda katedra potrzebuje cegieł"
	quest.4EBC5B191A7B12D9.title: "Blank Runes"
	quest.4EE580588CC10C4E.quest_desc: [
		"&6Demonite&r wypada z głębokiego wymiaru: żwir, fragmenty i surowe bryły metalu pochodzącego z samego wymiaru."
		""
		"To ruda, w której wyceniono cały endgame."
	]
	quest.4EE580588CC10C4E.quest_subtitle: "Własny metal wymiaru"
	quest.4EE580588CC10C4E.title: "Demonite"
	quest.4F77EDCEB49EB67F.quest_desc: [
		"Runy orba i szybkość ołtarza się kumulują. W pełni rozbudowany krąg utrzymuje nawet drenaż na poziomie Divinus."
		""
		"Opcjonalne strojenie dla cierpliwych."
	]
	quest.4F77EDCEB49EB67F.quest_subtitle: "Procent składany, wersja krwawa"
	quest.4F77EDCEB49EB67F.title: "Podwajanie Run"
	quest.538E28637FF76912.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.538E28637FF76912.title: "AllRightsReserved"
	quest.54AB11938676D4C7.quest_desc: [
		"Ten warsztat podwaja popularne rudy przez przetwarzanie z odczynnikami: wkładasz żelazo, złoto, miedź i resztę, a wychodzi podwójnie."
		""
		"Wolno w przeliczeniu na sztukę, ale za darmo dla cierpliwej bazy. Opcjonalne."
	]
	quest.54AB11938676D4C7.quest_subtitle: "Dwa za jeden, powoli"
	quest.54AB11938676D4C7.title: "Alchemia Rudy"
	quest.564AD8763F753C74.quest_desc: [
		"Tabula Vitae napełnia też &6Alchemy Flasks&r: do picia, zalegające i rzucane efekty warzone z Twojej Anima."
		""
		"Flaszki bojowe i użytkowe mają tu swoje miejsce."
	]
	quest.564AD8763F753C74.quest_subtitle: "Alchemia do wypicia"
	quest.564AD8763F753C74.title: "Efekty w Butelce"
	quest.56983FF3D82AF789.quest_desc: [
		"&6Imperfect Ritual Stones&r same wykonują małe jednorazowe efekty: sterowanie dniem i nocą, deszcz, inne szybkie sztuczki."
		""
		"Tanie, natychmiastowe i dobre do nauki systemu. Opcjonalne."
	]
	quest.56983FF3D82AF789.quest_subtitle: "Tanie sztuczki, dosłownie"
	quest.56983FF3D82AF789.title: "Niedoskonałe Rytuały"
	quest.56DDCB2865CEB9D3.quest_desc: [
		"&6Spiritus Aura Gauge&r rzutuje pięć pasków chunka na Twój widok, wystarczy, że leży w ekwipunku."
		""
		"Skradaj się, by zobaczyć dokładne liczby: Raw, Ruina, Invictus, Nihilum, Vindicta, od 0 do 100 każda."
	]
	quest.56DDCB2865CEB9D3.quest_subtitle: "Pięć pasków, brak zasięgu"
	quest.56DDCB2865CEB9D3.title: "Odczytywanie Aury"
	quest.56F4E4845B8F12BB.quest_desc: [
		"Mając związany orb, kliknij nim prawym przyciskiem przy ołtarzu, by złożyć ofiarę z własnej krwi: misa napełnia się EV. Z dala od ołtarza orb przechowuje ofiarę na później."
		""
		"EV w misie pozwala wytworzyć &6Tabula Rasa&r, podłoże niemal każdego sygilu, i wiele więcej."
	]
	quest.56F4E4845B8F12BB.quest_subtitle: "Krew w moc"
	quest.56F4E4845B8F12BB.title: "Czysta Karta"
	quest.5785D68A5F1ED2D2.quest_desc: [
		"&6Tau&r rośnie tylko w Demon Realm: Weak Tau, Strong Tau i Tau Oil pochodzą z jego wnętrza."
		""
		"Zasila ogród kadzideł i alchemię średniego poziomu, więc zbieraj je, póki tam jesteś."
	]
	quest.5785D68A5F1ED2D2.quest_subtitle: "Demoniczny owoc, najlepszy owoc"
	quest.5785D68A5F1ED2D2.title: "Żniwa Tau"
	quest.58248AF507380501.quest_desc: [
		"Zdejmuj zaklęcia ze sprzętu, z którego wyrosłeś, i odkładaj je do ponownego użycia."
		""
		"Cichy sposób na recykling łupów, którymi sypie loch. Opcjonalne."
	]
	quest.58248AF507380501.quest_subtitle: "Odzyskaj blask"
	quest.58248AF507380501.title: "Odzyskiwanie Zaklęć"
	quest.5A99B71DB0C6A42A.quest_desc: [
		"Pieczęcie mają stopnie. Simple keys otwierają Antechamber; głębsze drzwi wymagają &6Mine Keys&r i gorszych."
		""
		"Każdy klucz to łup w wymiarze. Nigdy się ich nie wytwarza."
	]
	quest.5A99B71DB0C6A42A.quest_subtitle: "Klucze to łup, nie receptury"
	quest.5A99B71DB0C6A42A.title: "Głębsze Zamki"
	quest.5AA17C1657E8E5DE.quest_desc: [
		"Sentient gear poprawia się tylko wtedy, gdy jest noszony i używany, więc daj mu pracę."
		""
		"Im dłużej z Tobą żyje, tym lepszy się staje. Opcjonalne."
	]
	quest.5AA17C1657E8E5DE.quest_subtitle: "Rozchodź go jak buty"
	quest.5AA17C1657E8E5DE.title: "Rozchodź To"
	quest.5ACB4565C6B2466C.quest_desc: [
		"Zasil tygiel &lredstonem&r, a odwróci się: pusty gem w środku zostanie &lnapełniony&r aurą chunka zamiast ją oddawać."
		""
		"Nasyć jeden aspekt, zostaw gem do ładowania, a przejmie ten aspekt."
	]
	quest.5ACB4565C6B2466C.quest_subtitle: "Redstone odwraca kurek"
	quest.5ACB4565C6B2466C.title: "Aspected Gems"
	quest.5BDD9D290D63ECE7.quest_desc: [
		"&6Daemonium Rancoris&r grasuje w głębszych korytarzach. Mściwy, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.5BDD9D290D63ECE7.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.5BDD9D290D63ECE7.title: "Daemonium Rancoris"
	quest.5C3EA8B4F5949406.quest_desc: [
		"&6Hellfire Forge&r to Twój drugi warsztat: z niej wychodzą sentient equipment, lepsze Spiritus Gems i połowa środkowej fazy gry."
		""
		"Pochłania Spiritus i EV, więc przed ciężką pracą zasil obie ekonomie."
	]
	quest.5C3EA8B4F5949406.quest_subtitle: "Goręcej niż grill"
	quest.5C3EA8B4F5949406.title: "Hellfire Forge"
	quest.5C7581C81669C499.quest_desc: [
		"&6Fast Miner&r przyspiesza Twój kilof, &6Green Grove&r hoduje uprawy, a &6Magnetism&r przyciąga dropy do Ciebie."
		""
		"Klasyczny zestaw użytkowy. Opcjonalne."
	]
	quest.5C7581C81669C499.quest_subtitle: "Haste robi rudę"
	quest.5C7581C81669C499.title: "Sygile Robotnika"
	quest.602884068EC40EDB.quest_desc: [
		"Narzędzia &6Sentient&r i miecz to żywy sprzęt. Zabójstwa sentient ostrzem od razu dają Spiritus, bez oznaczania sztyletem."
		""
		"Awansują dzięki woli, którą je karmisz. Opcjonalne, ale warto."
	]
	quest.602884068EC40EDB.quest_subtitle: "Uczy się. Karm go."
	quest.602884068EC40EDB.title: "Sentient Steel"
	quest.6101AB772B0317F1.quest_desc: [
		"Twoja &6Anima&r to niewidzialna sieć dusz, która przechowuje EV dla wszystkiego, co vitaemantyczne: sygili, rytuałów, orbów. Gdy się wyczerpie, niektóre przedmioty pobiorą koszt z Twojego ciała."
		""
		"Włóż orb do naładowanego ołtarza, by przenieść zgromadzoną krew do swojej Anima, dziesięć razy szybciej niż normalnie."
	]
	quest.6101AB772B0317F1.quest_subtitle: "Dusza ma baterię"
	quest.6101AB772B0317F1.title: "Zmysł Anima"
	quest.6171A7D347B9DFF4.quest_desc: [
		"&6Ritual Diviner&r pokazuje kształt, którego wymaga rytuał, i podgląda koszt, zanim zdecydujesz się na kamienie."
		""
		"Kosztuje mniej niż zgadywanie. Opcjonalne."
	]
	quest.6171A7D347B9DFF4.quest_subtitle: "Podgląd, zanim zapłacisz"
	quest.6171A7D347B9DFF4.title: "Oko Diviner"
	quest.62341583003C250F.quest_desc: [
		"&6Daemonium Doloris&r grasuje w głębszych korytarzach. Sprowadzający ból, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.62341583003C250F.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.62341583003C250F.title: "Daemonium Doloris"
	quest.62F71D88F1ED68B8.quest_desc: [
		"Dziesięć gatunków daemonium krąży po wymiarze, po jednym na aspekt i nastrój: Animaris, Cruoris, Doloris i reszta, a każdy upuszcza własny łup."
		""
		"Strona Bestiary wymienia, co każdy z nich pilnuje. Opcjonalny przewodnik terenowy."
	]
	quest.62F71D88F1ED68B8.quest_subtitle: "Dziesięć smaków kłopotów"
	quest.62F71D88F1ED68B8.title: "Poznaj Swoje Daemonium"
	quest.63BEB615CC08733D.quest_desc: [
		"&6Daemonium Fervidis&r grasuje w głębszych korytarzach. Żarliwy, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.63BEB615CC08733D.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.63BEB615CC08733D.title: "Daemonium Fervidis"
	quest.65BD73DA55BCC624.quest_desc: [
		"Neo Vitae to sztuka Vitaemancy: Twoja własna krew, przerobiona na moc. Ten rozdział prowadzi całą ścieżką, od pierwszego nacięcia po sam Demon Realm."
		""
		"Podążaj główną linią od lewej do prawej. Boczne gałęzie to opcjonalne lekcje, które dają lepsze historie niż sprzęt."
	]
	quest.65BD73DA55BCC624.quest_subtitle: "Chce tylko odrobinę"
	quest.65BD73DA55BCC624.title: "Witaj w Neo Vitae"
	quest.6607F68E3F0B6243.quest_desc: [
		"&6Daemonium Glaciaris&r grasuje w głębszych korytarzach. Lodowy prześladowca, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.6607F68E3F0B6243.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.6607F68E3F0B6243.title: "Daemonium Glaciaris"
	quest.671F7551CBDF462F.quest_desc: [
		"Rytuał Tier III pomija przedsionek i przenosi Cię prosto do &lEndless Realm&r, proceduralnym sercu wymiaru."
		""
		"Im głębiej wchodzisz, tym trudniejsze pomieszczenia: twardsze spawnery, bogatszy łup. Zabierz sprzęt."
	]
	quest.671F7551CBDF462F.quest_subtitle: "Bez opłat, tylko demony"
	quest.671F7551CBDF462F.title: "Autostrada do Piekła"
	quest.678017C531F68528.quest_desc: [
		"Sygile to Twoje narzędzia pracy: każdy robi jedną rzecz, zasilany EV z Twojej Anima."
		""
		"Kolejne zadania pokazują poszczególne rodziny. Wszystkie opcjonalne, wszystkie przydatne."
	]
	quest.678017C531F68528.quest_subtitle: "Jeden sygil, jedno zadanie"
	quest.678017C531F68528.title: "Pas Pełen Sygili"
	quest.6A866C75EE839078.quest_desc: [
		"Elementalne sygile naginają teren i pogodę: pomoc w lataniu, obsługa lawy, praca z mrozem."
		""
		"Każdy wytwarza się w array i czerpie z ładunku Anima."
	]
	quest.6A866C75EE839078.quest_subtitle: "Elementalny zestaw narzędzi"
	quest.6A866C75EE839078.title: "Powietrze, Lawa i Mróz"
	quest.702FC3E5D0D6C31F.quest_desc: [
		"&6Divinus Orb&r: &l10,000,000 EV&r, największe naczynie, jakie oferuje Vitaemancy."
		""
		"Z nim w ręku stać Cię na każdy rytuał na mapie."
	]
	quest.702FC3E5D0D6C31F.quest_subtitle: "Szczyt to styl życia"
	quest.702FC3E5D0D6C31F.title: "Szczyt"
	quest.70D2718D54785867.quest_desc: [
		"&6Spiritus Crucible&r spala gemy i kryształy do &laury&r, czyli Spiritus rozproszonego w powietrzu chunka, w którym stoi."
		""
		"Karm go naładowanymi gemami, luźnym Spiritus Essence lub odłamkami kryształów."
	]
	quest.70D2718D54785867.quest_subtitle: "Powietrze zyskuje równowagę"
	quest.70D2718D54785867.title: "Spiritus Crucible"
	quest.71E0D06EA65172CF.quest_desc: [
		"Ołtarz wykuwa też &6Throwing Daggers&r, Twoją wczesną broń dystansową i zalążek całej ekonomii Spiritus."
		""
		"Oznacz wrogie stworzenie raną od sztyletu, a potem je dobij: zabójstwo daje motes &6Spiritus&r. Miej przy sobie stos."
	]
	quest.71E0D06EA65172CF.quest_subtitle: "Najpierw dźgnij, potem zbieraj"
	quest.71E0D06EA65172CF.title: "Throwing Daggers"
	quest.73391A08D7615C77.quest_desc: [
		"Postaw &6Ara Vitae&r na płaskim terenie i połóż na nim &ldiament&r. Bez własnego zasilania ołtarz pobiera krew od każdego, kto stoi w pobliżu, i rafinuje ją w &6Essentia Vitae (EV)&r."
		""
		"Diament przemienia się w &6Novicius Orb&r. Kliknij nim prawym przyciskiem, by związać go ze swoją duszą."
	]
	quest.73391A08D7615C77.quest_subtitle: "Chce tylko odrobinę"
	quest.73391A08D7615C77.title: "Pierwszy Ołtarz"
	quest.759B0D6F8C0CC1EF.quest_desc: [
		"Pierwsze ulepszenie ołtarza to pierścień run osadzonych w kamieniu wokół Ara Vitae. Na Tier I otwiera się osiem miejsc na runy."
		""
		"Speed Runes skracają każde wytwarzanie; Capacity Runes pogłębiają misę. Dokładne liczby podaje strona plannera."
	]
	quest.759B0D6F8C0CC1EF.quest_subtitle: "Ołtarz zyskuje koronę"
	quest.759B0D6F8C0CC1EF.title: "Tier I: Pierścień Run"
	quest.770A5CCB2B571FD0.quest_desc: [
		"Orb w drugiej ręce pije z każdego zabójstwa: &l10 EV za punkt maksymalnego zdrowia&r ofiary trafia do własnego zbiornika orba."
		""
		"Napełnij go na polu bitwy, a potem połóż orb na ołtarzu, by wpłacić 10-krotną stawkę do swojej Anima."
	]
	quest.770A5CCB2B571FD0.quest_subtitle: "Każde zabójstwo się opłaca"
	quest.770A5CCB2B571FD0.title: "Żniwa Poległych"
	quest.7731623EA92027D9.quest_desc: [
		"&6Dominus Orb&r mieści &l5,000,000 EV&r. Od tego momentu Anima rzadko wyczerpuje się w środku rytuału."
		""
		"Po tym zostaje jeszcze jeden poziom."
	]
	quest.7731623EA92027D9.quest_subtitle: "Pięć milionów i rośnie"
	quest.7731623EA92027D9.title: "Orb Arcymaga"
	quest.7AFEB7A91DC8F413.quest_desc: [
		"Wykuj &6Discipulus Orb&r przy ołtarzu Tier I, a Twoja pojemność Anima skoczy z 5,000 do &l25,000 EV&r."
		""
		"Większe ofiary, większe wytwarzanie. Napełniaj dalej."
	]
	quest.7AFEB7A91DC8F413.quest_subtitle: "25,000 powodów, by iść dalej"
	quest.7AFEB7A91DC8F413.title: "Orb Ucznia"
	quest.7B293C32824033F9.quest_desc: [
		"&6Crystallarium Maleficum&r hoduje Spiritus Crystals z surowych odłamków zasilanych aurą."
		""
		"Farma kryształów, która utrzymuje zapas wszystkich pięciu aspektów."
	]
	quest.7B293C32824033F9.quest_subtitle: "Uprawa kryształów, w skrócie"
	quest.7B293C32824033F9.title: "Aktywuj Crystallarium Maleficum"
	quest.7C7C061FC04B89FB.quest_desc: [
		"Przerób demonite na części i sztabki &6Hellforged&r: metal stojący za najlepszymi narzędziami i ogniwami."
		""
		"Ostatni materiał, o który prosi ten rozdział."
	]
	quest.7C7C061FC04B89FB.quest_subtitle: "Materiał z najwyższej półki"
	quest.7C7C061FC04B89FB.title: "Hellforged Steel"
	quest.7CF9A68167ADAD1A.quest_desc: [
		"Produkcja ofiar skaluje się z runami szybkości ołtarza i Twoim bonusem do ofiar."
		""
		"Wolna krew to wolna praca; wcześniejsze zadania o automatyzacji to naprawiają. Opcjonalne."
	]
	quest.7CF9A68167ADAD1A.quest_subtitle: "Szybkość to statystyka buildu"
	quest.7CF9A68167ADAD1A.title: "Ociężałe Serce Nikomu Nie Służy"
	quest.7FEB1850709B6C3B.quest_desc: [
		"&6Daemonium Corrodis&r grasuje w głębszych korytarzach. Korodujący, jeden z dziesięciu w tym wymiarze."
		"Zabij jednego, by zapisać go w rejestrze. Głębsze komnaty skrywają rzadsze gatunki."
	]
	quest.7FEB1850709B6C3B.quest_subtitle: "Jeden z dziesięciu w tym wymiarze"
	quest.7FEB1850709B6C3B.title: "Daemonium Corrodis"
	task.0288CB407D31C889.title: "Wejdź do Endless Realm"
	task.1FF3177703E8A956.title: "Osadź Trzeci Krąg Run"
	task.29A4F7568EC9A669.title: "Wykuj Greater Spiritus Gem"
