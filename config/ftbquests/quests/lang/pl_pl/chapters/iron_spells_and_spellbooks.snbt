{
	image.011E4B6218D76D3A.title: "Ancient Knight"
	image.0603F832DA138A7B.title: "Scroll Forge"
	image.0C7130648130C896.title: "The Dead King"
	image.1738DE4800011D8B.title: "Spider Den"
	image.1EE2339CB09FDF9B.title: "Pyromancer Tower"
	image.29FABA9C983D1601.title: "Mangrove Hut"
	image.30F797309050ABCB.title: "Arcane Anvil"
	image.3347BF8400EC3592.title: "Citadel"
	image.38F99DB68682AB5E.title: "Mountain Tower"
	image.451CDFE56E407A48.title: "Alchemist Cauldron"
	image.4BF4AB0B829E9AC5.title: "Pyromancer"
	image.4CC18CD4CE3866C8.title: "Necromancer"
	image.5B166D12B729120B.title: "Cryomancer"
	image.60B89CFF74362ACD.title: "Echo of Tyros"
	image.759143506B8CE5E2.title: "Evoker Fort"
	image.7C697E0FFFB970F2.title: "Inscription Table"
	quest.000C1ECD781F3F81.quest_desc: ["&2&lNature&r służy do wykorzystywania Ziemi na naszą korzyść poprzez &2zatruwanie&r i &2osłabianie&r naszych wrogów! Dokładnie tak, jak robią to wielkie korporacje samej Ziemi! \\n&2&lNature&r ma jako Focus Material &2Poisonous Potato&r. \\n\\n&2Zwoje&r są &ajasnozielone&r z &2ciemnozielonym&r tekstem."]
	quest.000C1ECD781F3F81.title: "&2&lNature"
	quest.00D80AA4CDD8335C.quest_desc: ["Twoim zdaniem &6&lPriest&r nie jest wystarczająco &6Holy&r? W takim razie możesz wytworzyć &6Lightbringer Chestplate&r! \\n\\nNajpierw potrzebujesz &6Priest Robes&r, które można wytworzyć. \\n\\nPotrzebujesz też 3 &bMithril Weaves&r, wykonywanych z &bMithril&r i łańcuchów. \\n\\nNastępnie musisz zdobyć &dDivine Soulshard&r i możesz wytworzyć &6Chestplate&r. \\n\\nTen &6Chestplate&r daje tyle samo punktów zbroi co &6Priest Robes&r, ale wszystko inne jest znacznie lepsze! \\n\\nDostajesz Armor Toughness, Knockback Resistance i oczywiście więcej &3Spell Power&r oraz many."]
	quest.00D80AA4CDD8335C.title: "&6Lightbringer Chestplate"
	quest.01119871B1D5C576.quest_desc: [
		"Prawie w każdej &6wiosce&r mogą być &6&lPriests&r. Dotyczy to także &6wiosek&r z modów. \\n\\nZwykle stoją na środku &6wioski&r, na przykład przy targowiskach. Nie w każdej &6wiosce&r jakiś będzie."
		"{image:atm:textures/questpics/iron_spells/spells_village.png width:200 height:100 align:center}"
	]
	quest.01119871B1D5C576.title: "&6Wioska"
	quest.0436DF3308681913.quest_desc: [
		"Na tronie spoczywają szczątki dawnego &4&lKróla&r. Ale gdy podejdziesz bliżej i ich dotkniesz, zobaczysz, jak powstają z martwych; &4&lKról&r już nie jest martwy! Utrzyma go przy życiu jedynie morderstwo... a Ty jesteś najbliższą żywą istotą. \\n\\n&4&lThe Dead King&r to pierwszy boss w &lIron's Spells 'N Spellbooks&r. Ma 500 &cserc&r oraz prawdziwy pasek życia bossa (i muzykę). Potrafi używać wielu &3czarów&r z każdej klasy: od &2Poison Arrow&r z &2Nature&r, przez &6Blight&r z &6Holy&r, aż po &aFangs&r z &aEvokation&r! Potrafi też się teleportować, przywoływać umarłych i uderzać Cię za pomocą &4Blood Staff&r. \\n\\nJeśli go pokonasz, wypadną z niego &3zwoje&r wszelkiego rodzaju, Bone Keys, a być może także &4Blood Staff&r i Necronomicon.\\n\\nMożna go przywrócić do życia... znowu... za pomocą jego &9Phylactery&r, której odłamki można zdobyć z Trial Spawners w &4Catacombs&r."
		"{image:atm:textures/questpics/iron_spells/spells_king.png width:100 height:200 align:center}"
	]
	quest.0436DF3308681913.title: "&4&lThe Dead King"
	quest.0474C15D3AE3C2C9.quest_desc: ["&cDecrepit Scythe&r to broń, której &c&lEcho of Tyros&r używa, żeby Cię zabić. Tyle że nasza wersja jest znacznie mniejsza. \\n\\nMa bardzo podobne statystyki do &5Decrepit Flamberge&r, tylko nieco, naprawdę nieco, wyższe Attack Speed. \\n\\nMożna ją też ulepszyć za pomocą &6Pyrium&r, co da jej więcej obrażeń oraz &3czar&r! \\n\\n&3Czar &cHellrazera&r to &cRaise Hell&r. Wyśle on falę &cognia&r we wszystkich kierunkach wokół Ciebie. Nie rozprzestrzeni &cognia&r, ale zada mnóstwo obrażeń wszystkim pobliskim mobom!"]
	quest.0474C15D3AE3C2C9.title: "&cDecrepit Scythe"
	quest.05DBDD86FCFF3BA8.title: "&5Lightning&r Upgrade Orb"
	quest.06F2C42E6408149E.quest_desc: [
		"Mam nadzieję, że nie ukradłeś tego od &c&lPyromancera&r, to ten miły!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_pyromancer.png width:50 height:100 align:center}"
	]
	quest.06F2C42E6408149E.title: "&cPyromancer Outfit"
	quest.06F8EDF7513F8611.title: "&dEpic&r Ink"
	quest.08767A1E6D48A5EA.quest_desc: ["&7Graybeard Staff&r to bardzo tania laska. Tania zarówno ceną, jak i jakością. \\n\\nZadaje tylko 3 &4obrażenia&r, ale daje 25% Mana Regeneration i 10% &3Spell Power&r. \\n\\nCałkiem przydatna, jeśli zabijasz wyłącznie za pomocą &3czarów&r!"]
	quest.08767A1E6D48A5EA.quest_subtitle: "Kiedy zmieni się w Whitebeards?"
	quest.08767A1E6D48A5EA.title: "&7Graybeard Staff"
	quest.0CE1F6DE5FD6A6D9.title: "&aEvocation&r Upgrade Orb"
	quest.0E594BC58CC7476F.quest_desc: [
		"Może i jest zły, ale za to modny. "
		"{image:atm:textures/questpics/iron_spells/spells_outfit_archevoker.png width:60 height:100 align:center}"
	]
	quest.0E594BC58CC7476F.title: "&aArchevoker Outfit"
	quest.0EED5D755D2C866A.quest_desc: ["&d&lEnder&r służy do przejmowania wszystkich mocy &dEndermanów&r i &dEnder Dragona&r, a oczywiście także do używania ich dla siebie. &dTeleportacja&r, &dKule ognia&r i &dOddech smoka&r to tylko kilka z nich! \\n\\nFocus Material szkoły &d&lEnder&r to &dEnder Pearls&r. \\n\\n&dZwoje&r są &5fioletowe&r z &dróżowym&r tekstem."]
	quest.0EED5D755D2C866A.title: "&d&lEnder"
	quest.0F8B349EBC9110D6.quest_desc: ["Ten przedmiot jest fajny do zdobycia! Najpierw potrzebujemy &5Lightning Rod&r oraz &5Energized Core&r. \\n\\nPotem, gdy trwa burza, kliknij prawym przyciskiem myszy &5Energized Core&r na &5Lightning Rod&r. Jeśli zrobisz to prawidłowo, uderzy &5piorun&r. Zamieni on &5Lightning Rod&r w &5Rod o' Lightning&r! \\n\\nTa laska zadaje 5 &4obrażeń&r i zachowuje 15% Cast Time Reduction. Ale teraz daje tylko 5% &3Spell Power&r oraz 15% &3Spell Power&f dla &5czarów Lightning&r."]
	quest.0F8B349EBC9110D6.title: "&5Rod o' Lightning"
	quest.12498F8B5740F66E.quest_desc: ["&bWizard Gear&r to domyślna zbroja w &lIron's Spells&r! \\n\\nKażda inna zbroja jest wytwarzana z niej albo z czegoś, co z niej wytworzono! \\n\\nDo jej wytworzenia potrzebne są tylko &5Arcane Cloths&r. \\n\\nDaje ogromny przyrost maksymalnej many, tyle samo punktów zbroi co &bzbroja diamentowa&r oraz premię do Spell Power!"]
	quest.12498F8B5740F66E.title: "&bEkwipunek Czarodzieja"
	quest.1338EED4F26F3EFF.quest_desc: ["&3Spellbreaker&r to droga i potężna broń, który możemy wytworzyć. \\n\\nDo jego wykonania potrzebujemy &bWeapon Parts&r, &bdiamentów&f oraz 2 &bMithril Ingots&r. \\n\\n&3Spellbreaker&r zadaje 10 &4serc obrażeń&r i jest nieco szybszy od miecza. \\n\\nMa w sobie także &3czar&r &3Counterspell&r. Gdy mob używa przeciwko Tobie &3czaru&r, użyj tego, aby mu to uniemożliwić!"]
	quest.1338EED4F26F3EFF.title: "&3Spellbreaker"
	quest.13F77C38AC015E9F.quest_desc: [
		"Wysoko ponad górami, wysoko ponad chmurami stoi kolejna &bWieża&r. Ta przyprawia o dreszcze. \\n\\n&bWieża&r zbudowana jest ze Stone, Dark Oak i Deepslate. Odchodzi od niej druga wieża. Na zewnątrz prowadzą schody na pierwsze piętro. Stamtąd można wspiąć się wewnętrznymi schodami do sypialni lub drugiej wieży. \\n\\nAlbo można zejść za tymi schodami po drabinie do piwnicy, gdzie najprawdopodobniej znajdziesz &b&lCryomancera&r. \\n\\nW &bWieży&r znajdziesz Inscription Tables, Amethyst i skrzynie z łupami!"
		"{image:atm:textures/questpics/iron_spells/spells_mountaintower.png width:200 height:100 align:center}"
	]
	quest.13F77C38AC015E9F.title: "&bMountain Tower"
	quest.161477ABCC437BD2.quest_desc: ["&bBoreal Blade&r to fajny miecz! Zarówno pod względem charakteru, jak i temperatury. \\n\\nWytwarza się go z &bWeapon Parts&r, &bIce&r, &bMithril Ingots&r i &bIce Venom Vials&r. \\n\\nSprawdź zadanie &b&lIce Spider&r, aby zdobyć &bIce Venom&r! \\n\\nTen miecz zadaje mnóstwo obrażeń! 16 &4serc&r. Jest jednak wolny w zamachu, tak jak siekiera. \\n\\n&3Czar&r dołączony do &bBoreal Blade&r to &bFrostbite&r. To kolejny efekt... nie wiem, co robi."]
	quest.161477ABCC437BD2.title: "&bBoreal Blade"
	quest.19542103E042BDB5.quest_desc: ["{image:atm:textures/questpics/iron_spells/spells_outfit_shadow.png width:60 height:100 align:center}"]
	quest.19542103E042BDB5.title: "&dShadow-Walker Outfit"
	quest.19B057DFF331E41C.quest_desc: ["&4Scarecrow Outfit&r jest nieco lepszy od &9Wandering Magician&r, z trzykrotnie większą ilością many i większą liczbą punktów zbroi. \\n\\nTen wymaga jednak więcej przedmiotów do wytworzenia. \\n\\nPotrzebuje teraz &5Arcane Cloth&r zamiast &5Essence&r, a także &eHay Bales&r i &6Pumpkins&r."]
	quest.19B057DFF331E41C.title: "&4Scarecrow Outfit"
	quest.1A0368CB49B8CBFF.quest_desc: ["Ta &eSpell Book&r to rzadki łup z &cPłomyków&r. Pamiętam to, bo byłem zdziwiony, gdy dostałem jedną z mojej farmy &cPłomyków&r. \\n\\nDaje premię do &cczarów Fire&r i ma 10 miejsc na &3czary&r."]
	quest.1A0368CB49B8CBFF.quest_subtitle: "Gorąco! Gorąco! Gorąco!"
	quest.1A0368CB49B8CBFF.title: "&cBlaze Instruction Manual"
	quest.1BE69992D2C5085B.quest_desc: ["&n&aEvocation:&r\\nWzywanie ducha lub bóstwa. \\n\\n&a&lEvokation&r dotyczy tego, co robią &aPrzywoływacze&r, czyli głównie przyzywania. Czy to &aFangs&r, czy &aVexes&r, jeśli zostało przyzwane, to najpewniej jest to &aEvokation&r. \\n\\nFocus Material szkoły &a&lEvokation&r to &aszmaragdy&r. Runę możesz wytworzyć lub zdobyć od &a&lArchevokera&r. \\n\\nZwoje &aEvokation&r są &fbiałe&r z &0czarnym&r tekstem."]
	quest.1BE69992D2C5085B.title: "&a&lEvocation"
	quest.1CAEC4C273EDDB99.quest_desc: ["Jest tu! Jest tam! Jest wszędzie, i jest zgniła! Znajdziesz je w większości skrzyń. \\n\\nMieszczą 8 &3czarów&r, ale dają mniej Spell Resistance."]
	quest.1CAEC4C273EDDB99.title: "Rotten Spell Book"
	quest.204B969DA081056A.quest_desc: [
		"Mogą pojawiać się prawie wszędzie tam, gdzie pojawiają się wrogie moby z &2Vanilli&r. To nie bossowie, tylko kolejni wrogowie! \\n\\nMają 25 punktów &czdrowia&r i kilka ataków: &aFangs&r z ziemi, takie jak u &aEvokers&r, oraz &bSnowball&r, którą mogą w Ciebie rzucić. \\n\\nPotrafią też przyzywać zombie i szkielety do walki z Tobą. Te nic nie upuszczają i pojawiają się ze zbroją z ziemi. \\n\\nPo śmierci upuszczają Arcane Essence, a czasem także &3zwój&r!"
		"{image:atm:textures/questpics/iron_spells/spells_necromancer.png width:100 height:200 align:center}"
	]
	quest.204B969DA081056A.title: "Necromancers"
	quest.24150DE600C2D761.quest_desc: ["Ta jedna sama przenosi nas z kategorii E10 do Teen. &4&lBlood&r polega na zabijaniu wrogów dla własnego &czdrowia&r! Większość ataków Cię uleczy. \\n\\nFocus Material szkoły &4&lBlood&r to &4Blood Vials&r, które zdobywasz, gotując moba lub gracza w kotle. \\n\\nJej &4zwoje&r są brązowe (nie ma kodu koloru dla brązowego) z &4ciemnoczerwonym&r tekstem."]
	quest.24150DE600C2D761.title: "&4&lBlood"
	quest.24BAC1C0392E950E.quest_desc: [
		"Słyszałem, że teraz można po prostu ukończyć kursy online, żeby nim zostać."
		"{image:atm:textures/questpics/iron_spells/spells_outfit_priest.png width:60 height:100 align:center}"
	]
	quest.24BAC1C0392E950E.title: "&6Priest Outfit"
	quest.258B4890CF13D199.quest_desc: ["&aMagehunter&r to bardzo dziwna broń do zdobycia. Dziwna w tym sensie, że sposób jej zdobycia jest bardzo konkretny. \\n\\nAby ją zdobyć, musisz udać się do &aEvoker Fort&r, gdzie &aVindicator&r na 2. piętrze ją ma. Zabij go, aby ją zdobyć. \\n\\n&aMiecz&r jest dobry i zadaje 10 &4serc obrażeń&r przy normalnej prędkości miecza. \\n\\nTrzymając go, dostajesz odrobinę &3Spell Resistance&r. Co więcej, niektóre egzemplarze mogą mieć zaklęcia, mój miał!"]
	quest.258B4890CF13D199.title: "&aMagehunter"
	quest.25F79B40579B3909.quest_desc: ["&5Decrepit Flamberge&r to miecz z wyboru dla &5Ancient Knights&r i niektórych &5Cursed Armor Stands&r. \\n\\nTo właśnie od nich możemy go zdobyć, zabijając ich! \\n\\nWygląda jak &5Netherite Sword&r, tylko jakby się wiercił podczas wytwarzania. \\n\\nZadaje 11 &4serc obrażeń&r, ale jest nieco wolniejszy od miecza. \\n\\nMożna go ulepszyć za pomocą &6Pyrium&r, aby zwiększyć Attack Speed."]
	quest.25F79B40579B3909.title: "&5Decrepit Flamberge"
	quest.2664373E8977E7BE.quest_desc: ["Któż zna &4Blood&r tak jak wampiry! Nikt, oto kto! \\n\\nTa &eSpellbook&r nie jest trudna do wykonania, poza Ruined Book. \\n\\nPozostałe przedmioty to tylko &5Arcane Ingots&r i &4Bloody Vellum&r. &4Bloody Vellum&r powstaje przez zanurzenie &dHogskin&r w Alchemist Cauldron pełnym &4krwi&r. \\n\\n&eSpellbook&r ma 10 miejsc na czary i daje dodatkowy poziom &4Blood Slash&r oraz &4Blood Step&r!"]
	quest.2664373E8977E7BE.title: "&4Vampiric Spellbook"
	quest.27CF1A2587321A2C.quest_desc: ["Najlepsza &eSpell Book&r, jaką można sobie wyobrazić! 15 miejsc na &3czary&r! Czy w ogóle istnieje 15 &3czarów&r?!?! Aha, no tak, istnieje, 15 to wcale nie tak dużo... \\n\\nZrób to samo co wcześniej: poprzednia księga, sztabka i szablon."]
	quest.27CF1A2587321A2C.title: "&5Unobtainium&r Spell Book"
	quest.294418130521FDF4.quest_desc: ["&bMithril&r to ruda, która pojawia się tylko bardzo głęboko pod &2&lOverworldem&r. \\n\\nWystępuje na poziomach Y od około -40 aż do &8Bedrock&r. Mniej więcej tam, gdzie są &cjeziora lawy&r! \\n\\nDo jej wydobycia potrzebujesz &5Netherite Pickaxe&r, a wypadnie z niej tylko 1 &bRaw Mithril&r, chyba że użyjesz Fortune. \\n\\nTen &bRaw Mithril&r można przetopić na &bMithril Scraps&r. Można ich używać w recepturach albo połączyć 4 z nich w &bMithril Ingot&r!"]
	quest.294418130521FDF4.title: "Zdobywanie &bMithrilu"
	quest.29605960803BE885.quest_desc: ["&dAmethyst Rapier&r jest dość tania jak na to, co potrafi! \\n\\nTo tylko &bWeapon Parts&f, &dAmethyst&r i łańcuchy. \\n\\n&dAmethyst Rapier&r zadaje 8 &4serc obrażeń&r, tyle samo co &5Netherite Sword&r. Tylko że ta zadaje je znacznie szybciej, z Attack Speed 2,3. \\n\\nSpecjalną cechą &dAmethyst Rapier&r jest wbudowany czar! &dEchoing Strike&r. \\n\\nNaciskając (V) podczas trzymania &dRapiera&r, otrzymasz &dEfekt Echoing Strike&r. Każdy mob trafiony &dRapierem&r wyemituje falę uderzeniową, która zrani inne pobliskie moby."]
	quest.29605960803BE885.title: "&dAmethyst Rapier"
	quest.29BDCF3C1B11B4C6.quest_desc: ["&6Pyrium Staff&r to najpotężniejsza laska... no, pod względem &4obrażeń&r, nie mocy. \\n\\nPotrzebuje 2 &6Pyrium Ingots&r, &5Netherite Ingot&r i &5Arcane Cloth&r. \\n\\n&5Netherite Ingots&f i &5Arcane Cloths&r są łatwe, &6Pyrium&r... niekoniecznie. Musisz otworzyć 2 Vaults w &cCitadel&r. \\n\\n&6Pyrium Staff&r daje 5% &3Spell Power&r i 15% dla &cczarów Fire&r. A także 10% krótszy czas rzucania!"]
	quest.29BDCF3C1B11B4C6.title: "&6Pyrium Staff"
	quest.2A787B99A8B0C767.quest_desc: [
		"Bardzo ważny i bardzo powszechny blok! Można go wytworzyć lub znaleźć w większości struktur &lIron Spells&r. \\n\\nSłuży do dodawania i usuwania &3zwojów&r z &eSpell Books&r! Wrzuć &eSpell Book&r do miejsca na księgę, a potem &3zwój&r pod nią. Aby usunąć &3zwój&r, kliknij go, a następnie weź go z prawej strony do ekwipunku."
		"{image:atm:textures/questpics/iron_spells/spells_table_gui.png width:150 height:100 align:center}"
	]
	quest.2B901ECF97FFA181.quest_desc: ["Gdy w końcu połączysz Ancient Knowledge Fragments, otrzymasz... &9Eldritch Manuscript&r! Oto ostatnia klasa! \\n\\n&9Eldritch&r to ostatnia klasa, najpotężniejsza ze wszystkich &3czarów&r. Wytwarza się je za pomocą &9Echo Shards&r, a aby ich używać, trzeba się ich nauczyć z &9Manuscript&r. Każdy &9Manuscript&r jest jednorazowy."]
	quest.2B901ECF97FFA181.quest_subtitle: "9. klasa"
	quest.2B901ECF97FFA181.title: "&9&lEldritch"
	quest.2BB910B217DF3A12.quest_subtitle: "Dlaczego jest mokry? Był w jeziorze?"
	quest.2BB910B217DF3A12.title: "&dEnder&r Upgrade Orb"
	quest.2D84DA544D7A24FA.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.2E6F1C8718EB8C66.title: "&4Blood&r Upgrade Orb"
	quest.3009018DEC1EC952.quest_desc: ["W &2Overworld&r jest 6 struktur, w których mogą pojawić się bossowie! (Jest też 7., ale bez bossa)."]
	quest.3009018DEC1EC952.title: "&lCzas na Przygodę!"
	quest.300F2E45D185A9A1.quest_desc: ["&lIron&r przygotował dla nas wspaniały i bardzo zabawny mod magiczny! &lIron's Spells 'N Spellbooks!&r \\n\\n&lIron's Spells&r polega na tworzeniu i używaniu &3czarów&r! Każdy &3czar&r ma rzadkość, poziom i klasę! A każdego z nich można użyć w księdze czarów. \\n\\nNie będziesz mógł po prostu zrobić czego chcesz za pomocą &7żelaza&r i &credstone&r, musisz ruszyć tyłek, wyruszyć na przygodę i walczyć!"]
	quest.300F2E45D185A9A1.title: "&lIron's Spells 'N Spellbooks"
	quest.30B7AF815D9D7553.quest_desc: [
		"&cBurned Tower&r należąca do &c&lPyromancera&r. Niektórzy mówią, że jeśli jesteś dość blisko, by zobaczyć &cWieżę&r, to jesteś dość blisko, by poczuć jej żar. \\n\\n&cPyromancer Tower&r to spalona wieża zbudowana głównie z rodzajów kamienia, a w środku ze świerku i dębu. Obok &cWieży&r stoi też drugi budynek, który również należy do struktury. \\n\\nNa szczycie znajdziesz to, co powoduje dym, a także &5Armor Pile&r. \\n\\nJeśli chcesz znaleźć &c&lPyromancera&r, musisz zejść do piwnicy!"
		"{image:atm:textures/questpics/iron_spells/spells_pyromancertower.png width:200 height:100 align:center}"
	]
	quest.30B7AF815D9D7553.title: "&cPyromancer Tower"
	quest.3181D07337DEFD14.quest_desc: [
		"Jeśli obudzisz &4&lThe Dead King&r, gdy masz efekt Bad Omen lub Trial Omen, &4&lKról&r staje się silniejszy.\\n\\nTeraz ma 1000 &cserc&r, zadaje więcej obrażeń, porusza się i lata szybciej, jego przywołańcy zadają dodatkowe obrażenia, a on sam ma więcej pancerza. Potrafi teraz przywoływać &4Undead Rifts&r, które przyzywają &4Undead&r do walki za niego, a także używać czaru &aFang Swirl&r.\\n\\nŁup za jego pokonanie również jest lepszy. Oprócz zwykłego łupu może teraz upuścić Wicked Bone Ring, zwój &aFang Swirl&r, Tincture of Forgetfulness, &7Blank Runes&r i jeszcze więcej &bArcane Essence&r."
		"{image:atm:textures/questpics/iron_spells/spells_king_ominous.png width:100 height:200 align:center}"
	]
	quest.3181D07337DEFD14.quest_subtitle: "On znowu?"
	quest.3181D07337DEFD14.title: "&lThe Ominous Dead King"
	quest.32D2CE292E088939.title: "&cFire&r Upgrade Orb"
	quest.34FC02F47F52887F.quest_desc: ["Ta &eSpellbook&r na pewno sprawi, że zapracujesz na 12 &3miejsc na czary&r! \\n\\nPotrzebujesz &bIce Venom Vials&r, które powstają z &bIcy Fangs&r lub można je zdobyć w &bIce Spider Den&r. \\n\\n&5Arcane Cloths&r, które są bardzo łatwe do wykonania. A także &bMithril Scraps&r, po które musisz się wybrać do kopalni! \\n\\nSądząc po tym, jak zimna jest ta &eSpellbook&r, chyba pomaga w &bczarach Ice&r."]
	quest.34FC02F47F52887F.title: "&bFrostbanded Spellbook"
	quest.36B283532D70776A.quest_desc: ["&aBoots of Speed&r to najlepsze buty, jakie możesz tu zdobyć. \\n\\nNajpierw potrzebujemy &aArchevokers Boots&r. Jeśli nie lubisz rzeczy po kimś, polecam wytworzyć je samemu. \\n\\nPotem potrzebujemy &bMithril Weave&r. To połączenie &bMithril Ingots&r i łańcuchów. Używa się ich tylko do wytwarzania zbroi, więc wystarczy ich kilka. \\n\\nOstatnim składnikiem jest &dDivine Soulshard&r. \\n\\nTe &aButy&r dają więcej many niż jakiekolwiek inne, więcej &3Spell Power&r, a w dodatku sprawiają, że jesteś szybszy? Jak to robią? Zwiększają prędkość poruszania się i &3rzucania czarów&r!"]
	quest.36B283532D70776A.title: "&aBoots of Speed"
	quest.36F87173D8CD1D68.quest_desc: ["Ujeżdżaj &5Lightning&r! &5&lLightning&r polega na używaniu elektryczności do zabijania i wspierania siebie. Niektóre ataki działają nawet jak prawdziwy &5piorun&r! \\n\\nFocus Material szkoły &5&lLightning&r to &5Bottle 'O Lightning&r, które zdobywasz, używając pustej butelki na naładowanym Creeperze. Potrzebujesz &5Lightning&r, żeby zdobyć więcej &5Lightning&r! \\n\\nJej &5zwoje&r są &7szare&r z &bjasnoniebieskim&r tekstem."]
	quest.36F87173D8CD1D68.title: "&5&lLightning"
	quest.373EBEB2E96D9361.quest_desc: ["Podczas eksploracji zaśnieżonych biomów możesz natrafić na coś, co wygląda na zrujnowany kościół. \\n\\nTyle że to, co w środku, nie jest &6Holy&r! \\n\\nZejdź do piwnicy, do Catacombs. Znajdziesz tam mnóstwo Stray Spawners, pułapek z Powder Snow i łupów! \\n\\nA także &bIce Spider Eggs&r... spróbuj je zniszczyć, a zaalarmujesz..."]
	quest.373EBEB2E96D9361.title: "&bIce Spider Den"
	quest.395A33977B18B9AD.quest_desc: [
		"Po próbie zebrania &5Piles of Armor&r wydają się ożywać, jakby ktoś w nich był. Mogą też pojawiać się ze spawnerów. \\n\\nMają 60 &4serc&r i różnią się od innych bossów tym, że nie używają magii, tylko, jak sądzę, są czymś stworzonym z magii. Atakują mieczem, zamachując się nim albo szarżując z nim na Ciebie. \\n\\nZ tego, co widziałem, atakują wszystko, co zobaczą, poza innymi &5&lKnights&r! \\n\\nPo zabiciu wypuszczają Netherite Scraps i &cCinder Essence&r. Rzadko upuszczają swoją &5broń&r, a te w &cCitadel&r upuszczają Decrepit Keys."
		"{image:atm:textures/questpics/iron_spells/spells_knight.png width:100 height:150 align:center}"
	]
	quest.395A33977B18B9AD.title: "&5&lAncient Knight"
	quest.3A85110725E81CDF.quest_desc: ["Jeśli grałeś już w &2&lMinecrafta&r, powinieneś wiedzieć, czym jest zbroja i do czego służy! \\n\\n&lIron's Spells&r dodaje własne rodzaje zbroi. \\n\\nDziałają jak zwykłe zbroje, ale każda daje inne premie do Twoich magicznych mocy. Na przykład wyższy &3Spell Power&r, więcej many, a nawet premie żywiołów."]
	quest.3A85110725E81CDF.title: "&lZbroja"
	quest.3DCD38634176BD92.quest_desc: ["Połącz &eSpell Book&r z &6Allthemodium&r ze sztabką Vibranium i szablonem w Smithing Table.\\n\\nTen szablon można zdobyć, szczotkując Suspicious Soul Sand w bastionie."]
	quest.3DCD38634176BD92.title: "&3Vibranium&r Spell Book"
	quest.3E8077AB45C79E6A.quest_desc: [
		"Zdecydowanie lepszy od zwykłego kotła z Minecrafta! \\n\\nAlchemist Cauldron potrafi: \\n1. Dawać &4Blood&r przez gotowanie mobów lub gracza. \\n2. Tworzyć i ulepszać mikstury. \\n3. Z połowiczną szansą wydobyć Ink ze zwoju. \\n4. Łączyć 4 Ink danej rzadkości w jeden wyższej rzadkości. "
		"{image:atm:textures/questpics/iron_spells/spells_cauldron.png width:100 height:100 align:center}"
	]
	quest.401BB95B740385B7.title: "&6Holy&r Upgrade Orb"
	quest.4104ABDC0E577350.title: "&2Nature&r Upgrade Orb"
	quest.420CB9502DF8E1BC.quest_desc: ["&b&lIce Spider&r. \\n\\nTo wróg z 50 &4sercami&r i 20 punktami zbroi. \\n\\nJeśli podejdziesz blisko, ugryzie Cię albo uderzy jednym ze swoich licznych odnóży! \\nJeśli będziesz dalej, wystrzeli jakiś &blodowy kokon&r? Chyba? Cokolwiek to jest, rani Cię i &bzamraża&r w miejscu. Może też posłać w Twoją stronę z ziemi linię &blodowych skał&r, by Cię zranić. \\n\\nPo śmierci upuszcza String, &5Arcane Essence&r, a czasem &bIcy Fang&r."]
	quest.420CB9502DF8E1BC.title: "&b&lIce Spider"
	quest.4407BD7B5F033765.quest_desc: ["Kolejna możliwa do wytworzenia &eSpell Book&r, a zgodnie z wzorcem ta jest jeszcze droższa. Wymaga Arcane Clothes, Gold i Enchanted Book. Nie jest wybredna co do książki, ważne tylko, by była zaklęta! \\n\\nMa 10 miejsc na &3czary&r i daje ogromną premię do many!"]
	quest.4407BD7B5F033765.title: "Enchanted Spell Book"
	quest.445C21949ADA1FE3.quest_desc: ["Połącz Ancient Codex ze sztabką &6Allthemodium&r i szablonem w Smithing Table.\\n\\nSzablon możesz zdobyć, szczotkując Suspicious Clay w &9Ancient City&r."]
	quest.445C21949ADA1FE3.title: "&6Allthemodium&r Spell Book"
	quest.44E8D5DAD7E22724.quest_desc: ["Co ciekawe, to niewiele ulepsza. \\n\\n&3Spell Power&r pozostaje bez zmian, mana też, nawet punkty zbroi się nie zmieniają. Jedyną zmianą jest dodanie Armor Toughness. \\n\\nTo ma sens, w końcu to tylko &5ulepszenie do Netherite&r dla &bWizard Gear&r!"]
	quest.44E8D5DAD7E22724.title: "&cNetherite Battlemage Armor"
	quest.4567A27C53A01903.quest_desc: [
		"&c&lEcho of Tyros&r to pierwszy prawdziwy boss, jakiego dostajemy od &lIron's&r! \\n\\nMa 1000 &4serc&r i 16 punktów zbroi. A także zdolność przyzywania &5Ancient Knights&r do walki u jego boku! \\n\\nJak możesz się domyślić po jego tytule &c&lFirst Flamebearer&r, do ataku używa &cmagii ognia&r. \\n\\nMoże zamachnąć się &ckosą&r, by Cię trafić, lub uderzyć w ziemię, uwalniając falę &cognia&r we wszystkich kierunkach. \\n\\nKilka kolejnych ataków wykorzystuje &cogniste miecze&r: może rzucić w Ciebie całą serię albo przyzwać ich dziesiątki wyłaniających się z ziemi, by Cię zranić. \\n\\nOstatnie ataki to &ckule ognia&r, które rzuca w Ciebie, stojąc w miejscu albo skacząc wysoko w powietrze! \\n\\nGdy zadasz mu jedną czwartą &4zdrowia&r, uklęknie. To wtedy możesz uderzyć go najmocniej! Ale gdy zejdzie do 300 &4serc&r, ulepszy swoją broń i zbroję. Ulepszy nawet swoich &5Ancient Knights&r! \\n\\nJeśli jakimś cudem go zabijesz, upuści swoją &ckosę&r i &dDivine Soulshard&r. Oraz esencje, ale kogo one obchodzą, mamy &ckosę&r!"
		"{image:atm:textures/questpics/iron_spells/spells_echo.png width:125 height:100 align:center}"
	]
	quest.4567A27C53A01903.title: "&c&lEcho of Tyros, First Flamebearer"
	quest.489833A2A6C39151.quest_desc: [
		"Był podły, możesz to ukraść, nie obchodzi mnie to."
		"{image:atm:textures/questpics/iron_spells/spells_outfit_cryomancer.png width:60 height:100 align:center}"
	]
	quest.489833A2A6C39151.title: "&bCryomancer Outfit"
	quest.48C68664319B0294.quest_desc: ["Aby zdobyć tę specjalną księgę czarów, musisz zabić &4&lDead King&r! \\n\\nMa 10 miejsc na &3czary&r, ale 4 są już zajęte. &4Blood Slash&r, &4Blood Step&r, &4Ray of Siphoning&r i &4Blaze Storm&r są w niej od początku i nie da się ich usunąć."]
	quest.48C68664319B0294.title: "Necronomicom"
	quest.4CCA1E2AAA9AB9D9.quest_desc: [
		"Kiedy to trafi do moda?"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_electromancer.png width:50 height:100 align:center}"
	]
	quest.4CCA1E2AAA9AB9D9.title: "&5Electromancer Outfit"
	quest.4E3355FDCB65BB63.quest_desc: ["&aPrzywoływacze&r są znani jako potężny i zabójczy miniboss Minecrafta. Więc oczywiście &lIron&r dodał jeszcze potężniejszą i zabójczą wersję! I tak, ta &eksięga&r to rzadki łup z obu! \\n\\nMa 10 miejsc na czary, ale 3 są zajęte. &aFang Strike&r, &aFang Ward&r i &aVex Swarm&r dołączone są do &eksięgi&r i nie można ich przenieść. \\n\\nDaje także premię do &a&lEvocation&r!"]
	quest.4E3355FDCB65BB63.title: "&aGrimore of Evokation"
	quest.541446863A72B96C.title: "&7Common&r Ink"
	quest.548F85EE6B6F1811.quest_desc: [
		"Tak samo jak Piglin, do którego jest podobny, &2&lApotheocarist&r jest neutralny. W przeciwieństwie do innych Piglins nie obchodzi go &eGold&r, tylko ci, którzy go atakują. \\n\\nMożesz z nim handlować: dając mu Emeralds lub Potion Ingredients w zamian za mikstury, Potion Ingredients i &2zwoje Nature&r. \\n\\nJeśli chcesz go zabić, ma 60 serc. Będzie atakował Cię za pomocą mikstur i &2czarów Nature&r. Gdy zostanie ranny, spróbuje się uleczyć za pomocą mikstur (chyba naprawdę lubi mikstury). \\n\\nPo zabiciu upuszcza Arcane Essence, Ink, &2Nature Runes&r i &2zwoje Nature&r!"
		"{image:atm:textures/questpics/iron_spells/spells_apotheocarist.png width:100 height:200 align:center}"
	]
	quest.548F85EE6B6F1811.title: "&2&lApothecarist"
	quest.551A4916F032ACCF.quest_desc: [
		"Arcane Anvil ma najwięcej zastosowań spośród wszystkich bloków w &lIron Spells&r. \\n\\nMożesz łączyć &3czary&r z tym samym Ink, aby podnieść ich poziom. \\nMoże łączyć &3zwoje&r z bronią, aby można było ich z nim używać, na przykład z mieczem. \\nMożesz też ustawić Affinity pierścieniom za pomocą Upgrade Orbs albo dodawać Upgrade Orbs do broni i ekwipunku."
		"{image:atm:textures/questpics/iron_spells/spells_anvil_gui.png width:100 height:100 align:center}"
	]
	quest.555ED1E39131D91B.quest_desc: [
		"Nie powinieneś był wchodzić do &bWieży&r, &b&lCryomancer&r nie lubi graczy, jest wobec Ciebie wrogi. \\n\\n&b&lCryomancer&r od razu zacznie Cię atakować &bczarami Ice&r. Może nawet użyć przeciwko Tobie zwierząt! Poświęcać zwierzęta, żeby wygrać walkę, naprawdę ma zimne serce! \\n\\nPo zabiciu upuszcza Arcane Essence, Ink, &bIce Runes&r i &bzwoje Ice&r."
		"{image:atm:textures/questpics/iron_spells/spells_cryomancer.png width:100 height:200 align:center}"
	]
	quest.555ED1E39131D91B.title: "&b&lCryomancer"
	quest.59E68086A8B99EA7.quest_desc: [
		"&c&lPyromancer&r (nie mylić z Pie Romancerem) to kolejny neutralny mob dodany przez &lIron's Spells&r. Być może podpali moby, które są blisko niego, na &cogień&r... \\n\\nMożesz handlować z nim wszystkim, co związane z &cogniem&r, a także Ink i &czwojami Fire&r. \\n\\nJeśli chcesz zaryzykować wszystkie włosy na ciele i z nim walczyć, bądź przygotowany, ma 60 serc. Podpali Cię &cogniem&r za pomocą &cczarów Fire&r, bez dwóch zdań. \\n\\nPo śmierci upuszcza Arcane Essence, Ink, &cFire Runes&r i &cczary Fire&r!"
		"{image:atm:textures/questpics/iron_spells/spells_pyromancer.png width:100 height:200 align:center}"
	]
	quest.59E68086A8B99EA7.title: "&c&lPyromancer"
	quest.5B013A3A37D6902B.quest_desc: ["Fragmenty Ancient Knowledge znajdziesz rozsiane w skrzyniach w &9Ancient City&r. \\n\\nPotrzebujesz też &9Echo Shards&r, aby 1. połączyć fragmenty i poznać &9czary&r oraz 2. faktycznie wytworzyć &9czary&r."]
	quest.5B013A3A37D6902B.title: "Do Ancient City"
	quest.5DE863C3FB6492BE.quest_desc: [
		"DOŁĄCZ DO NAS!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_cultist.png width:60 height:100 align:center}"
	]
	quest.5DE863C3FB6492BE.title: "&4Cultist Outfit"
	quest.5ED368C926E5F32C.quest_desc: ["Jest jeszcze ostatnia klasa &3czarów&r, o której zapomniałem wspomnieć. Cóż, cała wiedza o tych &9czarach&r została zapomniana, więc to nie tylko moja wina. \\n\\nAby odzyskać wspomnienia, musimy cicho przejść aleją wspomnień, która akurat jest &9Ancient City&r."]
	quest.5ED368C926E5F32C.title: "Ostatnia Klasa..."
	quest.6046CA1F6AFE2AEA.quest_desc: ["&4The Blood Staff&r to łup z &4&lThe Dead King&r. Pewnie dlatego, że dosłownie jest jego laską! \\n\\nTa laska zadaje 8 &4obrażeń&r, więcej niż poprzednie. \\n\\nDaje 5% &3Spell Power&r do wszystkich &3czarów&r i 15% tylko do &4czarów Blood&r oraz 10% Summon Power."]
	quest.6046CA1F6AFE2AEA.title: "&4The Blood Staff"
	quest.60FAD8BF235E381B.title: "&bRare&r Ink"
	quest.615C3E012B2DECD3.quest_desc: ["&eSpellbooks&r! Gdzie indziej trzymałbyś &3czary&r? \\n\\nMożesz dodawać &3zwoje&r do &eSpellbooka&r, wkładając oba do Inscription Table. Mieści się w nich określona ilość, ale nie trzeba już martwić się o rzadkość. \\n\\nGdy &3zwoje&r zostaną dodane do Twojego &eSpellbooka&r, nie zostaną zużyte, zużywana będzie za to mana."]
	quest.615C3E012B2DECD3.title: "&eKsięgi Czarów&r!"
	quest.6187837A51BA09DC.quest_desc: ["&cCitadel&r to największa struktura, jaką daje nam &lIron's Spells&r. Jest zbudowana prawie w całości z &0Blackstone&r. \\n\\nMa ogromne mury i wieże otaczające główny budynek i połączone z nim. Znajdują się tam spawnery &5Ancient Knight&r i beczki z łupami. \\n\\nW głównym budynku na pierwszym piętrze jest biblioteka/pokój badań. Ma miliardy książek, a także skrzynie i więcej &5Ancient Knights&r! \\n\\nPiętro wyżej znajdują się Citadel Vaults oraz &5Cursed Armor Stands&r. Uważaj, próbując zabrać ich łup, mogą bronić swojej własności! \\n\\nNa najwyższym piętrze jest arena..."]
	quest.6187837A51BA09DC.title: "&cCitadel"
	quest.637C87D8968CD51A.title: "&aUncommon&r Ink"
	quest.639531AB27DCD267.quest_desc: ["&7Runy&r służą do tworzenia naszych klas i ich elementów. Aby zdobyć &7Blank Rune&r, możesz zabić &4&lDead King&r albo wyczyścić Inscribed Rune za pomocą Shriving Stone. \\n\\nIstnieje 8 różnych klas (1 sekretna), a każda ma własne &3zwoje&r, Focus Material, ulepszenia i stroje. "]
	quest.639531AB27DCD267.title: "&lKlasy"
	quest.641888DC7BC40AA9.quest_desc: [
		"Silnie strzeżona &aFortress&r jest domem &a&lArchevokera&r i jego pobratymców. \\nRozpoznasz ją po ogromnych murach ze świerku i gigantycznej &aFortress&r z kamienia w ich wnętrzu. \\n\\nWewnątrz murów i &aFortress&r można spotkać Illagers, Vindicators, &aEvokers&r i Ravagers. Gdy ich pokonasz, możesz wejść po schodach, przebiec parkourem na dach i spotkać &a&lLeader of the Fort&r na szczycie. \\n\\nSkoro jest tak silnie strzeżona, oczywiście w &aFort&r jest mnóstwo łupów."
		"{image:atm:textures/questpics/iron_spells/spells_evokerfort.png width:200 height:100 align:center}"
	]
	quest.641888DC7BC40AA9.title: "&aEvoker Fort"
	quest.652A14E17DDE97E6.quest_desc: ["Kolejna, do której wytworzenia potrzebna jest Ruined Book. Ruined Books znajdziesz w skrzyniach z &9Ancient City&r. \\n\\nPotrzebujesz też Dragon Skin, która wypada z &dEnder Dragona&r! \\n\\nBędzie miała 12 miejsc na &3czary&r i da premię do &dczarów Ender&r!"]
	quest.652A14E17DDE97E6.title: "&dDragonskin Spell Book"
	quest.660D8AD3EE975340.quest_desc: ["&bWeapon Parts&r będą potrzebne do wytworzenia kilku rodzajów broni. \\n\\nI tak, je również musimy wytworzyć. \\n\\nSą dość proste, tylko 3 &bMithril Ingots&r i 2 &5Arcane Ingots&r. \\n\\n&5Arcane Ingots&r powstają z 1 &6Copper Ingot&r i 8 &5Arcane Essence&r."]
	quest.660D8AD3EE975340.title: "&bCzęści Broni"
	quest.66762A4743104157.quest_desc: ["Kolejna &eSpellbook&r do wytworzenia, ta jest nieco droższa! Potrzebuje Hogskin, które wypada z Hoglinów. \\n\\nMieści 8 &3czarów&r, co technicznie nadal jest niewiele, ale lepiej!"]
	quest.66762A4743104157.title: "Apprentice's Spell Book"
	quest.67308C5DDF4A10D2.quest_desc: ["&9Wandering Magician Armor&r to najsłabsze, co może zaoferować &lIron's Spells&r. \\n\\nTo dosłownie ulepszenie &7Leather Armor&r! Kto w ogóle robi &7Leather Armor&r?!?!?! \\n\\nWystarczy wrzucić &7Leather Armor&r z &5Arcane Essence&r do stołu rzemieślniczego, aby ją wytworzyć. \\n\\nDzięki temu każda część da więcej punktów zbroi oraz niewielką premię do many!"]
	quest.67308C5DDF4A10D2.title: "&9Wandering Magician Outfit"
	quest.67439337E29A308B.quest_desc: ["&eArtificer's Cane&r jest droższa niż &7Graybeard Staff&r i dlatego jest potężniejsza. \\n\\nZadaje teraz 4 &4obrażenia&r i daje 15% redukcji czasu odnowienia i czasu rzucania oraz 10% &3Spell Power&r. \\n\\nPowiedziałem tylko, że jest lepsza, nie że dużo lepsza!"]
	quest.67439337E29A308B.title: "&eArtificer's Cane"
	quest.67A587F4BAD76C70.quest_desc: ["Najprostsza &eSpellbook&r, co czyni ją też najtańszą! \\n\\nMoże pomieścić łącznie tylko 5 &3czarów&r."]
	quest.67A587F4BAD76C70.title: "Flimsy Journal"
	quest.67D40A1A9332C03D.title: "&6Legendary&r Ink"
	quest.68B44B9E939F4228.quest_desc: [
		"Na szczycie &aFort&r mieszka &a&lArchevoker&r. Jest wrogi tylko wobec gracza i każdego, kto go atakuje. \\n\\nMa 60 serc i atakuje jak zwykły &aEvoker&r, a nawet więcej! &aFireworks&r, &aShield&r i &aBlast of Wind&r! \\n\\nPo zabiciu upuszcza Arcane Essence, Ink, &aEvokation Runes&r, &aEvokation Scrolls&r, a rzadko także &aGrimore of Evokation&r!"
		"{image:atm:textures/questpics/iron_spells/spells_evoker.png width:100 height:200 align:center}"
	]
	quest.68B44B9E939F4228.title: "&a&lArchevoker"
	quest.6963EC8A71D66AE3.quest_desc: [
		"Głęboko w błotnistych Mangrove Swamps znajduje się schronienie pustelniczego moba zwanego &2&lApotheocarist&r. \\n\\nNikogo w pobliżu i tylko to, czego potrzebuje do swoich mikstur. \\n\\n&2&lApotheocarist&r znajdziesz w jego &2Hut&r. \\n\\nZnajdziesz tam też kotły i statywy alchemiczne z miksturami!"
		"{image:atm:textures/questpics/iron_spells/spells_magrovehut.png width:200 height:100 align:center}"
	]
	quest.6963EC8A71D66AE3.title: "&2Mangrove Hut"
	quest.69763C2E2F454A73.quest_desc: ["&c&lFire&r oczywiście dotyczy &cognia&r. Większość zwojów polega na używaniu &cognia&r do palenia i ranienia. \\n\\nFocus Material szkoły &c&lFire&r to &cBlaze Rods&r. Możesz wytworzyć &cFire Runes&r albo zdobyć je, zabijając &c&lPyromancera&r. \\n\\nJej &czwoje&r są &cjasnoczerwone&r z &8szarym&r tekstem."]
	quest.69763C2E2F454A73.title: "&c&lFire"
	quest.69838E3F12218D68.quest_desc: [
		"Scroll Forge, możesz się domyślić, co robi! \\n\\nTworzy &3zwoje&r! \\n\\nDodaj Ink, aby ustawić rzadkość. Paper na sam &3zwój&r. Potem przedmiot odpowiadający rodzajowi &3czaru&r, jaki chcesz (&cBlaze Rod&r dla &c&lFire&r, &2Poisonous Potato&r dla &2&lNature&r, ITP.). Na koniec wybierz &3czar&r, który chcesz, a zostanie stworzony!"
		"{image:atm:textures/questpics/iron_spells/spells_scroll_gui.png width:150 height:100 align:center}"
	]
	quest.6CE7115DA2B23776.quest_desc: ["Niewiele lepsza od Flimsy... \\n\\nMoże pomieścić jeden &3czar&r więcej niż Flimsy Journal! To jeden bardzo potężny &3czar&r więcej w pogotowiu!"]
	quest.6CE7115DA2B23776.title: "Ironbound Journal"
	quest.6D232F6D8E8DA546.quest_desc: [
		"Bardzo popularny w okolicach Halloween!"
		"{image:atm:textures/questpics/iron_spells/spells_outfit_plagued.png width:60 height:100 align:center}"
	]
	quest.6D232F6D8E8DA546.title: "&2Plagued Outfit"
	quest.6DB5732177AABB87.quest_desc: [
		"Największa i najtrudniejsza struktura z &lIron's Spells&r. \\n\\nTo głęboko podziemna struktura podobna do Trial Chambers. Możesz też użyć Wayward Compasses, żeby ją znaleźć! \\n\\nZnajdziesz w niej mnóstwo Spawners, Trial Spawners i oczywiście łupów. \\n\\nNajważniejszym pomieszczeniem jest Throne Room; gdy tam dotrzesz, szkielet &4&lDead King&r ożyje! (Jeśli nie, być może trzeba go kliknąć)."
		"{image:atm:textures/questpics/iron_spells/spells_catacombs.png width:200 height:100 align:center}"
	]
	quest.6DB5732177AABB87.title: "&4Catacombs"
	quest.6F5F1C525CF08F96.quest_desc: ["Laski i... przedmioty podobne do lasek to broń, która daje magiczne premie, gdy się je trzyma! \\n\\nA do tego są stylowe!"]
	quest.6F5F1C525CF08F96.title: "Kostury, Różdżki i Laski"
	quest.71F0E9C36AA02B46.quest_desc: ["Ta arena wydaje się dość pusta... o, czekaj, co to takiego! \\n\\n&cCinderous Soul Rune&r. Wygląda prawie jak dziurka od klucza, tylko że Decrepit Keys do nich nie pasują. \\n\\nUwierz mi, nie pasują. \\n\\nZamiast tego potrzebujemy &cCinderous Soulcaller&r! Wytwarza się go z &cCinder Essence&r, &5Netherite Scraps&r i &9Echo Shard&r. \\n\\n&5Netherite Scraps&r pochodzą z &5Ancient Debris&r, &9Echo Shards&r z &9Ancient Cities&r, a &cCinder Essence&r upuszczają &5Ancient Knights&r!"]
	quest.71F0E9C36AA02B46.title: "&cCinderous Soulcaller"
	quest.7270A37E31A70C91.quest_desc: ["&6&lHoly&r jest dla wszystkich graczy medyków/wsparcia. Służy głównie do leczenia i pomagania. \\n\\nFocus Material szkoły &6&lHoly&r to &6Divine Pearls&r, które się wytwarza. Możesz z nich robić runy albo zabić &6&lPriesta&r, aby zdobyć &6Holy Runes&r. \\n\\n&6Zwoje Holy&r są &fbiałe&r ze &6złotym&r tekstem."]
	quest.7270A37E31A70C91.title: "&6&lHoly"
	quest.72AB70FD8D8FABBF.quest_subtitle: "&cThe Nether&r!"
	quest.72AB70FD8D8FABBF.title: "Na Autostradzie do..."
	quest.73D6B980D35082A0.quest_desc: ["To wymaga dłuższego wyjaśnienia, więc uzbrój się w cierpliwość. \\n\\nNajpierw znajdź &aEvoker Fort&r. \\nNastępnie znajdź ukrytą w nim Research Book. Potem poproś handlarza, który jest zakładnikiem w &aFort&r, o jej przetłumaczenie. (Jak nasi zakładnicy, tłumacze zadań!) \\nGdy zostanie przetłumaczona, zanieś ją do &6&lPriesta&r w &6wiosce&r i wymień na &eSpell Book&r! \\n\\nDaje premię do &6czarów Holy&r, a nie martw się, zakładnicy handlarze są bardzo, bardzo rzadcy, szukaj dalej!"]
	quest.73D6B980D35082A0.title: "&6Villager Bible"
	quest.7408CCF998D9CD37.quest_desc: ["&eSpell Book&r, którą można wytworzyć... tak, niełatwo ją wytworzyć. \\n\\nNajtrudniejsza do zdobycia będzie Ruined Book, którą znajdziesz w skrzyniach z &9Ancient City&r. &4Blood Vials&r można zdobyć, wkładając moba (a nawet siebie) do kotła nad Campfire albo do Alchemical Cauldron. &5Bottle O' Lightning&r powstaje przez użycie butelki na naładowanym Creeperze. \\n\\nGdy zrobisz to wszystko, możesz wytworzyć Ancient Codex. Jego 12 miejsc na &3czary&r jest bardzo pomocne!"]
	quest.7408CCF998D9CD37.title: "Ancient Codex"
	quest.76558D23A70AFF78.title: "&bIce&r Upgrade Orb"
	quest.78AA7BFABBFB9973.quest_desc: ["&eSpell Book&r szkoły &2&lNature&r. \\n\\nMa 10 &3czarów&r i daje premię do &2czarów Nature&r! \\n\\nDo jej wytworzenia potrzebujesz jednak Rotten Spell Book..."]
	quest.78AA7BFABBFB9973.title: "&2Druidic Tome"
	quest.794D6F9B8DB31E7D.quest_desc: ["&bIce Staff&r zbijał mnie z tropu przez dłuższy czas, ale na szczęście już wiem! \\n\\nPotrzebujesz &bPermafrost Shard&r i &bFrosted Helve&r. &bPermafrost Shard&r to łup w strukturze Ice Breaker. To wraki statków w lodowych biomach. \\n\\n&bFrosted Helve&r to wytwarzany przedmiot. Wymaga &5Arcane Ingots &fi&b Frozen Bones&r. Te drugie wypadają z &bStrays&r. \\n\\n&bIce Staff&r zadaje 5 &4obrażeń&r i daje 25% regeneracji many. Daje 5% &3Spell Power&r do wszystkich &3czarów&r i 15% tylko do &bczarów Ice&r."]
	quest.794D6F9B8DB31E7D.title: "&bIce Staff"
	quest.79EC8A49368421BF.quest_desc: ["&6Pyrium&r to pewny łup z Vaults w &cCitadels&r... \\n\\nTyle że te Vaults nie przyjmują zwykłych Trial Keys. Wow, jakby jeden klucz nie mógł otwierać każdego zamka! \\n\\nPotrzebujemy Decrepit Key, który wypada z &5Ancient Knights&r w &cCitadel&r. Pojawiają się w wieżach i na niższym poziomie biblioteki."]
	quest.79EC8A49368421BF.title: "&6Pyrium"
	quest.7C79BCE482A06199.quest_desc: ["&b&lIce&r dotyczy zimowych czarów. Używają &blodu&r i &bśniegu&r, by chłodzić i ranić wrogów. \\n\\nFocus Material szkoły &b&lIce&r to &bFrozen Bone&r, które wypadają z &bStrays&r. Możesz z nich wytworzyć &bIce Rune&r albo zabić &b&lCryomancera&r, aby ją zdobyć. \\n\\nJej &bzwoje&r są &bjasnoniebieskie&r z &9ciemniejszym niebieskim&r tekstem."]
	quest.7C79BCE482A06199.title: "&b&lIce"
	quest.7F85669FEA41CD97.quest_desc: [
		"Neutralny obrońca &6wioski&r. Atakuje wszystkie pobliskie wrogie moby. Jak Iron Golem, ale z jakiegoś powodu wygląda znajomo? Czy to może ktoś, kogo znamy, w przebraniu? \\n\\nMożesz handlować z nim, dając mikstury leczenia i Emeralds, w zamian za Furled Map, która wkrótce będzie pomagać przeciw &aEvoker Forts&r! \\n\\nJeśli chcesz go zabić, będzie wielokrotnie atakował Cię &6czarami Holy&r. Uleczy się też, gdy będzie miał mało zdrowia. \\n\\nPo zabiciu upuszcza Arcane Essence, Ink, &6Holy Runes&r i &6zwoje Holy&r."
		"{image:atm:textures/questpics/iron_spells/spells_priest.png width:100 height:200 align:center}"
	]
	quest.7F85669FEA41CD97.title: "&6&lPriest"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&5Ancient Battlegrounds&r to tylko fragment przeszłości. \\n\\nKto wie, co się stało. \\n\\nKto wie, kto z kim walczył. Wszystko, co nam zostało, to fragmenty murów i te &5Piles of Armor&r. Równie dobrze możesz je po prostu zebrać, wydobywając je kilofem."
		"{image:atm:textures/questpics/iron_spells/spells_battleground.png width:200 height:100 align:center}"
	]
	quest.7FC54AF87CBDD222.title: "&5Ancient Battleground"
	task.00C6A5CB44392D7E.title: "AllRightsReserved"
	task.1CC0E97BB8DC4F35.title: "Zabij 5 Necromancers"
	task.6D7DD99A02A8F451.title: "Odwiedź The Deep Dark"
	task.76B722B1AE7B6CF2.title: "AllRightsReserved"
}
