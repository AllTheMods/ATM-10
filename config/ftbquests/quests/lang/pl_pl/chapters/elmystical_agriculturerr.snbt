	quest.1CC4F8570A7A99EB.quest_desc: ["&dEssence&r to punkt wyjścia dla wszystkich Twoich potrzeb uprawowych w Mystical Agriculture.\\n\\n&eInferium Essence&r to podstawowy poziom wszystkich esencji. Możesz ją zdobyć, kopiąc, zabijając moby albo uprawiając nasiona! \\n\\nBy wytworzyć większe i lepsze esencje, musisz stworzyć &9Infusion Crystal&r. "]
	quest.1CC4F8570A7A99EB.quest_subtitle: "Poziom: &e1"
	quest.1CC4F8570A7A99EB.title: "&aInferium"
	quest.1CF8263756EE8F2A.quest_desc: ["Ten wyjątkowy &ePył&r wypada z Wither i Ender Dragon, gdy zostaną zabici przez &dEssence Weapon&r zaklętą &dMystical Enlightenment&r."]
	quest.1CF8263756EE8F2A.title: "&5Cognizant Dust&r"
	quest.1E0F92F07FDD162E.quest_desc: ["Do tworzenia upraw surowcowych będziesz potrzebować &bProsperity Seed Bases&r."]
	quest.1E0F92F07FDD162E.quest_subtitle: "Liczy się tylko (Seed) Base"
