{
	quest.088CA7B6D4899846.quest_desc: ["&#65C2A6Packer&r służy do tworzenia &#53E67BDouble Ingots&r, &#53E67BBlades&r i &#53E67BCables&r. Oprócz tego ta maszyna ma wiele innych zastosowań, ale to będą jej główne."]
	quest.0DAF5D42694EA8C9.quest_desc: [
		"&#6E6D6D&nForge Hammer&r jest początkiem Twojej podróży. Ma wiele zastosowań: od uzyskiwania &#B53A3Alepszej wydajności&r z rud po wytwarzanie &#DBD25Aczęści&r do przyszłych receptur."
		""
		"&7Hammer&r, który wytworzyłeś, nie jest wymagany w recepturze, ale da Ci lepszy rezultat przy &#DBD25Aczęściach&r, które wytwarzasz."
	]
	quest.0DAF5D42694EA8C9.title: "&#949494Forge Hammer"
	quest.1036837C9AD3F301.quest_desc: ["&#6E6D6DForge Hammer&r pozwoli Ci łatwo kruszyć sztabki lub rudy &#FFAC3Bmiedzi&r na jej pyły."]
	quest.12F9705ACB8FB300.quest_desc: [
		"&#EDD653&nCutting Machine&r pozwala wykonać wiele receptur. Najważniejsze z nich to Bolts. "
		""
		"&#EDD653&nCutting machine&r działa z &#E3993DLubricant&r, który uzyskuje się za pomocą &#EDD653&nMixer&r."
	]
	quest.12FB3990CA1653A4.quest_desc: [
		"&#DBA15ASteam Drill&r będzie Twoim najlepszym przyjacielem w wydobyciu na początku gry. Potrafi kopać obszar &53 na 3&r, a także ma &#EEF768przełączalny Silk Touch&r."
		""
		"Kopanie &53 na 3&r możesz przełączać skrótem klawiszowym \"Toggle 3x3 Mining\", który domyślnie jest ustawiony na &7'Y'&r."
		""
		"&#EEF768Silk Touch&r można przełączać, klikając Steam Drill &7prawym przyciskiem myszy podczas skradania&r"
		""
		"Aby napełnić &#DBA15ASteam Drill&r, możesz przytrzymać wiertło nad &6paliwem&r w ekwipunku i kliknąć &7prawym przyciskiem myszy&r. &9Wodę&r możesz nabrać, klikając &7prawym przyciskiem myszy&r w świecie, albo nosić ze sobą wiadro wody."
	]
	quest.1C9D3FC67D58AC02.quest_desc: ["&#EDD653&nMixer&r pozwala łączyć przedmioty i płyny. Można w nim barwić przedmioty, a nawet je powielać."]
	quest.1E4E462928F2A71C.quest_desc: [
		"&7&nCoke Oven&r służy do przetwarzania &#787777Coal&r w &#696464Coke&r. &#696464Coke&r jest 4 razy skuteczniejszym paliwem niż &#787777Coal&r. "
		""
		"Podgląd multibloku zobaczysz, trzymając &#D1D15EWrench&r w drugiej lub głównej ręce. Trzymanie &#B4D95DHatches&r w ręce pokaże Ci możliwe pozycje dla nich."
		""
		"&7&nCoke Oven&r jest pustym w środku multiblokiem zbudowanym głównie z cegieł."
	]
	quest.21A4FE1741E4E78C.quest_desc: [
		"&#65C2A6Quarry&r to multiblok generujący zasoby. Do działania wymaga &aDrills&r i &7Steam&r."
		""
		"Każda iteracja ma szansę zużyć &aDrill&r. Lepsze &aDrills&r dają lepsze zasoby."
		""
		"Steam Quarry może używać tylko &#DEA14BCopper&r i &#DE9531Bronze Drills&r. Może też użyć &#8A5C1EDirt&r do generowania Stone."
	]
	quest.21A4FE1741E4E78C.quest_subtitle: "Nieskończone zasoby"
	quest.23708582B1064C9D.quest_desc: ["&#46DBBBCircuit&r będzie wymagać niektórych z tych podstawowych komponentów do działania, a zautomatyzowanie ich produkcji przyda się w przyszłości."]
	quest.23708582B1064C9D.title: "Pojemność i Rezystancja"
	quest.24285F25F9563B02.quest_desc: ["&#467FDB&nAnalog Circuit&r, ach! W końcu go zrobiłeś. Zwykle inni potrzebowali o połowę mniej czasu niż Ty, ale nie będę Ci tego wypominać..."]
	quest.24285F25F9563B02.quest_subtitle: "Podstawy elektroniki"
	quest.253822C64BBBB1EB.quest_desc: ["&#6E6D6DForge Hammer&r pozwoli Ci łatwo kruszyć sztabki lub rudy &#9AD5EDcyny&r na jej pyły."]
	quest.357DDE894EB512F7.quest_desc: ["&#65C2A6Wiremill&r potrafi użyć dokładnie takiej siły, by zrobić dla Ciebie &#53E67BWires&r. Porażające!! Wiem..."]
	quest.3AA4D1B60E4E71A5.quest_desc: ["Wszystkie &cmultibloki&r są określane przez umieszczone w nich &ehatches&r. Ulepszenie tych &ehatches&r w &cmultiblokach&r ulepszy całą maszynę."]
	quest.41877F44CD3D1EDB.quest_desc: ["&#E3BC19Bronze Furnace&r działa tak jak zwykły piec, a jedyna większa różnica to zasilanie Steam i dwa razy większa szybkość."]
	quest.458BFDB636F8B495.quest_desc: ["Połączenie Coke dust z Iron da Uncooked Steel Dust. Wypalenie go w Steam Blast Furnace da Ci Steel Ingots, które są potrzebne do dalszego postępu."]
	quest.478C1AF86610A8B7.quest_desc: ["&#EDD653&nCompressor&r służy do tworzenia &#53EDAAPlates&r, &#53EDAACurved Plates&r i &#53EDAARings&r."]
	quest.48F77A0BE1F33B29.quest_desc: ["Dzięki nowo zbudowanemu &#65C2A6Wiremill&r możesz teraz wytwarzać &#53E67BWires&r i &#53E67BFine Wires&r, które poprowadzą Cię ku elektryce."]
	quest.48F77A0BE1F33B29.title: "Straszny Drut"
	quest.4E69C6ABFE467C25.quest_desc: ["&#65C2A6Alloy Smelter&r pochodzi z &#3187C4Extended Industrialization&r. Łączy zadania &#4C4BDEMixer&r i &#954BDEpieca&r w jedno, dzięki czemu praca jest mniej żmudna."]
	quest.55C6BBC996B51838.quest_desc: [
		"&#ED9553Bronze Boiler&r zamienia &9wodę&r w Steam. Steam jest paliwem dla Twoich maszyn w &7&nErze Pary&r."
		""
		"Aby go użyć, wystarczy dostarczyć mu &9wodę&r i dowolne &#ED5353paliwo do pieca&r. Podniesie to temperaturę maszyny, a przy maksymalnej temperaturze będzie mógł obsługiwać jednocześnie 4 maszyny."
	]
	quest.55C6BBC996B51838.quest_subtitle: "Gotowanie wody"
	quest.589DFDB8FB7211AA.quest_desc: ["Produkcja &7Rubber&r potrzebnego do przejścia do &#C1DB46&nEry Elektryczności&r jest banalna. Zautomatyzowanie jej jak najwcześniej zaprowadzi Cię dalej, niż myślisz."]
	quest.589DFDB8FB7211AA.title: "Rubber i Circuit Board"
	quest.5CCF92238B23EDC9.quest_desc: [
		"&#A0DE45&nModern Industrialization&r to mod podobny w swej naturze do &#D93D3DIC2&r i &#D93D3DGregTech&r, ale postępować w nim trzeba inaczej niż w tych 2 modach."
		""
		"W tych zadaniach poprowadzę Cię przez tworzenie części potrzebnych do &#E8C843AllTheMods Star&r, a później do &#43E898Infinity Armor&r."
	]
	quest.5CCF92238B23EDC9.quest_subtitle: "Czytanie pomoże"
	quest.5CCF92238B23EDC9.title: "&#A0DE45Witaj w Modern Industrialization"
	quest.5E191081662C2F1A.quest_desc: ["&#6E6D6DForge Hammer&r pełni rolę bloku stanowiska pracy dla Villagera &#A0DE45Modern Industrialization&r. Ten Villager zaoferuje Ci szeroki wybór przydatnych wymian."]
	quest.68EAB0248989FC97.quest_desc: [
		"&#EDD653&nSteam Blast Furnace&r otwiera nowe horyzonty postępu. To będzie kluczowy multiblok w Twoich przyszłych przedsięwzięciach."
		""
		"Ten multiblok pozwala nie tylko tworzyć &7Steel Ingots&r, ale także przetwarzać &#696E60Raw Synthetic Oil&r na &#494D43Synthetic Oil&r, który będzie później używany do &#36472ARubber&r i innych rzeczy."
	]
	quest.7282DCB1547CEB63.quest_desc: ["&#ED9553Bronze&r będzie podstawą &7&nEry Pary&r. Wypalenie tego pyłu da Ci &#ED9553Bronze Ingots&r, których będziesz używać dalej."]
	quest.7282DCB1547CEB63.title: "&#EDD653Bronze"
	quest.780D66E609F0695F.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.7A873E48E38B5C0E.quest_desc: ["Steel Machines zużywają dwa razy więcej Steam niż Bronze Machines, ale nadrabiają to dwukrotnie większą prędkością."]
	quest.7D220876E8FF7AED.quest_desc: [
		"&#65C2A6Unpacker&r ma wiele zastosowań: od rozpakowywania &#53E67Bbloków na Ingots&r i nie tylko, po &#53E67Brecykling części&r maszyn."
		""
		"&oMożesz nawet łatwiej zdobywać z niego Silicon Ingots.&r"
	]
	task.198A217D6A4C951C.title: "Oferty Villagerów"
	task.31BE41B971794377.title: "Era Stali"
	task.45C5CAC94406DF41.title: "Poziomy Multibloków"
}
