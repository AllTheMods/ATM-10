{
	quest.02593CD4B4AE814C.quest_desc: [
		"&bSalt&r jest ważny przy inkubacji &eAlchemical Sulfurs&r! \\n\\nAby zdobyć &bSalt&r, musisz upiec jakieś przedmioty. Różne przedmioty dają jednak różne &bSalts&r. &bSalts&r mają różne poziomy - im rzadszy przedmiot, tym wyższy poziom. \\n\\nAby wypiec &bSalt&r, włóż przedmioty do Oven i użyj źródła ciepła, by je podgrzać. Potem wyjmij &bSalt&r z Oven!"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "Odsalarnia"
	quest.0460DDEEFDEB0AAF.quest_desc: ["Divination Rods to narzędzia, którymi kontaktujesz się z duchami, by znaleźć określone przedmioty. \\n\\nNajpierw musisz wybrać blok lub przedmiot - kliknij go Rodem prawym przyciskiem myszy z Shiftem albo wytwórz Rod z jego &eAlchemical Sulfur&r!\\n\\nGdy trzymasz Rod i przytrzymujesz prawy przycisk myszy, będzie szukał wybranego przedmiotu. Wyda dźwięk, a Rod będzie świecił tym mocniej, im bliżej jest blok lub przedmiot. \\n\\nJeśli jesteś wystarczająco blisko, może pojawić się kula wskazująca drogę do przedmiotu."]
	quest.0460DDEEFDEB0AAF.title: "Divination Rods"
	quest.0542FE108089A0A2.quest_desc: ["&l&6Theurgy&r to sztuka używania magii do alchemii! A w naszym przypadku - używania maszyn i przedmiotów, by tworzyć więcej lub inne przedmioty! \\n\\nWiele maszyn potrzebnych w &l&6Theurgy&r wymaga miedzi, więc zacznij od niej!"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"Podobnie jak termometr, ten przedmiot przechowuje &cMercury&r! \\n\\nNiezależnie od tego, czy to &cMercury Crystals&r, czy &cShards&r, przechowuje &cMercury&r."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "&cMercury&r Vessel"
	quest.0830195863384CF0.quest_desc: ["&bStrata&r to pierwszy i najprostszy rodzaj, wytwarzany ze zwykłych bloków, takich jak Stone, Sand czy Obsidian. \\n\\nMożesz użyć 5 &bStrata Salt&r, aby wytworzyć &bMineral Salt&r."]
	quest.0830195863384CF0.title: "&bStrata Salt"
	quest.0854AD352218E1C3.quest_desc: ["Nie denerwuje Cię, gdy masz całą tę energię, ale brakuje Ci ciepła? \\n\\nTeraz możesz to zmienić dzięki Caloric Flux Emitter! Kliknij nim prawym przyciskiem myszy z Shiftem, aby powiązać go z maszyną. Następnie postaw go i zasil, aby przesyłał ciepło. \\n\\nNie można go powiązać z wieloma maszynami!"]
	quest.0854AD352218E1C3.quest_subtitle: "Jak?"
	quest.0854AD352218E1C3.title: "Bezprzewodowe Ciepło"
	quest.0EADCEA9AB001FC7.quest_desc: [
		"Bardzo proste źródło ciepła. Postaw pod maszyną i dokładaj paliwo do pieca: Coal, Logs, Dried Kelp Blocks."
		"{image:atm:textures/questpics/theurgy/theurgy_brazier.png width:100 height:100 align:center}"
	]
	quest.0EADCEA9AB001FC7.title: "Ciepło jak z Pieca"
	quest.0F7BB4ECCA5C082C.quest_desc: [
		"Tutaj umieścisz &eAlchemical Sulfur&r. \\n\\nPrzedmiot zawarty w &eAlchemical Sulfur&r zostanie dzięki inkubacji z powrotem zamieniony w ten przedmiot!"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_3.png width:100 height:125 align:center}"
	]
	quest.0F7BB4ECCA5C082C.title: "&eSulfur&r Vessel"
	quest.161E7D934A21F849.quest_desc: [
		"Reformation to zamiana jednego &eAlchemical Sulfur&r w inny albo użycie &3Alchemical Niter&r, by uzyskać ich więcej! \\n\\nPierwszym krokiem jest Source Pedestal - tu umieszczasz &eSulfur&r, który chcesz zamienić w inny."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_1.png width:100 height:100 align:center}"
	]
	quest.161E7D934A21F849.title: "Krok 1: Source Pedestal"
	quest.16B88F46021E956D.quest_desc: ["&l&6Theurgy&r ma maszyny, więc oczywiście potrzebuje logistyki!\\n\\n(Zajrzyj na stronę Basic Logistics, aby dowiedzieć się więcej o logistyce).\\n\\nDzięki &cMercury&r możesz przenosić przedmioty i płyny z miejsca na miejsce za pomocą &cMercury Wires&r i innych przedmiotów! To właśnie przewody faktycznie przenoszą przedmioty."]
	quest.16B88F46021E956D.title: "Logistyka z &cMercury&r"
	quest.19A2016B54C6FA34.quest_desc: ["Niektóre maszyny w &l&6Theurgy&r potrzebują ciepła, by zacząć pracę! &l&6Theurgy&r jest jednak bardzo zazdrosne o to, skąd jego maszyny biorą ciepło - jako źródeł ciepła możesz używać tylko tych dwóch maszyn. \\n\\n(Maszyny wykorzystujące ciepło to: Liquefaction Cauldron, Calcination Oven, &cMercury&r Distiller i Incubator)."]
	quest.19A2016B54C6FA34.quest_subtitle: "Ale z Ciebie Gorący Typ!"
	quest.19A2016B54C6FA34.title: "Ale z Ciebie Gorący Typ!"
	quest.1A46A97A00A31C03.quest_desc: [
		"Drugim krokiem jest Target Pedestal. Tu umieszczasz &eSulfur&r, w który ma zostać zamieniony pierwszy. \\n\\nAlbo tu umieszczasz &3Alchemical Niter&r."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_2.png width:100 height:100 align:center}"
	]
	quest.1A46A97A00A31C03.title: "Krok 2: Target Pedestal"
	quest.1C829609915E0012.quest_desc: [
		"Wkładasz &cMercury&r, \\nwyjmujesz energię. \\n\\nMF oznacza &cMercury&r Flux, a nie Metal Face ani wulgarne określenie, którym nazywa się ludzi!"
		"{image:atm:textures/questpics/theurgy/theurgy_mercuryflux.png width:100 height:100 align:center}"
	]
	quest.1C829609915E0012.title: "Produkcja Energii z &cMercury"
	quest.20C3AADEE2D4800D.quest_desc: [
		"Za pomocą &cMercury&r możesz też przenosić płyny z jednego zbiornika do drugiego. \\n\\nPodłącz Fluid Extractor tam, skąd płyn ma być pobierany, np. do zlewu. Następnie podłącz Fluid Inserter tam, dokąd płyn ma trafić, np. do &dSal Ammoniac&r Accumulator. Połącz oba przewodami i płyn powinien płynąć!"
		"{image:atm:textures/questpics/theurgy/theurgy_fluid.png width:200 height:75 align:center}"
	]
	quest.20C3AADEE2D4800D.title: "Przenoszenie Płynów"
	quest.26B462F2F41A77C7.quest_desc: ["Wszystkie dary Matki Natury... można bezlitośnie spalić w Oven, aż zostanie z nich tylko &bSalt&r! \\n\\nKłody, liście i uprawy można upiec na &bPlant Salts&r."]
	quest.26B462F2F41A77C7.title: "&bPlant Salt"
	quest.285B3FB38B12F8CA.quest_desc: [
		"Potrzebujesz tych dwóch bloków, aby wytworzyć &dSal Ammoniac&r (miałem ochotę nazwać to multiblokiem, ale 2 bloków nie uważam za multiblok). &dSal Ammoniac&r Tank na dole i &dSal Ammoniac Accumulator&r nad nim. \\n\\nW &dSal Ammoniac Accumulator&r trafiają &9woda&r i &dCrystals&r; może pomieścić 10 000 mb &9wody&r, czyli 10 wiader, oraz stos &dSal Ammoniac Crystals&r. Tank przechowuje wytworzony &dSal Ammoniac&r i mieści 2000 mb, czyli 2 wiadra."
		"{image:atm:textures/questpics/theurgy/theurgy_sal_front.png width:100 height:200 align:center}"
	]
	quest.285B3FB38B12F8CA.title: "Wytwarzanie &dSal Ammoniac"
	quest.2B29E9AB9447E1C6.quest_desc: [
		"To jest już prawdziwa maszyna multiblokowa! \\n\\nAby odzyskać przedmioty z &eAlchemical Sulfur&r, musisz je poddać inkubacji. Wymaga to Incubator, do którego przylegają wszystkie 3 Vessels. Kolejność nie ma znaczenia, o ile stykają się z dolną połową. \\n\\nGdy będzie miał wszystkie przedmioty w Vessels i ciepło, rozpocznie inkubację Twoich przedmiotów! Poznasz, że działa, gdy wydobędą się z niego cząsteczki dymu."
		"{image:atm:textures/questpics/theurgy/theurgy_incubator.png width:200 height:200 align:center}"
	]
	quest.2F0D6267569F740B.quest_desc: ["Common Materials są o stopień wyżej i rzadsze niż Abundant. To głównie sztabki i rzadsze przedmioty wypadające z mobów, jak Ender Pearls czy Rabbit Hide. \\n\\nPonownie pełną listę zobaczysz w tagach."]
	quest.36926B5EBFF6E55A.quest_desc: [
		"&cMercury&r to jeden z najważniejszych materiałów w &l&6Theurgy&r! \\n\\nAby go zdobyć, musisz wydestylować trochę w &cMercury&r Distiller. Włóż przedmioty do Distiller i dostarcz mu ciepła! \\n\\nNiektóre przedmioty dają więcej &cMercury&r - np. Diamond da 10 &cMercury&r za 1 sztukę, natomiast Stone wymaga 10 sztuk na 1 &cMercury&r."
		"{image:atm:textures/questpics/theurgy/theurgy_distiller.png width:100 height:150 align:center}"
	]
	quest.36926B5EBFF6E55A.title: "Wytwarzanie &cMercury"
	quest.393DA9C9D808A851.quest_desc: ["Kluczem w &l&6Theurgy&r jest &cMercurial&r Wand. Możesz nacisnąć Shift i przewijać, aby zmieniać jego tryby. \\n\\nMożesz włączać/wyłączać, aby w praktyce zatrzymać przesyłanie przez przewody. \\n\\nMożesz zmienić stronę, z której przedmioty będą wyciągane lub do której będą wkładane. \\n\\nI możesz zmienić kanał częstotliwości!"]
	quest.393DA9C9D808A851.quest_subtitle: "Myślałem, że to Mod o Magii..."
	quest.393DA9C9D808A851.title: "Oczywiście, że Jest Klucz"
	quest.3B6F723B03C4BF55.quest_desc: ["Digestion (bardzo prymitywna forma przetwarzania) to sposób, w jaki zmieniamy &3Alchemical Niters&r w różne formy. \\n\\nNajpierw potrzebujesz Purified Gold, które wytworzysz, wkładając Gold, &bAlchemical Salt&r i &9wodę&r do Digestion Vat i klikając prawym przyciskiem myszy z Shiftem, by je zamknąć - tak jak Fermentation Vat. \\n\\nPotem możesz połączyć 4 sztuki jednego &3Alchemical Niter&r z Purified Gold i &dSal Ammoniac&r, aby uzyskać wyższy poziom, lub zrobić odwrotnie, by uzyskać niższy."]
	quest.3B6F723B03C4BF55.title: "Digestion Vat"
	quest.3C5734448FEC128B.quest_desc: ["Najtańsza Divination Rod, czyli Glass Divination Rod. \\n\\nMoże znaleźć wszystkie rudy, które da się wydobyć za pomocą Stone Pickaxe. Czyli Copper, Coal i Iron. Nic wyższego."]
	quest.3EB63AF53E70C931.quest_desc: [
		"Reformation wymaga Mercury Flux, by działać! Kliknij Sulfuric Flux Emitter z Shiftem prawym przyciskiem myszy wszystkie 3 Pedestals, by je ustawić. Następnie postaw Emitter i dostarcz mu energii.\\n\\nPo tym wszystko powinno być gotowe do Reformation!"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_setup.png width:200 height:50 align:center}"
	]
	quest.3EB63AF53E70C931.title: "Krok 4: Zasilanie"
	quest.41ABC09C798CA8BE.quest_desc: ["To zadanie zostało stworzone przez &6Ekipę AllTheMods&r lub &2współtwórcę społeczności&r na potrzeby paczek AllTheMods. \\n\\nPonieważ wszystkie paczki &6AllTheMods&r są objęte licencją &eAll Rights Reserved&r, to zadanie nie może być używane w żadnych publicznych paczkach niewydanych przez &6AllTheMods Team&r bez wyraźnej zgody. \\n\\nTo zadanie jest celowo ukryte - jeśli to widzisz, jesteś w trybie edycji."]
	quest.457CAE66B0FA4CCF.quest_desc: ["Wszystkie rudy z &2Vanilla&r można znaleźć za pomocą Diamond Divination Rod. Znajduje wszystkie, a także netheryt!"]
	quest.45996B848792379E.quest_desc: ["Możesz wydobywać &dSal Ammoniac Crystals&r w &2Overworldzie&r, ale to nie jest takie proste. I tak będziesz potrzebować &9wody&r i maszyn do wytwarzania &dSal Ammoniac&r, aby zrobić &eAlchemical Sulfur&r. \\n\\n&dCrystals&r są opcjonalne, ale bardzo pomagają; z samej wody 1000 mb zamieni się w 100 mb &dSal Ammoniac&r. Z 1000 mb &9wody&r i jednym &dSal Ammoniac Crystal&r uzyskasz natomiast 1000 mb &dSal Ammoniac&r. \\n\\nDziesięciokrotnie większa produkcja przy zaledwie jednym dodatkowym przedmiocie!"]
	quest.45996B848792379E.quest_subtitle: "Po Co Nam Maszyny, Skoro Można To Po Prostu Wykopać?"
	quest.45996B848792379E.title: "Po Co Maszyny?"
	quest.48EE6C807C1668D4.quest_desc: ["Jeśli potrzebujesz, aby przewody sięgały dalej lub łączyły się z większą liczbą miejsc, możesz potrzebować Connector Node. \\n\\nTak po prostu!"]
	quest.48EE6C807C1668D4.title: "Przewody Tu, Przewody Tam"
	quest.49D1B01E07ABA471.quest_desc: [
		"Za pomocą &cMercury&r możesz przenosić przedmioty. \\nPodłącz Item Extractor tam, skąd przedmioty mają być pobierane. Następnie podłącz Item Inserter tam, dokąd mają trafić. Połącz oba za pomocą &cMercury Wires&r i przedmioty powinny zacząć się przemieszczać! \\n\\nMożna tego używać z maszynami &l&6Theurgy&r do automatyzacji!"
		"{image:atm:textures/questpics/theurgy/theurgy_item.png width:200 height:75 align:center}"
	]
	quest.49D1B01E07ABA471.title: "Przenoszenie Przedmiotów"
	quest.4EE482B9D61B5933.quest_desc: ["Oczywiście &2Vanilla&r to nie nasz limit - w modach jest znacznie więcej i znacznie rzadszych rzeczy! "]
	quest.54F0C5C48CFC94D0.quest_desc: ["Przy logistyce potrzebne jest filtrowanie. Są dwa różne filtry: List i Attribute. \\nDo List Filter dodajesz przedmioty i zmieniasz, czy to biała, czy czarna lista, oraz czy uwzględnia dane NBT. \\n\\nAttribute Filter bierze przedmiot wzorcowy, a następnie filtruje po wybranym atrybucie. Obejmuje to tagi i inne rzeczy, np. czy można go użyć jako Furnace Fuel lub czy może być przesyłany ścieżkami (pathway)!"]
	quest.55E321EFBE8956DE.quest_desc: ["Jeśli chcesz oszczędzać na recepturach fermentacji, Fermentation Starter jest dla Ciebie idealny. \\n\\nBardzo tani zamiennik innych przedmiotów w fermentacji."]
	quest.55E321EFBE8956DE.title: "Łatwiejsza Fermentacja"
	quest.5844DD2BEE5EC3DC.quest_desc: ["Nie jedz tego! \\n\\n&cMercury&r można wykorzystać do 3 różnych rzeczy: inkubacji, wytwarzania energii i logistyki!"]
	quest.5844DD2BEE5EC3DC.quest_subtitle: "Wenus... nie, &cMercury&r!"
	quest.5844DD2BEE5EC3DC.title: "Mercury"
	quest.616364E6AE05C341.quest_desc: ["&bMineral Salts&r powstają z... no cóż, minerałów. \\n\\nWszystko, co wydobywa się w jakiejś formie rudy, można zamienić w &bSalt&r. Surowe rudy, sztabki, klejnoty - wszystko zamienia się w &bMineral Salt&r! \\n\\nNawet Unobtainium można zamienić w &bSalt&r! Tylko proszę, nie rób tego, jest tyle lepszych alternatyw."]
	quest.616364E6AE05C341.title: "&bMineral Salt"
	quest.61DA3D61D7103647.quest_desc: ["&eAlchemical Sulfurs&r można zrobić praktycznie ze wszystkiego i można z nich zrobić praktycznie wszystko! \\n\\nW &eAlchemical Sulfurs&r istnieje kilka różnych grup przedmiotów, które mogą zostać wyjaśnione dokładniej w innym zadaniu. \\n\\nIstnieją 3 różne ścieżki przetwarzania &eAlchemical Sulfurs&r. 1. Fermentacja i Digestion do wytwarzania Niter. 2. Inkubacja, by ponownie wytworzyć te przedmioty, oraz 3. Zmiana przedmiotu za pomocą Reformation."]
	quest.61DA3D61D7103647.title: "&eAlchemical Sulfurs"
	quest.6A8E748B642DD16F.quest_desc: [
		"Tutaj będzie przechowywany &bSalt&r. \\n\\nRodzaj &bSalt&r ma znaczenie dla tego, co próbujesz poddać inkubacji. Jeśli chcesz wytworzyć Unobtainium, potrzebujesz &bMineral Salt&r, jeśli Wheat - &bPlant Salt&r, i tak dalej."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_2.png width:100 height:125 align:center}"
	]
	quest.6A8E748B642DD16F.title: "&bSalt&r Vessel"
	quest.6C6F4EB5CBE2FBC2.quest_desc: ["Iron Divination Rod jest odrobinę wyżej - potrafi znaleźć rudy, które da się wydobyć za pomocą Iron Pickaxe! Czyli Diamonds, Redstone i Gold."]
	quest.6CAD27627A3F8FD7.quest_desc: [
		"Teraz wreszcie dochodzimy do sedna moda, czyli &eAlchemical Sulfurs&r! \\n\\nAby je wytworzyć, potrzebujesz Liquefaction Cauldron, przedmiotu, &dSal Ammoniac&r i źródła ciepła. \\n\\nCiepło wyjaśniono w innym zadaniu, ale potrzebujesz Pyromantic Brazier lub Caloric Flux Emitter pod Cauldron, aby go podgrzać. \\n\\nPotem wlej do niego płynny &dSal Ammoniac&r. \\n\\nI na końcu przedmiot, który chcesz zamienić w &eAlchemical Sulfur&r. \\n\\nPoznasz, że działa, gdy zacznie bulgotać."
		"{image:atm:textures/questpics/theurgy/theurgy_lique.png width:100 height:100 align:center}"
	]
	quest.6CAD27627A3F8FD7.title: "Wytwarzanie &eAlchemical Sulfur"
	quest.7119F8C352D057BC.quest_desc: ["Teraz dochodzimy do zabawnej części! Przedmioty o rzadkości Rare sięgają aż do Elytra! Tak, uważam, że to lepsze niż Rare, ale nie ja ustalałem ten podział."]
	quest.7198ED7E97A256A4.quest_desc: ["Pierwszą specjalnie wytwarzaną Divination Rod jest Abundant Material Rod! \\n\\nGdy wytworzysz Rod z &eAlchemical Sulfur&r jakiegoś przedmiotu, Rod zostanie dostrojony do tego przedmiotu. \\n\\nListę Abundant Materials zobaczysz w tagach - jest zbyt duża, bym odczytywał ją w zadaniach.  "]
	quest.72FADEAEE2DA03AF.quest_desc: [
		"Trzecim krokiem jest miejsce, do którego trafi nowo zmieniony &eSulfur&r - Result Pedestal. Po zakończeniu Reformation trafi właśnie tutaj."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "Krok 3: Result Pedestal"
	quest.730F2D3329C4FF88.quest_desc: ["&nFermentacja&r: \\nProces chemiczny, w którym cząsteczki, takie jak glukoza, są rozkładane beztlenowo. \\n\\nCzyli &9woda&r i czas zmieniają rzeczy! \\n\\nAby użyć Fermentation Vat, włóż przedmioty i płyn do Vat, a następnie kliknij prawym przyciskiem myszy z Shiftem, by go zamknąć. \\n\\nPo chwili powinno się sfermentować! W ten sposób zamieniamy &eAlchemical Sulfur&r w &3Alchemical Niter&r, z którego można uzyskać więcej przedmiotów!"]
	quest.730F2D3329C4FF88.title: "Fermentation Vat"
	quest.76F675A898EAB4E8.quest_desc: ["&dSal Ammoniac&r jest kluczową częścią &eAlchemical Sulfur&r, którego użyjesz do wytwarzania i powielania przedmiotów. \\n\\nAby zdobyć &dSal Ammoniac&r, potrzebujesz trochę &9wody&r. "]
	quest.76F675A898EAB4E8.title: "&dSal Ammoniac"
	quest.7878F190BC8ADC82.quest_desc: ["Najlepsza z najlepszych. Od Diamonds, przez Nether Star, po Allthemodium. Ta Rod znajduje tylko najlepsze przedmioty!"]
	quest.7A1C117CA8FB7C31.quest_desc: ["Ta jest wyjątkowa!\\n\\nZamiast rud znajduje bloki Budding Amethyst!\\n\\nKoniec z męczącym szukaniem geod, dobry człowieku!"]
	quest.7A271F425C3934CE.quest_desc: ["Obecnie można go wytworzyć tylko przez upieczenie 2 &bPlant Salts&r na 1 &bCreature Salt&r. \\n\\nMamy nadzieję, że w nowszych aktualizacjach będzie można zabijać więcej żywych stworzeń, by zdobyć &bSalt&r!"]
	quest.7A271F425C3934CE.title: "&bCreature Salt"
