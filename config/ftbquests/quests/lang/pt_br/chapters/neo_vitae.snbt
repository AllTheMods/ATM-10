{
	quest.02B5E57E9E803F78.quest_desc: [
		"A armadura Senciente funciona igual às ferramentas: a gente veste e ela aprende com o que quer que a gente enfrente."
		""
		"Linha de equipamento opcional, mas combina demais com o conjunto de armas sencientes."
	]
	quest.02B5E57E9E803F78.quest_subtitle: "Armadura com opiniões"
	quest.02B5E57E9E803F78.title: "A Casca Senciente"
	quest.02DF776F9A4C9CB1.quest_desc: [
		"Um &6Demônio Péstis&r ronda os corredores mais fundos. O portador da peste, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.02DF776F9A4C9CB1.quest_subtitle: "Um dos dez do reino"
	quest.02DF776F9A4C9CB1.title: "Demônio Péstis"
	quest.07C69759A6163F2D.quest_desc: [
		"A gente assenta pedras rituais elementais, ar, terra, fogo e deus, ao redor de uma &6Pedra de Ritual Mestra&r. O padrão que a gente desenha decide o efeito."
		""
		"Fabrique a pedra mestra e uma leva de cada elemento."
	]
	quest.07C69759A6163F2D.quest_subtitle: "O padrão faz o ritual"
	quest.07C69759A6163F2D.title: "Pedras e a Mestra"
	quest.09DEA44456CD5010.quest_desc: [
		"O ritual Tier II &6Romper a Borda do Reino Demoníaco&r corta o véu e deixa um &lPilar de Inversão&r para trás. Toca nele e a gente atravessa."
		""
		"Essa é a porta para a &6Antecâmara&r, o bolso tutorial do Reino Demoníaco."
	]
	quest.09DEA44456CD5010.quest_subtitle: "O Tier II faz o corte"
	quest.09DEA44456CD5010.title: "Rompendo o Véu"
	quest.0ACA535425EA6A81.quest_desc: [
		"Todo ritual pede um &6Cristal de Ativação&r para acender: Fraco para ritos de nível baixo, Desperto e Divino para os grandes feitos com pedras Deus."
		""
		"O cristal Fraco é barato e vem cedo. Os mais fortes são trabalho do reino. Opcional."
	]
	quest.0ACA535425EA6A81.quest_subtitle: "Chaves de ritual, basicamente"
	quest.0ACA535425EA6A81.title: "Cristais de Ativação"
	quest.0BA0AA8A6F07D383.quest_desc: [
		"A gente vai precisar de uma &6Ferramenta de Escriba Arcano&r da Tábula da Vida ou do altar. É ela que desenha de verdade os círculos dos arranjos de alquimia."
		""
		"Toca o chão com ela e vê as linhas se acenderem."
	]
	quest.0BA0AA8A6F07D383.quest_subtitle: "Giz de poder"
	quest.0BA0AA8A6F07D383.title: "A Ferramenta do Escriba"
	quest.0E3971A4FB822ED0.quest_desc: [
		"Altar erguido, orbes vinculados, aura pulsando, reino conquistado. A gente tem agora toda ferramenta que a Vitaemancia oferece."
		""
		"O capítulo termina aqui, mas o mod não. A rede, os rituais e a masmorra continuam pagando."
	]
	quest.0E3971A4FB822ED0.quest_subtitle: "O pináculo é um estilo de vida"
	quest.0E3971A4FB822ED0.title: "Mestre Vitaemante"
	quest.11721D2D8F03C20F.quest_desc: [
		"Uma &6Gema de Espírito Insignificante&r guarda 64 Espírito e devora partículas soltas jogadas perto dela."
		""
		"Os tiers seguintes (Inferior 256, Comum 1.024, Superior 4.096, Grande 16.384) são forjados um dentro do outro."
	]
	quest.11721D2D8F03C20F.quest_subtitle: "64 alminhas"
	quest.11721D2D8F03C20F.title: "A Gema Insignificante"
	quest.11F6669733F1420B.quest_desc: [
		"O &6Orbe Mago da Vida&r: &l1.000.000 EV&r de Alma. O cofre de sete dígitos."
		""
		"É para este orbe que os rituais foram precificados."
	]
	quest.11F6669733F1420B.quest_subtitle: "A alma de sete dígitos"
	quest.11F6669733F1420B.title: "O Orbe do Mestre"
	quest.16F8403D1836717A.quest_desc: [
		"Segura qualquer orbe na &lmão secundária&r e usa: uma barreira de cristal sobe na sua frente e engole projéteis. Flechas, tridentes, bolas de fogo, tudo."
		""
		"Ela drena 50 EV por segundo e só liga pra ameaça à distância. Corpo a corpo passa direto. Opcional."
	]
	quest.16F8403D1836717A.quest_subtitle: "Flechas não entram"
	quest.16F8403D1836717A.title: "A Barreira Sanguínea"
	quest.18CD5EBD9682E855.quest_desc: [
		"Runas Tier IV entortam os números com força: Velocidade IV, Capacidade IV, multiplicadores de sacrifício."
		""
		"O custo de entrada sobe junto com o retorno."
	]
	quest.18CD5EBD9682E855.quest_subtitle: "Velocidade IV, Capacidade IV"
	quest.18CD5EBD9682E855.title: "Tier IV: O Quarto Anel"
	quest.19891A8F26FBAB0A.quest_desc: [
		"O &6Selo de Divinação&r lê nosso altar e nossa Alma em voz alta: nível da bacia, trabalho em curso, o que tá faltando pro altar."
		""
		"Vale carregar um enquanto a gente aprende o sistema."
	]
	quest.19891A8F26FBAB0A.quest_subtitle: "O selo fofoqueiro"
	quest.19891A8F26FBAB0A.title: "Olhos do Arranjo"
	quest.1B6642BBDAEB2BD5.quest_desc: [
		"O &6Orbe Feiticeiro da Vida&r sobe o teto para &l150.000 EV&r. Rituais e trabalho do Atanor ficam caros rápido daqui pra frente."
		""
		"Continua colhendo; os orbes antigos ainda enchem numa boa."
	]
	quest.1B6642BBDAEB2BD5.quest_subtitle: "Seis dígitos"
	quest.1B6642BBDAEB2BD5.title: "O Orbe do Mago"
	quest.1BBABB2106D321A4.quest_desc: [
		"Assenta teu orbe numa &6Ligação da Vida do Orbe&r do lado do altar e a rede carrega tua Alma por você, sem parar."
		""
		"Jeito mão-livre de manter os rituais alimentados. Opcional."
	]
	quest.1BBABB2106D321A4.quest_subtitle: "Carregamento de alma sem as mãos"
	quest.1BBABB2106D321A4.title: "A Ligação da Vida do Orbe"
	quest.1C43D98AB4E51F15.quest_desc: [
		"O &6Altar de Incenso&r fica num jardim de blocos de tranquilidade e concede &6Sacrifício Abençoado&r, um bônus gordo nas nossas ofertas."
		""
		"Assenta anéis de caminho e blocos de tranquilidade ao redor; o site do jardim faz a conta."
	]
	quest.1C43D98AB4E51F15.quest_subtitle: "Cheiro de vitória"
	quest.1C43D98AB4E51F15.title: "O Altar de Incenso"
	quest.1CBBEFE4A84ABA45.quest_desc: [
		"Uma &6Espiral Infernal&r sonda 16 blocos em cada direção cardinal e puxa Aura morro abaixo, equalizando os chunks sem secar nenhum."
		""
		"Encadeia elas de um chunk saturado até onde você trabalha. Opcional."
	]
	quest.1CBBEFE4A84ABA45.quest_subtitle: "Encanamento, só que sinistro"
	quest.1CBBEFE4A84ABA45.title: "Movendo a Aura"
	quest.1F7ACF813D8804A6.quest_desc: [
		"Um &6Arranjo de Alquimia&r aceita duas ofertas jogadas dentro do círculo. Alguns pares criam itens, outros disparam efeitos na hora."
		""
		"Nosso primeiro selo, o &6Selo de Divinação&r, sai de uma receita de arranjo."
	]
	quest.1F7ACF813D8804A6.quest_subtitle: "Duas ofertas, um desejo"
	quest.1F7ACF813D8804A6.title: "Círculo de Intenção"
	quest.22CB17C102BB6773.quest_desc: [
		"Em casa a gente trabalha o Tau Fraco em Tau Forte e espreme o Óleo Tau; o jardim de incenso bebe disso."
		""
		"O óleo ainda serve de reagente para os frascos melhores."
	]
	quest.22CB17C102BB6773.quest_subtitle: "Combustível de jardim"
	quest.22CB17C102BB6773.title: "Refinando o Tau"
	quest.22D7D3FBACEBE7FB.quest_desc: [
		"Selos de &6Necromancia&r erguem servos de carcaça, esqueleto e vadio que lutam pela gente até a gente dispensar."
		""
		"Eles custam Alma enquanto ficam de pé. Opcional."
	]
	quest.22D7D3FBACEBE7FB.quest_subtitle: "Funcionário do mês: os mortos"
	quest.22D7D3FBACEBE7FB.title: "Os Mortos que Servem"
	quest.2355A35C8F4C6A30.quest_desc: [
		"O terceiro anel abre os tiers de runa superiores e todas as receitas escondidas atrás deles."
		""
		"Daqui pra frente o altar deixa de ser bancada e vira chão de fábrica."
	]
	quest.2355A35C8F4C6A30.quest_subtitle: "Chão de fábrica destravado"
	quest.2355A35C8F4C6A30.title: "Tier III: Runas Profundas"
	quest.24C0619EB4A13CA3.quest_desc: [
		"&6Nós de roteamento&r marcam as entradas e saídas, os condutos carregam o fluxo e um &6Nó Roteador Mestre&r arbitra tudo."
		""
		"Começa pequeno: um produtor, um consumidor. Opcional."
	]
	quest.24C0619EB4A13CA3.quest_subtitle: "Encanamento, só que sinistro"
	quest.24C0619EB4A13CA3.title: "Deitando as Veias"
	quest.2774F4E92DC99642.quest_desc: [
		"O Sacrifício Abençoado faz cada oferta de clique valer muito mais, e depois joga a gente no &lEsgotamento da Alma&r, um tempo de recarga que afina o que vem depois."
		""
		"Então a gente cicla: abençoa, oferta, descansa. Opcional."
	]
	quest.2774F4E92DC99642.quest_subtitle: "Cheiro de vitória"
	quest.2774F4E92DC99642.title: "Esgotamento da Alma"
	quest.298458E916F65407.quest_desc: [
		"A Aura é &lpor chunk&r: Espírito que a gente queima num chunk enche só aquele chunk, com teto de 100 por aspecto."
		""
		"Quase toda máquina do meio de jogo bebe da Aura local, não do nosso inventário."
	]
	quest.298458E916F65407.quest_subtitle: "Ar local, assombrado"
	quest.298458E916F65407.title: "A Aura Entre os Mundos"
	quest.29953F9E8F0A0D7B.quest_desc: [
		"Um &6Demônio Cruóris&r ronda os corredores mais fundos. O caçador de sangue, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.29953F9E8F0A0D7B.quest_subtitle: "Um dos dez do reino"
	quest.29953F9E8F0A0D7B.title: "Demônio Cruóris"
	quest.29B003254299103C.quest_desc: [
		"Gemas Superior e Grande comprimem reservatórios inteiros num slot de inventário só."
		""
		"O tier Superior pede uma Tábula do Espírito, um Fragmento de Sangue Fraco e um Cristal de Espírito. Opcional."
	]
	quest.29B003254299103C.quest_subtitle: "Garrafas maiores"
	quest.29B003254299103C.title: "Subindo a Escada"
	quest.2C0A6D0EC40C766A.quest_desc: [
		"Um &6Demônio Ígnis&r ronda os corredores mais fundos. O ardente, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.2C0A6D0EC40C766A.quest_subtitle: "Um dos dez do reino"
	quest.2C0A6D0EC40C766A.title: "Demônio Ígnis"
	quest.2C178EF05E31AE9A.quest_desc: [
		"Lá dentro, cada &6Selo de Masmorra&r pede uma &lChave de Masmorra Simples&r, e elas só caem dos baús daqui mesmo. Chave trazida de fora não abre nada."
		""
		"Os baús pagam equipamento encantado, unções, Espírito e nossas primeiras plantas Tau."
	]
	quest.2C178EF05E31AE9A.quest_subtitle: "Chave é saque, não receita"
	quest.2C178EF05E31AE9A.title: "A Antecâmara"
	quest.2E22A601DC126B7B.quest_desc: [
		"&6Espírito&r é a segunda economia: moeda da alma em vez de sangue. Abates marcados por adaga e lâminas sencientes rendem."
		""
		"Espírito solto bagunça tudo, então ele pede uma gema."
	]
	quest.2E22A601DC126B7B.quest_subtitle: "A segunda carteira"
	quest.2E22A601DC126B7B.title: "Cristais do Nada"
	quest.332F3C08E4014F63.quest_desc: [
		"O &6Acumulador de Espírito&r é um reservatório flutuante que junta 1.000 Espírito de um Aspecto, e a rede de roteamento pode sacar dele."
		""
		"O Atanor o forja de uma Partícula de Ânimo, uma Gema de Espírito Comum, uma Tábula do Espírito, um fragmento Cru, um Tanque de Sangue e 2.000 mB de EV, num chunk com 45 de Crua."
	]
	quest.332F3C08E4014F63.quest_subtitle: "Mil no tanque"
	quest.332F3C08E4014F63.title: "O Acumulador de Espírito"
	quest.3617A216FF8BC06C.quest_desc: [
		"A masmorra se remonta num quebra-cabeça novo a cada viagem. Mesmas salas, mapa novo."
		""
		"Fica de olho nas &6Distorções Espaciais&r: câmaras de tentáculos do vazio que escondem a entrada das Minas ou a porta do Capataz. O próprio reino avisa quando elas aparecem."
	]
	quest.3617A216FF8BC06C.quest_subtitle: "Mesmas salas, terror novo"
	quest.3617A216FF8BC06C.title: "O Reino Infinito"
	quest.36BA45620B2BED5B.quest_desc: [
		"As &6Runas do Orbe&r esticam a capacidade da nossa Alma além do que até o Orbe Divino da Vida permite."
		""
		"Se o orbe máximo ainda não der conta, esta é a próxima alavanca. Opcional."
	]
	quest.36BA45620B2BED5B.quest_subtitle: "Estique a bateria"
	quest.36BA45620B2BED5B.title: "Runas do Orbe"
	quest.383F7F715C60252B.quest_desc: [
		"O Tier II alarga o altar de novo. Mais espaços de runa significam nossa primeira montagem de verdade: uma mistura funcional de Velocidade e Capacidade."
		""
		"Também destrava as receitas de altar que fecham o meio do mod."
	]
	quest.383F7F715C60252B.quest_subtitle: "Mais espaço para ambição"
	quest.383F7F715C60252B.title: "Tier II: O Segundo Anel"
	quest.3CA324BE8531F253.quest_desc: [
		"O &6Fragmento de Sangue Fraco&r é trabalho do Atanor, produzido quando a máquina tá de pé."
		""
		"Ele abre a Gema Superior e as receitas acima dela."
	]
	quest.3CA324BE8531F253.quest_subtitle: "Fragmento pequeno, portas grandes"
	quest.3CA324BE8531F253.title: "O Fragmento de Sangue Fraco"
	quest.3E563EED3D77FC35.quest_desc: [
		"Um &6Demônio Animaris&r ronda os corredores mais fundos. O caçador de almas do reino, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.3E563EED3D77FC35.quest_subtitle: "Um dos dez do reino"
	quest.3E563EED3D77FC35.title: "Demônio Animaris"
	quest.3EC65211B94462DA.quest_desc: [
		"A &6Partícula de Ânimo&r só cai no saque do reino, e é a peça sem a qual o Acumulador de Espírito não sai do Atanor."
		""
		"Guarda cada uma que você achar. Lembrete opcional."
	]
	quest.3EC65211B94462DA.quest_subtitle: "Drop raro, não perca"
	quest.3EC65211B94462DA.title: "A Partícula de Ânimo"
	quest.3ECB062B99C4E4A5.quest_desc: [
		"O &6Teleposicionador&r troca blocos entre dois pontos marcados, ou carrega a gente entre eles."
		""
		"Utilidade de fim de jogo pra mover spawners, plantações e os nossos próprios pés. Opcional."
	]
	quest.3ECB062B99C4E4A5.quest_subtitle: "Mudança de casa, mágica"
	quest.3ECB062B99C4E4A5.title: "O Teleposicionador"
	quest.3F2FE793CE5052F0.quest_desc: [
		"A &6Rede de Roteamento&r é a logística do mod: nós, condutos e roteadores movendo itens, fluidos e Espírito entre máquinas."
		""
		"É assim que o altar, o vaso e as gemas deixam de precisar da gente."
	]
	quest.3F2FE793CE5052F0.quest_subtitle: "Tubos com opiniões"
	quest.3F2FE793CE5052F0.title: "A Rede de Roteamento"
	quest.40C32A4F6DE4B782.quest_desc: [
		"O &6Atanor&r é a terceira grande bancada: um cadinho que produz fragmentos, acumuladores e os reagentes pesados de que a aura se alimenta."
		""
		"Ele quer EV, Aura e materiais tudo de uma vez, então lê o medidor antes de acender."
	]
	quest.40C32A4F6DE4B782.quest_subtitle: "Bancada número três"
	quest.40C32A4F6DE4B782.title: "O Atanor"
	quest.419DB4A2A5A5FC58.quest_desc: [
		"O &6Capataz&r comanda as obras profundas. Essa é a luta de chefe do reino."
		""
		"Mate ele pelos drops pesados: demonita e as peças que alimentam o trabalho Forjado no Inferno."
	]
	quest.419DB4A2A5A5FC58.quest_subtitle: "Ele manda no lugar"
	quest.419DB4A2A5A5FC58.title: "O Capataz"
	quest.4393ADF3E4C8B0D4.quest_desc: [
		"Espírito vem em cinco Aspectos: &6Crua, Ruinoso, Invicto, Nulo, Vingativo&r. Trabalhos diferentes pedem aspectos diferentes."
		""
		"A Aura conta cada um separado, e saturar um chunk com um aspecto é como o trabalho aspectado começa. Aula opcional."
	]
	quest.4393ADF3E4C8B0D4.quest_subtitle: "Escolha um sabor"
	quest.4393ADF3E4C8B0D4.title: "Os Cinco Aspectos"
	quest.4476319FD2019185.quest_desc: [
		"Um &6Demônio Voráxis&r ronda os corredores mais fundos. O eternamente faminto, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.4476319FD2019185.quest_subtitle: "Um dos dez do reino"
	quest.4476319FD2019185.title: "Demônio Voráxis"
	quest.44DC32A27B02CDB8.quest_desc: [
		"&6Armazenamento&r e &6Tesouros Vinculados&r transformam um selo em bolsos extras."
		""
		"Útil nas corridas longas de masmorra, quando a mochila enche rápido. Opcional."
	]
	quest.44DC32A27B02CDB8.quest_subtitle: "Bolsos, só que mágicos"
	quest.44DC32A27B02CDB8.title: "Armazém Carregado"
	quest.459F6257FB16AC47.quest_desc: [
		"O anel final completa a Ara Vitae. Toda família de runas ganha seu assento mais alto."
		""
		"O altar que começou como um bloco único virou uma catedral."
	]
	quest.459F6257FB16AC47.quest_subtitle: "Uma catedral de runas"
	quest.459F6257FB16AC47.title: "Tier V: O Último Anel"
	quest.46122A9389875512.quest_desc: [
		"&6Rituais&r são diagramas desenhados com pedras rituais ao redor de uma Pedra de Ritual Mestra: efeitos grandes de uso único, de fazendas a romper o véu do reino."
		""
		"O Projetista de Ritual planeja eles; o Adivinhador de Ritual diz o que um padrão pede."
	]
	quest.46122A9389875512.quest_subtitle: "Efeitos grandes, desenhos maiores"
	quest.46122A9389875512.title: "Ritos e Rituais"
	quest.4694863405CFB97B.quest_desc: [
		"As &6Minas&r são o tier profundo do reino: portas trancadas por chave, daemonium mais duro e os minérios que valem a viagem de verdade."
		""
		"Chaves de mina caem no saque do Reino Infinito."
	]
	quest.4694863405CFB97B.quest_subtitle: "Onde mora o bom minério"
	quest.4694863405CFB97B.title: "As Minas"
	quest.4840F41B536529E3.quest_desc: [
		"Uma &6Adaga de Arremesso com Efeito&r carrega a unção na lâmina: um arremesso aplica na marca o que estiver pintado nela."
		""
		"Pra amolecer o que não fica quieto pra uma segunda adaga. Opcional."
	]
	quest.4840F41B536529E3.quest_subtitle: "Pinte na lâmina"
	quest.4840F41B536529E3.title: "Uma Ponta Mais Afiada"
	quest.499B8461225D3E74.quest_desc: [
		"A Tábula produz &6Unções&r: encantamentos temporários que a gente pinta em lâminas e ferramentas pra um turno de trabalho."
		""
		"Afiamento pra noite de chefe, fortuna pra viagem de mineração. Opcional."
	]
	quest.499B8461225D3E74.quest_subtitle: "Afiamento temporário"
	quest.499B8461225D3E74.title: "Unções"
	quest.4AE0C2D2D8D145F6.quest_desc: [
		"O reino enriquece com a profundidade: selos mais fundos, baús melhores, a partícula e o chefe."
		""
		"Circuito opcional pro fim difícil."
	]
	quest.4AE0C2D2D8D145F6.quest_subtitle: "Chave é saque, não receita"
	quest.4AE0C2D2D8D145F6.title: "Trabalhando as Profundezas"
	quest.4EBC5B191A7B12D9.quest_desc: [
		"Runas circundam o altar e cada família modifica ele: Velocidade, Capacidade, Sacrifício, Orbe e mais. Todas começam como &6Runas Vazias&r."
		""
		"Fabrique uma leva agora; os próximos anéis vão pedir."
	]
	quest.4EBC5B191A7B12D9.quest_subtitle: "Toda catedral precisa de tijolos"
	quest.4EBC5B191A7B12D9.title: "Runas Vazias"
	quest.4EE580588CC10C4E.quest_desc: [
		"&6Demonita&r cai do reino profundo: cascalho, fragmentos e pedaços brutos do metal do próprio reino."
		""
		"É o minério em que todo o fim de jogo é precificado."
	]
	quest.4EE580588CC10C4E.quest_subtitle: "O metal do próprio reino"
	quest.4EE580588CC10C4E.title: "Demonita"
	quest.4F77EDCEB49EB67F.quest_desc: [
		"Runas de orbe e velocidade de altar se acumulam. Um anel completo mantém até dreno nível Divino alimentado."
		""
		"Ajuste fino opcional pra quem tem paciência."
	]
	quest.4F77EDCEB49EB67F.quest_subtitle: "Juros compostos, edição sangue"
	quest.4F77EDCEB49EB67F.title: "Dobrando nas Runas"
	quest.538E28637FF76912.quest_desc: ["Esta Missão foi criada pela &6Equipe AllTheMods&r, ou por um &2contribuidor da Comunidade&r para uso nos Modpacks AllTheMods. \\n\\nComo todos os pacotes &6AllTheMods&r são licenciados sob &eTodos os Direitos Reservados&r, esta Missão não pode ser usada em nenhum pacote público não lançado pela &6Equipe AllTheMods&r sem permissão explícita. \\n\\nEsta missão está intencionalmente oculta, se você está vendo isso, você está no modo de edição."]
	quest.538E28637FF76912.title: "AllRightsReserved"
	quest.54AB11938676D4C7.quest_desc: [
		"Essa bancada dobra minérios comuns por processamento de reagente: ferro, ouro, cobre e companhia entram, o dobro sai."
		""
		"Lento por peça, mas de graça pra uma base paciente. Opcional."
	]
	quest.54AB11938676D4C7.quest_subtitle: "Dois por um, devagar"
	quest.54AB11938676D4C7.title: "Alquimia de Minério"
	quest.564AD8763F753C74.quest_desc: [
		"A Tábula da Vida também enche &6Frascos de Alquimia&r: efeitos bebíveis, persistentes e arremessáveis produzidos da nossa Alma."
		""
		"Frasco de combate e de utilidade mora aqui."
	]
	quest.564AD8763F753C74.quest_subtitle: "Alquimia que dá para beber"
	quest.564AD8763F753C74.title: "Efeitos Engarrafados"
	quest.56983FF3D82AF789.quest_desc: [
		"&6Pedras de Ritual Imperfeitas&r rodam efeitos pequenos sozinhas: controle de dia/noite, chuva e outros truques rápidos."
		""
		"Baratas, instantâneas e boas pra aprender o sistema. Opcional."
	]
	quest.56983FF3D82AF789.quest_subtitle: "Truques baratos, literalmente"
	quest.56983FF3D82AF789.title: "Rituais Imperfeitos"
	quest.56DDCB2865CEB9D3.quest_desc: [
		"O &6Medidor de Aura de Espírito&r projeta as cinco barras do chunk na nossa visão só de estar no inventário."
		""
		"Agacha pros números exatos: Crua, Ruinoso, Invicto, Nulo, Vingativo, de 0 a 100 cada."
	]
	quest.56DDCB2865CEB9D3.quest_subtitle: "Cinco barras, sem sinal"
	quest.56DDCB2865CEB9D3.title: "Lendo a Aura"
	quest.56F4E4845B8F12BB.quest_desc: [
		"Com um orbe vinculado, clica nele perto do altar pra oferecer o próprio sangue: a bacia enche de EV. Longe do altar, o orbe guarda a oferta pra depois."
		""
		"EV na bacia fabrica &6Tábula Rasa&r, o substrato de quase todos os selos, e mais um monte de coisa."
	]
	quest.56F4E4845B8F12BB.quest_subtitle: "Sangue vira poder"
	quest.56F4E4845B8F12BB.title: "A Tábua Vazia"
	quest.5785D68A5F1ED2D2.quest_desc: [
		"&6Tau&r só cresce no Reino Demoníaco: Tau Fraco, Tau Forte e Óleo Tau vêm tudo de lá de dentro."
		""
		"Alimenta o jardim de incenso e a alquimia intermediária, então colhe enquanto a gente tá lá embaixo."
	]
	quest.5785D68A5F1ED2D2.quest_subtitle: "Fruta demoníaca, a melhor fruta"
	quest.5785D68A5F1ED2D2.title: "A Colheita de Tau"
	quest.58248AF507380501.quest_desc: [
		"Arranca encantamento de equipamento que a gente já superou e guarda eles pra reuso."
		""
		"Um jeito quieto de reciclar o saque que a masmorra entrega. Opcional."
	]
	quest.58248AF507380501.quest_subtitle: "Recicle o brilho"
	quest.58248AF507380501.title: "Reciclagem de Encantamentos"
	quest.5A99B71DB0C6A42A.quest_desc: [
		"Selos vêm em graus. Chaves Simples abrem a Antecâmara; as portas fundas pedem &6Chaves da Masmorra da Mina&r e piores."
		""
		"Toda chave é saque de dentro do reino. A gente nunca fabrica uma."
	]
	quest.5A99B71DB0C6A42A.quest_subtitle: "Chave é saque, não receita"
	quest.5A99B71DB0C6A42A.title: "Fechaduras Profundas"
	quest.5AA17C1657E8E5DE.quest_desc: [
		"Equipamento senciente só melhora enquanto tá vestido e sendo usado, então alimenta ele com trabalho."
		""
		"Quanto mais tempo vive na gente, melhor fica. Opcional."
	]
	quest.5AA17C1657E8E5DE.quest_subtitle: "Amacie como botas novas"
	quest.5AA17C1657E8E5DE.title: "Vista e Viva"
	quest.5ACB4565C6B2466C.quest_desc: [
		"Liga o vaso com &lredstone&r e ele inverte: uma gema vazia dentro é &lcarregada&r a partir da Aura do chunk em vez de drenada."
		""
		"Satura um aspecto, deixa uma gema carregando e ela assume esse aspecto."
	]
	quest.5ACB4565C6B2466C.quest_subtitle: "Redstone inverte a torneira"
	quest.5ACB4565C6B2466C.title: "Gemas Aspectadas"
	quest.5BDD9D290D63ECE7.quest_desc: [
		"Um &6Demônio Rancóris&r ronda os corredores mais fundos. O rancoroso, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.5BDD9D290D63ECE7.quest_subtitle: "Um dos dez do reino"
	quest.5BDD9D290D63ECE7.title: "Demônio Rancóris"
	quest.5C3EA8B4F5949406.quest_desc: [
		"A &6Forja do Fogo do Inferno&r é a nossa segunda bancada: equipamento senciente, Gemas de Espírito melhores e metade do meio de jogo sai toda dela."
		""
		"Ela bebe Espírito e EV, então alimenta as duas economias antes de qualquer trabalho pesado."
	]
	quest.5C3EA8B4F5949406.quest_subtitle: "Mais quente que churrasco"
	quest.5C3EA8B4F5949406.title: "A Forja do Fogo do Inferno"
	quest.5C7581C81669C499.quest_desc: [
		"&6Minerador Rápido&r acelera nossa picareta, &6Bosque Verde&r faz plantação crescer, &6Magnetismo&r puxa drops pra gente."
		""
		"O clássico kit de utilidade. Opcional."
	]
	quest.5C7581C81669C499.quest_subtitle: "Pressa faz minério"
	quest.5C7581C81669C499.title: "Selos de Trabalho"
	quest.602884068EC40EDB.quest_desc: [
		"Ferramentas e a espada &6Sencientes&r são equipamento vivo. Abates com uma lâmina senciente soltam Espírito na hora, sem precisar marcar com adaga."
		""
		"Elas sobem de nível com a vontade que a gente alimenta nelas. Opcional, mas vale demais."
	]
	quest.602884068EC40EDB.quest_subtitle: "Ela aprende. Alimente-a."
	quest.602884068EC40EDB.title: "Aço Senciente"
	quest.6101AB772B0317F1.quest_desc: [
		"A nossa &6Alma&r é uma rede invisível que armazena EV pra tudo que é vitaemântico: selos, rituais, orbes. Se ela secar, alguns itens cobram o custo da nossa carne."
		""
		"Coloca o orbe dentro de um altar carregado pra mover o sangue guardado pra Alma, dez vezes mais rápido que o normal."
	]
	quest.6101AB772B0317F1.quest_subtitle: "A alma tem bateria"
	quest.6101AB772B0317F1.title: "Um Sentido de Alma"
	quest.6171A7D347B9DFF4.quest_desc: [
		"O &6Adivinhador de Ritual&r mostra a forma que um ritual pede e prevê o custo antes da gente assentar as pedras."
		""
		"Sai mais barato que adivinhar. Opcional."
	]
	quest.6171A7D347B9DFF4.quest_subtitle: "Prévia antes de pagar"
	quest.6171A7D347B9DFF4.title: "O Olho do Adivinhador"
	quest.62341583003C250F.quest_desc: [
		"Um &6Demônio Dolóris&r ronda os corredores mais fundos. O mensageiro da dor, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.62341583003C250F.quest_subtitle: "Um dos dez do reino"
	quest.62341583003C250F.title: "Demônio Dolóris"
	quest.62F71D88F1ED68B8.quest_desc: [
		"Dez espécies de daemonium rondam o reino, uma por aspecto e humor: Animaris, Cruóris, Dolóris e as demais, cada uma dropa seu próprio saque."
		""
		"O Bestiário lista o que cada uma guarda. Guia de campo opcional."
	]
	quest.62F71D88F1ED68B8.quest_subtitle: "Dez sabores de encrenca"
	quest.62F71D88F1ED68B8.title: "Conheça os Daemonium"
	quest.63BEB615CC08733D.quest_desc: [
		"Um &6Demônio Férvidis&r ronda os corredores mais fundos. O fervoroso, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.63BEB615CC08733D.quest_subtitle: "Um dos dez do reino"
	quest.63BEB615CC08733D.title: "Demônio Férvidis"
	quest.65BD73DA55BCC624.quest_desc: [
		"Neo Vitae é a arte da Vitaemancia: o nosso próprio sangue, refinado em poder. Este capítulo anda o caminho inteiro, do primeiro corte até o Reino Demoníaco."
		""
		"Segue a linha principal da esquerda pra direita. Os ramos laterais são aulas opcionais que pagam mais história do que equipamento."
	]
	quest.65BD73DA55BCC624.quest_subtitle: "Só quer um golinho"
	quest.65BD73DA55BCC624.title: "Bem-vindo a Neo Vitae"
	quest.6607F68E3F0B6243.quest_desc: [
		"Um &6Demônio Glaciáris&r ronda os corredores mais fundos. O espreitador congelado, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.6607F68E3F0B6243.quest_subtitle: "Um dos dez do reino"
	quest.6607F68E3F0B6243.title: "Demônio Glaciáris"
	quest.671F7551CBDF462F.quest_desc: [
		"O ritual Tier III pula o vestíbulo e deixa a gente direto no &lReino Infinito&r, o coração procedural da dimensão."
		""
		"As salas escalam conforme a gente desce: spawners mais duros, saque mais rico. Vai equipado."
	]
	quest.671F7551CBDF462F.quest_subtitle: "Sem pedágio, só demônios"
	quest.671F7551CBDF462F.title: "Estrada para o Inferno"
	quest.678017C531F68528.quest_desc: [
		"Selos são nossas ferramentas de trabalho: cada um faz uma função só, alimentado por EV da nossa Alma."
		""
		"As próximas missões mostram as famílias. Todas opcionais, todas úteis."
	]
	quest.678017C531F68528.quest_subtitle: "Um selo, uma função"
	quest.678017C531F68528.title: "Um Cinto Cheio de Selos"
	quest.6A866C75EE839078.quest_desc: [
		"Selos elementais dobram terreno e clima: auxílio de voo, manejo de lava, trabalho de gelo."
		""
		"Cada um é feito num arranjo e se alimenta de carga da Alma."
	]
	quest.6A866C75EE839078.quest_subtitle: "Kit de ferramentas elementais"
	quest.6A866C75EE839078.title: "Ar, Lava e Gelo"
	quest.702FC3E5D0D6C31F.quest_desc: [
		"O &6Orbe Divino da Vida&r: &l10.000.000 EV&r, o maior recipiente que a Vitaemancia oferece."
		""
		"Com ele na mão, todo ritual do mapa fica pagável."
	]
	quest.702FC3E5D0D6C31F.quest_subtitle: "O pináculo é um estilo de vida"
	quest.702FC3E5D0D6C31F.title: "O Pináculo"
	quest.70D2718D54785867.quest_desc: [
		"O &6Vaso do Malefício&r queima gemas e cristais na &lAura&r, Espírito difundido pelo ar do chunk onde ele tá."
		""
		"Alimenta ele com gemas carregadas, Essência de Espírito solta ou cristais de Espírito."
	]
	quest.70D2718D54785867.quest_subtitle: "O ar ganha um saldo"
	quest.70D2718D54785867.title: "O Vaso do Malefício"
	quest.71E0D06EA65172CF.quest_desc: [
		"O altar também forja &6Adagas de Arremesso&r, nossa primeira arma à distância e a semente da economia de Espírito inteira."
		""
		"Marca uma criatura hostil com um ferimento de adaga e depois finaliza: o abate rende partículas de &6Espírito&r. Mantém uma pilha por perto."
	]
	quest.71E0D06EA65172CF.quest_subtitle: "Esfaqueie primeiro, colete depois"
	quest.71E0D06EA65172CF.title: "Adagas de Arremesso"
	quest.73391A08D7615C77.quest_desc: [
		"Coloca uma &6Ara Vitae&r no chão plano e deposita um &ldiamante&r nela. Sem energia própria, o altar tira sangue de quem estiver por perto e refina em &6Essentia Vitae (EV)&r."
		""
		"O diamante se transfigura num &6Orbe Noviço da Vida&r. Clica com o botão direito pra vincular ele à sua alma."
	]
	quest.73391A08D7615C77.quest_subtitle: "Só quer um golinho"
	quest.73391A08D7615C77.title: "O Primeiro Altar"
	quest.759B0D6F8C0CC1EF.quest_desc: [
		"A primeira melhoria do altar é um anel de runas assentado na pedra ao redor da Ara Vitae. Oito espaços de runa abrem no Tier I."
		""
		"Runas de Velocidade encurtam todo trabalho; Runas de Capacidade aprofundam a bacia. O site de planejamento mostra os números exatos."
	]
	quest.759B0D6F8C0CC1EF.quest_subtitle: "O altar ganha uma coroa"
	quest.759B0D6F8C0CC1EF.title: "Tier I: Anel de Runas"
	quest.770A5CCB2B571FD0.quest_desc: [
		"Um orbe na mão secundária bebe de cada abate: &l10 EV por ponto de vida máxima&r da vítima cai no reservatório do orbe."
		""
		"Enche ele em batalha e depois deposita no altar pra uma carga 10x mais rápida na nossa Alma."
	]
	quest.770A5CCB2B571FD0.quest_subtitle: "Todo abate paga"
	quest.770A5CCB2B571FD0.title: "Colheita dos Caídos"
	quest.7731623EA92027D9.quest_desc: [
		"O &6Orbe Senhor da Vida&r guarda &l5.000.000 EV&r. Daqui pra frente a Alma raramente zera no meio de um ritual."
		""
		"Falta um tier depois deste."
	]
	quest.7731623EA92027D9.quest_subtitle: "Cinco milhões e subindo"
	quest.7731623EA92027D9.title: "O Orbe do Arquimago"
	quest.7AFEB7A91DC8F413.quest_desc: [
		"Forja o &6Orbe Discípulo da Vida&r num altar Tier I e a capacidade da nossa Alma salta de 5.000 para &l25.000 EV&r."
		""
		"Ofertas maiores, trabalhos maiores. Continua enchendo."
	]
	quest.7AFEB7A91DC8F413.quest_subtitle: "25.000 motivos para continuar"
	quest.7AFEB7A91DC8F413.title: "O Orbe do Aprendiz"
	quest.7B293C32824033F9.quest_desc: [
		"O &6Cristalório do Malefício&r cultiva Cristais de Espírito a partir de fragmentos crus alimentados pela aura."
		""
		"A fazenda de cristais que mantém os cinco aspectos abastecidos."
	]
	quest.7B293C32824033F9.quest_subtitle: "Fazenda de cristais, basicamente"
	quest.7B293C32824033F9.title: "Ative o Cristalório do Malefício"
	quest.7C7C061FC04B89FB.quest_desc: [
		"Refina demonita em peças e lingotes &6Forjado no Inferno&r: o metal por trás das ferramentas e células máximas."
		""
		"O último material que o capítulo pede."
	]
	quest.7C7C061FC04B89FB.quest_subtitle: "Material de prateleira alta"
	quest.7C7C061FC04B89FB.title: "Aço Forjado no Inferno"
	quest.7CF9A68167ADAD1A.quest_desc: [
		"A produção de sacrifício escala com runas de velocidade do altar e o nosso bônus de sacrifício."
		""
		"Sangue lento é trabalho lento; as missões de automação anteriores resolvem isso. Opcional."
	]
	quest.7CF9A68167ADAD1A.quest_subtitle: "Velocidade é estatística de build"
	quest.7CF9A68167ADAD1A.title: "Coração Lento Não Serve a Ninguém"
	quest.7FEB1850709B6C3B.quest_desc: [
		"Um &6Demônio Corródis&r ronda os corredores mais fundos. O corrosivo, um dos dez do reino."
		"Mate um para registrá-lo no registro. As salas mais fundas escondem as espécies mais raras."
	]
	quest.7FEB1850709B6C3B.quest_subtitle: "Um dos dez do reino"
	quest.7FEB1850709B6C3B.title: "Demônio Corródis"
	task.0288CB407D31C889.title: "Entrar no Reino Infinito"
	task.1FF3177703E8A956.title: "Assentar o terceiro anel de runas"
	task.29A4F7568EC9A669.title: "Forjar uma Gema de Espírito Maior"
	task.2E79DA68A894ADA3.title: "Assentar o quarto anel de runas"
	task.3888E025817A3078.title: "Rever as famílias de selos"
	task.4583E01C36D6F8CE.title: "Receber o bônus de Sacrifício Abençoado"
	task.5042D493A5C64E1F.title: "Dominar as artes da Vitaemancia"
	task.5C46A937BDD648FB.title: "Saquear uma Partícula de Ânimo"
	task.636C5D69E573AFD6.title: "Colher EV de abates com um orbe na mão secundária"
	task.69E3F53841566D45.title: "Conhecer o bestiário daemonium"
	task.6D5BE02E9FAED45C.title: "TodosOsDireitosReservados"
	task.725FB5D93493B696.title: "Forjar um Acumulador de Espírito no Atanor"
	task.73813DADA29F08D1.title: "Completar o quinto anel"
	task.751D04253475CDEE.title: "Produzir uma unção na Tábula da Vida"
	task.7C216145BA10CE53.title: "Levantar a Barreira Sanguínea uma vez"
	task.7DA13EB040BC1C19.title: "TodosOsDireitosReservados"
}
