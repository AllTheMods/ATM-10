{
	quest.010607466D565B53.quest_desc: ["Genre, connectez-vous à Mère Nature. \\n\\nAvec les &aBottes enracinées&r, la nature est votre meilleure amie ! Debout sur de l'herbe, vous régénérez vos cœurs. Et quand vous mangez debout sur de l'herbe, ça agit comme si vous y mettiez de la poudre d'os."]
	quest.010607466D565B53.quest_subtitle: "Pieds"
	quest.010607466D565B53.title: "&aBottes enracinées"
	quest.0A1D4228271DECA3.quest_desc: ["Où êtes-vous passé ?\\n\\nAh, vous faites juste la moitié de votre taille d'avant. Assez petit pour passer sous un espace d'1 bloc."]
	quest.0A1D4228271DECA3.quest_subtitle: "Collier"
	quest.0A1D4228271DECA3.title: "&5Charme de rétrécissement&r"
	quest.0E716B90E60C486B.quest_desc: ["Parfois, la meilleure façon de se battre, c'est de ne pas se battre... mais de s'enfuir ! \\n\\nAvec le &4Collier de panique&r, quand vous êtes touché, vous recevez l'effet Vitesse un court moment. Juste le temps de vous échapper !"]
	quest.0E716B90E60C486B.quest_subtitle: "Collier"
	quest.0E716B90E60C486B.title: "&4Collier de panique&r"
	quest.11C5F17C6BB1237B.quest_desc: ["En portant le &5Bracelet flétri&r, les attaques au corps à corps peuvent donner l'effet Wither.\\n\\nDésolé pour les archers !"]
	quest.11C5F17C6BB1237B.quest_subtitle: "Poignets (mains)"
	quest.11C5F17C6BB1237B.title: "&5Bracelet flétri&r"
	quest.122E6E7CABCB17E7.quest_desc: ["Pour une raison quelconque, les creepers ont peur des chats. Les creepers sont aussi très bêtes et croient que les chats auxquels ressemblent vos &7Chaussons&r sont vrais. \\n\\nTous les creepers vous fuient et ne sont pas hostiles quand vous portez ces &7Chaussons&r. \\n\\nEn plus, ils miaulent quand vous prenez des dégâts ! (Par contre, impossible de vous garantir que vous retomberez toujours sur vos pattes.)"]
	quest.122E6E7CABCB17E7.quest_subtitle: "Pieds"
	quest.122E6E7CABCB17E7.title: "&7Chaussons chat&r"
	quest.145E7D1A88B83DDD.quest_desc: ["Où êtes-vous passé ?"]
	quest.145E7D1A88B83DDD.quest_subtitle: "Écharpe (collier)"
	quest.145E7D1A88B83DDD.title: "&9Écharpe d'invisibilité&r"
	quest.161A90E134592D0E.quest_desc: ["Comme le bœuf cru normal, vous pouvez cuire le &cBœuf éternel&r pour obtenir un &4Steak éternel&r !\\n\\nIl marche comme le &cBœuf éternel&r, mais avec plus de points de nourriture et de saturation."]
	quest.161A90E134592D0E.quest_subtitle: "Unique"
	quest.161A90E134592D0E.title: "&4Steak éternel"
	quest.16255FB20F35A9D9.quest_desc: ["Le &3Tuba&r vous donne un peu de respiration aquatique quand vous entrez dans l'&9Eau&r. Comme une carapace de tortue ! Attention, ça s'épuise."]
	quest.16255FB20F35A9D9.quest_subtitle: "Tête"
	quest.16255FB20F35A9D9.title: "&3Tuba"
	quest.19B393433FB0C62F.quest_desc: ["Le secret des arpenteurs pour marcher sur la &cLave&r est dans leurs jambes. Alors on leur a pris leurs jambes pour que vous les utilisiez ! \\n\\nEn vous accroupissant, vous pouvez marcher sans danger sur la &cLave&r ! Mais si vous arrêtez de vous accroupir, vous tomberez dans la &cLave&r. Elles permettent aussi de marcher sans danger sur les blocs de magma et autres blocs brûlants !"]
	quest.19B393433FB0C62F.quest_subtitle: "Pieds"
	quest.19B393433FB0C62F.title: "&4Chaussures d'arpenteur&r"
	quest.1E40ACF3E69A4100.quest_desc: ["Faut-il le boire ? Aucune idée, il reste juste là et il marche... \\n\\nAvec la &6Fiole d'antidote&r, les effets négatifs (comme Wither ou Poison) durent beaucoup moins longtemps ! Très utile face aux sorcières ou aux squelettes wither."]
	quest.1E40ACF3E69A4100.quest_subtitle: "Ceinture"
	quest.1E40ACF3E69A4100.title: "&6Fiole d'antidote&r"
	quest.2215FB0777D7029D.quest_desc: ["Crampons, pointes, appelez-les comme vous voulez ! \\n\\nLes &7Bottes inébranlables&r vous gardent bien sur vos pieds. Vous ne serez plus repoussé par les attaques et vous ne glisserez plus sur la glace."]
	quest.2215FB0777D7029D.quest_subtitle: "Pieds"
	quest.2215FB0777D7029D.title: "&7Bottes inébranlables&r"
	quest.221C9EDA651144BA.quest_desc: ["Quelle &9Eau&r ? \\n\\nAvec le &3Charme d'immersion&r, vous vous déplacez dans l'&9Eau&r comme dans l'air ! Par contre, vous ne pouvez toujours pas respirer sous l'eau..."]
	quest.221C9EDA651144BA.quest_subtitle: "Collier"
	quest.221C9EDA651144BA.title: "&3Charme d'immersion&r"
	quest.2607F3DC07049785.quest_desc: ["Pourquoi prendre le temps de s'asseoir pour un bon petit plat maison quand on peut manger et boire vite ! \\n\\nAvec ce &6Chapeau&r très stylé, manger et boire est beaucoup plus rapide."]
	quest.2607F3DC07049785.quest_subtitle: "Tête"
	quest.2607F3DC07049785.title: "&6Chapeau à boire en plastique"
	quest.27E951F4F4F6F847.quest_desc: ["Comme le &aPendentif épineux&r, en un peu plus chaud. Non, attendez, en beaucoup plus chaud ! \\n\\nLe &cPendentif de flammes&r peut mettre le feu à vos attaquants ! Quand ils prennent feu, le &cPendentif&r vous donne aussi Résistance au feu."]
	quest.27E951F4F4F6F847.quest_subtitle: "Collier"
	quest.27E951F4F4F6F847.title: "&cPendentif de flammes&r"
	quest.29448D08C8777425.quest_desc: ["Ce soir, il dormira avec les poissons. \\n\\nLe &cChapeau de pêcheur&r attire les poissons et augmente vos chances d'obtenir un butin rare !"]
	quest.29448D08C8777425.quest_subtitle: "Tête"
	quest.29448D08C8777425.title: "&cChapeau de pêcheur"
	quest.2AD78E22988A92D3.quest_desc: ["Je vous vois ! \\n\\nEn portant les &2Lunettes de vision nocturne&r, vous pouvez voir dans le noir ! Pas grand-chose d'autre à dire..."]
	quest.2AD78E22988A92D3.quest_subtitle: "Tête"
	quest.2AD78E22988A92D3.title: "&2Lunettes de vision nocturne"
	quest.321F16645640C462.quest_desc: ["Les perles de l'Ender sont une façon amusante de voyager ! (Utile pour la Bumblezone, je me demande si on aura un chapitre de quêtes pour ce mod !) Mais vous détestez que la perle soit consommée et vous fasse 2 cœurs de dégâts à chaque fois, non ? \\n\\nAvec la &9Propulsion warp&r, tout ça disparaît, faisant clairement des perles de l'Ender le meilleur moyen de transport ! C'est votre faim qui est consommée à la place de la perle, et vous ne prenez plus de dégâts en l'utilisant. Quand toutes vos barres de faim sont vides, elle consomme de nouveau des perles."]
	quest.321F16645640C462.quest_subtitle: "Ceinture"
	quest.321F16645640C462.title: "&9Propulsion warp&r"
	quest.3446803FB59D8875.quest_desc: ["Vous donne Épines. Pas à votre armure, à vous ! Comme un poisson-globe !"]
	quest.3446803FB59D8875.quest_subtitle: "Collier"
	quest.3446803FB59D8875.title: "&aPendentif épineux&r"
	quest.3525D5DCC3A534D9.quest_desc: ["Ça, c'est un de mes préférés ! \\n\\nLes &9Griffes de creusage&r : 1. augmentent votre vitesse de minage, donc en gros un niveau d'Efficacité sur toutes les pioches, et 2. font agir vos poings comme une pioche en pierre ! \\n\\nSuper utiles pour construire et pour jouer en général !"]
	quest.3525D5DCC3A534D9.quest_subtitle: "Mains"
	quest.3525D5DCC3A534D9.title: "&9Griffes de creusage&r"
	quest.3705D303CF423804.quest_desc: ["L'autre face des &aGriffes sauvages&r : elles augmentent les dégâts que vous infligez en les portant."]
	quest.3705D303CF423804.quest_subtitle: "Mains"
	quest.3705D303CF423804.title: "&eGant de puissance&r"
	quest.3B3BD39BA02DCA13.quest_desc: ["Avec le &6Piston de poche&r, vos attaques repoussent vos ennemis bien plus loin ! \\n\\nJe me demande qui gagne : le &6Piston de poche&r ou les &7Bottes inébranlables&r ?"]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Mains"
	quest.3B3BD39BA02DCA13.title: "&6Piston de poche&r"
	quest.3E0643EA9183CDAE.quest_desc: ["« C'était son chapeau, M. Krabs ! Il était numéro 1 ! » \\n\\nFait exactement la même chose que le &6Chapeau à boire&r normal, mais en beaucoup plus cool !"]
	quest.3E0643EA9183CDAE.quest_subtitle: "Tête"
	quest.3E0643EA9183CDAE.title: "&9Chapeau à boire fantaisie"
	quest.3E1A3BC8642390B3.quest_desc: ["« Je suis Mary Poppins, les amis ! » \\n\\n&4Le parapluie&r est un outil très utile ajouté par &l&3Artifacts&r ! On peut le tenir devant soi comme un bouclier en maintenant le clic droit. Ou s'en servir pour ralentir sa chute rien qu'en le tenant !"]
	quest.3E1A3BC8642390B3.quest_subtitle: "Unique"
	quest.3E1A3BC8642390B3.title: "&4Parapluie&r"
	quest.3EC8A0B89788D079.quest_desc: ["Je n'ai pas de mains, j'ai des &9Palmes&r. \\n\\nLes &9Palmes&r agissent comme une Agilité aquatique bien meilleure. Vous nagez et marchez dans l'&9Eau&r beaucoup plus vite !"]
	quest.3EC8A0B89788D079.quest_subtitle: "Pieds"
	quest.3EC8A0B89788D079.title: "&9Palmes&r"
	quest.427014BDE06DE631.quest_desc: ["Tout ce que je frappe prend feu !!!!!"]
	quest.427014BDE06DE631.quest_subtitle: "Mains"
	quest.427014BDE06DE631.title: "&cGantelet de feu&r"
	quest.436E4E3515BCCDE9.quest_desc: ["Avec le &bNuage en bouteille&r équipé, appuyez deux fois sur Espace pour faire un double saut ! Très utile pour le parkour ! \\n\\nAugmente aussi la hauteur de chute supportée, comme les &dBottes de lapin&r !"]
	quest.436E4E3515BCCDE9.quest_subtitle: "Ceinture"
	quest.436E4E3515BCCDE9.title: "&bNuage en bouteille&r"
	quest.4564B577CB4EC046.quest_desc: ["En abattant des centaines de vaches, vous pourriez tomber sur un bœuf rare. Pas un atteint de la vache folle, je parle du &cBœuf éternel&r !\\n\\nLe &cBœuf éternel&r se mange comme un bœuf cru normal, mais il ne disparaît pas une fois mangé ! À la place, il a un temps de recharge avant de pouvoir le remanger.\\n\\n(Marche aussi avec les sacs à dos qui nourrissent automatiquement !)"]
	quest.4564B577CB4EC046.quest_subtitle: "Unique"
	quest.4564B577CB4EC046.title: "&cBœuf éternel&r"
	quest.4933CF4675E77D50.quest_desc: ["Après avoir pris des dégâts de feu, le &5Crâne d'obsidienne&r s'active et vous donne un moment de Résistance au feu. Assez long, espérons-le, pour fuir les flammes !"]
	quest.4933CF4675E77D50.quest_subtitle: "Ceinture"
	quest.4933CF4675E77D50.title: "&5Crâne d'obsidienne&r"
	quest.4A7AEBEB87CEC274.quest_desc: ["Je ne crois pas avoir le droit d'utiliser une marque précise de &cChaussures de course&r, alors imaginez celle que vous voulez. \\n\\nLes &cChaussures de course&r donnent un bonus de vitesse quand vous sprintez, pour aller encore plus vite en courant ! Elles donnent aussi le saut automatique en sprintant..."]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Pieds"
	quest.4A7AEBEB87CEC274.title: "&cChaussures de course&r"
	quest.4D3379D38237F830.quest_desc: ["En portant &bcelles-ci&r aux pieds, vous pouvez faire un miracle : marcher sur l'&9Eau&r ! \\n\\nEnfin, plutôt courir sur l'&9Eau&r : il faut sprinter pour pouvoir courir sur l'&9Eau&r. Dès que vous arrêtez de sprinter, vous commencez à couler."]
	quest.4D3379D38237F830.quest_subtitle: "Pieds"
	quest.4D3379D38237F830.title: "&bAqua-sprinteurs&r"
	quest.5040B3D29F238BC0.quest_desc: ["Lapin, saute. Lapin, saute. Lapin, saute.\\n\\nAvec les &dBottes de lapin&r, vous sautez deux fois plus haut et prenez moitié moins de dégâts de chute ! Ça ne vous rend pas invincible aux chutes, vous pouvez toujours mourir, c'est juste plus dur."]
	quest.5040B3D29F238BC0.quest_subtitle: "Pieds"
	quest.5040B3D29F238BC0.title: "&dBottes de lapin&r"
	quest.50A32AC6EDBC5854.quest_desc: ["La nourriture seule peut devenir ennuyeuse, mais c'est bien meilleur avec un accompagnement ! Plus précisément un &6Anneau d'oignon&r !\\n\\nEn portant l'&6Anneau d'oignon&r, tout ce que vous mangez vous donne un peu de Célérité."]
	quest.50A32AC6EDBC5854.quest_subtitle: "Mains"
	quest.50A32AC6EDBC5854.title: "&6Anneau d'oignon&r"
	quest.589F1D502F680075.quest_desc: ["Parfait pour les fêtes à la piscine ! \\n\\nEn plus d'être mignon et drôle, le &dFlamant à l'hélium&r vous permet de nager dans l'air. Oui, vous avez bien entendu ! Nager... dans... l'air... \\n\\nQuand vous êtes en l'air, par exemple en sautant, appuyez sur CTRL pour commencer à nager dans l'air. Vous vous déplacez comme dans l'eau : nager vers le haut, vers le bas, partout !"]
	quest.589F1D502F680075.quest_subtitle: "Ceinture"
	quest.589F1D502F680075.title: "&dFlamant à l'hélium&r"
	quest.5CE44C58A470E48E.quest_desc: ["&l&3Artifacts&r est un super mod qui ajoute des &l&3Artefacts&r qui rendront votre expérience Minecraft bien plus facile et bien plus amusante !\\n\\nTous les &l&3Artefacts&r se trouvent en explorant, par l'archéologie ou en tuant des mimiques !\\n\\nLes mimiques se trouvent dans des campements souterrains et ressemblent à des coffres normaux ! Mais si vous approchez trop, elles attaquent !"]
	quest.5CE44C58A470E48E.title: "&l&3Artifacts"
	quest.5DE7C4FD5FA29236.quest_desc: ["Vous détestez quand vous êtes sur le point de tuer un enderman et qu'il se téléporte ? En fait vous ne détestez pas ça, vous adorez ! Vous êtes juste en colère parce que vous êtes jaloux ! Vous le voulez ! \\n\\nEt avec la &5Ceinture de chorus&r, vous l'avez ! Vous vous téléportez quand un coup devrait vous tuer."]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Ceinture"
	quest.5DE7C4FD5FA29236.title: "&5Ceinture de chorus&r"
	quest.5EB7CE3A1DCD3E9B.quest_desc: ["C'est un &cAimant&r."]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Ceinture"
	quest.5EB7CE3A1DCD3E9B.title: "&cAttracteur universel&r"
	quest.5F5E43B3F51CAE9E.quest_desc: ["« Ils sont magiquement délicieux ! » \\n\\nLe &aChapeau superstitieux&r vous donne un niveau de Butin en plus sur les créatures que vous tuez ! \\n\\nIl se cumule avec les enchantements !"]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Tête"
	quest.5F5E43B3F51CAE9E.title: "&aChapeau superstitieux"
	quest.5FD6A738754F6013.quest_desc: ["Cette quête a été écrite par l'&6équipe AllTheMods&r ou un &2contributeur de la communauté&r pour les modpacks AllTheMods. \\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut pas être utilisée dans un pack public non publié par l'&6équipe AllTheMods&r sans autorisation explicite. \\n\\nCette quête est volontairement cachée ; si vous la voyez, c'est que vous êtes en mode édition."]
	quest.623796B1D7981E59.quest_desc: ["« Essayez aussi Terraria ! »\\n\\nUne fois équipé, vous gagnez 5 cœurs en plus ! Soit 10 points de vie entiers ! Ce qui fait 30 points de vie au total par défaut."]
	quest.623796B1D7981E59.quest_subtitle: "Ceinture"
	quest.623796B1D7981E59.title: "&4Cœur de cristal&r"
	quest.62622137648A4F56.quest_desc: ["Vous détestez devoir miner puis faire fondre vos minerais avec deux objets différents ? Maintenant vous pouvez être plus paresseux que jamais avec le &7Chauffe-pioche&r !\\n\\nEn portant le &7Chauffe-pioche&r, les minerais que vous minez sont automatiquement fondus !\\n\\nFaites attention si vous voulez traiter vos minerais."]
	quest.62622137648A4F56.quest_subtitle: "Mains"
	quest.62622137648A4F56.title: "&7Chauffe-pioche&r"
	quest.6A452BFC8A967C39.quest_desc: ["Porter ces &aGriffes&r vous fait ressentir quelque chose. L'adrénaline monte, les pensées s'arrêtent, la force grimpe comme jamais ! \\n\\nAvec les &aGriffes sauvages&r, vous attaquez beaucoup plus vite avec vos armes ou vos poings."]
	quest.6A452BFC8A967C39.quest_subtitle: "Mains"
	quest.6A452BFC8A967C39.title: "&aGriffes sauvages&r"
	quest.6FBE5B5D5027B32C.quest_desc: ["Porter ce &7Chapeau&r-là fait courir vos bestioles comme le vent ! \\n\\nEt il est rudement joli, en plus."]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Tête"
	quest.6FBE5B5D5027B32C.title: "&7Chapeau de cowboy"
	quest.70C7D92844089DEB.quest_desc: ["Comme les autres pendentifs, celui-ci peut blesser votre attaquant, mais avec la foudre ! \\n\\nEn plus, si vous avez la (mal)chance d'être frappé par la foudre, elle ne vous fera pas mal."]
	quest.70C7D92844089DEB.quest_subtitle: "Collier"
	quest.70C7D92844089DEB.title: "&bPendentif de choc&r"
	quest.7188DC06A28AE30E.quest_desc: ["Porter c'&eCrochet doré&r augmente l'expérience que vous rapportent les ennemis passés par-dessus bord, moussaillon !"]
	quest.7188DC06A28AE30E.quest_subtitle: "Mains"
	quest.7188DC06A28AE30E.title: "&eCrochet doré&r"
	quest.72D6265E35814927.quest_desc: ["La plupart des jeux avec un système de vie et de dégâts ont des frames d'invincibilité. Après avoir pris des dégâts, vous avez quelques frames d'invincibilité pour 1. ne pas mourir instantanément sur une simple attaque, et 2. avoir le temps de riposter. \\n\\nAvec le &eCollier croix&r, vous avez quelques frames d'invincibilité en plus. Donc un peu plus de temps pour riposter !"]
	quest.72D6265E35814927.quest_subtitle: "Collier"
	quest.72D6265E35814927.title: "&eCollier croix&r"
	quest.73B73870B29DFAD9.quest_desc: ["Un des nôtres ! Un des nôtres ! \\n\\nLe &eChapeau de villageois&r fait croire aux villageois que vous venez du même village, alors ils suppriment la taxe des étrangers. Les échanges avec les villageois coûtent moins cher."]
	quest.73B73870B29DFAD9.quest_subtitle: "Tête"
	quest.73B73870B29DFAD9.title: "&eChapeau de villageois"
	quest.73FC51144FC2DA52.quest_desc: ["Avec ce &7Gant&r, vous volez la vie de tous les ennemis que vous frappez !\\n\\nAh oui, pardon, j'oubliais... bleh bleh blehhh !"]
	quest.73FC51144FC2DA52.quest_subtitle: "Mains"
	quest.73FC51144FC2DA52.title: "&7Gant de vampire&r"
	quest.74B352457BF1541B.quest_desc: ["Si vous êtes comme moi, ou comme n'importe quelle personne saine d'esprit, vous détestez la neige poudreuse. Heureusement, &l&3Artifacts&r nous donne un outil pour ça : les raquettes ! \\n\\nLes raquettes permettent de marcher sans danger sur la neige poudreuse, comme les bottes en cuir. Vous avez aussi un bonus de vitesse en marchant sur n'importe quelle neige !"]
	quest.74B352457BF1541B.quest_subtitle: "Pieds"
	quest.7503823ACDDB0491.quest_desc: ["Avec ça et le &aChapeau superstitieux&r, vous avez tous les porte-bonheur qu'il vous faut !\\nL'&2Écharpe porte-bonheur&r donne un niveau de Fortune en plus à vos pioches."]
	quest.7503823ACDDB0491.quest_subtitle: "Écharpe (collier)"
	quest.7503823ACDDB0491.title: "&2Écharpe porte-bonheur&r"
	quest.789AF6D0A6321945.quest_desc: [
		"Le plus important ! Le plus puissant ! Le plus dangereux de tous les &l&3Artefacts&r !"
		"{@pagebreak}"
		"Je ne suis même pas sûr de devoir expliquer ce qu'il fait, c'est trop dangereux !"
		"{@pagebreak}"
		"Si vous êtes vraiment sûr de pouvoir maîtriser sa puissance, alors continuez peut-être à lire..."
		"{@pagebreak}"
		"Il n'est pas trop tard pour faire demi-tour !"
		"{@pagebreak}"
		"Bon, je vous aurai prévenu..."
		"{@pagebreak}"
		"Appuyez sur Maj pour avoir une chance de péter quand le &dCoussin péteur&r est équipé."
	]
	quest.789AF6D0A6321945.quest_subtitle: "Unique"
	quest.789AF6D0A6321945.title: "&dCoussin péteur&r"
	task.376652638B9221C9.title: "TousDroitsRéservés"
	task.68DC39876E14FC1B.title: "Tuer 1 mimique"
	task.72E89066290E3040.title: "TousDroitsRéservés"
}
