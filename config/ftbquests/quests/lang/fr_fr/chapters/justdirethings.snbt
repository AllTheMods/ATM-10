	]
	quest.3971FF7D044D1FE5.quest_desc: ["Les capacités d'armure se configurent et s'activent dans le menu de configuration. Utilisez un outil ou une baguette JDT pour ouvrir le menu, et clique sur votre armure pour configurer les capacités de cette pièce."]
	quest.3A471716A29F5172.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :&r"
		""
		"Donne des élytres au joueur ; note : les élytres données par cette amélioration sont affectées par les améliorations de vitesse de marche et de course."
	]
	quest.3AE1811C32B94A66.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :&r"
		""
		"Éteint le joueur s'il est en feu ; a un temps de recharge."
	]
	quest.3B3E3D81843BB358.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :&r"
		""
