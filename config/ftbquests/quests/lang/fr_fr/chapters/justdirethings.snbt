	quest.2409EAD96CE3BDF7.quest_desc: ["Les modèles en blazegold servent à améliorer les armures et outils en ferricore en blazegold, en gardant les enchantements et améliorations installées."]
	quest.242F74010488F261.quest_desc: ["Le bidon de combustible est un objet qui permet d'utiliser le combustible plus efficacement. Il peut stocker 50 000 de combustible ; chaque objet combustible a une valeur différente selon le nombre d'objets qu'il fait fondre. Une unité de combustible suffit pour faire fondre un objet."]
	quest.24BA4B4EED0A9DBD.quest_desc: [
		"Améliorations valides :"
		"- Brouillard mental"
	]
	quest.25213DBA6E6CEDD2.quest_desc: [
		"La glu ombrepulse est le quatrième et dernier niveau de glu ajouté par JDT et demande des matériaux de cité antique et du Warden."
		""
		"Fabrications débloquées :"
		"- Alliage d'éclipse"
		"- Braise d'éclipse"
		"- Cristal temporel"
	]
	quest.25E915AE1FC53254.quest_desc: ["Les modèles en célestigemme servent à améliorer les armures et outils en blazegold en célestigemme, en gardant les enchantements et améliorations installées."]
	quest.27FD46A8C958D259.quest_desc: ["Le totem de rappel de la mort est un objet à usage unique qui permet au joueur de se téléporter à l'endroit de sa mort."]
	quest.283D7E65F2AD45F2.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :&r"
		""
		"Une version améliorée du scanner de créatures qui fait briller les créatures proches une fois activée."
	]
	quest.2875FACD3BFB0A8E.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :&r"
		""
		"Donne un léger soin une fois activée, mais ne peut être activée que si le joueur a récemment subi des dégâts ou en subit."
	]
	quest.2A01CE9206DD4F8A.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :&r"
		""
		"Mine d'un coup les blocs de minerai adjacents, mais met un peu plus de temps à miner."
	]
	quest.2A919F73CB09CF8B.quest_desc: [
		"Améliorations valides :"
		"- Vitesse de course"
		"- Vitesse de marche"
		"- Vitesse de nage"
		"- Leurre"
		"- Traversée"
	]
	quest.2B1BAEC5DAAF9DAC.quest_desc: [
		"Améliorations valides :"
		"- Abatteur d'arbres"
		"- Casseur de feuilles"
		"- Fonte automatique"
		"- Téléporteur de butin"
	]
	quest.2D86D4403E0F4EB9.quest_desc: [
		"Le blazegold est un nouveau matériau ajouté par JDT. On l'obtient en faisant une propagation de glu sur des blocs d'or avec une glu de niveau 2 ou plus."
		""
		"Le blazegold donne la capacité intrinsèque Réparation par la lave aux outils et armures. Elle répare l'outil/l'armure quand on le lâche dans une source de lave, en transformant la source en obsidienne en échange de la réparation."
	]
	quest.2D86D4403E0F4EB9.title: "Blazegold"
	quest.2F86FB9E4D49E4B0.quest_desc: [
		"Améliorations valides :"
		"- Scanner de créatures"
	]
	quest.3138B83ABC2930F9.quest_desc: [
