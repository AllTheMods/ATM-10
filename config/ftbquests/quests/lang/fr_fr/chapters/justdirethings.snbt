	quest.1EA02BA24AF02256.quest_desc: ["Les modèles en alliage d'éclipse servent à améliorer les armures et outils en célestigemme en alliage d'éclipse, en gardant les enchantements et améliorations installées."]
	quest.1ECFA72CF2BA4B45.quest_desc: ["Un simple distributeur dont on peut régler la quantité lâchée à la fois."]
	quest.1FE7C52491E7499B.quest_desc: [
