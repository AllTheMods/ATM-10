	quest.200ECDC70E97D254.quest_desc: ["Le bidon de carburant est un réservoir qui peut remplir des conteneurs avec le fluide qu'il contient.\\n\\nIl a trois modes de remplissage :\\n\\n - Aucun\\n - Tous\\n - Just Dire Things"]
	quest.21147C8CBF98AEB4.quest_desc: [
