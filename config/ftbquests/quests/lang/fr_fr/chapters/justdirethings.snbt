{
	image.0461FDE296ADCEA2.title: "Tutoriel de Pilpoh : automatiser les cristaux temporels"
	quest.026C63594F813BCC.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :&r"
		""
		"Retire tous les effets négatifs du joueur une fois activée ; a un temps de recharge."
	]
	quest.0272E58516A0C284.quest_desc: [
		"Améliorations valides :"
		"- Mineur de minerai"
		"- Scanner de minerai &4&lDÉSACTIVÉ&r&f"
		"- Tondeuse"
		"- Balayeur de ciel"
		"- Abatteur d'arbres"
		"- Casseur de feuilles"
		"- Fonte automatique"
		"- Marteau"
		"- Téléporteur de butin"
	]
	quest.02B0CCD5607FF3B5.quest_desc: ["L'accesseur de joueur agit comme un coffre relié à l'inventaire du joueur. Avec l'interface, on peut configurer ses faces pour accéder à l'inventaire du joueur, à sa main secondaire ou à ses emplacements d'armure."]
	quest.02B8F50721F12CFF.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :"
		""
		"Empêche le joueur de subir des dégâts de chute."
	]
	quest.03ED9B0DFE8B4574.quest_desc: [
		"Améliorations valides :"
		"- Brouillard mental"
		"- Stupéfaction"
		""
		"Capacité intrinsèque :"
		"- Réparation par la lave"
	]
	quest.04A1D582003A0D9A.quest_desc: [
		"Améliorations valides :"
		"- Vitesse de course"
		"- Vitesse de marche"
	]
	quest.05056CAA64E3971B.quest_desc: [
		"&lType de capacité :&r passive"
		""
		"&lFonction de la capacité :&r"
		""
		"Les flèches tirées par l'arc appliquent un effet de potion selon votre cartouche de potion."
	]
	quest.05D8C6EF8FCD6250.quest_desc: [
		"La glu primogel est le premier niveau de glu ajouté par JDT et se fabrique avec des matériaux de base de l'Overworld."
		""
		"Fabrications débloquées :"
		"- Ferricore"
		"- Charbon primitif"
		""
		"Exemple de propagation de la glu :"
		""
		"{image:atm:textures/questpics/justdirethings/goo_spread_ferricore.png width:200 height:200 align:center}"
	]
	quest.07655CA904354E9E.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :"
		""
		"Casse l'herbe et les fleurs proches quand il est activé."
	]
	quest.079A415488A32076.quest_desc: ["La braise de blaze est un nouveau matériau ajouté par JDT. On l'obtient en faisant une propagation de glu sur des blocs de charbon primitif avec une glu de niveau 2 ou plus. Le minerai de braise de blaze est affecté par Fortune."]
	quest.09485B63483B7A15.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :"
		""
		"Fait temporairement perdre aux monstres hostiles proches leur agressivité envers le joueur ; a un temps de recharge."
	]
	quest.09D2137B4F42006E.quest_desc: ["La braise d'éclipse est un nouveau matériau ajouté par JDT. On l'obtient en faisant une propagation de glu sur des blocs de charbon de flamme du vide avec une glu de niveau 4. Le minerai de braise d'éclipse est affecté par Fortune."]
	quest.0A02DBE226C3F44E.quest_desc: [
		"Améliorations valides :"
		"- Brouillard mental"
		"- Stupéfaction"
		"- Vision nocturne"
		"- Suppression des effets négatifs"
		"- Anéantissement mental"
	]
	quest.0B485DB737A036E9.quest_desc: ["Le copieur de réglages de machine permet de copier les réglages d'une machine à l'autre."]
	quest.0B9BBE2A764631BF.quest_desc: ["L'échangeur simple peut téléporter les objets, blocs, créatures ou joueurs au-dessus de lui vers un autre échangeur simple auquel il est relié. Pour relier les échangeurs, utilisez la clé en ferricore."]
	quest.0C1D55AA9CC902BD.quest_desc: [
		"Améliorations valides :"
		"- Tondeuse"
		"- Balayeur de ciel"
		"- Fonte automatique"
		"- Marteau"
		"- Téléporteur de butin"
	]
	quest.0C2EC56133D3CC6C.quest_desc: [
		"&lType de capacité :&r active"
		""
		"&lFonction de la capacité :&r"
		""
		"Rend temporairement le joueur insensible aux dégâts une fois activée ; a un temps de recharge."
	]
	quest.0C9DD8E53A1B92C0.quest_desc: [
