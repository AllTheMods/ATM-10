	quest.5BA84F6282D9CAF1.quest_desc: ["L'&6Armure en Allthemodium&r, mais avec des bonus pour les sorts d'&e&lIron's Spells&r !"]
	quest.5BA84F6282D9CAF1.quest_subtitle: "24"
	quest.5BA84F6282D9CAF1.title: "&6Tenue de mage en Allthemodium"
	quest.5C83D5CDD980FD9A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_snout.png width:100 height:150 align:center}"]
	quest.5C83D5CDD980FD9A.quest_subtitle: "Vestiges de bastion"
	quest.5C83D5CDD980FD9A.title: "Garniture d'armure Groin"
	quest.5DDC15AAFD2CAF47.quest_desc: ["L'&bArmure en diamant&r est la suivante dans la chaîne &l&2vanilla&r ; c'est aussi généralement là qu'on commence à l'enchanter ! \\n\\nJe conseille Protection et ses variantes, pas besoin d'être difficile en moddé !"]
