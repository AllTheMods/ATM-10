	quest.654F5C84114A31A1.quest_desc: ["Armure d'&e&lIron's Spells&r très simple et pas chère, utile en début de partie !"]
	quest.654F5C84114A31A1.quest_subtitle: "20"
	quest.654F5C84114A31A1.title: "&4Tenue d'épouvantail"
	quest.65A529C8238E89F1.quest_desc: ["Grâce à &5&lMekanism&r, on peut maintenant faire de l'armure en &9Lapis-lazuli&r ! \\n\\nBon, elle est un peu nulle..."]
	quest.65A529C8238E89F1.quest_subtitle: "9"
	quest.65A529C8238E89F1.title: "&9Armure en lapis-lazuli"
	quest.65E733AACBE62EDB.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ward.png width:100 height:150 align:center}"]
	quest.65E733AACBE62EDB.quest_subtitle: "Cités antiques"
	quest.65E733AACBE62EDB.title: "Garniture d'armure Protection"
	quest.66B5A8D259E12BF5.quest_desc: ["Attendez, vous me dites qu'elle a les mêmes stats que la &cNetherite&r ? En plus de bonus de sorts ? \\n\\nPourquoi quelqu'un voudrait de la &cNetherite&r normale !"]
	quest.66B5A8D259E12BF5.quest_subtitle: "20"
	quest.66B5A8D259E12BF5.title: "&4Tenue de mage de bataille en netherite"
	quest.66C21934DAFFAC7F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_tide.png width:100 height:150 align:center}"]
	quest.66C21934DAFFAC7F.quest_subtitle: "Lâché par les gardiens anciens"
	quest.66C21934DAFFAC7F.title: "Garniture d'armure Marée"
	quest.672AC964851832EB.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_swamp.png width:100 height:150 align:center}"]
	quest.672AC964851832EB.title: "&7Argent des marais&r"
	quest.686EB173C94301C0.quest_desc: ["L'&bArmure de glace&r d'&e&lIron's Spells&r !"]
	quest.686EB173C94301C0.quest_subtitle: "20"
	quest.686EB173C94301C0.title: "&bTenue de cryomancien"
	quest.68DABFFB6B3E1A57.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_eye.png width:100 height:150 align:center}"]
	quest.68DABFFB6B3E1A57.quest_subtitle: "Forteresse"
	quest.68DABFFB6B3E1A57.title: "Garniture d'armure Œil"
	quest.690DB8BEF80617E5.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_utherium.png width:100 height:150 align:center}"]
	quest.690DB8BEF80617E5.title: "&cUthérium&r"
	quest.6A21228B0511FF85.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_thermal.png width:100 height:150 align:center}"]
	quest.6A21228B0511FF85.title: "&6Pierre de source thermale&r"
	quest.6B671CB07D046BEC.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_diamond.png width:100 height:150 align:center}"]
	quest.6B671CB07D046BEC.title: "&bDiamant&r"
	quest.6C5F9D0D447EFB9C.quest_desc: ["Vous pensiez que le &l&2vanilla&r, c'était tout ? \\n\\nL'&6Armure en Allthemodium&r a plus de points d'armure et de robustesse, plus une meilleure protection contre la magie et d'autres bonus décrits dans la page de quêtes &6&lAllthemodium&r ! \\n\\nAu fait, il faut de la &cNetherite&r pour la fabriquer."]
	quest.6C5F9D0D447EFB9C.quest_subtitle: "24"
	quest.6C5F9D0D447EFB9C.title: "&6Armure en Allthemodium"
	quest.6ED2CDD01659FD10.quest_desc: ["Cet ensemble a autant de points d'armure que le fer, mais il est meilleur en robustesse et en résistance au recul."]
	quest.6ED2CDD01659FD10.quest_subtitle: "15"
	quest.6ED2CDD01659FD10.title: "&7Armure en fer compressé"
	quest.6F335B4F3FD660E7.quest_desc: ["Celle-ci n'est pas drôle à obtenir. \\n\\nIl faut des &aLingots de métal de chevalier&r, qu'on obtient en faisant fondre des &aAmas d'éclats d'armure&r. \\n\\nOn obtient un &aAmas d'éclats d'armure&r en combinant 9 &aÉclats d'armure&r. \\n\\nLes &aÉclats d'armure&r tombent des gobelins de la &l&9Twilight Forest&r et, rarement, des crabes-casques."]
	quest.6F335B4F3FD660E7.quest_subtitle: "20"
	quest.6F335B4F3FD660E7.title: "&aArmure en métal de chevalier"
	quest.6F76DA3BBAE8337B.quest_desc: ["La meilleure armure d'&6&lAllthemodium&r : l'&5Unobtainium&r ! \\n\\nMaintenant avec 100% de résistance au recul et des stats plus élevées partout ! \\n\\nIl faut aussi l'&3Armure en vibranium&r pour la faire."]
	quest.6F76DA3BBAE8337B.quest_subtitle: "40"
	quest.6F76DA3BBAE8337B.title: "&5Armure en unobtainium"
	quest.71C552678A0F649F.quest_desc: ["L'&7Osmium&r apparaît autour de l'ardoise des abîmes et se mine avec du fer, mais il donne de meilleures stats que la &cNetherite&r !"]
	quest.71C552678A0F649F.quest_subtitle: "21"
	quest.71C552678A0F649F.title: "&7Armure en osmium"
	quest.7279700A93E8630B.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_unobtainium.png width:100 height:150 align:center}"]
	quest.7279700A93E8630B.title: "&5Unobtainium&r"
	quest.729DCB919A92B735.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_bolt.png width:100 height:150 align:center}"]
	quest.729DCB919A92B735.quest_subtitle: "Chambres d'épreuve"
	quest.729DCB919A92B735.title: "Garniture d'armure Éclair"
	quest.72D578686C47B154.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_red.png width:100 height:150 align:center}"]
	quest.72D578686C47B154.title: "&5Cristal de lumière stellaire rouge&r"
	quest.72DDA413D73E3235.quest_desc: ["Des stats bien plus élevées partout avec l'armure suivante d'&6&lAllthemodium&r : le &3Vibranium&r ! \\n\\nIl vous faudra l'&6Armure en Allthemodium&r pour la créer."]
	quest.72DDA413D73E3235.quest_subtitle: "32"
	quest.72DDA413D73E3235.title: "&3Armure en vibranium"
