	quest.459BB5B4CDB21773.quest_desc: ["L'&9Argent des marais&r se trouve dans les marais boueux d'&5&lEternal Starlight&r."]
	quest.459BB5B4CDB21773.quest_subtitle: "15"
	quest.459BB5B4CDB21773.title: "&9Armure en argent des marais"
	quest.4664AFCFB5618CEB.quest_desc: ["La &bGlacite&r se trouve dans les biomes froids d'&5&lEternal Starlight&r !"]
	quest.4664AFCFB5618CEB.quest_subtitle: "17"
	quest.4664AFCFB5618CEB.title: "&bArmure en glacite"
	quest.497D222F74A52DF5.quest_desc: ["Ça, j'aime ! Le fer est très courant, et son armure est formidable en début de partie. \\n\\nLes zombies et les squelettes n'ont quasiment aucune chance !"]
	quest.497D222F74A52DF5.quest_subtitle: "15"
	quest.498483750C18FCD6.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_regalium.png width:100 height:150 align:center}"]
	quest.498483750C18FCD6.title: "&eRégalium&r"
	quest.4A9CB8778D37049F.quest_desc: ["Il faudra un rituel d'éveil pour obtenir les objets qui permettent de faire un autre rituel d'éveil sur l'&4Armure en supremium&r. \\n\\nJe pense que ça vaut le coup : c'est la meilleure armure de &2&lMystical&r !"]
	quest.4A9CB8778D37049F.quest_subtitle: "36"
	quest.4A9CB8778D37049F.title: "&6Armure en supremium éveillé"
