	quest.79D3055DE0EEA6B0.quest_desc: ["L'&cArmure de feu&r d'&d&lArs Elemental&r !"]
	quest.79D3055DE0EEA6B0.quest_subtitle: "15"
	quest.79D3055DE0EEA6B0.title: "&cTenue de pyromancien"
	quest.7ADE27F9398D97F1.quest_desc: ["Celle-ci n'a rien de différent, pourquoi vous la regardez ?"]
	quest.7ADE27F9398D97F1.quest_subtitle: "10"
	quest.7ADE27F9398D97F1.title: "Armure d'abeille 2"
	quest.7B500E0577BDFF8F.quest_desc: ["Le &6Bronze&r est un mélange de &6Cuivre&r et d'étain. \\n\\nIl y a une douzaine de façons de faire cet alliage, je ne vous dirai pas laquelle est la bonne."]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6Armure en bronze"
	quest.7B76EC62E3F7E12C.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_aethersent.png width:100 height:150 align:center}"]
	quest.7B76EC62E3F7E12C.title: "&5Aethersent&r"
	quest.7C1D407CF67786F6.quest_desc: ["L'armure d'air d'&d&lArs Elemental&r !"]
	quest.7C1D407CF67786F6.quest_subtitle: "15"
	quest.7C1D407CF67786F6.title: "&fTenue d'aethermancien"
	quest.7F11ABFB2E21B7E4.quest_desc: ["L'armure est un élément très important de &l&2Minecraft&r : c'est ce qui vous protège. \\n\\nLes pièces d'armure donnent des points d'armure différents. Ce sont eux qui déterminent l'efficacité de votre armure, plus il y en a, mieux c'est !\\n\\nLa plupart des armures peuvent être décorées avec des garnitures : utilisez une pièce d'armure avec une garniture et un objet de couleur pour changer son apparence !"]
	quest.7F11ABFB2E21B7E4.title: "&l&bArmures de base&r"
	quest.7F8B6D5F360D985A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_fiery.png width:100 height:150 align:center}"]
	quest.7F8B6D5F360D985A.title: "&eArdent"
	quest.7FABB77A60E7962C.quest_desc: ["En infusant de l'obsidienne avec des &bDiamants&r, on obtient de la poudre d'obsidienne raffinée ! \\n\\nEnsuite, on peut y compresser de l'&7Osmium&r pour l'obtenir en lingot. \\n\\nAprès ça, on peut transformer ces lingots en armure aux stats meilleures que celles de l'&6Armure en Allthemodium&r !"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5Armure en obsidienne raffinée"
