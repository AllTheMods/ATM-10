	quest.4DF683461225690F.title: "&7Fer&r"
	quest.50429F57480F44DA.quest_desc: ["La &cPierre de source thermale&r apparaît dans des bassins chauds, rares dans &5&lEternal Starlight&r !"]
	quest.50429F57480F44DA.quest_subtitle: "16"
	quest.50429F57480F44DA.title: "&cArmure en pierre de source thermale"
	quest.5064D5F99E2C69C8.quest_desc: ["Version améliorée de l'&9Imperium&r."]
	quest.5064D5F99E2C69C8.quest_subtitle: "29"
	quest.5064D5F99E2C69C8.title: "&4Armure en supremium"
	quest.50B127137AA9E660.quest_desc: ["Enfin, le &6Cuivre&r sert vraiment à quelque chose !"]
	quest.50B127137AA9E660.quest_subtitle: "13"
	quest.50B127137AA9E660.title: "&6Armure en cuivre"
	quest.52A29269A23F85B3.quest_desc: ["La &9Tenue de yéti&r nécessite de la fourrure de yéti alpha qui, vous l'avez deviné, ne tombe que des yétis alphas. \\n\\nAu moins, la tenue ralentit vos ennemis en les gelant !"]
	quest.52A29269A23F85B3.quest_subtitle: "20"
	quest.52A29269A23F85B3.title: "&9Tenue de yéti"
	quest.52AFABA08674B6A8.quest_desc: ["L'&3Armure en vibranium&r, mais avec des bonus pour les sorts d'&d&lArs Nouveau&r !"]
