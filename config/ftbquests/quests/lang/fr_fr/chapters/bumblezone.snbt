	task.386645685E595D4D.title: "ALERTE PHOBIE"
	task.4E6F5A4B1FE8CB23.title: "Tuer 5 Rootmin"
	task.5F9F725E2AD5FD3C.title: "Tous droits réservés"
	task.646B54EB48AFB6A4.title: "Tuer 10 variantes d'abeilles"
