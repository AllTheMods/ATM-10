	quest.0A64D0937A5F7513.title: "Canne à pêche en or"
	quest.0EFF1AA37772156B.quest_desc: ["Ce bloc fournit de l'eau à la cuisine multibloc.\\n\\nIl peut aussi fournir de l'eau à l'infini en la pompant par câbles ou tuyaux."]
	quest.0EFF1AA37772156B.quest_subtitle: "1 bloc suffit !"
	quest.0EFF1AA37772156B.title: "L'évier = de l'eau infinie"
	quest.13AFCD3B6F62B986.quest_desc: ["Donne des recettes de glace et de neige !"]
	quest.13AFCD3B6F62B986.quest_subtitle: "Ice, Ice, Baby !"
	quest.13AFCD3B6F62B986.title: "Amélioration glace"
	quest.1515B32545F51266.quest_desc: ["Permet de brancher de l'énergie sur la cuisinière."]
	quest.1515B32545F51266.title: "Amélioration de chauffage"
	quest.1697CC05D08B388D.quest_subtitle: "Délicieux poulet frit !"
	quest.1697CC05D08B388D.title: "Les poules doivent partir"
	quest.16D0F1E3CEB60ABF.title: "Canne à pêche en fer"
	quest.1827DEEA2DF1B144.quest_desc: ["Bienvenue dans le chapitre Nourriture et agriculture !\\n\\nVous y trouverez différentes façons de cultiver et de préparer de la nourriture !"]
	quest.1827DEEA2DF1B144.title: "Nourriture et Agriculture"
	quest.18EADBAFC932F864.quest_desc: ["Pour tondre les moutons, il faut des cisailles, on ne pourrait pas avoir de laine autrement... pas vrai ?"]
	quest.18EADBAFC932F864.quest_subtitle: "Partie pacifiste"
	quest.18EADBAFC932F864.title: "C'est l'heure de la tonte"
	quest.1D2EF12FD7FDD217.quest_desc: ["Les poules les pondent naturellement. Enfin, ce n'est pas vraiment considéré comme naturel...\\n\\nJe suppose que les poules font juste... de l'&oœuf-ercice !!!&r."]
	quest.1D2EF12FD7FDD217.quest_subtitle: "...ou pas ?"
	quest.1D2EF12FD7FDD217.title: "Je ne vais pas faire de jeu de mots sur les œufs"
	quest.1D48298525EEADC9.quest_desc: ["Vous devriez déjà avoir tout ce qu'il vous faut."]
	quest.1D48298525EEADC9.quest_subtitle: "Versez-moi du sucre !"
	quest.1D48298525EEADC9.title: "Vous êtes trop chou"
	quest.1DCAA0310AA55F1C.quest_desc: ["Mais d'habitude il ferme à 17 h, alors qui s'en soucie ?"]
	quest.1DCAA0310AA55F1C.quest_subtitle: "Willy serait fier"
	quest.1DCAA0310AA55F1C.title: "Les débuts d'un pêcheur"
	quest.1F114EB0AAB86DB4.quest_desc: ["Les marchés vous donnent un villageois qui peut tout vous vendre, si vous avez assez d'émeraudes.\\n\\nPetit secret : c'est en général juste 1 émeraude par objet, et heureusement, il a TOUT."]
	quest.1F114EB0AAB86DB4.quest_subtitle: "Le villageois peut apparaître de plus d'une façon"
	quest.1F114EB0AAB86DB4.title: "Acheter des fournitures agricoles"
	quest.2786D5AC19163524.quest_desc: ["Ce bloc permet les recettes de cuisson dans votre cuisine multibloc !"]
	quest.2786D5AC19163524.quest_subtitle: "Pas besoin de minuteur"
	quest.2786D5AC19163524.title: "Chéri, il y a un four dans la cuisine"
	quest.28C9EDBF6607E180.quest_desc: ["Ce bloc fait partie d'une cuisine multibloc.\\n\\nIl vous montre toutes les recettes possibles avec la nourriture de votre inventaire, ou stockée dans la cuisine multibloc.\\n\\nVous pouvez enfin créer une jolie cuisine dans Minecraft."]
	quest.28C9EDBF6607E180.quest_subtitle: "Betty White est née avant le pain de mie en tranches"
	quest.28C9EDBF6607E180.title: "LA MEILLEURE INVENTION DEPUIS LE PAIN EN TRANCHES"
	quest.2E9C035EEE7E5C34.quest_desc: ["La laisse classique. Utilisez-la pour amener des animaux dans votre zone de ferme.\\n\\nCe n'est pas la même chose que le minerai (en anglais, « lead » veut aussi dire plomb)."]
	quest.2E9C035EEE7E5C34.quest_subtitle: "Allez, avance, petit toutou"
	quest.2E9C035EEE7E5C34.title: "On fait ça à l'ancienne"
	quest.361DFDB1E1352D6B.quest_desc: ["Trouvez de la canne à sucre près de l'eau."]
	quest.361DFDB1E1352D6B.title: "Sugar Sugar"
	quest.37CA6F9F0226F10E.quest_desc: ["Ce bloc stocke les objets pour cuisiner.\\n\\nVous pouvez aussi poser dessus d'autres éléments de la cuisine multibloc, comme des grille-pain et une vache en bocal."]
	quest.37CA6F9F0226F10E.quest_subtitle: "Il nous faut plus d'espace pour cuisiner"
	quest.37CA6F9F0226F10E.title: "Besoin de plus d'espace pour cuisiner ?"
	quest.3EA883C0BB7BD38F.quest_desc: ["Récoltons des morceaux de laine !"]
	quest.3EA883C0BB7BD38F.quest_subtitle: "Dont la toison était... arc-en-ciel ?"
	quest.3EA883C0BB7BD38F.title: "Mary avait un petit agneau"
	quest.43021923E220CF68.quest_desc: ["Pour transformer la terre en terre labourée, il vous faut une houe."]
	quest.43021923E220CF68.quest_subtitle: "Attendez d'avoir des machines pour ça..."
	quest.43021923E220CF68.title: "Le planteur"
	quest.45F83C2750F70F9B.quest_desc: ["Allez-y, mettez un livre dans un four et faites-le fondre."]
	quest.45F83C2750F70F9B.quest_subtitle: "Ça ne prendra absolument pas feu..."
	quest.45F83C2750F70F9B.title: "Fabriquer une cuisine, avec un livre"
	quest.47764EFC822E462A.quest_desc: ["Ce bloc produit du lait avec le temps et active les recettes au lait de la cuisine multibloc.\\n\\nPour mettre une vache dans le bocal, placez le bocal dans un trou. Attirez la vache pour qu'elle tombe dans ce trou au-dessus du bocal, puis faites-lui tomber une enclume dessus.\\n\\nJe ne sais pas en quoi est fait ce verre, mais il est plus solide que ma relation avec le poulet."]
	quest.47764EFC822E462A.quest_subtitle: "Des pouvoirs de traite phénoménaux... dans un minuscule espace de vie"
	quest.47764EFC822E462A.title: "Une vache en bocal"
	quest.511562EA5811306B.title: "Canne à pêche en diamant"
	quest.55C4824DAD905512.quest_desc: ["Cette quête a été créée par le personnel de &6AllTheMods&r ou un contributeur de la communauté &2Community contributor&r pour être utilisée dans les modpacks AllTheMods.\\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut être utilisée dans aucun pack public non publié par l'équipe &6AllTheMods&r sans autorisation explicite.\\n\\nCette quête est intentionnellement masquée. Si vous la voyez, c'est que vous êtes en mode édition."]
	quest.56550CD12C681B0F.quest_desc: ["On trouve des &2graines de lin&r qui poussent dans les champs d'herbe. Le lin est super si vous avez besoin de beaucoup de ficelle en début de partie."]
	quest.56550CD12C681B0F.quest_subtitle: "Lin dedans, lin dehors"
	quest.58495CFBF4F20CE9.quest_desc: ["Fonctionne comme le plan de travail de cuisine, mais en hauteur.\\n\\nEt on ne peut rien poser dessus."]
	quest.58495CFBF4F20CE9.quest_subtitle: "Tellement de place pour les activités !"
	quest.58495CFBF4F20CE9.title: "Encore plus de rangement"
	quest.58D5BD3106BFD94A.quest_desc: ["Fabriquez la version suivante du livre. Je vous promets que ça vaut le coup.\\n\\nJe vous rends même un diamant."]
	quest.58D5BD3106BFD94A.quest_subtitle: "Ça vaut totalement le coup"
	quest.58D5BD3106BFD94A.title: "Cuisiner avec la puissance des diamants"
	quest.5A1DCD6C7F712A78.title: "Canne à pêche en neptunium"
	quest.635620A03E3505BF.quest_desc: ["Je ne veux pas savoir comment vous les avez eus."]
