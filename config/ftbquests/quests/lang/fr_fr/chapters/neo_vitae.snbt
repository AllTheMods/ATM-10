{
	quest.02B5E57E9E803F78.quest_desc: [
		"L'armure sensible se fixe sur votre corps et apprend. Elle gagne des niveaux comme les outils."
		""
		"Une gamme d'équipement facultative qui va de pair avec les armes sensibles."
	]
	quest.02B5E57E9E803F78.quest_subtitle: "Une armure qui a son avis"
	quest.02B5E57E9E803F78.title: "La coque sensible"
	quest.02DF776F9A4C9CB1.quest_desc: [
		"Un &6Daemonium Pestis&r rôde dans les couloirs profonds : le porteur de peste, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.02DF776F9A4C9CB1.quest_subtitle: "L'un des dix du royaume"
	quest.02DF776F9A4C9CB1.title: "Daemonium Pestis"
	quest.07C69759A6163F2D.quest_desc: [
		"Les pierres rituelles élémentaires (air, terre, feu et Deus) se placent autour d'une &6pierre rituelle maîtresse&r. C'est le motif qui décide de l'effet."
		""
		"Fabriquez la pierre maîtresse et quelques pierres de chaque élément."
	]
	quest.07C69759A6163F2D.quest_subtitle: "Le motif fait le rituel"
	quest.07C69759A6163F2D.title: "Les pierres et la maîtresse"
	quest.09DEA44456CD5010.quest_desc: [
		"Le rituel de niveau II &6Franchir la frontière du Royaume démoniaque&r déchire le voile et laisse derrière lui un &lpilier d'inversion&r. Touchez-le pour passer de l'autre côté."
		""
		"C'est la porte de l'&6antichambre&r, la poche d'apprentissage du Royaume démoniaque."
	]
	quest.09DEA44456CD5010.quest_subtitle: "Le niveau II fait la découpe"
	quest.09DEA44456CD5010.title: "Percer le voile"
	quest.0ACA535425EA6A81.quest_desc: [
		"Chaque rituel demande un &6cristal d'activation&r pour s'allumer : le faible pour les rites de bas niveau, l'éveillé et le Divinus pour les plus puissants, construits avec des pierres Deus."
		""
		"Le cristal faible est accessible tôt et peu coûteux. Les plus forts demandent de travailler dans le royaume. Facultatif."
	]
	quest.0ACA535425EA6A81.quest_subtitle: "Les clés des rituels, en somme"
	quest.0ACA535425EA6A81.title: "Cristaux d'activation"
	quest.0BA0AA8A6F07D383.quest_desc: [
		"Fabriquez un &6outil de scribe arcanique&r à la Tabula Vitae ou à l'autel. Il trace les motifs dont sont faits les cercles alchimiques."
		""
		"Frappez le sol avec et regardez les lignes s'illuminer."
	]
	quest.0BA0AA8A6F07D383.quest_subtitle: "La craie du pouvoir"
	quest.0BA0AA8A6F07D383.title: "L'outil du scribe"
	quest.0E3971A4FB822ED0.quest_desc: [
		"Autel complet, orbes liés, aura vibrante, royaume conquis : vous tenez tous les outils que la Vitaemancie peut offrir."
		""
		"Le chapitre s'arrête ici. Pas le mod : le réseau, les rituels et le donjon continuent de rapporter."
	]
	quest.0E3971A4FB822ED0.quest_subtitle: "L'apogée, c'est un mode de vie"
	quest.0E3971A4FB822ED0.title: "Maître vitaemancien"
	quest.11721D2D8F03C20F.quest_desc: [
		"Une &6gemme de Spiritus mineure&r contient 64 Spiritus et absorbe les particules qui tombent à proximité."
		""
		"Les niveaux suivants (inférieure 256, commune 1 024, supérieure 4 096, suprême 16 384) se forgent les uns à partir des autres."
	]
	quest.11721D2D8F03C20F.quest_subtitle: "64 petites âmes"
	quest.11721D2D8F03C20F.title: "La gemme mineure"
	quest.11F6669733F1420B.quest_desc: [
		"L'&6orbe de vitae Magus&r : &l1 000 000 d'EV&r d'Anima. La réserve à sept chiffres."
		""
		"C'est autour de cet orbe que le prix des rituels a été pensé."
	]
	quest.11F6669733F1420B.quest_subtitle: "L'âme à sept chiffres"
	quest.11F6669733F1420B.title: "L'orbe du maître"
	quest.16F8403D1836717A.quest_desc: [
		"Tenez n'importe quel orbe en &lmain secondaire&r et utilisez-le : une barrière de cristal se dresse devant vous et absorbe les attaques à distance (flèches, tridents, boules de feu)."
		""
		"Elle consomme 50 EV par seconde et ne réagit qu'aux menaces à distance. Les attaques au corps à corps passent à travers. Facultatif."
	]
	quest.16F8403D1836717A.quest_subtitle: "Flèches non admises"
	quest.16F8403D1836717A.title: "La protection sanguine"
	quest.18CD5EBD9682E855.quest_desc: [
		"Les runes de niveau IV font nettement grimper les chiffres : vitesse IV, capacité IV, multiplicateurs de sacrifice."
		""
		"Le prix d'entrée monte avec le gain."
	]
	quest.18CD5EBD9682E855.quest_subtitle: "Vitesse IV, capacité IV"
	quest.18CD5EBD9682E855.title: "Niveau IV : le quatrième cercle"
	quest.19891A8F26FBAB0A.quest_desc: [
		"Le &6sceau de divination&r lit à voix haute votre autel et votre Anima : niveau de remplissage, travail en cours, ce qui manque à l'autel."
		""
		"Gardez-en un sur vous pendant que vous apprenez le système."
	]
	quest.19891A8F26FBAB0A.quest_subtitle: "Le sceau qui raconte tout"
	quest.19891A8F26FBAB0A.title: "Les yeux du cercle"
	quest.1B6642BBDAEB2BD5.quest_desc: [
		"L'&6orbe de vitae Veneficus&r relève le plafond à &l150 000 EV&r. À partir d'ici, les rituels et le travail à l'athanor coûtent vite cher."
		""
		"Continuez à récolter : les anciens orbes se remplissent toujours très bien."
	]
	quest.1B6642BBDAEB2BD5.quest_subtitle: "Six chiffres"
	quest.1B6642BBDAEB2BD5.title: "L'orbe du magicien"
	quest.1BBABB2106D321A4.quest_desc: [
		"Placez votre orbe dans un &6lien d'orbe de vitae&r à côté de l'autel, et le réseau charge votre Anima en continu."
		""
		"La façon la plus simple de garder les rituels alimentés sans rien faire. Facultatif."
	]
	quest.1BBABB2106D321A4.quest_subtitle: "Charger son âme sans les mains"
	quest.1BBABB2106D321A4.title: "Le lien d'orbe"
	quest.1C43D98AB4E51F15.quest_desc: [
		"L'&6autel d'encens&r se pose dans un jardin de blocs de tranquillité. Il accorde le &6Sacrifice béni&r, un gros bonus sur vos propres offrandes."
		""
		"Posez des anneaux de chemin et des blocs de tranquillité autour ; le site de planification du jardin montre les calculs."
	]
	quest.1C43D98AB4E51F15.quest_subtitle: "Ça sent la victoire"
	quest.1C43D98AB4E51F15.title: "L'autel d'encens"
	quest.1CBBEFE4A84ABA45.quest_desc: [
		"Un &6conduit de Spiritus&r sonde 16 blocs dans chaque direction cardinale et fait descendre l'aura là où il y en a moins : il équilibre sans jamais tout vider."
		""
		"Enchaînez-en plusieurs depuis un chunk saturé jusqu'à votre lieu de travail. Facultatif."
	]
	quest.1CBBEFE4A84ABA45.quest_subtitle: "De la plomberie, mais qui fait peur"
	quest.1CBBEFE4A84ABA45.title: "Déplacer l'aura"
	quest.1F7ACF813D8804A6.quest_desc: [
		"Un &6cercle alchimique&r prend deux offrandes déposées à l'intérieur. Certaines paires fabriquent des objets, d'autres déclenchent des effets sur place."
		""
		"Votre premier sceau, le &6sceau de divination&r, vient d'une recette de cercle."
	]
	quest.1F7ACF813D8804A6.quest_subtitle: "Deux offrandes, un vœu"
	quest.1F7ACF813D8804A6.title: "Cercle d'intention"
	quest.22CB17C102BB6773.quest_desc: [
		"De retour chez vous, transformez le fruit de Tau en Tau saturé et en huile de Tau ; le jardin d'encens s'en abreuve."
		""
		"L'huile sert aussi de réactif pour les meilleurs flacons."
	]
	quest.22CB17C102BB6773.quest_subtitle: "Du carburant pour le jardin"
	quest.22CB17C102BB6773.title: "Raffiner le Tau"
	quest.22D7D3FBACEBE7FB.quest_desc: [
		"Les sceaux de &6nécromancie&r font lever des serviteurs (zombies momifiés, squelettes, vagabonds) qui se battent pour vous jusqu'à ce que vous les renvoyiez."
		""
		"Ils coûtent de l'Anima tant qu'ils restent debout. Facultatif."
	]
	quest.22D7D3FBACEBE7FB.quest_subtitle: "Employé du mois : les morts"
	quest.22D7D3FBACEBE7FB.title: "Les morts à votre service"
	quest.2355A35C8F4C6A30.quest_desc: [
		"Le troisième cercle ouvre des niveaux de runes plus élevés et les recettes qui vont avec."
		""
		"À partir d'ici, l'autel devient une véritable usine."
	]
	quest.2355A35C8F4C6A30.quest_subtitle: "L'usine est débloquée"
	quest.2355A35C8F4C6A30.title: "Niveau III : des runes plus profondes"
	quest.24C0619EB4A13CA3.quest_desc: [
		"Les &6nœuds de routage&r marquent les entrées et les sorties ; les conduits portent le flux ; un &6nœud de routage maître&r arbitre le tout."
		""
		"Commencez petit : un producteur, un consommateur. Facultatif."
	]
	quest.24C0619EB4A13CA3.quest_subtitle: "De la plomberie, mais qui fait peur"
	quest.24C0619EB4A13CA3.title: "Tracer les veines"
	quest.2774F4E92DC99642.quest_desc: [
		"Le Sacrifice béni donne beaucoup plus de valeur à chaque offrande par clic droit, puis vous fait tomber dans l'&lEffilochage d'âme&r, un temps de recharge qui réduit les offrandes suivantes."
		""
		"Enchaînez le cycle : bénédiction, offrande, repos. Facultatif."
	]
	quest.2774F4E92DC99642.quest_subtitle: "Ça sent la victoire"
	quest.2774F4E92DC99642.title: "Effilochage d'âme"
	quest.298458E916F65407.quest_desc: [
		"L'aura fonctionne &lpar chunk&r : le Spiritus brûlé dans un chunk ne remplit que ce chunk, avec un plafond de 100 par aspect."
		""
		"Presque toutes les machines du milieu de partie puisent dans l'aura locale, pas dans votre inventaire."
	]
	quest.298458E916F65407.quest_subtitle: "L'air du coin, hanté"
	quest.298458E916F65407.title: "L'aura entre les mondes"
	quest.29953F9E8F0A0D7B.quest_desc: [
		"Un &6Daemonium Cruoris&r rôde dans les couloirs profonds : le chasseur de sang, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.29953F9E8F0A0D7B.quest_subtitle: "L'un des dix du royaume"
	quest.29953F9E8F0A0D7B.title: "Daemonium Cruoris"
	quest.29B003254299103C.quest_desc: [
		"Les gemmes supérieures et suprêmes font tenir des réservoirs entiers dans un seul emplacement d'inventaire."
		""
		"Le niveau supérieur demande une Tabula Spiritus, un éclat de sang faible et un cristal de Spiritus. Facultatif."
	]
	quest.29B003254299103C.quest_subtitle: "De plus grandes bouteilles"
	quest.29B003254299103C.title: "Gravir l'échelle"
	quest.2C0A6D0EC40C766A.quest_desc: [
		"Un &6Daemonium Ignis&r rôde dans les couloirs profonds : celui qui brûle, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.2C0A6D0EC40C766A.quest_subtitle: "L'un des dix du royaume"
	quest.2C0A6D0EC40C766A.title: "Daemonium Ignis"
	quest.2C178EF05E31AE9A.quest_desc: [
		"À l'intérieur, chaque &6sceau de donjon&r demande une &lclé de donjon simple&r : on n'en trouve que dans ces coffres, et on ne peut pas en fabriquer. Une clé apportée de l'extérieur n'ouvre rien."
		""
		"Les coffres d'ici donnent de l'équipement enchanté, des onctions, du Spiritus et les premières récoltes de Tau."
	]
	quest.2C178EF05E31AE9A.quest_subtitle: "Les clés se trouvent, elles ne se fabriquent pas"
	quest.2C178EF05E31AE9A.title: "L'antichambre"
	quest.2E22A601DC126B7B.quest_desc: [
		"Le &6Spiritus&r est la seconde économie : une monnaie d'âme au lieu du sang. Les créatures tuées après avoir été marquées à la dague et les lames sensibles en rapportent."
		""
		"Le Spiritus en vrac encombre tout : il lui faut une gemme."
	]
	quest.2E22A601DC126B7B.quest_subtitle: "Le deuxième portefeuille"
	quest.2E22A601DC126B7B.title: "Des cristaux à partir de rien"
	quest.332F3C08E4014F63.quest_desc: [
		"L'&6accumulateur spirituel&r est un réservoir flottant de 1 000 Spiritus d'un seul aspect, dans lequel le réseau de routage peut puiser."
		""
		"L'athanor le forge à partir d'une particule d'Animus, d'une gemme commune, d'une Tabula Spiritus, d'un éclat brut, d'un réservoir de sang et de 2 000 mB d'EV, dans un chunk contenant 45 de Spiritus brut."
	]
	quest.332F3C08E4014F63.quest_subtitle: "Mille dans le réservoir"
	quest.332F3C08E4014F63.title: "L'accumulateur spirituel"
	quest.3617A216FF8BC06C.quest_desc: [
		"Le donjon se reconstruit comme un nouveau puzzle à chaque visite : mêmes salles, nouvelle carte."
		""
		"Guettez les &6distorsions spatiales&r : des salles aux vrilles de vide qui cachent l'entrée des mines ou la porte du contremaître. Le royaume lui-même vous prévient quand elles apparaissent."
	]
	quest.3617A216FF8BC06C.quest_subtitle: "Mêmes salles, nouvelle horreur"
	quest.3617A216FF8BC06C.title: "Le Royaume sans fin"
	quest.36BA45620B2BED5B.quest_desc: [
		"Les &6runes de l'orbe&r étendent votre capacité d'Anima au-delà de ce que permet même l'orbe de vitae Divinus."
		""
		"Si l'orbe le plus puissant ne suffit toujours pas, c'est le levier suivant. Facultatif."
	]
	quest.36BA45620B2BED5B.quest_subtitle: "Étirer la batterie"
	quest.36BA45620B2BED5B.title: "Runes de l'orbe"
	quest.383F7F715C60252B.quest_desc: [
		"Le niveau II agrandit encore l'autel. Plus d'emplacements de runes, c'est votre premier vrai montage : un bon mélange de vitesse et de capacité."
		""
		"Il débloque aussi les recettes d'autel qui ouvrent le milieu du mod."
	]
	quest.383F7F715C60252B.quest_subtitle: "Plus de place pour l'ambition"
	quest.383F7F715C60252B.title: "Niveau II : le deuxième cercle"
	quest.3CA324BE8531F253.quest_desc: [
		"L'&6éclat de sang faible&r se travaille à l'athanor : on le produit une fois la machine en place."
		""
		"Il ouvre l'accès à la gemme supérieure et aux recettes au-dessus."
	]
	quest.3CA324BE8531F253.quest_subtitle: "Petit éclat, grandes portes"
	quest.3CA324BE8531F253.title: "L'éclat de sang faible"
	quest.3E563EED3D77FC35.quest_desc: [
		"Un &6Daemonium Animaris&r rôde dans les couloirs profonds : le chasseur d'aspect de l'âme, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.3E563EED3D77FC35.quest_subtitle: "L'un des dix du royaume"
	quest.3E563EED3D77FC35.title: "Daemonium Animaris"
	quest.3EC65211B94462DA.quest_desc: [
		"La &6particule d'Animus&r ne se trouve que dans le butin du royaume. C'est la pièce sans laquelle on ne peut pas forger l'accumulateur spirituel."
		""
		"Gardez toutes celles que vous trouvez. Rappel facultatif."
	]
	quest.3EC65211B94462DA.quest_subtitle: "Butin rare, ne la perdez pas"
	quest.3EC65211B94462DA.title: "La particule d'Animus"
	quest.3ECB062B99C4E4A5.quest_desc: [
		"Le &6téléporteur&r échange des blocs entre deux points marqués, ou vous transporte de l'un à l'autre."
		""
		"Un outil de fin de partie pour déplacer des générateurs, des cultures et vous-même. Facultatif."
	]
	quest.3ECB062B99C4E4A5.quest_subtitle: "Un déménagement magique"
	quest.3ECB062B99C4E4A5.title: "Le téléporteur"
	quest.3F2FE793CE5052F0.quest_desc: [
		"Le &6réseau de routage&r est la logistique du mod : des nœuds, des conduits et des routeurs qui déplacent objets, fluides et Spiritus entre les machines."
		""
		"C'est grâce à lui que l'autel, le creuset et les gemmes n'ont plus besoin de vous."
	]
	quest.3F2FE793CE5052F0.quest_subtitle: "Des tuyaux qui ont leur avis"
	quest.3F2FE793CE5052F0.title: "Le réseau de routage"
	quest.40C32A4F6DE4B782.quest_desc: [
		"L'&6athanor&r est le troisième grand poste de travail : un creuset qui prépare les éclats, les accumulateurs et les gros réactifs nourris par l'aura."
		""
		"Il demande de l'EV, de l'aura et des matériaux en même temps. Lisez la jauge avant de l'allumer."
	]
	quest.40C32A4F6DE4B782.quest_subtitle: "Poste de travail numéro trois"
	quest.40C32A4F6DE4B782.title: "L'athanor"
	quest.419DB4A2A5A5FC58.quest_desc: [
		"Le &6contremaître&r dirige les chantiers profonds. C'est le boss du royaume."
		""
		"Tuez-le pour son précieux butin : la démonite et les pièces qui servent aux travaux de métal forgé aux enfers."
	]
	quest.419DB4A2A5A5FC58.quest_subtitle: "C'est lui le patron"
	quest.419DB4A2A5A5FC58.title: "Le contremaître"
	quest.4393ADF3E4C8B0D4.quest_desc: [
		"Le Spiritus existe sous cinq aspects : &6Brut, Ruina, Invictus, Nihilum, Vindicta&r. Chaque travail demande l'aspect qui lui convient."
		""
		"L'aura les compte séparément ; saturer un chunk avec un aspect, c'est ainsi que commence le travail par aspect. Leçon facultative."
	]
	quest.4393ADF3E4C8B0D4.quest_subtitle: "Choisissez votre saveur"
	quest.4393ADF3E4C8B0D4.title: "Les cinq aspects"
	quest.4476319FD2019185.quest_desc: [
		"Un &6Daemonium Voraxis&r rôde dans les couloirs profonds : l'éternel affamé, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.4476319FD2019185.quest_subtitle: "L'un des dix du royaume"
	quest.4476319FD2019185.title: "Daemonium Voraxis"
	quest.44DC32A27B02CDB8.quest_desc: [
		"Les sceaux de &6rétention&r et des &6trésors liés&r transforment votre sceau en poches supplémentaires."
		""
		"Pratique pour les longues expéditions au donjon, où l'inventaire se remplit vite. Facultatif."
	]
	quest.44DC32A27B02CDB8.quest_subtitle: "Des poches, mais magiques"
	quest.44DC32A27B02CDB8.title: "Rangement portable"
	quest.459F6257FB16AC47.quest_desc: [
		"Le dernier cercle achève l'Ara Vitae. Chaque famille de runes a désormais sa place la plus haute."
		""
		"L'autel qui n'était au départ qu'un simple bloc est devenu une cathédrale."
		""
		"L'autel qui n'était au départ qu'un simple bloc est devenu une cathédrale."
	]
	quest.459F6257FB16AC47.quest_subtitle: "Une cathédrale de runes"
	quest.459F6257FB16AC47.title: "Niveau V : le dernier cercle"
	quest.46122A9389875512.quest_desc: [
		"Les &6rituels&r sont des motifs tracés avec des pierres rituelles autour d'une pierre rituelle maîtresse : de grands effets ponctuels, des fermes à l'ouverture du royaume."
		""
		"Le concepteur de rituels les prépare ; le devin rituel vous dit ce qu'un motif demande."
	]
	quest.46122A9389875512.quest_subtitle: "Grands effets, dessins encore plus grands"
	quest.46122A9389875512.title: "Rites et rituels"
	quest.4694863405CFB97B.quest_desc: [
		"Les &6mines&r sont le niveau profond du royaume : des portes à clé de mine, des Daemonium plus féroces et les minerais qui valent le déplacement."
		""
		"Les clés de mine se trouvent dans le butin du Royaume sans fin."
	]
	quest.4694863405CFB97B.quest_subtitle: "Là où se cache le bon minerai"
	quest.4694863405CFB97B.title: "Les mines"
	quest.4840F41B536529E3.quest_desc: [
		"Une &6dague de lancer enduite&r porte une onction sur sa lame : un seul lancer administre à la cible ce dont elle est enduite."
		""
		"Pour affaiblir ce qui ne reste pas en place le temps d'une deuxième dague. Facultatif."
	]
	quest.4840F41B536529E3.quest_subtitle: "Il suffit de l'enduire"
	quest.4840F41B536529E3.title: "Une pointe plus acérée"
	quest.499B8461225D3E74.quest_desc: [
		"La Tabula prépare des &6onctions&r : des enchantements temporaires appliqués sur les lames et les outils le temps d'un travail."
		""
		"Du tranchant pour une nuit de boss, de la fortune pour une expédition minière. Facultatif."
	]
	quest.499B8461225D3E74.quest_subtitle: "Un tranchant temporaire"
	quest.499B8461225D3E74.title: "Les onctions"
	quest.4AE0C2D2D8D145F6.quest_desc: [
		"Le royaume s'enrichit avec la profondeur : des sceaux plus profonds, de meilleurs coffres, la particule d'Animus et le boss."
		""
		"Un parcours facultatif pour la partie difficile. Facultatif."
	]
	quest.4AE0C2D2D8D145F6.quest_subtitle: "Les clés se trouvent, elles ne se fabriquent pas"
	quest.4AE0C2D2D8D145F6.title: "Exploiter les profondeurs"
	quest.4EBC5B191A7B12D9.quest_desc: [
		"Les runes entourent l'autel et chaque famille le modifie : vitesse, capacité, sacrifice, orbe et d'autres encore. Toutes commencent sous forme de &6runes vierges&r."
		""
		"Fabriquez-en une série ; les prochains cercles en auront besoin."
		""
		"Fabriquez-en une série dès maintenant ; les prochains cercles en auront besoin."
	]
	quest.4EBC5B191A7B12D9.quest_subtitle: "Toute cathédrale a besoin de briques"
	quest.4EBC5B191A7B12D9.title: "Runes vierges"
	quest.4EE580588CC10C4E.quest_desc: [
		"La &6démonite&r se trouve dans les profondeurs du royaume : du gravier, des fragments et des morceaux bruts du métal propre au royaume."
		""
		"C'est le minerai sur lequel repose le prix de toute la fin de partie."
	]
	quest.4EE580588CC10C4E.quest_subtitle: "Le métal du royaume"
	quest.4EE580588CC10C4E.title: "Démonite"
	quest.4F77EDCEB49EB67F.quest_desc: [
		"Les runes de l'orbe et la vitesse de l'autel se cumulent. Un cercle au maximum suffit à alimenter même les consommations de niveau Divinus."
		""
		"Un réglage facultatif pour les plus patients. Facultatif."
	]
	quest.4F77EDCEB49EB67F.quest_subtitle: "Les intérêts composés, version sang"
	quest.4F77EDCEB49EB67F.title: "Doubler la mise sur les runes"
	quest.538E28637FF76912.quest_desc: ["Cette quête a été écrite par l'&6équipe AllTheMods&r ou un &2contributeur de la communauté&r pour les modpacks AllTheMods. \\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut pas être utilisée dans un pack public non publié par l'&6équipe AllTheMods&r sans autorisation explicite. \\n\\nCette quête est volontairement cachée ; si vous la voyez, c'est que vous êtes en mode édition."]
	quest.538E28637FF76912.title: "Tous droits réservés"
	quest.54AB11938676D4C7.quest_desc: [
		"Le poste de travail double les minerais courants grâce au traitement par réactifs : fer, or, cuivre et compagnie à l'entrée, le double à la sortie."
		""
		"Lent par pièce, gratuit pour une base patiente. Facultatif."
	]
	quest.54AB11938676D4C7.quest_subtitle: "Deux pour un, lentement"
	quest.54AB11938676D4C7.title: "L'alchimie des minerais"
	quest.564AD8763F753C74.quest_desc: [
		"La Tabula Vitae remplit aussi des &6flacons alchimiques&r : des effets à boire, persistants ou à lancer, préparés à partir de votre Anima."
		""
		"Flacons de combat et préparations utilitaires se préparent tous ici."
	]
	quest.564AD8763F753C74.quest_subtitle: "L'alchimie qui se boit"
	quest.564AD8763F753C74.title: "Des effets en bouteille"
	quest.56983FF3D82AF789.quest_desc: [
		"Les &6pierres rituelles imparfaites&r produisent seules de petits effets ponctuels : contrôle du jour et de la nuit, pluie et autres tours rapides."
		""
		"Pas chères, immédiates, parfaites pour apprendre le système. Facultatif."
	]
	quest.56983FF3D82AF789.quest_subtitle: "Des tours pas chers, au sens propre"
	quest.56983FF3D82AF789.title: "Rituels imparfaits"
	quest.56DDCB2865CEB9D3.quest_desc: [
		"La &6jauge d'aura de Spiritus&r affiche les cinq barres du chunk dans votre champ de vision tant qu'elle est dans votre inventaire."
		""
		"Accroupissez-vous pour voir les valeurs exactes : Brut, Ruina, Invictus, Nihilum, Vindicta, de 0 à 100 chacun."
	]
	quest.56DDCB2865CEB9D3.quest_subtitle: "Cinq barres, aucun réseau"
	quest.56DDCB2865CEB9D3.title: "Lire l'aura"
	quest.56F4E4845B8F12BB.quest_desc: [
		"Avec un orbe lié, faites un clic droit près de l'autel pour offrir votre propre sang : le bassin se remplit d'EV. Loin de l'autel, l'orbe garde l'offrande pour plus tard."
		""
		"L'EV du bassin permet de fabriquer la &6Tabula Rasa&r, la base de presque tous les sceaux, et bien d'autres choses."
	]
	quest.56F4E4845B8F12BB.quest_subtitle: "Du sang au pouvoir"
	quest.56F4E4845B8F12BB.title: "La page blanche"
	quest.5785D68A5F1ED2D2.quest_desc: [
		"Le &6Tau&r ne pousse que dans le Royaume démoniaque : fruit de Tau, Tau saturé et huile de Tau viennent tous de là-bas."
		""
		"Il alimente le jardin d'encens et l'alchimie de milieu de partie. Récoltez-en pendant que vous y êtes."
	]
	quest.5785D68A5F1ED2D2.quest_subtitle: "Fruit démoniaque, meilleur fruit"
	quest.5785D68A5F1ED2D2.title: "La récolte du Tau"
	quest.58248AF507380501.quest_desc: [
		"Retirez les enchantements de l'équipement devenu trop faible et gardez-les pour plus tard."
		""
		"Une façon discrète de recycler le butin que donne le donjon. Facultatif."
	]
	quest.58248AF507380501.quest_subtitle: "Recycler ce qui brille"
	quest.58248AF507380501.title: "Récupération d'enchantements"
	quest.5A99B71DB0C6A42A.quest_desc: [
		"Les sceaux ont différents degrés. Les clés simples ouvrent l'antichambre ; les portes plus profondes demandent des &6clés de donjon des mines&r et pire encore."
		""
		"Toutes les clés sont du butin du royaume. Vous n'en fabriquez jamais."
	]
	quest.5A99B71DB0C6A42A.quest_subtitle: "Les clés se trouvent, elles ne se fabriquent pas"
	quest.5A99B71DB0C6A42A.title: "Des serrures plus profondes"
	quest.5AA17C1657E8E5DE.quest_desc: [
		"L'équipement sensible ne s'améliore que porté et utilisé. Donnez-lui du travail."
		""
		"Plus il reste longtemps sur vous, meilleur il devient. Facultatif."
	]
	quest.5AA17C1657E8E5DE.quest_subtitle: "À faire à son pied, comme des bottes"
	quest.5AA17C1657E8E5DE.title: "La faire à sa mesure"
	quest.5ACB4565C6B2466C.quest_desc: [
		"Alimentez le creuset en &lredstone&r et il s'inverse : une gemme vide placée dedans se &lremplit&r à partir de l'aura du chunk au lieu de s'y vider."
		""
		"Saturez un aspect, laissez une gemme se charger, et elle prend cet aspect."
	]
	quest.5ACB4565C6B2466C.quest_subtitle: "La redstone inverse le robinet"
	quest.5ACB4565C6B2466C.title: "Gemmes d'aspect"
	quest.5BDD9D290D63ECE7.quest_desc: [
		"Un &6Daemonium Rancoris&r rôde dans les couloirs profonds : le rancunier, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.5BDD9D290D63ECE7.quest_subtitle: "L'un des dix du royaume"
	quest.5BDD9D290D63ECE7.title: "Daemonium Rancoris"
	quest.5C3EA8B4F5949406.quest_desc: [
		"La &6forge des feux de l'enfer&r est le deuxième poste de travail : l'équipement sensible, de meilleures gemmes de Spiritus et une partie du milieu de partie en sortent."
		""
		"Elle consomme du Spiritus et de l'EV : alimentez les deux économies avant un gros travail."
	]
	quest.5C3EA8B4F5949406.quest_subtitle: "Plus chaud qu'un barbecue"
	quest.5C3EA8B4F5949406.title: "La forge des feux de l'enfer"
	quest.5C7581C81669C499.quest_desc: [
		"Le &6mineur rapide&r accélère votre pioche, le &6bosquet vert&r fait pousser les cultures, le &6magnétisme&r attire le butin vers vous."
		""
		"La panoplie utilitaire classique. Facultatif."
	]
	quest.5C7581C81669C499.quest_subtitle: "La hâte fait le minerai"
	quest.5C7581C81669C499.title: "Les sceaux de travail"
	quest.602884068EC40EDB.quest_desc: [
		"Les outils et l'épée &6sensibles&r sont un équipement vivant. Les ennemis tués avec une lame sensible donnent directement du Spiritus, sans marque de dague."
		""
		"Ils gagnent des niveaux grâce à la volonté que vous leur donnez. Facultatif, mais ça en vaut la peine."
	]
	quest.602884068EC40EDB.quest_subtitle: "Il apprend. Nourrissez-le."
	quest.602884068EC40EDB.title: "L'acier sensible"
	quest.6101AB772B0317F1.quest_desc: [
		"Votre &6Anima&r est un réseau d'âme invisible qui stocke l'EV pour tout ce qui touche à la vitaemancie : sceaux, rituels, orbes. Quand il est à sec, certains objets prélèvent le coût sur votre chair."
		""
		"Placez l'orbe dans un autel chargé pour transférer le sang stocké vers votre Anima, dix fois plus vite que la normale."
	]
	quest.6101AB772B0317F1.quest_subtitle: "L'âme a une batterie"
	quest.6101AB772B0317F1.title: "Un sens pour l'Anima"
	quest.6171A7D347B9DFF4.quest_desc: [
		"Le &6devin rituel&r montre la forme que demande un rituel et donne un aperçu du coût avant que vous n'engagiez vos pierres."
		""
		"Ça coûte moins cher que de deviner. Facultatif."
	]
	quest.6171A7D347B9DFF4.quest_subtitle: "Voir avant de payer"
	quest.6171A7D347B9DFF4.title: "L'œil du devin"
	quest.62341583003C250F.quest_desc: [
		"Un &6Daemonium Doloris&r rôde dans les couloirs profonds : le porteur de douleur, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.62341583003C250F.quest_subtitle: "L'un des dix du royaume"
	quest.62341583003C250F.title: "Daemonium Doloris"
	quest.62F71D88F1ED68B8.quest_desc: [
		"Dix espèces de Daemonium rôdent dans le royaume, une par aspect et par humeur : Animaris, Cruoris, Doloris et les autres, chacune avec son propre butin."
		""
		"La page du bestiaire indique ce que chacune garde. Guide de terrain facultatif."
	]
	quest.62F71D88F1ED68B8.quest_subtitle: "Dix saveurs d'ennuis"
	quest.62F71D88F1ED68B8.title: "Connaissez vos Daemonium"
	quest.63BEB615CC08733D.quest_desc: [
		"Un &6Daemonium Fervidis&r rôde dans les couloirs profonds : le fervent, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.63BEB615CC08733D.quest_subtitle: "L'un des dix du royaume"
	quest.63BEB615CC08733D.title: "Daemonium Fervidis"
	quest.65BD73DA55BCC624.quest_desc: [
		"Neo Vitae est l'art de la Vitaemancie : votre propre sang, raffiné en pouvoir. Ce chapitre parcourt tout le chemin, de la première entaille jusqu'au Royaume démoniaque lui-même."
		""
		"Suivez la ligne principale de gauche à droite. Les quêtes des branches secondaires sont des leçons facultatives, qui rapportent de meilleures histoires que de l'équipement."
	]
	quest.65BD73DA55BCC624.quest_subtitle: "Il n'en veut qu'un petit peu"
	quest.65BD73DA55BCC624.title: "Bienvenue dans Neo Vitae"
	quest.6607F68E3F0B6243.quest_desc: [
		"Un &6Daemonium Glaciaris&r rôde dans les couloirs profonds : le traqueur gelé, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.6607F68E3F0B6243.quest_subtitle: "L'un des dix du royaume"
	quest.6607F68E3F0B6243.title: "Daemonium Glaciaris"
	quest.671F7551CBDF462F.quest_desc: [
		"Le rituel de niveau III évite le vestibule et vous dépose dans le &lRoyaume sans fin&r : le cœur de la dimension, généré au hasard."
		""
		"Les salles deviennent plus dangereuses à mesure que vous descendez, avec des générateurs plus coriaces et un butin plus riche. Venez bien équipé."
	]
	quest.671F7551CBDF462F.quest_subtitle: "Pas de péage, juste des démons"
	quest.671F7551CBDF462F.title: "Autoroute pour l'enfer"
	quest.678017C531F68528.quest_desc: [
		"Les sceaux sont vos outils de travail : chacun a une seule fonction, alimentée par l'EV de votre Anima."
		""
		"Les quêtes suivantes présentent les familles. Toutes facultatives, toutes utiles."
	]
	quest.678017C531F68528.quest_subtitle: "Un sceau, une fonction"
	quest.678017C531F68528.title: "Une ceinture pleine de sceaux"
	quest.6A866C75EE839078.quest_desc: [
		"Les sceaux élémentaires modifient le terrain et la météo : aide au vol, gestion de la lave, travail du gel."
		""
		"Chacun se fabrique dans un cercle et se nourrit de la charge d'Anima."
	]
	quest.6A866C75EE839078.quest_subtitle: "La trousse élémentaire"
	quest.6A866C75EE839078.title: "Air, lave et gel"
	quest.702FC3E5D0D6C31F.quest_desc: [
		"L'&6orbe de vitae Divinus&r : &l10 000 000 d'EV&r, le plus grand réceptacle que la Vitaemancie puisse offrir."
		""
		"Avec lui en main, tous les rituels de la carte sont à votre portée."
	]
	quest.702FC3E5D0D6C31F.quest_subtitle: "L'apogée, c'est un mode de vie"
	quest.702FC3E5D0D6C31F.title: "L'apogée"
	quest.70D2718D54785867.quest_desc: [
		"Le &6creuset à Spiritus&r brûle les gemmes et les cristaux pour les changer en &laura&r, du Spiritus diffusé dans l'air du chunk où il se trouve."
		""
		"Alimentez-le avec des gemmes chargées ou des éclats de cristal."
	]
	quest.70D2718D54785867.quest_subtitle: "L'air a son solde"
	quest.70D2718D54785867.title: "Le creuset à Spiritus"
	quest.71E0D06EA65172CF.quest_desc: [
		"L'autel forge aussi des &6dagues de lancer&r, votre première arme à distance et le point de départ de l'économie du Spiritus."
		""
		"Marquez une créature hostile d'une blessure de dague, puis achevez-la : elle laisse des particules de &6Spiritus&r. Gardez-en une pile."
	]
	quest.71E0D06EA65172CF.quest_subtitle: "Piquer d'abord, ramasser ensuite"
	quest.71E0D06EA65172CF.title: "Dagues de lancer"
	quest.73391A08D7615C77.quest_desc: [
		"Posez un &6Ara Vitae&r sur un sol plat et placez dessus un &ldiamant&r. Sans puissance propre, l'autel puise le sang de quiconque se tient à proximité et le raffine en &6Essentia Vitae (EV)&r."
		""
		"Le diamant se transforme en &6orbe de vitae Novicius&r. Faites un clic droit avec pour le lier à votre âme."
	]
	quest.73391A08D7615C77.quest_subtitle: "Il n'en veut qu'un petit peu"
	quest.73391A08D7615C77.title: "Le premier autel"
	quest.759B0D6F8C0CC1EF.quest_desc: [
		"La première amélioration de l'autel est un cercle de runes placées dans la pierre autour de l'Ara Vitae. Huit emplacements de runes s'ouvrent au niveau I."
		""
		"Les runes de vitesse raccourcissent chaque fabrication ; les runes de capacité agrandissent le bassin. Le site de planification donne les chiffres exacts."
	]
	quest.759B0D6F8C0CC1EF.quest_subtitle: "L'autel se fait une couronne"
	quest.759B0D6F8C0CC1EF.title: "Niveau I : le cercle de runes"
	quest.770A5CCB2B571FD0.quest_desc: [
		"Un orbe en main secondaire boit à chaque ennemi tué : &l10 EV par point de vie maximum&r de la victime vont dans la réserve de l'orbe."
		""
		"Remplissez-le sur le champ de bataille, puis déposez l'orbe sur l'autel pour un transfert dix fois plus rapide vers votre Anima."
	]
	quest.770A5CCB2B571FD0.quest_subtitle: "Chaque victime rapporte"
	quest.770A5CCB2B571FD0.title: "La moisson des vaincus"
	quest.7731623EA92027D9.quest_desc: [
		"L'&6orbe de vitae Dominus&r contient &l5 000 000 d'EV&r. Passé ce stade, l'Anima se vide rarement en plein rituel."
		""
		"Il ne reste qu'un seul niveau après celui-ci."
	]
	quest.7731623EA92027D9.quest_subtitle: "Cinq millions et ça continue"
	quest.7731623EA92027D9.title: "L'orbe de l'archimage"
	quest.7AFEB7A91DC8F413.quest_desc: [
		"Forgez l'&6orbe de vitae Discipulus&r sur un autel de niveau I. Votre capacité d'Anima passe de 5 000 à &l25 000 EV&r."
		""
		"Offrandes plus grandes, fabrications plus grandes. Continuez à remplir."
	]
	quest.7AFEB7A91DC8F413.quest_subtitle: "25 000 raisons de continuer"
	quest.7AFEB7A91DC8F413.title: "L'orbe de l'apprenti"
	quest.7B293C32824033F9.quest_desc: [
		"Le &6Crystallarium Maleficum&r fait pousser des cristaux de Spiritus à partir d'éclats bruts nourris par l'aura."
		""
		"La ferme à cristaux qui garde vos cinq aspects bien approvisionnés."
	]
	quest.7B293C32824033F9.quest_subtitle: "L'agriculture de cristaux, en somme"
	quest.7B293C32824033F9.title: "Activer le Crystallarium Maleficum"
	quest.7C7C061FC04B89FB.quest_desc: [
		"Raffinez la démonite en pièces et en lingots &6forgés aux enfers&r : le métal derrière les meilleurs outils et les meilleures cellules."
		""
		"Le dernier matériau que demande le chapitre."
	]
	quest.7C7C061FC04B89FB.quest_subtitle: "Matériau haut de gamme"
	quest.7C7C061FC04B89FB.title: "L'acier forgé aux enfers"
	quest.7CF9A68167ADAD1A.quest_desc: [
		"La production du sacrifice augmente avec les runes de vitesse de l'autel et votre bonus de sacrifice."
		""
		"Sang lent, travail lent ; les quêtes d'automatisation précédentes y remédient. Facultatif."
	]
	quest.7CF9A68167ADAD1A.quest_subtitle: "La vitesse fait partie du montage"
	quest.7CF9A68167ADAD1A.title: "Un cœur lent ne sert à personne"
	quest.7FEB1850709B6C3B.quest_desc: [
		"Un &6Daemonium Corrodis&r rôde dans les couloirs profonds : celui qui ronge tout, l'un des dix du royaume."
		"Tuez-en un pour l'inscrire au registre. Les salles plus profondes abritent les espèces plus rares."
	]
	quest.7FEB1850709B6C3B.quest_subtitle: "L'un des dix du royaume"
	quest.7FEB1850709B6C3B.title: "Daemonium Corrodis"
	task.0288CB407D31C889.title: "Entrer dans le Royaume sans fin"
	task.1FF3177703E8A956.title: "Placer le troisième cercle de runes"
	task.29A4F7568EC9A669.title: "Forger une gemme de Spiritus supérieure"
	task.2E79DA68A894ADA3.title: "Placer le quatrième cercle de runes"
	task.3888E025817A3078.title: "Passer en revue les familles de sceaux"
	task.4583E01C36D6F8CE.title: "Recevoir l'effet Sacrifice béni"
	task.5042D493A5C64E1F.title: "Maîtriser les arts de la Vitaemancie"
	task.5C46A937BDD648FB.title: "Trouver une particule d'Animus"
	task.636C5D69E573AFD6.title: "Récolter de l'EV en tuant avec un orbe en main secondaire"
	task.69E3F53841566D45.title: "Découvrir le bestiaire des Daemonium"
	task.6D5BE02E9FAED45C.title: "Tous droits réservés"
	task.725FB5D93493B696.title: "Forger un accumulateur spirituel dans l'athanor"
	task.73813DADA29F08D1.title: "Achever le cinquième cercle"
	task.751D04253475CDEE.title: "Préparer une onction à la Tabula Vitae"
	task.7C216145BA10CE53.title: "Faire apparaître une fois la protection sanguine"
	task.7DA13EB040BC1C19.title: "Tous droits réservés"
}
