	task.298EA976A7627731.title: "Trouver une cité antique"
	task.2A7CD3F14D3DC7C5.title: "Armure en unobtainium"
	task.2E3BC536B8A9FD91.title: "Tenue de mage en unobtainium"
	task.32447C5882610D6C.title: "Visiter l'End"
	task.40C43560F454AD82.title: "Outils en Allthemodium"
	task.46B42667B6BC1A3C.title: "Visiter le Nether"
	task.4709938E0FDCE0FB.title: "Armure en Allthemodium"
	task.5F45BABFD89DE0EC.title: "TousDroitsRéservés"
	task.614C3310C61487CB.title: "Armure d'arcaniste en unobtainium"
	task.61E3800DF5D25567.title: "Armure d'arcaniste en Allthemodium"
