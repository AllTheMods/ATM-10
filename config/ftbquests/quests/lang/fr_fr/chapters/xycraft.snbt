{
	quest.030AC1AF8F735550.quest_desc: ["Pour mettre des liquides dans le réservoir, il vous faudra des tuyaux.\\n\\nLa pompe hydraulique peut y mettre de l'eau automatiquement, lentement, mais gratuitement !"]
	quest.030AC1AF8F735550.title: "Tuyaux"
	quest.06B85804163DD18B.quest_desc: ["La Soaryn Box (Soaryn étant l'auteur de XyCraft) est le coffre de XyCraft.\\n\\nElle ne garde pas les objets quand on casse le bloc ! À quoi peuvent bien servir ces carrés dessus ?"]
	quest.08E484DD3E751697.quest_subtitle: "Le B de « Roy G. Biv » (l'arc-en-ciel)"
	quest.08E484DD3E751697.title: "&bGemmes de xychorium bleu"
	quest.0D01524F249E25D7.quest_subtitle: "Qui a éteint la lumière ?"
	quest.0D01524F249E25D7.title: "&8Gemmes de xychorium sombre"
	quest.15540271BF17C2E4.quest_desc: ["&lBienvenue dans XyCraft !&r\\n\\nCette série de mods est surtout consacrée à XyCraft : World et Machines !\\nWorld nous donne les gemmes, qu'on trouve en minant."]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.16B4A00948D1F60D.quest_desc: ["Cette quête a été créée par le personnel de &6AllTheMods&r ou un contributeur de la communauté &2Community contributor&r pour être utilisée dans les modpacks AllTheMods.\\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut être utilisée dans aucun pack public non publié par l'équipe &6AllTheMods&r sans autorisation explicite.\\n\\nCette quête est intentionnellement masquée. Si vous la voyez, c'est que vous êtes en mode édition."]
	quest.1A96C595CBA42840.quest_desc: ["Les graines de kivi permettent de faire pousser de l'essence de kivi, qu'on transforme en kivi !"]
	quest.1A96C595CBA42840.title: "Automatisation du kivi"
	quest.1E00DBAACDF4404F.quest_desc: ["Le collecteur fonctionne comme un entonnoir d'absorption très bon marché.\\n\\nIl ramasse tous les objets dans un rayon de 3 blocs et les met dans l'inventaire en dessous ou dans le sien. On peut l'éteindre avec de la redstone !"]
	quest.2278A98DCDF713D7.quest_desc: ["Il est temps de fabriquer le réservoir ! D'abord, il vous faut des blocs de construction et au moins 1 valve. Le verre et les E/S d'objets sont facultatifs.\\n\\nLe réservoir doit avoir un cadre en blocs de construction. Est bloc de construction tout ce qui n'est pas transparent, soumis à la gravité, ou de la terre ou de l'herbe naturelle.\\n\\nDes objets comme la pierre, le bois ou le métal forment le cadre et les arêtes. Le verre, les valves et les E/S d'objets se placent dans les murs, et l'intérieur doit être vide.\\n\\nIl peut faire au plus 13x13x13. Une fois tout ça fait, faites un clic droit sur la valve : elle dira 'Formed' (formé) ou vous indiquera le problème."]
	quest.2278A98DCDF713D7.title: "&lLe réservoir"
	quest.2AC7BC448C007BDB.quest_desc: ["Renforcez le kivi avec de l'aluminium et vous obtiendrez des cadres de machine, nécessaires pour fabriquer des machines."]
	quest.2B5E14A47062F83C.quest_subtitle: "Le R de « Roy G. Biv » (l'arc-en-ciel)"
	quest.2B5E14A47062F83C.title: "&cGemmes de xychorium rouge"
	quest.2C4ECA4F5B1639F4.quest_desc: ["Le champ de lumière n'éclaire pas beaucoup, mais il fonctionne comme une méga-torche.\\n\\nLes monstres n'apparaissent pas dans une zone autour de lui, d'environ 32 blocs de rayon."]
	quest.2C4ECA4F5B1639F4.title: "&fChamp de lumière"
	quest.2C7D62231AD6406A.quest_desc: ["XyCraft a une super multistructure de réservoir de fluide !"]
	quest.2C7D62231AD6406A.title: "&bStockage et manipulation des fluides"
	quest.355244420EA47546.quest_desc: ["Le fabricateur est le fabricant automatique. Il prend les objets de l'inventaire en dessous et réalise une recette choisie.\\n\\nVous pouvez verrouiller les recettes avec CTRL + clic. Mais il faudra sortir les objets fabriqués par tuyau."]
	quest.355244420EA47546.quest_subtitle: "Fabricant automatique"
	quest.39E4FC9BA89E44BC.quest_desc: ["Le ballon sur un bâton est une source précoce et limitée de vol créatif.\\n\\nPosez le bâton et vous serez attaché à un ballon ! Appuie deux fois sur Espace pour commencer à voler, mais pas trop loin. Si vous vous éloignez trop, vous vous détachez et vous tombez."]
	quest.39E4FC9BA89E44BC.quest_subtitle: "Là-haut !"
	quest.3E970E76372AB094.quest_desc: ["La &2jardinière accélérée&r fonctionne comme une terre labourée normale, avec quelques différences.\\n\\nElle est arrosée automatiquement et plus rapide qu'une terre labourée normale."]
	quest.3E970E76372AB094.title: "&2Jardinière accélérée"
	quest.3F68BA498E877C8C.quest_subtitle: "Le deuxième prénom de Roy Biv (le G, pour green, le vert)"
	quest.3F68BA498E877C8C.title: "&aGemmes de xychorium vert"
	quest.43F08B510FC1C06F.quest_desc: ["Les E/S d'objets permettent de faire entrer et sortir des objets du réservoir. On peut les régler en sortie ou en entrée."]
	quest.43F08B510FC1C06F.quest_subtitle: "Là où les objets vont et viennent"
	quest.43F08B510FC1C06F.title: "E/S d'objets"
	quest.4A92237E17ED5F1C.quest_desc: ["Le conteneur du vide transforme n'importe quel inventaire en poubelle. Posez-le sur l'inventaire et adieu les objets !"]
	quest.5E1D4169C083ACEF.quest_desc: ["La &cplaque d'allumage&r fait apparaître du feu devant elle quand elle reçoit un signal de redstone.\\n\\nElle éteint le feu quand le signal s'arrête."]
	quest.5E1D4169C083ACEF.title: "&cPlaque d'allumage"
	quest.623E6A855B363C8D.quest_desc: ["Le &9bloc d'eau&r agit comme de l'eau, mais sans couler.\\n\\nOn peut faire des générateurs de roche avec, irriguer des terres labourées, mais pas faire de « MLG » avec. (Les poissons essaient aussi d'entrer dedans, mais meurent quand même.)"]
	quest.623E6A855B363C8D.quest_subtitle: "De l'eau mais solide... de la glace ?"
	quest.623E6A855B363C8D.title: "&9Bloc d'eau"
	quest.643FB1A3ED0EA9EC.quest_desc: ["La valve est le cœur de votre réservoir. C'est par là que vous pompez ou envoies les fluides dedans."]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Là où le fluide va et vient"
	quest.643FB1A3ED0EA9EC.title: "Valves"
	quest.64D0D69ADB8820DA.quest_desc: ["Le &8vide à fluide&r est un bloc qui fait disparaître toute l'eau qui le touche.\\n\\nSources ou eau qui coule, tout ce qui est dans un rayon d'1 bloc disparaît."]
	quest.64D0D69ADB8820DA.title: "&8Vide à fluide"
	quest.69F11A94D44AB5CF.quest_subtitle: "Trop de lumière !"
	quest.69F11A94D44AB5CF.title: "&fGemmes de xychorium claires"
	quest.6D0876A402C22067.quest_desc: ["XyCraft propose un peu de stockage et de manipulation d'objets. Mais pas autant que pour les fluides !"]
	quest.6D0876A402C22067.title: "&6Stockage et manipulation d'objets"
	quest.71D133BA3EC6F4FD.quest_desc: ["L'extracteur fait « pousser » le bloc ou l'objet en dessous de lui et le déplace vers un inventaire au-dessus.\\n\\nOn peut s'en servir pour un générateur de pierre taillée qui marche avec plein de types de pierre, un générateur d'améthyste, ou même un générateur d'œufs de dragon, entre autres !"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Cultiver des cailloux ! (et plus)"
	quest.7574A782DCFB87CE.quest_desc: ["Le kivi sert à plusieurs choses, surtout pour la déco et les machines.\\n\\nIl vous faudra du kivi pour les cadres de machine et d'autres machines de XyCraft. On peut l'utiliser avec des gemmes de xychorium dans un tailleur de pierre pour des blocs décoratifs."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	task.4EEF358CAC170CC4.title: "Gemmes de xychorium"
	task.55DD09212E3DB168.title: "Tuyaux à fluide"
	task.706FA543A6C675D3.title: "Tous droits réservés"
}
