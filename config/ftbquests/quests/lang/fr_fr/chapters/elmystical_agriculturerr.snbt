	quest.1636F3F12E92CAEA.quest_desc: [
		"Pour utiliser un arrosoir, il faut le remplir d'eau en faisant un clic droit sur une source d'eau. Une fois rempli, maintenez le clic droit sur une culture pour arroser les cultures dans la zone de l'arrosoir."
		""
		"Les arrosoirs d'essence peuvent arroser automatiquement. Faites simplement accroupi + clic droit dans le vide avec l'arrosoir pour activer ou désactiver l'arrosage automatique. L'arrosoir a l'air enchanté quand c'est activé."
	]
	quest.16E3031D800B40D5.quest_desc: ["Le générateur en soulium utilise des essences de créature pour faire apparaître des créatures. Par exemple, avec de l'essence de ghast, vous pouvez faire apparaître un ghast."]
	quest.19065F9DB95FE9C0.quest_subtitle: "Niveau : &b4"
	quest.19AAC139177442C1.quest_subtitle: "Niveau : &63"
	quest.19FFD64154AFC89D.quest_subtitle: "Niveau : &b4"
