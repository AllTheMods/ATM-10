{
	quest.00CB8D60E7831A57.quest_desc: ["Les catacombes sont d'immenses structures souterraines faites de briques de roche profonde. Une partie peut dépasser du sol et être repérée. \\n\\nDans cet immense labyrinthe se trouvent des &7Oubliés&r, des coffres cachés et le boss : le &aGardien oublié&r. \\n\\nJ'espère que vous êtes prêt !"]
	quest.00CB8D60E7831A57.title: "Catacombes"
	quest.01B13BBB41BBB460.quest_desc: ["L'&carmure en utherium&r a les mêmes stats que l'armure en netherite ! \\n\\nSans avoir besoin de modèle de forge !"]
	quest.01B13BBB41BBB460.title: "Armure en &cutherium&r"
	quest.050D8480EE9D8E62.quest_desc: [
		"Les forêts de bois ondulant sont des forêts comme les autres. \\n\\nSauf que ces arbres poussent comme bon leur semble."
		"{image:atm:textures/questpics/undergarden/undergarden_wiggle.png width:200 height:100 align:center}"
	]
	quest.050D8480EE9D8E62.title: "Forêt de bois ondulant"
	quest.06D13E319C26C949.quest_desc: [
		"Le marais aux champignons de sang abrite les champignons de sang géants. \\n\\nLe sang me met mal à l'aise, alors je vais faire court."
		"{image:atm:textures/questpics/undergarden/undergarden_blood.png width:200 height:100 align:center}"
	]
	quest.06D13E319C26C949.title: "Marais aux champignons de sang"
	quest.073BA8470EA37A00.quest_desc: [
		"Encore une mer, mais celle-ci est bien plus froide."
		"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
	]
	quest.073BA8470EA37A00.title: "Mer glacée"
	quest.08D9C809CF4062E8.quest_desc: ["Mangez-les crus, grillés, ou sur un bâton. \\n\\nQue ne peut-on pas faire avec les haricots souterrains !"]
	quest.0A0A991BAC99092C.quest_desc: [
		"Le marais aux champignons indigo est bien plus rempli que le marais aux champignons de sang. \\n\\nIl y a bien sûr des champignons indigo, mais aussi de petits arbres smogstem et des mares de mélange virulent. Je me demande ce que ça fait..."
		"{image:atm:textures/questpics/undergarden/undergarden_indigo.png width:200 height:100 align:center}"
	]
	quest.0A0A991BAC99092C.title: "Marais aux champignons indigo"
	quest.0A1D6E233C0ECC8E.quest_desc: [
		"Les &dNargoyles&r sont des monstres hostiles et méchants qui apparaissent sous terre. \\n\\nIls ont 7 cœurs et demi et essaient sans relâche de vous tuer. \\n\\nIls ne lâchent rien et servent juste d'obstacle à ceux qui veulent miner tranquillement."
		"{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}"
	]
	quest.0A1D6E233C0ECC8E.title: "&dNargoyle&r"
	quest.0C98503A2F20484D.quest_desc: [
		"Près des champs de givre, vous trouverez peut-être des forêts de smogstem givrées. \\n\\nCe sont comme des champs de givre, mais avec des arbres smogstem !"
		"{image:atm:textures/questpics/undergarden/undergarden_frostytrees.png width:200 height:100 align:center}"
	]
	quest.0C98503A2F20484D.title: "Forêt de smogstem givrée"
	quest.0D91A6B36BD2F526.quest_desc: ["Améliorez votre &7hache de bataille en cloggrum&r pour obtenir la meilleure arme que l'&2&lUndergarden&r puisse offrir !"]
	quest.0D91A6B36BD2F526.title: "Arme ultime !"
	quest.0FA77C28A57E06F1.quest_desc: ["Les champignons voilés ne se trouvent que dans leur marais. \\n\\nIls ont des chapeaux bruns qui, s'il y a de l'air en dessous, font apparaître des voiles de champignon. D'où leur nom !"]
	quest.1054168AFD8520D4.quest_desc: [
		"Le &aGardien oublié&r est un golem massif fait de &alingots oubliés&r. \\n\\nIl prend le joueur pour cible et fera tout pour le tuer. \\n\\nIl a 80 cœurs, et si vous arrivez à le tuer, il lâchera des &apépites oubliées&r."
		"{image:atm:textures/questpics/undergarden/undergarden_guardian.png width:100 height:200 align:center}"
	]
	quest.1054168AFD8520D4.title: "&aGardien oublié&r"
	quest.1190BB433EFA3945.quest_desc: ["Le lance-pierre est une arme très amusante ajoutée par &2&lUndergarden&r. Il a 4 munitions possibles : \\n\\nLa glu de scintling : quand elle touche une créature, elle lui donne l'effet Gluant. \\n\\nLes roches profondes : de simples projectiles. \\n\\nLes baies cloquées pourries : elles explosent à l'impact. \\n\\nEt les &eGronglets&r : ils ne font aucun dégât, ils font juste du bruit et se font tirer !"]
	quest.119242549BD21764.quest_desc: [
		"Les &eBrutes&r apparaissent dans quelques biomes et sont neutres. \\n\\nSi vous en frappez une, toutes celles du coin vous attaquent. Comme les loups ou les piglins zombifiés. \\n\\nÀ leur mort, elles peuvent lâcher leurs défenses, qui peuvent remplacer les os !"
		"{image:atm:textures/questpics/undergarden/undergarden_brute.png width:100 height:100 align:center}"
	]
	quest.119242549BD21764.title: "&eBrutes&r"
	quest.130577AD1A1A8222.quest_desc: ["Le &7cloggrum&r a des stats un peu moins bonnes que l'armure en fer, mais il pousse pratiquement sur les arbres, donc c'est juste. \\n\\nLes bottes aident aussi à traverser la glu de scintling !"]
	quest.130577AD1A1A8222.title: "Armure en &7cloggrum&r"
	quest.141681FE9E524FB0.quest_desc: [
		"Les &7Oubliés&r sont des guerriers qui apparaissent dans les catacombes. \\n\\nIls portent une armure ancienne et des outils en cloggrum, qu'ils peuvent tous lâcher à leur mort. \\n\\nIls ciblent et tuent aussi les &ccréatures pourries&r."
		"{image:atm:textures/questpics/undergarden/undergarden_forgotten.png width:100 height:200 align:center}"
	]
	quest.141681FE9E524FB0.title: "&7Oublié&r"
	quest.15A8F04BC10E619E.quest_desc: [
		"Certains détestent explorer plein de biomes différents pour obtenir toutes les pousses d'arbres. \\n\\nVisiblement, le dev de &2&lUndergarden&r aussi, alors il a mis la plupart d'entre elles dans la forêt dense !"
		"{image:atm:textures/questpics/undergarden/undergarden_dense.png width:200 height:100 align:center}"
	]
	quest.15A8F04BC10E619E.title: "Forêt dense"
	quest.16A04B2FC3F0D902.quest_desc: ["Les outils en &7cloggrum&r fonctionnent comme les outils en fer, ils ressemblent juste plus à de la boue que le fer ! \\n\\nL'épée fait quand même plus de dégâts qu'une épée en fer."]
	quest.16A04B2FC3F0D902.title: "Outils en &7cloggrum&r"
	quest.17C2C8F64B4AE6EE.quest_desc: [
		"Les &2Dwellers&r sont les vaches de l'&2&lUndergarden&r. \\n\\nIls sont passifs et lâchent du cuir et de la viande de Dweller à leur mort. \\n\\nDieu merci, on ne peut pas les traire, je ne veux pas du lait que font ces &2Dwellers&r."
		"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
	]
	quest.17C2C8F64B4AE6EE.title: "&2Dweller&r"
	quest.19862DBCE9305DE3.quest_desc: ["La &3lance&r, l'arme préférée des &7Habitants&r... avec la hache en bois. \\n\\nIl faut 2 bâtons et du &3rogdorium&r pour la fabriquer. \\n\\nElle fait autant de dégâts qu'une &bépée en diamant&r, avec plus d'allonge ! \\n\\nElle peut aussi être lancée comme un trident."]
	quest.19862DBCE9305DE3.title: "&3Lance"
	quest.1A23BBF444D17A63.quest_desc: [
		"Les &2grands Dwellers&r apparaissent sous le niveau Y 0. Il vous faudra une &apioche oubliée&r ou une &6pioche en Allthemodium&r pour miner la roche de l'effroi sur le chemin. \\n\\nLes &2grands Dwellers&r ont évolué différemment de leurs petits cousins : les profondeurs sont dangereuses, ils ont dû devenir plus grands et plus forts ! \\n\\nIls sont maintenant plus grands, avec 100 cœurs. Ils sont aussi neutres au lieu de passifs. Comme les piglins zombifiés, si l'un d'eux est frappé, tous attaquent."
		"{image:atm:textures/questpics/undergarden/undergarden_greater.png width:100 height:100 align:center}"
	]
	quest.1A23BBF444D17A63.title: "&2Grand Dweller"
	quest.1BAE1519E44E40CE.quest_desc: [
		"Imaginez la mer ancienne. Maintenant, retirez tout le varech et tous les &bGwibs&r et &bGwiblings&r. \\n\\nVoilà la mer morte !"
		"{image:atm:textures/questpics/undergarden/undergarden_dead.png width:200 height:100 align:center}"
	]
	quest.1BAE1519E44E40CE.title: "Mer morte"
	quest.1C232674CD04024D.quest_desc: ["La dimension de l'&2&lUndergarden&r est pleine de biomes variés et répugnants, avec beaucoup de végétation, de créatures amicales ou non, et bien sûr des minerais et des objets. \\n\\nJ'espère que vous êtes prêt à vous battre !"]
	quest.1C232674CD04024D.title: "Bienvenue dans l'&2&lUndergarden&r !"
	quest.1D2C70F1750E84D0.quest_desc: [
		"Une nouvelle &ccréature pourrie&r ? \\n\\nLe &cRotbelcher&r a 17 cœurs et demi et 4 points d'armure. \\n\\nS'il est près de vous, il vous frappe avec ses bras. Si vous êtes un peu plus loin, il vous crache dessus. \\n\\nIl lui faudrait un bain de bouche, si son crachat est aussi immonde."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbelcher.png width:100 height:200 align:center}"
	]
	quest.1D2C70F1750E84D0.title: "&cRotbelcher"
	quest.1E13D7CE5A9EFF74.quest_desc: [
		"Les champs de givre sont l'un des biomes froids de l'&2&lUndergarden&r. On le voit aux énormes stalactites de glace, à la neige poudreuse et au gazon profond gelé ! \\n\\nIci, au lieu de la roche profonde habituelle sous terre, vous trouverez de la pierre-frisson. \\n\\nLa pierre-frisson se comporte plus comme de la glace que comme de la vraie pierre. Du moins quand on marche dessus !"
		"{image:atm:textures/questpics/undergarden/undergarden_frosty.png width:200 height:100 align:center}"
	]
	quest.1E13D7CE5A9EFF74.title: "Champs de givre"
	quest.1E81B903137BB62A.quest_desc: ["Les outils normaux ne suffiront pas, surtout face aux monstres dangereux de l'&2&lUndergarden&r. \\n\\nOn peut fabriquer le &7bouclier en cloggrum&r, qui fonctionne comme un bouclier normal. \\n\\nMais la &7hache de bataille&r, elle, est un butin rare des &7Oubliés&r."]
	quest.1E81B903137BB62A.title: "Armes en &7cloggrum&r"
	quest.1FCF946B7BE3C0BD.quest_desc: ["Les outils en &cutherium&r ressemblent aux outils en diamant, mais les armes sont plus efficaces contre les &ccréatures pourries&r ! \\n\\nOn utilise ce qu'elles produisent pour leur faire plus de dégâts ! Il y a sûrement une dizaine de références à la pop culture à faire avec ça, mais aucune ne me vient..."]
	quest.1FCF946B7BE3C0BD.title: "Outils &cuthériques&r"
	quest.22739522F0D33D7B.quest_desc: ["Les gloomgourds apparaissent et se cultivent comme les citrouilles. \\n\\nComme les citrouilles, on peut en faire de la tarte, ou même des citrouilles-lanternes ! \\n\\nContrairement aux citrouilles, on peut en faire des explosifs..."]
	quest.24D38DA8E86DD897.quest_desc: [
		"La plus petite et la plus faible des &ccréatures pourries&r. \\n\\nElle a 5 cœurs. \\n\\nComme toutes les &ccréatures pourries&r, elle cible les &2Nés-de-pierre&r et les &7Oubliés&r et lâche des &céclats uthériques&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotling.png width:100 height:100 align:center}"
	]
	quest.24D38DA8E86DD897.title: "&cRotling&r"
	quest.257893DD23BF5017.quest_desc: ["Pour obtenir du &3rogdorium&r, il faut aller dans les profondeurs sous le niveau Y 0. Pour ça, il vous faut une &apioche oubliée&r ou une &6pioche en Allthemodium&r. \\n\\nIl faut aussi une pioche du même niveau pour miner le &3minerai de rogdorium&r, qui apparaît partout dans les profondeurs. \\n\\nVous pouvez aussi utiliser une hache &aoubliée&r ou en &6Allthemodium&r pour miner la &3racine ancienne rogdorique&r. Elle est bien plus fréquente, mais ne donne qu'une &3pépite de rogdorium&r, contre un morceau entier pour le &3minerai&r."]
	quest.257893DD23BF5017.title: "&3Rogdorium"
	quest.278D34BBC13356DF.quest_desc: [
		"Un marais violet ! \\n\\nIl y a des champignons d'encre et du mélange virulent partout !"
		"{image:atm:textures/questpics/undergarden/undergarden_ink.png width:200 height:100 align:center}"
	]
	quest.278D34BBC13356DF.title: "Marais aux champignons d'encre"
	quest.2A2041098C069772.quest_desc: [
		"Les &7Habitants&r apparaissent dans les profondeurs, sous le niveau Y 0. Il vous faudra une &apioche oubliée&r ou de niveau équivalent pour miner jusque-là. \\n\\nLes &7Habitants&r ont l'air étrangement et répugnamment humains : ils portent des masques mystérieux et tiennent une lance ou une hache en bois. \\n\\nLes &7Habitants&r existent en version petite et ronde, et en version grande et maigre. Mais tous ont 10 cœurs. \\n\\nIls ne lâchent rien, à part peut-être leur arme."
		"{image:atm:textures/questpics/undergarden/undergarden_denizens.png width:100 height:200 align:center}"
	]
	quest.2A2041098C069772.title: "&7Habitant"
	quest.2C5A7E4CD8B57E08.quest_desc: ["Les arbres grongle sont de grands arbres façon jungle qui n'apparaissent que dans les biomes Gronglegrowth ! \\n\\nC'est aussi sur ces arbres qu'apparaissent les &eGronglets&r."]
	quest.2E596B5A4EA2ABF4.quest_desc: [
		"Ce Smogvent bouge ? Non attends, c'est juste un &3S'Mog&r ! Le proche cousin du &2Mog&r ! \\n\\nIls agissent exactement comme les &2Mogs&r, mais ceux-ci peuvent lâcher de la mogmousse bleue."
		"{image:atm:textures/questpics/undergarden/undergarden_smog.png width:100 height:100 align:center}"
	]
	quest.2E596B5A4EA2ABF4.title: "&3S'Mog&r"
	quest.30582B5FBED35FD1.quest_desc: ["Les &camas uthériques&r et les &céclats&r peuvent être lâchés par plusieurs créatures, surtout les monstres &cpourris&r. \\n\\n9 &céclats&r font 1 &camas&r. \\n\\nIl faudra ensuite utiliser un infuseur pour combiner du &3rogdorium&r et un &camas uthérique&r afin de fabriquer un &ccristal uthérique&r."]
	quest.30582B5FBED35FD1.title: "&cUthérique&r"
	quest.30D6924003C6E273.quest_desc: ["Les camps d'&7Habitants&r se trouvent dans les profondeurs. Il faut miner sous le niveau Y 0, au-delà de la roche de l'effroi. \\n\\nLa roche de l'effroi demande une &apioche oubliée&r pour être minée. C'est le même niveau que la &6pioche en Allthemodium&r. \\n\\nPlein d'&7Habitants&r y apparaissent, avec des totems mystérieux et des coffres ! Rarement, un coffre contient un masque mystérieux, le même que portent les &7Habitants&r. \\n\\nPorter un masque mystérieux près des &7Habitants&r, c'est comme porter de l'&eor&r devant les piglins. Ils restent neutres sauf si quelqu'un est frappé (ou si on fait quelque chose pour les énerver)."]
	quest.30ED5FF9DF7B34CF.quest_desc: ["En pillant un camp d'Habitants ou en le fabriquant, on peut utiliser le totem mystérieux ! \\n\\nEuh... comment on s'en sert ? \\n\\nPosez-le simplement et toutes les quelques secondes, il vous donne &bPureté&r pendant 10 secondes. \\n\\n&bPureté&r vous purifie de la &cpourriture&r."]
	quest.353AEEC116A5DEEF.quest_desc: [
		"Les mers anciennes sont de vastes mers ouvertes dans l'&2&lUndergarden&r. \\n\\nBizarrement, malgré toute cette pollution, l'eau est potable. \\n\\nL'eau abrite aussi des &bGwibs&r et des &bGwiblings&r. Sans oublier l'algue scintillante !"
		"{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}"
	]
	quest.353AEEC116A5DEEF.title: "Mer ancienne"
	quest.36389696767EFB4E.quest_desc: [
		"L'abysse stérile est, comme son nom l'indique, stérile... Il n'y a rien d'autre que des monstres hostiles et des cailloux. \\n\\nPersonnellement, je préfère trouver des cailloux n'importe où ailleurs..."
		"{image:atm:textures/questpics/undergarden/undergarden_barren.png width:200 height:100 align:center}"
	]
	quest.36389696767EFB4E.title: "Abysse stérile"
	quest.380D3212D1CBA593.quest_desc: [
		"La créature &cpourrie&r de taille moyenne : le &cRotwalker&r. \\n\\nIl a 20 cœurs. \\n\\nComme toutes les &ccréatures pourries&r, il cible les &2Nés-de-pierre&r et les &7Oubliés&r et lâche des &céclats uthériques&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotwalker.png width:100 height:200 align:center}"
	]
	quest.380D3212D1CBA593.title: "&cRotwalker&r"
	quest.3AF7446592D19FA6.quest_desc: ["Le &eregalium&r est l'équivalent de l'émeraude dans l'&2&lUndergarden&r. \\n\\nOn ne peut pas en faire d'armures ni d'outils, mais il sert à faire des échanges avec les &2Nés-de-pierre&r contre d'autres objets."]
	quest.3AF7446592D19FA6.title: "&eRégalium&r"
	quest.4141EF8B8C316118.quest_desc: ["Le &7cloggrum&r est le fer de l'&2&lUndergarden&r. \\n\\nOn le trouve partout et il sert dans une dizaine de recettes différentes. \\n\\nMême certains monstres en lâchent !"]
	quest.4141EF8B8C316118.title: "&7Cloggrum&r"
	quest.43A1BC20BB054A14.quest_desc: ["L'algue scintillante pousse dans les mers anciennes et glacées. \\n\\nElle ne fait pas grand-chose à part briller, et on peut en faire une tarte !"]
	quest.43FD4AEBB9548E57.quest_desc: [
		"La forêt de smogstem est un biome voisin des marais aux champignons indigo. \\n\\nBien sûr, elle est aussi bleue et a des champignons indigo ! Mais avec de plus grands arbres smogstem !"
		"{image:atm:textures/questpics/undergarden/undergarden_smogstem.png width:200 height:100 align:center}"
	]
	quest.43FD4AEBB9548E57.title: "Forêt de smogstem"
	quest.4568C2F465EDB960.quest_desc: ["Le droopfruit peut apparaître dans à peu près tous les biomes, il suffit de lever les yeux ! \\n\\nIl apparaît au plafond de la plupart des biomes et pousse un peu comme les baies lumineuses."]
	quest.46DCB235D3FEDA61.quest_desc: ["Comme les outils en fer, mais tous ralentissent ceux qu'ils touchent. \\n\\nEnfin, sauf la houe, mais vous vous intéressez vraiment à une simple houe ?"]
	quest.46DCB235D3FEDA61.title: "Outils en &bfroststeel&r"
	quest.4985F82E0D300C6D.quest_desc: ["Si vous voulez rentrer dans l'&2&lOverworld&r mais que vous ne retrouvez pas votre portail d'origine, pas d'inquiétude, il y a une solution ! \\n\\nAvec 4 roches profondes, 4 &7lingots de cloggrum&r et une &apépite oubliée&r, vous pouvez fabriquer le catalyseur effrité. \\n\\nIl fonctionne exactement comme le catalyseur normal pour activer un portail."]
	quest.49EB9FB2133E3219.quest_desc: ["L'armure ancienne est portée par les &7Oubliés&r, et c'est sur eux qu'on peut l'obtenir. \\n\\nIl n'y a pas de bottes anciennes : apparemment, les &7Oubliés&r n'ont pas de pieds."]
	quest.49EB9FB2133E3219.title: "Armure ancienne"
	quest.4C5CFA45D9B4F6D3.quest_desc: ["Les champignons indigo sont apparemment les meilleurs amis des smogstem et apparaissent surtout avec eux !"]
	quest.4C7E006502E30C20.quest_desc: ["Cette quête a été créée par le personnel de &6AllTheMods&r ou un contributeur de la communauté &2Community contributor&r pour être utilisée dans les modpacks AllTheMods.\\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut être utilisée dans aucun pack public non publié par l'équipe &6AllTheMods&r sans autorisation explicite.\\n\\nCette quête est intentionnellement masquée. Si vous la voyez, c'est que vous êtes en mode édition."]
	quest.4D836B9D9E3B898F.quest_desc: [
		"Les &aNés-de-pierre&r sont le mélange parfait entre villageois et golems de fer. \\n\\nVous pouvez faire du commerce avec eux par un clic droit. \\n\\nEt ils combattent les monstres hostiles (ou les joueurs qui les frappent)."
		"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
	]
	quest.4D836B9D9E3B898F.title: "&aNé-de-pierre&r"
	quest.4E3D548E5D8D7D26.quest_desc: [
		"Les champs oubliés sont les plaines de l'&2&lUndergarden&r. \\n\\nIl n'y a pas d'arbres, mais plein de rochers, de fleurs et de créatures ! \\n\\nMais les &7Oubliés&r n'y apparaissent pas, désolé de casser votre enthousiasme."
		"{image:atm:textures/questpics/undergarden/undergarden_field.png width:200 height:100 align:center}"
	]
	quest.4E3D548E5D8D7D26.title: "Champs oubliés"
	quest.4F3B4990BE6C2A4A.quest_desc: [
		"Les &7Scintlings&r sont de petites limaces innocentes qu'on trouve partout dans l'&2&lUndergarden&r. \\n\\nElles font comme les golems de neige : elles laissent une traînée partout où elles passent. Sauf que celle-ci est plus gluante... \\n\\nÀ leur mort, elles lâchent de la glu de scintling, mais vous pouvez simplement la récolter sur leurs traînées, alors pourquoi les tuer !"
		"{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}"
	]
	quest.4F3B4990BE6C2A4A.title: "&7Scintling&r"
	quest.4F5A2E2A5C7F4837.quest_desc: ["Les &alingots oubliés&r s'obtiennent dans les catacombes, en pillant les coffres ou en tuant le &aGardien oublié&r. \\n\\nIl vous faudra aussi un modèle de forge, qu'on trouve dans les coffres des catacombes."]
	quest.4F5A2E2A5C7F4837.title: "&aOublié&r"
	quest.511144EF336BFAF5.quest_desc: [
		"Les flèches de smog sont... oui, vous avez deviné ! L'endroit d'où vient tout le smog ! Enfin pas tout, on ne peut pas oublier les &2Mogs&r et les &3S'mogs&r. \\n\\nVous y trouverez des baies cloquées, de la terre profonde grossière et des évents de smog. Je ne conseille pas de s'en approcher..."
		"{image:atm:textures/questpics/undergarden/undergarden_smogspires.png width:200 height:100 align:center}"
	]
	quest.511144EF336BFAF5.title: "Flèches de smog"
	quest.51C59FDF0BD11FDF.quest_desc: ["Je suis à peu près sûr que la seule définition d'un arbre de bois ondulant, c'est qu'il a des bûches et des feuilles de bois ondulant. Ils semblent pousser dans toutes les directions, tailles et formes. \\n\\nOn les trouve dans les forêts de bois ondulant et les forêts denses. \\n\\nIls ont de jolies feuilles roses et des bûches brunes, un peu comme le sapin !"]
	quest.51E2728C5E35A152.quest_desc: ["Le froststeel apparaît dans les biomes gelés : champs de givre, forêts de smogstem givrées, et sans doute les mers glacées. \\n\\nIl apparaît dans la pierre-frisson, qui remplace la roche profonde dans ces biomes. La pierre-frisson se comporte un peu comme la glace : elle est glissante et vous ralentit un peu. \\n\\nVous pouvez aussi trouver des pépites dans le ventre des Munchers !"]
	quest.51E2728C5E35A152.title: "&bAcier givré&r"
	quest.53FDC6C536E50A1A.quest_desc: ["Les &bGwiblings&r sont des poissons amicaux des mers. \\n\\nIls sont plus petits que les &bGwibs&r et se comportent comme les poissons du jeu de &2&lbase&r !"]
	quest.53FDC6C536E50A1A.title: "&bGwibling&r"
	quest.57545837046F552B.quest_desc: [
		"Attendez, ce n'est pas un pot normal ! \\n\\nLes &2pots mystérieux&r sont des créatures vivantes déguisées en pots. \\n\\nIls ont 4 cœurs et s'enfuient quand on les frappe. S'ils se croient hors de danger, ils reprennent leur déguisement. \\n\\nÀ leur mort, ils peuvent lâcher du &7cloggrum&r, des &bpépites de froststeel&r et des &céclats uthériques&r."
		"{image:atm:textures/questpics/undergarden/undergarden_pot.png width:100 height:120 align:center}"
	]
	quest.57545837046F552B.title: "&2Pots mystérieux"
	quest.5AF0E903DB670D65.quest_desc: ["Avec de la roche de l'effroi, du &3rogdorium&r et un &camas uthérique&r, on peut fabriquer l'infuseur ! \\n\\nC'est un bloc qui sert à fabriquer et infuser certains objets. Pour l'instant, il n'y a pas beaucoup de recettes, mais je parie qu'on en verra plus ! \\n\\nIl sert surtout à fabriquer des &ccristaux uthériques&r et à infuser les armures avec du &3rogdorium&r. \\n\\nUne armure infusée de &3rogdorium&r vous protège de la maladie de la &cpourriture&r."]
	quest.5B4B5C148D63ACA1.quest_desc: [
		"Les &asbires oubliés&r n'apparaissent pas comme des monstres normaux : il faut les créer. On les crée en posant une gloomgourd sculptée sur un &abloc de lingots oubliés&r. \\n\\nIls se comportent comme les golems de neige : ils ne vous attaquent jamais et tirent sur les monstres hostiles. \\n\\nIls ont 10 cœurs et ne lâchent rien à leur mort... mais pourquoi les tueriez-vous ?"
		"{image:atm:textures/questpics/undergarden/undergarden_minion.png width:125 height:100 align:center}"
	]
	quest.5B4B5C148D63ACA1.title: "&aSbires oubliés&r"
	quest.5D229FA3A5F92954.quest_desc: [
		"Les &4Munchers&r ressemblent aux autres monstres hostiles de l'&2&lUndergarden&r, mais leur butin les rend bien plus utiles ! \\n\\nLe Muncher peut lâcher du &7cloggrum&r et des &bpépites de froststeel&r à sa mort."
		"{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}"
	]
	quest.5D229FA3A5F92954.title: "&4Muncher&r"
	quest.5E63C78CDC44FF95.quest_desc: ["Les baies cloquées pourries ne se lancent pas, mais transformées en bombes cloquées, si ! \\n\\nOn peut même aller plus loin et faire des boomgourds, qui agissent comme de la TNT qui projette des baies cloquées partout."]
	quest.5E63C78CDC44FF95.title: "Des explosifs !!!"
	quest.5FCA6F5FE97780B7.quest_desc: [
		"Les &eGronglets&r sont techniquement des blocs, pas des créatures. Mais je les aime trop pour ne pas les inclure ! \\n\\nIls apparaissent sur les arbres grongle et émettent du bruit et de la lumière ! Parfaits pour la décoration."
		"{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}"
	]
	quest.5FCA6F5FE97780B7.title: "&eGronglets&r"
	quest.6124C0E9E419694B.quest_desc: ["Améliorez les outils en &7cloggrum&r avec des &alingots oubliés&r et un modèle de forge. \\n\\nCe sont les meilleurs outils possibles : ils ont déjà Efficacité, mais seulement pour les blocs de l'&2&lUndergarden&r. \\n\\nEt l'épée et la hache font plus de dégâts à toutes les créatures de l'&2&lUndergarden&r, sauf la &cBête pourrie&r et le &aGardien oublié&r !"]
	quest.6124C0E9E419694B.title: "Outils &aoubliés&r"
	quest.647A87E800C703C3.quest_desc: [
		"De loin mon biome préféré ! \\n\\nUne immense jungle verte avec d'énormes arbres Gronglegrowth. \\n\\nSur ces arbres, vous trouverez des &eGronglets&r !"
		"{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}"
	]
	quest.647A87E800C703C3.title: "Gronglegrowth"
	quest.6751F2651063B3A5.quest_desc: ["On trouve les champignons de sang dans leurs marais. \\n\\nIls ont la forme de chênes noirs et sont surtout blancs, avec seulement quelques blocs tachés de sang !"]
	quest.67A2347534269528.quest_desc: [
		"Les &9Sploogies&r apparaissent rarement, mais quand ils le font, c'est pour vous agacer. \\n\\nIls vous crachent dessus (en faisant des bruits de succion dégoûtants), mais si vous les frappez, ils s'enfuient, comme un bébé piglin. \\n\\nIls ne lâchent que des cailloux de roche profonde à leur mort."
		"{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}"
	]
	quest.67A2347534269528.title: "&9Sploogie&r"
	quest.6C4B93FE64BD418D.quest_desc: ["Aller dans l'&2&lUndergarden&r ressemble à aller dans &c&lle Nether&r. Il faut fabriquer un portail. \\n\\nIl a la même forme et la même taille qu'un portail du Nether, mais au lieu d'obsidienne, il faut une variante de briques de pierre : briques de pierre, briques de pierre moussues ou briques d'ardoise des abîmes. \\n\\nUne fois formé, vous pouvez l'activer en utilisant le catalyseur dessus."]
	quest.6C4B93FE64BD418D.quest_subtitle: "Fabriquer le portail"
	quest.6C4B93FE64BD418D.title: "The Undergarden"
	quest.6D4FB6291CA8D1A6.quest_desc: ["Les arbres smogstem sont bien plus épais dans leur moitié basse, comme les baobabs dans la vraie vie ! \\n\\nIls ont des feuilles bleues et des bûches grises. \\nOn les trouve dans plusieurs biomes : forêts de smogstem, forêts denses, et même dans les marais à champignons indigo !"]
	quest.6E7C8537D8A28833.quest_desc: [
		"Sous la couche Y 0, il y a deux biomes, les profondeurs en sont un. \\n\\nPour descendre sous la couche Y 0, il faut miner de la roche d'effroi. Pour miner la roche d'effroi, il vous faut une pioche oubliée ou une pioche en allthemodium. \\n\\nIci apparaissent des grands habitants, des résidents et des monstres pourris."
		"{image:atm:textures/questpics/undergarden/undergarden_depths.png width:200 height:100 align:center}"
	]
	quest.6E7C8537D8A28833.title: "Profondeurs"
	quest.6F416275B6F6D8F0.quest_desc: ["Les baies cloquées apparaissent dans les flèches de smog. \\n\\nComme elles poussent dans un endroit aussi dégoûtant, certaines sont pourries. \\n\\nJe ne recommande pas de manger celles-là, elles peuvent peut-être servir à autre chose !"]
	quest.6F483B77D64F4EE2.quest_desc: [
		"Sous la couche Y 0, il y a deux biomes, le bosquet de rogdorium en est un. \\n\\nPour descendre sous la couche Y 0, il faut miner de la roche d'effroi. Pour miner la roche d'effroi, il vous faut une pioche oubliée ou une pioche en allthemodium. \\n\\nUn biome bien plus agréable que les profondeurs. Beaucoup moins de monstres et beaucoup plus de plantes ! Avec des arbres smogstem et plein de fleurs."
		"{image:atm:textures/questpics/undergarden/undergarden_rogdorium.png width:200 height:100 align:center}"
	]
	quest.6F483B77D64F4EE2.title: "Bosquet de rogdorium"
	quest.70FD8856BFCD9AEE.quest_desc: [
		"Le plus grand et le plus dangereux des &cmonstres pourris&r. \\n\\nIl a 80 cœurs, ce qui en fait un boss selon moi. \\n\\nComme tous les &cmonstres pourris&r, il cible les &2Stoneborns&r et les &7Forgottens&r et lâche des &céclats uthériques&r."
		"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
	]
	quest.70FD8856BFCD9AEE.title: "&cBête pourrie&r"
	quest.71E1454990DEC451.quest_desc: [
		"Les &bGwibs&r sont des versions plus grandes et plus en colère des &bGwiblings&r. \\n\\nIls ne lâchent rien et on ne peut pas les mettre dans un seau. Tout ce qu'ils offrent, c'est de la douleur !"
		"{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}"
	]
	quest.71E1454990DEC451.title: "&bGwib&r"
	quest.739601B0C43B239B.quest_desc: ["Oui, elles peuvent faire de la teinture noire !"]
	quest.744DBE831C120B2F.quest_desc: [
		"Ce caillou bouge ? Oh, attendez, ce n'est pas un caillou, c'est un &aMog&r ! \\n\\nLes &aMogs&r se reproduisent avec des cailloux de roche des profondeurs et, à leur mort, peuvent lâcher d'autres cailloux ou de la mousse de Mog ! \\n\\nLa mousse de Mog sert dans plein de recettes différentes !"
		"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
	]
	quest.744DBE831C120B2F.title: "&aMog&r"
	quest.75A66B81C1181F59.quest_desc: ["Les vestiges oubliés sont de toutes petites ruines en briques de roche des profondeurs qu'on trouve dans l'&2&lUndergarden&r. \\n\\nIl y a plein de pots remplis de butin ! \\n\\nCassez-les, tout simplement !"]
	quest.75A66B81C1181F59.title: "Vestige oublié"
	quest.7617737FC179EA1A.quest_desc: ["L'armure en &bfroststeel&r est un peu moins bonne que l'armure en diamant, mais elle donne aussi une grosse résistance au recul. \\n\\nPar contre, elle donne aussi un malus de vitesse : on dirait qu'on ne va pas beaucoup bouger !"]
	quest.7617737FC179EA1A.title: "Armure en &bfroststeel&r"
	quest.76CDC18D7A208512.quest_desc: ["Dans l'&2&lUndergarden&r, les &cmonstres pourris&r (&crotling&f, &crotwalker&f, &crotbelcher&f et la &cbête pourrie&r) peuvent vous infecter avec de l'&cuthérium&r. \\n\\nSi vous l'attrapez, ça apparaît sous forme de barres rouges au-dessus de vos barres de faim. Après 4 barres pleines, des lignes rouges apparaissent sur votre écran. À 8 barres, les barres se mettent à trembler pour vous avertir que ça empire. À 10 barres, elles brillent toutes, et c'est là que vous commencez à prendre des dégâts. \\n\\nLa &cpourriture&r s'en va lentement toute seule, sauf si elle est pleine. Vous pouvez aussi obtenir la pureté grâce aux totems mystérieux, ou manger du &3rogdorium&r pour vous en débarrasser. \\n\\nLes deux viennent des profondeurs, qui apparaissent sous la couche Y 0. Il vous faudra une &apioche oubliée&r ou une autre pioche du même niveau, comme en &6allthemodium&r, pour y accéder. \\n\\nLe seul moyen d'empêcher la &cpourriture&r est d'infuser votre armure avec du &3rogdorium&r grâce à l'infuseur."]
	quest.76CDC18D7A208512.title: "Attention"
	quest.79C652E3FCB88550.quest_desc: [
		"Les &5Gloompers&r sont techniquement passifs, mais ils ont un mécanisme de défense contre vous, donc je les considère comme neutres ! \\n\\nQuand on les frappe, ils lâchent un effet semblable à une potion persistante. \\n\\nÀ leur mort, ils lâchent leurs cuisses (très savoureuses) et parfois du cuir. \\n\\nOn peut aussi les faire se reproduire avec des gloomgourds !"
		"{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}"
	]
	quest.79C652E3FCB88550.title: "&5Gloomper&r"
	quest.7E3DA4168D352B42.quest_desc: [
		"Promis, c'est le dernier marais à champignons ! \\nCes champignons ont l'air assez normaux, mais leur particularité, c'est ce qui en sort ! \\n\\nLes voiles ! Un bloc de déco vraiment utile."
		"{image:atm:textures/questpics/undergarden/undergarden_veil.png width:200 height:100 align:center}"
	]
	quest.7E3DA4168D352B42.title: "Marais à champignons voilés"
	task.39194D9CDF673768.title: "Tous droits réservés"
	task.4AA225E5056787B8.title: "Tous droits réservés"
}
