{
	quest.00075A5F9AC120ED.quest_desc: ["Ceci va retirer les objets de votre coffre d'entrée."]
	quest.00075A5F9AC120ED.quest_subtitle: "Toujours nécessaire"
	quest.002163B909070CF8.quest_desc: [
		"Permet de voir les détails de certains blocs/fluides, même à travers les murs.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
	]
	quest.002163B909070CF8.quest_subtitle: "Max : 1"
	quest.00D7BCC68D971A53.quest_desc: ["Les créatures vivantes proches sont suivies automatiquement, même à travers les murs. Si c'est un monstre agressif, vous recevrez un avertissement quand il vous prend pour cible."]
	quest.00D7BCC68D971A53.quest_subtitle: "Max : 1"
	quest.02643BAD1AE747C6.quest_desc: ["Le &3compresseur de liquide avancé&r fonctionne comme le compresseur de liquide, en bien meilleur !"]
	quest.04BE9F63E6003475.quest_desc: ["Le &3GPL&r peut servir à fabriquer du plastique fondu."]
	quest.04BE9F63E6003475.quest_subtitle: "Celui qu'il nous faut"
	quest.04BE9F63E6003475.title: "GPL"
	quest.0672462DA3599484.quest_subtitle: "512 000 mB"
	quest.09BA45CBBFB4AE26.quest_desc: ["L'étape suivante de ce mod demande de mettre en place des &3chaînes d'assemblage&r. Le composant principal d'une &3chaîne d'assemblage&r est le &3contrôleur d'assemblage&r.\\n\\nC'est là que va la pression."]
	quest.09BA45CBBFB4AE26.quest_subtitle: "Toujours nécessaire"
	quest.0A912B2E2BE34920.quest_desc: [
		"On peut trouver du pétrole brut en surface, mais forer est un excellent moyen d'en obtenir beaucoup. Utilisez d'abord un &3capteur sismique&r jusqu'à trouver du pétrole sous vous, puis utilisez votre &3élévateur à gaz&r rempli de tiges de forage pour forer. (Il a besoin de pression pour fonctionner).\\n"
		"{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
	]
	quest.0A912B2E2BE34920.quest_subtitle: "Forer pour du pétrole"
	quest.0AEAEA976ED0C470.quest_desc: ["La &3station de recharge&r sert à recharger divers outils et gadgets de &aPneumaticCraft&r avec de la pression."]
	quest.0AEAEA976ED0C470.quest_subtitle: "Où est le câble ?"
	quest.0CC48C2AA553A314.quest_desc: ["Les &3forets&r s'utilisent dans un marteau-piqueur pneumatique."]
	quest.0D2F5CC96269F9E3.quest_desc: ["L'étape suivante pour fabriquer des circuits imprimés utilise la &3cuve de gravure&r avec de l'acide de gravure. Elle a besoin de chaleur pour fonctionner."]
	quest.0D2F5CC96269F9E3.quest_subtitle: "C'est l'heure de la gravure !"
	quest.0D31CD79BE6CC8D2.quest_desc: ["Pourquoi le pain normal n'a pas besoin de levure ?"]
	quest.0D31CD79BE6CC8D2.quest_subtitle: "La levure de tous vos problèmes"
	quest.0D31CD79BE6CC8D2.title: "Levure"
	quest.0D5015B8FF482D0A.quest_desc: [
		"Il faudra commander des choses sur &3Amadron&r avec la &3tablette Amadron&r pour continuer à progresser. Pour l'utiliser, faites accroupi + clic droit sur un coffre et sur un réservoir de fluide, mettez votre monnaie dans un conteneur relié (émeraudes, etc.) et commandez quelque chose. Vous verrez un Amadrone descendre prendre votre argent, et un autre venir déposer ce que vous avez commandé."
		""
		"{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
	]
	quest.0D5015B8FF482D0A.quest_subtitle: "Je me demande s'ils livrent en 1 jour ?"
	quest.0D5015B8FF482D0A.title: "Amadron"
	quest.0D50BDEFA0319EA1.quest_desc: ["Ceci dépose le produit fini dans votre coffre de sortie."]
	quest.0D50BDEFA0319EA1.quest_subtitle: "Toujours nécessaire"
	quest.0D9560C8E247F9E7.quest_desc: ["Faites un clic droit quelque part et vous pourrez retrouver votre chemin jusque-là. Si vous êtes assez près et qu'il existe un trajet direct, un chemin apparaîtra."]
	quest.0D9560C8E247F9E7.quest_subtitle: "Max : 1"
	quest.0E65BE9460B74000.quest_desc: [
		"Les cadres logistiques doivent être reliés à un &3module logistique&r pour fonctionner."
		""
		"{image:pneumaticcraft:textures/patchouli/logistics_module.png width:100 height:100 align:left fit:true}"
	]
	quest.0F49E9167B5E97C9.quest_desc: ["Tous les dégâts de chute que vous subissez (sans compter l'armure) sont aussi infligés aux monstres proches."]
	quest.0F49E9167B5E97C9.quest_subtitle: "Max : 1"
	quest.0FF050EC1EA6EAED.quest_desc: ["L'&3entonnoir à liquide&r est un entonnoir, mais pour les liquides. Ce n'est pas un remplacement des tuyaux."]
	quest.0FF050EC1EA6EAED.quest_subtitle: "Qui a besoin de tuyaux ?"
	quest.122EDEC12C9A05D2.quest_desc: ["J'ai oublié de dire que tout peut exploser ? ...\\n\\nHeureusement, il y a une solution simple ! L'&3amélioration de sécurité&r, placée dans une machine, l'empêche d'exploser ; mettez-en dans toutes les machines qui l'acceptent."]
	quest.122EDEC12C9A05D2.quest_subtitle: "Si seulement il y avait une solution simple..."
	quest.122EDEC12C9A05D2.title: "Éviter les explosions ?"
	quest.132DF9ECEFFB3B71.quest_desc: ["La &3carte d'extension de module&r rend le module de recharge encore meilleur."]
	quest.13F68CA518CD287C.quest_desc: ["Le &3diesel&r peut servir à fabriquer plus de kérosène ou du lubrifiant."]
	quest.13F68CA518CD287C.quest_subtitle: "Pauvre Sel"
	quest.13F68CA518CD287C.title: "Diesel"
	quest.1427B3AB09510D20.quest_desc: ["Assemblez votre circuit imprimé non assemblé avec 2 condensateurs et 2 transistors pour obtenir un &3circuit imprimé fini&r."]
	quest.1427B3AB09510D20.quest_subtitle: "Vous avez réussi !"
	quest.142C67218BD16867.quest_desc: ["Chargez votre minigun avec ces &3munitions de minigun&r pour l'utiliser."]
	quest.15007DCAF701B361.quest_desc: ["Recharge les autres objets pressurisables de votre inventaire avec la réserve du plastron."]
	quest.15007DCAF701B361.quest_subtitle: "Max : 6"
	quest.15D355EB164EBE68.quest_subtitle: "Nécessaires pour les circuits imprimés finis"
	quest.15D355EB164EBE68.title: "Condensateurs"
	quest.187816477B732517.quest_desc: ["Le &3gadget de transfert&r agit comme un entonnoir qu'on peut placer entre des blocs."]
	quest.187816477B732517.quest_subtitle: "Un entonnoir plus petit"
	quest.21624A6500545C42.quest_desc: [
		"Les &3tuteurs à cultures&r se placent au-dessus de vos cultures pour les faire pousser plus vite."
		""
		"{image:atm:textures/questpics/pneumaticcraft/crop_support.png width:200 height:100 align:center}"
	]
	quest.21624A6500545C42.quest_subtitle: "Des cultures plus rapides"
	quest.22572456571C3F8D.quest_desc: ["Le &3module de recharge&r dépressurise tous les objets pressurisables des conteneurs vers lesquels il pointe."]
	quest.230463E830D6FFEB.quest_desc: ["Maintenant qu'on a du plastique, l'étape suivante est d'obtenir des circuits imprimés finis ; commencez par fabriquer des &3circuits imprimés vierges&r dans la chambre de pression."]
	quest.230463E830D6FFEB.quest_subtitle: "Le chemin vers les circuits imprimés"
	quest.2338E5269CA23C91.quest_desc: ["Le &3foret en netherite&r est le meilleur foret, encore meilleur que le foret en diamant."]
	quest.2338E5269CA23C91.quest_subtitle: "C'est le meilleur foret"
	quest.23737103592776C2.quest_desc: ["La &3lampe à kérosène&r est une excellente source de lumière qui utilise du carburant (le kérosène étant le meilleur) pour éclairer."]
	quest.23737103592776C2.quest_subtitle: "Les méga-torches, c'est rien !"
	quest.24042326B4632DD4.quest_desc: ["Pour commencer la logistique, fabriquez un &3noyau logistique&r ; je recommande de lire le manuel de PNC:R pour un tutoriel complet sur l'utilisation de ces objets."]
	quest.24042326B4632DD4.quest_subtitle: "Transporter des objets/fluides"
	quest.24042326B4632DD4.title: "Logistique"
	quest.26BEA64C80ECE1A6.quest_desc: ["Chaque &3cadre logistique&r sert à un type d'automatisation différent."]
	quest.2745297337E13E9E.quest_desc: ["Le &3compresseur d'air avancé&r fonctionne comme le compresseur d'air, en bien meilleur !"]
	quest.2745297337E13E9E.quest_subtitle: "Plus besoin des vieux compresseurs d'air ennuyeux !"
	quest.2801B7B6BF61E978.quest_desc: ["Le &3kérosène&r peut servir à fabriquer de l'essence ou de carburant pour une lampe à kérosène."]
	quest.2801B7B6BF61E978.quest_subtitle: "Vous avez kéro-vu ça ?"
	quest.2801B7B6BF61E978.title: "Kérosène"
	quest.2AED15E3AC0346FE.quest_desc: [
		"Voici quelques &3améliorations&r utilisables tôt dans ce mod. Maintenez Maj en survolant une &3amélioration&r pour voir où elle peut servir, ou Maj en survolant quelque chose pour voir quelles améliorations il accepte."
		""
		"Note : le sous-titre indique la quantité max de cette &3amélioration&r qu'on peut mettre dans quelque chose."
	]
	quest.2AED15E3AC0346FE.quest_subtitle: "Des trucs très utiles"
	quest.2AED15E3AC0346FE.title: "Améliorations simples"
	quest.2C5D78630C7AD57F.quest_desc: ["Augmente la portée, fait des choses différentes selon où on l'utilise."]
	quest.2C5D78630C7AD57F.quest_subtitle: "Approchez-vous !"
	quest.2CC56A4F06E53307.quest_desc: [
		"Mettez vos circuits imprimés vierges dans une &3boîte à lumière UV&r pour les charger. Elle a besoin de pression et d'un accès à la lumière du soleil."
		"{image:atm:textures/questpics/pneumaticcraft/uv_charging.png width:300 height:150 align:center}"
	]
	quest.2CC56A4F06E53307.quest_subtitle: "J'espère que vous avez des lunettes de soleil !"
	quest.2CC56A4F06E53307.title: "Charger aux UV"
	quest.2DE7CC686B56881F.quest_desc: ["Vous protège des radiations de Mekanism."]
	quest.2DE7CC686B56881F.quest_subtitle: "Max : 1"
	quest.2E8F851A4E98F741.quest_desc: [
		"L'&3armure pneumatique&r est déjà très bien seule, mais pour la rendre géniale, il faut y installer des améliorations. Appuie sur 'U' (par défaut) pour ouvrir l'interface d'amélioration ; certaines améliorations utilisent de la pression, d'autres non."
		""
		"Comme pour les autres outils de PneumaticCraft, pour améliorer l'&3armure pneumatique&r, il vous faut une station de recharge avec de la pression."
		""
		"Note : le sous-titre indique la quantité max de cette amélioration qu'on peut mettre dans quelque chose."
	]
	quest.2E8F851A4E98F741.quest_subtitle: "L'homme de fer compressé"
	quest.2E8F851A4E98F741.title: "Armure pneumatique"
	quest.30AD7B15682E4D0E.quest_desc: ["Un panneau intelligent qui peut stocker et afficher autant de texte qu'on veut, mis à l'échelle pour toujours tenir.\\n\\nClic droit avec une teinture pour changer la couleur ; vous pouvez colorer la bordure et le fond séparément."]
	quest.30AD7B15682E4D0E.quest_subtitle: "Des panneaux ? Jamais entendu parler !"
	quest.312331F6DB0CE5F4.quest_desc: ["Allez plus vite que le niveau I."]
	quest.312331F6DB0CE5F4.quest_subtitle: "Max : 1"
	quest.31BCE63F5E016323.quest_desc: ["Le &3compresseur solaire&r produit de la pression grâce à la lumière du soleil : plus il fait chaud, plus il produit de pression.\\n\\nMais attention, s'il chauffe trop, il tombe en panne et il faudra le réparer."]
	quest.31BCE63F5E016323.quest_subtitle: "Dans le creux de ma main..."
	quest.31BCE63F5E016323.title: "La pression du soleil"
	quest.325483DEB0C602F8.quest_desc: ["Cette quête a été écrite par l'&6équipe AllTheMods&r ou un &2contributeur de la communauté&r pour les modpacks AllTheMods. \\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut pas être utilisée dans un pack public non publié par l'&6équipe AllTheMods&r sans autorisation explicite. \\n\\nCette quête est volontairement cachée ; si vous la voyez, c'est que vous êtes en mode édition."]
	quest.32C3E14578D48E6C.quest_desc: ["Comme les &3tubes de pression&r normaux, mais ceux-ci supportent 10 bars de pression."]
	quest.32C3E14578D48E6C.quest_subtitle: "Tubes de pression améliorés"
	quest.3334D15766A47A46.quest_desc: ["Avec un programme d'assemblage laser, vous pouvez accélérer la production de &3circuits imprimés non assemblés&r. Mettez simplement un circuit imprimé vierge dans le coffre d'entrée, envoie de la pression et attendez."]
	quest.3334D15766A47A46.title: "Automatiser les circuits imprimés"
	quest.36D72D759C4E8823.quest_desc: ["Peut-être même un peu trop rapide."]
	quest.36D72D759C4E8823.quest_subtitle: "Max : 1"
	quest.371A34B297C8A8EF.quest_desc: ["PneumaticCraft, c'est tout sur la pression ! Ces quêtes ne couvrent pas tout le mod, mais quand même beaucoup ! Pensez à consulter JEI, lire les infobulles et lire le manuel PNC:R, ils sont tous très utiles.\\n\\nPour commencer, il vous faut des &3lingots de fer compressé&r ! Le plus simple : creusez un trou, mettez-y des lingots de fer (ou des blocs) puis faites tout sauter avec de la TNT !\\n\\nCertains peuvent se perdre dans l'explosion, mais c'est un risque à prendre !"]
	quest.371A34B297C8A8EF.quest_subtitle: "La puissance de l'air"
	quest.371A34B297C8A8EF.title: "PneumaticCraft: Repressurized"
	quest.39F142224D5210A9.quest_desc: ["Le &3biodiesel&r peut servir à fabriquer du &3lubrifiant&r et du &3plastique fondu&r."]
	quest.39F142224D5210A9.quest_subtitle: "Bio/diesel"
	quest.39F142224D5210A9.title: "Biodiesel"
	quest.3A9AC6AB4407DC32.quest_desc: ["Même si toutes les recettes ne demandent pas les mêmes composants, vous pouvez installer vos &3chaînes d'assemblage&r avec tout dedans. Une installation simple de &3chaîne d'assemblage&r utilisable pour tout est montrée sur l'image ci-dessous. Lisez les quêtes de chaque composant pour des infos importantes.\\n\\nLes améliorations de vitesse rendent tout ça bien plus rapide !"]
	quest.3A9AC6AB4407DC32.quest_subtitle: "Montage nécessaire"
	quest.3A9AC6AB4407DC32.title: "Utiliser les chaînes d'assemblage"
	quest.3CFE522A4B7CC2EC.quest_desc: [
		"Le &3coffre renforcé&r est un coffre résistant aux explosions avec 36 emplacements. Il ne peut pas devenir un grand coffre. Il fonctionne aussi comme une boîte de Shulker."
		"{image:atm:textures/questpics/pneumaticcraft/reinforced_chest_ui.png width:200 height:100 align:center}"
	]
	quest.3CFE522A4B7CC2EC.quest_subtitle: "Mieux que votre coffre de tous les jours"
	quest.3D819550074CA376.quest_desc: ["L'objet devra être placé ici avant d'être récupéré."]
	quest.3D819550074CA376.quest_subtitle: "Toujours nécessaire"
	quest.3E16CF590C911129.quest_desc: ["Le &3compresseur d'air&r est un moyen facile de produire de la pression : mettez-y des objets combustibles et regarde la magie opérer ! (Je recommande d'en fabriquer au moins 3 pour commencer.)"]
	quest.3E16CF590C911129.quest_subtitle: "Sous pression"
	quest.3E16CF590C911129.title: "Produire de la pression"
	quest.3F9CCCFEF4E84166.quest_desc: ["Pour augmenter votre production de chaleur, placez un &3dissipateur thermique&r du côté froid de votre tube vortex."]
	quest.3F9CCCFEF4E84166.quest_subtitle: "Plus de chaleur"
	quest.3F9CCCFEF4E84166.title: "Meilleure production de chaleur"
	quest.40924F0D64253A38.quest_desc: ["Permet à des choses de distribuer des objets."]
	quest.40924F0D64253A38.quest_subtitle: "Disparu !"
	quest.40F634AC38F42B88.quest_desc: ["Pour déplacer la pression, il vous faudra des &3tubes de pression&r. Quelle pression, vous demandez ? Continuez la série de quêtes pour voir à quoi ils servent."]
	quest.40F634AC38F42B88.quest_subtitle: "Quelle pression ?"
	quest.40F634AC38F42B88.title: "Déplacer la pression"
	quest.423B8DA485C1308C.quest_desc: ["L'&3essence&r peut servir à fabriquer du GPL."]
	quest.423B8DA485C1308C.quest_subtitle: "Gaz, gaz, gaz"
	quest.423B8DA485C1308C.title: "Essence"
	quest.42951D14ADCD9332.quest_desc: ["Je pourrais avoir ça avec de la purée de petits pois et des haricots sur toast, s'il vous plaît, chef ?"]
	quest.42951D14ADCD9332.quest_subtitle: "Envie d'un fish \\& chips ?"
	quest.42951D14ADCD9332.title: "Fish \\& chips !"
	quest.43CDC28DC56BB3E2.quest_subtitle: "128 000 mB"
	quest.43EF5513A1C52A37.quest_desc: ["L'&3usine de traitement thermopneumatique&r servira à fabriquer du plastique fondu : envoie simplement du GPL, du charbon et de la chaleur."]
	quest.43EF5513A1C52A37.quest_subtitle: "Plus le nom est long, mieux c'est"
	quest.43EF5513A1C52A37.title: "Traitement thermopneumatique"
	quest.440B1E1D4951F808.quest_desc: [
		"Le &3coffre intelligent&r est un coffre résistant aux explosions avec 72 emplacements, un entonnoir omnidirectionnel intégré entièrement configurable et des emplacements d'amélioration. Il ne peut pas devenir un grand coffre. Il fonctionne aussi comme une boîte de Shulker."
		"{image:atm:textures/questpics/pneumaticcraft/smart_chest_ui.png width:200 height:100 align:center}"
	]
	quest.440B1E1D4951F808.quest_subtitle: "L'intello des coffres"
	quest.456B9DD108CF340F.quest_desc: ["Rend les choses plus rapides."]
	quest.456B9DD108CF340F.quest_subtitle: "Vite !"
	quest.461C8F1E88AA58D9.quest_desc: [
		"Ils servent dans les recettes qui utilisent la version en seau des liquides de PneumaticCraft.\\n\\nQuand un &3réservoir de fluide&r est posé sur un autre &3réservoir de fluide&r et qu'on les relie avec une clé, ils deviennent un seul grand réservoir.\\n"
		"{image:pneumaticcraft:textures/patchouli/small_tanks.png width:250 height:250 align:center fit:true}"
	]
	quest.461C8F1E88AA58D9.quest_subtitle: "32 000 mB"
	quest.46BE62C20C720D10.quest_desc: ["Empêche les endermen de s'énerver contre vous, comme les citrouilles sculptées."]
	quest.46BE62C20C720D10.quest_subtitle: "Max : 1"
	quest.482E558BCFEE6B7E.quest_desc: ["Les &3briques de construction&r sont de jolis blocs de construction, mais attention, elles font mal. Refabriquez-les pour les rendre lisses."]
	quest.482E558BCFEE6B7E.quest_subtitle: "Aucune douleur n'est pire que de marcher dessus"
	quest.495DCA49B4E80852.quest_desc: ["La &3minigun&r est une arme qui a besoin de pression et de munitions pour fonctionner. Lisez l'infobulle pour plus d'infos."]
	quest.495DCA49B4E80852.quest_subtitle: "Piou piou !"
	quest.4A076530297F4A97.quest_desc: [
		"Avec ces 3 composants, vous pouvez créer de superbes &3ascenseurs&r.\\n"
		"{image:pneumaticcraft:textures/patchouli/elevator.png width:1 height:1 align:left fit:true}"
	]
	quest.4A076530297F4A97.title: "Ascenseurs"
	quest.4B4F5341D6DBDD19.quest_desc: ["Gardez votre souffle sous l'eau : quand vos bulles descendent à 5, elles sont remplies ! Ça permet aussi de voir bien plus facilement sous l'eau !"]
	quest.4B4F5341D6DBDD19.quest_subtitle: "Max : 1"
	quest.4C0D00B5305117A1.quest_desc: [
		"La &3tourelle sentinelle&r peut être placée quelque part et réglée pour attaquer les monstres ou les joueurs à portée. Il lui faut juste des munitions de minigun."
		""
		"{image:pneumaticcraft:textures/patchouli/sentry_turret.png width:100 height:100 align:left fit:true}"
	]
	quest.4C0D00B5305117A1.quest_subtitle: "Piou piou (sans vous)"
	quest.4CA17B0A80020B2F.quest_desc: ["Le &3manomètre&r sert à afficher des infos supplémentaires sur une machine."]
	quest.4CA17B0A80020B2F.quest_subtitle: "Il me faut plus d'infos !"
	quest.4E1E31EDD544EE10.quest_subtitle: "64 000 mB"
	quest.4F5348D0C83C3B0D.quest_desc: ["Les &3cellules solaires&r servent à fabriquer des compresseurs solaires."]
	quest.4F5348D0C83C3B0D.quest_subtitle: "Les cellules du soleil"
	quest.4F5348D0C83C3B0D.title: "Cellules solaires"
	quest.4FCC20D9F8F87B2F.quest_desc: ["La &3clé pneumatique&r sert à déplacer ou casser vos machines et vos tubes."]
	quest.4FCC20D9F8F87B2F.quest_subtitle: "Parlons couple et outils !"
	quest.5103C817381181DE.quest_desc: ["Permet d'utiliser des élytres tout en gardant votre plastron pneumatique."]
	quest.5103C817381181DE.quest_subtitle: "Max : 1"
	quest.520EFA7F446AFBF2.quest_desc: ["Le &3lubrifiant&r peut servir à fabriquer des forets."]
	quest.520EFA7F446AFBF2.quest_subtitle: "Produire du lubrifiant !"
	quest.520EFA7F446AFBF2.title: "Lubrifiant"
	quest.521656D425E2FDBA.quest_desc: ["Allez encore plus vite que le niveau II."]
	quest.521656D425E2FDBA.quest_subtitle: "Max : 1"
	quest.52D3697F1F5625C7.quest_desc: ["L'&3acide de gravure&r se fabrique dans la chambre de pression avec du plastique fondu... et quelques autres choses. Il sert dans la cuve de gravure."]
	quest.52D3697F1F5625C7.quest_subtitle: "Ne demandez pas..."
	quest.5303509A1C2B1CCD.quest_desc: ["Le &3marteau-piqueur pneumatique&r utilise de la pression pour miner, et on peut l'améliorer pour le rendre génial !"]
	quest.5303509A1C2B1CCD.quest_subtitle: "Désolé, Jack !"
	quest.53518D4ED99A242F.quest_desc: ["L'&3applicateur de camouflage&r sert à cacher les machines de PneumaticCraft dans d'autres blocs."]
	quest.53518D4ED99A242F.quest_subtitle: "Vous voulez une installation qui a du style ?"
	quest.54169B69725C49DF.quest_desc: ["Posez votre plastique liquide au sol, ou stockez-le dans un coffre équipé d'un cadre chauffant, et voilà votre &3feuille de plastique&r !"]
	quest.54169B69725C49DF.quest_subtitle: "Enfin !"
	quest.54169B69725C49DF.title: "&fPlastique"
	quest.5A0860631323B5E3.quest_desc: ["Fabriquée avec de la &3farine de blé&r. Sert à faire du saumon en tempura et du pain au levain."]
	quest.5A0860631323B5E3.quest_subtitle: "Il faut la pétrir"
	quest.5A9D6672385D3D82.quest_desc: ["N'utilise qu'1 lapis par amélioration au lieu de 4."]
	quest.5A9D6672385D3D82.quest_subtitle: "Économiser du lapis"
	quest.5AEE86EB39FD4087.quest_desc: ["Le &3tube vortex&r sépare la pression en air chaud et air froid. L'air froid va du côté bleu, l'air chaud du côté rouge."]
	quest.5AEE86EB39FD4087.quest_subtitle: "Toujours pas des RF..."
	quest.5AEE86EB39FD4087.title: "Production de chaleur"
	quest.5B9F933ECD6B24FD.quest_desc: ["Permet de sauter plus haut qu'avec le niveau II."]
	quest.5B9F933ECD6B24FD.quest_subtitle: "Max : 1"
	quest.5C7D9BCDF19B86BD.quest_desc: ["Empêche les choses d'exploser."]
	quest.5C7D9BCDF19B86BD.quest_subtitle: "En sécurité !"
	quest.5D64250B940BC8FD.quest_desc: ["Le fer compressé peut servir à fabriquer l'&3armure en fer compressé&r : c'est comme l'armure en fer, mais avec une meilleure robustesse et une meilleure résistance au recul.\\n\\nOn peut la fabriquer ou la trouver souvent dans les coffres de butin."]
	quest.5D64250B940BC8FD.quest_subtitle: "Super résistance au recul"
	quest.5D64250B940BC8FD.title: "Armure en fer compressé"
	quest.5D71ED16FD4E725A.quest_desc: ["Rend les piglins passifs (comme porter une armure en or) ; l'amélioration ne doit être mise que sur une seule pièce."]
	quest.5D71ED16FD4E725A.quest_subtitle: "Max : 1"
	quest.5D7B34761E8FD212.quest_desc: [
		"Le &3compresseur électrostatique&r produit beaucoup de pression grâce aux coups de foudre.\\n\\nPour plus d'infos, allez voir l'onglet « Information » dans JEI.\\n"
		"{image:pneumaticcraft:textures/patchouli/electrostatic_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.5D7B34761E8FD212.title: "La pression de la foudre"
	quest.5E71F8A046C60346.quest_desc: ["Qui vous a dit que PneumaticCraft ne servait pas à produire de l'énergie ?\\n\\nLa &3dynamo pneumatique&r permet de transformer votre pression en FE. Lisez l'infobulle ou le manuel PNC:R pour savoir comment elle fonctionne."]
	quest.5E71F8A046C60346.quest_subtitle: "Pression = énergie"
	quest.5E71F8A046C60346.title: "Produire de l'énergie"
	quest.602C3E88D96F8843.quest_desc: ["Mettez un circuit imprimé vierge chargé dans la cuve de gravure avec de l'acide de gravure et de la chaleur, et vous obtiendrez des &3circuits imprimés non assemblés&r."]
	quest.602C3E88D96F8843.quest_subtitle: "On y est presque !"
	quest.61AD2207E770CD7F.quest_desc: ["Permet de ramasser objets et expérience de plus loin."]
	quest.61AD2207E770CD7F.quest_subtitle: "Max : 6"
	quest.61B479079DC1C69C.quest_desc: ["Permet de sauter plus haut qu'avec le niveau I."]
	quest.61B479079DC1C69C.quest_subtitle: "Max : 1"
	quest.61BA2932EC86DA2E.quest_desc: ["Permet de sauter TRÈS haut."]
	quest.61BA2932EC86DA2E.quest_subtitle: "Max : 1"
	quest.63F6F4EBCEB914B0.quest_desc: ["La &3chambre de pression&r est une multistructure importante faite de &3murs de chambre de pression&r (les faces peuvent être remplacées par du &3verre de chambre de pression&r). Elle peut aller d'un 3x3x3 à un 5x5x5. Les blocs nécessaires pour le 5x5x5 sont ceux demandés pour terminer cette quête.\\n\\nPour utiliser la chambre de pression, il faut envoyer de la pression dans une &3valve de chambre de pression&r avec les &3tubes de pression&r fabriqués plus tôt ; pensez à mettre une amélioration de sécurité dans la valve. &lLes recettes demandent des quantités de pression différentes&r.\\n\\nIl faut pouvoir faire entrer et sortir des objets de la chambre de pression : c'est là qu'interviennent les &3interfaces de chambre de pression&r. Bleu à l'extérieur, c'est pour importer des objets ; doré à l'extérieur, c'est pour les sortir. Placez-en une de chaque sur n'importe quelle face."]
	quest.63F6F4EBCEB914B0.quest_subtitle: "Mise sous pression !"
	quest.63F6F4EBCEB914B0.title: "La chambre de pression"
	quest.649167FC31EB916E.quest_desc: ["L'&3huile végétale&r s'obtient en mettant des cultures ou des graines dans une &3usine de traitement thermopneumatique&r."]
	quest.649167FC31EB916E.quest_subtitle: "Une meilleure huile"
	quest.649167FC31EB916E.title: "Huile végétale"
	quest.64D34A6C3487C5DF.quest_desc: ["L'&3interface aérienne&r permet de remplir de pression vos objets pressurisables. Vous pouvez maintenant utiliser votre armure pneumatique sans avoir à la recharger !\\n\\nIl vous en faudra une pour fabriquer l'&6étoile ATM&r."]
	quest.64D34A6C3487C5DF.quest_subtitle: "De la pression sans fil !"
	quest.64E2E05B228EA53E.quest_desc: ["Les &3tubes de pression avancés&r sont les meilleurs tubes de pression disponibles : ils supportent 20 bars de pression !\\n\\nIls sont déjà très cool seuls, mais ils servent aussi dans des recettes encore plus cool."]
	quest.64E2E05B228EA53E.quest_subtitle: "Un tout nouveau niveau !"
	quest.657DB994B029F61C.quest_desc: [
		"Quand le &3cadre chauffant&r est posé sur un conteneur avec certains fluides et qu'il est assez froid, il transforme ces fluides en objets."
		""
		"Transforme le plastique fondu en plastique."
		"Transforme l'eau en glace."
		"Transforme la lave en obsidienne."
	]
	quest.65E2AF881709C896.quest_desc: ["L'un des matériaux les plus importants dont vous aurez besoin est la &3pierre renforcée&r : commencez par en fabriquer 32 avec du fer compressé et de la pierre normale."]
	quest.65E2AF881709C896.quest_subtitle: "Il vous en faudra beaucoup"
	quest.65E2AF881709C896.title: "Pierre renforcée"
	quest.6674270897997BF7.quest_desc: ["Permet de sauter plus haut que d'habitude et vous rend élastique, pour vous déplacer plus vite.\\n\\nOn ne peut avoir qu'un seul niveau de ces améliorations dans les jambières à la fois."]
	quest.6674270897997BF7.quest_subtitle: "Max : 1"
	quest.681A3F31FB242555.quest_desc: ["L'&3éthanol&r peut servir à fabriquer du biodiesel."]
	quest.681A3F31FB242555.title: "Éthanol"
	quest.68F92455A9483AD6.quest_desc: ["Vous ne verrez cette quête que si vous avez utilisé des bottes à réaction.\\n\\nIl est impossible d'utiliser des bottes à réaction sans prendre de dégâts, n'essaie même pas..."]
	quest.68F92455A9483AD6.quest_subtitle: "Vous pensiez que les élytres étaient difficiles ?"
	quest.68F92455A9483AD6.title: "Bottes à réaction"
	quest.6B1C06C753C10E44.quest_desc: ["Le &3configurateur logistique&r sert à configurer les cadres logistiques et les gadgets de transfert."]
	quest.6CA01DCE1F4A0EC3.quest_desc: ["L'étape suivante du mod demande de récolter du &3pétrole brut&r. On trouve ce pétrole naturellement à la surface de l'Overworld."]
	quest.6CA01DCE1F4A0EC3.quest_subtitle: "Le chemin vers le plastique"
	quest.6CA01DCE1F4A0EC3.title: "Pétrole brut"
	quest.6D124ACF4AE80490.quest_desc: ["Avec les micromissiles, vous pouvez tirer des explosions de loin ! Maintenant, personne ne peut s'échapper !\\n\\nIls sont nécessaires pour fabriquer l'&6étoile ATM&r."]
	quest.6D124ACF4AE80490.quest_subtitle: "Tirer des explosions de loin !"
	quest.6EB53CDCB80D4B66.quest_desc: [
		"La &3porte pneumatique&r est une porte automatique qu'on peut régler pour qu'elle ne s'ouvre que pour vous !"
		""
		"{image:pneumaticcraft:textures/patchouli/pneumatic_door.png width:200 height:200 align:right fit:true}"
	]
	quest.6FD65139CD50A8C0.quest_desc: ["Est-ce seulement possible ?\\n\\nSi vous voulez automatiser ce procédé, vous pouvez utiliser &eProductive Bees&r ou &aMystical Agriculture&r. Ou j'imagine que vous pourriez l'automatiser avec... des explosions."]
	quest.6FD65139CD50A8C0.quest_subtitle: "Marre de tout faire exploser ?"
	quest.7040CA41C0A3C2F2.quest_desc: [
		"&3Plans de circuit imprimé&r EN PROMO pour 8 émeraudes. (Pour une durée limitée seulement.)"
		"{@pagebreak}"
		"(texte provisoire pour une nouvelle page)"
	]
	quest.7040CA41C0A3C2F2.quest_subtitle: "Merci, Amadron !"
	quest.7040CA41C0A3C2F2.title: "&9Plan de circuit imprimé"
	quest.715B86DC82EA636B.quest_desc: [
		"Le &3compresseur à liquide&r crée de la pression avec certains liquides. Vous pouvez y mettre le carburant par clic droit avec le seau sur la machine, en pompant le fluide dedans, ou en mettant un seau dans l'emplacement du haut de l'interface."
		""
		"{image:pneumaticcraft:textures/gui/gui_liquid_compressor.png width:200 height:200 align:center fit:true}"
	]
	quest.715B86DC82EA636B.title: "La pression par les liquides"
	quest.7177E49BF9ECA5CF.quest_desc: [
		"Le &3compresseur thermique&r crée de la pression grâce à la chaleur ! Placez quelque chose de chaud d'un côté et quelque chose de froid de l'autre pour créer de la pression."
		""
		"{image:pneumaticcraft:textures/patchouli/thermal_compressor.png width:100 height:100 align:left fit:true}"
	]
	quest.7177E49BF9ECA5CF.title: "La pression par la chaleur"
	quest.718DABA6C9E5982A.quest_desc: ["Donne Vision nocturne au joueur quand il est porté."]
	quest.718DABA6C9E5982A.quest_subtitle: "Max : 1"
	quest.72C09FD89C28B1EC.quest_desc: [
		"La &3raffinerie de pétrole&r qu'on va fabriquer est une multistructure de 1x1x5 composée d'1 &3contrôleur de raffinerie&r (en bas) et de quatre &3sorties de raffinerie&r (au-dessus). Il faut y faire entrer du pétrole et de la chaleur pour qu'elle fonctionne. Elle produit du diesel, du kérosène, de l'essence et du GPL. Mettre des &3isolants thermiques&r sur les côtés aide à garder la chaleur."
		""
		"{image:atm:textures/questpics/pneumaticcraft/oil_refinery.png width:300 height:150 align:center}"
	]
	quest.72C09FD89C28B1EC.quest_subtitle: "Là, on avance"
	quest.72C09FD89C28B1EC.title: "Raffinerie de pétrole"
	quest.7386A8433698946C.quest_desc: [
		"Choisissez un objet et cette amélioration le cherchera à proximité dans les coffres ou par terre. Pour le trouver dans les coffres, il faut l'amélioration de suivi de blocs, et pour le trouver par terre, l'amélioration de suivi d'entités.\\n"
		"{image:atm:textures/questpics/pneumaticcraft/item_search_upgrade.png width:200 height:200 align:center}"
	]
	quest.7386A8433698946C.quest_subtitle: "Max : 1"
	quest.7395B41685F4BC1A.quest_desc: ["Le &3compresseur à flux&r peut créer énormément de pression avec de l'énergie. Envoie simplement des FE dedans et il commencera à en produire. Si vous avez assez de FE en trop, c'est sans doute le moyen le plus simple de produire de la pression."]
	quest.7395B41685F4BC1A.quest_subtitle: "Énergie = pression"
	quest.7395B41685F4BC1A.title: "La pression par l'énergie"
	quest.74015945716FD10A.quest_desc: ["Cet &3entonnoir omnidirectionnel&r peut faire entrer des objets par n'importe quelle face, et on peut l'améliorer pour qu'il soit bien plus rapide qu'un entonnoir normal ! Pratique quand on n'a pas besoin de tuyaux."]
	quest.74015945716FD10A.quest_subtitle: "Un entonnoir configurable"
	quest.74AE214747A3DB1A.quest_desc: ["Augmente la quantité de pression que les choses peuvent contenir."]
	quest.74AE214747A3DB1A.quest_subtitle: "Montez le son !"
	quest.75D3F3C1D4A3EAA2.quest_desc: ["Pour déplacer la chaleur produite par le tube vortex, fabriquez des &3caloducs&r."]
	quest.75D3F3C1D4A3EAA2.quest_subtitle: "On a de la chaleur à déplacer :)"
	quest.75D3F3C1D4A3EAA2.title: "Déplacer la chaleur"
	quest.762B8309E1A31B99.quest_desc: ["Chaque amélioration ajoute +0,5 de défense d'armure et +1 de robustesse d'armure."]
	quest.762B8309E1A31B99.quest_subtitle: "Max : 4"
	quest.7770F0D62457096D.quest_desc: ["Ces quêtes ne parlent pas des drones, mais ils sont géniaux ! Renseignez-vous dessus si vous voulez les utiliser."]
	quest.7770F0D62457096D.title: "Programmer des drones"
	quest.795143471F31A64A.quest_subtitle: "Nécessaire pour les recettes au laser"
	quest.7953C87C488A2AF7.quest_desc: ["Permet de voler comme Iron Man.\\n\\nOn ne peut avoir qu'un seul niveau de ces améliorations dans les bottes à la fois. Chaque niveau consomme plus de pression que le précédent.\\n\\nUtilisez ces améliorations, ne vous contentez pas de les fabriquer."]
	quest.7953C87C488A2AF7.quest_subtitle: "Max : 1"
	quest.7B2008977702D0C8.quest_desc: ["Quand vous créez de la pression dans un compresseur d'air, si la pression n'a nulle part où aller, elle disparaît simplement. Assurez-vous qu'elle a un endroit où aller avant d'en créer."]
	quest.7B2008977702D0C8.quest_subtitle: "Qu'est-il arrivé aux RF ou aux FE ?"
	quest.7BFC24607189B6D0.quest_desc: ["Vous fait nager plus vite."]
	quest.7BFC24607189B6D0.quest_subtitle: "Max : 1"
	quest.7BFE7DAF18981843.quest_subtitle: "Nécessaire pour les recettes à la perceuse"
	quest.7D6B4AEF806AF62E.quest_desc: ["100 % bien trop rapide ! Essaie de ne pas mourir !"]
	quest.7D6B4AEF806AF62E.quest_subtitle: "Max : 1"
	quest.7D81F2381516204D.quest_subtitle: "Nécessaires pour les circuits imprimés finis"
	quest.7D81F2381516204D.title: "Transistors"
	quest.7FB12EC3A5888123.quest_desc: ["La &3jonction de tubes&r vous donne plus de contrôle sur le transport de votre pression, en permettant à vos tubes de pression d'aller dans plus de directions."]
	quest.7FB12EC3A5888123.quest_subtitle: "Non, c'est par là !"
	task.0B54EDC9E21F2E77.title: "Cadres logistiques"
	task.13266875BDB5077D.title: "Tous droits réservés"
	task.1EEC7B67E037F766.title: "Comprendre la pression"
	task.25FF884779D98BAD.title: "Briques de construction™"
	task.2C268116DA162155.title: "Tous droits réservés"
	task.49A8320F9EA7F4BD.title: "Automatisation du fer compressé"
}
