{
	quest.00453FF528AA0B1C.quest_desc: ["Les &7squelettes Lonestar&r sont des monstres hostiles qui peuvent apparaître n'importe où. \\n\\nIls ont 10 &4cœurs&r et vous lancent leur épée pour vous attaquer. \\n\\nÀ leur mort, ils peuvent laisser des os, des &7pépites d'argent profond&r et des &7épées brisées&r."]
	quest.00453FF528AA0B1C.title: "&7Squelettes Lonestar"
	quest.00FDBA93722ACECE.title: "&4Houe en amarambre"
	quest.011FCC180FF3BD83.title: "&9Épée en malarite"
	quest.01F322AEFCC6109E.quest_desc: ["Les crânes emmêlés peuvent être lâchés par... eh bien, les crânes emmêlés. \\n\\nIls peuvent servir de projectile, comme une tête de Wither lancée par un Wither. \\n\\nMais il est consommé quand vous faites ça."]
	quest.02414CBEF2CD5A9D.title: "&7Épée en argent profond"
	quest.028472D7F51D439A.title: "&aFaux en flowglaze"
	quest.02B574B09AB45D09.quest_desc: [
		"Les &bFreezes&r fonctionnent comme les &cBlazes&r : ils s'envolent et vous lancent une boule. \\n\\nSauf que les &bFreezes&r ne lancent qu'une boule, et elle vous refroidit au lieu de vous réchauffer. \\n\\nIls ont 16 &4cœurs&r et laissent des &btubes gelés&r à leur mort."
		"{image:atm:textures/questpics/eternal/starlight_freeze.png width:150 height:100 align:center}"
	]
	quest.02B574B09AB45D09.title: "&bFreeze"
	quest.0342248394E40B6A.quest_desc: ["Cette quête a été créée par le personnel de &6AllTheMods&r ou un contributeur de la communauté &2Community contributor&r pour être utilisée dans les modpacks AllTheMods.\\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut être utilisée dans aucun pack public non publié par l'équipe &6AllTheMods&r sans autorisation explicite.\\n\\nCette quête est intentionnellement masquée. Si vous la voyez, c'est que vous êtes en mode édition."]
	quest.03B40AB768FC0161.quest_desc: [
		"Les &3rivières scintillantes&r sont des rivières amicales. Elles ne feront rien de spécial pour vous tuer. \\n\\nElles relient parfois des &bmers&r entre elles et traversent des forêts. \\n\\nÉvidemment, elles contiennent de l'&9eau&r, mais dans cette &9eau&r se trouvent plein de bonnes choses !"
		"{image:atm:textures/questpics/eternal/starlight_river.png width:200 height:100 align:center}"
	]
	quest.03B40AB768FC0161.title: "&3Rivière scintillante"
	quest.0576C32B0FB360B0.quest_desc: [
		"La &l&9Monstruosité lunaire&r a 200 &4cœurs&r et ne subit qu'1 point de dégâts par coup, sauf si vous utilisez le feu. \\n\\nElle a quelques attaques, dont des pics au sol, des projectiles et des têtes emmêlées explosives ! \\n\\nQuand vous la tuez, elle lâche des flèches, des lingots, des crânes emmêlés, des &9pétales tenaces&r, des &5lianes tenaces&r, de la &9rosée d'âme&r et peut-être une arme rare !"
		"{image:atm:textures/questpics/eternal/starlight_lunar.png width:100 height:125 align:center}"
	]
	quest.0576C32B0FB360B0.title: "&9&lMonstruosité lunaire"
	quest.061C4A9E439CE09B.title: "&9Pelle en malarite"
	quest.0688CE330DAF8714.title: "&cHoue en feu stellaire"
	quest.06D3EC025557855F.title: "&7Hache en argent profond"
	quest.0720474D384F4774.quest_desc: ["Le &emarimold&r est un champignon qui pousse sous l'eau. \\n\\nOn en trouve des grandes et des petites versions. \\n\\nLes blocs ressemblent à un mélange de &6miel&r et de &echampilampes&r."]
	quest.0720474D384F4774.title: "&eMarimold"
	quest.0854589F28AAA8D0.title: "&dHoue en diamant étoilé"
	quest.09981C89C585002E.title: "&bCasque en glacite"
	quest.09C3C0F0278C842F.title: "&4Plastron en amarambre"
	quest.0BB8D556305EB307.quest_desc: [
		"La rivière d'éther, vous la reconnaîtrez en la voyant. \\n\\nElle est lumineuse, très lumineuse, et peut apparaître en rouge sur votre carte : c'est un bug, ignorez-le."
		"{image:atm:textures/questpics/eternal/starlight_ether.png width:200 height:100 align:center}"
	]
	quest.0BB8D556305EB307.title: "Rivière d'éther"
	quest.0C096EE635645E43.quest_desc: ["L'&barbalète &dde cristal&r se fabrique comme une &3arbalète &7mécanique&r, mais avec des &bcristaux&r au lieu de bâtons. \\n\\nElle tire des flèches et fait les mêmes dégâts qu'une arbalète normale, mais celle-ci donne l'infection cristalline. L'infection cristalline inflige 1 point de dégâts chaque seconde grâce aux cristaux qui poussent sur la cible ! Et oui, ça la tuera."]
	quest.0C096EE635645E43.title: "&bArbalète &dde cristal"
	quest.0CFAAF6F13EB6C2C.title: "&cMarteau en feu stellaire"
	quest.0D1C143B2C788204.quest_desc: ["Les &5Chercheurs&r sont des monstres hostiles qui peuvent apparaître partout dans &9&lStarlight&r. \\n\\nIls ont 12 &4cœurs&r et demi et volent. \\n\\nIls vous attaquent en s'approchant et en vous lançant leur langue. \\n\\nLes &5Chercheurs&r sont aussi un excellent moyen de farmer des &5yeux chercheurs&r !"]
	quest.0D1C143B2C788204.title: "&5Chercheurs"
	quest.0D427BD581ADC3A6.title: "&aPioche en flowglaze"
	quest.0E1C2DA415D5742D.title: "&bÉpée en glacite"
	quest.0F0D41F29386333A.quest_desc: ["Les &darbres écarlates&r varient en taille et en forme, et sont même parfois tombés ! \\n\\nMais tous ont des &dfeuilles roses&r ! Y compris ceux au sol."]
	quest.0F0D41F29386333A.title: "&dArbres écarlates"
	quest.0F4783FA019C4567.quest_desc: ["L'&4amarambre&r se trouve rarement en écorçant des &cbûches de torreya&r. \\n\\nOn peut en faire des lingots pour fabriquer des armures et des outils, ou l'utiliser dans d'autres recettes, comme un feu de camp qui vous donnera de la régénération !"]
	quest.0F4783FA019C4567.title: "&4Amarambre"
	quest.0F812AE4F247FF1C.title: "&bPlastron en glacite"
	quest.0F8955B74DBDF5F9.title: "&cFaux en feu stellaire"
	quest.0FE15701F2EDC3E9.quest_desc: ["En empilant un &5bloc d'aethersent&r et un &5fruit de cactus lunaris&r, on peut créer un &5golem d'aethersent&r ! \\n\\nCe gaillard n'a qu'un seul travail : empêcher l'apparition des &5Creteors&r lors des &5pluies de météores&r. \\n\\nSi une &5pluie de météores&r se produit, il les abat avant même qu'ils n'apparaissent !"]
	quest.0FE15701F2EDC3E9.title: "&5Golem d'aethersent"
	quest.10AB188AC6FB24D3.quest_desc: [
		"Le &b&lGolem stellaire&r a 220 &4cœurs&r et 2 modes. \\n\\nLe 1er est son mode attaque : il ne peut pas être blessé, il faut attendre la fin de ses attaques pour le frapper. Il attaque avec des boules de feu, des coups au sol ou un rayon laser dévastateur ! \\n\\nLe 2e est son mode recharge : il commence à puiser de l'énergie dans les blocs d'énergie, qu'il faudra éteindre pour pouvoir le blesser. \\n\\nÀ sa mort, il lâche plein de lingots et de flèches, de l'&bacier de golem&r, une garniture d'armure Forge, et peut-être même l'épée d'énergie !"
		"{image:atm:textures/questpics/eternal/starlight_golem.png width:150 height:100 align:center}"
	]
	quest.10AB188AC6FB24D3.title: "&b&lGolem stellaire"
	quest.10D78DC368E16987.title: "&aHache en flowglaze"
	quest.11783E5EF07481C3.title: "&aArc en flowglaze"
	quest.127D085D6C9DB690.quest_desc: ["Le &esalpêtre&r se trouve partout sous terre, mais il est très fréquent dans le biome &drivage chaud&r. \\n\\nIl faut une pioche en pierre pour le miner, et il lâche quelques &epoudres de salpêtre&r. Oui, Fortune fonctionne dessus ! \\n\\nLa &epoudre&r peut remplacer les autres nitres."]
	quest.127D085D6C9DB690.title: "&ePoudre de salpêtre"
	quest.144ECED643031A9A.quest_desc: ["Les champignons luisants sont d'énormes champignons qu'on trouve dans les forêts écarlates ! \\n\\nIls fonctionnent comme les champignons bruns ou rouges, mais ceux-ci brillent bien plus fort ! \\n\\n(Si vous ne le saviez pas, les champignons bruns et rouges émettent en fait une lumière de niveau 1.)"]
	quest.15195F456D8AD4C8.quest_desc: ["Quand l'éther touche l'&9eau&r, du &athioquartz&r se forme. Ça peut arriver naturellement lors de la génération, ou vous pouvez le provoquer ! \\n\\nMais ce n'est pas comme ça qu'on obtient des éclats : ils viennent du &athioquartz bourgeonnant&r !"]
	quest.15195F456D8AD4C8.title: "&aThioquartz"
	quest.1533D98B3B2A758E.quest_desc: ["Les &7épées brisées&r peuvent être lâchées par les &7squelettes Lonestar&r ou fabriquées avec les &7lames&r lâchées. \\n\\nL'&7épée brisée&r s'utilise plus comme un trident que comme une épée : au lieu de frapper, vous la lancez. Puis vous pouvez faire un clic droit pour faire revenir la &7lame&r comme un trident avec Loyauté, et encore un clic droit pour la recharger si besoin."]
	quest.1533D98B3B2A758E.title: "&7Épée brisée"
	quest.17A8E4151DE37015.quest_desc: ["Pour fabriquer les outils et armes en &cfeu stellaire&r, il vous faut d'abord des outils en &6pierre-source thermale&r à améliorer. Puis le &cmodèle d'amélioration&r. \\n\\nLe &cmodèle d'amélioration en feu stellaire&r se trouve dans les structures de boss : le &9jardin maudit&r et la &bforge du golem&r."]
	quest.17A8E4151DE37015.title: "&cModèle en feu stellaire"
	quest.17D82EEA20D02EC8.quest_desc: ["Le fond de la &bmer&r est tapissé de &5gravier poussiéreux&r. \\n\\nIl peut remplacer le &7gravier&r normal et lâche rarement des &5éclats poussiéreux&r qui permettent de fabriquer d'autres blocs !"]
	quest.17D82EEA20D02EC8.title: "&5Gravier poussiéreux"
	quest.17EC65B33AC5F0B4.quest_desc: [
		"Les &8Marcheurs assoiffés&r sont des monstres neutres qui apparaissent à la surface des &5déserts cristallisés&r. \\n\\nQuand ils sont énervés, ils vous frappent et vous donnent Faim. \\n\\nIls ont 20 &4cœurs&r et peuvent lâcher une &8dent de la faim&r à leur mort."
		"{image:atm:textures/questpics/eternal/starlight_thirst.png width:100 height:125 align:center}"
	]
	quest.17EC65B33AC5F0B4.title: "&8Marcheur assoiffé"
	quest.1815A439BA9879B7.quest_desc: [
		"Le &drivage chaud&r est un biome plutôt ennuyeux, qui sert surtout à relier la &bmer étoilée&r et la terre ferme. \\n\\nIl a du &dsable crépusculaire&r avec de la pierre en dessous. J'y ai aussi trouvé plus de &esalpêtre&r que d'habitude."
		"{image:atm:textures/questpics/eternal/starlight_shore.png width:200 height:100 align:center}"
	]
	quest.1815A439BA9879B7.title: "&dRivage chaud"
	quest.18AA0B2E9C3B912A.quest_desc: ["C'est un &9escargot&r. \\n\\nIl lâche sa coquille et sa viande."]
	quest.18AA0B2E9C3B912A.title: "&9Escargot de l'ombre"
	quest.19B8871B701F11F4.title: "&dPioche en diamant étoilé"
	quest.19F7BAD1150A2107.quest_desc: ["Le &cfeu stellaire&r ! \\n\\nNon, pas comme Starfire de Teen Titans ou Teen Titans Go. Celui-ci est un matériau qui sert à fabriquer des outils et des armes, ou..."]
	quest.19F7BAD1150A2107.title: "&cFeu stellaire"
	quest.1A95BFE57029F9C4.quest_desc: ["Déçu qu'on n'ait pas eu le golem de tuf ? Pas de panique, on a le &7golem de grimstone&r ! \\n\\nIl fait exactement la même chose : il reste là et tient un bloc ou un objet. \\n\\nPosez simplement un &5fruit de cactus lunaris&r sur des &7briques de grimstone&r et vous l'obtiendrez."]
	quest.1A95BFE57029F9C4.title: "&7Golem de grimstone"
	quest.1AAFC306507DFCF8.title: "&bFaux en glacite"
	quest.1AB17923F87AE264.quest_desc: [
		"Le Yéti : un nom qui terrifie tous ceux qui explorent le froid ! Une abominable créature poilue qui vit dans le climat le plus rude et le plus glacial, et dévore tout ce qui ose s'y aventurer ! \\n\\nEnfin, pas ce Yéti-là : ceux-ci sont mignons et amicaux ! Ils préfèrent se rouler par terre plutôt que de vous manger. \\n\\nIls ne se défendent même pas et n'ont que 10 &4cœurs&r. \\n\\nÀ leur mort, ils lâchent leur fourrure et de la ficelle ; la fourrure peut remplacer la laine."
		"{image:atm:textures/questpics/eternal/starlight_yeti.png width:100 height:100 align:center}"
	]
	quest.1AB17923F87AE264.title: "Yétis"
	quest.1AFCA421A6A50DA4.quest_desc: ["Le &amodèle d'amélioration en flowglaze&r apparaît aussi dans les structures de boss : le &9jardin maudit&r et la &bforge du golem&r. \\n\\nIl faut appliquer le &aflowglaze&f et le &amodèle d'amélioration&f sur la &bglacite &fpour fabriquer les &aarmes en flowglaze&r."]
	quest.1AFCA421A6A50DA4.title: "&aModèle en flowglaze"
	quest.1C863B4BC6EAD1CD.title: "&9Faucille en malarite"
	quest.1E7B5CDF0D5F833F.title: "&7Pioche en argent profond"
	quest.1EA98CFE85035939.title: "&5Bas en aethersent"
	quest.1ECD4331DDFBBB52.quest_desc: ["Les &carbres torreya&r sont d'énormes arbres violet/rose qui font environ 40 blocs de haut. \\n\\nLeurs feuilles poussent dans toutes les directions et les &elianes de torreya&r en pendent."]
	quest.1ECD4331DDFBBB52.title: "&cArbres torreya"
	quest.20D705C99BD11F18.title: "&cHache en feu stellaire"
	quest.252AD9C886DE45C8.quest_desc: [
		"Les &9Regards crépusculaires&r sont des poissons neutres qu'on trouve dans &5l'Abysse&r. \\n\\nSi vous en frappez un, tous vous attaquent, comme les loups ou les piglins zombifiés. Si vous vous éloignez trop de &5l'Abysse&r, ils arrêtent de vous suivre et retournent dans les profondeurs. \\n\\nIls ne lâchent rien à leur mort, alors évite peut-être de les frapper..."
		"{image:atm:textures/questpics/eternal/starlight_gaze.png width:150 height:100 align:center}"
	]
	quest.252AD9C886DE45C8.title: "&9Regard crépusculaire"
	quest.2583E4890619044E.title: "&6Épée en pierre-source thermale"
	quest.25B45E8FBC9705B3.title: "&dHache en diamant étoilé"
	quest.25E782DB4309A1B8.quest_desc: ["Les &3bois de cerf d'aurore&r sont lâchés par les &3cerfs d'aurore&r à leur mort. \\n\\nIls peuvent servir d'épée ou de houe."]
	quest.25E782DB4309A1B8.title: "&3Bois de cerf d'aurore"
	quest.271A112ABDD923A6.quest_desc: ["Comme le palétuvier normal, mais en moins moche."]
	quest.271A112ABDD923A6.title: "&9Arbres banyin"
	quest.27D8E62556F7CE8D.title: "&6Houe en pierre-source thermale"
	quest.282AEEC832FFC8D7.title: "&4Hache en amarambre"
	quest.2872C4229702B077.title: "&bPioche en glacite"
	quest.29283BF1B6ED3634.quest_desc: ["L'&3arbalète &7mécanique&r se fabrique comme une arbalète normale, mais avec de l'&bacier de golem&r. \\n\\nElle fonctionne comme une arbalète normale, en beaucoup plus puissante ! Et on peut l'enchanter pour qu'elle fasse encore plus !"]
	quest.29283BF1B6ED3634.title: "&3Arbalète &7mécanique"
	quest.298963543B99734E.quest_desc: ["Les &bmers étoilées&r ont leurs propres versions du corail ! \\n\\nJuste, ne faites pas comme moi : n'oubliez pas Toucher de soie pour les ramasser..."]
	quest.298963543B99734E.title: "Blocs de corail"
	quest.29A1E1FF02BD9219.quest_desc: [
		"Une &3forêt&r aussi bleue que l'océan. \\n\\nLa &3forêt stellaire&r est de loin le biome le plus courant de &9&lStarlight&r. \\n\\nElle est entièrement couverte de dizaines d'&3arbres lunaires&r, avec plein de créatures, passives et hostiles, en dessous."
		"{image:atm:textures/questpics/eternal/starlight_forest.png width:200 height:100 align:center}"
	]
	quest.29A1E1FF02BD9219.title: "&3Forêt stellaire"
	quest.29EC143D7E0347DE.quest_desc: ["La &8dague de la faim&r se fabrique avec des &8dents de la faim&r. \\n\\nLa &8dague&r a une valeur de faim. Quand vous frappez des monstres, elle monte ; quand elle est inactive, elle baisse. À 100 %, vous obtenez des bonus. Et si elle tombe à 0 %, elle commence à vous tuer. \\n\\nQuand vous frappez des monstres (ou des joueurs), elle leur donne aussi l'effet Faim. \\n\\nJe la comprends, moi aussi je m'énerve quand j'ai faim."]
	quest.29EC143D7E0347DE.title: "&8Dague de la faim"
	quest.2A14A47E40A97329.title: "&aMasque d'alchimiste"
	quest.2D457E53BB6D63C7.quest_desc: [
		"Les points les plus hauts de &9&lStarlight&r sont les forêts de pergélisol, perchées sur les montagnes. \\n\\nÀ cette altitude, il fait bien plus froid : elles sont couvertes de neige et de glace ! \\n\\nAu moins, les créatures amicales semblent aimer le froid !"
		"{image:atm:textures/questpics/eternal/starlight_permafrost.png width:200 height:100 align:center}"
	]
	quest.2D457E53BB6D63C7.title: "Forêt de pergélisol"
	quest.2DA8CE213AC3869B.quest_desc: ["On trouve des &dcristaux &bstellaires&r partout dans les &5déserts cristallisés&r, et même dessous. \\n\\nIls fonctionnent comme l'&5améthyste&r et font même le même bruit !"]
	quest.2DA8CE213AC3869B.title: "&dCristaux &bstellaires"
	quest.2E29DC243E8AD61E.quest_desc: [
		"Les &9chrysopes scintillantes&r ne font rien et ne lâchent rien, elles ajoutent juste de l'ambiance. \\n\\nElles ressemblent aussi au seul insecte que je supporte !"
		"{image:atm:textures/questpics/eternal/starlight_shimmer.png width:150 height:100 align:center}"
	]
	quest.2E29DC243E8AD61E.title: "&9Chrysope scintillante"
	quest.2E9D3DA2DF3E3AC9.quest_desc: ["La &bfaux &5en pétales&r empoisonne tout ce qu'elle touche. \\n\\nJEI dit qu'elle peut labourer la terre, mais en jeu, non... \\n\\nQuand elle touche l'&9eau&r, plein de particules apparaissent. \\n\\nJe ne crois pas que cet objet soit fini."]
	quest.2E9D3DA2DF3E3AC9.title: "&bFaux &5en pétales"
	quest.2F3E7233129F2B89.quest_desc: [
		"Agit exactement comme un luminopoisson, mais celui-ci a une corne sur la tête !"
		"{image:atm:textures/questpics/eternal/starlight_fish2.png width:100 height:100 align:center}"
	]
	quest.2F3E7233129F2B89.title: "Luminaris"
	quest.306A5B38B52F65F3.title: "&4Pioche en amarambre"
	quest.3124D945A54938C2.quest_desc: ["L'argent des marais apparaissait avant dans les &9marais&r, mais il a été promu (ou rétrogradé, je ne sais pas) et apparaît maintenant partout ; dans les &9marais&r apparaît désormais la malarite."]
	quest.3124D945A54938C2.title: "&9Malarite"
	quest.315F1CB8158DFB92.title: "&5Capuche en aethersent"
	quest.31DDEA54B6E81EEE.title: "&7Casque en argent profond"
	quest.337D376BE2653F0F.title: "&bBottes en glacite"
	quest.34119FC1728B75B9.title: "&4Casque en amarambre"
	quest.342EEB042DEC2B8C.quest_desc: ["Le magma et les geysers apparaissent tous les deux au fond de &5l'Abysse&r. \\n\\nLe magma vous aide à descendre et à garder votre souffle. \\n\\nLes geysers, eux, sont juste jolis !"]
	quest.342EEB042DEC2B8C.title: "Magma et geysers"
	quest.34D7CA6F99B29C87.title: "&2Masque à sac d'air"
	quest.362F4CFD1B8B12B1.quest_desc: ["Tous les êtres vivants meurent dans l'éther comme dans la lave. Bizarrement, on peut quand même le mettre dans un seau ! \\n\\nLe seul moyen d'en avoir est de le trouver dans la rivière d'éther. \\n\\nQuand l'eau touche l'éther, des &ablocs de thioquartz&r se forment !"]
	quest.36BCCF7395658A5C.quest_desc: ["Les boss de &9&lStarlight&r vivent dans leurs structures. Elles ne sont pas courantes (heureusement), alors vous aurez peut-être besoin d'aide, c'est-à-dire des yeux chercheurs. \\n\\nLes yeux chercheurs fonctionnent comme les &ayeux de l'Ender&r : faites un clic droit pour les lancer et suivez-les jusqu'aux structures. \\n\\nPour choisir la structure, il faut un objet précis dans votre main secondaire, comme..."]
	quest.36BCCF7395658A5C.title: "Trouver les boss"
	quest.37355F60E45777FE.quest_desc: ["L'&3orbe de prophétie&r peut être fabriqué ou obtenu en battant le &7&lGardien du seuil&r ! \\n\\nIl sert surtout à activer le portail, mais il aura d'autres usages !"]
	quest.37355F60E45777FE.title: "&3Orbe de prophétie"
	quest.373CA701008A9584.quest_desc: ["L'&4arbalète flétrie&r demande d'avoir tué la &9&lMonstruosité lunaire&r et le &b&lGolem stellaire&r. \\n\\nL'&4arbalète flétrie&r est comme une arbalète normale, mais chaque flèche inflige Wither et Lenteur."]
	quest.373CA701008A9584.title: "&4Arbalète flétrie"
	quest.375F0A098589CF29.quest_desc: [
		"En utilisant vos yeux chercheurs, vous serez peut-être perplexe de les voir soudain partir sous terre. C'est sans doute parce que la &bforge du golem&r est profondément enfouie, genre aux niveaux Y négatifs. \\n\\nIl y a plein de salles sinueuses, chacune pleine de butin, de &clave&f et de &bFreezes&r ! La salle qu'on cherche abrite le &b&lGolem stellaire&r !"
		"{image:atm:textures/questpics/eternal/starlight_golemforge.png width:200 height:100 align:center}"
	]
	quest.375F0A098589CF29.title: "&bForge du golem"
	quest.378A7484CF999F03.quest_desc: ["Ce serait parfait pour de minuscules maisons de poupées sous-marines ! \\n\\nSi au moins une autre personne dans l'histoire a déjà eu cette idée..."]
	quest.378A7484CF999F03.title: "&dVarech en spirale"
	quest.37E49A1A6BA0E28D.title: "&5Cape en aethersent"
	quest.38CF9E6E7490BD50.title: "&6Marteau en pierre-source thermale"
	quest.39796595B42BB41E.quest_desc: ["Le &bboomerang &7d'énergie&r est une arme unique en &8acier de golem&r. \\n\\nPour l'utiliser, faites simplement un clic droit pour le lancer. \\n\\nComme tous les autres boomerangs, sauf ceux que j'ai lancés moi, il revient vers vous. Il revient après environ 10 blocs ou s'il touche un bloc. \\n\\nS'il touche un monstre, il fait des dégâts et y met le feu."]
	quest.39796595B42BB41E.title: "&bBoomerang &7d'énergie"
	quest.3991EEEFDD263A91.quest_desc: [
		"Les &9araignées crépusculaires&r, comme les &7squelettes Lonestar&r, sont hostiles et apparaissent partout. \\n\\nElles ont 5 &4cœurs&r et attaquent en vous frappant. Après vous avoir frappé, elles vous donnent l'effet Surbrillance pendant quelques secondes. \\n\\nÀ leur mort, elles lâchent de la ficelle et leurs yeux !"
		"{image:atm:textures/questpics/eternal/starlight_spider.png width:100 height:100 align:center}"
	]
	quest.3991EEEFDD263A91.title: "&9Araignées crépusculaires"
	quest.3A33514BD62CD7D9.title: "&bHache en glacite"
	quest.3A6C912577A615EE.title: "&dÉpée en diamant étoilé"
	quest.3AFEE53B4276F8CA.quest_desc: ["Enfin, un outil ! \\n\\nLe &3Sape-tout&r est une pioche. Sa particularité : plus votre niveau Y est bas, plus elle mine vite. \\n\\nMais comment sait-elle à quelle profondeur elle est ?"]
	quest.3AFEE53B4276F8CA.title: "&3Sape-tout"
	quest.3BAF4078F5776809.title: "&6Plastron en pierre-source thermale"
	quest.3C37018123D3653C.title: "&2Bottes à sac d'air"
	quest.3C74DAE7EC844A98.quest_desc: ["Les &3baies lunaires&r sont une excellente source de nourriture, et très faciles à obtenir ! \\n\\nElles poussent vers le bas depuis les &3feuilles d'arbre lunaire&r, et vous pouvez cueillir les &3baies&r sur les lianes comme les &ebaies lumineuses&r. \\nSauf que celles-ci donnent bien plus de points de nourriture et de saturation !"]
	quest.3C74DAE7EC844A98.title: "&3Baies lunaires"
	quest.3CAD0701EC16C2D8.quest_desc: [
		"Les &9marais sombres&r parsèment le monde de &9&lStarlight&r. \\n\\nVous y trouverez plein de plantes, d'animaux, et bien sûr de la boue."
		"{image:atm:textures/questpics/eternal/starlight_swamp.png width:200 height:100 align:center}"
	]
	quest.3CAD0701EC16C2D8.title: "&9Marais sombre"
	quest.3D26E7BFE0AA964A.quest_desc: [
		"Le luminopoisson est un poisson lumineux qui vit dans &5l'Abysse&r.\\n\\nIl se comporte comme un poisson normal. Vous pouvez le pêcher, le mettre dans un seau, et même le cuire !"
		"{image:atm:textures/questpics/eternal/starlight_fish1.png width:100 height:100 align:center}"
	]
	quest.3D26E7BFE0AA964A.title: "Luminopoisson"
	quest.3D4032E7119AF8B7.quest_desc: ["Les &5bombes sonar&r se fabriquent avec du &9gel frissonnant&r, lâché par les &dmites cristallisées&r. \\n\\nOn peut les lancer pour blesser toutes les créatures (et joueurs) dans une énorme zone ! Elles secouent aussi l'écran des joueurs et jouent un bruit fort. \\n\\nC'est désorientant, alors utilisez-les seulement sur vos amis !"]
	quest.3D4032E7119AF8B7.title: "&5Bombe sonar"
	quest.3D7CEED6B974ED8C.title: "&5Bottes en aethersent"
	quest.40786B63E2901D11.quest_desc: [
		"Voyons, comment décrire le &9jardin maudit&r... c'est un sacré labyrinthe ! \\n\\nIl y a des entrées de chaque côté, et il faut trouver le chemin jusqu'au centre, où se trouve la &9&lMonstruosité lunaire&r !\\n\\nPartout dans le labyrinthe, vous trouverez des coffres pleins de butin et des &9Emmêlés&r !"
		"{image:atm:textures/questpics/eternal/starlight_maze.png width:150 height:150 align:center}"
	]
	quest.40786B63E2901D11.title: "&9Jardin maudit"
	quest.40C776497D68367F.quest_desc: ["Lianes, &dtapis de mousse de cristal rouge &fet &bbleu&r, &3baies lunaires&r, mousse des cavernes et &dracines de cristal rouge &fet &bbleu&r. \\n\\nOn peut les tenir en main secondaire avec l'œil chercheur pour trouver le &9jardin maudit&r."]
	quest.40C776497D68367F.title: "Objets de la &9&lMonstruosité&r"
	quest.41197BEBED4A9B69.title: "&7Houe en argent profond"
	quest.4147D247E4D754D0.quest_desc: [
		"Les &7Gleeches&r sont de minuscules créatures qui apparaissent dans le &5désert cristallisé&r. \\n\\nIls veulent votre sang sans relâche, même par la violence. Heureusement, ils n'ont que 4 &4cœurs&r ! \\n\\nÀ leur mort, ils peuvent lâcher leurs &7œufs&r, qu'on peut lancer comme projectile."
		"{image:atm:textures/questpics/eternal/starlight_gleech.png width:100 height:100 align:center}"
	]
	quest.4147D247E4D754D0.title: "&7Gleech"
	quest.41C70F0873E14307.quest_desc: ["Il y a des arbres dans le désert ! \\n\\nNon, attendez, il y avait des arbres..."]
	quest.41C70F0873E14307.title: "&8Bûche lunaire morte"
	quest.429785E8F64929CE.quest_desc: ["Pour aller dans la &9&ldimension Starlight&r, il faut trouver des &7ruines de portail&r dans l'&2&lOverworld&r. \\n\\nVous y trouverez un &7&lGardien du seuil&r : faites un clic droit pour lui parler et le défier en duel ! Attention, il est très coriace. \\n\\nLe Gardien du seuil vous jugera aussi digne si vous avez vaincu l'Ender Dragon, et vous laissera sauter le duel.\\n\\nUne fois le duel gagné, vous recevez quelques objets, dont l'&3orbe de prophétie&r. Faites un clic droit sur le &7portail&r avec l'&3orbe&r pour l'activer ! Puis entrez dedans pour aller dans..."]
	quest.429785E8F64929CE.title: "Le gardien du seuil et le portail"
	quest.45AA690C89BF6845.title: "&6Jambières en pierre-source thermale"
	quest.45B0442B80A7C7FB.title: "&9Hache en malarite"
	quest.45D73CA0A7BE4666.quest_desc: [
		"La &emer peu profonde luxuriante&r porte bien son nom : beaucoup de végétation, et pas très profonde ! \\n\\nElle ne fait qu'environ 20 blocs de profondeur."
		"{image:atm:textures/questpics/eternal/starlight_shallow.png width:200 height:100 align:center}"
	]
	quest.45D73CA0A7BE4666.title: "&eMer peu profonde luxuriante"
	quest.46E32356964E56A0.title: "&7Jambières en argent profond"
	quest.470EA6870DBBB352.title: "&7Plastron en argent profond"
	quest.474C8AF9D536D4E7.title: "&6Pelle en pierre-source thermale"
	quest.47CB136D7764B86D.quest_desc: ["Les &elianes de torreya&r pendent des &carbres torreya&r. \\n\\nElles pendent parce qu'on ne peut pas les poser autrement... \\n\\nLe bulbe au bout émet de la lumière !"]
	quest.47CB136D7764B86D.title: "&eLianes de torreya"
	quest.47DF2314B10146E9.title: "&6Pioche en pierre-source thermale"
	quest.484ABFF266C8791E.quest_desc: ["Les &eorbiflores&r sont des plantes qui poussent au fond de la &bmer&r. \\n\\nOn peut les récolter n'importe quand, mais si vous voulez les &elumières d'orbiflore&r, il faut attendre ! \\n\\nQuand elles atteignent le niveau de la mer, elles fleurissent. Après la floraison, elles font pousser la &elumière&r !"]
	quest.484ABFF266C8791E.title: "&eOrbiflore"
	quest.49D1EA8E812A12F6.quest_desc: ["C'est juste une jolie plante. \\n\\nIl vous faudra une faucille pour la récolter ! \\n\\nJe ne sais pas pourquoi, je ne me suis jamais intéressé aux plantes, mais je trouve les roseaux cool. Peut-être parce qu'ils sont près de l'&9eau&r, ou que les massettes ressemblent à des corn dogs. Je ne sais pas, mais je les aime bien."]
	quest.49DC0BD7DC1B893C.quest_desc: ["&5Les abysses&r sont des fosses profondes dans les &bmers étoilées&r. Elles descendent jusqu'à -50 ! \\n\\nElles ont plusieurs couches de pierre colorées sur leurs parois et contiennent plein de blocs, de mousses et de poissons différents !"]
	quest.49DC0BD7DC1B893C.title: "&5L'Abysse"
	quest.4A54288FD22C903D.quest_desc: ["La &2velvetumousse&r apparaît dans &5l'Abysse&r. \\n\\nVous pouvez miner les &2vertes&r pour obtenir des &2boules de velvetumousse&r, qu'on peut manger ou transformer en &aboule de slime&r ! \\n\\nLes &4rouges&r font pousser de jolies plantes !"]
	quest.4A54288FD22C903D.title: "&2Velvetumousse &fet sa version &4rouge &f"
	quest.4A5EA948F5DCEB73.quest_desc: ["L'&7argent profond&r s'appelait avant argent des marais et n'apparaissait que dans les &9marais sombres&r. \\n\\nMaintenant, on le trouve partout sous terre... c'est sans doute pour ça qu'ils ont changé le nom !"]
	quest.4A5EA948F5DCEB73.title: "&7Argent profond"
	quest.4B097031A3EE930B.title: "&bHoue en glacite"
	quest.4B13835110F1FE82.title: "&7Faucille en argent profond"
	quest.4C23D7E3DC8327C2.quest_desc: ["Pour tuer la &9&lMonstruosité lunaire&r, il faut la mettre en feu ! \\n\\nVous pouvez utiliser un briquet ou une &eboîte d'allumettes au salpêtre&r. \\n\\nPersonnellement, je trouve la &eboîte d'allumettes&r plus adaptée !"]
	quest.4C23D7E3DC8327C2.title: "Brûlez-la !"
	quest.4C72D2BB6785CC78.title: "&cPelle en feu stellaire"
	quest.4D0B50731FED3CEE.quest_desc: ["Pour obtenir la lance croissant, il faut la fabriquer avec des objets lâchés par la Monstruosité lunaire et la Haine emmêlée, ou l'obtenir directement de la Monstruosité lunaire. (Il faudra la tuer de toute façon, en gros.) \\n\\nVous pouvez utiliser la lance comme un trident et frapper les monstres, ou maintenir le clic droit pour être propulsé en avant avec. Si vous touchez des monstres avec cette seconde attaque, ceux qui sont proches subissent aussi des dégâts."]
	quest.4D0B50731FED3CEE.title: "&5Lance &bcroissant"
	quest.4D4DE266A2A325B0.quest_desc: ["La &4redstone&r, l'&bacier de golem&r et l'&8acier de golem oxydé&r sont des objets qui servent à trouver la &bforge du golem&r. \\n\\nTenez l'un d'eux (sans doute la &4redstone&r, qu'on trouve sous terre dans &9&lStarlight&r) dans votre main secondaire et utilisez l'œil chercheur pour trouver la &bforge du golem&r, qui, au fait, est sous terre !"]
	quest.4D4DE266A2A325B0.title: "Objets du &l&bgolem&r"
	quest.4D53D9BBD8279282.quest_desc: ["Les &3arbres lunaires&r vont d'immenses &3arbres&r gigantesques à de tout petits. Ils s'adaptent pour prendre toute la place possible ! (Ça expliquerait les &3forêts denses&r.) \\n\\nIls se plantent comme des pousses normales, et des &3baies lunaires&r peuvent pousser sur leurs feuilles !"]
	quest.4D53D9BBD8279282.title: "&3Arbres lunaires"
	quest.4D8C9960BB675221.quest_desc: ["Il a un nom rigolo !"]
	quest.4DBC3B4D38CC6152.quest_desc: [
		"Les &dmites cristallisées&r apparaissent tout en bas des &5déserts cristallisés&r. \\n\\nElles sont neutres, et je conseille de ne pas les frapper, car elles font énormément de dégâts ! \\n\\nElles ont aussi 10 &4cœurs&r et peuvent lâcher des &dcristaux &bstellaires&r ou du &9gel frissonnant&r à leur mort. \\n\\nCes jolies bestioles peuvent être apprivoisées en leur donnant de la viande ! Elles combattront alors pour vous."
		"{image:atm:textures/questpics/eternal/starlight_moth.png width:125 height:100 align:center}"
	]
	quest.4DBC3B4D38CC6152.title: "&dMite cristallisée"
	quest.5003365C2A7B4B53.title: "&cÉpée en feu stellaire"
	quest.50674FE3C6BE9990.quest_desc: [
		"Comme la &3forêt stellaire&r normale, mais avec beaucoup moins d'espace entre les arbres !"
		"{image:atm:textures/questpics/eternal/starlight_dense.png width:200 height:100 align:center}"
	]
	quest.50674FE3C6BE9990.title: "&3Forêt stellaire dense"
	quest.50EC8F8CD04D9598.title: "&5Fureur des étoiles"
	quest.516AC1F0E0BCAE55.quest_desc: ["Les &btubes gelés&r sont lâchés par les &bFreezes&r dans la &bforge du golem&r. \\n\\nOn peut les lancer comme des potions pour blesser ce qu'ils touchent."]
	quest.516AC1F0E0BCAE55.title: "&bTubes gelés"
	quest.51B1AF28328FFBAD.quest_desc: [
		"La &cforêt de varech en spirale&r est un biome très décevant pour les amateurs de bois. \\n\\nCe biome n'est pas une forêt, c'est un océan ! Et même pas le biome océanique avec un arbre, ça, c'est la &emer peu profonde luxuriante&r. \\n\\nDésolé."
		"{image:atm:textures/questpics/eternal/starlight_spiral.png width:200 height:100 align:center}"
	]
	quest.51B1AF28328FFBAD.title: "&cForêt de varech en spirale"
	quest.51B6D203E28D92BE.quest_desc: ["Marre d'attendre les &5pluies de météores&r ? Pourquoi ne pas en lancer une vous-même ! \\n\\nLa &5fusée Aetherstrike&r agit comme un feu d'artifice normal : elle s'envole, fait un joli spectacle, mais celle-ci invoque aussi une &5pluie de météores&r. \\n\\nEh oui, elle lance une &5pluie de météores&r là où elle a été tirée. \\n\\nMais elle a un temps de recharge."]
	quest.51B6D203E28D92BE.title: "&5Fusée Aetherstrike"
	quest.5244B2D6B5FA0487.quest_desc: [
		"Le &5désert cristallisé&r ressemble à un désert normal, mais teinté de &5violet&r. \\n\\nAvec en plus des cristaux géants, je ne crois pas que les déserts normaux en aient..."
		"{image:atm:textures/questpics/eternal/starlight_desert.png width:200 height:100 align:center}"
	]
	quest.5244B2D6B5FA0487.title: "&5Désert cristallisé"
	quest.5282190D0C0C2AA9.quest_desc: ["Les &ddiamants étoilés&r apparaissent loin sous terre, partout dans &9&lStarlight&r. \\n\\nVous les trouverez autour de la pierre du vide. \\nVu le mot « diamant » dans le nom, oui, c'est excellent pour les outils et les armes."]
	quest.5282190D0C0C2AA9.title: "&dDiamant étoilé"
	quest.53149C516E544FE9.quest_desc: ["Les &5Creteors&r et &5mini-Creteors&r peuvent venir des &5pluies de météores&r. \\n\\nLes &5Creteors&r sont neutres : il faut les frapper d'abord. Ils ont 8 &4cœurs&r. \\n\\nQuand on les frappe, ils roulent vers vous et se mettent à clignoter. Ils vous font un peu de dégâts, mais ils explosent aussi ! L'explosion met du temps, donc vous avez le temps de fuir, mais quand elle arrive, ils font apparaître... \\n\\nDes &5mini-Creteors&r ! Ceux-là sont bien moins amicaux que leurs grands frères. \\n\\nLes &5mini-Creteors&r foncent sur vous et explosent. Ils n'ont que 2 &4cœurs&r et demi. \\n\\nQuand on les tue (sans qu'ils explosent), les deux lâchent de l'&5aethersent&r et de la &5peau de Creteor&r."]
	quest.53149C516E544FE9.quest_subtitle: "Des monstres venus de l'espace ? Des extraterrestres ?"
	quest.53149C516E544FE9.title: "&5Creteors"
	quest.5424A0E1292B13EE.quest_desc: ["Dans &9&lStarlight&r, vous trouverez peut-être des mares chaudes. \\n\\n(Ce n'est ni un biome ni une structure, il faudra juste chercher autour de vous pour en trouver !) \\n\\nVous y trouverez de la &6pierre-source thermale&r."]
	quest.5424A0E1292B13EE.title: "&6Pierre-source thermale"
	quest.5466CB622A637DCD.quest_desc: ["Le fruit abyssal peut techniquement apparaître dans n'importe quelle étendue d'&9eau&r, mais c'est le seul à vivre dans les &3rivières scintillantes&r. \\n\\nIl pousse du fond vers le haut comme le &2varech&r, mais fonctionne aussi comme les &ebaies lumineuses&r : des fruits y poussent et on peut les cueillir."]
	quest.54DE8AAAE2181F18.quest_desc: ["La &dgrande épée Moonring&r n'a plus besoin du butin des deux boss : il suffit maintenant de tuer la &9&lMonstruosité lunaire&r. \\n\\nElle fonctionne comme une épée normale d'avant la 1.9 : elle peut bloquer les attaques comme un bouclier, mais on ne peut pas spammer les coups à pleine puissance."]
	quest.54DE8AAAE2181F18.title: "&dGrande épée Moonring"
	quest.562B280928897E0D.title: "&dBottes en diamant étoilé"
	quest.564F0343B1704CE8.title: "&cArbalète en feu stellaire"
	quest.5671D301C5264C7F.title: "&cPioche en feu stellaire"
	quest.59613CCE59689263.quest_desc: ["Les &2Rookfish&r sont de mignons calmars en forme de pièce d'échecs qui nagent dans &9&lStarlight&r. \\nIls ont 5 &4cœurs&r et lâchent eux-mêmes et leurs sacs d'air à leur mort."]
	quest.59613CCE59689263.title: "&2Rookfish"
	quest.5B737000D540ED48.title: "&4Faucille en amarambre"
	quest.5C11E99FF201C3F9.quest_desc: ["La &8grande épée en acier de golem&r est une arme très amusante. \\n\\nD'abord, elle peut bloquer. Faites simplement un clic droit pour bloquer. \\n\\nEnsuite, des &bBOULES DE FOUDRE&r ! À chaque clic gauche, 3 &bboules de foudre&r partent de l'&8épée&r. La &bfoudre&r relie les 3 et blesse tout ce qu'elle touche. Elles rebondissent aussi sur les blocs. \\n\\nEn plus, c'est juste une super &8épée&r de toute façon !"]
	quest.5C11E99FF201C3F9.title: "&8Grande épée en acier de golem"
	quest.5D8E715CCB7ACCAC.title: "&dJambières en diamant étoilé"
	quest.5DFE3CB5B0130A7A.quest_desc: ["Il y a plein de végétation à la surface des &3rivières scintillantes&r, et on peut marcher sur certaines !"]
	quest.5DFE3CB5B0130A7A.title: "La vie de la rivière"
	quest.5E8A1D47CF3C7ACF.title: "&aPelle en flowglaze"
	quest.60FDCA2FDFE74056.quest_desc: [
		"C'est &dROSE&r ! \\n\\nVous y trouverez des &darbres écarlates&r avec leurs feuilles tombées en tas en dessous. Vous y trouverez aussi des champignons luisants !"
		"{image:atm:textures/questpics/eternal/starlight_scarlet.png width:200 height:100 align:center}"
	]
	quest.60FDCA2FDFE74056.title: "&dForêt écarlate"
	quest.61E11E4C358898D6.title: "&dCasque en diamant étoilé"
	quest.62A11EEC976DA5C5.title: "&aRobe d'alchimiste"
	quest.62B44B688D09C939.quest_desc: ["Le &aflowglaze&r ! \\n\\nEn faisant un clic droit avec du &cfeu stellaire&r en main, vous le lancez. Il peut affecter les monstres avec le &cfeu stellaire&r, ou s'il touche du sable, le transformer en &aflowglaze brut&r. \\n\\nFaites simplement fondre le &aflowglaze&r et on peut l'utiliser avec le modèle d'amélioration pour faire des armes et des outils."]
	quest.62B44B688D09C939.title: "&aFlowglaze"
	quest.62DA302CF53B7C39.title: "&6Bottes en pierre-source thermale"
	quest.62F33BBE7BDFE404.quest_desc: ["La &5baguette de &btéléportation&r est un autre butin de la &9Monstruosité lunaire&r, et seulement d'elle ! \\n\\nMaintenez le clic droit avec la baguette pour l'activer, puis relâchez : elle vous téléporte sur le dernier bloc que vous regardiez ! \\n\\nIl y a une portée, mais elle est assez grande. Et un temps de recharge après utilisation !"]
	quest.62F33BBE7BDFE404.title: "&5Baguette de &7téléportation"
	quest.6314B892B569A0A5.quest_desc: ["&9&lStarlight&r ! \\n\\nUne dimension où c'est toujours le &9crépuscule&r, et non, on ne peut pas changer ça. \\n\\nIl y a des dizaines de biomes, de créatures, de boss, et même de blocs à trouver ! Saurez-vous tous les découvrir ?"]
	quest.6314B892B569A0A5.title: "&9&lEternal Starlight"
	quest.63362CC33B39C627.quest_desc: [
		"Les mers étoilées sont d'immenses étendues d'eau nichées entre les rivages chauds et la terre ferme. \\n\\nElles cachent plein de merveilles et en font pousser ! \\n\\nJ'espère que vous avez pris vos lunettes de plongée !"
		"{image:atm:textures/questpics/eternal/starlight_starlitsea.png width:200 height:100 align:center}"
	]
	quest.63362CC33B39C627.title: "&bMer étoilée"
	quest.636848ED1115A0B3.quest_desc: [
		"Les &8Ratlins&r sont des créatures paisibles qui peuvent apparaître en surface. \\n\\nÀ leur mort, ils lâchent de la viande de Ratlin, du cuir et de la mousse des cavernes. \\n\\nCette dernière sert à les faire se reproduire !"
		"{image:atm:textures/questpics/eternal/starlight_rat.png width:100 height:100 align:center}"
	]
	quest.636848ED1115A0B3.title: "&8Ratlins"
	quest.641C74BFA03BC01F.title: "&bBouclier en glacite"
	quest.645380EA38544D3B.title: "&bPelle en glacite"
	quest.64B6E1ABD471CF29.title: "&7Bottes en argent profond"
	quest.66536AAF9E98C3A6.title: "&9Houe en malarite"
	quest.66DE7EF4AFCE4F7A.title: "&7Pelle en argent profond"
	quest.687C51D915339086.title: "&aBouclier en flowglaze"
	quest.68B2D3B985FC1378.quest_desc: [
		"Une forêt lumineuse et magnifique, pleine d'&carbres torreya&r et de &elianes&r."
		"{image:atm:textures/questpics/eternal/starlight_torreya.png width:200 height:100 align:center}"
	]
	quest.68B2D3B985FC1378.title: "&cForêt de torreya"
	quest.699C6DDE6B2D51C1.quest_desc: ["Les &2arbres jinglestem&r poussent sous l'eau... Je me demande s'il existe des arbres comme ça dans la vraie vie ? \\n\\nIls ont des &2feuilles d'algue&r au lieu de feuilles normales."]
	quest.699C6DDE6B2D51C1.title: "Des &2arbres jinglestem&f ?"
	quest.6B00D5DBB3552F15.quest_desc: [
		"Les &9Tangled&r sont des ennemis qui apparaissent dans le &9jardin maudit&r. \\n\\nIls ont 10 &4cœurs&r et attaquent en vous frappant. Si vous êtes touché, vous subissez un peu de poison. \\n\\nÀ leur mort, ils lâchent des lianes et des os, mais font aussi apparaître un crâne de Tangled ! \\n\\nLes crânes de Tangled agissent comme des vex : ils volent à travers les blocs et vous frappent. Ils n'ont que 5 &4cœurs&r et, à leur mort, vous donnent le crâne comme objet."
		"{image:atm:textures/questpics/eternal/starlight_tangled.png width:150 height:100 align:center}"
	]
	quest.6B00D5DBB3552F15.title: "&9Tangled"
	quest.6DCC11671A2BAA1C.quest_desc: ["Rarement, dans les forêts de &9&lStarlight&r, vous pouvez croiser des &coiseaux&r. \\nSi vous donnez des graines à 2 &coiseaux&r près d'un nid, ils passent d'&coiseaux&r à tourtereaux. \\n\\nPas vraiment, mais ils vont se blottir tous les deux dans leur nid. Ensuite, ils vous laisseront un cadeau. Parfois, ce cadeau sera..."]
	quest.6DCC11671A2BAA1C.title: "Les oiseaux et les... oiseaux ?"
	quest.6E970CF05B96EB20.quest_desc: ["Pour blesser le &b&lgolem&r, il faut couper son alimentation ! \\n\\nPour ça, faites un clic droit sur les blocs d'énergie quand ils deviennent bleus. \\n\\nEn général, il y en a 2 dans les coins de la salle du boss et 2 au-dessus de lui !"]
	quest.6E970CF05B96EB20.title: "Coupure de courant"
	quest.6EC289857CDC4969.quest_desc: [
		"Les &bEnts&r sont une autre créature paisible qui apparaît à la surface de &9&lStarlight&r. Eux apparaissent dans les forêts ! \\n\\nCes petits arbres peuvent lâcher des bâtons, des &3baies lunaires&r et des &3feuilles lunaires&r à leur mort. \\n\\nVous pouvez utiliser des &3baies lunaires&r pour les faire se reproduire !"
		"{image:atm:textures/questpics/eternal/starlight_ent.png width:100 height:100 align:center}"
	]
	quest.6EC289857CDC4969.title: "&bEnts"
	quest.6ECDD55D55D4D44E.title: "&5Arc long de la chute d'étoiles"
	quest.6F5F6BAB09CB4F5E.title: "&9Lance en malarite"
	quest.70A82A5D17D558FB.quest_desc: ["L'&bépée d'énergie&r ne peut être lâchée que par le &b&lgolem de Starlight&r. \\n\\nElle marche comme une épée normale, mais avec un clic droit vous pouvez foncer sur eux en la balançant, comme Genji dans Overwatch !"]
	quest.70A82A5D17D558FB.title: "&bÉpée d'énergie"
	quest.70F8A8D6C442F2B6.title: "&aHoue en flowglaze"
	quest.713548E540B18E07.quest_desc: ["L'&9arc de l'anneau lunaire&r ne peut être lâché que par la &9&lmonstruosité lunaire&r. \\n\\nIl tire des flèches comme un arc normal, mais des pics sortent du sol dans la même direction que la flèche !"]
	quest.713548E540B18E07.title: "&9Arc de l'anneau lunaire"
	quest.713EF442D59501BA.quest_desc: ["La &5chaîne des &9âmes&r se fabrique avec des butins de la &9&lmonstruosité lunaire&r. \\n\\nC'est un grappin ! Faites un clic droit pour le lancer, et une fois qu'il touche quelque chose, il commence à vous tirer vers lui. Ensuite, refaites un clic droit pour le décrocher."]
	quest.713EF442D59501BA.title: "&5Chaîne des &9âmes"
	quest.71C58666D4BC2508.quest_desc: ["Fonctionne comme un briquet !"]
	quest.71C58666D4BC2508.title: "&eBoîte d'allumettes au salpêtre"
	quest.7322332BB6CF5CF7.title: "&7Pinceau en argent profond"
	quest.7618153D6613790E.title: "&6Faux thermique en springstone"
	quest.76BFC5815FC6565C.quest_desc: ["Rarement, à la surface de &9&lStarlight&r, une &5pluie de météores&r peut se produire. \\n\\nDans la vraie vie, des morceaux de météores qui s'écrasent à quelques pas de vous, c'est terrifiant, mais dans &2&lMinecraft&r, c'est utile ! \\n\\nQuand ça arrive, un matériau appelé &5aethersent&r apparaît au sol là où les météores ont frappé. Et des créatures peuvent aussi sortir de ces mêmes météores !"]
	quest.76BFC5815FC6565C.title: "&5Pluie de météores"
	quest.770C0975CA61CE46.quest_desc: ["On trouve la &bglacite&r profondément sous terre dans les forêts de pergélisol. \\n\\nElle sert à fabriquer des armures et des outils qui protègent des dégâts de gel !"]
	quest.770C0975CA61CE46.title: "&bGlacite"
	quest.7798BC7C5112D6FB.title: "&bJambières en glacite"
	quest.78D26411B482CD5A.title: "&dPelle en diamant étoilé"
	quest.79B03F769746784A.title: "&9Pioche en malarite"
	quest.79B33E4691E6CB45.title: "&aÉpée en flowglaze"
	quest.7A16D2EB63359294.quest_desc: [
		"Les &3cerfs d'aurore&r sont des animaux à sabots amicaux qui vivent aussi dans le froid. \\n\\nCes &3cerfs&r n'essaient pas de vous faire du mal, mais si vous vous mettez sur leur chemin quand ils courent, vous risquez de sentir leurs &3bois&r. \\n\\nDes &3bois&r qu'ils peuvent aussi lâcher à leur mort, et qui servent d'arme ou de houe ! \\n\\nIls peuvent aussi lâcher du cuir ou du steak de cerf d'aurore."
		"{image:atm:textures/questpics/eternal/starlight_deer.png width:200 height:100 align:center}"
	]
	quest.7A16D2EB63359294.title: "&3Cerf d'aurore"
	quest.7AF8567CF8C543F7.title: "&6Hache thermique en springstone"
	quest.7B5D34650BBD97D9.quest_desc: ["L'&5aethersent&r est lâché par les &5Creteors&r et par les &5pluies de météores&r. \\n\\nLa plupart des &5pluies de météores&r en lâchent des tonnes, alors pas d'inquiétude !"]
	quest.7B5D34650BBD97D9.title: "&5Aethersent"
	quest.7B937E68FEFBBA98.title: "&dPlastron en diamant étoilé"
	quest.7C53F52992EA2064.title: "&4Pelle en amaramber"
	quest.7D68FD0637351E02.title: "&6Casque thermique en springstone"
	quest.7D7BD1458CF12021.quest_desc: ["C'est un désert, bien sûr qu'il y a des &5cactus&r ! \\n\\nUne fois adultes, les &5cactus&r peuvent faire pousser des fruits sur leur sommet !"]
	quest.7D7BD1458CF12021.title: "&5Cactus lunaris"
	quest.7E90138B0A2C3210.quest_desc: ["Les arbres de Northland sont de grands arbres robustes dans les forêts de pergélisol. \\n\\nIls ressemblent à des épicéas, mais bien plus clairs ! Peut-être des épicéas albinos. \\n\\nLeurs pousses doivent être plantées sur de la terre, pas de l'herbe, en carré de 2x2."]
	quest.7FBB431AC055FE93.quest_desc: ["Le &7spectateur soulit&r se fabrique avec une &9rosée d'âme&r et un &9œil d'araignée de Nightfall&r. \\n\\nIl fonctionne comme la caméra collante de Tom Clancy's Splinter Cell. Faites un clic droit pour envoyer le &7spectateur&r, et au bout d'un moment vous pourrez voir à travers lui. Vous pouvez même vous voir avec ! \\n\\nOn ne peut pas l'arrêter avant la fin, alors fais attention quand vous l'utilisez. Il a aussi une durabilité et un temps de recharge."]
	quest.7FBB431AC055FE93.title: "&7Spectateur soulit"
	quest.7FBD51663C1A711A.title: "&4Épée en amaramber"
	quest.7FF77463F2A0E210.quest_desc: ["La boue de Nightfall ne se trouve que dans les &9marais sombres&r. \\n\\nVous pouvez en faire d'autres blocs !"]
	task.0AD8AC7ECCD8002A.title: "Tous droits réservés"
	task.2510A7EE5D886B63.title: "Tous droits réservés"
	task.452736994864F623.title: "Visiter une rivière chatoyante"
	task.67690077D4273A36.title: "Visiter Starlight"
}
