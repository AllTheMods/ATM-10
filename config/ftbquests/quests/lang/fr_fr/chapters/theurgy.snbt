{
	quest.02593CD4B4AE814C.quest_desc: [
		"Le &bsel&r est important pour incuber les &esoufres alchimiques&r ! \\n\\nPour obtenir du &bsel&r, il faut cuire des objets. Mais des objets différents donnent des &bsels&r différents. Les &bsels&r ont des niveaux, d'autant plus élevés qu'ils sont rares. \\n\\nPour extraire le &bsel&r par cuisson, mettez les objets dans le four et utilisez une source de chaleur pour le chauffer. Puis récupère le &bsel&r dans le four !"
		"{image:atm:textures/questpics/theurgy/theurgy_oven.png width:100 height:100 align:center}"
	]
	quest.02593CD4B4AE814C.title: "Usine de dessalement"
	quest.0460DDEEFDEB0AAF.quest_desc: ["Les baguettes de divination sont nos outils pour contacter les esprits afin de trouver certains objets. \\n\\nD'abord, il faut choisir le bloc ou l'objet, soit par accroupi + clic droit dessus avec la baguette, soit en fabriquant la baguette avec son &esoufre alchimique&r !\\n\\nEn la tenant et en maintenant le clic droit, la baguette cherche l'objet choisi. Elle émet un son et s'illumine selon la proximité du bloc ou de l'objet. \\n\\nSi vous êtes assez près, un orbe peut apparaître pour vous montrer le chemin."]
	quest.0460DDEEFDEB0AAF.title: "Baguettes de divination"
	quest.0542FE108089A0A2.quest_desc: ["La &l&6Théurgie&r est l'art d'utiliser la magie pour l'alchimie ! Ou, dans notre cas, d'utiliser des machines et des objets pour obtenir plus d'objets, ou d'autres objets ! \\n\\nBeaucoup des machines nécessaires pour la &l&6Théurgie&r demandent du cuivre, alors commence par là !"]
	quest.0542FE108089A0A2.title: "&l&6Theurgy"
	quest.06AD25DB96F3A1CC.quest_desc: [
		"Comme un thermomètre, ils contiennent du &cmercure&r ! \\n\\nQue ce soit des &ccristaux&r ou des &céclats de mercure&r, il contient du &cmercure&r."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_1.png width:100 height:125 align:center}"
	]
	quest.06AD25DB96F3A1CC.title: "Récipient à &cmercure&r"
	quest.0830195863384CF0.quest_desc: ["La &bstrate&r est le premier sel, le plus basique, fabriqué avec des blocs ordinaires comme la pierre, le sable ou l'obsidienne. \\n\\nVous pouvez utiliser 5 &bsels de strate&r pour fabriquer du &bsel minéral&r."]
	quest.0830195863384CF0.title: "&bSel de strate"
	quest.0854AD352218E1C3.quest_desc: ["Vous ne détestez pas avoir toute cette énergie mais pas de chauffage ? \\n\\nVous pouvez maintenant changer ça avec l'émetteur de flux calorique ! Accroupi + clic droit avec pour le lier à une machine. Puis posez-le et alimentez-le pour envoyer de la chaleur. \\n\\nIl ne peut pas être lié à plusieurs machines !"]
	quest.0854AD352218E1C3.quest_subtitle: "Comment ?"
	quest.0854AD352218E1C3.title: "Chaleur sans fil"
	quest.0EADCEA9AB001FC7.quest_desc: [
		"Source de chaleur très simple. Placez-la sous la machine et donnez-lui du combustible de four : charbon, bûches, blocs d'algues séchées."
		"{image:atm:textures/questpics/theurgy/theurgy_brazier.png width:100 height:100 align:center}"
	]
	quest.0EADCEA9AB001FC7.title: "Une chaleur de four"
	quest.0F7BB4ECCA5C082C.quest_desc: [
		"C'est ici que vous mettez le &esoufre alchimique&r. \\n\\nL'objet contenu dans le &esoufre alchimique&r redeviendra cet objet grâce à l'incubation !"
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_3.png width:100 height:125 align:center}"
	]
	quest.0F7BB4ECCA5C082C.title: "Récipient à &esoufre&r"
	quest.161E7D934A21F849.quest_desc: [
		"La réformation consiste à changer un &esoufre alchimique&r en un autre, ou à utiliser du &3nitre alchimique&r pour en obtenir plus ! \\n\\nLa première étape est le piédestal source : c'est là que vous mettez le &esoufre&r que vous voulez changer en un autre."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_1.png width:100 height:100 align:center}"
	]
	quest.161E7D934A21F849.title: "Étape 1 : piédestal source"
	quest.16B88F46021E956D.quest_desc: ["La &l&6Théurgie&r a des machines, alors bien sûr il lui faut de la logistique !\\n\\n(Allez voir la page Logistique de base pour en savoir plus sur la logistique.)\\n\\nAvec le &cmercure&r, vous pouvez déplacer objets et fluides d'un endroit à l'autre grâce aux &cfils de mercure&r et à d'autres objets ! Ce sont les fils qui déplacent vraiment les objets."]
	quest.16B88F46021E956D.title: "La logistique avec le &cmercure&r"
	quest.19A2016B54C6FA34.quest_desc: ["Certaines machines de la &l&6Théurgie&r ont besoin de chaleur pour démarrer ! Mais la &l&6Théurgie&r est très exclusive sur la façon dont ses machines reçoivent la chaleur : seules ces deux machines peuvent servir de source de chaleur. \\n\\n(Les machines qui utilisent la chaleur sont : le chaudron de liquéfaction, le four de calcination, le distillateur de &cmercure&r et l'incubateur.)"]
	quest.19A2016B54C6FA34.quest_subtitle: "Qu'est-ce que vous êtes chaud !"
	quest.19A2016B54C6FA34.title: "Qu'est-ce que vous êtes chaud !"
	quest.1A46A97A00A31C03.quest_desc: [
		"La deuxième étape est le piédestal cible. C'est là que vous mettez le &esoufre&r en lequel vous voulez transformer le premier. \\n\\nOu là que vous mettez le &3nitre alchimique&r."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_2.png width:100 height:100 align:center}"
	]
	quest.1A46A97A00A31C03.title: "Étape 2 : piédestal cible"
	quest.1C829609915E0012.quest_desc: [
		"Mettez du &cmercure&r, \\nrécupère de l'énergie. \\n\\nMF veut dire &cMercure&r Flux, pas Metal Face ni une insulte vulgaire !"
		"{image:atm:textures/questpics/theurgy/theurgy_mercuryflux.png width:100 height:100 align:center}"
	]
	quest.1C829609915E0012.title: "Produire de l'énergie avec du &cmercure"
	quest.20C3AADEE2D4800D.quest_desc: [
		"Vous pouvez aussi déplacer des fluides d'un réservoir à un autre avec le &cmercure&r. \\n\\nAttachez un extracteur de fluide là où vous voulez prendre le fluide, comme un évier. Puis mettez l'insertion de fluide là où vous voulez qu'il aille, comme un accumulateur de &dsel ammoniac&r. Reliez les deux avec des fils et ça devrait circuler !"
		"{image:atm:textures/questpics/theurgy/theurgy_fluid.png width:200 height:75 align:center}"
	]
	quest.20C3AADEE2D4800D.title: "Déplacement des fluides"
	quest.26B462F2F41A77C7.quest_desc: ["Tous les cadeaux de Mère Nature... peuvent être impitoyablement brûlés dans un four jusqu'à ne laisser que du &bsel&r ! \\n\\nLes bûches, les feuilles et les cultures peuvent être grillées en &bsels végétaux&r."]
	quest.26B462F2F41A77C7.title: "&bSel végétal"
	quest.285B3FB38B12F8CA.quest_desc: [
		"Il nous faut ces deux blocs pour fabriquer du &dsel ammoniac&r (j'ai failli dire multibloc, mais pour moi 2 blocs ne font pas un multibloc). Un réservoir de &dsel ammoniac&r en bas, avec un &daccumulateur de sel ammoniac&r dessus. \\n\\nL'&daccumulateur de sel ammoniac&r reçoit l'&9eau&r et les &dcristaux&r ; il peut contenir 10 000 mB d'&9eau&r, soit 10 seaux, et une pile de &dcristaux de sel ammoniac&r. Le réservoir reçoit le &dsel ammoniac&r produit et peut contenir 2 000 mB, soit 2 seaux."
		"{image:atm:textures/questpics/theurgy/theurgy_sal_front.png width:100 height:200 align:center}"
	]
	quest.285B3FB38B12F8CA.title: "Fabriquer du &dsel ammoniac"
	quest.2B29E9AB9447E1C6.quest_desc: [
		"Ça, c'est une machine multistructure ! \\n\\nPour récupérer des objets à partir de &esoufre alchimique&r, il faut les incuber. Il faut l'incubateur avec les 3 récipients adjacents. L'ordre n'importe pas, tant qu'ils touchent la moitié du bas. \\n\\nUne fois tous les objets dans les récipients et la chaleur en place, il commence à incuber vos objets ! Vous saurez qu'il fonctionne quand des particules de fumée en sortiront."
		"{image:atm:textures/questpics/theurgy/theurgy_incubator.png width:200 height:200 align:center}"
	]
	quest.2F0D6267569F740B.quest_desc: ["Les matériaux communs sont un cran au-dessus des abondants, et plus rares. Ce sont surtout des lingots et des butins de monstres plus rares, comme les perles de l'Ender ou la peau de lapin. \\n\\nLà encore, vous pouvez voir la liste complète dans les tags."]
	quest.36926B5EBFF6E55A.quest_desc: [
		"Le &cmercure&r est l'un des matériaux les plus importants de la &l&6Théurgie&r ! \\n\\nPour en obtenir, il faut en distiller dans le distillateur de &cmercure&r. Mettez des objets dans le distillateur et donnez-lui de la chaleur ! \\n\\nCertains objets donnent plus de &cmercure&r, comme les diamants : 10 de &cmercure&r pour 1 diamant, contre 10 pierres pour 1 de &cmercure&r."
		"{image:atm:textures/questpics/theurgy/theurgy_distiller.png width:100 height:150 align:center}"
	]
	quest.36926B5EBFF6E55A.title: "Fabriquer du &cmercure"
	quest.393DA9C9D808A851.quest_desc: ["La clé de la &l&6Théurgie&r est la baguette &cmercurielle&r. Vous pouvez maintenir Maj et faire défiler la molette pour changer de mode. \\n\\nVous pouvez activer/désactiver pour, en gros, arrêter le transfert des fils. \\n\\nVous pouvez changer la face par laquelle les objets sont extraits ou insérés. \\n\\nEt vous pouvez changer le canal de fréquence !"]
	quest.393DA9C9D808A851.quest_subtitle: "Je croyais que c'était un mod de magie..."
	quest.393DA9C9D808A851.title: "Évidemment qu'il y a une clé"
	quest.3B6F723B03C4BF55.quest_desc: ["La digestion (une forme très rudimentaire de traitement) sert à changer les &3nitres alchimiques&r en différentes formes. \\n\\nD'abord, il faut de l'or purifié, obtenu en mettant de l'or, du &bsel alchimique&r et de l'&9eau&r dans la cuve de digestion, puis accroupi + clic droit pour la fermer comme la cuve de fermentation. \\n\\nEnsuite, on peut combiner 4 &3nitres alchimiques&r d'un même type avec de l'or purifié et du &dsel ammoniac&r pour obtenir un niveau supérieur, ou faire l'inverse pour un niveau inférieur."]
	quest.3B6F723B03C4BF55.title: "Cuve de digestion"
	quest.3C5734448FEC128B.quest_desc: ["La baguette de divination la moins chère : la baguette de divination en verre. \\n\\nElle trouve tous les minerais qu'une pioche en pierre peut miner. Donc cuivre, charbon et fer. Rien de plus."]
	quest.3EB63AF53E70C931.quest_desc: [
		"La réformation a besoin de flux de mercure pour fonctionner ! Il faut faire accroupi + clic droit sur les 3 piédestaux avec l'émetteur de flux sulfurique pour les régler. Puis posez l'émetteur et alimentez-le.\\n\\nEnsuite, tout devrait être prêt pour la réformation !"
		"{image:atm:textures/questpics/theurgy/theurgy_reform_setup.png width:200 height:50 align:center}"
	]
	quest.3EB63AF53E70C931.title: "Étape 4 : l'alimentation"
	quest.41ABC09C798CA8BE.quest_desc: ["Cette quête a été écrite par l'&6équipe AllTheMods&r ou un &2contributeur de la communauté&r pour les modpacks AllTheMods. \\n\\nComme tous les packs &6AllTheMods&r sont sous licence &eTous droits réservés&r, cette quête ne peut pas être utilisée dans un pack public non publié par l'&6équipe AllTheMods&r sans autorisation explicite. \\n\\nCette quête est volontairement cachée ; si vous la voyez, c'est que vous êtes en mode édition."]
	quest.457CAE66B0FA4CCF.quest_desc: ["Tous les minerais du jeu de &2base&r peuvent être trouvés avec la baguette de divination en diamant. Elle les trouve tous, plus la netherite !"]
	quest.45996B848792379E.quest_desc: ["Vous pouvez miner des &dcristaux de sel ammoniac&r dans l'&2Overworld&r, mais ce n'est pas si facile. Il faudra quand même de l'&9eau&r et les machines pour faire du &dsel ammoniac&r afin de fabriquer du &esoufre alchimique&r. \\n\\nLes &dcristaux&r sont facultatifs mais aident énormément : avec juste de l'eau, 1000 mB donnent 100 mB de &dsel ammoniac&r. Avec 1000 mB d'&9eau&r et un &dcristal de sel ammoniac&r, on obtient 1000 mB de &dsel ammoniac&r. \\n\\nDix fois plus de production avec un seul objet en plus !"]
	quest.45996B848792379E.quest_subtitle: "Pourquoi a-t-on besoin de machines si on peut simplement le miner ?"
	quest.45996B848792379E.title: "Pourquoi des machines ?"
	quest.48EE6C807C1668D4.quest_desc: ["Si vos fils doivent aller plus loin ou se connecter à plus d'endroits, il vous faut peut-être un nœud connecteur. \\n\\nC'est aussi simple que ça !"]
	quest.48EE6C807C1668D4.title: "Des fils par ici, des fils par là"
	quest.49D1B01E07ABA471.quest_desc: [
		"Vous pouvez transférer des objets avec le &cmercure&r. \\nAttachez un extracteur d'objets là où vous voulez prendre les objets. Puis attachez l'insertion d'objets là où vous voulez qu'ils aillent. Reliez les deux avec des &cfils de mercure&r et les objets devraient commencer à circuler ! \\n\\nÇa marche avec les machines de la &l&6Théurgie&r pour l'automatisation !"
		"{image:atm:textures/questpics/theurgy/theurgy_item.png width:200 height:75 align:center}"
	]
	quest.49D1B01E07ABA471.title: "Déplacement des objets"
	quest.4EE482B9D61B5933.quest_desc: ["Évidemment, le jeu de &2base&r n'est pas notre maximum : il y a bien plus, et bien plus rare, dans le moddé !"]
	quest.54F0C5C48CFC94D0.quest_desc: ["Avec la logistique, il faut du filtrage. Il y a deux filtres différents : liste et attribut. \\nLe filtre liste : on y met des objets et on choisit liste blanche ou noire, et si on tient compte des données NBT ou non. \\n\\nLe filtre attribut prend un objet de référence puis filtre selon un attribut choisi. Ça inclut les tags et d'autres choses, comme le fait de pouvoir servir de combustible de four ou de faire des chemins !"]
	quest.55E321EFBE8956DE.quest_desc: ["Si vous voulez économiser sur les recettes de fermentation, le starter de fermentation est parfait pour vous. \\n\\nUn remplacement très bon marché d'autres objets pour la fermentation."]
	quest.55E321EFBE8956DE.title: "Une fermentation plus facile"
	quest.5844DD2BEE5EC3DC.quest_desc: ["Ne le mange pas ! \\n\\nLe &cmercure&r sert à 3 choses : l'incubation, la production d'énergie et la logistique !"]
	quest.5844DD2BEE5EC3DC.quest_subtitle: "Vénus... non, &cMercure&r !"
	quest.5844DD2BEE5EC3DC.title: "Mercure"
	quest.616364E6AE05C341.quest_desc: ["Les &bsels minéraux&r se font avec... eh bien, des minéraux. \\n\\nTout ce qui se mine sous forme de minerai peut devenir du &bsel&r. Minerais bruts, lingots, gemmes, tout devient du &bsel minéral&r ! \\n\\nMême l'unobtainium peut devenir du &bsel&r ! Mais s'il vous plaît, ne faites pas ça, il y a tellement de meilleures options."]
	quest.616364E6AE05C341.title: "&bSel minéral"
	quest.61DA3D61D7103647.quest_desc: ["Les &esoufres alchimiques&r peuvent être faits à partir de pratiquement tout et transformés en pratiquement tout ! \\n\\nIl y a quelques groupes d'objets différents dans les &esoufres alchimiques&r, peut-être expliqués dans une autre quête. \\n\\nIl y a 3 chemins pour traiter les &esoufres alchimiques&r : 1. la fermentation et la digestion pour faire du nitre, 2. l'incubation pour refaire ces objets, et 3. changer l'objet par réformation."]
	quest.61DA3D61D7103647.title: "&eSoufres alchimiques"
	quest.6A8E748B642DD16F.quest_desc: [
		"C'est là que le &bsel&r sera conservé. \\n\\nLe type de &bsel&r compte pour ce que vous voulez incuber. Pour faire de l'unobtainium, il vous faut du &bsel minéral&r, pour du blé, du &bsel végétal&r, et ainsi de suite."
		"{image:atm:textures/questpics/theurgy/theurgy_vessel_2.png width:100 height:125 align:center}"
	]
	quest.6A8E748B642DD16F.title: "Récipient à &bsel&r"
	quest.6C6F4EB5CBE2FBC2.quest_desc: ["La baguette de divination en fer va un peu plus loin : elle trouve les minerais qu'une pioche en fer peut miner ! Donc les diamants, la redstone et l'or."]
	quest.6CAD27627A3F8FD7.quest_desc: [
		"On arrive enfin au cœur du mod, les &esoufres alchimiques&r ! \\n\\nPour les faire, il faut un chaudron de liquéfaction, un objet, du &dsel ammoniac&r et un chauffage. \\n\\nLa chaleur est expliquée dans une autre quête, mais il vous faudra soit le brasero pyromantique, soit l'émetteur de flux calorique sous le chaudron pour le chauffer. \\n\\nEnsuite, le &dsel ammoniac&r liquide dedans. \\n\\nEt enfin, l'objet que vous voulez transformer en &esoufre alchimique&r. \\n\\nVous saurez que ça marche quand ça fait des bulles."
		"{image:atm:textures/questpics/theurgy/theurgy_lique.png width:100 height:100 align:center}"
	]
	quest.6CAD27627A3F8FD7.title: "Fabriquer du &esoufre alchimique"
	quest.7119F8C352D057BC.quest_desc: ["On arrive aux choses amusantes ! Les objets rares vont même jusqu'aux élytres ! Oui, j'aurais pensé que c'était mieux que rare, mais ce n'est pas moi qui ai fait ce classement."]
	quest.7198ED7E97A256A4.quest_desc: ["La première baguette de divination spéciale à fabriquer est la baguette des matériaux abondants ! \\n\\nQuand vous fabriquez la baguette avec le &esoufre alchimique&r d'un objet, la baguette s'accorde à cet objet. \\n\\nVous pouvez voir la liste des matériaux abondants dans les tags : elle est trop longue pour que je la lise dans les quêtes."]
	quest.72FADEAEE2DA03AF.quest_desc: [
		"La troisième étape, c'est là où ira le &esoufre&r tout juste transformé : le piédestal de résultat. Une fois reformé, il atterrit ici."
		"{image:atm:textures/questpics/theurgy/theurgy_reform_3.png width:100 height:100 align:center}"
	]
	quest.72FADEAEE2DA03AF.title: "Étape 3 : piédestal de résultat"
	quest.730F2D3329C4FF88.quest_desc: ["&nFermentation&r : \\nle processus chimique par lequel des molécules comme le glucose sont dégradées sans oxygène. \\n\\nAutrement dit : de l'&9eau&r et du temps changent les choses ! \\n\\nPour utiliser la cuve de fermentation, mettez les objets et le fluide dans la cuve, puis faites accroupi + clic droit pour la fermer. \\n\\nAu bout d'un moment, ça devrait fermenter ! C'est comme ça qu'on transforme le &esoufre alchimique&r en &3nitre alchimique&r, qui peut devenir d'autres objets !"]
	quest.730F2D3329C4FF88.title: "Cuve de fermentation"
	quest.76F675A898EAB4E8.quest_desc: ["Le &dsel ammoniac&r est un élément essentiel du &esoufre alchimique&r, qui nous servira à fabriquer et reproduire des objets. \\n\\nPour obtenir du &dsel ammoniac&r, il nous faut de l'&9eau&r."]
	quest.76F675A898EAB4E8.title: "&dSel ammoniac"
	quest.7878F190BC8ADC82.quest_desc: ["Le meilleur du meilleur. Des diamants à l'étoile du Nether en passant par l'allthemodium. Cette baguette ne trouve que les meilleurs objets !"]
	quest.7A1C117CA8FB7C31.quest_desc: ["Celle-ci est unique !\\n\\nAu lieu de trouver des minerais, elle trouve les blocs d'améthyste bourgeonnante !\\n\\nFini de galérer à trouver des géodes, mon brave !"]
	quest.7A271F425C3934CE.quest_desc: ["Pour l'instant, on ne peut l'obtenir qu'en faisant cuire 2 &bsels végétaux&r pour obtenir 1 &bsel de créature&r. \\n\\nEspérons que les prochaines mises à jour nous permettront de tuer plus de créatures vivantes pour du &bsel&r !"]
	quest.7A271F425C3934CE.title: "&bSel de créature"
	task.339A5D32CC00D60C.title: "Tous droits réservés"
	task.3489080F5FDE8B1B.title: "Chaleur"
	task.6D9221A533926A7B.title: "Tous droits réservés"
	task.76F6BC2EC054BD3C.title: "Soufres alchimiques"
}
