	quest.4FE7F45C72EF5DC1.title: "Abeille de nickel"
	quest.500BEAD94C97DF96.quest_desc: ["Peut être placée dans une ruche ou une centrifugeuse.\\n\\nDans une ruche, elle réduit de 20 % le temps que les abeilles passent dans la ruche.\\n\\nDans une centrifugeuse, elle augmente la vitesse de traitement.\\n\\nElles se cumulent."]
	quest.500BEAD94C97DF96.quest_subtitle: "Abeilles soniques"
