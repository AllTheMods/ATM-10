	quest.6F978C4D561F35EC.quest_desc: [
		"L'embouteilleuse a deux usages : mettre le miel en bouteille et écraser les abeilles pour leurs gènes.\\n\\nPour obtenir des gènes d'abeilles, placez un piston au-dessus de l'embouteilleuse en laissant un bloc d'espace entre eux.\\n\\nPlacez l'abeille sur l'embouteilleuse et activez le piston pour écraser l'abeille en gènes. La fiole d'abeille écrasée obtenue peut ensuite aller dans une centrifugeuse.\\n\\nNote : pensez à mettre des fioles dans l'embouteilleuse."
		"{image:atm:textures/questpics/bees/bottler.png width:100 height:150 align:1}"
	]
	quest.6F978C4D561F35EC.quest_subtitle: "Chérie, j'ai écrasé les abeilles"
