	quest.094D28B7A0170039.quest_subtitle: "Donnez un entonnoir à une abeille normale"
	quest.094D28B7A0170039.title: "Abeille collectrice"
	quest.097DE7038A746847.quest_subtitle: "Apparaît depuis un nid de roseaux"
	quest.09FD3D0B9BCAEB5A.quest_desc: [
		"Le nid de gravier attire les abeilles dans un biome de rivière ou de plage."
		""
