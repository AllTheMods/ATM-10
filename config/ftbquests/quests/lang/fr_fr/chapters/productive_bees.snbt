	quest.29EE878BC8D3A742.quest_desc: [
		"Pour lancer notre propre ferme d'abeilles, il va falloir trouver des abeilles... et les capturer."
		""
		"Un clic droit sur une abeille avec ceci la capture !"
		""
		"L'aventure peut aussi vous rapporter des &6cages à abeilles solides&r, alors garde l'œil ouvert !"
	]
	quest.29EE878BC8D3A742.title: "Capturer des abeilles !"
	quest.2A559D527BC88DEC.quest_desc: ["Si vous jetez un &9œuf d'apparition d'abeille spatiale&r et un &8bloc d'acier céleste&r dans la lave, vous créez un œuf d'apparition d'abeille d'acier céleste."]
