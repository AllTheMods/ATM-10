	quest.49776AC58E535E6A.title: "Abeille d'inanite"
	quest.4C0302FF4F63B52E.quest_desc: [
		"Si vous voulez les abeilles ATM, il faut beaucoup de captures, de croisements et de nourrissage."
		""
		"La suite de la série de quêtes indique quelles abeilles il vous faut pour avancer."
		""
		"Pensez à consulter JEI et le &9grand livre des abeilles&r pour plus d'infos !"
	]
