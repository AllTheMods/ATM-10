	quest.5F1784E562C29B66.quest_desc: ["Fabriquez-vous un &5nid de pierre de l'End&r et allez dans l'End capturer une de ces abeilles !"]
	quest.5F1784E562C29B66.quest_subtitle: "&9Nécessite un nid de pierre de l'End"
	quest.5F1784E562C29B66.title: "Abeille de l'Ender"
