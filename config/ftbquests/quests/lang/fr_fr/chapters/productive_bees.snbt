	quest.6BFF78D4218DF1F2.title: "Abeille de stellarite"
	quest.6D484150536536B9.quest_desc: [
		"Ce nid attire les &eabeilles cristallines&r. Il vous faudra du quartz du Nether au lieu de friandises au miel pour attirer l'abeille."
		""
		"Le plus simple pour obtenir un bloc de quartz est de le miner avec une pioche Toucher de soie."
		""
		"Astuce : le laiton a le trait Toucher de soie quand on fabrique un outil Silent Gear."
	]
	quest.6D484150536536B9.quest_subtitle: "Attire les abeilles cristallines dans le Nether"
	quest.6DBF9CAB37B9BBF3.quest_subtitle: "Augmente la productivité des abeilles de 120 %"
	quest.6DC826659699E638.quest_subtitle: "Faites se percuter un œuf d'apparition d'abeille de redstone et un œuf d'apparition d'abeille d'électrum"
